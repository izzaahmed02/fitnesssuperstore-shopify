{% doc %}
  @prompt
    a video slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-slider__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-slider__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-video-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-video-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-video-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-video-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap }}px;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .ai-video-slider__slide-{{ ai_gen_id }} {
    flex: 0 0 calc(100% / {{ block.settings.slides_per_view }} - {{ block.settings.slide_gap }}px * ({{ block.settings.slides_per_view }} - 1) / {{ block.settings.slides_per_view }});
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #000;
  }

  .ai-video-slider__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
  }

  .ai-video-slider__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-slider__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-slider__placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-slider__play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-video-slider__play-button-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-slider__play-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: #000;
    margin-left: 3px;
  }

  .ai-video-slider__play-button-{{ ai_gen_id }}.playing {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-slider__video-info-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.info_background_color }};
  }

  .ai-video-slider__video-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.info_text_color }};
    margin: 0 0 8px;
  }

  .ai-video-slider__video-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.info_text_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-video-slider__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-video-slider__button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-video-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: scale(1.1);
  }

  .ai-video-slider__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-slider__button-{{ ai_gen_id }}:disabled:hover {
    transform: none;
  }

  .ai-video-slider__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.button_icon_color }};
  }

  .ai-video-slider__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
    opacity: 0.4;
  }

  .ai-video-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (max-width: 989px) {
    .ai-video-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(100% / {{ block.settings.slides_per_view_tablet }} - {{ block.settings.slide_gap }}px * ({{ block.settings.slides_per_view_tablet }} - 1) / {{ block.settings.slides_per_view_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - {{ block.settings.slide_gap }}px);
    }

    .ai-video-slider__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-video-slider__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<video-slider-{{ ai_gen_id }} class="ai-video-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-slider__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-video-slider__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-video-slider__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-video-slider__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-slider__wrapper-{{ ai_gen_id }}">
      <div class="ai-video-slider__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..6) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign title_key = 'video_title_' | append: i
            assign description_key = 'video_description_' | append: i
            
            assign video = block.settings[video_key]
            assign video_title = block.settings[title_key]
            assign video_description = block.settings[description_key]
          %}

          <div class="ai-video-slider__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            <div class="ai-video-slider__video-wrapper-{{ ai_gen_id }}">
              {% if video != blank %}
                <video
                  class="ai-video-slider__video-{{ ai_gen_id }}"
                  data-video
                  loop
                  muted
                  playsinline
                  preload="metadata"
                >
                  <source src="{{ video }}" type="video/mp4">
                </video>
                <button
                  class="ai-video-slider__play-button-{{ ai_gen_id }}"
                  data-play-button
                  aria-label="Play video"
                >
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              {% else %}
                <div class="ai-video-slider__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-video-slider__empty-state-{{ ai_gen_id }}">
                    Add a video
                  </div>
                </div>
              {% endif %}
            </div>

            {% if video_title != blank or video_description != blank %}
              <div class="ai-video-slider__video-info-{{ ai_gen_id }}">
                {% if video_title != blank %}
                  <h3 class="ai-video-slider__video-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                {% endif %}
                {% if video_description != blank %}
                  <p class="ai-video-slider__video-description-{{ ai_gen_id }}">{{ video_description }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-video-slider__controls-{{ ai_gen_id }}">
        <button
          class="ai-video-slider__button-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous slide"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>

        <div class="ai-video-slider__dots-{{ ai_gen_id }}" data-dots></div>

        <button
          class="ai-video-slider__button-{{ ai_gen_id }}"
          data-next
          aria-label="Next slide"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</video-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = {{ block.settings.slides_per_view }};
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplayDelay = {{ block.settings.autoplay_delay }} * 1000;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = this.querySelectorAll('[data-slide]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.videos = this.querySelectorAll('[data-video]');
        this.playButtons = this.querySelectorAll('[data-play-button]');

        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.updateSlidesPerView();
        this.createDots();
        this.setupEventListeners();
        this.updateSlider();

        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => this.updateSlidesPerView());
      }

      updateSlidesPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.slidesPerView = 1;
        } else if (width <= 989) {
          this.slidesPerView = {{ block.settings.slides_per_view_tablet }};
        } else {
          this.slidesPerView = {{ block.settings.slides_per_view }};
        }
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
        this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
        this.updateSlider();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.playButtons.forEach((button, index) => {
          button.addEventListener('click', () => this.toggleVideo(index));
        });

        this.videos.forEach((video) => {
          video.addEventListener('ended', () => {
            const button = video.parentElement.querySelector('[data-play-button]');
            if (button) {
              button.classList.remove('playing');
            }
          });
        });
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;

        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-video-slider__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateSlider() {
        const slideWidth = this.slides[0]?.offsetWidth || 0;
        const gap = {{ block.settings.slide_gap }};
        const offset = -(this.currentIndex * (slideWidth + gap));

        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-video-slider__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
          this.resetAutoplay();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateSlider();
          this.resetAutoplay();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
        this.resetAutoplay();
      }

      toggleVideo(index) {
        const video = this.videos[index];
        const button = this.playButtons[index];

        if (!video || !button) return;

        if (video.paused) {
          this.pauseAllVideos();
          video.play();
          button.classList.add('playing');
          this.stopAutoplay();
        } else {
          video.pause();
          button.classList.remove('playing');
          this.startAutoplay();
        }
      }

      pauseAllVideos() {
        this.videos.forEach((video, index) => {
          video.pause();
          const button = this.playButtons[index];
          if (button) {
            button.classList.remove('playing');
          }
        });
      }

      startAutoplay() {
        if (!this.autoplay) return;

        this.autoplayTimer = setInterval(() => {
          if (this.currentIndex >= this.maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateSlider();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.updateSlidesPerView());
      }
    }

    customElements.define('video-slider-{{ ai_gen_id }}', VideoSlider{{ ai_gen_id }});
  })();
</script>

