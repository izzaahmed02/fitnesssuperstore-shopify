  <!doctype html>
    <html class="js" lang="{{ request.locale.iso_code }}">
      <head>
        <meta charset="utf-8">
         {% render 'optimization', postpone_loading: 'init' %}         
          <meta http-equiv="X-UA-Compatible" content="IE=edge">
          <meta name="viewport" content="width=device-width,initial-scale=1">
          <meta name="theme-color" content="">
          {% if template contains 'product' and product %}
            <link rel="canonical" href="{{ shop.url }}/products/{{ product.handle }}">
          {% elsif collection %}
            <link rel="canonical" href="{{ collection.url | prepend: shop.url }}">
          {% else %}
            <link rel="canonical" href="{{ canonical_url }}">
          {% endif %}
          {% if template == 'search' %}
            <meta name="robots" content="noindex,nofollow"/>
          {%- endif -%}
          {%- if settings.favicon != blank -%}
          
        <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
          {%- endif -%}
          {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
          <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
          {%- endunless -%}

          <title>
            {{ page_title | escape_once }}
            {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
            {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
          </title>
          <!-- Google Tag Manager -->
          <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-PFW6SMSL');</script>
          <!-- End Google Tag Manager -->
          {% if template contains 'index' %}
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "Organization",
              "name": {{ shop.name | json }},
              {% if settings.logo %}
                "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
              {% endif %}
              "sameAs": [
                {% if settings.social_twitter_link %}{{ settings.social_twitter_link | json }}{% endif %}
                {% if settings.social_facebook_link %}, {{ settings.social_facebook_link | json }}{% endif %}
                {% if settings.social_pinterest_link %}, {{ settings.social_pinterest_link | json }}{% endif %}
                {% if settings.social_instagram_link %}, {{ settings.social_instagram_link | json }}{% endif %}
                {% if settings.social_tiktok_link %}, {{ settings.social_tiktok_link | json }}{% endif %}
                {% if settings.social_youtube_link %}, {{ settings.social_youtube_link | json }}{% endif %}
              ],
              "url": {{ request.origin | append: page.url | json }}
            }
          </script>
        {% endif %}


  {% if template contains 'product' and product %}
  {% assign domain_origin = request.origin %}
<script type="application/ld+json">
{%- capture ld_json -%}
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": "https://{{ shop.domain }}{{ product.url }}#product",
      "@type": "Product",
      "brand": {
        "@type": "Brand",
        "@id": "https://{{ shop.domain }}{{ product.url }}#brand",
        "name": "{{ product.vendor | default: shop.name | escape }}"
      },
      {% if product.metafields.reviews.rating.value and product.metafields.reviews.review_count %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "@id": "https://{{ shop.domain }}{{ product.url }}#aggregaterating",
        "name": "{{ product.title | escape }}",
        "ratingValue": "{{ product.metafields.reviews.rating.value | escape }}",
        "ratingCount": "{{ product.metafields.reviews.review_count }}",
        "reviewCount": "{{ product.metafields.reviews.review_count }}"
      },
      {% endif %}
      "audience": "{{ product.metafields.custom.audience | default: 'Fitness enthusiasts and commercial gym users' | escape }}",
      "category": "{{ product.type | default: 'Fitness Equipment' | escape }}",
      "description": "{{ product.description | strip_html | strip_newlines | truncate: 500 | escape | default: 'High-quality fitness equipment for home or commercial use.' }}",
      "image": [{% for image in product.images %}"{{ image.src | img_url: 'master' | split: '?' | first | escape }}"{% unless forloop.last %},{% endunless %}{% else %}"{{ 'product-placeholder.jpg' | asset_url | split: '?' | first | default: 'https://via.placeholder.com/500' | escape }}"{% endfor %}],
      "name": "{{ product.title | escape }}",
      "color": "{{ product.metafields.custom.product_color | default: 'Not specified' | escape }}",
      "countryOfAssembly": "{{ product.metafields.custom.country_of_assembly | default: 'US' | escape }}",
      "countryOfLastProcessing": "{{ product.metafields.custom.country_of_last_processing | default: 'US' | escape }}",
      "hasMeasurement": {
        "@type": "QuantitativeValue",
        "@id": "https://{{ shop.domain }}{{ product.url }}#measurement",
        "value": "Dimensions: {{product.metafields.custom.length_in | escape}} inch length x {{product.metafields.custom.width_in | escape}} inch weight x {{product.metafields.custom.height_in | escape}} inch height"
      },
      "keywords": [{%- assign keyword_list = product.metafields.custom.keywords.value -%}{%- if keyword_list != blank -%}{%- for keyword in keyword_list -%}"{{ keyword | strip | escape }}"{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- elsif product.tags.size > 0 -%}{%- for tag in product.tags -%}"{{ tag | strip | escape }}"{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- else -%}{%- assign words = product.title | split: ' ' -%}{%- for word in words -%}"{{ word | strip | escape }}"{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endif -%}],
      "manufacturer": {
        "@type": "Organization",
        "@id": "https://{{ shop.domain }}{{ product.url }}#manufacturer",
        "name": "{{ product.vendor | default: shop.name | escape }}"
      },
      "weight": "{{ product.metafields.custom.product_weight_lbs | default: 'Not specified' | escape }}",
      "mpn": "{{ product.selected_or_first_available_variant.sku | default: product.handle | escape }}",
      "itemCondition": "https://schema.org/{% if product.metafields.custom.condition_state %}{% if product.metafields.custom.condition_state contains 'as is'%}UsedCondition{% elsif product.metafields.custom.condition_state contains 'Remanufactured'%}RefurbishedCondition{% else %}{{ product.metafields.custom.condition_state }}Condition{% endif %}{% else %}NewCondition{% endif %}",
      "offers": {
        "@id": "https://{{ shop.domain }}{{ product.url }}?variant={{ product.selected_or_first_available_variant.id }}#offer",
        "@type": "Offer",
        "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": "{{ product.price | divided_by: 100.0 | default: '0.00' }}",
        "priceCurrency": "{{ shop.currency | default: 'USD' }}",
        "url": "https://{{ shop.domain }}{{ product.url }}?variant={{ product.selected_or_first_available_variant.id }}",
        {% if product.metafields.reviews.rating.value and product.metafields.reviews.review_count %}
        "aggregateRating": {
          "@type": "AggregateRating",
          "@id": "https://{{ shop.domain }}{{ product.url }}#aggregaterating",
          "name": "{{ product.title | escape }}",
          "ratingValue": "{{ product.metafields.reviews.rating.value | escape }}",
          "ratingCount": "{{ product.metafields.reviews.review_count }}",
          "reviewCount": "{{ product.metafields.reviews.review_count }}"
        },
        {% endif %}
        "offeredBy": {
          "@type": "Organization",
          "@id": "https://{{ shop.domain }}#seller",
          "name": "{{ shop.name | escape }}",
          "url": "https://{{ shop.domain }}",
          "logo": "{{ 'logo.png' | asset_url | default: 'https://via.placeholder.com/500' }}",
          "description": "{{ shop.description | escape | default: 'Premium fitness equipment at competitive prices.' }}",
          "founder": "Timothy French",
          "foundingDate": "2010",
          "sameAs": [{% if shop.metafields.custom.social_media %}{% for link in shop.metafields.custom.social_media %}"{{ link | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}{% else %}"https://www.facebook.com/FitnessSuperstore","https://x.com/fitsuperstore","https://www.instagram.com/fitness.superstore/"{% endif %}],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "{{ shop.phone | default: 'Not specified' | escape }}",
            "contactType": "Customer Service",
            "areaServed": "{{ shop.metafields.custom.area_served | default: 'US' | escape }}",
            "availableLanguage": ["{{ shop.metafields.custom.language | default: 'English' | escape }}"]
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "{{ shop.address.street | default: 'Not specified' | escape }}",
            "addressLocality": "{{ shop.address.city | default: 'Not specified' | escape }}",
            "addressRegion": "{{ shop.address.province_code | default: 'Not specified' | escape }}",
            "postalCode": "{{ shop.address.zip | default: 'Not specified' | escape }}",
            "addressCountry": "{{ shop.address.country | default: 'Not specified' | escape }}"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://{{ shop.domain }}/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      },
      "sku": "{{ product.selected_or_first_available_variant.sku | default: product.handle | escape }}",
      "url": "https://{{ shop.domain }}{{ product.url }}"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{ shop.name | escape }}", "item": "{{ request.origin }}/" }
        {%- assign position = 2 -%}
        {%- assign all_breadcrumb_objects = product.metafields.custom.breadcrumb_paths.value | sort: "priority" -%}
        {%- assign active_path = nil -%}
        {%- assign source_flag = "unset" -%}
        {%- if collection -%}
          {%- for b_path in all_breadcrumb_objects -%}
            {%- assign b_steps = b_path.steps.value -%}
            {%- assign latest_step = b_steps.last -%}
            {%- if latest_step and latest_step.handle == collection.handle -%}
              {%- assign active_path = b_path -%}
              {%- assign source_flag = "metaobject" -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if active_path == nil -%}
          {%- for fallback_path in all_breadcrumb_objects -%}
            {%- if fallback_path.steps and fallback_path.steps.value != blank -%}
              {%- assign active_path = fallback_path -%}
              {%- assign source_flag = "metaobject" -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign crumbs_text = product.metafields.custom.breadcrumbs.value -%}
        {%- if active_path == nil and crumbs_text != blank -%}
          {%- assign source_flag = "text" -%}
        {%- endif -%}
        {%- if source_flag == "unset" and product.collections.first -%}
          {%- assign default_coll = product.collections.first -%}
          {%- assign source_flag = "default" -%}
        {%- endif -%}
        {%- if source_flag == "metaobject" -%}
          {%- assign nav_steps = active_path.steps.value -%}
          {%- assign nav_titles = active_path.custom_titles.value -%}
          {%- for nav_coll in nav_steps -%}
            {%- if nav_coll.handle != blank -%}
              ,{ "@type": "ListItem", "position": {{ position }}, "name": "{{ nav_titles[forloop.index0] | default: nav_coll.title | escape }}", "item": "{{ request.origin }}/collections/{{ nav_coll.handle }}" }
              {%- assign position = position | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif source_flag == "text" -%}
          {%- assign parts_split = crumbs_text | split: 'Home' -%}
          {%- assign text_parts = parts_split[1] | split: '>' -%}
          {%- assign crumbs_size = text_parts.size | minus: 1 -%}
          {%- for idx in (0..crumbs_size) -%}
            {%- assign raw = text_parts[idx] | strip | handleize -%}
            {%- assign title = text_parts[idx] | strip -%}
            {%- if idx > 0 and raw != blank and collections[raw] -%}
              ,{ "@type": "ListItem", "position": {{ position }}, "name": "{{ title | escape }}", "item": "{{ request.origin }}/collections/{{ raw }}" }
              {%- assign position = position | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif source_flag == "default" -%}
          ,{ "@type": "ListItem", "position": {{ position }}, "name": "{{ default_coll.title | escape }}", "item": "{{ request.origin }}/collections/{{ default_coll.handle }}" }
          {%- assign position = position | plus: 1 -%}
        {%- endif -%}
        ,{ "@type": "ListItem", "position": {{ position }}, "name": "{{ product.title | escape }}", "item": "{{ request.origin }}{{ product.url }}" }
      ]
    }
  ]
}
{%- endcapture -%}
{{- ld_json | strip_newlines -}}
</script>
{% endif %}

{% if template contains 'collection' and collection %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://{{ shop.domain }}{{ collection.url }}",
  "url": "https://{{ shop.domain }}{{ collection.url }}",
  "name": "{{ collection.title | escape }} | {{ shop.name }}",
  "inLanguage": "en",
  "description": "{{ collection.description | strip_html | strip_newlines | truncate: 400 | escape }}",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{ shop.name | escape }}",
        "item": "{{ request.origin }}/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ collection.title | escape }}",
        "item": "https://{{ shop.domain }}{{ collection.url }}"
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {% paginate collection.products by 24 %}
        {% for product in collection.products %}
          {
            "@type": "Product",
            "@id": "https://{{ shop.domain }}{{ product.url  }}",
            "name": "{{ product.title | escape }}",
            "url": "https://{{ shop.domain }}{{ product.url }}",
            "description": "{{ product.description | strip_html | strip_newlines | truncate: 400 | escape }}",
            "sku": "{{ product.selected_or_first_available_variant.sku | escape }}",
            "brand": {
              "@type": "Brand",
              "name": "{% if product.vendor %}{{ product.vendor | escape }}{% else %}{{ shop.name | escape }}{% endif %}"
            },
            "image": "{{ product.featured_image | image_url: '800x800' }}",
            "itemCondition": "https://schema.org/{% if product.metafields.custom.condition_state %}{% if product.metafields.custom.condition_state contains 'as is'%}UsedCondition{% elsif product.metafields.custom.condition_state contains 'Remanufactured'%}RefurbishedCondition{%else%}{{product.metafields.custom.condition_state}}Condition{%endif%}{% else %}NewCondition{% endif %}",
            "offers": {
              "@type": "Offer",
              "url": "https://{{ shop.domain }}{{ product.url }}",
              "price": "{{ product.price | money_without_currency | replace: ',', '' }}",
              "priceCurrency": "USD",
              "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
            }
            {% if product.metafields.reviews.rating %}
              ,
              "aggregateRating": {
                "@type": "AggregateRating",
                "@id": "{{ product.url }}#aggregaterating",
                "name": "{{ product.title | escape }}",
                "ratingValue": "{{ product.metafields.reviews.rating }}",
                "ratingCount": "{{ product.metafields.reviews.count }}",
                "reviewCount": "{{ product.metafields.reviews.count }}"
              }
            {% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      {% endpaginate %}
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}",
    "telephone": "{{ shop.phone | default: 'Not specified' | escape }}",
    "email": "sales@fitnesssuperstore.com",
    "image": "{{ settings.logo | image_url: 'master' }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "537 Stone Rd. STE F",
      "addressLocality": "Benicia",
      "addressRegion": "CA",
      "postalCode": "94510",
      "addressCountry": "US"
    }
  }
}
</script>

{% endif %}
                  

          {% if page_description %}
          <meta name="description" content="{{ page_description | escape }}">
          {% endif %}

          {% render 'meta-tags' %}

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
  
    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}
    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
      {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
      {% if forloop.index == 1 -%}
      :root,
      {%- endif %}
      .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      {% if scheme.settings.background_gradient != empty %}
      --gradient-background: {{ scheme.settings.background_gradient }};
      {% else %}
      --gradient-background: {{ scheme.settings.background }};
      {% endif %}

      {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
              assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
              assign background_color_contrast = background_color | color_lighten: 5
          else
              assign background_color_contrast = background_color | color_darken: 25
          endif
      %}

      --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
      --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
      --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
      --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
      --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
      --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
      --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
      color: rgba(var(--color-foreground));
      background-color: rgb(var(--color-background));
      line-height:24px;
      }

      :root {
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};
      --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};

      --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-heading-style: {{ settings.type_header_font.style }};
      --font-heading-weight: {{ settings.type_header_font.weight }};

      --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
      --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};

      --media-padding: {{ settings.media_padding }}px;
      --media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};
      --media-border-width: {{ settings.media_border_thickness }}px;
      --media-radius: {{ settings.media_radius }}px;
      --media-shadow-opacity: {{ settings.media_shadow_opacity | divided_by: 100.0 }};
      --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset }}px;
      --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset }}px;
      --media-shadow-blur-radius: {{ settings.media_shadow_blur }}px;
      --media-shadow-visible: {% if settings.media_shadow_opacity > 0 %}1{% else %}0{% endif %};

      --page-width: {{ settings.page_width | divided_by: 10 }}rem;
      --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;

      --product-card-image-padding: {{ settings.card_image_padding | divided_by: 10.0 }}rem;
      --product-card-corner-radius: {{ settings.card_corner_radius | divided_by: 10.0 }}rem;
      --product-card-text-alignment: {{ settings.card_text_alignment }};
      --product-card-border-width: {{ settings.card_border_thickness | divided_by: 10.0 }}rem;
      --product-card-border-opacity: {{ settings.card_border_opacity | divided_by: 100.0 }};
      --product-card-shadow-opacity: {{ settings.card_shadow_opacity | divided_by: 100.0 }};
      --product-card-shadow-visible: {% if settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
      --product-card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
      --product-card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset | divided_by: 10.0 }}rem;
      --product-card-shadow-blur-radius: {{ settings.card_shadow_blur | divided_by: 10.0 }}rem;

      --collection-card-image-padding: {{ settings.collection_card_image_padding | divided_by: 10.0 }}rem;
      --collection-card-corner-radius: {{ settings.collection_card_corner_radius | divided_by: 10.0 }}rem;
      --collection-card-text-alignment: {{ settings.collection_card_text_alignment }};
      --collection-card-border-width: {{ settings.collection_card_border_thickness | divided_by: 10.0 }}rem;
      --collection-card-border-opacity: {{ settings.collection_card_border_opacity | divided_by: 100.0 }};
      --collection-card-shadow-opacity: {{ settings.collection_card_shadow_opacity | divided_by: 100.0 }};
      --collection-card-shadow-visible: {% if settings.collection_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
      --collection-card-shadow-horizontal-offset: {{ settings.collection_card_shadow_horizontal_offset | divided_by: 10.0 }}rem;
      --collection-card-shadow-vertical-offset: {{ settings.collection_card_shadow_vertical_offset | divided_by: 10.0 }}rem;
      --collection-card-shadow-blur-radius: {{ settings.collection_card_shadow_blur | divided_by: 10.0 }}rem;

      --blog-card-image-padding: {{ settings.blog_card_image_padding | divided_by: 10.0 }}rem;
      --blog-card-corner-radius: {{ settings.blog_card_corner_radius | divided_by: 10.0 }}rem;
