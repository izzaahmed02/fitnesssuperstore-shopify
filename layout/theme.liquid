    margin-bottom: 16px;
}

.addon-popup {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  font-family: inherit;
}

/* Overlay */
.addon-popup-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}

/* Popup Box */
.addon-popup-box {
  position: relative;
  background: #fff;
  width: 90%;
  max-width: 620px;
  max-height: 85vh;
  margin: auto;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

/* Header */
.addon-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #e5e5e5;
}

.addon-popup-header h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
}

.addon-popup-close {
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
  line-height: 1;
}

/* Content */
.addon-popup-content {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
}

/* Ensure accordion spacing looks good */
.addon-popup-content .customproduct_option {
  margin: 0;
}

.addon-popup-content .accordion {
  border-bottom: 1px solid #eaeaea;
  padding: 12px 0;
}

/* Footer */
.addon-popup-footer {
  position: sticky;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 20px;
  border-top: 1px solid #e5e5e5;
  background: #fff;
}

/* Buttons */
.addon-btn {
  min-width: 120px;
  padding: 10px 16px;
  font-size: 14px;
  border-radius: 6px;
  cursor: pointer;
  border: none;
  width:50%;
}

.addon-btn.primary {
  background: #f0592a;
  color: #fff;
}

.addon-btn.primary:hover {
  background: #000;
}

.addon-btn.secondary {
    background: transparent;
    color: #333;
    border: 1.5px solid #D3D9E5 !important;
}

.addon-btn.secondary:hover {
  background: #e5e5e5;
}

/* Mobile adjustments */
@media (max-width: 640px) {
  .addon-popup-box {
    width: 95%;
    max-height: 90vh;
  }

  .addon-popup-footer {
    flex-direction: column;
  }

  .addon-btn {
    width: 100%;
  }
}



/* ===============================
   BUTTON LOADER
================================ */
.cart-modify-addon {
  position: relative;
}

.cart-modify-addon.loading {
  pointer-events: none;
  opacity: 0.7;
}

.cart-modify-addon .btn-loader {
  display: none;
  width: 14px;
  height: 14px;
  border: 2px solid #000;
  border-top-color: transparent;
  border-radius: 50%;
  position: absolute;
  right: 8px;
  top: 32%;
  transform: rotate(360deg);
  animation: spin 0.8s linear infinite;
}

.cart-modify-addon.loading .btn-loader {
  display:block;
}

/* ===============================
   POPUP FULL LOADER
================================ */
.addon-popup-loader {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.75);
  z-index: 50;
  display: none;
  align-items: center;
  justify-content: center;
}

.addon-popup-loader.active {
  display: flex;
}

.addon-popup-loader .spinner {
  width: 42px;
  height: 42px;
  border: 4px solid #000;
  border-top-color: #111;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); 
  }
}

