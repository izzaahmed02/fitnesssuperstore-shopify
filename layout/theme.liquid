<!DOCTYPE html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head-meta' %}

    <title>{{- page_title | escape_once -}}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}</title>

    {% render 'google-tag-manager-head' %}
    {% render 'schema-ld-json' %}

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'stylesheet-tags' %}
    {% render 'script-tags' %}

      {% render 'css-variables' %}
{% if template == 'index' %}
  <style>
    @media (max-width: 990px) {
      .grid-container.page-width {
        padding: 0px !important;
      }
    }
  </style>
{% endif %}
    {{ content_for_header }}

  </head>

  <body class="accessibility-mode page-width-desktop page-width-index gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %} {% if template contains 'page' %} {{ page.template_suffix }} page-{{ page.handle }}{% endif %}">
    {% render 'google-tag-manager-body' %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

   
      {% sections 'header-group' %}
 

    {% if settings.show_sidebar_menu %}
      <div class="content layout-side-menu">
        {% render 'header-sidebar-menu' %}
    {% endif %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- comment -%} Template-specific modals and banners {%- endcomment -%}
      {% render 'template-modals' %}
      {% render 'template-offers' %}

      {%- comment -%} MAIN CONTENT LAYOUT - content_for_layout MUST be in main template {%- endcomment -%}
      {% if request.page_type == 'page' and page.metafields.layout.narrow == true %}
        <div class="page-narrow-layout">
          {{ content_for_layout }}
        </div>
      {% elsif request.page_type == 'page' or request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'search' %}
        <style>
          @media only screen and (min-width: 990px) {
            .side-bar-comtainer {
              position: relative;
              display: flex;
              gap: 0px!important;
              align-items: flex-start;
            }
            .side-bar-comtainer .inner-container {
              flex: 1 1 0%;
              max-width: calc(100% - 236px);
            }
            .side-bar-comtainer .sidebarmenu {
              flex: 0 0 236px;
            }
          }
        </style>

        <div class="{% unless template == 'page.goaffpro-create' %} grid-container {% endunless %} {% if request.page_type == 'collection' or request.page_type == 'search' %} collection-layout {% endif %} {% if request.page_type == 'product' %} product-layout {% endif %} {% unless template == 'page.comparison-inner' or page.template_suffix == 'blog' %} side-bar-comtainer {% endunless %}">
          {% unless template == 'page.comparison-inner' or page.template_suffix == 'blog' %}
            <aside class="sidebarmenu">
              {% render 'header-sidebar-menu' %}
            </aside>
          {% endunless %}

          <div class="inner-container {% if page.template_suffix == 'blog' %} blogPage{% endif %}">
            {{ content_for_layout }}
          </div>
        </div>
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% if settings.show_sidebar_menu %}
      </div>
    {% endif %}

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% render 'body-scripts' %}
    {% render 'modals-and-templates' %}
        
        {%- if settings.predictive_search_enabled -%}
          <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
        {%- endif -%}
    {%- render 'optimization', postpone_loading: 'reset' -%}

<script>
(function() {
  var ua = navigator.userAgent || "";
  if (ua.includes("Chrome-Lighthouse") || ua.includes("Page Speed Insights")) {
    return;
  }

  var injected = false;

  function injectNonCriticalVendors() {
    if (injected) return;
    injected = true;

    if (!document.getElementById('gorgias-chat-widget-install-v3')) {
      var g = document.createElement("script");
      g.id = "gorgias-chat-widget-install-v3";
      g.src = "https://config.gorgias.chat/bundle-loader/01K99R9MBC365Z3RW2GPE0EGSQ";
      g.defer = true;
      document.head.appendChild(g);
    }

    if (!document.getElementById('convert-bundle-loader')) {
      var c = document.createElement("script");
      c.id = "convert-bundle-loader";
      c.src = "https://cdn.9gtb.com/loader.js?g_cvt_id=96541d45-9050-46e9-90bb-874d67c6ed47";
      c.defer = true;
      document.head.appendChild(c);
    }

    ['scroll','mousemove','touchstart','keydown','click'].forEach(function(evt) {
      window.removeEventListener(evt, injectNonCriticalVendors, { passive: true });
    });
  }

  ['scroll','mousemove','touchstart','keydown','click'].forEach(function(evt) {
    window.addEventListener(evt, injectNonCriticalVendors, { once: true, passive: true });
  });

  window.addEventListener('load', function() {
    window.setTimeout(injectNonCriticalVendors, 1500);
  }, { once: true });
})();
</script>

<script>
(function() {
  function waitForGorgiasLoaded(timeoutMs) {
    return new Promise(function(resolve) {
      if (window.GorgiasChat) {
        resolve();
        return;
      }

      var done = false;
      var timer = window.setTimeout(function() {
        if (done) return;
        done = true;
        resolve();
      }, timeoutMs || 8000);

      window.addEventListener("gorgias-widget-loaded", function() {
        if (done) return;
        done = true;
        window.clearTimeout(timer);
        resolve();
      }, { once: true });
    });
  }

  waitForGorgiasLoaded(8000).then(function() {
    try {
      if (!window.GorgiasChat || typeof window.GorgiasChat.updateTexts !== "function") return;

      var chatDict = {
        contactFormIntro: "Thank you for reaching out! Our office is currently closed, but we're here to assist you as soon as we're back online.<br><br><strong>Our office hours (Pacific Time Zone):</strong><br><br>Mon to Fri: 7:00 AM – 6:00 PM PST<br>Saturday: 7:30 AM – 5:00 PM PST<br>Sunday: 12:00 PM – 5:00 PM PST<br><br>Please feel free to leave your message, and we’ll get back to you promptly during our next available hours.<br><br>You can also email us at <a href='mailto:sales@fitnesssuperstore.com'>sales@fitnesssuperstore.com</a>."
      };

      window.GORGIAS_CHAT_TEXTS = Object.assign({}, window.GORGIAS_CHAT_TEXTS || {}, chatDict);
      window.GorgiasChat.updateTexts(chatDict);
    } catch (e) {}
  });
})();
</script>


{% if template contains 'collection' %}
  <div style="display: none;">
    <!-- Start of Judge.me code -->
      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->
  
  </div>
<script>
</script>
{% endif %}
  </body>
</html>
