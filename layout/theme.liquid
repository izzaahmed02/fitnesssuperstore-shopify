<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head-meta' %}
     
    <title>
      {{ page_title | escape_once }}
      {% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
      {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    </title>

    {% render 'google-tag-manager-head' %}
    {% comment %} {% render 'schema-ld-json' %} {% endcomment %}

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'stylesheet-tags' %}
    {% render 'script-tags' %}

      {% render 'css-variables' %}
{% if template == 'index' %}
  <style>
    @media (max-width: 990px) {
      .grid-container.page-width {
        padding: 0px !important;
    }
  </style>
{% endif %}
    {{ content_for_header }}
  </head>

  <body class="accessibility-mode page-width-desktop page-width-index gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %} {% if template contains 'page' %} page-{{ page.handle }}{% endif %}">
    {% render 'google-tag-manager-body' %}
    
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% unless template == 'page.goaffpro-create' %}
      {% sections 'header-group' %}  
    {% endunless %}

    {% if settings.show_sidebar_menu %}
      <div class="content layout-side-menu">
        {% render 'header-sidebar-menu' %}
    {% endif %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- comment -%} Template-specific modals and banners {%- endcomment -%}
      {% render 'template-modals' %}
      {% render 'template-offers' %}
      
      {%- comment -%} MAIN CONTENT LAYOUT - content_for_layout MUST be in main template {%- endcomment -%}
      {% if request.page_type == 'page' and page.metafields.layout.narrow == true %}
        <div class="page-narrow-layout">
          {{ content_for_layout }}
        </div>
      {% elsif request.page_type == 'page' or request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'search' %}
        <style>
          @media only screen and (min-width: 990px) {
            .side-bar-comtainer { 
              position: relative;
              display: flex;
              gap: 0px!important;
              align-items: flex-start;
            }
            .side-bar-comtainer .inner-container {
              flex: 1 1 0%;
              max-width: calc(100% - 236px);
            }
            .side-bar-comtainer .sidebarmenu {
              flex: 0 0 236px;
            }
          }
        </style>
        
        <div class="{% unless template == 'page.goaffpro-create' %} grid-container {% endunless %} {% if request.page_type == 'collection' or request.page_type == 'search' %} collection-layout {% endif %} {% if request.page_type == 'product' %} product-layout {% endif %} {% unless template == 'page.goaffpro-create' %} side-bar-comtainer {% endunless %}">
          {% unless template == 'page.goaffpro-create' %}
            <aside class="sidebarmenu">
              {% render 'header-sidebar-menu' %}
            </aside>
          {% endunless %}

          <div class="inner-container">
            {{ content_for_layout }} 
          </div>
        </div>
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% if settings.show_sidebar_menu %}
      </div>
    {% endif %}

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% render 'body-scripts' %}
    {% render 'modals-and-templates' %}
    {%- render 'optimization', postpone_loading: 'reset' -%}

    <script>
setTimeout(function() {
  document.querySelector('.smobile-gallery-wrapper.only-mobile').style.display = 'block';
}, 3000);
    </script>

    <script>
setTimeout(function() {
  // First, prevent the cart drawer from opening by intercepting its open method
  var cartDrawer = document.querySelector('cart-drawer');
  if (cartDrawer && cartDrawer.open) {
    var originalOpen = cartDrawer.open;
    cartDrawer.open = function() {
      console.log('Cart drawer open blocked');
      // Do nothing - block the drawer from opening
    };
  }

  var btns = document.querySelectorAll('.product-form__submit.button.button--full-width.button--primary');
  
  btns.forEach(function(btn) {
    if (btn.__customNavHandled) return;
    btn.__customNavHandled = true;
    
    btn.addEventListener('click', function(e) {
      console.log("Button ATC Clicked");
      
      var origOpen = XMLHttpRequest.prototype.open;
      var origSend = XMLHttpRequest.prototype.send;
      
      XMLHttpRequest.prototype.open = function() {
        if (arguments[1] && typeof arguments[1] === 'string' && arguments[1].indexOf('/cart/add') !== -1) {
          this.__isCartAdd = true;
        }
        return origOpen.apply(this, arguments);
      };
      
      XMLHttpRequest.prototype.send = function() {
        if (this.__isCartAdd) {
          this.addEventListener('load', function() {
            if (this.status >= 200 && this.status < 300) {
              // Immediately redirect on successful cart add
              window.location.href = '/cart';
            }
          });
        }
        return origSend.apply(this, arguments);
      };
      
      // Fallback redirect
      setTimeout(function() {
        XMLHttpRequest.prototype.open = origOpen;
        XMLHttpRequest.prototype.send = origSend;
        window.location.href = '/cart';
      }, 1500);
      
    }, true);
  });
}, 3000);
    </script>
  </body>
</html>
