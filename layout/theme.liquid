{% comment %} <script>
document.addEventListener("DOMContentLoaded", function () {

  const basePrice = {{ product.selected_or_first_available_variant.price | money_without_currency }};
  alert(basePrice);
  const radios = document.querySelectorAll(".addon-radio");
  const totalBox = document.getElementById("final-price");

  let selectedAddonId = null;
  let selectedAddonPrice = 0;

  function updatePrice() {
    selectedAddonPrice = 0;
    selectedAddonId = null;

    radios.forEach(radio => {
      if (radio.checked) {
        selectedAddonPrice = parseFloat(radio.dataset.price);
        selectedAddonId = radio.dataset.addonId;
      }
    });

    const total = basePrice + selectedAddonPrice;
    totalBox.innerText = "₹" + total.toFixed(2);
  }

  radios.forEach(r => r.addEventListener("change", updatePrice));
  updatePrice();

  /* 🔥 OVERRIDE ADD TO CART */
  const form = document.querySelector('form[action="/cart/add"]');

  form.addEventListener("submit", function (e) {
    e.preventDefault();

    const mainVariantId = {{ product.selected_or_first_available_variant.id }};

    let items = [
      { id: mainVariantId, quantity: 1 }
    ];

    if (selectedAddonId) {
      items.push({
        id: selectedAddonId,
        quantity: 1
      });
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items })
    })
    .then(() => {
      window.location.href = "/cart";
    });
  });

});
</script> {% endcomment %}

<script>
document.addEventListener("click", async function(e){

  const removeBtn = e.target.closest(".cart-item__remove");
  if(!removeBtn) return;

  e.preventDefault();

  const lineIndex = Number(removeBtn.dataset.index);

  const cart = await fetch('/cart.js').then(r => r.json());

  const parent = cart.items[lineIndex - 1];
  if(!parent) return location.reload();

  const groupId = parent.properties?.group_id;
  if(!groupId) return location.reload();

  let updates = {};

  cart.items.forEach((item, i)=>{
      if(item.properties && item.properties.group_id == groupId){
          updates[i+1] = 0;
      }
  });

  await fetch('/cart/update.js',{
      method:"POST",
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ updates })
  });

  location.reload();
});

</script>
