{% doc %}
  @prompt
    a caraousel of logos with blocks
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-logo-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-carousel__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-logo-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-logo-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    align-items: center;
  }

  .ai-logo-carousel__track-{{ ai_gen_id }}.ai-carousel-animate-{{ ai_gen_id }} {
    animation: ai-logo-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-logo-carousel__slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
    background-color: {{ block.settings.logo_background }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-logo-carousel__slide-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-logo-carousel__image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    {% if block.settings.grayscale %}
      filter: grayscale(100%);
      transition: filter 0.3s ease;
    {% endif %}
  }

  {% if block.settings.grayscale %}
    .ai-logo-carousel__slide-{{ ai_gen_id }}:hover .ai-logo-carousel__image-{{ ai_gen_id }} {
      filter: grayscale(0%);
    }
  {% endif %}

  .ai-logo-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-logo-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-logo-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-logo-carousel__button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-logo-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-logo-carousel__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @keyframes ai-logo-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - {{ block.settings.logo_spacing | divided_by: 2.0 }}px));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-carousel__slide-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.7 }}px;
      height: {{ block.settings.logo_height | times: 0.7 }}px;
    }

    .ai-logo-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<logo-carousel-{{ ai_gen_id }} class="ai-logo-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-logo-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-logo-carousel__track-wrapper-{{ ai_gen_id }}">
      <div class="ai-logo-carousel__track-{{ ai_gen_id }} {% if block.settings.auto_scroll %}ai-carousel-animate-{{ ai_gen_id }}{% endif %}" data-track>
        {% for i in (1..8) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign link_key = 'logo_link_' | append: i
            assign logo_image = block.settings[logo_key]
            assign logo_link = block.settings[link_key]
          %}

          {% if logo_image %}
            <div class="ai-logo-carousel__slide-{{ ai_gen_id }}">
              {% if logo_link != blank %}
                <a href="{{ logo_link }}" rel="noopener">
                  <img
                    src="{{ logo_image | image_url: width: 400 }}"
                    alt="{{ logo_image.alt | escape }}"
                    class="ai-logo-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ logo_image.width }}"
                    height="{{ logo_image.height }}"
                  >
                </a>
              {% else %}
                <img
                  src="{{ logo_image | image_url: width: 400 }}"
                  alt="{{ logo_image.alt | escape }}"
                  class="ai-logo-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ logo_image.width }}"
                  height="{{ logo_image.height }}"
                >
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% if block.settings.auto_scroll %}
          {% for i in (1..8) %}
            {% liquid
              assign logo_key = 'logo_' | append: i
              assign link_key = 'logo_link_' | append: i
              assign logo_image = block.settings[logo_key]
              assign logo_link = block.settings[link_key]
            %}

            {% if logo_image %}
              <div class="ai-logo-carousel__slide-{{ ai_gen_id }}">
                {% if logo_link != blank %}
                  <a href="{{ logo_link }}" rel="noopener">
                    <img
                      src="{{ logo_image | image_url: width: 400 }}"
                      alt="{{ logo_image.alt | escape }}"
                      class="ai-logo-carousel__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="{{ logo_image.width }}"
                      height="{{ logo_image.height }}"
                    >
                  </a>
                {% else %}
                  <img
                    src="{{ logo_image | image_url: width: 400 }}"
                    alt="{{ logo_image.alt | escape }}"
                    class="ai-logo-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ logo_image.width }}"
                    height="{{ logo_image.height }}"
                  >
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-logo-carousel__controls-{{ ai_gen_id }}">
        <button class="ai-logo-carousel__button-{{ ai_gen_id }}" data-prev aria-label="Previous">
          <svg xmlns="https://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-logo-carousel__button-{{ ai_gen_id }}" data-next aria-label="Next">
          <svg xmlns="https://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</logo-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.autoScroll = {{ block.settings.auto_scroll | json }};
        this.currentIndex = 0;
        this.slideWidth = {{ block.settings.logo_width }} + {{ block.settings.logo_spacing }};
      }

      connectedCallback() {
        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.scrollPrev());
          this.nextButton.addEventListener('click', () => this.scrollNext());
        }

        if (this.autoScroll && this.track) {
          this.track.addEventListener('mouseenter', () => this.pauseAnimation());
          this.track.addEventListener('mouseleave', () => this.resumeAnimation());
        }
      }

      scrollPrev() {
        if (this.autoScroll) {
          this.track.classList.remove('ai-carousel-animate-{{ ai_gen_id }}');
        }
        this.currentIndex = Math.max(0, this.currentIndex - 1);
        this.updatePosition();
      }

      scrollNext() {
        if (this.autoScroll) {
          this.track.classList.remove('ai-carousel-animate-{{ ai_gen_id }}');
        }
        const visibleSlides = this.track.children.length / 2;
        const maxIndex = Math.floor(visibleSlides) - 1;
        this.currentIndex = Math.min(maxIndex, this.currentIndex + 1);
        this.updatePosition();
      }

      updatePosition() {
        this.track.style.transform = `translateX(-${this.currentIndex * this.slideWidth}px)`;
      }

      pauseAnimation() {
        this.track.style.animationPlayState = 'paused';
      }

      resumeAnimation() {
        this.track.style.animationPlayState = 'running';
      }
    }

    customElements.define('logo-carousel-{{ ai_gen_id }}', LogoCarousel{{ ai_gen_id }});
  })();
</script>

