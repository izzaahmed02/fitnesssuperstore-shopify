      "blocks": {
        "collapsible_row_hnXGQM": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When was Fitness Superstore established?",
            "icon": "none",
            "row_content": "<p><strong>Founded in 2010, Fitness Superstore Inc. set out to be one of the largest fitness equipment retailers in the United States</strong>. In 2013, the company became an S-Corp, marking a major step forward in its growth and presence in the global fitness industry.</p>",
            "page": "",
            "disable_accordion": false,
            "open_collapsible_row": true
          }
        },
        "collapsible_row_epc7Vc": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What type of business is Fitness Superstore?",
            "icon": "none",
            "row_content": "<p><strong>Fitness Superstore is a leading retailer of fitness and gym equipment</strong>, offering both brand new and professionally remanufactured machines. Serving home users and commercial facilities alike, it provides quality products from top industry brands at competitive prices.</p>",
            "page": "",
            "disable_accordion": false,
            "open_collapsible_row": true
          }
        },
        "collapsible_row_JexmV4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes Fitness Superstore different from other fitness equipment retailers?",
            "icon": "none",
            "row_content": "<p>Fitness Superstore stands out with 14 years of trusted service, top-rated support, and full-service options at competitive prices. We offer extensive warranties, fast response times, and consistently earn 5-star reviews across platforms from happy customers worldwide.</p>",
            "page": "",
            "disable_accordion": false,
            "open_collapsible_row": false
          }
        },
        "collapsible_row_RTpAXe": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does Fitness Superstore offer services for commercial and B2B customers?",
            "icon": "none",
            "row_content": "<p>Yes, Fitness Superstore offers full-service solutions for commercial and B2B clients, including delivery, assembly, and global shipping. We also provide extensive customization options—from paint and upholstery to logo engraving—tailored to your brand and facility needs.</p>",
            "page": "",
            "disable_accordion": false,
            "open_collapsible_row": false
          }
        },
        "collapsible_row_GaBwiB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What brands does Fitness Superstore carry?",
            "icon": "none",
            "row_content": "<p>Fitness Superstore carries 30 top fitness brands, including Life Fitness, Precor, Technogym, Hammer Strength, Stairmaster, French Fitness, and many more. Our wide selection ensures you’ll find the perfect equipment for both home and commercial fitness needs.</p>",
            "page": "",
            "disable_accordion": false,
            "open_collapsible_row": false
          }
        }
