    "grid_info_blocks_cgRy9m": {
      "type": "grid-info-blocks",
      "blocks": {
        "block_7rgEAm": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/8b4eb90f7b58bf4b08c86644c2732621_9d027b53-809f-4b38-8d4d-84d6a887f513.png",
            "title": "Remanufactured Equipment",
            "text": "<p>Marketed at 70% off their retail prices, we carry a long list of industry-trusted brands that are remanufactured cosmetically and mechanically to like-new condition.</p>",
            "link_text": "See more",
            "link_url": "#popup",
            "target_id": "",
            "popup_title": "Remanufactured Equipment",
            "popup_text": "Marketed at 70% off their retail prices, we carry a long list of industry-trusted brands, including Cybex, Precor, Life Fitness, Technogym, Matrix, Stairmaster, Star Trac, and Woodway. The equipment is taken from commercial fitness facilities that are upgrading or are closing their doors. We then remanufacture them to like-new condition. <br><br>\n\nAll remanufactured machines include a 1 year warranty covering parts and on-site labor. We also offer extended warranties of 2, 3, 4, and 5 years parts & on site labor. This will guarantee your machine works like a brand new machine for the period of the warranty. Is your machine squeaking? Heart rate not working? Is the screen not responding quickly? Call us, we will send a technician to your house free of charge.",
            "popup_link_text": "Learn more about our remanufactured products here.",
            "popup_link_url": "shopify://pages/remanufactured-gym-equipment",
            "video_url": "https://www.youtube.com/watch?v=SRmm8j6NY8M",
            "cover_image": "shopify://shop_images/38f5b71ad796e2980e8d0c0c5622d7f4.png",
            "order": "second"
          }
        },
        "block_Vkc66J": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/c1ea2cb8cfaf5e02b93aa007fbe97bda_1.png",
            "title": "French Fitness",
            "text": "<p>Fitness Superstore is the exclusive dealer of French Fitness, offering everything you need for a commercial or home gym.</p>",
            "link_text": "See more",
            "link_url": "#popup",
            "target_id": "",
            "popup_title": "French Fitness",
            "popup_text": "In 2019, Fitness Superstore Inc developed French Fitness, its own brand of gym equipment and currently stands as its exclusive dealer. French Fitness offers everything you need for a commercial or home gym– from gym flooring to treadmills, ellipticals, exercise bikes, steppers, stair mills, rowers, air bikes, and strength training equipment including cross training equipment, rack and rig systems, selectorized equipment, plate loaded equipment, free weights, benches, multi functional equipment, gym accessories and attachments, plyo and speed training, and more. <br><br>\n\nFrench Fitness products are assembled in the USA. They pride themselves for delivering industry-standard quality, excellent customer service, extensive warranties (10 year parts, 1 year labor).",
            "popup_link_text": "See more of our French Fitness equipment here.",
            "popup_link_url": "shopify://pages/fs-ff-landing-page",
            "video_url": "https://youtu.be/17M_YKuGCeo?si=Ral9ultyt3xUBGML",
            "cover_image": "shopify://shop_images/maxresdefault_1.jpg",
            "order": "first"
          }
        },
        "block_cDEexk": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/5016ad755272cc43c5edb578256251df_896840f8-5a4a-4ab7-aa3e-d2dccca5ccc2.png",
            "title": "New Equipment",
            "text": "<p>We are an official distributor of some of the most popular fitness equipment brands in the market, providing full factory warranties and a variety of shipping options.</p>",
            "link_text": "See more",
            "link_url": "#popup",
            "target_id": "",
            "popup_title": "New Equipment",
            "popup_text": "We are an authorized distributor for top brands such as Body-Solid, Concept2, Dynamic Fitness, Golden Designs, Jacobs Ladder, Marpo Kinetics, Nautilus, PowerBlock, Power Plate, SportsArt, Stairmaster, Star Trac, Schwinn, Throwdown, Versaclimber, and French Fitness - our brand. Each machine comes with full manufacturer warranties, providing our customers with the best deals.",
            "popup_link_text": "Check out our brand new products here.",
