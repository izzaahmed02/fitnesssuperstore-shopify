        "block_xJEE3B": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_6.png",
            "title": "Established Industry Leader",
            "text": "<p>As a growing company with over 100 expert staff, we have solidified our position as a trusted gym equipment manufacturer in the country.</p>",
