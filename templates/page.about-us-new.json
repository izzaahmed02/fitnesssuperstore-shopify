            "title": "Top-Rated Across Platforms",
            "text": "<p>Trusted by thousands of clients worldwide, our consistent 5-star ratings reflect unwavering customer satisfaction.</p>",
            "image_below1": "shopify://shop_images/image_248_2fb5170f-4dea-43f0-b650-7eb03aa1b1d6.png",
            "image_below_link_url_1": "https://www.trustpilot.com/review/www.fitnesssuperstore.com",
