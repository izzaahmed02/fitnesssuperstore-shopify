    "grid_info_blocks_cgRy9m": {
      "type": "grid-info-blocks",
      "blocks": {
        "block_Vkc66J": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/Nationwide_Shipping.png",
            "title": "Shipping Info",
            "text": "<p>Fast, insured delivery across the United States handled by trusted logistics partners.</p>",
            "link_text": "Learn More",
            "link_url": "shopify://pages/shipping-information",
            "target_id": "",
            "popup_title": "French Fitness",
            "popup_text": "In 2019, Fitness Superstore developed French Fitness, its own brand of gym equipment and currently stands as its exclusive dealer. French Fitness offers everything you need for a commercial or home gym– from gym flooring to treadmills, ellipticals, exercise bikes, steppers, stair mills, rowers, air bikes, and strength training equipment including cross training equipment, rack and rig systems, selectorized equipment, plate loaded equipment, free weights, benches, multi functional equipment, gym accessories and attachments, plyo and speed training, and more. <br><br>\n\nFrench Fitness products are assembled in the USA. They pride themselves for delivering industry-standard quality, excellent customer service, extensive warranties (10 year parts, 1 year labor).",
            "popup_link_text": "See more of our French Fitness equipment here.",
            "popup_link_url": "shopify://pages/french-fitness-overview",
            "video_url": "https://youtu.be/17M_YKuGCeo?si=Ral9ultyt3xUBGML",
            "cover_image": "shopify://shop_images/maxresdefault_1.jpg",
            "order": "first"
          }
        },
        "block_7rgEAm": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/AdobeStock_637162437.jpg",
            "title": "Warranty",
            "text": "<p>Comprehensive coverage backed by certified technicians and genuine replacement parts.</p>",
            "link_text": "Learn More",
            "link_url": "shopify://pages/warranty",
            "target_id": "",
            "popup_title": "Remanufactured Equipment",
            "popup_text": "Marketed at 70% off their retail prices, we carry a long list of industry-trusted brands, including Cybex, Precor, Life Fitness, Technogym, Matrix, Stairmaster, Star Trac, and Woodway. The equipment is taken from commercial fitness facilities that are upgrading or are closing their doors. We then remanufacture them to like-new condition. <br><br>\n\nAll remanufactured machines include a 1 year warranty covering parts and on-site labor. We also offer extended warranties of 2, 3, 4, and 5 years parts & on site labor. This will guarantee your machine works like a brand new machine for the period of the warranty. Is your machine squeaking? Heart rate not working? Is the screen not responding quickly? Call us, we will send a technician to your house free of charge.",
            "popup_link_text": "Learn more about our remanufactured products here.",
            "popup_link_url": "shopify://pages/remanufactured-gym-equipment",
            "video_url": "https://www.youtube.com/watch?v=SRmm8j6NY8M",
            "cover_image": "shopify://shop_images/38f5b71ad796e2980e8d0c0c5622d7f4.png",
            "order": "second"
          }
        },
        "block_cDEexk": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/handsome-man-is-engaged-gym.jpg",
            "title": "Financing",
            "text": "<p>Flexible payment options that make owning premium fitness equipment simple and affordable.</p>",
            "link_text": "Learn More",
            "link_url": "shopify://pages/financing",
            "target_id": "",
            "popup_title": "New Equipment",
            "popup_text": "We are an authorized distributor for top brands such as Body-Solid, Concept2, Dynamic Fitness, Golden Designs, Jacobs Ladder, Marpo Kinetics, Nautilus, PowerBlock, Power Plate, SportsArt, Stairmaster, Star Trac, Schwinn, Throwdown, Versaclimber, and French Fitness - our brand. Each machine comes with full manufacturer warranties, providing our customers with the best deals.",
            "popup_link_text": "Check out our brand new products here.",
            "popup_link_url": "shopify://pages/new-equipment-page",
            "video_url": "",
            "order": "first"
          }
        }
      },
