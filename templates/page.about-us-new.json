            "stars": "5",
            "title": "",
            "copy": "Fitness Superstore has an amazing staff! I love their customer service! The best!",
            "author": "Rick A."
          }
        },
        "card_zkkfRd": {
          "type": "card",
          "settings": {
            "tab_handle": "company",
            "tab_title": "Company Reviews",
            "stars": "5",
            "title": "",
            "copy": "Delivery was tracked perfectly. Arrived on time in perfect condition. Packaging well protected the product from any damage from delivery.",
            "author": "Lori R."
          }
        },
        "card_gmy4zV": {
          "type": "card",
          "settings": {
            "tab_handle": "product",
            "tab_title": "Product Reviews",
            "stars": "5",
            "title": "Great machine for the price",
            "copy": "We researched stair mills for over a year before buying this one. We absolutely love it. Commercial quality at a reasonable price and the steps are big enough for larger feet (husband is size 13). If you are putting this anywhere but a garage gym you definitely will need to pay for the moving fee. We were able to pop it right into our garage gym with a pallet jack but it is HEAVY and you could not get it up or down stairs on your own!",
            "author": "Deanna S."
          }
        },
        "card_UtBPMW": {
          "type": "card",
          "settings": {
            "tab_handle": "product",
            "tab_title": "Product Reviews",
            "stars": "5",
            "title": "",
            "copy": "Amazing equipment! Our staff and members love this new equipment!",
            "author": "Rick A."
          }
        },
        "card_nkfgHU": {
          "type": "card",
          "settings": {
            "tab_handle": "product",
            "tab_title": "Product Reviews",
            "stars": "5",
            "title": "",
            "copy": "It has only been two months, but it has worked great and our members love it!",
            "author": "Michael D."
          }
        },
        "card_dGbfYC": {
          "type": "card",
          "settings": {
            "tab_handle": "product",
            "tab_title": "Product Reviews",
            "stars": "5",
            "title": "",
            "copy": "This French Fitness FFB Black Dual Adjustable Pulley system arrived just as advertised. Our firefighters utilize this machine on a daily basis and love it! The quality and value of this machine is unmatched.",
            "author": "John I."
          }
        },
        "card_6V7eUf": {
          "type": "card",
          "settings": {
            "tab_handle": "product",
            "tab_title": "Product Reviews",
            "stars": "5",
            "title": "Old school - is good school.",
            "copy": "If you like the 'old fashioned' Stairmaster - this is the place to get it. Delivery was a breeze and the product and service have both been first rate. We had a small problem that was promptly resolved (free) and the machine has been working like a champ since then. Great item.",
            "author": "Tckj"
          }
        }
      },
