          }
        },
        "card_Mcmwag": {
          "type": "card",
          "settings": {
            "tab_handle": "company",
            "tab_title": "Company Reviews",
            "stars": "5",
            "title": "",
            "copy": "I only do business with fitnesssuperstore.com when it comes to all my workout needs. They have the best prices and by far the best customer service I have ever had to work with. Which is also why I always come back to them for all my gym purchases.",
            "author": "HILLARY S."
          }
        },
        "card_i4C6e6": {
          "type": "card",
          "settings": {
            "tab_handle": "company",
