    "faq_showroom": {
      "type": "faq-warehouse",
      "blocks": {
        "faq_call": {
          "type": "faq",
          "settings": {
            "title": "Do I need to call before visiting?",
            "copy": "<p>We recommend it. Inventory rotates as equipment arrives and sells, so calling ahead or submitting the form above confirms your model is on the floor before you drive out.</p>"
          }
        },
        "faq_appointment": {
          "type": "faq",
          "settings": {
            "title": "Can I visit without an appointment?",
            "copy": "<p>Yes. Walk-ins are welcome during showroom hours, Monday through Friday, 8 AM to 3:30 PM. Because inventory rotates and staff availability can vary for unscheduled visits, we still recommend calling ahead or submitting the form above so we can confirm the model you want is on the floor.</p>"
          }
        },
        "faq_stone_rd": {
          "type": "faq",
          "settings": {
            "title": "Is 537 Stone Road open to visitors?",
            "copy": "<p>No. 537 Stone Road is our operations, remanufacturing, and outbound shipping facility and is not open to the public. All showroom visits are at 457 Industrial Way, Benicia, CA 94510.</p>"
          }
        },
        "faq_remote": {
          "type": "faq",
          "settings": {
            "title": "What if I'm not local to Benicia?",
            "copy": "<p>Request a live or recorded video walkthrough and our team will show you equipment remotely, compare options, and answer your questions before you order.</p>"
          }
        }
      },
      "block_order": [
        "faq_call",
        "faq_appointment",
        "faq_stone_rd",
        "faq_remote"
      ],
      "custom_css": [
