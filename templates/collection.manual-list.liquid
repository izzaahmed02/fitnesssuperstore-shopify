{% layout none %}
{% paginate collection.metafields.custom.related_collections.value by 4 %}
  <div class="manuals-list__wrapper">
    {% for innerCol in collection.metafields.custom.related_collections.value %}
      <div class="manuals-list__container">
        <h3 class="manuals-list__title">{{ innerCol.title | remove: "Assembly" | remove: "Owners" | remove: "All" | | remove: 'Manuals' }}</h3>
        <div class="manuals-list-inner" data-list-name="{{ innerCol.handle }}">
          {%- for product in innerCol.products -%}
            <a class="manuals-list-item" href="{% if product.metafields.custom.manual_file %} {{ product.metafields.custom.manual_file | file_url  }} {% else %} {{ product.metafields.custom.manual_link  }} {% endif %}" target="_blank">
              {{ product.title }}
            </a>
          {%- endfor -%}
        </div>
        {% if innerCol.products_count > 50 %}
          <button class="manuals-load-more" data-handle="{{ innerCol.handle }}" data-offset="50" data-product-count="{{ innerCol.products_count }}" data-current-page="1">Show more manuals</button>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="pagination">
      <div data-href="{{ paginate.previous.url }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z" fill="{% if paginate.previous %}#F1592A{% else %}#CCCCCC{% endif %}"/>
        </svg>
      </div>
      {% for part in paginate.parts %}
        {% if part.is_link %}
          <div data-href="{{ part.url }}">{{ part.title }}</div>
        {% else %}
          <span class="current" data-title="{{ part.title }}">{{ part.title }}</span>
        {% endif %}
      {% endfor %}
      <div data-href="{{ paginate.next.url }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="{% if paginate.next %}#F1592A{% else %}#CCCCCC{% endif %}"/>
        </svg>
      </div>
    </div>
  {% endif %}
{% endpaginate %}