        "step_x8d8HB": {
          "type": "step",
          "settings": {
            "heading": "PayPal Pay Later (if offered  in your PayPal account)",
            "text": "<p>PayPal is a payment method you can select at checkout. If PayPal offers you Pay Later options (such as installment plans), you'll see those choices after you log in to PayPal.</p>",
            "heading_blue": "(if offered in your PayPal account)",
            "block_ul_title": "How to check out with PayPal (and Pay Later if available)",
            "block_ul_text": "<ol><li>Select PayPal at checkout.</li><li>Log in to your PayPal account.</li><li>If Pay Later is offered for your purchase, select it in PayPal. Otherwise, choose your preferred PayPal funding source and complete checkout.</li></ol>",
