    "installment_options_financing_nP68xW": {
      "type": "installment-options-financing",
      "blocks": {
        "step_pKfKQQ": {
          "type": "step",
          "settings": {
            "heading": "Shop Pay Installments (inside Shop Pay)",
            "text": "<p>Shop Pay Installments happens inside the Shop Pay checkout experience. At checkout, select Shop Pay (Pay in full or in installments). If you're eligible, you'll be prompted to choose installments within Shop Pay.</p>",
            "heading_blue": "(inside Shop Pay)",
            "block_ul_title": "How to use Shop Pay Installments",
            "block_ul_text": "<ol><li>Select \"Shop Pay – Pay in full or in installments\" in the Payment section at checkout.</li><li>When prompted, choose Pay in installments and complete any required verification.</li><li>Review the plan shown in Shop Pay, then confirm to place your order.</li></ol>",
            "block_important": "If you don't see installments",
            "block_important_text": "<p>Installments can be unavailable based on eligibility, purchase amount, or card/bank rules. If you don't see the option, try another card, choose Affirm – Pay Over Time instead, or pay in full with another method.<br/></p>",
            "text_color": "#D12E06",
