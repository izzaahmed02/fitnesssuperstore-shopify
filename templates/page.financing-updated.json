        "step_BGWEjJ": {
          "type": "step",
          "settings": {
            "heading": "Shop Pay Installments",
            "text": "<p>Shop Pay Installments happens inside the Shop Pay checkout experience. At checkout, select Shop Pay (Pay in full or in installments). If you're eligible, you'll be prompted to choose installments within Shop Pay.</p>",
            "heading_blue": "(inside Shop Pay)",
            "block_ul_title": "How to use Shop Pay Installments",
            "block_ul_text": "<ol><li>Select \"Shop Pay – Pay in full or in installments\" in the Payment section at checkout.</li><li>When prompted, choose Pay in installments and complete any required verification.</li><li>Review the plan shown in Shop Pay, then confirm to place your order.</li></ol>",
            "block_important": "If you don't see installments",
            "block_important_text": "<p>Installments can be unavailable based on eligibility, purchase amount, or card/bank rules. If you don't see the option, try another card, choose Affirm – Pay Over Time instead, or pay in full with another method.<br/></p>",
            "text_color": "#f1592a",
            "show_icon": true,
            "block_message": "Important",
            "block_message_text": "<p>Shop Pay Installments is separate from Affirm. Approval in one does not guarantee approval in the other.</p>",
            "show_icons": true,
            "girs_icons": false
          }
        },
        "step_gMK4bD": {
          "type": "step",
          "settings": {
            "heading": "Affirm",
            "text": "<p>Affirm is a standalone financing option (separate from Shop Pay). To use it, select Affirm – Pay Over Time in the Payment section at checkout.</p>",
            "heading_blue": "(Pay Over Time)",
            "block_ul_title": "How to use Affirm",
            "block_ul_text": "<ol><li>Select \"Affirm – Pay Over Time\" at checkout.</li><li>You'll be prompted to sign in or apply with Affirm, then choose your terms.</li><li>Once approved, confirm the plan and place your order. Payments are managed in your Affirm account.</li></ol>",
            "block_important": "If you don't see installments",
            "block_important_text": "<p>Installments can be unavailable based on eligibility, purchase amount, or card/bank rules. If you don't see the option, try another card, choose Affirm – Pay Over Time instead, or pay in full with another method.<br/></p>",
            "text_color": "#f1592a",
            "show_icon": true,
            "block_message": "Important",
            "block_message_text": "<p>Shop Pay Installments is separate from Affirm. Approval in one does not guarantee approval in the other.</p>",
            "show_icons": true,
            "girs_icons": false
          }
        },
        "step_N4bMnd": {
          "type": "step",
          "settings": {
            "heading": "PayPal Pay Later",
            "text": "<p>PayPal is a payment method you can select at checkout. If PayPal offers you Pay Later options (such as installment plans), you'll see those choices after you log in to PayPal.</p>",
            "heading_blue": "(if offered in your PayPal account)",
            "block_ul_title": "How to check out with PayPal (and Pay Later if available)",
            "block_ul_text": "<ol><li>Select PayPal at checkout.</li><li>Log in to your PayPal account.</li><li>If Pay Later is offered for your purchase, select it in PayPal. Otherwise, choose your preferred PayPal funding source and complete checkout.</li></ol>",
