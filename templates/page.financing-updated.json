        "step_nWpxmA": {
          "type": "step",
          "settings": {
            "heading": "Affirm (Pay Over Time)",
            "text": "<p>Affirm is a standalone financing option (separate from Shop Pay). To use it, select Affirm – Pay Over Time in the Payment section at checkout.</p>",
            "heading_blue": "(Pay Over Time)",
            "block_ul_title": "How to use Affirm",
            "block_ul_text": "<ol><li>Select \"Affirm – Pay Over Time\" at checkout.</li><li>You'll be prompted to sign in or apply with Affirm, then choose your terms.</li><li>Once approved, confirm the plan and place your order. Payments are managed in your Affirm account.</li></ol>",
            "block_important": "If you get stuck with Affirm",
            "block_important_text": "<p>Affirm approvals are handled directly by Affirm. If approval fails, try using the same name and address on your order that you have on file with Affirm, choose another payment method, or try Shop Pay Installments (separate eligibility).</p>",
            "text_color": "#D12E06",
            "show_icon": true,
            "block_message": "Important",
            "block_message_text": "<p>Shop Pay Installments is separate from Affirm. Approval in one does not guarantee approval in the other.</p>",
