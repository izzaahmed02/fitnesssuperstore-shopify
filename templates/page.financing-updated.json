        "step_rUUR3h": {
          "type": "step",
          "settings": {
            "heading": "Geneva Capital (business financing)",
            "text": "<p>Geneva Capital is a business financing partner option, often used by gyms, studios, and facilities building out commercial spaces. If you're purchasing for a business and want a dedicated business financing route, this is typically the best fit.</p>",
            "heading_blue": "(business financing)",
            "block_ul_title": "How Geneva Capital financing works",
            "block_ul_text": "<ol><li>Request a quote/invoice from our team (so you have exact totals, shipping, and any installation).</li><li>Complete the Geneva Capital application.</li><li>If approved, you'll receive your terms from Geneva Capital and can proceed with the purchase.</li></ol>",
            "block_important": "Business application (Tax ID typically required).",
            "block_important_text": "<p>Business financing approvals and terms are handled by Geneva Capital.</p>",
            "text_color": "#23232b",
            "show_icon": false,
            "block_message": "",
            "block_message_text": "",
            "show_icons": false,
            "gird_icons": true,
            "icon1": "shopify://shop_images/Icon.png",
            "title1": "Competitive Interest Rates",
            "text1": "Save more and reach your goals faster with our advantageous rates",
            "icon2": "shopify://shop_images/Icon_8158712b-e231-4bf0-a2a5-afe1eabfec35.png",
            "title2": "Fitness Financing Expert",
            "text2": "15 years experience in financing fitness facilities",
            "icon3": "shopify://shop_images/Icon_d0426484-0154-4ef1-b3cb-e1a4b84049b0.png",
            "title3": "Trust & Service",
            "text3": "A trusted company with excellent customer service",
            "icon4": "shopify://shop_images/Icon_1bcad8e1-2406-4d17-b4fe-0cd6fdcf3a7b.png",
            "title4": "Nationwide Availability",
            "text4": "Available for all",
            "tab_content": true,
            "tab_title1": "Terms & Requirements",
            "tab_title_inner1": "General Terms & Requirements in Applying for a Geneva Capital Loan:",
            "list_items1": "Registered business’ Tax ID;\nThe company needs to have good credit standing for better chances of approval;\nClients and their businesses must be located within the USA;\nLoan terms: 12 months, 24 months, 36 months, 48 months, 60 months;\nThe start-up financing plan requires as little as 2 months payment upfront;\nLoanable amounts depend on each client’s profile and nature of business;\nStandard APR starts at 10% based on today’s rates and go increase from there depending on risk factors, length of term, amount financed, etc.",
            "tab_title2": "Business Requirements",
            "tab_title_inner2": "Geneva Capital business financing is available for US-based businesses. To qualify, you'll need:",
            "list_items2": "A registered business Tax ID;\nA US-based business address;\nLoan terms may be available in multiple durations;\nApproval, rates, and upfront requirements depend on your business profile and the financing terms selected",
            "tab_title3": "How to Apply",
            "tab_title_inner3": "How to Apply",
            "list_items3": "<p>Request a quote or invoice from our team so you have exact totals, including shipping and any installation costs.;Complete the Geneva Capital financing application at apply.gogc.com.;If approved, you'll receive your terms from Geneva Capital and can proceed with your purchase.</p>",
            "tab_description3": "<p>To get started or if you have questions, contact Geneva Capital directly:</p><p>Mary Jo Mccormick, Sales Manager 1311 Broadway Street, Alexandria, MN 56308 </p><p>Phone: 320-759-3550 | Cell: 320-293-6957 | Fax: 320-762-8402 Email: <a href=\"mailto:maryjo@gogc.com\" target=\"_blank\">maryjo@gogc.com</a> Website: <a href=\"http://www.gogc.com/\" target=\"_blank\">www.gogc.com</a></p>",
            "step_button_text": "Complete the Geneva Capital application",
            "step_button_link": "https://apply.gogc.com/",
            "callout_box": true,
            "callout_heading": "Working with your own financing company?",
            "callout_text": "<p>We can provide an invoice/quote and supporting paperwork to help you purchase through your preferred lender or financing partner. Contact our team and we’ll send what you need.</p>",
            "callbutton_text": "Request invoice & paperwork",
            "callbutton_link": "https://www.fitnesssuperstore.com/pages/contact",
            "show_faq": false,
            "title_faq1": "",
