        },
        "block_XtwbeY": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_7.png",
            "title": "Dedicated Customer Service",
            "text": "<p>From sales to support, we're here every step of the way to address all of your inquiries, repairs, or warranty claims.</p>",
            "image_below_origin_proportions": false,
            "link_label": "",
