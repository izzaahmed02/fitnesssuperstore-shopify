        "block_HnpWaA": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_9.png",
            "title": "Full-scale Customization and Personalization",
            "text": "<p>Choose from any Pantone or RAL color for paint, a variety of upholstery choices, and even carved logos to represent your institution.</p>",
            "image_below_origin_proportions": false,
            "link_label": "See more",
