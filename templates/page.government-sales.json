        "block_Bfwyi7": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_2.png",
            "title": "Extensive Warranty",
            "text": "<p>All remanufactured equipment includes a 1 year parts and labor warranty, along with extended warranty options of up to 5 years parts and labor. French Fitness comes with 10 years parts, 1 year labor. Both exceed any comparable industry warranties offered by other companies.</p>",
            "image_below_origin_proportions": false,
            "link_label": "",
            "link_url": "",
            "addrtitle1": "",
