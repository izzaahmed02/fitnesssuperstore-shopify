        "block_4T8wtA": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_8.png",
            "title": "Full Service Delivery and Assembly Options",
            "text": "<p>We are one of the few gym equipment manufacturers that offer full-service options at a reasonable price. </p>",
            "image_below_origin_proportions": false,
            "link_label": "Learn more",
            "link_url": "shopify://pages/shipping-information",
