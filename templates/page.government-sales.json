            "image": "shopify://shop_images/Rectangle_1869_10.png",
            "title": "CEO-led Customer Care",
            "text": "<p>Ensuring swift solutions to critical issues, our CEO personally oversees customer satisfaction.</p>",
            "image_below_origin_proportions": false,
