        },
        "block_YXfMFe": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_3.png",
            "title": "Assembled in the USA",
            "text": "<p>All our products are assembled in our factory located in Benicia, CA. This ensures that each remanufactured equipment is carefully rebuilt according to industry standards of safety, durability, and functionality.</p>",
            "image_below_origin_proportions": false,
            "link_label": "",
