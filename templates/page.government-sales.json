        },
        "block_pEXdmh": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/image_264.png",
            "title": "Top-Rated Across Platforms",
            "text": "<p>Trusted by thousands of clients worldwide, our consistent 5-star ratings reflect unwavering customer satisfaction.</p>",
            "image_below_origin_proportions": true,
