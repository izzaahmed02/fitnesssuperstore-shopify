        "block_xJEE3B": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_6.png",
            "title": "Established Industry Leader",
            "text": "<p>With over 14 years of expertise and a dedicated team of 52 experts, Fitness Superstore has solidified its position as a trusted gym equipment manufacturer in the country.</p>",
            "image_below_origin_proportions": false,
            "link_label": "",
