    "image_with_text_7ta7mx": {
      "type": "image-with-text",
      "blocks": {
        "heading_hwzd8A": {
          "type": "heading",
          "settings": {
            "heading": "You can*hear* your machine",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 7
          }
        },
        "text_LVVPew": {
          "type": "text",
          "settings": {
            "text": "<p>If you can hear the whurring of your machine, it means you don't have enough resistance which is letting you move too quickly. This also means you aren't burning as many calories as you could. Keep a steady medium pace with enough resistance to keep your heart rate up</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_hwzd8A",
        "text_LVVPew"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
        "@media (max-width: 7520px) {.gradient {padding-top: 0; padding-bottom: 24px; }}"
      ],
      "settings": {
        "bg_color": "",
        "image": "shopify://shop_images/Rectangle_1869_5_b087aa08-01d1-49e7-acc2-21e2cc1a619f.png",
        "original_image_proportions": false,
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "section_color_scheme": "",
        "color_scheme": "",
        "image_behavior": "none",
        "mobile_content_alignment": "left",
