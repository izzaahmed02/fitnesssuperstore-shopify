    "image_with_text_DrxXnp": {
      "type": "image-with-text",
      "blocks": {
        "heading_cGdEGJ": {
          "type": "heading",
          "settings": {
            "heading": "You have*numb* toes",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 6
          }
        },
        "text_DC4wXf": {
          "type": "text",
          "settings": {
            "text": "<p>The most common mistake for elliptical misuse is improper weight distribution. Don't stand with your weight on your toes. This puts too much pressure on them, causing them to go numb. Instead stand with your weight on the back of your heels. This will allow you to have more stamina as well as strengthen other muscles</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_cGdEGJ",
        "text_DC4wXf"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
        "@media (max-width: 7520px) {.gradient {padding-top: 0; padding-bottom: 24px; }}"
      ],
      "settings": {
        "bg_color": "",
        "image": "shopify://shop_images/Rectangle_1869_4_976b13a2-2afd-43fc-8385-f4bd4fe76b22.png",
        "original_image_proportions": false,
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "section_color_scheme": "",
        "color_scheme": "",
