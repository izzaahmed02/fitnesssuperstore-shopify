    "image_with_text_myEtNn": {
      "type": "image-with-text",
      "blocks": {
        "heading_xVWNza": {
          "type": "heading",
          "settings": {
            "heading": "You don't work your*arms*",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 8
          }
        },
        "text_Bz33Dx": {
          "type": "text",
          "settings": {
            "text": "<p>If you aren't using your arms, you're missing half the workout. Try to use the moving handles two days a week for an upper body workout; then use the other days to hold the stationary handles. Focus on arms for 1 minute, then pump your legs for 4. Repeat this at intervals through your workout.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_xVWNza",
        "text_Bz33Dx"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
        "@media (max-width: 7520px) {.gradient {padding-top: 0; padding-bottom: 24px; }}"
      ],
      "settings": {
        "bg_color": "",
        "image": "shopify://shop_images/Rectangle_1869_6_a7ebb003-fcbc-4e19-8c30-37fa235b7c1a.png",
        "original_image_proportions": false,
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "section_color_scheme": "",
