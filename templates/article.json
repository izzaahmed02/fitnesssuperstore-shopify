    "image_with_text_wbGYj4": {
      "type": "image-with-text",
      "blocks": {
        "heading_jWAdak": {
          "type": "heading",
          "settings": {
            "heading": "Your resistance is *zero*",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 1
          }
        },
        "text_mEbhr6": {
          "type": "text",
          "settings": {
            "text": "<p>Use enough resistance to push and pull through a stride, otherwise, you won't see any results. Use a moderate pace to exercise until you are fairly exhausted. If you could go for another five minutes when you stop, your level is too low</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_jWAdak",
        "text_mEbhr6"
      ],
      "custom_css": [
