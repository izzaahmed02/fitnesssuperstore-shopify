    "image_with_text_BBP7Hq": {
      "type": "image-with-text",
      "blocks": {
        "heading_aiM8Py": {
          "type": "heading",
          "settings": {
            "heading": "You don't enter your *information*",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 3
          }
        },
        "text_PMW8bW": {
          "type": "text",
          "settings": {
            "text": "<p>The default for most machines is 150 lbs so make sure you enter your current stats to get accurate calorie readings. Burning 100 calories every ten minutes is a good goal</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_aiM8Py",
        "text_PMW8bW"
      ],
      "custom_css": [
