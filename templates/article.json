    "image_with_text_GRHXy8": {
      "type": "image-with-text",
      "blocks": {
        "heading_CKc6jV": {
          "type": "heading",
          "settings": {
            "heading": "You don't change *directions*",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 4
          }
        },
        "text_R4a7E3": {
          "type": "text",
          "settings": {
            "text": "<p>Change directions; going backwards not only livens things up, but it moves the focus from your quads to your hamstrings and glutes</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_CKc6jV",
        "text_R4a7E3"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
