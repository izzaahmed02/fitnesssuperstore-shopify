    "image_with_text_8BrRxm": {
      "type": "image-with-text",
      "blocks": {
        "heading_nxCwzE": {
          "type": "heading",
          "settings": {
            "heading": "You *slouch* when you exercise",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 2
          }
        },
        "text_LaJKBf": {
          "type": "text",
          "settings": {
            "text": "<p>Standing up straight engages your core and lengthens your abs. Plus, it helps work your upper body muscles, especially, if you stop holding on to the armrests</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_nxCwzE",
        "text_LaJKBf"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
