    "image_with_text_66qTzX": {
      "type": "image-with-text",
      "blocks": {
        "heading_R66NmN": {
          "type": "heading",
          "settings": {
            "heading": "Hills are*easy*",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 9
          }
        },
        "text_3GqkXc": {
          "type": "text",
          "settings": {
            "text": "<p>Unlike treadmills, increasing the incline won't increase the difficulty of the work out. It actually makes it easier for you to push and pull. Try using a minimum incline or none at all for those hill intervals. You'll burn more calories with your increased heart rate.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_R66NmN",
        "text_3GqkXc"
