    "image_with_text_YFW8dq": {
      "type": "image-with-text",
      "blocks": {
        "heading_jYQKjA": {
          "type": "heading",
          "settings": {
            "heading": "Your*routine* is the same",
            "heading_size": "tiny",
            "text_transform": false,
            "mobile_title_size": "normal",
            "number": 5
          }
        },
        "text_f3tigT": {
          "type": "text",
          "settings": {
            "text": "<p>Alternate your workout to prevent monotony and to boost your calorie burn. Use intervals of steady resistance but increased pace. OR maintain your speed and switch up your resistance</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "heading_jYQKjA",
        "text_f3tigT"
      ],
      "custom_css": [
        ".image-with-text__heading {font-weight: 700; margin-bottom: 0 !important;}",
        "@media (max-width: 7520px) {.gradient {padding-top: 0; padding-bottom: 24px; }}"
      ],
      "settings": {
        "bg_color": "",
        "image": "shopify://shop_images/Rectangle_1869_3_7cd57acf-f26e-4843-8187-18d3c4bbfcd9.png",
        "original_image_proportions": false,
        "height": "adapt",
        "desktop_image_width": "full-screen",
        "layout": "column",
        "desktop_content_position": "top",
        "desktop_content_alignment": "center",
        "content_layout": "no-overlap",
        "section_color_scheme": "",
