      ],
      "settings": {
        "title": "Fitness Superstore's Growth Story",
        "text": "In 2010, Tim founded Fitness Superstore. He started with a 4,200 sq ft warehouse in Concord, CA, and expanded \nthe business to include a staff, a comprehensive website, and a range of refurbished gym equipment. By 2013, \nthe business had grown to 35 employees and achieved $6 million in sales. This year marked the company's incorporation to Fitness Superstore Inc., and significant breakthroughs in the fitness industry.\nSince 2020, the company has consistently generated $15 million in annual sales, underscoring its strong market demand \nand sustained growth trajectory.",
        "link_text": "Learn more about Fitness Superstore's story",
        "link_url": "shopify:\/\/pages\/our-story",
        "bottom_t": "",
        "bottom_link_text": "",
        "bottom_link_url": ""
      }
    },
    "image_with_text_iwnTw3": {
      "type": "image-with-text",
      "blocks": {
        "heading_qVVQdP": {
          "type": "heading",
          "settings": {
            "heading": "People-Centric Business",
            "heading_size": "h1",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_rzPBqy": {
          "type": "text",
          "settings": {
            "text": "<p>Tim believes in being deeply involved in every aspect of the business. He strives to create a friendly workplace where every employee feels valued and is always available to address unique customer situations. These core values led to the team’s growth to over 100 employees.<br\/><\/p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
