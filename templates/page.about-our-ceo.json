            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_RaW88E": {
          "type": "text",
          "settings": {
            "text": "<p>French Fitness currently operates out of a 40,000 sq ft property in Benicia, CA, which includes the warehouse and its newly renovated headquarters. Fitness Superstore Inc. has expanded to a 23,500 sq ft space in Benicia, CA, where its warehouse, factory, assembly line, and offices are located.<br\/><\/p>",
