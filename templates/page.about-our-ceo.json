    "image_with_text_869GgP": {
      "type": "image-with-text",
      "blocks": {
        "heading_6Cbxqq": {
          "type": "heading",
          "settings": {
            "heading": "Entrepreneur Turned Fitness Enthusiast",
            "heading_size": "h1",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_hmHLPk": {
          "type": "text",
          "settings": {
            "text": "<p>Tim has consistently been a fitness enthusiast, going to the gym 3-4 times a week from the time he began selling fitness equipment, to date. He has engaged in activities from weightlifting to CrossFit, and more. This hands-on experience helped him understand gym machines and deliver gym equipment that are highly competitive in the market.<br\/><\/p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
