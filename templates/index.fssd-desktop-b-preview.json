    "homepage_homepage_faqs_HtBRyk": {
      "type": "homepage-homepage-faqs",
      "blocks": {
        "faq_GazcUQ": {
          "type": "faq",
          "settings": {
            "title": "Warranty options for new and remanufactured equipment",
            "copy": "<p><strong>New equipment:</strong> Warranty terms vary by brand and product. Most French Fitness equipment includes lifetime frame, 10-year parts, and 1-year labor coverage in the USA and Canada.</p><p><strong>Remanufactured equipment:</strong> Includes 1-year parts and on-site labor coverage in the USA and Canada, with extended options available. Terms and exclusions apply.</p><p><a href=\"/pages/warranty\" title=\"Warranty\">See warranty details</a></p>"
          }
        },
        "faq_rmAVzi": {
          "type": "faq",
          "settings": {
            "title": "CEO led customer service",
            "copy": "<p>Fitness Superstore is trusted by thousands of clients worldwide with over 4.8 rating on all major platforms. This is thanks to our CEO's personal oversight of customer satisfaction to ensure that critical issues are addressed swiftly and effectively.</p><p><a href=\"/pages/reviews\" target=\"_blank\" title=\"Reviews\">See our rating</a></p>"
          }
        },
        "faq_GRq6XA": {
          "type": "faq",
          "settings": {
            "title": "Offering full delivery service and other shipping options",
            "copy": "<p>We are one of the few gym equipment manufacturers that offer full-service options at a reasonable price. We have our own fleet of delivery vehicles, 50+ warehouse manpower, and partnerships with the top local and global couriers. We offer curbside delivery, installation/assembly, and room-of-choice delivery options for US-based clients.</p><p><a href=\"/pages/shipping-information\" target=\"_blank\" title=\"Shipping information\">See more</a></p>"
          }
        },
        "faq_admh6K": {
          "type": "faq",
          "settings": {
            "title": "Top Quality remanufactured equipment",
            "copy": "<p>At Fitness Superstore, quality is our top priority. Our equipment undergoes a rigorous inspection, testing, and quality assurance process to ensure that every machine meets our high standards.</p>"
          }
        }
      },
      "block_order": [
        "faq_GazcUQ",
        "faq_rmAVzi",
        "faq_GRq6XA",
        "faq_admh6K"
      ],
