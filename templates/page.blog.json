    "custom_liquid_Mn4C3n": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"page-width all-blogs-page\">\n  <header class=\"page-header\">\n    <h1>{{ page.title }}</h1>\n    {% if page.content != blank %}\n      <div class=\"page-description\">\n        {{ page.content }}\n      </div>\n    {% endif %}\n  </header>\n\n  <div class=\"all-blogs-container\">\n    {% for blog in blogs %}\n      {% if blog.articles_count > 0 %}\n        <section class=\"blog-section\">\n          <h2 class=\"blog-title\">{{ blog.title }}</h2>\n          \n          <div class=\"blog-posts-grid\">\n            {% for article in blog.articles limit: 100 %}\n              <article class=\"blog-post-card\">\n                {% if article.image %}\n                  <a href=\"{{ article.url }}\" class=\"post-image\">\n                    <img src=\"{{ article.image | img_url: '600x' }}\" \n                         alt=\"{{ article.title | escape }}\"\n                         loading=\"lazy\">\n                  </a>\n                {% endif %}\n                \n                <div class=\"post-content\">\n                  <div class=\"post-meta\">\n                    <span class=\"post-date\">{{ article.published_at | date: \"%B %d, %Y\" }}</span>\n                    {% if article.author %}\n                      <span class=\"post-author\">by {{ article.author }}</span>\n                    {% endif %}\n                    <span class=\"post-blog-tag\">{{ blog.title }}</span>\n                  </div>\n                  \n                  <h3 class=\"post-title\">\n                    <a href=\"{{ article.url }}\">{{ article.title }}</a>\n                  </h3>\n                  \n                  {% if article.excerpt != blank %}\n                    <p class=\"post-excerpt\">{{ article.excerpt | strip_html | truncate: 150 }}</p>\n                  {% else %}\n                    <p class=\"post-excerpt\">{{ article.content | strip_html | truncate: 150 }}</p>\n                  {% endif %}\n                  \n                  <a href=\"{{ article.url }}\" class=\"read-more-btn\">Read more →</a>\n                </div>\n              </article>\n            {% endfor %}\n          </div>\n        </section>\n      {% endif %}\n    {% endfor %}\n  </div>\n</div>\n\n<style>\n  .all-blogs-page {\n    padding: 40px 20px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .page-header {\n    text-align: center;\n    margin-bottom: 50px;\n  }\n\n  .page-header h1 {\n    font-size: 2.5rem;\n    margin-bottom: 15px;\n  }\n\n  .page-description {\n    color: #666;\n    max-width: 700px;\n    margin: 0 auto;\n  }\n\n  .blog-section {\n    margin-bottom: 60px;\n  }\n\n  .blog-title {\n    font-size: 2rem;\n    margin-bottom: 30px;\n    padding-bottom: 10px;\n    border-bottom: 2px solid #e0e0e0;\n  }\n\n  .blog-posts-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n    gap: 30px;\n    margin-bottom: 40px;\n  }\n\n  .blog-post-card {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    overflow: hidden;\n    transition: transform 0.2s, box-shadow 0.2s;\n  }\n\n  .blog-post-card:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 5px 20px rgba(0,0,0,0.1);\n  }\n\n  .post-image {\n    display: block;\n    overflow: hidden;\n  }\n\n  .post-image img {\n    width: 100%;\n    height: 200px;\n    object-fit: cover;\n    transition: transform 0.3s;\n  }\n\n  .blog-post-card:hover .post-image img {\n    transform: scale(1.05);\n  }\n\n  .post-content {\n    padding: 20px;\n  }\n\n  .post-meta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    font-size: 0.85rem;\n    color: #666;\n    margin-bottom: 10px;\n  }\n\n  .post-blog-tag {\n    background: #f0f0f0;\n    padding: 2px 8px;\n    border-radius: 3px;\n    font-weight: 500;\n  }\n\n  .post-title {\n    font-size: 1.3rem;\n    margin: 10px 0 15px;\n    line-height: 1.3;\n  }\n\n  .post-title a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .post-title a:hover {\n    color: #0066cc;\n  }\n\n  .post-excerpt {\n    color: #555;\n    line-height: 1.6;\n    margin-bottom: 15px;\n  }\n\n  .read-more-btn {\n    display: inline-block;\n    color: #0066cc;\n    text-decoration: none;\n    font-weight: 500;\n    transition: color 0.2s;\n  }\n\n  .read-more-btn:hover {\n    color: #004999;\n    text-decoration: underline;\n  }\n\n  @media (max-width: 768px) {\n    .blog-posts-grid {\n      grid-template-columns: 1fr;\n    }\n    \n    .page-header h1 {\n      font-size: 2rem;\n    }\n    \n    .blog-title {\n      font-size: 1.5rem;\n    }\n  }\n</style>",
        "color_scheme": "",
