        "question_tgxYRM": {
          "type": "question",
          "settings": {
            "title": "Who is responsible for transporting goods from the ocean port to the final destination for international buyers?",
            "text": "<p>International buyers are responsible for transportation from the ocean port to the final destination.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_aNVeqf": {
          "type": "question",
          "settings": {
            "title": "How are smaller items shipped internationally?",
            "text": "<p>Smaller items are shipped via Fedex International Ground, door to door. Items to be shipped via Fedex are subject to customs fees and VAT, which will be included upon checkout. All small parcels are shipped following DDP terms.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "#",
            "arrow": "false"
          }
        },
        "question_CxTjVT": {
          "type": "question",
          "settings": {
