    "faq_6zN8K3": {
      "type": "faq",
      "blocks": {
        "question_NAihpf": {
          "type": "question",
          "settings": {
            "title": "Where do we get our products?",
            "text": "<p>Our remanufactured equipment consists of pre-owned machines, primarily sourced from commercial facilities nationwide through club trade-ins and lease returns. </p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_nTqhKf": {
          "type": "question",
          "settings": {
            "title": "How old is our remanufactured equipment?",
            "text": "<p>The age range of our equipment spans from 3 to 20 years. Each model has a specific manufacturing period, meaning its age depends on when it was produced within that range. No matter what the age is, the end result is a product in like new condition, both mechanically and cosmetically.</p>",
            "url_text": "View photos",
            "btn_text": "",
            "url_link": "shopify://pages/remanufactured-photos",
            "arrow": "false"
          }
        },
        "question_Mk3HbG": {
          "type": "question",
          "settings": {
            "title": "Are there warranties on Fitness Superstore’s remanufactured equipment?",
            "text": "<p>Yes. Remanufactured equipment includes a 1-year parts and on-site labor warranty in the USA and Canada. Extended coverage is available for up to 5 years. Terms and exclusions apply.</p><p><a href=\"https://www.fitnesssuperstore.com/pages/warranty\" title=\"Fitness Superstore warranty information\">Learn more</a></p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_qedJHm": {
          "type": "question",
          "settings": {
            "title": "What does our remanufacturing process consist of?",
            "text": "<p>We take pride in having the most rigorous remanufacturing process in the industry. Every machine is completely disassembled, sanded, and repainted to restore its appearance. Key components such as belts, bearings, and batteries are replaced on all machines. Additionally, any part showing more than 25% wear is replaced to ensure optimal performance.<br/><br/>We stand by our commitment to quality with a comprehensive warranty, guaranteeing that your machine will be in \"like new\" working condition and \"close to new\" cosmetic condition. Our goal is to ensure that the performance, reliability, and appearance of the remanufactured equipment are virtually indistinguishable from new machines.<br/><br/>80% of our machines are remanufactured in our main factory located in Benicia, CA, while the 20% are performed in our satellite warehouses in the USA.</p>",
            "url_text": "View Video",
            "btn_text": "",
            "url_link": "#seven-stage-process-video",
            "arrow": "false"
          }
        }
      },
      "block_order": [
        "question_NAihpf",
        "question_nTqhKf",
        "question_Mk3HbG",
        "question_qedJHm"
      ],
