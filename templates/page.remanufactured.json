            "popup_link_text": "",
            "popup_link_url": "",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
            "order": "first"
          }
        },
        "block_j3wKbz": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/AdobeStock_613748180.jpg",
            "title": "Refurbished",
            "text": "<p>Selective maintenance based on condition. May include touch-up painting, belt replacements, and other repairs as needed. Internal components are inspected but not fully rebuilt. Some wear may remain. Best for: Budget buyers comfortable with cosmetic imperfections and shorter expected machine life.\n</p>",
            "link_text": "",
            "link_url": "",
            "target_id": "",
            "popup_title": "",
            "popup_text": "",
            "popup_link_text": "",
            "popup_link_url": "",
            "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
            "order": "first"
          }
        },
        "block_yhbMU7": {
          "type": "block",
          "settings": {
            "icon": "shopify://shop_images/5016ad755272cc43c5edb578256251df_2c0c9949-e858-4228-a51b-5e91ffde46ab.png",
            "title": "Cleaned and serviced",
            "text": "<p>Equipment is polished, inspected, lubricated, and adjusted for proper function. No major rebuilding or component replacement. Sold closer to as-is condition. Best for: Casual or low-traffic use where upfront cost matters more than long-term reliability.</p>",
