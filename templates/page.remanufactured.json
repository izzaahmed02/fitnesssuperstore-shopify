    "image_with_text_h4YhdY": {
      "type": "image-with-text",
      "blocks": {
        "heading_aJKdqk": {
          "type": "heading",
          "settings": {
            "heading": "What does remanufactured mean?",
            "heading_size": "h2",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_hmt7fy": {
          "type": "text",
          "settings": {
            "text": "<p>Remanufactured gym equipment refers to previously used fitness machines that have undergone an extensive restoration process to bring them back to a condition that is both mechanically and cosmetically comparable to brand new. <br/><br/>By choosing remanufactured equipment, you not only receive high-quality fitness machines but also contribute to environmental sustainability by reducing waste and conserving resources.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
        "button_DgHCcN": {
