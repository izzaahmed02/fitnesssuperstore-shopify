            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_3wnaVB": {
          "type": "text",
          "settings": {
            "text": "<p><strong>G4 Fitness</strong> is a locally owned gym in Caddo Mills founded by <strong>Jeff and Brittani Gunnels</strong> and built to serve both first time gym members and experienced athletes with a fully equipped strength and functional training floor. One of the main challenges was sourcing durable commercial grade equipment on a tight opening timeline without waiting six to eight months for custom builds while still meeting performance and aesthetic standards. After more than a year of hands on planning and construction Jeff and Brittani brought their shared vision to life with a welcoming community focused facility designed to support all fitness levels.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
        "list_Er4FnF": {
          "type": "list",
          "settings": {
            "list": "<p>Create a welcoming and unintimidating gym environment for all fitness levels</p>"
          }
        },
        "list_qb7nyP": {
          "type": "list",
          "settings": {
            "list": "<p>Deliver commercial grade equipment that supports daily use safety and long term performance</p>"
          }
        },
        "list_3dbqLk": {
          "type": "list",
          "settings": {
            "list": "<p>Design a functional layout that improves traffic flow training efficiency and member experience</p>"
          }
        },
        "list_wDUgVM": {
          "type": "list",
          "settings": {
            "list": "<p>Maintain a clean modern aesthetic that reflects the quality of the facility</p>"
          }
        }
      },
