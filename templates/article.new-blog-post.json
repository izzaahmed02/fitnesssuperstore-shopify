        },
        "block_QQkbjK": {
          "type": "block",
          "settings": {
            "image": "shopify://shop_images/Rectangle_1869_2.png",
            "title": "Extensive and Top of the Industry Remanufactured Warranty",
            "text": "<p>Our remanufactured equipment comes with 1-year parts and labor warranty standard on all our remanufactured products, along with extended warranty options of up to 5 years, while brand new equipment maintain their original brand’s warranties.</p>",
