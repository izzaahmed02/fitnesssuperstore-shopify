        "step_KrJPhd": {
          "type": "step",
          "settings": {
            "title": "2005",
            "text": "Tim got his own place and started selling out of his garage, with the Bowflex still being the core product"
          }
        },
        "step_YMKiRN": {
          "type": "step",
          "settings": {
            "title": "2007",
            "text": "He then launched FitnessSales.com with a business partner out of a 2,500 sq ft warehouse in Concord, CA. They also began dealing with used commercial gym equipment - anything you see in a gym. Machines were cleaned and serviced before selling."
          }
        },
        "step_8zr9Gh": {
          "type": "step",
          "settings": {
            "title": "2010",
            "text": "FitnessSales.com folded and Tim founded Fitness Superstore. He started with a 4,200 sq ft warehouse on 5125 Port Chicago Hwy in Concord, CA, and expanded the business to include a staff, a comprehensive website, and a range of refurbished gym equipment. This is where the 7-step remanufacturing process began."
          }
        },
        "step_DxAwPR": {
          "type": "step",
          "settings": {
            "title": "2013",
            "text": "This year marked the company's incorporation to Fitness Superstore Inc., and significant breakthroughs in the fitness industry. The business had grown to 35 employees and achieved $6 million in sales. We also moved into a 10,000 sq ft warehouse on 2551 Stanwell Dr in Concord, CA."
          }
        },
        "step_8EzdA7": {
          "type": "step",
          "settings": {
            "title": "2014",
            "text": "Business continued to thrive and we leased an extra 7,500 sq ft warehouse in Antioch, CA for additional storage."
          }
        },
        "step_UHV7eQ": {
          "type": "step",
          "settings": {
            "title": "2016",
            "text": "We moved out of both previous warehouses to 537 Stone Rd, Benicia, CA, where we continue to operate to date."
          }
        },
        "step_aLfjGG": {
          "type": "step",
          "settings": {
            "title": "2017",
            "text": "We went to IHSRA for the first time, and became an authorized dealer of various new equipment including BodySolid, Jacob's Ladder, BodyCraft, Marpo Kinetics, Power Plate, Versaclimber."
          }
        },
        "step_tkrG4W": {
          "type": "step",
          "settings": {
            "title": "2019",
            "text": "Our founder and CEO developed French Fitness, a gym equipment brand that offers everything you need for a commercial or home gym."
          }
        },
        "step_mYYp4G": {
          "type": "step",
          "settings": {
            "title": "2020",
            "text": "This year marks the beginning of our sustained achievement of $15 million in annual sales, driven primarily by the success of our remanufactured equipment and French Fitness product lines."
