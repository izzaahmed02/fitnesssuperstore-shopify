        "review_wpw4fj": {
          "type": "review",
          "settings": {
            "stars": "5",
            "title": "",
            "copy": "Fitness Superstore was spot on with their products, customer service and price. Everything comes as advertised, complete, great condition and on time.",
            "author": "Rob"
          }
