        "text_3wnaVB": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Revitalize Fitness</strong> is a 5,000 sq ft performance-driven training facility built to support serious coaching, consistent programming, and long-term client development. Formerly known as Rick Anderson Fitness, the gym has evolved alongside its growing membership and expanding training demands. With multiple coaches working on the floor and high daily equipment usage, the facility required commercial-grade machines that could deliver reliability, safety, and consistent performance. As part of this growth, Revitalize Fitness partnered with Fitness Superstore and selected French Fitness gym equipment to support its training philosophy.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
        "list_Er4FnF": {
          "type": "list",
