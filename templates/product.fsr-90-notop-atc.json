    "faq_zpC9RH": {
      "type": "faq",
      "blocks": {
        "question_eta9wP": {
          "type": "question",
          "settings": {
            "title": "Who is this machine for?",
            "text": "<p>It’s a great choice for home gym owners, personal training studios, and athletes who want a durable, multi-functional piece of equipment.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_Yp9hXX": {
          "type": "question",
          "settings": {
            "title": "Can it handle barbell training?",
            "text": "<p>Yes. The squat rack includes adjustable J-hooks and safety spotter arms, so you can train with free weights just as you would on a stand-alone rack.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_hndkNJ": {
          "type": "question",
          "settings": {
            "title": "Is it beginner-friendly?",
            "text": "<p>Absolutely. The Smith bar provides a controlled path for learning major lifts, while the cables allow lighter, more gradual resistance.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_RNkeyj": {
          "type": "question",
          "settings": {
            "title": "Does it replace a full gym?",
            "text": "<p>The FSR90 delivers nearly everything you’d expect from a complete training facility. By combining free-weight lifts, Smith machine exercises, and a full range of cable movements, it gives you the functionality of multiple machines in one space-saving design.</p>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        }
      },
