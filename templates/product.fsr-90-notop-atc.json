    "fsr_extra_info_RWhKg6": {
      "type": "fsr-extra-info",
      "name": "FSR Extra Info",
      "settings": {
        "product-details-title": "Product Details",
        "product-details-content": "<p>The French Fitness FSR90 is a versatile all in one training system built for athletes, fitness enthusiasts, and home gym owners who want commercial grade performance in a compact footprint. It combines a functional trainer, Smith machine, and squat rack into one sleek unit, giving you the flexibility to move from free weight barbell training to guided Smith machine lifts and cable exercises without switching machines.<br/><br/>Engineered with high gauge steel, smooth pulley operation, and reinforced components, the FSR90 delivers long term durability and a premium training experience. Whether your goal is building muscle, increasing power, or improving overall conditioning, this adaptable system supports every style of strength training with precision and ease.<br/><br/><strong>Warranty</strong></p><ul><li>Lifetime Frame Warranty</li><li>10 Years Parts Warranty*</li><li>1 Year Labor Warranty*</li></ul><p>*What is covered? See complete <a href=\"https://www.fitnesssuperstore.com/pages/french-fitness-warranty\" target=\"_blank\" title=\"https://www.fitnesssuperstore.com/pages/french-fitness-warranty\">French Fitness Warranty</a> details.</p>",
        "tech-specs-title": "Tech Specs",
        "tech-specs-image": "shopify://shop_images/FSR90_Tech_Specs.png",
        "tech-specs-content": "<ul><li><strong>Assembled Dimensions:</strong> 88.13\" L × 65\" W × 87.4\" H (w/Bar Catches connected)</li><li><strong>Width (Inner Part of Cage):</strong> 48\" (158 cm)</li><li><strong>Width (Outer Part of Cage):</strong> 52\" (132 cm)</li><li><strong>Dimensions w/ Jammer Arms Fully Extended:</strong> 101.5\" (Jammer Arms extend 56.5\" from Cable Columns)</li><li><strong>Recommended Footprint:</strong> ~ 9 ft wide × 11 ft long for safe movement and accessory clearance</li><li><strong>Product Weight:</strong> 992 lb (450 kg)</li><li><strong>Frame Thickness:</strong> 2\" × 2.75\" uprights • Cable Columns: 2\" × 2\"</li><li><strong>Smith Bar:</strong> 88 1/8\" Olympic, 45 lb, linear ball bearings (not counterbalanced); straight vertical travel</li><li><strong>Bushing Type:</strong> Weights have Plastic / Nylon Bushings. Bronze bushings for the rest of the machine</li><li><strong>Max Loads:</strong> Smith 600 lb • J-Hooks 550 lb • Safety Catches 660 lb • Pull-Up Bar 500 lb • Plate Storage 600 lb<br/></li></ul><p><strong>Note: Most standard Olympic bars won’t fit the carriage spacing. Use the optional FSR90/FSR80 Chrome Olympic Bar designed for this unit.</strong></p>",
        "weight-stacks-title": "Weight Stacks",
        "weight-stacks-content": "<ul><li><strong>Weight Stack:</strong> Dual 220 lb (440 lb total) </li><li><strong>Ratio: </strong>2:1</li><li><strong>Weight Stack Increments:</strong> (20) 11 lbs weight plates per side (feels like 5.5 lb per click)</li><li><strong>Cable Specs:</strong> 4.8 mm PA; Tensile 2160 MPa; Breaking Load 2,293 lb; Elongation 80–88%</li><li><strong>Cable Travel:</strong> 62\"</li><li><strong>Selector Pin:</strong> 10 mm</li></ul>",
        "smith-bar-specs-title": "Smith Bar Specs",
        "smith-bar-specs-content": "<ul><li>Smith Bearing Type: Linear Ball Bearings</li><li>Straight up and down movement</li><li>Ultra smooth smith machine movement and solid steel tubing</li><li>Adjustable safety catches for Smith Machine exercises</li><li>88 1/8\" Olympic Smith Bar (Weighs 45 lbs)</li><li>Distance from the bottom of the smith bar to the floor when the smith bar is touching the top bumpers: 74\" </li><li>Distance from the bottom of the smith bar to the floor when the smith bar is resting on the top hook: 66.77\" (170 cm)</li><li>Distance from the bottom of the smith bar to the floor when the smith bar is resting on the bottom bumpers: 16\" (41 cm)</li><li>Distance from the bottom of the smith bar to the floor when the smith bar is resting on the bottom hook: 17.56\" (44.6 cm)</li></ul>",
        "accessories-title": "Accessories",
        "accessories-content": "{{ product.metafields.custom.features_specs.value.accessory_feature | metafield_tag }}",
        "features-title": "Features",
        "features-content": "<ul><li>Brand: {{ product.vendor }}</li></ul>{{ product.metafields.custom.features_specs.value.features | metafield_tag }}",
        "all-in-one-title": "The Ultimate ALL-IN-ONE Machine:",
        "all-in-one-content": "{{ product.metafields.custom.features_specs.value.all_in_one_overview | metafield_tag }}"
      }
    },
