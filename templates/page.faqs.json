    "custom_liquid_C4HyUp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  :root {\n    --fs-orange: #D83D0E;\n    --fs-dark: #23232B;\n    --fs-text: #33343A;\n    --fs-muted: #666B73;\n    --fs-border: #E4E4E7;\n    --fs-bg: #FAFAFB;\n    --fs-soft-orange: #FFF2ED;\n  }\n\n  .fs-faq-page {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 32px 18px 72px;\n    color: var(--fs-text);\n    font-family: inherit;\n  }\n\n  .fs-faq-hero {\n    background: var(--fs-dark);\n    color: #fff;\n    border-radius: 18px;\n    padding: 44px 34px;\n    margin-bottom: 44px;\n  }\n\n  .fs-faq-eyebrow {\n    color: #FFB199;\n    font-weight: 700;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    font-size: 13px;\n    margin-bottom: 10px;\n  }\n\n  .fs-faq-hero h1 {\n    color: #fff;\n    font-size: 48px;\n    line-height: 1.05;\n    margin: 0 0 16px;\n    text-transform: uppercase;\n  }\n\n  .fs-faq-hero p {\n    font-size: 18px;\n    line-height: 1.6;\n    max-width: 840px;\n    margin: 0 0 24px;\n    color: rgba(255,255,255,.88);\n  }\n\n  .fs-faq-hero-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  .fs-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 46px;\n    padding: 12px 18px;\n    border-radius: 8px;\n    font-weight: 700;\n    text-decoration: none;\n    line-height: 1.2;\n    transition: all .2s ease;\n  }\n\n  .fs-btn-primary {\n    background: var(--fs-orange);\n    color: #fff;\n    border: 1px solid var(--fs-orange);\n  }\n\n  .fs-btn-secondary {\n    background: #fff;\n    border: 1px solid #D83D0E;\n    color: #D83D0E;\n  }\n\n  .fs-btn:hover {\n    transform: translateY(-1px);\n  }\n\n  .fs-faq-intro-grid {\n    display: grid;\n    grid-template-columns: 1.2fr .8fr;\n    gap: 24px;\n    margin-bottom: 44px;\n  }\n\n  .fs-card {\n    border: 1px solid var(--fs-border);\n    background: #fff;\n    border-radius: 16px;\n    padding: 24px;\n  }\n\n  .fs-card h2,\n  .fs-card h3 {\n    margin: 0 0 12px;\n    color: var(--fs-dark);\n    font-size: 28px;\n    line-height: 1.2;\n  }\n\n  .fs-card p {\n    color: var(--fs-muted);\n    line-height: 1.65;\n  }\n\n  .fs-contact-list {\n    display: grid;\n    gap: 14px;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .fs-contact-list li {\n    line-height: 1.5;\n  }\n\n  .fs-contact-list strong {\n    color: var(--fs-dark);\n  }\n\n  .fs-contact-list a {\n    color: var(--fs-orange);\n    text-decoration: none;\n  }\n\n  .fs-toc {\n    background: var(--fs-bg);\n    border: 1px solid var(--fs-border);\n    border-radius: 16px;\n    padding: 24px;\n    margin-bottom: 44px;\n  }\n\n  .fs-toc h2 {\n    margin: 0 0 18px;\n    font-size: 28px;\n    line-height: 1.2;\n    color: var(--fs-dark);\n  }\n\n  .fs-toc-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .fs-toc-grid a {\n    display: block;\n    background: #fff;\n    border: 1px solid var(--fs-border);\n    border-radius: 10px;\n    padding: 14px 16px;\n    color: var(--fs-dark);\n    text-decoration: none;\n    font-weight: 700;\n    transition: all .2s ease;\n  }\n\n  .fs-toc-grid a:hover {\n    border-color: var(--fs-orange);\n    color: var(--fs-orange);\n  }\n\n  .fs-faq-section {\n    padding: 44px 0;\n    scroll-margin-top: 110px;\n  }\n\n  .fs-faq-section-header {\n    margin-bottom: 24px;\n  }\n\n  .fs-faq-section-header h2 {\n    font-size: 38px;\n    line-height: 1.1;\n    text-transform: uppercase;\n    margin: 0 0 10px;\n    color: var(--fs-dark);\n  }\n\n  .fs-faq-section-header p {\n    margin: 0;\n    color: var(--fs-muted);\n    line-height: 1.65;\n    max-width: 830px;\n  }\n\n  .fs-faq-list {\n    display: grid;\n    gap: 24px;\n  }\n\n  .fs-faq-item {\n    border: 1px solid var(--fs-border);\n    background: #fff;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n\n  .fs-faq-item summary {\n    cursor: pointer;\n    padding: 20px;\n    font-weight: 800;\n    color: var(--fs-dark);\n    list-style: none;\n    position: relative;\n    padding-right: 56px;\n    line-height: 1.5;\n  }\n\n  .fs-faq-item summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .fs-faq-item summary:after {\n    content: \"+\";\n    position: absolute;\n    right: 20px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: var(--fs-orange);\n    font-size: 24px;\n    font-weight: 800;\n  }\n\n  .fs-faq-item[open] summary:after {\n    content: \"–\";\n  }\n\n  .fs-faq-answer {\n    padding: 0 20px 20px;\n    color: var(--fs-muted);\n    line-height: 1.7;\n  }\n\n  .fs-faq-answer p {\n    margin: 0 0 12px;\n  }\n\n  .fs-faq-answer ul {\n    margin: 10px 0 14px 20px;\n    padding: 0;\n  }\n\n  .fs-faq-answer li {\n    margin-bottom: 6px;\n  }\n\n  .fs-faq-answer a {\n    color: var(--fs-orange);\n    font-weight: 700;\n  }\n\n  .fs-note {\n    background: var(--fs-soft-orange);\n    border: 1px solid #FFD2C3;\n    border-radius: 12px;\n    padding: 14px 16px;\n    margin-top: 14px;\n    color: #5F2D1E;\n    line-height: 1.6;\n  }\n\n  .fs-final-cta {\n    background: var(--fs-bg);\n    border: 1px solid var(--fs-border);\n    border-radius: 18px;\n    padding: 36px 30px;\n    text-align: center;\n    margin-top: 44px;\n  }\n\n  .fs-final-cta h2 {\n    margin: 0 0 12px;\n    color: var(--fs-dark);\n    text-transform: uppercase;\n    font-size: 38px;\n    line-height: 1.1;\n  }\n\n  .fs-final-cta p {\n    margin: 0 auto 20px;\n    max-width: 760px;\n    color: var(--fs-muted);\n    line-height: 1.65;\n  }\n\n  .fs-final-actions {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 12px;\n  }\n\n  @media (max-width: 900px) {\n    .fs-faq-intro-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .fs-toc-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media (max-width: 600px) {\n    .fs-faq-page {\n      padding: 22px 14px 56px;\n    }\n\n    .fs-faq-hero {\n      padding: 30px 20px;\n      border-radius: 14px;\n      margin-bottom: 24px;\n    }\n\n    .fs-faq-hero h1 {\n      font-size: 36px;\n    }\n\n    .fs-faq-hero p {\n      font-size: 16px;\n    }\n\n    .fs-faq-intro-grid {\n      gap: 16px;\n      margin-bottom: 24px;\n    }\n\n    .fs-toc {\n      margin-bottom: 24px;\n      padding: 20px;\n    }\n\n    .fs-toc-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .fs-faq-section {\n      padding: 24px 0;\n    }\n\n    .fs-faq-section-header {\n      margin-bottom: 16px;\n    }\n\n    .fs-faq-section-header h2,\n    .fs-final-cta h2 {\n      font-size: 30px;\n    }\n\n    .fs-card h2,\n    .fs-card h3,\n    .fs-toc h2 {\n      font-size: 24px;\n    }\n\n    .fs-faq-list {\n      gap: 16px;\n    }\n\n    .fs-btn {\n      width: 100%;\n    }\n\n    .fs-final-actions {\n      flex-direction: column;\n    }\n\n    .fs-final-cta {\n      padding: 28px 20px;\n      margin-top: 24px;\n    }\n  }\n\n/* PAGE TITLE */\n.fs-faq-hero h1 {\n  color: #fff;\n  font-size: 48px;\n  line-height: 1.05;\n  margin: 0 0 16px;\n  text-transform: uppercase;\n}\n\n/* ALL MAIN SECTION HEADINGS */\n.fs-faq-section-header h2,\n.fs-final-cta h2,\n.fs-toc h2,\n.fs-card h2 {\n  font-size: 38px;\n  line-height: 1.1;\n  text-transform: uppercase;\n  color: var(--fs-dark);\n}\n\n/* SUBHEADINGS */\n.fs-card h3 {\n  font-size: 28px;\n  line-height: 1.2;\n  color: var(--fs-dark);\n}\n\n/* MOBILE */\n@media (max-width: 600px) {\n\n  .fs-faq-hero h1 {\n    font-size: 36px;\n  }\n\n  .fs-faq-section-header h2,\n  .fs-final-cta h2,\n  .fs-toc h2,\n  .fs-card h2 {\n    font-size: 28px;\n  }\n\n  .fs-card h3 {\n    font-size: 24px;\n  }\n}\n</style>\n\n<div class=\"fs-faq-page\">\n\n  \n\n  <section class=\"fs-faq-intro-grid\">\n    <div class=\"fs-card\">\n      <h2>Need help choosing equipment?</h2>\n      <p>\n        Fitness Superstore helps customers compare new equipment, including French Fitness,\n        with remanufactured commercial equipment from leading brands. If you are not sure which\n        path fits your space, budget, or goals, our team can help.\n      </p>\n      <a class=\"fs-btn fs-btn-primary\" href=\"/pages/contact\">Talk to an Equipment Specialist</a>\n    </div>\n\n    <div class=\"fs-card\">\n      <h3>Quick contact</h3>\n      <ul class=\"fs-contact-list\">\n        <li><strong>Fitness Superstore:</strong><br><a href=\"mailto:sales@fitnesssuperstore.com\">sales@fitnesssuperstore.com</a><br><a href=\"tel:+19252152927\">+1-925-215-2927</a></li>\n        <li><strong>French Fitness Sales:</strong><br><a href=\"mailto:sales@frenchfitness.com\">sales@frenchfitness.com</a><br><a href=\"tel:+19254306111\">(925) 430-6111</a></li>\n        <li><strong>French Fitness Warranty:</strong><br><a href=\"mailto:support@frenchfitness.com\">support@frenchfitness.com</a><br>Mon–Fri, 8:00 am–4:00 pm PST</li>\n      </ul>\n    </div>\n  </section>\n\n  <nav class=\"fs-toc\" aria-label=\"FAQ categories\">\n    <h2>Browse by topic</h2>\n    <div class=\"fs-toc-grid\">\n      <a href=\"#buying-equipment\">Buying Equipment</a>\n      <a href=\"#french-fitness\">French Fitness</a>\n      <a href=\"#remanufactured-equipment\">Remanufactured Equipment</a>\n      <a href=\"#shipping-delivery\">Shipping & Delivery</a>\n      <a href=\"#warranty-service\">Warranty & Service</a>\n      <a href=\"#showroom-walkthroughs\">Showroom & Walkthroughs</a>\n      <a href=\"#company-brand\">Company & Brand</a>\n      <a href=\"#careers\">Careers</a>\n    </div>\n  </nav>\n\n  <section id=\"buying-equipment\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Buying Equipment</h2>\n      <p>Answers about what we sell, how to choose between equipment paths, and how our team can help.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\" open>\n        <summary>Do you sell both new and remanufactured equipment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. Fitness Superstore sells new equipment, including French Fitness and selected new brands, plus remanufactured commercial equipment from leading brands.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What is the difference between new and remanufactured equipment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>New equipment is factory-new and may include French Fitness or selected partner brands. Remanufactured equipment is commercial-grade equipment that has gone through a deeper rebuild and restoration process so it can deliver strong performance and value.</p>\n          <p><a href=\"/pages/remanufactured-gym-equipment\">Learn more about remanufactured equipment</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Should I buy new or remanufactured gym equipment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Choose new equipment when you want factory-new condition, a consistent look across your space, or a specific brand line such as French Fitness. Choose remanufactured equipment when you want premium commercial brands, strong value, and proven equipment at a lower cost than buying new.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I mix new and remanufactured equipment in one order?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. Many customers combine new and remanufactured equipment to get the best balance of appearance, performance, and budget.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can your team help me choose equipment for my space?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. Our team can help compare categories, equipment paths, warranties, shipping options, and layout considerations so you can choose the right setup.</p>\n          <p><a href=\"/pages/contact\">Contact our team</a> to get started.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do you help with full gym layouts or packages?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. We can help customers compare equipment categories and gym package options for home gyms, studios, apartment fitness centers, schools, hotels, and commercial facilities.</p>\n          <p><a href=\"/pages/gym-packages\">Explore gym packages</a>.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"french-fitness\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>French Fitness</h2>\n      <p>Answers about French Fitness equipment, warranty, sales, and support.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>Is French Fitness sold new only?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. French Fitness is sold as new equipment. Fitness Superstore sells French Fitness as part of its new-equipment path.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What warranty comes with French Fitness?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>French Fitness core covered categories include Lifetime Frame, 10-Year Parts, and 1-Year Labor coverage. French Fitness accessories, free weights, and flooring follow a separate 1-Year Limited Parts structure.</p>\n          <p><a href=\"/pages/french-fitness-warranty\">View the French Fitness warranty</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>How do I contact French Fitness warranty support?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>For French Fitness warranty support, email <a href=\"mailto:support@frenchfitness.com\">support@frenchfitness.com</a> or call <a href=\"tel:+19254306111\">(925) 430-6111</a>. Warranty support hours are Mon–Fri, 8:00 am to 4:00 pm PST.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>How do I contact French Fitness sales?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>For French Fitness sales or general questions, email <a href=\"mailto:sales@frenchfitness.com\">sales@frenchfitness.com</a> or call <a href=\"tel:+19254306111\">(925) 430-6111</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I see French Fitness equipment before buying?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. You can visit the Benicia showroom to see select French Fitness equipment in person, or request a video walkthrough if you are shopping remotely.</p>\n          <p><a href=\"/pages/warehouse-page\">View showroom information</a> or <a href=\"/pages/contact\">request a walkthrough</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Is French Fitness good for commercial gyms?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>French Fitness can be a strong fit for many commercial and light-commercial environments, especially when buyers want new equipment, a consistent look, strong value, and a broad equipment lineup.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"remanufactured-equipment\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Remanufactured Equipment</h2>\n      <p>Answers about what remanufactured means, how it compares to refurbished, and what support is included.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>What does remanufactured mean?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Remanufactured equipment goes through a deeper rebuild process than basic used or cleaned equipment. The goal is to restore mechanical function, appearance, and reliability so the machine can perform like a commercial-grade machine should.</p>\n          <p><a href=\"/pages/remanufactured-gym-equipment\">See our remanufactured equipment page</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>How is remanufactured different from refurbished?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Refurbished equipment may involve cleaning, touch-up work, or selective repairs. Remanufactured equipment goes through a more complete restoration process. We use “refurbished” mainly when explaining the comparison, while “remanufactured” is the primary term for our rebuilt commercial equipment.</p>\n          <p><a href=\"/blogs/buying-guides/remanufactured-vs-refurbished-gym-equipment-buyer-s-guide-for-home-commercial-gyms\">Read the remanufactured vs refurbished guide</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What warranty comes with remanufactured equipment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>All remanufactured machines include 1 year of parts and on-site labor coverage in the USA and Canada. Extended coverage options of 2, 3, 4, and 5 years are also available on many units.</p>\n          <p><a href=\"/pages/warranty\">View warranty details</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I see remanufactured equipment before buying?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. You can visit our Benicia warehouse showroom to see finished remanufactured equipment in person, compare machine types, and talk with the team about our remanufacturing standards.</p>\n          <p><a href=\"/pages/warehouse-page\">View showroom information</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do remanufactured machines look new?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Remanufactured machines are restored mechanically and cosmetically so they look and perform at a high standard. Individual product pages may include photos, condition details, and warranty information.</p>\n          <p><a href=\"/pages/remanufactured-photos\">View remanufactured photos</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I request photos or a video walkthrough?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. If you are shopping remotely, you can contact our team and request photos or a video walkthrough when available. Select “Showroom Visit / Video Walkthrough” on the contact form.</p>\n          <p><a href=\"/pages/contact\">Request a video walkthrough</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do you sell used or “As Is” weights?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Occasionally, Fitness Superstore may offer used dumbbells, weight plates, or similar items as “As Is.” These are rare used products, not remanufactured machines. When possible, product pages will include actual photos, or photos may be available on request.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"shipping-delivery\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Shipping & Delivery</h2>\n      <p>Answers about shipping, delivery, installation, special regions, and international terms.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>Do you ship nationwide?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. Fitness Superstore ships throughout the USA and supports a range of delivery options depending on product, location, and service level.</p>\n          <p><a href=\"/pages/shipping-information\">View shipping information</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What delivery options do you offer?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Delivery options may include curbside delivery, garage delivery, room-of-choice delivery, and delivery with assembly depending on the order and destination.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do you offer room-of-choice delivery or installation?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes, room-of-choice delivery and installation may be available depending on the product, location, and order details. Availability and pricing can vary by destination.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do you ship to Hawaii, Alaska, Puerto Rico, and Canada?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. We ship to Hawaii, Alaska, Puerto Rico, and Canada. Most customers in major population areas can use the website shipping quote. Very remote areas may require special handling or a custom freight quote.</p>\n          <p>If actual freight cost is significantly higher than the website quote, Fitness Superstore may contact the customer after ordering with available options, including paying the shipping difference, arranging freight, or canceling for a full refund.</p>\n          <p><a href=\"/pages/shipping-information\">Review Shipping Information</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do you ship internationally?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. International shipping is available under the standard international door-to-port (CIF) terms shown on the website. Customers only need to contact us before ordering if they need different shipping terms or special handling.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What are standard international shipping terms?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Standard international shipping on the website uses door-to-port (CIF) terms. This means customers should review the international shipping terms shown during the order process and contact our team only if they need different freight terms, special delivery handling, or clarification before ordering.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"warranty-service\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Warranty & Service</h2>\n      <p>Answers about warranty coverage, claim routing, service support, and location-based considerations.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>How do I start a warranty claim?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Contact the correct support path with your order details, product information, and a clear description of the issue. Photos or videos can help the team review the issue faster.</p>\n          <ul>\n            <li><strong>Fitness Superstore / remanufactured equipment:</strong> <a href=\"mailto:sales@fitnesssuperstore.com\">sales@fitnesssuperstore.com</a> or <a href=\"tel:+19252152927\">+1-925-215-2927</a></li>\n            <li><strong>French Fitness warranty:</strong> <a href=\"mailto:support@frenchfitness.com\">support@frenchfitness.com</a> or <a href=\"tel:+19254306111\">(925) 430-6111</a></li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What warranty comes with remanufactured equipment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>All remanufactured machines include 1 year of parts and on-site labor coverage in the USA and Canada. Extended coverage options of 2, 3, 4, and 5 years are also available on many units.</p>\n          <p><a href=\"/pages/warranty\">View the master warranty page</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What warranty comes with French Fitness?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>French Fitness core covered categories include Lifetime Frame, 10-Year Parts, and 1-Year Labor coverage. Accessories, free weights, and flooring follow a separate 1-Year Limited Parts structure.</p>\n          <p><a href=\"/pages/french-fitness-warranty\">View French Fitness warranty details</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do warranty or service options vary by location?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Warranty, delivery, and service logistics may vary for very remote areas in Hawaii, Alaska, Puerto Rico, and Canada. Most customers in major population areas can use the website shipping quote and standard ordering process.</p>\n          <p>International shipping is available under the standard international door-to-port (CIF) terms shown on the website. Contact us before ordering only if you need different shipping terms or special handling.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What information should I include when requesting support?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Please include your order number, product name or SKU, delivery address, a clear description of the issue, and photos or video when useful. This helps the team route the request and determine the best next step.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Are warranties transferable?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Warranty coverage is generally tied to the original purchaser and original order. Please review the applicable warranty page or contact our team for the terms that apply to your product.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"showroom-walkthroughs\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Showroom & Video Walkthroughs</h2>\n      <p>Answers about visiting the Benicia showroom, what to expect, and how remote walkthroughs work.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>Which address should I visit?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Public showroom visits and walk-ins should go to:</p>\n          <p><strong>457 Industrial Way<br>Benicia, CA 94510</strong></p>\n          <p>Operations, remanufacturing, and outbound shipping are handled through 537 Stone Rd Suite F, which is not open to the public.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Is the showroom a traditional retail store?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>No. The Benicia showroom is located inside an active warehouse environment, not a traditional retail storefront. You can view and compare equipment, test select machines, and speak with available team members.</p>\n          <div class=\"fs-note\">For the best experience, we recommend calling ahead or requesting a walkthrough so our team can help coordinate support.</div>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I test equipment in person?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>You can view and test select equipment in the showroom, depending on availability and showroom conditions. If you are coming to see a specific product, contact us first so we can help confirm availability.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I request a video walkthrough?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Yes. If you are not local to Benicia, you can request a video walkthrough to see equipment remotely, compare options, and ask questions before ordering. Use the Contact page and select “Showroom Visit / Video Walkthrough.”</p>\n          <p><a href=\"/pages/contact\">Request a video walkthrough</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Do I need an appointment?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Walk-ins are welcome during showroom hours, but calling ahead or requesting a walkthrough is recommended. This helps the team prepare and improves the experience if you are coming to see specific equipment.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Can I see the remanufacturing process?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>You can see finished remanufactured equipment in the showroom and talk with our team about our remanufacturing standards. The operations and remanufacturing facility at 537 Stone Rd Suite F is not open to the public.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"company-brand\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Company & Brand Questions</h2>\n      <p>Short factual answers about Fitness Superstore, French Fitness, and company background.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>Who founded Fitness Superstore?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Fitness Superstore was founded by Tim French in 2010.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Who owns Fitness Superstore?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Tim French is the founder and owner of Fitness Superstore.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>When was Fitness Superstore founded?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Fitness Superstore was founded in 2010.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What is the relationship between Fitness Superstore and French Fitness?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Fitness Superstore is the retailer, and French Fitness is the new-equipment brand launched in 2019.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>Where is Fitness Superstore based?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Fitness Superstore is based in Benicia, California. Public showroom visits are at 457 Industrial Way, while operations, remanufacturing, and outbound shipping are handled through 537 Stone Rd Suite F, which is not open to the public.</p>\n        </div>\n      </details>\n\n      <details class=\"fs-faq-item\">\n        <summary>What equipment paths does Fitness Superstore offer?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>Fitness Superstore offers two main equipment paths: new equipment, including French Fitness and selected new brands, and remanufactured commercial equipment from leading brands.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section id=\"careers\" class=\"fs-faq-section\">\n    <div class=\"fs-faq-section-header\">\n      <h2>Careers</h2>\n      <p>A short answer for visitors searching for job information.</p>\n    </div>\n\n    <div class=\"fs-faq-list\">\n      <details class=\"fs-faq-item\">\n        <summary>Are you hiring?</summary>\n        <div class=\"fs-faq-answer\">\n          <p>We do not currently list job openings on the website. For general business inquiries, please use the Contact page.</p>\n          <p><a href=\"/pages/contact\">Contact Fitness Superstore</a>.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section class=\"fs-final-cta\">\n    <h2>Still Have Questions?</h2>\n    <p>\n      Our team can help with equipment selection, warranty coverage, delivery options,\n      showroom visits, video walkthroughs, and support questions.\n    </p>\n    <div class=\"fs-final-actions\">\n      <a class=\"fs-btn fs-btn-primary\" href=\"/pages/contact\">Contact Our Team</a>\n      <a class=\"fs-btn fs-btn-secondary\" href=\"/collections/products-remanufactured\">Shop Remanufactured</a>\n      <a class=\"fs-btn fs-btn-secondary\" href=\"/collections/new-equipment\">Shop New Equipment</a>\n    </div>\n  </section>\n\n</div>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do you sell both new and remanufactured equipment?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Fitness Superstore sells new equipment, including French Fitness and selected new brands, plus remanufactured commercial equipment from leading brands.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is the difference between new and remanufactured equipment?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"New equipment is factory-new and may include French Fitness or selected partner brands. Remanufactured equipment is commercial-grade equipment that has gone through a deeper rebuild and restoration process so it can deliver strong performance and value.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Should I buy new or remanufactured gym equipment?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Choose new equipment when you want factory-new condition, a consistent look across your space, or a specific brand line such as French Fitness. Choose remanufactured equipment when you want premium commercial brands, strong value, and proven equipment at a lower cost than buying new.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I mix new and remanufactured equipment in one order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Many customers combine new and remanufactured equipment to get the best balance of appearance, performance, and budget.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is French Fitness sold new only?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. French Fitness is sold as new equipment. Fitness Superstore sells French Fitness as part of its new-equipment path.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What warranty comes with French Fitness?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"French Fitness core covered categories include Lifetime Frame, 10-Year Parts, and 1-Year Labor coverage. French Fitness accessories, free weights, and flooring follow a separate 1-Year Limited Parts structure.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I contact French Fitness warranty support?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"For French Fitness warranty support, email support@frenchfitness.com or call (925) 430-6111. Warranty support hours are Mon-Fri, 8:00 am to 4:00 pm PST.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I contact French Fitness sales?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"For French Fitness sales or general questions, email sales@frenchfitness.com or call (925) 430-6111.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What does remanufactured mean?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\