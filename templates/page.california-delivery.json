        "accordion_XbPgfb": {
          "type": "accordion",
          "settings": {
            "title": "Will there be additional costs if I choose “In-Store Pickup”?",
            "copy": "<p>No, there are no additional charges for in-store pickup. Once your order is ready, we’ll notify you via phone or email. When you arrive at our warehouse, our team will assist in loading your equipment.</p>"
          }
        },
        "accordion_YG9TAH": {
          "type": "accordion",
          "settings": {
            "title": "How can I select the \"In-Store Pickup\" option upon checkout?",
            "copy": "<p>From the product page, select curbside delivery as a shipping option, then click on \"Add to Cart\". On your shopping cart, select the country, state, and plug in your zip code. Then, click on \"Confirm Shipping Costs\". It will lead you to the checkout page where you can select \"In-Store Pickup\".</p>"
