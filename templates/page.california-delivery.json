    "delivery-first-acc": {
      "type": "delivery-first-acc",
      "blocks": {
        "accordion_d7b3kL": {
          "type": "accordion",
          "settings": {
            "title": "How long will it take for the item to be ready for delivery?",
            "copy": "<p>The preparation time varies by item. Please refer to the lead time indicated on the product page or contact us directly to confirm the timelines.</p>",
            "image": "shopify://shop_images/Img_4db027e0-4347-47d0-ada1-f1d73bdd3907.png"
          }
        },
        "accordion_rrw7HN": {
          "type": "accordion",
          "settings": {
            "title": "What are my options for Northern California delivery and how much will it cost?",
            "copy": "<p>We offer two delivery options within Northern California: </p><ol><li> Curbside Delivery: Your items will be delivered to the closest curbside to your address. The curbside delivery cost is calculated upon online checkout.</li><li>Room of Choice Delivery: We’ll bring your equipment to the specific room you choose. This option includes assembly of gym equipment.</li></ol><ul><li>Cost would be the curbside delivery cost + the room of choice cost</li><li>To calculate the room of choice cost, you can select your preferred Room of Choice delivery option directly from the product page. The cost shown will reflect the actual delivery charges for your chosen item and location.</li></ul><p><strong>To give you a general idea of delivery fees, you can also refer to our Delivery Cost Chart, which provides estimated costs for the different options:</strong></p>"
          }
        }
      },
      "block_order": [
        "accordion_d7b3kL",
        "accordion_rrw7HN"
      ],
      "settings": {
        "title": "Northern California Delivery",
        "copy": "<p>If you are located within 120 to 200 miles of our warehouse showroom in Benicia, CA, then we will deliver in our own trucks. There will be no additional transportation time on top of the lead time. Simply expect a call from us when your items are ready for delivery.</p><p>For those located outside our radius, our reliable third-party carriers will handle your packages. Visit our <a href=\"/pages/shipping-information\" target=\"_blank\" title=\"Shipping information\">Shipping Information </a>page for more details.</p>"
      }
    },
