{% layout none %}

<div class="manuals-list__container">
  <h3 class="manuals-list__title">{{ collection.title | remove: "Manuals" }}</h3>
  {%- for product in collection.products -%}
    <a class="manuals-list-item" href="{{ product.metafields.custom.manual_file | file_url  }}" target="_blank">
      {{ product.title }}
    </a>
  {%- endfor -%}
</div>