{% layout none %}

{% paginate collection.products by 50 %}
<div class="manuals-list__container">
  <h3 class="manuals-list__title">{{ collection.title | remove: "Assembly Manuals" | remove: "Owners Manuals" | remove: "All Manuals" }}</h3>
  <div class="manuals-list-inner" data-list-name="{{ collection.handle }}">
    {%- for product in collection.products -%}
      <a class="manuals-list-item" href="{% if product.metafields.custom.manual_file %} {{ product.metafields.custom.manual_file | file_url  }} {% else %} {{ product.metafields.custom.manual_link  }} {% endif %}" target="_blank">
        {{ product.title }}
      </a>
    {%- endfor -%}
  </div>

  {% if paginate.next %}
    <button class="manuals-load-more" data-handle="{{ collection.handle }}" data-product-count="{{ collection.products_count }}" data-current-page="{{ paginate.current_page }}">Show more manuals</button>
  {% endif %}
</div>
{% endpaginate %}