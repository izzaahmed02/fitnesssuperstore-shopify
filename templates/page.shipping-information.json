    "faq_jHMtqV": {
      "type": "faq",
      "blocks": {
        "question_WBV9A7": {
          "type": "question",
          "settings": {
            "title": "What to expect?",
            "text": "<ul><li>Terms and conditions apply for customers outside of the US and Canada.</li><li>VAT/GST will be charged on the total of the item cost plus shipping for all international destinations, including Canada and Mexico.</li><li>Shipping costs for all countries will reflect on our website upon online checkout.</li><li>International buyers (excluding Canada and smaller items) are responsible for GST/VAT and customs or brokerage fees. Canada shipments will be charged broker fees and GST/VAT.</li><li>Smaller items (under 150 lbs) are shipped via Fedex International Ground, door to door and are subject to customs fees and VAT, which will be included upon checkout.</li><li>Equipment that weighs 150 lbs or more will be shipped via ocean freight.</li><li>Our website provides a quotation for CIF terms to the largest port in the country of destination.</li><li>Should you prefer DDP or EXW terms, please contact us to receive a custom quotation.</li><li>We can ship to most ports in your country. However, any ports other than the largest, will require a quote, which you can email, chat, or call our team for.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_zybLPa": {
          "type": "question",
          "settings": {
            "title": "Differences among CIF, DDP, and EXW terms",
            "text": "<ul><li><strong>CIF contract</strong> - The price covers transportation to the largest port in your country, and all fees associated with getting it to the largest port in your country. However, all fees after the arrival to the destination port are the customer’s responsibility. The customer is responsible for: (1) customs duties and taxes, (2) arranging and paying for transportation from the port to the final destination, and (3) destination port fees.</li><li><strong>DDP contract</strong> - Customs duties and arranging and paying for transportation until they reach the destination, and their taxes are factored into the equipment's total price. The seller is accountable for ar responsibility until the product is delivered to the agreed-upon location.</li><li><strong>EXW contract</strong> - The customer is responsible for picking up the item/s from our warehouse, coordinating with couriers, and all customs duties, taxes, port charges, and other fees that may be incurred to reach the point of destination.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        }
      },
      "block_order": [
        "question_WBV9A7",
        "question_zybLPa"
      ],
