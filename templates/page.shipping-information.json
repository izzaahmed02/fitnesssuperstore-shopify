    "image_with_text_6DQ4XN": {
      "type": "image-with-text",
      "blocks": {
        "heading_UPhUDi": {
          "type": "heading",
          "settings": {
            "heading": "Curbside Delivery",
            "heading_size": "tiny",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_TKxCiw": {
          "type": "text",
          "settings": {
            "text": "<p>Get your machines delivered to the closest curb accessible by a 24-foot box truck from your location. In the absence of a nearby curb, your items will be dropped off on your driveway or part of your property closest to the street.</p><p>What to expect:</p><ul><li>Shipping time: 2-14 business days for residents of the lower 48 states and may take longer for other states. You may call or email us to confirm the expected arrival date of your items.</li><li>One person will deliver, shipped through a third party courier</li><li>Machine/s are packed in a crate</li><li>The customer will be responsible for placing their purchases in their preferred areas, as well as unpacking and disposing of the packaging</li><li>Select products will be delivered assembled, while some are disassembled, according to the specific product’s information (which you may find on its product page)</li><li>For addresses without curbs, refer to the image below to determine the possible delivery locations:</li></ul>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
