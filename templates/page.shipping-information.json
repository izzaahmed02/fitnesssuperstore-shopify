        "text_THnnfA": {
          "type": "text",
          "settings": {
            "text": "<p>If you are located within 120 to 200 miles of our warehouse located in Benicia, CA, then we will deliver in our own trucks. And there will be no additional transportation time on top of the lead time. Simply expect a call from us when your items are ready for delivery!</p><p>Ask about this special offer for all local customers: we offer free shipping and 50% off on assembly/installation.</p><p>In-store pickup is also available from our warehouse, with no additional charges. Just indicate your preference for pickup upon checkout.</p><p>Point of reference for our Northern California shipping and in-store pickup address is:</p><p></p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
