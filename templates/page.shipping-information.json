      }
    },
    "rich_text_international_802": {
      "type": "rich-text",
      "blocks": {
        "text_body": {
          "type": "text",
          "settings": {
            "text": "<p>Availability, transportation, duties, taxes, customs clearance and onward delivery depend on the destination and written quote. CIF covers transportation to the specified destination port, with destination charges and onward arrangements handled by the buyer as quoted. DDP covers delivery to the named destination under the quoted inclusive scope. EXW places pickup and transportation arrangements with the buyer. Confirm the quoted responsibilities before ordering.</p>"
          }
        },
