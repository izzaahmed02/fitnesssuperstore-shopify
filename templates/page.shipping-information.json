    "collapsible_content_6WrxWB": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_w8BrTk": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does Fitness Superstore take to deliver?",
            "icon": "none",
            "row_content": "<p>Fitness Superstore <strong>typically ships brand new equipment within 2 to 7 business days</strong>, depending on your location. Remanufactured equipment takes 2 to 5 weeks. International delivery may take longer based on the selected freight method. You can check estimated delivery times by entering your zip code during checkout.</p>",
