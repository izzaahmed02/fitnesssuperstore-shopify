    "rich_text_services_802": {
      "type": "rich-text",
      "blocks": {
        "text_body": {
          "type": "text",
          "settings": {
            "text": "<p>Curbside freight: delivery to the closest accessible curbside area. The customer moves the equipment from curbside, unpacks it and disposes of the packaging. Equipment may arrive assembled or disassembled as stated on the product page.</p><p>Garage delivery, no unpacking: equipment is left in its crate in the garage. The customer handles movement beyond the garage, unpacking and packaging disposal. Confirm driveway and pallet-jack access before booking.</p><p>Parcel: smaller eligible items travel by parcel carrier or our local vehicle. Parcel delivery does not include assembly.</p><p>Room of choice / assembly: select the service offered for the item. The purchased scope determines placement, unpacking, assembly and packaging removal. Provide room location, doorway/path measurements, stairs and access photos before booking. Do not assume these services are included with curbside, parcel or free shipping. For a two-step delivery-and-installation arrangement, transportation and the assembler's appointment are confirmed separately; the transit estimate is not an installation-completion date.</p>"
          }
        },
        "heading_services": {
          "type": "heading",
          "settings": {
            "heading": "Choose your delivery service",
            "heading_size": "h2"
          }
        }
      },
      "block_order": [
        "heading_services",
        "text_body"
      ],
      "settings": {
        "desktop_content_position": "left",
        "content_alignment": "left",
        "color_scheme": "",
        "full_width": false,
        "max-width": 780,
        "h1": false,
