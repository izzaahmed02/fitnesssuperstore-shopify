        "title": "How Fitness Superstore Packages Gym Equipment",
        "use_h1": false,
        "text": "Fitness Superstore gym equipment is meticulously packaged to ensure that you receive your purchases in top condition. We have found that this is the most effective way to deliver your items in mint condition.",
        "use_larger_text": false,
        "enable_video_looping": false,
        "video_url": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
