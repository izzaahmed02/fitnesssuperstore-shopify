    "faq_333TMG": {
      "type": "faq",
      "blocks": {
        "question_DU4YLg": {
          "type": "question",
          "settings": {
            "title": "Garage Installation",
            "text": "<p>If you’re setting up a garage gym, then this service is perfect for you! We can assemble your equipment right into their new home with our garage installation services. </p><p>What to expect:</p><ul><li>Shipping time: 5-17 business days to the lower 48 states in addition to the processing time stated on the item page. Note that it may take longer for other states. You may call or email us to confirm the expected arrival date of your items.</li><li>If there are barriers such as stairs, soil, grass, or a passageway smaller than 60” wide, then this service will not suffice.</li><li>We will take care of unpacking, hauling out the packaging, and installation of your equipment in the designated garage space.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_gHDnL8": {
          "type": "question",
          "settings": {
            "title": "Room of Choice Delivery, Fully Assembled (0-3 Steps)",
            "text": "<ul><li>If there are 3 steps or less from the entrance to the room of choice where the items will be assembled, this option is for you</li><li>The item may arrive fully assembled or to be assembled on-site</li><li>The packaging will be removed and hauled away</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_TbaNGN": {
          "type": "question",
          "settings": {
            "title": "Room of Choice Delivery, Fully Assembled (4+ Steps)",
            "text": "<ul><li>If there are 4 or more steps from the entrance to the room of choice where the items will be assembled, this option is for you</li><li>The item may arrive fully assembled or to be assembled on-site</li><li>The packaging will be removed and hauled away</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_h6yJJA": {
          "type": "question",
          "settings": {
            "title": "Any Room of Choice, Fully Assembled",
            "text": "<ul><li>This option is only applicable to select items. Select this choice if it appears.</li><li>Whether it’s a garage delivery, 0-3 steps, or 4+ steps room of choice delivery, this option will suffice, covering the same services of assembly, unpacking, and hauling of packaging materials.</li><li>If you are unsure on which option you should select, get in touch with our sales representatives from 6am to 6pm, Pacific Standard Time, at 925-215-292.</li></ul><p>What to expect:</p><ul><li>Shipping time: 5-17 business days to the lower 48 states in addition to the processing time stated on the item page. Note that it may take longer for other states. You may call or email us to confirm the expected arrival date of your items.</li><li>We will need concrete details on which area of your home or business it will be set up, including the width of the most narrow door, number of steps, and other details or photos of where the equipment will pass through, from the entrance to your room of choice. All information must be provided in the order comments of our checkout page. Otherwise, we will send you an email requesting for the measurements, photos, or a video. Failure to provide information may lead to delays in shipping.</li><li>The items will be shipped through a third party courier.</li><li>Room of choice delivery does not include a demonstration of how to use the product. Our movers are not permitted to test nor plug in the equipment, to protect your warranty validity.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_LPpcCE": {
          "type": "question",
          "settings": {
            "title": "Assembly- Any Room (2 Step Process)",
            "text": "<ul><li>Shipping to be handled by FedEx or Curbside via freight</li><li>Customer is responsible for removing debris or barriers going to the room of choice</li><li>An assembler will arrive approximately after 7 days to move the item/s to your room of choice and install them</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        }
      },
      "block_order": [
        "question_DU4YLg",
        "question_gHDnL8",
        "question_TbaNGN",
        "question_h6yJJA",
        "question_LPpcCE"
      ],
      "custom_css": [
        "@media screen and (max-width: 750px) {.faq {padding-block: 48px; } .h2 {font-size: 20px; line-height: 26px; } .faq__text {margin-top: 16px; }}"
      ],
      "settings": {
        "title": "Room of Choice Delivery",
        "text": "Conveniently have your gym equipment delivered and assembled in the room of your choice- whether it’s up four flights of stairs or straight to your garage. This service includes unpacking of purchased items, disposing of packaging, and full assembly of the machine/s in your desired space.\n<br>\n<br>\nIn the checkout page, you will see 5 options under the drop-down Room of Choice Delivery menu. Here’s a guide on how to determine which one is applicable to your order:",
        "heading_position": "left",
        "full-column-width": false
      }
    },
    "faq_jHMtqV": {
      "type": "faq",
      "blocks": {
        "question_WBV9A7": {
          "type": "question",
          "settings": {
            "title": "What to expect?",
            "text": "<ul><li>Terms and conditions apply for customers outside of the US and Canada.</li><li>Shipping costs for all countries will reflect on our website upon online checkout.</li><li>International buyers (excluding Canada and smaller items) are responsible for GST/VAT and customs or brokerage fees. Canada shipments will be charged broker fees and GST/VAT.</li><li>Smaller items (under 150 lbs) are shipped via Fedex International Ground, door to door and are subject to customs fees and VAT, which will be included upon checkout.</li><li>Equipment that weighs 150 lbs or more will be shipped via ocean freight.</li><li>Our website provides a quotation for CIF terms to the largest port in the country of destination.</li><li>Should you prefer DDP or EXW terms, please contact us to receive a custom quotation.</li><li>We can ship to most ports in your country. However, any ports other than the largest, will require a quote, which you can email, chat, or call our team for.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
