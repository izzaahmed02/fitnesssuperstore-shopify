    "faq_333TMG": {
      "type": "faq",
      "blocks": {
        "question_DU4YLg": {
          "type": "question",
          "settings": {
            "title": "Garage Installation",
            "text": "<p>Choose this option when your destination is a garage with straightforward access.</p><p>What to expect:</p><ul><li><strong>Estimated transit:</strong> 5–17 business days to most addresses in the contiguous U.S., plus the processing time shown on the product page (timing can vary by location).</li><li><strong>Access notes:</strong> Intended for paths without stairs/steps and with adequate clearance (tight turns, narrow doorways, grass/soil, or steep/uneven paths may require a different option).</li><li><strong>What’s included:</strong> Delivery into the garage, unpacking, packaging removal, and assembly where included in the selected service.</li><li><strong>Need help choosing?</strong> Call <strong>925-215-2927</strong> or email <a href=\"mailto:sales@fitnesssuperstore.com\" target=\"_blank\"><strong>sales@fitnesssuperstore.com</strong></a>.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_gHDnL8": {
          "type": "question",
          "settings": {
            "title": "Room of Choice Delivery, Fully Assembled (0-3 Steps)",
            "text": "<p>Select this option if there are <strong>0–3 steps total </strong>from the entry point to the destination room.</p><ul><li>Equipment may arrive fully assembled or be assembled on-site, depending on the item and access.</li><li>Packaging removal is included where applicable to the selected service.</li><li>You may be asked to confirm access details (e.g., narrowest doorway width, step count). See the <a href=\"/pages/delivery-assembly-legal-addendum\" title=\"Delivery & Assembly Legal Addendum\">Legal Addendum</a> for details.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_TbaNGN": {
          "type": "question",
          "settings": {
            "title": "Room of Choice Delivery, Fully Assembled (4+ Steps)",
            "text": "<p>Select this option if there are <strong>4 or more steps total </strong>from the entry point to the destination room.</p><ul><li>Equipment may arrive fully assembled or be assembled on-site, depending on the item and access.</li><li>Packaging removal is included where applicable to the selected service.</li><li>Additional access details may be required to schedule service. See the <a href=\"/pages/delivery-assembly-legal-addendum\" title=\"Delivery & Assembly Legal Addendum\">Legal Addendum</a> for details.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_h6yJJA": {
          "type": "question",
          "settings": {
            "title": "Any Room of Choice, Fully Assembled (Select Items Only)",
            "text": "<p>This option appears only for select items. If it is shown at checkout, it can cover garage delivery, 0–3 steps, or 4+ steps Room of Choice setups for that item.</p><p><strong>What to expect:</strong></p><ul><li><strong>Estimated transit:</strong> 5–17 business days to most addresses in the contiguous U.S., plus the processing time shown on the product page (timing can vary by location).</li><li>To avoid delays, include access notes at checkout (step count, narrowest doorway, tight turns/landings, elevator availability, obstacles). Photos/video can help when requested.</li><li>Delivery and assembly may be scheduled separately depending on the item and location.</li><li>If you’re unsure which option to select, call <strong>925-215-2927</strong> or email <a href=\"mailto:sales@fitnesssuperstore.com\" target=\"_blank\"><strong>sales@fitnesssuperstore.com</strong></a>.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        },
        "question_LPpcCE": {
          "type": "question",
          "settings": {
            "title": "Assembly- Any Room (2 Step Process)",
            "text": "<p>This option is used when delivery and assembly occur as two separate steps.</p><ul><li><strong>Step 1:</strong> Delivery is completed via FedEx (small parcel) or freight (curbside), depending on the item(s).</li><li><strong>Step 2:</strong> Assembly is scheduled separately after delivery (timing varies by location; many areas schedule approximately <strong>7+ days</strong> after delivery).</li><li>Customer is responsible for clearing a safe path and removing barriers to the destination room.</li><li>See the <a href=\"/pages/delivery-assembly-legal-addendum\" title=\"Delivery & Assembly Legal Addendum\"><strong>Delivery & Assembly Legal Addendum</strong></a> for full terms, requirements, and limitations.</li></ul>",
            "url_text": "",
            "btn_text": "",
            "url_link": "",
            "arrow": "false"
          }
        }
      },
      "block_order": [
        "question_DU4YLg",
        "question_gHDnL8",
        "question_TbaNGN",
        "question_h6yJJA",
        "question_LPpcCE"
      ],
