    "homepage_faqs_wUTedA": {
      "type": "homepage-faqs",
      "blocks": {
        "faq_pFHtjY": {
          "type": "faq",
          "settings": {
            "title": "How long does Fitness Superstore take to deliver?",
            "copy": "<p>Fitness Superstore <strong>typically ships brand new equipment within 2 to 7 business days</strong>, depending on your location. Remanufactured equipment takes 2 to 5 weeks. International delivery may take longer based on the selected freight method. You can check estimated delivery times by entering your zip code during checkout.</p>"
          }
        },
        "faq_PmwNiH": {
          "type": "faq",
          "settings": {
            "title": "What delivery options are available?",
            "copy": "<p>Fitness Superstore offers several delivery options, including curbside, garage delivery, and delivery with assembly. For customers within 120 to 200 miles of our Benicia, CA warehouse, we provide direct delivery via our own trucks. Other areas are served by partner couriers, and smaller items are shipped via USPS, FedEx, or UPS.</p>"
          }
        },
        "faq_rNyzfA": {
          "type": "faq",
          "settings": {
            "title": "How much does delivery cost?",
            "copy": "<p>Delivery costs vary based on location and delivery method. We offer various delivery options, including curbside, garage delivery, and assembly services. To get an accurate shipping cost, simply select your delivery preference and enter your zip code during checkout. Costs are calculated based on the service chosen.</p>"
          }
        },
        "faq_VLCGNP": {
          "type": "faq",
          "settings": {
            "title": "What happens with late deliveries?",
            "copy": "<p>If your delivery is late, please contact us at <a href=\"mailto:sales@fitnesssuperstore.com\" target=\"_blank\">sales@fitnesssuperstore.com</a>. Our team will promptly investigate the issue, and a manager will follow up with a satisfactory resolution. We are committed to ensuring every customer receives their order on time and in full.</p>"
          }
        },
        "faq_ynDpNK": {
          "type": "faq",
          "settings": {
            "title": "How should I handle short deliveries or damaged packaging?",
            "copy": "<p>If items are missing or packaging is damaged, note it on the delivery receipt before signing, take photos, and email <a href=\"mailto:sales@fitnesssuperstore.com\" target=\"_blank\">sales@fitnesssuperstore.com</a>. We’ll review the issue and advise on next steps based on the situation.</p>"
          }
        }
      },
      "block_order": [
        "faq_pFHtjY",
        "faq_PmwNiH",
        "faq_rNyzfA",
        "faq_VLCGNP",
        "faq_ynDpNK"
