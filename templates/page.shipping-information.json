    "image_with_text_bLhqDJ": {
      "type": "image-with-text",
      "blocks": {
        "heading_rrjN9x": {
          "type": "heading",
          "settings": {
            "heading": "SHIPPING TERMS & CONDITIONS",
            "heading_size": "h2",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_4Lz3Xr": {
          "type": "text",
          "settings": {
            "text": "<p>The delivery costs reflected on our website assume that the customer has provided us with accurate shipping and warranty information. Additional charges will incur when:</p><ul><li>A customer cancels the delivery when the item has already been loaded into the truck or courier</li><li>A customer is late for the agreed delivery appointment</li><li>A customer does not respond to the shipper within 5 business days of contact attempt. This will accumulate to storage fees</li><li>A “Room of Choice Delivery” customer provides inaccurate house measurements or insufficient information regarding their home or space, which will lead to a failed delivery</li></ul><p></p><p><a href=\"/pages/terms-conditions\" target=\"_blank\" title=\"Terms & Conditions\">Visit this page for the complete terms and conditions.</a></p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
