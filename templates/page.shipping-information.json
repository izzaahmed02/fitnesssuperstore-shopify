    "rich_text_bbDgaK": {
      "type": "rich-text",
      "blocks": {
        "heading_fKhMVq": {
          "type": "heading",
          "settings": {
            "heading": "Small Parcel Deliveries",
            "heading_size": "h1"
          }
        },
        "text_J3YCAT": {
          "type": "text",
          "settings": {
            "text": "<p>Smaller items that don’t need assembly or can fit in standard parcels will be shipped out either through one of our partner couriers or personally delivered by our in-house vehicle. Parcels to be shipped within 120 miles of our showroom in Benicia, CA will be delivered by our trucks. Beyond 120 miles, shipping will be through USPS, FedEx, or UPS. Expect delivery within 1-6 business days for the lower 48 states in addition to the processing time stated on the item page.</p><p><a href=\"/pages/contact\" title=\"Contact us\">Contact us to confirm the expected arrival date of your items.</a></p>"
          }
        }
      },
