    "image_with_text_kNFK3X": {
      "type": "image-with-text",
      "blocks": {
        "text_C8yRDr": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Here’s an overview of what you can expect on your delivery:</strong></p><ul><li>Brand New Machines: Machines are disassembled upon delivery. Frame pieces are either blanket wrapped or in cardboard boxes. The equipment is securely attached to the bottom pallet or frame, ensuring stability and product safety.</li><li>Remanufactured Machines: Crate with the product securely tied to a wooden frame with the same material used on a treadmill belt.</li><li>Parcel Deliveries: Cardboard boxes (items below 150 lbs, FedEx: within 165” in length and girth, USPS: within 130” in length and girth) or blanket wrapped for heavy metal parts.</li><li>Plywood is placed over fragile areas like consoles, cardio equipment, and other plastic materials.</li><li>Upon sealing, the crates are enclosed with heavy duty stretch wrap and a strapping machine is used, firmly locking all layers of packaging.</li></ul><p></p>",
            "text_style": "body",
            "text_size": "middle"
          }
        }
      },
      "block_order": [
        "text_C8yRDr"
      ],
