    "image_with_text_eLQQ7N": {
      "type": "image-with-text",
      "blocks": {
        "heading_9WTyxG": {
          "type": "heading",
          "settings": {
            "heading": "Garage Delivery, No Unpacking, Left in Crate",
            "heading_size": "tiny",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_3mawKx": {
          "type": "text",
          "settings": {
            "text": "<p>If you’d like for us to simply deliver your new gym equipment to your garage, this is the service to avail.</p><p></p><p>What to expect:</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
        "list_mdqtLE": {
          "type": "list",
          "settings": {
            "list": "<p>Shipping time: 2-14 business days to the lower 48 states<strong> in addition to the processing time stated on the item page. </strong>Note that it may take longer for other states. You may <strong>call</strong> or <strong>email us</strong> to confirm the expected arrival date of your items.</p><p>The courier will arrive equipped with a liftgate and a pallet jack, which can only cross gravel and concrete roads.</p><p>The customer will be responsible for placing their purchases in their specific preferred areas other than the garage, as well as unpacking and disposing of the packaging.</p>"
          }
        }
      },
