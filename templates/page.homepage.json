          }
        },
        "review_KhUMWE": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/product-image.jpg",
            "stars": "5",
            "title": "Reliable Enough for First Responders",
            "copy": "This French Fitness FFB Black Dual Adjustable Pulley system arrived just as advertised. Our firefighters utilize this machine on a daily basis and love it! The quality and value of this machine is unmatched.”",
