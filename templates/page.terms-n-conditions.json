          "type": "item",
          "settings": {
            "text_without_number": "",
            "text": "<p>Use any portion of the Website for uploading, posting, e-mailing, transmitting, or otherwise making available junk mail, commercial advertisements, or any other form of commercial solicitation.</p>",
            "sub_items": ""
          }
        },
        "item_gJtEmf": {
          "type": "item",
          "settings": {
