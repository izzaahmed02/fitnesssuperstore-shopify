        "heading_wpGfPr": {
          "type": "heading",
          "settings": {
            "heading": "TIFFANY AND CHRISTIAN - FORGE CHS",
            "heading_size": "h2",
            "text_transform": true,
            "mobile_title_size": "normal"
          }
        },
        "text_3wnaVB": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Forge CHS</strong> is a 10,000 sq ft locally owned, 24/7 gym in Charleston, SC designed to give members everything they expect from a big-box gym without the crowds or confusion. When Tiffany and Christian set out to build their facility, they wanted commercial-grade equipment that could handle round-the-clock use across their membership base, personal training clients, and group classes. The challenge was finding machines built to take rep after rep without fear of failure while supporting Tiffany's coaching philosophy of intentional, safe training that drives real progress. With nearly 20 years of experience in strength training, conditioning, and functional fitness, Tiffany knew exactly what the equipment needed to deliver. To achieve this, Forge CHS partnered with Fitness Superstore, based out of Benicia, California, and selected French Fitness gym equipment throughout the entire facility. The machines are clearly built to last, focus on safety features, and provide the durability required for a 24/7 operation. The comprehensive warranty coverage and all-in-one sourcing made French Fitness the ideal fit for a facility where equipment would see constant daily use from members of all experience levels.</p>",
            "text_style": "body",
            "text_size": "middle"
          }
        },
        "list_Er4FnF": {
          "type": "list",
          "disabled": true,
          "settings": {
            "list": "<p>Create a welcoming and unintimidating gym environment for all fitness levels</p>"
