      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n\n    <h3 style=\"\n      font-size:22px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      USA &amp; Canada Warranty Terms\n    </h3>\n\n    <ul style=\"list-style:none;margin:0;padding-left:0;\">\n\n      <!-- Item 1 -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"\n            width:10px;height:10px;border-radius:999px;\n            background:#d83d0e;display:block;\n          \"></span>\n        </span>\n\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>10 Years Parts:</strong> All functional components from the date of purchase.\n        </span>\n      </li>\n\n      <!-- Item 2 -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"\n            width:10px;height:10px;border-radius:999px;\n            background:#d83d0e;display:block;\n          \"></span>\n        </span>\n\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>1 Year Labor:</strong> Covers technician service.\n        </span>\n      </li>\n\n      <!-- Item 3 -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"\n            width:10px;height:10px;border-radius:999px;\n            background:#d83d0e;display:block;\n          \"></span>\n        </span>\n\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Lifetime Frame Warranty:</strong> Structural frame and welds.\n        </span>\n      </li>\n\n      <!-- Item 4 -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"\n            width:10px;height:10px;border-radius:999px;\n            background:#d83d0e;display:block;\n          \"></span>\n        </span>\n\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Accessories &amp; Flooring:</strong> 1 year limited parts warranty. Non functional or cosmetic issues covered if reported within 7 days.\n        </span>\n      </li>\n\n      <!-- Item 5 -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin:0;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"\n            width:10px;height:10px;border-radius:999px;\n            background:#d83d0e;display:block;\n          \"></span>\n        </span>\n\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Labor Extension Options:</strong> 50 dollars per year (storage racks), 100 dollars per year (strength equipment), 150 dollars per year (cardio equipment).\n        </span>\n      </li>\n\n    </ul>\n\n  </section>\n</div>",
