    "custom_liquid_FFERJU": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n    <h3 style=\"\n      font-size:22px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      How To Redeem Your Warranty\n    </h3>\n\n    <ol style=\"list-style:none;margin:0 0 16px 0;padding-left:0;\">\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;\">\n        <div style=\"\n          width:30px;height:30px;border-radius:999px;\n          background:#f1592a;color:#ffffff;font-weight:700;\n          font-size:16px;display:flex;align-items:center;\n          justify-content:center;flex-shrink:0;\n        \">1</div>\n        <div>\n          <h4 style=\"margin:0 0 4px 0;font-size:18px;font-weight:700;color:#242833;\">\n            Contact Us\n          </h4>\n          <p style=\"margin:0;font-size:17px;line-height:26px;\">\n            Start a claim and send photos or videos of the issue.\n          </p>\n        </div>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;\">\n        <div style=\"\n          width:30px;height:30px;border-radius:999px;\n          background:#f1592a;color:#ffffff;font-weight:700;\n          font-size:16px;display:flex;align-items:center;\n          justify-content:center;flex-shrink:0;\n        \">2</div>\n        <div>\n          <h4 style=\"margin:0 0 4px 0;font-size:18px;font-weight:700;color:#242833;\">\n            Confirmation\n          </h4>\n          <p style=\"margin:0;font-size:17px;line-height:26px;\">\n            Our warranty support team will confirm receipt and provide next steps.\n          </p>\n        </div>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;\">\n        <div style=\"\n          width:30px;height:30px;border-radius:999px;\n          background:#f1592a;color:#ffffff;font-weight:700;\n          font-size:16px;display:flex;align-items:center;\n          justify-content:center;flex-shrink:0;\n        \">3</div>\n        <div>\n          <h4 style=\"margin:0 0 4px 0;font-size:18px;font-weight:700;color:#242833;\">\n            Repair Plan\n          </h4>\n          <p style=\"margin:0;font-size:17px;line-height:26px;\">\n            We assess the issue, supply any required parts, and coordinate with an independent service provider to complete repairs.\n          </p>\n        </div>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:0;\">\n        <div style=\"\n          width:30px;height:30px;border-radius:999px;\n          background:#f1592a;color:#ffffff;font-weight:700;\n          font-size:16px;display:flex;align-items:center;\n          justify-content:center;flex-shrink:0;\n        \">4</div>\n        <div>\n          <h4 style=\"margin:0 0 4px 0;font-size:18px;font-weight:700;color:#242833;\">\n            Technician Service\n          </h4>\n          <p style=\"margin:0;font-size:17px;line-height:26px;\">\n            Labor, dispatch, and scheduling are coordinated through third party technicians based on your location and product type.\n          </p>\n        </div>\n      </li>\n    </ol>\n\n    <p style=\"font-size:18px;line-height:28px;margin:16px 0 0 0;\">\n      All warrantied part shipments are prepaid by French Fitness. Customers must return replaced parts using the provided return label to keep coverage in good standing. Cosmetic issues are covered for all products if reported within 7 days of delivery.\n    </p>\n  </section>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_LtQfPB": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n    <div style=\"\n      max-width:100%;\n      margin:0 auto;\n      padding:28px 32px;\n      background:#ffffff;\n      border-left:4px solid #d83d0e;\n      border-radius:8px;\n      box-shadow:0 10px 25px rgba(0,0,0,0.08);\n      position:relative;\n      overflow:hidden;\n      font-style:italic;\n    \">\n      <div style=\"\n        position:absolute;\n        left:0;\n        top:0;\n        width:100%;\n        height:6px;\n        background:linear-gradient(90deg,#f1592a,#d83d0e,#f5a623);\n        opacity:0.9;\n      \"></div>\n\n      <div style=\"\n        display:flex;\n        align-items:center;\n        gap:16px;\n        margin-bottom:20px;\n        position:relative;\n        z-index:1;\n      \">\n        <div style=\"\n          width:56px;\n          height:56px;\n          display:flex;\n          align-items:center;\n          justify-content:center;\n          background:#fff3ed;\n          border-radius:999px;\n          border:2px solid #f1592a;\n        \">\n          <svg viewBox=\"0 0 24 24\" style=\"width:30px;height:30px;fill:#d83d0e;\">\n            <path d=\"M12 2L4 5v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V5l-8-3z\"/>\n          </svg>\n        </div>\n        <div style=\"\n          font-size:32px;\n          font-weight:800;\n          color:#242833;\n          text-transform:uppercase;\n          letter-spacing:1px;\n          line-height:38px;\n          font-style:normal;\n        \">\n          Disclaimer\n        </div>\n      </div>\n\n      <div style=\"position:relative;z-index:1;\">\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          Except as explicitly stated in this warranty, French Fitness makes no other express or implied warranties, including merchantability or fitness for a particular purpose.\n        </p>\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          We expressly disclaim all warranties not outlined herein.\n        </p>\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          Any implied warranties imposed by law are limited to these terms.\n        </p>\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          Neither French Fitness nor its affiliates shall be liable for incidental or consequential damages.\n        </p>\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          Some jurisdictions do not allow limitation of implied warranties or exclusion of incidental damages. Those limitations may not apply in such cases.\n        </p>\n        <p style=\"margin:0 0 14px 0;font-size:18px;line-height:30px;\">\n          This warranty gives you specific legal rights, and you may have additional rights that vary by state.\n        </p>\n        <p style=\"margin:0;font-size:18px;line-height:30px;\">\n          It is the sole express warranty applicable to French Fitness branded products, and no one is authorized to modify or extend these terms on our behalf.\n        </p>\n      </div>\n    </div>\n  </section>\n</div>",
