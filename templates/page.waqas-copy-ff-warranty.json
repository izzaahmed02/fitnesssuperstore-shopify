      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n    <!-- MAIN HEADING + INTRO -->\n    <h2 style=\"\n      font-size:28px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      Official Warranty Policy - Full Terms &amp; Conditions\n    </h2>\n\n    <p style=\"\n      font-size:18px;\n      line-height:28px;\n      margin:0 0 24px 0;\n    \">\n      The following section provides the complete, enforceable warranty terms for French Fitness equipment.\n    </p>\n\n    <!-- USAGE CATEGORIES -->\n    <h3 style=\"\n      font-size:22px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      Usage Categories\n    </h3>\n\n    <div style=\"\n      display:flex;\n      gap:20px;\n      flex-wrap:wrap;\n      margin-bottom:0;\n    \">\n      <!-- Commercial -->\n      <div style=\"\n        flex:1 1 260px;\n        min-width:260px;\n        background:#ffffff;\n        border-radius:18px;\n        border:1px solid #f1f1f1;\n        padding:22px 22px 20px 22px;\n        box-shadow:0 10px 26px rgba(0,0,0,0.06);\n      \">\n        <div style=\"\n          width:56px;\n          height:56px;\n          border-radius:999px;\n          background:radial-gradient(circle at 30% 20%, #ffe4d6, #fff3ed);\n          display:flex;\n          align-items:center;\n          justify-content:center;\n          margin:0 0 14px 0;\n        \">\n          <svg viewBox=\"0 0 24 24\" style=\"width:26px;height:26px;fill:#d83d0e;\">\n            <path d=\"M3 7h2v10H3V7zm4-2h2v14H7V5zm6 0h2v14h-2V5zm6 2h2v10h-2V7zM11 11h2v2h-2v-2z\"/>\n          </svg>\n        </div>\n        <h3 style=\"\n          font-size:20px;\n          font-weight:800;\n          color:#242833;\n          margin:0 0 8px 0;\n        \">\n          Commercial Grade Product Warranty\n        </h3>\n        <p style=\"font-size:16px;line-height:26px;margin:0;\">\n          Intended for gyms, health clubs, and fitness centers where a high volume of users utilize the equipment continuously throughout the day.\n        </p>\n      </div>\n\n      <!-- Light commercial -->\n      <div style=\"\n        flex:1 1 260px;\n        min-width:260px;\n        background:#ffffff;\n        border-radius:18px;\n        border:1px solid #f1f1f1;\n        padding:22px 22px 20px 22px;\n        box-shadow:0 10px 26px rgba(0,0,0,0.06);\n      \">\n        <div style=\"\n          width:56px;\n          height:56px;\n          border-radius:999px;\n          background:radial-gradient(circle at 30% 20%, #ffe4d6, #fff3ed);\n          display:flex;\n          align-items:center;\n          justify-content:center;\n          margin:0 0 14px 0;\n        \">\n          <svg viewBox=\"0 0 24 24\" style=\"width:26px;height:26px;fill:#d83d0e;\">\n            <path d=\"M19 3h-3.18C15.4 1.84 14.3 1 13 1h-2C9.7 1 8.6 1.84 8.18 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 0c.55 0 1 .45 1 1s-.45 1-1 1h-2c-.55 0-1-.45-1-1s.45-1 1-1h2zm4 14H7v-2h10v2zm0-4H7v-2h10v2z\"/>\n          </svg>\n        </div>\n        <h3 style=\"\n          font-size:20px;\n          font-weight:800;\n          color:#242833;\n          margin:0 0 8px 0;\n        \">\n          Light Commercial Product Warranty\n        </h3>\n        <p style=\"font-size:16px;line-height:26px;margin:0;\">\n          Intended for schools, police and fire stations, hospitals, rehab centers, and hotels, where usage averages 2 to 4 hours per day. Warranty is void if used in full commercial environments.\n        </p>\n      </div>\n\n      <!-- Home use -->\n      <div style=\"\n        flex:1 1 260px;\n        min-width:260px;\n        background:#ffffff;\n        border-radius:18px;\n        border:1px solid #f1f1f1;\n        padding:22px 22px 20px 22px;\n        box-shadow:0 10px 26px rgba(0,0,0,0.06);\n      \">\n        <div style=\"\n          width:56px;\n          height:56px;\n          border-radius:999px;\n          background:radial-gradient(circle at 30% 20%, #ffe4d6, #fff3ed);\n          display:flex;\n          align-items:center;\n          justify-content:center;\n          margin:0 0 14px 0;\n        \">\n          <svg viewBox=\"0 0 24 24\" style=\"width:26px;height:26px;fill:#d83d0e;\">\n            <path d=\"M12 3l9 8h-3v9h-5v-6H11v6H6v-9H3l9-8z\"/>\n          </svg>\n        </div>\n        <h3 style=\"\n          font-size:20px;\n          font-weight:800;\n          color:#242833;\n          margin:0 0 8px 0;\n        \">\n          Home Use Product Warranty\n        </h3>\n        <p style=\"font-size:16px;line-height:26px;margin:0;\">\n          Tailored for personal or home settings with usage under 1 hour per day. Warranty is void if used in light commercial or commercial settings.\n        </p>\n      </div>\n    </div>\n  </section>\n</div>",
