    "custom_liquid_fbVFbC": {
      "type": "custom-liquid",
      "name": "Custom Liquid for Disclaimer",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width: 1100px;\n  margin: 40px auto;\n  padding: 20px;\n  display: flex;\n  gap: 28px;\n  flex-wrap: wrap;\n  font-family: inherit;\n  color: #333333;\n\">\n\n  <!-- LEFT COLUMN -->\n  <div style=\"flex: 1 1 520px; min-width: 300px;\">\n\n    <h2 style=\"\n      font-size: 32px;\n      font-weight: 800;\n      color: #242833;\n      margin: 0 0 20px 0;\n    \">\n      Need Assistance?\n    </h2>\n\n    <p style=\"font-size: 18px; line-height: 28px; margin: 0 0 16px 0;\">\n      For all warranty questions, claims, or parts requests:\n    </p>\n\n    <p style=\"font-size: 18px; line-height: 28px; margin: 0 0 16px 0;\">\n      Our support team is available Mon–Fri, 8 a.m. to 4 p.m. PST to help keep your equipment performing its best.\n    </p>\n\n    <p style=\"font-size: 18px; line-height: 28px; margin: 0 0 16px 0;\">\n      All French Fitness products are assembled in California and backed for life by a team that knows high-quality gear down to the last bolt.\n    </p>\n\n    <!-- BLOCKQUOTE NOTE -->\n    <blockquote style=\"\n      border-left: 4px solid #D83D0E;\n      background-color: #f9f9f9;\n      padding: 16px 20px;\n      margin: 20px 0 0 0;\n      font-style: italic;\n      color: #333333;\n    \">\n      <p style=\"margin: 0 0 10px 0; font-size: 18px; line-height: 28px;\">\n        Warranty labor, dispatch, and scheduling are handled by independent service providers coordinated by National Gym Service, our designated warranty dispatch partner.\n      </p>\n      <p style=\"margin: 0 0 10px 0; font-size: 18px; line-height: 28px;\">\n        French Fitness covers all approved warranty parts and labor costs.\n      </p>\n      <p style=\"margin: 0; font-size: 18px; line-height: 28px;\">\n        This partnership ensures consistent nationwide coverage and timely support without affecting customer warranty rights.\n      </p>\n    </blockquote>\n\n  </div>\n\n  <!-- RIGHT COLUMN (CONTACT CARD) -->\n  <div style=\"\n    flex: 0 1 360px;\n    min-width: 300px;\n    background: #fff3ed;\n    border: 2px solid #f1592a;\n    border-radius: 10px;\n    padding: 28px;\n    box-shadow: 0 10px 25px rgba(0,0,0,0.08);\n  \">\n\n    <div style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 20px;\">\n      \n      <h3 style=\"font-size: 24px; font-weight: 800; color: #242833; margin: 0;\">\n        Contact Support\n      </h3>\n    </div>\n\n    <!-- EMAIL WITH ICON -->\n    <div style=\"display: flex; align-items: flex-start; gap: 12px; margin: 0 0 16px 0;\">\n      <div style=\"\n        width: 36px;\n        height: 36px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        background: #ffffff;\n        border-radius: 50%;\n        border: 2px solid #f1592a;\n        flex-shrink: 0;\n      \">\n        <!-- Email Icon -->\n        <svg viewBox='0 0 24 24' style=\"width: 20px; height: 20px; fill: #d83d0e;\">\n          <path d=\"M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z\"/>\n        </svg>\n      </div>\n\n      <p style=\"font-size: 18px; line-height: 28px; margin: 0;\">\n        <strong>Email:</strong><br>\n        <a href=\"mailto:support@frenchfitness.com\" style=\"color: #d83d0e; font-weight: 700; text-decoration: none;\">\n          support@frenchfitness.com\n        </a>\n      </p>\n    </div>\n\n    <!-- PHONE WITH ICON -->\n    <div style=\"display: flex; align-items: flex-start; gap: 12px;\">\n      <div style=\"\n        width: 36px;\n        height: 36px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        background: #ffffff;\n        border-radius: 50%;\n        border: 2px solid #f1592a;\n        flex-shrink: 0;\n      \">\n        <!-- Phone Icon -->\n        <svg viewBox='0 0 24 24' style=\"width: 20px; height: 20px; fill: #d83d0e;\">\n          <path d=\"M6.62 10.79C8.06 13.62 10.38 15.94 13.21 17.38L15.41 15.17C15.69 14.89 16.08 14.78 16.43 14.88C17.55 15.18 18.75 15.34 20 15.34C20.55 15.34 21 15.79 21 16.34V20C21 20.55 20.55 21 20 21C10.61 21 3 13.39 3 4C3 3.45 3.45 3 4 3H7.66C8.21 3 8.66 3.45 8.66 4C8.66 5.25 8.82 6.46 9.12 7.57C9.22 7.92 9.11 8.31 8.83 8.59L6.62 10.79Z\"/>\n        </svg>\n      </div>\n\n      <p style=\"font-size: 18px; line-height: 28px; margin: 0;\">\n        <strong>Phone:</strong><br>\n        <a href=\"tel:19254306111\" style=\"color: #d83d0e; font-weight: 700; text-decoration: none;\">\n          (925) 430-6111\n        </a>\n      </p>\n    </div>\n\n  </div>\n\n</div>",
