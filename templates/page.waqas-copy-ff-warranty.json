    "custom_liquid_bHdDyB": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:40px auto;\n  padding:0 20px 32px 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section style=\"\n    border-bottom:1px solid #e4e4e4;\n    padding-bottom:32px;\n  \">\n\n    <!-- IMAGE FLOAT RIGHT -->\n    <img \n      src=\"https://www.fitnesssuperstore.com/cdn/shop/files/image_14.png?v=1734082464\"\n      alt=\"French Fitness Warranty Image\"\n      style=\"\n        width:360px;\n        height:auto;\n        float:right;\n        margin:4px 0 12px 24px;\n        border-radius:12px;\n        box-shadow:0px 8px 24px rgba(0,0,0,0.12);\n      \"\n    >\n\n    <!-- WRAPPING TEXT -->\n    <p style=\"\n      font-size:18px;\n      line-height:28px;\n      margin:0 0 12px 0;\n      max-width:740px;\n    \">\n      You should not need an expensive gym membership or a luxury budget to train on serious equipment. French Fitness makes high quality, commercial grade gear accessible at prices that do not break the bank, turning any space into a place you actually want to train with stable, safe equipment that inspires confidence every time you use it.\n    </p>\n\n    <div style=\"clear:both;\"></div>\n\n  </section>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_X4kBh4": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n\n    <!-- HEADING -->\n    <h2 style=\"\n      font-size:28px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      How We Build For Confidence\n    </h2>\n\n    <!-- INTRO TEXT -->\n    <p style=\"\n      font-size:18px;\n      line-height:28px;\n      margin:0 0 18px 0;\n      max-width:800px;\n    \">\n      That confidence starts with how we build. French Fitness equipment is engineered around three core priorities:\n    </p>\n\n    <!-- LIST START -->\n    <ul style=\"list-style:none;margin:0 0 16px 0;padding-left:0;\">\n\n      <!-- SAFETY -->\n      <li style=\"display:flex;align-items:flex-start;gap:14px;margin-bottom:14px;\">\n        <span style=\"\n          width:40px;height:40px;border-radius:999px;\n          background:#fff3ed;border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;flex-shrink:0;\n        \">\n          <!-- Shield Check Icon -->\n          <svg viewBox='0 0 24 24' style=\"width:22px;height:22px;fill:#d83d0e;\">\n            <path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14l-3.5-3.5 1.41-1.41L11 12.17l4.09-4.09 1.41 1.41L11 15z\"/>\n          </svg>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Safety:</strong> Smart geometry, controlled movement paths, and intuitive adjustments that keep you supported and in control.\n        </span>\n      </li>\n\n      <!-- DURABILITY -->\n      <li style=\"display:flex;align-items:flex-start;gap:14px;margin-bottom:14px;\">\n        <span style=\"\n          width:40px;height:40px;border-radius:999px;\n          background:#fff3ed;border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;flex-shrink:0;\n        \">\n          <!-- Dumbbell Icon -->\n          <svg viewBox='0 0 24 24' style=\"width:22px;height:22px;fill:#d83d0e;\">\n            <path d=\"M21 9h-2V7h-2v2H7V7H5v2H3v6h2v2h2v-2h10v2h2v-2h2V9z\"/>\n          </svg>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Durability:</strong> Commercial grade frames, welds, and components chosen and tested to handle everyday use in homes and shared spaces.\n        </span>\n      </li>\n\n      <!-- INNOVATION -->\n      <li style=\"display:flex;align-items:flex-start;gap:14px;margin-bottom:0;\">\n        <span style=\"\n          width:40px;height:40px;border-radius:999px;\n          background:#fff3ed;border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;flex-shrink:0;\n        \">\n          <!-- Lightbulb Icon -->\n          <svg viewBox='0 0 24 24' style=\"width:22px;height:22px;fill:#d83d0e;\">\n            <path d=\"M9 21h6v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.58 1.22 4.83 3.11 6.26.54.41.89 1.04.89 1.74V18h6v-1c0-.7.35-1.33.89-1.74C17.78 13.83 19 11.58 19 9c0-3.86-3.14-7-7-7z\"/>\n          </svg>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Innovation:</strong> Ongoing research and development that prototypes, tests, and refines new designs so each generation is more user friendly and rewarding to use.\n        </span>\n      </li>\n\n    </ul>\n\n    <!-- OUTRO TEXT -->\n    <p style=\"font-size:18px;line-height:28px;margin:0;\">\n      Our product development team tests materials, drawing on years of commercial remanufacturing experience, and oversees U.S. assembly so everything feels stable, smooth, and consistent whenever you reach for it.\n    </p>\n\n  </section>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_dCB8mT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n    <h2 style=\"\n      font-size:28px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 16px 0;\n    \">\n      Built On U.S. Assembly &amp; Remanufacturing Expertise\n    </h2>\n\n    <div style=\"\n      background:#f9fafb;\n      border-radius:12px;\n      border-left:4px solid #f1592a;\n      padding:20px 22px;\n      box-shadow:0 6px 18px rgba(0,0,0,0.04);\n    \">\n      <p style=\"font-size:18px;line-height:28px;margin:0 0 16px 0;\">\n        Before French Fitness became a brand, the team spent years remanufacturing high end commercial equipment from many of the industry's best known names.\n      </p>\n      <p style=\"font-size:18px;line-height:28px;margin:0 0 16px 0;\">\n        At our Benicia, California facilities, remanufactured machines go through a detailed, multi stage process that includes full inspection, deep cleaning, component replacement, reassembly to factory specifications, and final testing.\n      </p>\n      <p style=\"font-size:18px;line-height:28px;margin:0 0 16px 0;\">\n        That hands on experience with what truly holds up over time feeds directly into French Fitness research and development. It shapes how we design frames, select components, and set the quality bar for every new product.\n      </p>\n      <p style=\"font-size:18px;line-height:28px;margin:0;\">\n        In short, French Fitness equipment is the result of years spent rebuilding commercial machines, combined with U.S. assembly and a warranty that stands behind it.\n      </p>\n    </div>\n  </section>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_mCJ9Qk": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"\n  max-width:1100px;\n  margin:0 auto 40px auto;\n  padding:0 20px;\n  font-family:inherit;\n  color:#333333;\n\">\n  <section>\n\n    <!-- HEADING -->\n    <h2 style=\"\n      font-size:28px;\n      font-weight:800;\n      color:#242833;\n      margin:0 0 12px 0;\n    \">\n      How We Stand Behind Your Equipment\n    </h2>\n\n    <!-- INTRO -->\n    <p style=\"\n      font-size:18px;\n      line-height:28px;\n      margin:0 0 16px 0;\n      max-width:800px;\n    \">\n      When you choose French Fitness, you are not just buying gear, you are buying confidence. For most French Fitness strength and cardio equipment, your standard coverage in the USA and Canada includes:\n    </p>\n\n    <!-- WARRANTY BULLETS -->\n    <ul style=\"list-style:none;margin:0 0 16px 0;padding-left:0;\">\n\n      <!-- Lifetime Frame -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:10px;height:10px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>Lifetime Frame Warranty:</strong> Structural frame and welds.\n        </span>\n      </li>\n\n      <!-- 10 Years Parts -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:10px;height:10px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>10 Years Parts:</strong> Functional components.\n        </span>\n      </li>\n\n      <!-- 1 Year Labor -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:0;\">\n        <span style=\"\n          width:26px;height:26px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:10px;height:10px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:28px;\">\n          <strong>1 Year Labor:</strong> Technician service and repairs.\n        </span>\n      </li>\n\n    </ul>\n\n    <!-- MAIN CATEGORY COVERAGE TEXT -->\n    <p style=\"font-size:18px;line-height:28px;margin:16px 0 8px 0;\">\n      This level of coverage applies to <strong>core French Fitness categories</strong>:\n    </p>\n\n    <!-- NEW BULLET LIST FOR CATEGORIES -->\n    <ul style=\"list-style:none;margin:0 0 16px 0;padding-left:0;\">\n\n      <!-- bullet template repeated for each item -->\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Cardio equipment</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Gym systems</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Racks and cages</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Plate-loaded equipment</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Benches</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:8px;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Selectorized equipment</span>\n      </li>\n\n      <li style=\"display:flex;align-items:flex-start;gap:12px;margin-bottom:0;\">\n        <span style=\"\n          width:22px;height:22px;border-radius:999px;\n          border:2px solid #f1592a;\n          display:flex;align-items:center;justify-content:center;\n          background:#ffffff;flex-shrink:0;\n        \">\n          <span style=\"width:8px;height:8px;border-radius:999px;background:#d83d0e;display:block;\"></span>\n        </span>\n        <span style=\"font-size:18px;line-height:26px;\">Storage racks</span>\n      </li>\n\n    </ul>\n\n    <!-- EXTRA COPY -->\n    <p style=\"font-size:18px;line-height:28px;margin:16px 0 12px 0;\">\n      Accessories, free weights, and flooring include a <strong>1-year limited parts warranty</strong>, which covers breakage or failure.\n    </p>\n\n    <p style=\"font-size:18px;line-height:28px;margin:0 0 12px 0;\">\n      Cosmetic issues are covered if reported within <strong>7 days of delivery</strong>. Labor coverage can be extended annually.\n    </p>\n\n    <!-- LINK -->\n    <p style=\"font-size:18px;line-height:28px;margin:12px 0;\">\n      For more about the team and process behind each product, read \n      <a href=\"https://www.fitnesssuperstore.com/pages/about-french-fitness\" style=\"color:#d83d0e;font-weight:700;text-decoration:none;\">\n        About French Fitness\n      </a>.\n    </p>\n\n    <!-- TABLE SECTION FOLLOWS (unchanged) -->\n\n  </section>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_z3Uj6P": {
