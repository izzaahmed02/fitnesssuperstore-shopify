    "payment_faqs_tMPbE4": {
      "type": "payment-faqs",
      "blocks": {
        "accordion_QTYRf4": {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Why am I asked for a phone number at checkout?</p>",
            "accordion_content": "<p>A phone number helps with delivery coordination and may be used for checkout verification for certain payment methods (for example, Shop Pay). Marketing texts are optional and only selected if you opt in.</p>"
          }
        },
        "accordion_XVJkyk": {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Can I use more than one payment method on a single order?</p>",
            "accordion_content": "<p>Online checkout typically supports one payment method per order. If you needsplitpayments, contact our team andwe'lladvisewhat'spossible for your purchase.</p>"
          }
        },
        "accordion_HknPd6": {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>I selected Shop Pay but don't see installments. What should I do?</p>",
            "accordion_content": "<p>Installments can be unavailable based on eligibility, purchase amount, or card/bank rules. If installments are not offered, you can still use Shop Pay to pay in full, try another card, or select Affirm as an alternative pay-over-timeoption.</p>"
          }
        },
        "accordion_ttVtkt": {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>How can I reach a representative if I have an urgent payment question?</p>",
            "accordion_content": "<p>Contact our team and we'll help you choose the best payment path for your order. </p><p>Payment options are subject to eligibility and checkout availability. Financing approvals and terms are determined by the financing provider. </p>"
          }
        }
      },
