    "multicolumn_iGgXmz": {
      "type": "multicolumn",
      "blocks": {
        "column_JLW4pU": {
          "type": "column",
          "settings": {
            "title": "Residential",
            "subtitle": "",
            "text": "<p>Our Residential Warranty applies exclusively to machines used in a home setting for personal use by the purchaser and their extended family. This warranty ensures that your fitness equipment is covered for any mechanical or electronic issues, parts replacements, and labor costs, provided the machine is not used for commercial purposes.</p>",
            "link_text": "",
            "link": "",
            "label_text": ""
          }
        },
        "column_tebhDr": {
          "type": "column",
          "settings": {
            "title": "Commercial",
            "subtitle": "",
            "text": "<p>Our Commercial Warranty is designed for machines used in business or commercial environments, such as gyms, hotels, apartment complexes, schools, and military stations. This warranty covers a wide range of issues, including mechanical and electronic faults, parts replacements, and labor costs, ensuring your equipment remains operational and reliable in a high-use setting.</p>",
            "link_text": "",
            "link": "",
            "label_text": ""
          }
        }
      },
