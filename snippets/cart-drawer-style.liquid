{% style %}
  .cart-link{
    width: 100%;
    height: 48px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #F1592A; 
    margin-top: 16px!important;
  }
  .drawer__heading{
    font-family: "Lato";
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #23232B;
    text-transform: none;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-bottom: 0!important;
    
  }
  .cart-drawer__subheading{
    font-size: 16px;
    font-weight: 400;
    color: #4F4F55;
    line-height: 24px;
    margin-bottom: 24px;
  }
  .cart-drawer__subheading span{
    font-weight: 700;
  }
  .product-option dt{
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: #808080;
  }
  .cart-item__wrapper{
    max-width: 310px;
  }
  .cart-item__details{
    max-width: 310px;
  }
  .cart-item{
    flex-wrap: wrap;
  }
  .extra-option-item{
    display: none;
    align-items: center;
    
    width: calc( 100% - 126px )!important;
    margin-left: auto;
    margin-top: 18px;
    column-gap: 16px;
  }
  
  .cart-drawer .extra-option-item.toggle {
      display: flex;
  }
  .add-info{
    display: flex;
    justify-content: space-between;
    width: calc( 100% - 126px )!important;
    margin-left: auto;
  }
  .extra-option-item dl{
    margin-top: 0;
    margin-bottom: 0;
  }
  .extra-option-item .cart-item__name{
    display: none;
  }
  .extra-price{
    display: none;
  }
  .cart-drawer .extra-option-item .cart-item__media{
    width: 60px;
    height: 60px;
    min-width: 60px;
  }
  .extra-option-item .cart-item__wrapper dt{
    display: none;
  }
  .cart-drawer .extra-option-item .cart-item__image{
    width: 60px;
    height: 60px;
  }
  
  .cart-drawer .extra-option-item .product-option dd{
    display: block;
    max-width: 256px;
  }
  cart-remove-button{
    display: flex;
    flex-direction: column;
    align-items: end;
    font-family: "Lato";
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: #23232B;
    margin-left: auto!important;
  }
  .show-extra{
    display: none;
    justify-content: space-between;
    align-items: center;
    width: calc( 100% - 126px )!important;
    margin-top: 12px;
    margin-left: auto;
    cursor: pointer;
  }
  .show-extra.active svg{
    transform: scale(-1, -1);
  }
  cart-remove-button svg{
    margin-bottom: 16px;
  }
  .quantity-wrapper{
    color: #4F4F55;
  }
  .quantity-wrapper span{
    font-weight: 700;
    margin-left: 12px;
    color: #23232B;
  }
  .price-wrapper{
    font-family: "Lato";
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #23232B;
  }
  .cart-item dl{
    margin-top: 12px;
    margin-bottom: 12px;
  }
  .cart-item{
    padding-top: 16px;
    border-top: 1px solid #E5E5E5;
    margin-top: 16px;
  }  
  .cart-item:first-child{
    padding-top: 0;
    border-top: 0;
    margin-top: 0;
  }
  .total-wrapper{
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #808080;
  }
  .total-wrapper span{
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
    color: #23232B;
  }
  .cart-remove-button{
    background: transparent;
    padding: 0;
    border: 0;
    cursor: pointer;
  }
  .cart-item__quantity {
    margin-left: auto;
  }
  .empty-cart__wrapper{
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .drawer__close{
    margin-left: 10px;
    cursor: pointer;
  }
  .cart-count-bubble span{
    display: none;
  }  
  .extra-option-item .product-option dt{
    display: none;
  }
  @media(max-width: 524px){
    .cart-item__details{
      order: 1;
    }
    .extra-option-item .cart-item__details{
      order: 0;
    }
    .add-info{
      width: 100%!important;
      order: 1;
    }
    .show-extra{
      width: 100%!important;
      order: 1;
    }
    .extra-option-item{
      width: 100%!important;
    }
  }
{% endstyle %}