    window.location.replace('/collections/all' + window.location.search + window.location.hash);
  }
</script>
<script src="{{ 'jquery.min.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'custom.js' | asset_url }}" defer="defer"></script>

{% if settings.animations_reveal_on_scroll %}
  <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% assign should_load_slick = false %}
{% if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'blog' or request.page_type == 'article' or template contains 'page.homepage' or template contains 'page.reviews' or template contains 'page.warehouse' %}
  {% assign should_load_slick = true %}
{% endif %}
{% if should_load_slick %}
  <script src="{{ 'slick.min.js' | asset_url }}" defer></script>
{% endif %}

{% if request.page_type == 'product' %}
  <script>
    (function() {
      var squareLoaded = false;

      function loadSquareMarketplace() {
        if (squareLoaded) return;
        squareLoaded = true;
        var squareScript = document.createElement('script');
        squareScript.src = 'https://js.squarecdn.com/square-marketplace.js';
        squareScript.async = true;
        document.head.appendChild(squareScript);

        ['keydown', 'click', 'touchstart'].forEach(function(evt) {
          window.removeEventListener(evt, onInteraction, { passive: true });
        });
      }

      function onInteraction() {
        loadSquareMarketplace();
      }

      ['keydown', 'click', 'touchstart'].forEach(function(evt) {
        window.addEventListener(evt, onInteraction, { once: true, passive: true });
      });

      window.addEventListener('load', function() {
        window.setTimeout(function() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadSquareMarketplace, { timeout: 5000 });
          } else {
            loadSquareMarketplace();
          }
        }, 3000);
      }, { once: true });
    })();
  </script>
{% endif %}

{% if template contains 'page.about-us' or template contains 'page.warehouse-page' %}
  <script>
    (function() {
      var mapsLoaded = false;

      function loadGoogleMaps() {
        if (mapsLoaded) return;
        mapsLoaded = true;
        var mapsScript = document.createElement('script');
        mapsScript.src = "https://maps.googleapis.com/maps/api/js?key=AIzaSyC1KAxFSFi-ORhUWVMuZfaHGyjAF-pmVDw";
        mapsScript.defer = true;
        document.head.appendChild(mapsScript);
      }

      ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(evt) {
        window.addEventListener(evt, loadGoogleMaps, { once: true, passive: true });
      });

      window.addEventListener('load', function() {
        window.setTimeout(loadGoogleMaps, 1200);
      }, { once: true });
    })();
  </script>
{% endif %}


