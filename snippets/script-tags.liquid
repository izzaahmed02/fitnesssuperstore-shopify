{% if request.page_type == 'product' %}
  <script>
    (function() {
      var squareLoaded = false;

      function loadSquareMarketplace() {
        if (squareLoaded) return;
        squareLoaded = true;
        var squareScript = document.createElement('script');
        squareScript.src = 'https://js.squarecdn.com/square-marketplace.js';
        squareScript.async = true;
        document.head.appendChild(squareScript);

        ['keydown', 'click', 'touchstart'].forEach(function(evt) {
          window.removeEventListener(evt, onInteraction, { passive: true });
        });
      }

      function onInteraction() {
        loadSquareMarketplace();
      }

      ['keydown', 'click', 'touchstart'].forEach(function(evt) {
        window.addEventListener(evt, onInteraction, { once: true, passive: true });
      });

      window.addEventListener('load', function() {
        window.setTimeout(function() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadSquareMarketplace, { timeout: 5000 });
          } else {
            loadSquareMarketplace();
          }
        }, 3000);
      }, { once: true });
    })();
  </script>
{% endif %}

{% if template contains 'page.about-us' or template contains 'page.warehouse-page' %}
  <script>
    (function() {
      var mapsLoaded = false;

      function loadGoogleMaps() {
        if (mapsLoaded) return;
        mapsLoaded = true;
        var mapsScript = document.createElement('script');
        mapsScript.src = "https://maps.googleapis.com/maps/api/js?key=AIzaSyC1KAxFSFi-ORhUWVMuZfaHGyjAF-pmVDw";
        mapsScript.defer = true;
        document.head.appendChild(mapsScript);
      }

      ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(evt) {
        window.addEventListener(evt, loadGoogleMaps, { once: true, passive: true });
      });

      window.addEventListener('load', function() {
        window.setTimeout(loadGoogleMaps, 1200);
      }, { once: true });
    })();
  </script>
{% endif %}


<script>
  (function () {
    var heatmapLoaded = false;

    function initHeatmap() {
      if (heatmapLoaded) return;
      heatmapLoaded = true;

      (window._heatmap_paq = window._heatmap_paq || []).push(['setTrackerUrl', (window.heatUrl = 'https://dashboard.heatmap.com/') + 'heatmap.php']);
      window.hErrorLogs = window.hErrorLogs || [];

      var heatmapScript = document.createElement('script');
      heatmapScript.src = window.heatUrl + 'preprocessor.min.js?sid=2798';
      heatmapScript.defer = true;
      document.head.appendChild(heatmapScript);

      ['error', 'unhandledrejection'].forEach(function (type) {
        window.addEventListener(type, function (event) {
          window.hErrorLogs.push({ type: type, event: event });
        });
      });

      ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (evt) {
        window.removeEventListener(evt, initHeatmap, { passive: true });
      });
    }

    ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (evt) {
      window.addEventListener(evt, initHeatmap, { once: true, passive: true });
    });

    window.addEventListener('load', function () {
      window.setTimeout(initHeatmap, 1500);
    }, { once: true });
  })();
</script>



<script>
  (function () {
    var gtagLoaded = false;

    function loadGtag() {
      if (gtagLoaded) return;
      gtagLoaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };

      var gtagScript = document.createElement('script');
      gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=AW-997565942';
      gtagScript.async = true;
      document.head.appendChild(gtagScript);

      window.gtag('js', new Date());
      window.gtag('config', 'AW-997565942');

      ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (evt) {
        window.removeEventListener(evt, loadGtag, { passive: true });
      });
    }

    ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (evt) {
      window.addEventListener(evt, loadGtag, { once: true, passive: true });
    });

    window.addEventListener('load', function () {
      window.setTimeout(loadGtag, 1500);
    }, { once: true });
  })();
</script>
