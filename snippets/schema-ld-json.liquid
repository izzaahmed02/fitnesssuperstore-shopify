{% case template.name %}
  {% when 'index' %}
    {% render 'schema-organization' %}
  {% when 'product' %}
    {% if product.template_suffix == 'discontinued' %}
      {% render 'schema-product-discontinued', product: product %}
    {% else %}
      {% render 'schema-product', product: product %}
    {% endif %}
  {% when 'collection' %}
    {% render 'schema-collection', collection: collection %}
  {% when 'article' %}
    {% if article.metafields.custom.seo_videos %}
      {% render 'schema-video', videos: article.metafields.custom.seo_videos.value %}
    {% endif %}
  {% when 'page' %}
    {% if page.metafields.custom.seo_videos %}
      {% render 'schema-video', videos: page.metafields.custom.seo_videos.value %}
    {% endif %}
{% endcase %}