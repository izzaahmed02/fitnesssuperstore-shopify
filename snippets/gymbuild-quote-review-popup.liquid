    position: fixed;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    z-index: -1;
    overflow-y: auto;
    padding: 40px 16px;
    background: rgba(35, 35, 43, 0.5);
  }

  .gymbuild-quote-review-modal[open] {
    opacity: 1;
    visibility: visible;
    /* Above the customize drawer's z-index: 101 — this can open from
       inside that drawer, and must render on top of it. */
    z-index: 102;
  }

  .gymbuild-quote-review-modal__content {
    box-sizing: border-box;
    position: relative;
    background: #fff;
    width: min(600px, 100%);
    margin: 0 auto;
    border-radius: 12px;
    padding: 28px;
  }

