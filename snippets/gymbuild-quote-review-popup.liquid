</style>

<script>
  (function () {
    var reviewModal = document.getElementById('GymBuildQuoteReviewModal-{{ section.id }}');
    if (!reviewModal) return;

    var noSwapsEl = reviewModal.querySelector('[data-gymbuild-review-no-swaps]');
    var swapsListEl = reviewModal.querySelector('[data-gymbuild-review-swaps]');
    var customizationsRow = reviewModal.querySelector('[data-gymbuild-review-customizations-row]');
    var customizationsPriceEl = reviewModal.querySelector('[data-gymbuild-review-customizations-price]');
    var noAddonsEl = reviewModal.querySelector('[data-gymbuild-review-no-addons]');
    var addonsListEl = reviewModal.querySelector('[data-gymbuild-review-addons]');
    var addonsRow = reviewModal.querySelector('[data-gymbuild-review-addons-row]');
    var addonsPriceEl = reviewModal.querySelector('[data-gymbuild-review-addons-price]');
    var subtotalEl = reviewModal.querySelector('[data-gymbuild-review-subtotal]');
    var basePriceCents = {{ current_variant.price }};

    function formatMoney(cents) {
      return '$' + (cents / 100).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function formatDelta(deltaCents) {
      var sign = deltaCents > 0 ? '+ ' : '- ';
      return sign + formatMoney(Math.abs(deltaCents));
    }

    // Returns the swaps' net price delta in cents, so the caller can fold it
    // into the subtotal alongside the add-ons total.
    function populateSwaps() {
      var items = Array.from(document.querySelectorAll('[data-gymbuild-item]'));
      var swapped = items.filter(function (item) {
        return item.dataset.itemId !== item.dataset.originalId;
      });

      swapsListEl.innerHTML = '';

      if (!swapped.length) {
        noSwapsEl.hidden = false;
        customizationsRow.hidden = true;
        return 0;
      }

      noSwapsEl.hidden = true;

      var totalDeltaCents = 0;

      swapped.forEach(function (item) {
        var currentPrice = parseInt(item.dataset.itemPrice, 10) || 0;
        var originalPrice = parseInt(item.dataset.originalPrice, 10) || 0;
        var qty = parseInt(item.dataset.itemQty, 10) || 1;
        var deltaCents = (currentPrice - originalPrice) * qty;
        totalDeltaCents += deltaCents;

        var deltaClass = deltaCents > 0 ? 'is-increase' : (deltaCents < 0 ? 'is-decrease' : '');

        var row = document.createElement('div');
        row.className = 'gymbuild-quote-review-modal__swap-item';
        row.innerHTML =
          '<img class="gymbuild-quote-review-modal__swap-item-image" src="' + item.dataset.itemImage + '" alt="" loading="lazy">' +
          '<div>' +
          '<p class="gymbuild-quote-review-modal__swap-item-title">' + item.dataset.itemTitle + '</p>' +
          '<p class="gymbuild-quote-review-modal__swap-item-delta ' + deltaClass + '">' + formatDelta(deltaCents) + '</p>' +
          '</div>';

        swapsListEl.appendChild(row);
      });

      customizationsRow.hidden = false;
      customizationsPriceEl.textContent = formatDelta(totalDeltaCents);
      return totalDeltaCents;
    }

    // Add-ons are toggled on the PDP's own carousel (product-add-ons-quote),
    // outside this modal — the DOM there is the single source of truth, read
    // fresh each time this modal opens. Returns their total in cents.
    function populateAddOns() {
      var selected = Array.from(
        document.querySelectorAll('product-add-ons-quote [data-addon-state="selected"]')
      );

      addonsListEl.innerHTML = '';

      if (!selected.length) {
        noAddonsEl.hidden = false;
        addonsRow.hidden = true;
        return 0;
      }

      noAddonsEl.hidden = true;

      var totalCents = 0;

      selected.forEach(function (toggle) {
        var priceCents = parseInt(toggle.dataset.addonPriceCents, 10) || 0;
        totalCents += priceCents;

        var row = document.createElement('div');
        row.className = 'gymbuild-quote-review-modal__swap-item';
        row.innerHTML =
          '<img class="gymbuild-quote-review-modal__swap-item-image" src="' + toggle.dataset.addonImage + '" alt="" loading="lazy">' +
          '<div>' +
          '<p class="gymbuild-quote-review-modal__swap-item-title">' + toggle.dataset.addonTitle + '</p>' +
          '<p class="gymbuild-quote-review-modal__swap-item-delta is-increase">' + formatDelta(priceCents) + '</p>' +
          '</div>';

        addonsListEl.appendChild(row);
      });

      addonsRow.hidden = false;
      addonsPriceEl.textContent = formatDelta(totalCents);
      return totalCents;
    }

    function populateReview() {
      var swapsDeltaCents = populateSwaps();
      var addOnsTotalCents = populateAddOns();
      subtotalEl.textContent = formatMoney(basePriceCents + swapsDeltaCents + addOnsTotalCents);
    }

    // Nothing is submitted anywhere yet, and this form has no action, so an
    // uncaught submit would just reload the PDP with the fields as query
    // params. Block it unconditionally — the Phase 3 handler replaces this
    // body with the payload build + fetch(), keeping the preventDefault().
    var reviewForm = reviewModal.querySelector('[data-gymbuild-review-form]');
    if (reviewForm) {
      reviewForm.addEventListener('submit', function (event) {
        event.preventDefault();
      });
    }

    // Delegated on document (not querySelectorAll + per-element listeners):
    // this snippet's inline script block runs as soon as it's parsed,
    // which is BEFORE the main PDP's own "Request Quote Review" button
    // (further down the section) exists in the DOM yet. Matching at
    // click-time instead of attach-time makes this work regardless of
    // where either trigger button sits in the HTML.
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-gymbuild-open-review]');
      if (!trigger) return;

      var customizeDrawer = document.getElementById('GymBuildCustomizeModal-{{ section.id }}');
      if (customizeDrawer && customizeDrawer.hasAttribute('open')) {
        customizeDrawer.hide();
      }

      populateReview();
      reviewModal.show(trigger);
    });
  })();
</script>
