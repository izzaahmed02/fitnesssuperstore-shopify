    font-weight: 700;
    color: #23232b;
  }

  .gymbuild-quote-review-modal__details {
    margin-bottom: 18px;
  }

  .gymbuild-quote-review-modal__details-list {
    margin: 0;
    padding-left: 18px;
    font-size: 13px;
