  }

  .gymbuild-quote-review-modal__package {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .gymbuild-quote-review-modal__package-image-wrap {
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    background: #faf9f9;
    border-radius: 6px;
    overflow: hidden;
  }

  .gymbuild-quote-review-modal__package-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .gymbuild-quote-review-modal__package-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: #23232b;
  }

  .gymbuild-quote-review-modal__package-price {
    margin: 2px 0 0;
    font-size: 18px;
    font-weight: 700;
    color: #f1592a;
  }

