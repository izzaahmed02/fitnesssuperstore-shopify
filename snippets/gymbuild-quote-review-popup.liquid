    opacity: 1;
    visibility: visible;
    /* Above the customize drawer's z-index: 101 — this can open from
       inside that drawer, and must render on top of it. */
    z-index: 102;
  }

  .gymbuild-quote-review-modal__content {
    box-sizing: border-box;
    position: relative;
    background: #fff;
    width: min(600px, 100%);
    margin: 0 auto;
    border-radius: 12px;
    padding: 28px;
  }

  .gymbuild-quote-review-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .gymbuild-quote-review-modal__title {
    font-size: 24px;
    line-height: 30px;
    font-weight: 700;
    text-transform: uppercase;
    color: #23232b;
    margin: 0;
  }

