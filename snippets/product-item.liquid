{% assign product = product %}
<div class="product-item card__inner" data-product-id="{{ product.id }}">
    <div class="image-wrap">
        {% assign images = product.images %}
        {% for item in images limit: 5 %}
            {% if item != '' %}
                <div class="image-item">
                    {{ item | image_url: width: auto | image_tag: class: 'lazy-load' }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <div class="tags-wrapper">
        {%- if product.available != false -%}
            {% unless  product.metafields.custom.processing_time  == blank %}
                <div class="ship-wrapper">
                    {% comment %}
                    {% render 'icon-ship' %}
                    {% endcomment %}
                    {{ product.metafields.custom.processing_time | replace: "from our Warehouse", "" | replace: "leave our Warehouse", "" | replace: "from Manufacturer's Warehouse", "" }}
                </div>
            {% endunless %}
        {% endif %}
        {% if product.metafields.custom.condition_state contains "New" %}
            <div class="condition-tag">
                {% render 'icon-new' %}
                New
            </div>
        {% else %}
            <div class="condition-tag blue">
                {% render 'icon-remanufactured' %}
                Remanufactured
            </div>
        {% endif %}
        {% if product.compare_at_price != blank %}
            <div class="sale-tag">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M8.21437 1.54706L8.0026 2C8.21437 1.54706 8.21458 1.54716 8.2148 1.54726L8.21535 1.54752L8.21675 1.54818L8.22084 1.55012L8.234 1.55644C8.24496 1.56175 8.26024 1.56925 8.27955 1.57895C8.31817 1.59836 8.37296 1.62662 8.44161 1.66388C8.57884 1.73835 8.77189 1.849 9.00215 1.99703C9.46184 2.29254 10.0745 2.74001 10.6883 3.34984C11.9163 4.56985 13.1693 6.46277 13.1693 9.09091C13.1693 12.0713 10.8786 14.5 8.0026 14.5C5.12661 14.5 2.83594 12.0713 2.83594 9.09091C2.83594 7.60221 3.38191 6.40198 3.91738 5.58255C4.18567 5.17199 4.45419 4.85242 4.65722 4.63401C4.75891 4.52462 4.84465 4.44009 4.90641 4.38167C4.93731 4.35244 4.96225 4.32971 4.98024 4.31362L5.00191 4.29449L5.00862 4.28869L5.0109 4.28673L5.01177 4.28599L5.01213 4.28568C5.01229 4.28555 5.01245 4.28541 5.33594 4.66667L5.01245 4.28541C5.16099 4.15937 5.36922 4.13109 5.546 4.21294C5.72279 4.29478 5.83594 4.47186 5.83594 4.66667C5.83594 5.69788 5.8406 6.44629 5.98337 6.94597C6.05073 7.18174 6.13522 7.30688 6.21853 7.37631C6.29511 7.44012 6.4222 7.5 6.66927 7.5C6.91624 7.5 7.10476 7.38108 7.27011 7.03464C7.44667 6.6647 7.54636 6.11764 7.58691 5.46881C7.62679 4.83081 7.60715 4.14498 7.57614 3.52497C7.56625 3.32704 7.55487 3.13173 7.54408 2.94629C7.52215 2.56986 7.5026 2.23415 7.5026 2C7.5026 1.82905 7.58994 1.66995 7.73417 1.57817C7.87839 1.48639 8.05951 1.47466 8.21437 1.54706ZM4.85378 5.98226C4.82081 6.02972 4.78765 6.07883 4.7545 6.12957C4.28997 6.84044 3.83594 7.85234 3.83594 9.09091C3.83594 11.5651 5.72394 13.5 8.0026 13.5C10.2813 13.5 12.1693 11.5651 12.1693 9.09091C12.1693 6.80996 11.0889 5.15743 9.98354 4.05925C9.46603 3.54511 8.94752 3.15753 8.5427 2.89109C8.55313 3.06978 8.56439 3.26496 8.5749 3.47503C8.6064 4.10502 8.62842 4.83586 8.58496 5.53119C8.54218 6.2157 8.43354 6.91863 8.1726 7.46537C7.90045 8.03558 7.4223 8.5 6.66927 8.5C6.24968 8.5 5.87677 8.39321 5.57835 8.14453C5.28666 7.90146 5.12115 7.56827 5.02184 7.2207C4.92113 6.86819 4.87494 6.4455 4.85378 5.98226Z"
                          fill="#F52419"/>
                </svg>
                Sale
            </div>
        {% endif %}
        {% if product.compare_at_price == blank %}
            <div class="card__badge {{ settings.badge_position }}">
                {%- if product.compare_at_price > product.price and product.available -%}
                    <span id="Badge-{{ section_id }}-{{ product.id }}"
                          class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">
                        {{- 'products.product.on_sale' | t -}}
                    </span>
                {%- endif -%}
            </div>
        {% endif %}
    </div>
    <div class="comparable-custom-action">
        <input
                class="add-to-comparable"
                type="checkbox"
                id="add-to-comparable-checkbox_{{ product.handle }}"
                data-product="{{ product.handle }}"
        >
        <label for="add-to-comparable-checkbox_{{ product.handle }}">Compare</label>
    </div>
    {%- if product.available == false -%}
        <span class="soldout">
          {% render 'icon-sold-out' %}
          {{- 'products.product.sold_out' | t -}}
      </span>
    {% endif %}
    <a class="title" href="{{ product.url | within: collection }}">
        {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
    </a>
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% comment %} <div class="main-review-container">
        <div class="star_container {{ current_variant.sku | downcase }}" hidden></div>
        <div class="review-container">
            <svg width="20" height="19" viewBox="0 0 20 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.27355 0.574932C9.55949 -0.0449654 10.4405 -0.0449657 10.7264 0.574932L12.9159 5.32176C13.0325 5.5744 13.2719 5.74836 13.5482 5.78112L18.7393 6.3966C19.4172 6.47698 19.6895 7.31489 19.1883 7.77838L15.3503 11.3276C15.1461 11.5165 15.0546 11.7979 15.1089 12.0708L16.1276 17.198C16.2607 17.8676 15.5479 18.3855 14.9522 18.052L10.3908 15.4987C10.148 15.3628 9.85203 15.3628 9.60925 15.4987L5.04779 18.052C4.4521 18.3855 3.73933 17.8676 3.87238 17.198L4.89115 12.0708C4.94537 11.7979 4.85392 11.5165 4.64965 11.3276L0.811744 7.77839C0.310544 7.31489 0.582797 6.47698 1.26071 6.3966L6.4518 5.78112C6.72809 5.74836 6.96752 5.5744 7.08406 5.32176L9.27355 0.574932Z"
                      fill="#FFC107"/>
            </svg>
            <div class="reviews-rating"><span class="star-count"></span><span class="reviews-count">()</span></div>
        </div>
    </div> {% endcomment %}
    <div class="product-item__price-container">
        {%- if product.available != false -%}
            {% if product.metafields.custom.retail_price != blank %}
                <div class="old-price-wrapper {% unless product.metafields.custom.retail_price != blank %}retail-price-blank{% endunless %}">
                    {% if product.metafields.custom.retail_price != blank %}
                        <span>As high as:</span> {{ product.metafields.custom.retail_price | money }}
                    {% endif %}
                </div>
            {% endif %}
            <div class="price-wrapper">
                <span class="price-title">Price USD:</span>
                <span class="price-value">{{ product.price | money }}</span>
            </div>
        {% endif %}
    </div>
</div>
