<style>

  .search-modal__content{
    display: block;
  }

.default-search-content {
  width: 100%;
}

    .predictive-search__result-group--adjacent {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    flex-direction: row;
  }

    .predictive-search__list-item:before
  
  {
    content: "";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: contain;
    left: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M3.5 11C3.5 6.85786 6.85786 3.5 11 3.5C15.1421 3.5 18.5 6.85786 18.5 11C18.5 15.1421 15.1421 18.5 11 18.5C6.85786 18.5 3.5 15.1421 3.5 11ZM11 2.5C6.30558 2.5 2.5 6.30558 2.5 11C2.5 15.6944 6.30558 19.5 11 19.5C13.1673 19.5 15.1451 18.6889 16.6465 17.3536L19.6464 20.3536C19.8417 20.5488 20.1583 20.5488 20.3536 20.3536C20.5488 20.1583 20.5488 19.8417 20.3536 19.6464L17.3536 16.6465C18.6889 15.1451 19.5 13.1673 19.5 11C19.5 6.30558 15.6944 2.5 11 2.5Z' fill='%23808080'/%3E%3C/svg%3E");
  }


  #predictive-search-results-products-list-default .predictive-search__list-item:before{
    content: none!important;
  }


  
  .prodsHeader{
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .prodsHeader .bannerBtn{
    color: #f1592a;
    font-size: 16px;
    font-weight: 700;
    text-decoration: underline;
  }

  .predictive-search__list-item {
    position: relative;
    padding-left: 0;
  }



  .predictive-search__search-for-button, .predictive-search__loading-state{
    background: white;   
    margin-top: 10px;
  }

   .predictive-search__search-for-button button, .predictive-search__search-for-button button:hover{
     color: black;
   }

  .predictive-search__column {
    flex: 1;
  }


  @media (max-width: 989px) {
  .predictive-search__results-groups-wrapper, .predictive-search__result-group--adjacent{
    gap: 10px!important;
  }
  }

  @media (max-width: 768px) {
    .predictive-search__result-group--adjacent {
      flex-direction: column;
    }
    .predictive-search__column {
      max-width: none;
    }
  }

  
  .gl-search-fullscreen {
    font-size: 16px !important;
    color: #212529 !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    z-index: 2147483647 !important;
    overflow: hidden !important;
    background: #f8f9fa !important;
  }

  .header__search, .header__search details {
    width: 100%;
  }

  .search__input::placeholder {
  opacity: 1;
  color: #757575; /* your desired placeholder color */
}

.search__input:focus::placeholder {
  opacity: 1; /* Ensure it's still visible on focus */
  color: #757575;
}


  .search-modal__form {
    max-width: 100% !important;
    width: 100% !important;
    padding: 24px 0px !important;
    display: flex !important;
  }

  .search.search-modal__form{
      padding: 0px !important;
  }

  .predictive-search {
    border: none;
    outline: none;
  }

  .search-modal__content {
    align-items: start !important;
    flex-wrap: wrap;
  }

  .field__input,
  .field__label {
    background-color: white !important;
    color: #757575 !important;
    height: 64px;
  }

  .predictive-search__heading {
    color: #212529 !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
    text-transform: capitalize !important;
    margin: 0!important;
  }


  .predictive-search__item-query-result mark{
    color: #777;
  }

  .modal__close-button .icon {
    color: black;
  }

  .header predictive-search {
    align-items: center !important;
  }

  .search__button.field__button{
    left: 0!important;
    top: 0!important;
    bottom: 0!important;
    height: auto!important;
    width: 64px;
  }

  .search-modal__content .svg-wrapper svg{
    width: 32px;
    height: 32px;
    fill: #495057;
  }

  .search-modal__content .search__input.field__input{
    padding-right: 9.8rem;
    padding-left: 64px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 64px;
    color: #000 !important;
  }
</style>

<details-modal class="header__search gl-fullscreen-search">
  <details>
    <summary class="customSearch">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search custom-header-search">
        <input
          class="custom-header-search--input"
          id="{{ input_id }}"
          type="search"
          name="q"
          value=""
          placeholder="{{ 'general.search.search' | t }}"
          {%- if settings.predictive_search_enabled -%}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          {%- endif -%}
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="reset"
          class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-reset.svg' | inline_asset_content -}}
          </span>
        </button>
        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
    </summary>

    <div
      class="search-modal modal__content gl-search-fullscreen"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div class="search-modal__content gl-fullscreen-content" tabindex="-1">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <div style="width: 100%;">
              <input
                class="search__input field__input"
                id="{{ input_id }}"
                type="search"
                name="q"
                placeholder="I'm looking for..."
                value=""
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
            </div>
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">
                {{- 'icon-search.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
             
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>

  
            
        {%- if settings.predictive_search_enabled -%}
          <button
            type="button"
            class="search-modal__close-button modal__close-button link link--text focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}



<!-- START: Default Search Content with Predictive Search Structure -->
        <div class="default-search-content" id="default-search-content">
          <div id="predictive-search-results-groups-wrapper-default" class="predictive-search__results-groups-wrapper">
            <div class="predictive-search__result-group">
              <div class="queries">
                <h2 id="predictive-search-queries-default" class="predictive-search__heading text-body caption-with-letter-spacing">Popular Searches</h2>
                {% assign popular_searches = settings.popular_searches | split: "," %}
                    <ul id="predictive-search-results-queries-list-default" class="predictive-search__results-list list-unstyled" role="group" aria-labelledby="predictive-search-queries-default">
                      {% for search in popular_searches %}
                        {% assign search_trimmed = search | strip %}
                        <li class="predictive-search__list-item" role="option" aria-selected="false">
                          <a href="/search?q={{ search_trimmed | url_encode }}" class="predictive-search__item link link--text" tabindex="-1">
                            <div class="predictive-search__item-content predictive-search__item-content--centered">
                              <p class="predictive-search__item-heading predictive-search__item-query-result h5" aria-label="{{ search_trimmed }}">
                                <span>{{ search_trimmed }}</span>
                              </p>
                            </div>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
              </div>

              <div class="predictive-search__pages-wrapper">
                <h2 id="predictive-search-pages-desktop-default" class="predictive-search__heading text-body caption-with-letter-spacing">Pages</h2>
                 {% assign popular_pages = settings.popular_pages | split: "," %}
                <ul id="predictive-search-results-pages-list-desktop-default" class="predictive-search__results-list list-unstyled" role="group" aria-labelledby="predictive-search-pages-desktop-default">
                  {% for page in popular_pages %}
                      {% assign page_trimmed = page | strip %}
                  <li id="predictive-search-option-page-default-1" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/pages/{{ page_trimmed }}" class="predictive-search__item link link--text" tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">{{ page_trimmed }}</p>
                      </div>
                    </a>
                  </li>
                 {% endfor %}
                </ul>
              </div>
              
            </div>

            <div class="predictive-search__result-group predictive-search__result-group--adjacent">
              <div class="predictive-search__column">
                <div class="prodsHeader">
                  <h2 id="predictive-search-products-default" class="predictive-search__heading text-body caption-with-letter-spacing">Featured Products</h2>
                  <a href="/collections/all" class="bannerBtn">View all products</a>
                </div>
                <ul id="predictive-search-results-products-list-default" class="predictive-search__results-list list-unstyled" role="group" aria-labelledby="predictive-search-products-default">
                  <li id="predictive-search-option-product-default-1" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/products/sample-product-a" class="predictive-search__item predictive-search__item--link-with-thumbnail link link--text" tabindex="-1">
                      <img class="predictive-search__image" src="https://placehold.co/50x50/cccccc/333333?text=Product+A" alt="Sample Product A" width="50" height="50">
                      <div class="predictive-search__item-content">
                        <p class="predictive-search__item-heading h5">Sample Product A</p>
                        <span class="visually-hidden">Vendor:</span>
                        <div class="predictive-search__item-vendor">
                          Brand X
                        </div>
                        <div class="price">
                          <div class="price__container">
                            <div class="price__regular">
                              <span class="visually-hidden visually-hidden--inline">Regular price</span>
                              <span class="price-item-fixed ">$29.99</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </a>
                  </li>
                  <li id="predictive-search-option-product-default-2" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/products/sample-product-b" class="predictive-search__item predictive-search__item--link-with-thumbnail link link--text" tabindex="-1">
                      <img class="predictive-search__image" src="https://placehold.co/50x50/cccccc/333333?text=Product+B" alt="Sample Product B" width="50" height="50">
                      <div class="predictive-search__item-content">
                        <p class="predictive-search__item-heading h5">Sample Product B</p>
                        <span class="visually-hidden">Vendor:</span>
                        <div class="predictive-search__item-vendor">
                          Brand Y
                        </div>
                        <div class="price">
                          <div class="price__container">
                            <div class="price__regular">
                              <span class="visually-hidden visually-hidden--inline">Regular price</span>
                              <span class="price-item-fixed ">$49.99</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <div class="predictive-search__column">
                <h2 id="predictive-search-collections-default" class="predictive-search__heading text-body caption-with-letter-spacing">
                  Featured Collections
                </h2>
                <ul id="predictive-search-results-collections-list-default" class="predictive-search__results-list list-unstyled" role="group" aria-labelledby="predictive-search-collections-default">
                  <li id="predictive-search-option-collection-default-1" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/collections/womens" class="predictive-search__item link link--text" tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">Women's Fashion</p>
                      </div>
                    </a>
                  </li>
                  <li id="predictive-search-option-collection-default-2" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/collections/mens" class="predictive-search__item link link--text" tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">Men's Apparel</p>
                      </div>
                    </a>
                  </li>
                  <li id="predictive-search-option-collection-default-3" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/collections/kids" class="predictive-search__item link link--text" tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">Kids' Collection</p>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- You can duplicate the pages section for mobile if needed, or remove if not applicable -->
              <div class="predictive-search__pages-wrapper">
                <h2 id="predictive-search-pages-mobile-default" class="predictive-search__heading text-body caption-with-letter-spacing">More Pages</h2>
                <ul id="predictive-search-results-pages-list-mobile-default" class="predictive-search__results-list list-unstyled" role="group" aria-labelledby="predictive-search-pages-mobile-default">
                  <li id="predictive-search-option-page-mobile-default-1" class="predictive-search__list-item" role="option" aria-selected="false">
                    <a href="/pages/blog" class="predictive-search__item link link--text" tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">Our Blog</p>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <!-- END: Default Search Content -->



            
      </div>
    </div>
  </details>
</details-modal>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const detailsEl = document.querySelector('.header__search details');

  if (!detailsEl) return;

  const input = detailsEl.querySelector('.search__input');
  const predictiveSearchResults = detailsEl.querySelector('[data-predictive-search]');
  const defaultSearchContent = detailsEl.querySelector('#default-search-content'); // Get the new div

  detailsEl.addEventListener('toggle', () => {
    if (detailsEl.open) {
      // Show default content when modal opens and input is empty
      if (input.value.trim() === '') {
        defaultSearchContent.style.display = 'block';
        predictiveSearchResults.style.display = 'none'; // Ensure predictive results are hidden
      }
      setTimeout(() => {
        input.focus();
      }, 10);
    } else {
      // Hide both when modal closes
      defaultSearchContent.style.display = 'none';
      predictiveSearchResults.style.display = 'none';
    }
  });

  input.addEventListener('input', () => {
    if (input.value.trim() === '') {
      // Show default content if input is cleared
      defaultSearchContent.style.display = 'block';
      predictiveSearchResults.style.display = 'none';
    } else {
      // Hide default content and show predictive search results
      defaultSearchContent.style.display = 'none';
      predictiveSearchResults.style.display = 'block';
    }
  });

  // Also handle the case where the input already has a value when the modal opens (e.g., from browser autofill)
  if (detailsEl.open && input.value.trim() !== '') {
    defaultSearchContent.style.display = 'none';
    predictiveSearchResults.style.display = 'block';
    input.dispatchEvent(new Event('input', { bubbles: true })); // Trigger search if already has value
  }
});
</script>