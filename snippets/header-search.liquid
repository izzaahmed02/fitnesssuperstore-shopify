<style>

.default-search-content {
  padding: 20px;
  background-color: #ffffff;
  border-radius: 5px;
  margin-top: 20px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  width: 100%;
}

.default-search-content h3 {
  margin-top: 0;
  font-size: 20px;
  color: #333;
}

.default-search-content ul {
  list-style: none;
  padding: 0;
}

.default-search-content li {
  margin-bottom: 10px;
}

.default-search-content a {
  text-decoration: none;
  color: #007bff;
  font-weight: bold;
}

.default-search-content a:hover {
  text-decoration: underline;
}

  
  .gl-search-fullscreen {
    font-size: 16px !important;
    color: #212529 !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    z-index: 2147483647 !important;
    overflow: hidden !important;
    background: #f8f9fa !important;
  }

  .header__search, .header__search details {
    width: 100%;
  }

  .search__input::placeholder {
  opacity: 1;
  color: #757575; /* your desired placeholder color */
}

.search__input:focus::placeholder {
  opacity: 1; /* Ensure it's still visible on focus */
  color: #757575;
}


  .search-modal__form {
    max-width: 100% !important;
    width: 100% !important;
    padding: 24px 0px !important;
    display: flex !important;
  }

  .search.search-modal__form{
      padding: 0px !important;
  }

  .predictive-search {
    border: none;
    outline: none;
  }

  .search-modal__content {
    align-items: start !important;
  }

  .field__input,
  .field__label {
    background-color: white !important;
    color: #757575 !important;
    height: 64px;
  }

  .predictive-search__heading {
    color: #212529 !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
    text-transform: capitalize !important;
    margin: 0!important;
  }


  .predictive-search__item-query-result mark{
    color: #777;
  }

  .modal__close-button .icon {
    color: black;
  }

  .header predictive-search {
    align-items: center !important;
  }

  .search__button.field__button{
    left: 0!important;
    top: 0!important;
    bottom: 0!important;
    height: auto!important;
    width: 64px;
  }

  .search-modal__content .svg-wrapper svg{
    width: 32px;
    height: 32px;
    fill: #495057;
  }

  .search-modal__content .search__input.field__input{
    padding-right: 9.8rem;
    padding-left: 64px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 64px;
    color: #000 !important;
  }
</style>

<details-modal class="header__search gl-fullscreen-search">
