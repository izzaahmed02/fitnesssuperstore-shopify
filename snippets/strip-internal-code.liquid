{%- comment -%}
  Strips a trailing internal-code suffix " (NNN)" from a product/variant title
  so that customer-facing surfaces don't expose merchant-only IDs.

  Accepts:
    title – the raw title string

  Outputs:
    The title with a trailing " (digits)" segment removed, if present.
    Titles without a trailing all-digits parenthetical are returned unchanged
    (e.g. "Mat (6) FF-RSGF (6 Squares)" stays as-is).
{%- endcomment -%}
{%- liquid
  assign clean_title = title | strip
  assign segments = clean_title | split: ' ('
  if segments.size > 1
    assign last_segment = segments | last
    if last_segment contains ')'
      assign code_candidate = last_segment | replace: ')', '' | strip
      if code_candidate != ''
        assign non_digits = code_candidate | replace: '0', '' | replace: '1', '' | replace: '2', '' | replace: '3', '' | replace: '4', '' | replace: '5', '' | replace: '6', '' | replace: '7', '' | replace: '8', '' | replace: '9', ''
        if non_digits == ''
          assign last_idx = segments.size | minus: 1
          assign rebuilt = ''
          for seg in segments
            if forloop.index0 == last_idx
              break
            endif
            if forloop.index0 == 0
              assign rebuilt = seg
            else
              assign rebuilt = rebuilt | append: ' (' | append: seg
            endif
          endfor
          assign clean_title = rebuilt
        endif
      endif
    endif
  endif
-%}
{{- clean_title -}}
