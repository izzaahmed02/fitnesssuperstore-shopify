<div class="">
  <input
    hidden
    class="field__input price-filter-input"
    name="{{ filter.min_value.param_name }}"
    id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
    {%- if filter.min_value.value -%}
      value="0"
    {%- endif -%}
    type="text"
    inputmode="decimal"
    placeholder="0"
    data-pattern="\d| |,|\."
    data-min="0"
    data-max="{{ filter.range_max | money_without_currency }}"
  >

</div>

{%- if filter_type != 'vertical' -%}
  <span class="field-currency">{{ cart.currency.symbol }}</span>
{%- endif -%}

<div class="">
  <select class="price-filter-input" name="{{ filter.max_value.param_name }}" id="{{ id_prefix }}{{ filter.label | escape }}-LTE">
    <option selected="selected" value="">Select Price</option>
    <option value="300">300</option>
    <option value="500">500</option>
    <option value="1000">1000</option>
  </select>

</div>
