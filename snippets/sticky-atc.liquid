{% comment %}
  Renders a sticky Add-to-Cart bar for the product page.

  Layout follows the approved design: a bar pinned to the top of the viewport
  on desktop and a collapsible panel fixed to the bottom on mobile. It appears
  once the main Add-to-Cart button scrolls out of view.

  The bar owns no selection or pricing state of its own. Its option dropdowns
  are built client-side from the options already rendered in
  #Product-Options-<section_id> and are kept in two-way sync with them, so the
  existing product-custom-options.js / product-form-with-options.js remain the
  single source of truth for pricing, validation and cart submission. Clicking
  the bar's button triggers the real submit button.

  Accepts:
  - product: {Object} product object.
  - section_id: {String} id of the main product section.

  Usage:
  {% render 'sticky-atc', product: product, section_id: section.id %}
{% endcomment %}

{%- if product != blank -%}
  {{ 'sticky-atc.css' | asset_url | stylesheet_tag }}

  <sticky-atc
    class="sticky-atc"
    data-section-id="{{ section_id }}"
    data-submit-button="ProductSubmitButton-{{ section_id }}"
    data-sticky-options="{{ product.metafields.custom.sticky_bar_options.value | json | escape }}"
    aria-hidden="true"
  >
    {%- comment -%} Mobile-only expand/collapse toggle. {%- endcomment -%}
    <button
      type="button"
      class="sticky-atc__toggle"
      data-sticky-atc-toggle
      aria-expanded="true"
      aria-label="{{ 'accessibility.toggle' | t | default: 'Toggle' }}"
    >
      {% render 'icon-caret' %}
    </button>

    <div class="sticky-atc__inner page-width">
      <div class="sticky-atc__product">
        {%- if product.featured_media != blank -%}
          <img
            class="sticky-atc__image"
            src="{{ product.featured_media | image_url: width: 120 }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="60"
            height="60"
            loading="lazy"
          >
        {%- endif -%}
        <div class="sticky-atc__details">
          <p class="sticky-atc__title">{{ product.title | escape }}</p>
          {%- assign sticky_variant = product.selected_or_first_available_variant -%}
          {%- assign sticky_compare = product.metafields.custom.retail_price -%}
          {%- if sticky_compare == blank or sticky_compare <= sticky_variant.price -%}
            {%- assign sticky_compare = sticky_variant.compare_at_price -%}
          {%- endif -%}
          <div class="sticky-atc__pricing">
            <span class="sticky-atc__price-current">{{ sticky_variant.price | money }}</span>
            {%- if sticky_compare != blank and sticky_compare > sticky_variant.price -%}
              <span class="sticky-atc__price-compare">{{ sticky_compare | money }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Option dropdowns are injected here from the live options. {%- endcomment -%}
      <div class="sticky-atc__options" data-sticky-atc-options></div>

      <button
        type="button"
        class="sticky-atc__button button button--primary"
        data-sticky-atc-button
      >
        {% render 'icon-cart' %}
        <span>{{ 'products.product.add_to_cart' | t }}</span>
      </button>
    </div>
  </sticky-atc>

  <script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
