<style>
  .pdp-breadcrumbs__item {
    display: flex;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .pdp-breadcrumbs__item a,
  .pdp-breadcrumbs__item span {
    color: #f1592a;
    margin-right: 5px;
  }
  .pdp-breadcrumbs__item .divider {
    color: #000;
  }
</style>
<style>
  .pdp-breadcrumbs__item {
    display: flex;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .pdp-breadcrumbs__item a,
  .pdp-breadcrumbs__item span {
    color: #f1592a;
    margin-right: 5px;
  }
  .pdp-breadcrumbs__item .divider {
    color: #000;
  }
</style>

<div class="customBreadcrumbs">
  <div class="pdp-breadcrumbs custom-breadcrumbs">
    <p><strong>Browse for more gym equipment in the same category as this item:</strong></p>

    {%- assign breadcrumb_paths = product.metafields.custom.breadcrumb_paths.value 
       | sort: "priority" -%}

    {% for item in breadcrumb_paths %}
      <div class="pdp-breadcrumbs__item">
        {%- assign titles = item.custom_titles.value | default: item.title | split: "," -%}
        {%- assign size = titles.size | minus: 1 -%}

        {% for title in titles %}
          {% assign index = forloop.index0 %}
          {% assign step = item.steps.value[index] %}

          {% if step and step.url %}
            <a href="{{ step.url }}">{{ title | strip }}</a>
          {% else %}
            <span>{{ title | strip }}</span>
          {% endif %}

          {% if index < size %}
            <span class="divider">></span>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>
