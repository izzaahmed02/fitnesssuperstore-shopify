<style>
  .pdp-breadcrumbs__item {
    display: flex;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .pdp-breadcrumbs__item a,
  .pdp-breadcrumbs__item span {
    color: #D83D0E;
    margin-right: 5px;
  }
  .pdp-breadcrumbs__item .divider {
    color: #000;
  }
  @media (max-width: 749px) {
    .pdp-breadcrumbs__item a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 4px 6px;
      margin-right: 8px;
    }
  }
</style>
<div class="customBreadcrumbs">
  <div class="pdp-breadcrumbs custom-breadcrumbs">
    <p><strong>Browse for more gym equipment in the same category as this item:</strong></p>
    {%- liquid
      assign brand_key = product.vendor | strip | downcase
      assign brand_words = brand_key | prepend: ' ' | append: ' '
      assign product_type_names = '|'
      assign product_type_word_sets = '|'
      assign shown_names = '|'
    -%}
    {%- for pass in (1..2) -%}
      {%- for item in product.metafields.custom.breadcrumb_paths.value -%}
        {%- liquid
          assign titles = item.custom_titles.value
          assign root_title = ''
          assign last_title = ''
          assign last_url = ''
          if titles and titles.size > 0
            assign root_title = titles.first
            assign last_title = titles.last
            assign last_index = titles.size | minus: 1
            for step in item.steps.value
              if forloop.index0 == last_index
                assign last_url = step.url
              endif
            endfor
          else
            for step in item.steps.value
              if forloop.first
                assign root_title = step.title
              endif
              if forloop.last
                assign last_title = step.title
                assign last_url = step.url
              endif
            endfor
          endif

          if last_title == blank
            continue
          endif

          assign root_key = root_title | strip | downcase
          assign name_key = last_title | strip | downcase
          assign name_token = name_key | prepend: '|' | append: '|'
          assign is_brand_path = false
          if brand_key != blank and root_key == brand_key
            assign is_brand_path = true
          endif

          # Word set for near-match checks: lowercase, punctuation/"and"/brand words removed, order ignored.
          assign raw_words = name_key | replace: '/', ' ' | replace: '&', ' ' | replace: ',', ' ' | replace: '(', ' ' | replace: ')', ' ' | replace: '-', ' ' | split: ' '
          assign word_set = ' '
          assign word_count = 0
          for word in raw_words
            assign padded_word = word | prepend: ' ' | append: ' '
            unless word == 'and' or brand_words contains padded_word or word_set contains padded_word
              assign word_set = word_set | append: word | append: ' '
              assign word_count = word_count | plus: 1
            endunless
          endfor

          if pass == 1
            unless is_brand_path or product_type_names contains name_token
              assign product_type_names = product_type_names | append: name_key | append: '|'
              assign product_type_word_sets = product_type_word_sets | append: word_set | append: '|'
            endunless
            continue
          endif

          if shown_names contains name_token
            continue
          endif
          if is_brand_path and product_type_names contains name_token
            continue
          endif

          # Brand-path near-match: a single word must match exactly; otherwise all of its words
          # must appear in a Product Type name that has at most one extra word.
          if is_brand_path and word_count > 0
            assign near_match = false
            assign own_words = word_set | strip | split: ' '
            assign type_word_sets = product_type_word_sets | split: '|'
            for type_set in type_word_sets
              if word_count == 1
                if type_set == word_set
                  assign near_match = true
                  break
                endif
              else
                assign type_count = type_set | strip | split: ' ' | size
                assign extra_words = type_count | minus: word_count
                if extra_words >= 0 and extra_words <= 1
                  assign all_found = true
                  for own_word in own_words
                    assign padded_own = own_word | prepend: ' ' | append: ' '
                    unless type_set contains padded_own
                      assign all_found = false
                      break
                    endunless
                  endfor
                  if all_found
                    assign near_match = true
                    break
                  endif
                endif
              endif
            endfor
            if near_match
              continue
            endif
          endif
          assign shown_names = shown_names | append: name_key | append: '|'
        -%}
        <div class="pdp-breadcrumbs__item">
          {%- if last_url != blank -%}
            <a href="{{ last_url }}">{{ last_title }}</a>
          {%- else -%}
            <span>{{ last_title }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>