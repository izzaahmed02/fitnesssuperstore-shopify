{% comment %}
  Renders the header drawer: a mobile push menu where each level slides in as its own panel.
  Hidden at 990px+ while the desktop header uses the mega menu.

  Content comes from the "Mobile push menu" picked on the header's Additional menu block
  (three levels: category > subcategory > brand/type). Items linked to "#" with no children
  render as group labels (e.g. "Shop", "Company & Support"); rows before the first label use
  the large category style. See menu-push-panel for how Level 3 is filled.

  Until a mobile push menu is picked, it falls back to the header menu (with "Shop By Product
  Type" flattened) followed by the additional mobile menu, without group labels.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}
{%- liquid
  assign push_menu = blank
  assign extra_menu = blank
  for block in section.blocks
    if block.type == 'menu'
      assign push_menu = block.settings.mobile_push_menu
      assign extra_menu = block.settings.additional_mobile_menu
    endif
  endfor

  if push_menu != blank
    assign root_links = push_menu.links
  else
    assign root_links = section.settings.menu.links | where: 'handle', ''
    for link in section.settings.menu.links
      if link.title == 'Shop By Product Type'
        assign root_links = root_links | concat: link.links
      else
        assign single_link = section.settings.menu.links | where: 'handle', link.handle
        assign root_links = root_links | concat: single_link
      endif
    endfor
    if extra_menu != blank
      assign root_links = root_links | concat: extra_menu.links
    endif
  endif
-%}
{{ 'component-menu-push.css' | asset_url | stylesheet_tag }}
<script src="{{ 'menu-push.js' | asset_url }}" defer="defer"></script>
<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span> {% render 'icon-hamburger' %} {% render 'icon-close' %} </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer menu-drawer--push page-width motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <menu-push class="menu-push">
        <nav class="menu-push__stage" aria-label="{{ 'sections.header.menu' | t }}">
          <div class="menu-push__panel is-active" id="MenuPush-root">
            <ul class="menu-push__list" role="list">
              {%- assign row_class = 'menu-push__row menu-push__row--top' -%}
              {%- for link in root_links -%}
                {%- if link.links == blank and link.url == '#' -%}
                  {%- assign row_class = 'menu-push__row menu-push__row--bold' -%}
                  <li class="menu-push__label">{{ link.title | escape }}</li>
                  {%- continue -%}
                {%- endif -%}
                <li>
                  {%- if link.links != blank -%}
                    <button
                      type="button"
                      class="{{ row_class }}"
                      data-menu-push="MenuPush-{{ forloop.index }}"
                      aria-controls="MenuPush-{{ forloop.index }}"
                      aria-expanded="false"
                    >
                      <span>{{ link.title | escape }}</span>
                    </button>
                  {%- else -%}
                    <a href="{{ link.url }}" class="{{ row_class }}"{% if link.current %} aria-current="page"{% endif %}>
                      {{- link.title | escape -}}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>

          {%- for link in root_links -%}
            {%- if link.links != blank -%}
              {%- assign panel_id = 'MenuPush-' | append: forloop.index -%}
              {%- render 'menu-push-panel', link: link, panel_id: panel_id -%}
            {%- endif -%}
          {%- endfor -%}
        </nav>

        <div class="menu-push__contact">
          <p class="menu-push__contact-label">Need help?</p>
          <div class="menu-push__contact-row">
            <a href="tel:+19252152927">Call (925) 215-2927</a>
            <a href="mailto:sales@fitnesssuperstore.com">Email Us</a>
          </div>
        </div>
      </menu-push>
    </div>
  </details>
</header-drawer>
