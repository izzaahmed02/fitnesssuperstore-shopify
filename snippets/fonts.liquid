{{ 'SF-Pro-Text-Semibold.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'SF-Pro-Text-Semibold.woff' | asset_url | preload_tag: as: 'font', type: 'font/woff', crossorigin: 'anonymous' }}


{% style %}
    @font-face {
    font-family: 'SF-Pro-Text';
    font-display: swap;
    font-weight: 600;
    font-style: normal;
    src: url("{{ 'SF-Pro-Text-Semibold.woff2' | asset_url }}") format('woff2'),
    url("{{ 'SF-Pro-Text-Semibold.woff' | asset_url }}") format('woff');
    }
{% endstyle %}
