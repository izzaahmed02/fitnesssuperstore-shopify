{%- comment -%}
  Near-title option selector for single-option combined listings
  (e.g. "Turf Grade: V1 Base / V2 Plus / V3 Premium").

  Renders the family's option values as links directly under the product title,
  in the same slot and with the same markup/classes as finish-selector.liquid, so
  a combined-listing PDP reads exactly like the Black / Silver finish PDPs. Each
  value links to the child product it belongs to (value.product_url), which is
  where the standard variant picker sends the customer anyway.

  Only single-option combined listings qualify. Multi-option families (the hex
  dumbbell parents) keep the standard variant picker, because one link per value
  cannot express a combination of several options.

  The active value is the one whose child URL is the page being viewed. On the
  parent PDP none of the child URLs match, so the value Shopify marks as selected
  is used instead.

  The section renders this in both the mobile and desktop title slots, and skips
  the standard variant picker when combined_listing_selector_applies is true (see
  main-product.liquid / main-product-comb.liquid).

  Accepts:
    product - {Object} the product to render the selector for (required)
{%- endcomment -%}

{%- liquid
  assign cl_option = null
  if product.combined_listing != blank and product.options_with_values.size == 1
    assign cl_option = product.options_with_values.first
  endif
-%}

{%- if cl_option != blank and cl_option.values.size > 1 -%}
  {%- liquid
    assign current_url = product.url | split: '?' | first
    assign on_child_url = false
    for value in cl_option.values
      assign value_base_url = value.product_url | split: '?' | first
      if value_base_url == current_url
        assign on_child_url = true
      endif
    endfor
  -%}

  {%- style -%}
    .finish-selector{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:0 0 20px;}
    .finish-selector__label{font-family:"Lato",sans-serif;font-size:14px;font-weight:700;color:#23232B;margin-right:2px;}
    .finish-selector__option{display:inline-flex;align-items:center;justify-content:center;min-width:72px;padding:8px 16px;border:1px solid #D4D4D8;border-radius:4px;background:#fff;font-family:"Lato",sans-serif;font-size:14px;font-weight:600;line-height:1;color:#23232B;text-decoration:none;cursor:pointer;transition:border-color .2s ease,color .2s ease,background .2s ease;}
    .finish-selector__option:hover{border-color:#D12E06;color:#D12E06;}
    .finish-selector__option.is-active{border-color:#D12E06;background:#D12E06;color:#fff;cursor:default;pointer-events:none;}
  {%- endstyle -%}
  <div class="finish-selector" role="group" aria-label="Choose {{ cl_option.name | escape }}">
    <span class="finish-selector__label">{{ cl_option.name | escape }}:</span>
    {%- for value in cl_option.values -%}
      {%- liquid
        assign value_url = value.product_url | default: value.variant.url
        assign value_base_url = value_url | split: '?' | first
        if on_child_url
          assign is_active = false
          if value_base_url == current_url
            assign is_active = true
          endif
        else
          assign is_active = value.selected
        endif
      -%}
      {%- if is_active -%}
        <span class="finish-selector__option is-active" aria-current="true">{{ value.name | escape }}</span>
      {%- elsif value_url != blank -%}
        <a class="finish-selector__option" href="{{ value_url }}">{{ value.name | escape }}</a>
      {%- else -%}
        <span class="finish-selector__option">{{ value.name | escape }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
