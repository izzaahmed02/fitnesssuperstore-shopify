      Pantone: '152C',
      HEX: '#E57200',
    },
    {
      name: 'RESEDA GREEN',
      Pantone: '5763C',
      HEX: '#737B4C',
    },
    {
      name: 'COFFEE BROWN',
      Pantone: '139C',
      HEX: '#AF6D04',
    },
    {
      name: 'SUN GOLD',
      Pantone: '871C',
      HEX: '#84754E',
    },
    {
      name: 'OLYMPIA WHITE',
      Pantone: 'No Pantone match',
      HEX: '#F1EEE6',
    },
    {
      name: 'STORM GREY',
      Pantone: 'Cool Gray 5C',
      HEX: '#B1B3B3',
    },
    {
      name: 'PLATINUM SPARKLE',
      Pantone: '166C',
      HEX: '#8A8D8F',
    },
    {
      name: 'JET BLACK',
      Pantone: 'Process Black C',
      HEX: '#2D2926',
    },
    {
      name: 'TEXTURED BLACK',
      Pantone: 'Process Black C',
      HEX: '#1D1D1D',
    },
    {
      name: 'SILVER VEIN',
      Pantone: 'No Pantone match',
      HEX: '#71706E',
    },
    {
      name: 'SLATE GREY',
      Pantone: 'Cool Grey 11C',
      HEX: '#53565A',
    },
    {
      name: 'EBONY CHROME',
      Pantone: 'Cool Grey 10C C22',
      HEX: '#63666A',
    },
    {
      name: 'STONE GREY',
      Pantone: '152C',
      HEX: '#A69F88',
    },
    {
      name: 'POST OFFICE BLUE',
      Pantone: '540C',
      HEX: '#003057',
    },
    {
      name: 'PATRIOT BLUE',
      Pantone: '301C',
      HEX: '#004B87',
    },
    {
      name: 'LIGHT BLUE',
      Pantone: '7461C',
      HEX: '#007DBA',
    },
    {
      name: 'PURPLE WAVE',
      Pantone: '268C',
      HEX: '#582C83',
    },
    {
      name: 'LILAC',
      Pantone: '667C',
      HEX: '#7C6992',
    },
    {
      name: 'PINK',
      Pantone: '166C',
      HEX: '#E35205',
    },
  ];

  document.addEventListener('DOMContentLoaded', function () {
    const trigger = document.getElementById('custom-color-trigger');
    const inputContainer = document.querySelector('.custom-color-input');
    const colorInput = document.getElementById('custom-color-value');
    const hiddenInput = document.getElementById('custom-color-hidden');
    const hiddenProduct = document.getElementById('custom-color-product');
    const hiddenProductQuantity = document.getElementById('custom-color-quantity');
    const hiddenProductProperty = document.getElementById('custom-color-properties');
    const swatchContainer = document.querySelector('.color-options');
    const addButton = document.getElementById('add-custom-color');
    const selectedColorInfo = document.querySelector('.color_option_selected-container');
    const selectedColorElement = document.querySelector('.color_option_selected');
    const selectedColorPriceElement = document.querySelector('.color_option_selected-price');
    const closeSelectedInfoBtn = selectedColorInfo.querySelector('svg');
    const closeIcon = document.querySelector('.custom-color-input-header svg');
    const errorMessage = document.querySelector('.custom-color-error_message');
    const productSwatches = document.querySelectorAll('.color-options-container input[type=radio]');

    // Show the input field when "+" is clicked
    trigger.addEventListener('click', () => {
      inputContainer.style.display = 'block';
      errorMessage.style.display = 'none';
      addButton.classList.remove('disabled');
    });

    // Close the input popup when clicking on the close icon
    closeIcon.addEventListener('click', () => {
      inputContainer.style.display = 'none';
      colorInput.value = '';
      errorMessage.style.display = 'none';
      addButton.classList.remove('disabled');
    });

    // Add custom color swatch
    addButton.addEventListener('click', () => {
      const color = colorInput.value.trim();

      // Validate the hex color
      if (/^#(?:[0-9a-fA-F]{3}){1,2}$/.test(color)) {
        const matchedColor = availableColors.find((c) => c.HEX.toLowerCase() === color.toLowerCase());
        if (matchedColor) {
          // Display Pantone value
          selectedColorElement.textContent = `Custom color: ${matchedColor.name} (Pantone: ${matchedColor.Pantone} / ${matchedColor.HEX})`;
          selectedColorPriceElement.textContent = '$600';

          const updatedProductSwatches = document.querySelectorAll('.color-options-container input[type=radio]');
          updatedProductSwatches.forEach((input) => (input.checked = false));

          errorMessage.style.display = 'none';
          addButton.classList.remove('disabled');
          selectedColorInfo.style.display = 'flex';
        } else {
          errorMessage.style.display = 'flex';
          addButton.classList.add('disabled');
          return;
        }

        hiddenInput.value = color;
        hiddenProductProperty.value = color;
        hiddenProduct.disabled = false;
        hiddenProductQuantity.disabled = false;
        hiddenProductProperty.disabled = false;

        // Create the custom swatch
        const customSwatch = document.createElement('div');

        const customSwatchesOnPage = document.querySelectorAll('.swatch--custom');
        customSwatchesOnPage.forEach((swatch) => swatch.classList.remove('selected'));

        const updatedProductSwatches = document.querySelectorAll('.color-options-container input[type=radio]');
        updatedProductSwatches.forEach((input) => (input.checked = false));

        customSwatch.classList.add('swatch', 'swatch--custom', 'selected');
        customSwatch.style.backgroundColor = color;
        customSwatch.title = matchedColor
          ? `Custom color: ${matchedColor.name} (Pantone: ${matchedColor.Pantone} / ${matchedColor.HEX})`
          : `Custom Color: ${color}`;

        // Add radio input for variant logic
        customSwatch.innerHTML = `
          <input
            type="radio"
            id="custom-color-swatch-${color}"
            name="custom-color"
            value="${color}"
          >
          <label for="custom-color-swatch-${color}">
            <span class="swatch-label" style="background: ${color};"></span>
          </label>
        `;

        // Ensure swatch is selectable
        customSwatch.addEventListener('click', () => {
          document.querySelectorAll('.swatch--custom').forEach((swatch) => swatch.classList.remove('selected'));
          customSwatch.classList.add('selected');

          const updatedProductSwatches = document.querySelectorAll('.color-options-container input');
          updatedProductSwatches.forEach((input) => (input.checked = false));

          if (matchedColor) {
            selectedColorElement.textContent = `Custom color: ${matchedColor.name} (Pantone: ${matchedColor.Pantone} / ${matchedColor.HEX})`;
            selectedColorPriceElement.textContent = '$600';
            selectedColorInfo.style.display = 'flex';

            hiddenInput.value = color;
            hiddenProductProperty.value = color;
            hiddenProduct.disabled = false;
            hiddenProductQuantity.disabled = false;
            hiddenProductProperty.disabled = false;
          }
        });

        swatchContainer.appendChild(customSwatch);

        // Reset input and hide container
        colorInput.value = '';
        inputContainer.style.display = 'none';
        errorMessage.style.display = 'none';
        addButton.classList.remove('disabled');

        console.log(`Custom color ${color} added.`);
      } else {
        errorMessage.style.display = 'flex';
        addButton.classList.add('disabled');
      }
    });

    closeSelectedInfoBtn.addEventListener('click', () => {
      selectedColorInfo.style.display = 'none';
    });

    // Handle Shopify swatches
    document.querySelectorAll('.color-options-container .swatch-input__label').forEach((input) => {
      console.log('Swatch:', input);
      input.addEventListener('click', () => {
        console.log('swatch click!');
        hiddenInput.value = '';
        hiddenProductProperty.value = '';
        hiddenProduct.disabled = true;
        hiddenProductQuantity.disabled = true;
        hiddenProductProperty.disabled = true;
        const customSwatchesOnPage = document.querySelectorAll('.swatch--custom.selected');
        customSwatchesOnPage.forEach((swatch) => swatch.classList.remove('selected'));
        console.log(`Shopify color selected: black`);
      });
    });

    // Handle quantity change
      const mainQuantityInput = document.querySelector('.quantity__input');
      const customQuantityInput = document.getElementById('custom-color-quantity');
  
      mainQuantityInput.addEventListener('input', function () {
        const mainQuantity = parseInt(mainQuantityInput.value, 10) || 1;
        customQuantityInput.value = mainQuantity;
      });
  });
</script>
