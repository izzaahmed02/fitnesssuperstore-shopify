{%- comment -%}
  Renders the Judge.me preview stars badge for a product.
  Kept as a dedicated snippet so it can be reused on every PDP template
  (standard, variants, combined-listing, avisplus-options, gift-cards)
  and flexed with the availability badge.

  Accepts:
    - product: {Object} product object (required)
{%- endcomment -%}
<div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
  {{ product.metafields.judgeme.badge }}
</div>
