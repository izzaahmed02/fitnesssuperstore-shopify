<div class="customer-location-container">
    <span class="transit-time-calculator-header">Transit Time Calculator</span>
    <div class="location-header" onclick="toggleTransitTimeForm()">
      <span>Customer Location:</span>
      <span class="location-display"></span>
    </div>
    <div class="transit-time-form">
        <span class="postal-code">ZIP code</span>
        <div class="location-form" id="location-form">              
          <div>
            <input type="text" id="postalCode" value="1100" />  
          </div>
          <button id="estimate-delivery-times-btn" class="button--full-width button--primary">Estimate Shipping Time</button>
        </div>
    </div>
    <div class="transit-times-container"></div>  
  </div>
<script defer src="https://s3.us-west-1.amazonaws.com/fitnesssuperstore.info/js/moment.js"></script>
<script defer src="https://s3.us-west-1.amazonaws.com/fitnesssuperstore.info/js/moment-business-days.js"></script>
<script src="{{ 'transit-time-calculator.js' | asset_url }}" defer="defer"></script>