{% comment %}
  1. Try to use metaobject-based breadcrumbs (sorted by priority).
  2. If not available, fallback to manual text-based metafield (multi-line text).
  3. If still empty, fallback to Shopify collection-based path.
{% endcomment %}

{% assign product_breadcrumbs = product.metafields.custom.breadcrumbs.value %}
{% assign first_breadcrumb = product_breadcrumbs | split: 'Home' %}
{% assign jp = first_breadcrumb[1] | split: '>' %}
{% assign length = jp.size | minus: 1 %}

{% assign breadcrumb_metaobjects = product.metafields.custom.breadcrumb_paths.value | sort: "priority" %}
{% assign selected_breadcrumb = nil %}
{% assign breadcrumb_source = "none" %}

{% if collection %}
  {% for path in breadcrumb_metaobjects %}
    {% assign steps = path.steps.value %}
    {% assign last_step = nil %}

    {% for step in steps %}
      {% assign last_step = step %}
    {% endfor %}

    {% if last_step and last_step.handle == collection.handle %}
      {% assign selected_breadcrumb = path %}
      {% assign breadcrumb_source = "metaobject" %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if selected_breadcrumb == nil %}
  {% for breadcrumb in breadcrumb_metaobjects %}
    {% if breadcrumb.steps and breadcrumb.steps.value != blank %}
      {% assign selected_breadcrumb = breadcrumb %}
      {% assign breadcrumb_source = "metaobject" %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if selected_breadcrumb == nil and product_breadcrumbs != blank %}
  {% assign breadcrumb_source = "text_metafield" %}
{% endif %}

{% if breadcrumb_source == "none" and product.collections.first %}
  {% assign fallback_collection = product.collections.first %}
  {% assign breadcrumb_source = "shopify_default" %}
{% endif %}

<div class="custom-breadcrumbs">
  <div class="page-width">
    <div class="custom-breadcrumbs__wrapper">
      <div class="custom-breadcrumbs__navigation">
        {% if breadcrumb_source == "metaobject" %}
          <a href="/">Home</a>
          {% assign steps = selected_breadcrumb.steps.value %}
          {% assign custom_titles = selected_breadcrumb.custom_titles.value %}

          {% for collection in steps %}
            {% render 'icon-arrow-right-breadcrumbs' %}
            {% assign index = forloop.index0 %}
            <a href="{{ collection.url }}">
              {{ custom_titles[index] | default: collection.title }}
            </a>
          {% endfor %}
          {% render 'icon-arrow-right-breadcrumbs' %}
          <span aria-current="page">{{ product.title }}</span>
        {% elsif breadcrumb_source == "text_metafield" %}
          {% for i in (0..length) %}
            {% assign col = jp[i] | handleize %}

            {% if forloop.first %}
              <a href="/">Home</a>
            {% else %}
              {% render 'icon-arrow-right-breadcrumbs' %}
              <a href="{{ collections[col].url }}">{{- jp[i] }}</a>
            {% endif %}
          {% endfor %}
        {% elsif breadcrumb_source == "shopify_default" %}
          <a href="/">Home</a>
          {% render 'icon-arrow-right-breadcrumbs' %}
          <a href="{{ fallback_collection.url }}">{{ fallback_collection.title }}</a>
          {% render 'icon-arrow-right-breadcrumbs' %}
          <span aria-current="page">{{ product.title }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>
