{%- assign cta_title = block.settings.cta_title -%}
{%- assign cta_text = block.settings.cta_text -%}
{%- assign cta_button_link = block.settings.cta_button_link -%}
{%- assign cta_button_label = block.settings.cta_button_label -%}
{%- assign cta_image = block.settings.cta_image -%}

<div class="collection-grid-helper" style="text-align: {{ block.settings.cta_alignment }}">
  <div class="collection-grid-helper__content">
    {% if cta_title != blank %}
      <h3 class="collection-grid-helper__title">{{ cta_title }}</h3>
    {% endif %}
    {% if cta_text != blank %}
      <p class="collection-grid-helper__text">{{ cta_text }}</p>
    {% endif %}
    {% if cta_button_link %}
      <a href="{{ cta_button_link }}" class="collection-grid-helper__button button">
        <span>{{ cta_button_label }}</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="white"/>
        </svg>
      </a>
    {% endif %}
  </div>
  {% if cta_image %}
    <figure class="collection-grid-helper__image-wrapper">
      {%- capture sizes -%}
                (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                (min-width: 750px) calc(100vw / 2), calc(100vw / 2)
            {%- endcapture -%}

      {{
        cta_image
        | image_url: width: 1500
        | image_tag:
          loading: 'lazy',
          class: 'collection-grid-helper__image',
          sizes: sizes,
          widths: '375, 550, 750, 1100, 1500',
          alt: section_title
        | escape
      }}
    </figure>
  {% endif %}
</div>
