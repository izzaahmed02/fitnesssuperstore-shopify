{% unless settings.type_body_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}

{% unless settings.type_header_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}


<!-- Core layout CSS: render-blocking so the page paints in its final layout.
     Loading these async caused an unstyled paint then a full-page reflow (CLS).
     Files are small and served from the preconnected Shopify CDN. -->
<link rel="stylesheet" href="{{ 'main.min.css' | asset_url }}">

<!-- Base styles that must render before LCP -->
<link rel="stylesheet" href="{{ 'base-v2.min.css' | asset_url }}">

<!-- custom.css defines the layout of the site header and the breadcrumbs, both of
     which sit above the fold on every template. Loading it async painted those
     elements unstyled first and then reflowed the whole page once it arrived,
     which was the main source of the Core Web Vitals CLS failures. Render-blocking
     so the first paint is already the final layout. -->
<link rel="stylesheet" href="{{ 'custom.css' | asset_url }}">



{% if settings.predictive_search_enabled %}
  <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
{% endif %}

<!-- Slider CSS sizes carousel track/slides. Loading it async let the slides stack
     full width before collapsing into the carousel, shifting everything below. -->
<link rel="stylesheet" href="{{ 'slick.min.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'slick-theme.min.css' | asset_url }}">
