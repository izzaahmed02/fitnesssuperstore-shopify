{% unless settings.type_body_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}

{% unless settings.type_header_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}

{{ 'main.min.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'base-v2.min.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'custom-shell.css' | asset_url | stylesheet_tag: preload: true }}

{% if request.page_type == 'product' %}
  <link rel="stylesheet" href="{{ 'product-options.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'reviews-overrides.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'product-options.css' | asset_url }}"></noscript>
  <noscript><link rel="stylesheet" href="{{ 'reviews-overrides.css' | asset_url }}"></noscript>
{% endif %}

{% if settings.predictive_search_enabled %}
  <link rel="stylesheet" href="{{ 'search-overrides.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'search-overrides.css' | asset_url }}"></noscript>
{% endif %}

{% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'page' %}
  <link rel="stylesheet" href="{{ 'page-modules.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'page-modules.css' | asset_url }}"></noscript>
{% endif %}

{% assign should_load_slick = false %}
{% if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'blog' or request.page_type == 'article' or template contains 'page.homepage' or template contains 'page.reviews' or template contains 'page.warehouse' %}
  {% assign should_load_slick = true %}
{% endif %}

{% if should_load_slick %}
  <link rel="stylesheet" href="{{ 'slick.min.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'slick-theme.min.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="{{ 'slick.min.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'slick-theme.min.css' | asset_url }}">
  </noscript>
{% endif %}
