<link rel="preload" href="{{ 'main.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'main.min.css' | asset_url }}"></noscript>

<!-- Base styles that must render before LCP -->
<link rel="preload" href="{{ 'base-v2.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'base-v2.min.css' | asset_url }}"></noscript>

<!-- Non-critical CSS (load after LCP) -->

<link rel="preload" href="{{ 'custom.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'custom.css' | asset_url }}"></noscript>



{% unless settings.type_body_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}

{% unless settings.type_header_font.system? %}
  <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
{% endunless %}

{% if settings.predictive_search_enabled %}
  <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
{% endif %}

<link rel="preload" as="style" href="{{ 'slick.min.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet';">
<link rel="preload" as="style" href="{{ 'slick-theme.min.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet';">

<noscript>
  <link rel="stylesheet" href="{{ 'slick.min.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'slick-theme.min.css' | asset_url }}">
</noscript>
