<style>
  .price-banner {
    position: relative;
    width: 100%;
    min-height: 64px;
    border-radius: 16px;
    background-color: #fce6de;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    inline-size: 100%;
    margin: 8px 0px 40px;
    overflow: hidden;
  }

  .price-banner__prices {
    padding: 12px;
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    width: 55%;
    height: auto;
    gap: 4px;
    white-space: nowrap;
    font-size: clamp(2.6rem, 100cqi / 50, 3rem);
  }

  @media (min-width: 550px) {
    .price-banner__prices {
      flex-direction: row;
      align-items: center;
      width: 60%;
      gap: 8px;
    }
  }

  @media (min-width: 990px) {
    .price-banner__prices {
      font-size: clamp(1.4rem, 100cqi / 50, 3rem);
    }
  }

  .price-banner__price {
    font-weight: 700;
    color: #f1592a;
  }

  .price-banner__compare {
    color: #bfa3a3;
    text-decoration: line-through;
  }

  .price-banner__label {
    position: relative;
    width: 45%;
    max-width: 230px;
    height: auto;
    padding-right: 1.2rem;
    padding-left: 4rem;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    white-space: nowrap;
    font-weight: 700;
    font-family: 'Oswald';
    color: #f2f2f2;
    font-size: clamp(1.6rem, 100cqi / 76, 2.2rem);
    text-transform: uppercase;
  }

  @media (min-width: 550px) {
    .price-banner__label {
      padding-right: 1.6rem;
      font-size: clamp(2rem, 100cqi / 76, 2.2rem);
    }
  }

  @media (min-width: 750px) {
    .price-banner__label {
      width: 40%;
      letter-spacing: 1px;
      font-size: clamp(2.2rem, 100cqi / 76, 2.2rem);
    }
  }

  @media (min-width: 990px) {
    .price-banner__label {
      font-size: clamp(1.6rem, 100cqi / 76, 2.2rem);
    }
  }

  @media (min-width: 1200px) {
    .price-banner__label {
      padding-left: 6rem;
      font-size: clamp(2rem, 100cqi / 76, 2.2rem);
    }
  }

  .price-banner__label span {
    position: relative;
    z-index: 1;
  }

  .price-banner__label:before,
  .price-banner__label:after {
    content: '';
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .price-banner__label:before {
    right: 10px;
    background-color: #fac3b2;
    clip-path: polygon(45% -45%, 100% 0, 100% 100%, 0% 100%);
  }
  .price-banner__label:after {
    right: 0;
    background-color: #f1592a;
    clip-path: polygon(45% -45%, 100% 0, 100% 100%, 0% 100%);
  }
</style>

{% assign sale_price_raw = sale_price | replace: ',', '' %}
{% assign sale_price = sale_price_raw | times: 100.0 %}

{%- assign price = sale_price | money -%}


{% if current_price > sale_price %}
  <div class="price-banner">
    <div class="price-banner__prices">
      <span class="price-banner__price">

{%- if price contains '$' -%}
  {{ price | remove: '$' }}        
{%- else -%}
  {{ price | prepend: '$' }}        
{%- endif -%}
      </span>
      <span class="price-banner__compare">
        {{ current_price | money }}
      </span>
    </div>
    <div class="price-banner__label">
      <span>
        {{ sale_name }}
      </span>
    </div>
  </div>
{% endif %}
