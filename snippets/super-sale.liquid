<style>
    .price-banner {
        position: relative;
        width: 557px;
        height: 64px;
        border-radius: 16px;
        background-color: #FFE4DC;
        display: flex;
        align-items: center;
        padding: 0 20px;
        box-sizing: border-box;
        overflow: hidden;
        margin: 12px 0px;
    }
    
    .price-info {
      display: flex;
      gap: 8px;
      align-items: baseline;
      z-index: 2; 
    }
    
    .current-price {
      font-family: 'Lato';
      font-size: 32px;
      font-weight: bold;
      color: #F15F34;  
      margin: 0;
    }
    
    .sale-price {
      font-family: 'Lato';
      font-size: 32px;
      color: #B3B3B3;
      text-decoration: line-through;
      margin: 0;
    }
    
    .sale-section {
        position: absolute;
        top: 0;
        right: 0;
        width: 565px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        color: #fff;
        font-weight: bold;
        text-transform: uppercase;
        z-index: 3;
        background-color: #FAC3B2;
        font-size: 30px;
        clip-path: polygon(72% 0, 100% 0, 100% 100%, 60% 100%);
        box-sizing: border-box;
        padding: 0 10px;
        font-family: 'Oswald';
    }

    .sale-section::before {
        content: "";
        position: absolute;
        top: 0;
        right: -5px;
        width: 686px;
        height: 100%;
        background-color: #F1592A;
        clip-path: polygon(78% 0, 100% 0, 100% 100%, 68% 100%);
        z-index: -1;
    }
  </style>
  <style>
    @media (max-width: 750px) {
      .price-banner {
        width: auto;
      }
      .current-price {
        font-size: 18px;
      }
      .sale-price {
        font-size: 18px;
      }
      .sale-section {
        width: 388px;
        font-size: 19px;
      }
      .sale-section::before {
        width: 472px;
      }
    }
  </style>
  <div class="price-banner">
    <div class="price-info">
      <p class="current-price">${{ sale_price  }}</p>
      <p class="sale-price">{{ current_price | money }}</p>
    </div>
    <div class="sale-section">
      {{  sale_name }}
    </div>
  </div>