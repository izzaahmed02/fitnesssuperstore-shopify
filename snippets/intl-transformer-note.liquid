{%- comment -%}
  International transformer note (informational only — NOT an add-on or voltage selector).

  Renders a single compact line below Add to Cart on PRODUCT PAGES ONLY, for corded
  cardio products where the display flag has been turned on. The supporting detail sits
  in an information popover opened by hover, keyboard focus, or tap.

  Display control (single source of truth):
    custom.show_external_transformer_note (boolean) — content-display toggle only.

  Test the metafield's .value, never the metafield object. Once the metafield exists on
  a product the object stays truthy even after the toggle is set to false, so an object
  test would keep the note visible when it should be hidden.

  This flag is a content-display control. It does not represent or imply that any
  particular machine, model, or brand works or does not work with a transformer.

  The following metafields are intentionally NOT consulted here and must not decide
  whether the note displays:
    - custom.external_transformer_product
    - custom.external_transformer_eligible
    - custom.electrical_requirement

  Usage: {% render 'intl-transformer-note', product: product %}
{%- endcomment -%}

{%- if request.page_type == 'product' and product != blank -%}
  {%- if product.metafields.custom.show_external_transformer_note.value == true -%}
    {%- assign intl_transformer_popover_id = 'IntlTransformerInfo-' | append: product.id -%}
    {%- style -%}
      .intl-transformer-note {
        position: relative;
        margin-top: 1.25rem;
        margin-bottom: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--color-foreground), 0.12);
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(var(--color-foreground), 0.8);
      }
      @media screen and (min-width: 750px) {
        .intl-transformer-note {
          font-size: 1.1rem;
        }
      }
      .intl-transformer-note a {
        color: inherit;
        text-decoration: underline;
        font-weight: 500;
      }
      /* Stays static so the popover is positioned against the note, not the icon,
         which keeps it inside the viewport when the icon sits near a screen edge.
         vertical-align: middle centres the icon against the text it follows. */
      .intl-transformer-note__info {
        position: static;
        display: inline-flex;
        align-items: center;
        vertical-align: middle;
      }
      .intl-transformer-note__toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 0 0 0.4rem;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        cursor: pointer;
        line-height: 0;
        -webkit-tap-highlight-color: transparent;
      }
      .intl-transformer-note__toggle svg {
        display: block;
        width: 1.8rem;
        height: 1.8rem;
      }
      .intl-transformer-note__toggle:hover,
      .intl-transformer-note__toggle[aria-expanded='true'] {
        opacity: 0.75;
      }
      .intl-transformer-note__toggle:focus-visible {
        outline: 0.2rem solid rgb(var(--color-foreground));
        outline-offset: 0.1rem;
      }
      /* Quick add fetches the product page and injects its product-info markup, which
         carries a copy of this note. Hide it there immediately; the script removes it. */
      quick-add-modal .intl-transformer-note,
      [id^='QuickAddInfo-'] .intl-transformer-note {
        display: none;
      }
      .intl-transformer-note__popover {
        position: absolute;
        z-index: 3;
        top: calc(100% + 0.6rem);
        left: 0;
        right: 0;
        max-width: 42rem;
        padding: 1rem 1.2rem;
        border: 1px solid rgba(var(--color-foreground), 0.28);
        border-radius: 0.4rem;
        background-color: rgb(var(--color-background));
        box-shadow: 0 0.3rem 1.2rem rgba(var(--color-foreground), 0.18);
        font-size: 1rem;
        line-height: 1.5;
        color: rgb(var(--color-foreground));
      }
    {%- endstyle -%}
    <p class="intl-transformer-note" data-intl-transformer-note>
      Shipping outside the U.S. or Canada? <a href="/pages/contact">Contact us</a> about
      220-240V transformer options.<span class="intl-transformer-note__info">
        <button
          type="button"
          class="intl-transformer-note__toggle"
          aria-label="Transformer information"
          aria-expanded="false"
          aria-controls="{{ intl_transformer_popover_id }}"
          data-intl-transformer-toggle
        >
          {%- comment -%} Same help icon the PDP already uses for option and variant popups. {%- endcomment -%}
          <svg
            class="button--popup"
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9 2.125C5.20304 2.125 2.125 5.20304 2.125 9C2.125 12.797 5.20304 15.875 9 15.875C12.797 15.875 15.875 12.797 15.875 9C15.875 5.20305 12.797 2.125 9 2.125ZM0.874999 9C0.874999 4.51269 4.51269 0.875001 9 0.875001C13.4873 0.875002 17.125 4.51269 17.125 9C17.125 13.4873 13.4873 17.125 9 17.125C4.51268 17.125 0.874998 13.4873 0.874999 9ZM9.83333 12.3333C9.83333 12.7936 9.46024 13.1667 9 13.1667C8.53976 13.1667 8.16667 12.7936 8.16667 12.3333C8.16667 11.8731 8.53976 11.5 9 11.5C9.46024 11.5 9.83333 11.8731 9.83333 12.3333ZM7.93333 7.33334C7.93333 6.74423 8.4109 6.26667 9 6.26667C9.5891 6.26667 10.0667 6.74423 10.0667 7.33334L10.0667 7.43444C10.0667 7.74415 9.94364 8.04117 9.72464 8.26017L8.57574 9.40907C8.34142 9.64339 8.34142 10.0233 8.57574 10.2576C8.81005 10.4919 9.18995 10.4919 9.42427 10.2576L10.5732 9.1087C11.0172 8.66466 11.2667 8.06241 11.2667 7.43444L11.2667 7.33334C11.2667 6.08149 10.2518 5.06667 9 5.06667C7.74816 5.06667 6.73333 6.08149 6.73333 7.33333L6.73333 7.75C6.73333 8.08137 7.00196 8.35 7.33333 8.35C7.6647 8.35 7.93333 8.08137 7.93333 7.75L7.93333 7.33334Z" fill="#D83D0E"></path>
          </svg>
        </button>
      </span>
      <span
        id="{{ intl_transformer_popover_id }}"
        class="intl-transformer-note__popover"
        data-intl-transformer-popover
        hidden
      >
        For treadmills, ellipticals, exercise bikes, steppers, and other corded cardio
        equipment. We&rsquo;ll help identify the appropriate transformer capacity and
        connection based on the equipment&rsquo;s electrical requirements and destination
        power supply.
      </span>
    </p>
    <script src="{{ 'intl-transformer-note.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}
