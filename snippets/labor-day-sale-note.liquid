{% comment %}
  snippets/labor-day-sale-note.liquid

  Price-adjacent Labor Day offer on eligible PDPs. Eligibility mirrors the
  discount collections, while the displayed equipment price is calculated
  from the selected variant. Shopify still applies the automatic discount at
  checkout; this component does not alter catalog or checkout prices.

  Accepts:
    product         (Product)  required
    hide_on_mobile  (boolean)  optional
{% endcomment %}
{%- liquid
  assign in_ff = false
  assign in_reman = false

  if product.vendor == 'French Fitness' and product.type != 'Product (Hidden)'
    unless product.tags contains 'july4-exclude'
      assign in_ff = true
    endunless
  endif

  if product.type == 'Product Index' and product.title contains 'Remanufactured'
    assign in_reman = true
  endif

  assign campaign_text = ''
  assign campaign_percent = 0
  if in_ff
    assign campaign_text = settings.sale_promo_ff
    assign campaign_percent = 10
  elsif in_reman
    assign campaign_text = settings.sale_promo_reman
    assign campaign_percent = 5
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign campaign_base_price = current_variant.price
  assign campaign_multiplier = 100 | minus: campaign_percent
  assign campaign_checkout_price = campaign_base_price | times: campaign_multiplier | divided_by: 100
  assign campaign_savings = campaign_base_price | minus: campaign_checkout_price
-%}
{%- comment -%} Date window is evaluated in the store timezone. {%- endcomment -%}
{%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign start_s = settings.laborday_start | date: '%s' | plus: 0 -%}
{%- assign end_s = settings.laborday_end | date: '%s' | plus: 0 -%}
{%- assign in_window = false -%}
{%- if settings.laborday_force_preview or request.design_mode -%}
  {%- assign in_window = true -%}
{%- elsif start_s > 0 and end_s > 0 and now_s >= start_s and now_s < end_s -%}
  {%- assign in_window = true -%}
{%- endif -%}
{%- if campaign_text != blank and campaign_percent > 0 and campaign_base_price > 0 and in_window -%}
  <div class="campaign-sale-container{% if hide_on_mobile %} hide-on-mobile{% endif %}">
    <p class="campaign-sale-container__copy">{{ campaign_text | escape }}</p>
    <div class="campaign-sale-price" aria-live="polite">
      <span class="campaign-sale-price__label">Labor Day equipment price</span>
      <strong class="campaign-sale-price__value">{{ campaign_checkout_price | money }}</strong>
    </div>
    <p class="campaign-sale-container__savings">
      Save an additional {{ campaign_savings | money }} automatically at checkout.
    </p>
    <p class="campaign-sale-container__scope">
      Based on the {{ campaign_base_price | money }} equipment price. Options, warranty, shipping, and installation are excluded.
    </p>
  </div>
{%- endif -%}
