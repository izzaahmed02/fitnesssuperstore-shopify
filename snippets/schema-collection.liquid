<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ request.origin | append: collection.url | json }},
  "url": {{ request.origin | append: collection.url | json }},
  "name": {{ collection.title | append: ' | ' | append: shop.name | json }},
  "inLanguage": "en",
  "description": {{ collection.description | strip_html | strip_newlines | strip | replace: '&amp;', '&' | truncate: 400 | json }},

  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ shop.name | json }},
        "item": {{ request.origin | append: '/' | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
    ]
  },

  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {% paginate collection.products by 24 %}
        {% for product in collection.products %}
          {%- assign product_image_url = product.featured_image | image_url: width: 800 -%}
          {
            "@type": "Product",
            "@id": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }},
            "url": {{ request.origin | append: product.url | json }},
            "description": {{ product.description | strip_html | strip_newlines | strip | replace: '&amp;', '&' | truncate: 400 | json }},
            "sku": {{ product.selected_or_first_available_variant.sku | default: product.handle | json }},
            "brand": {
              "@type": "Brand",
              "name": {{ product.vendor | default: shop.name | json }}
            },
            {% if product.featured_image %}
            "image": {% if product_image_url contains 'https://' or product_image_url contains 'http://' %}{{ product_image_url | json }}{% else %}{{ product_image_url | prepend: 'https:' | json }}{% endif %},
            {% endif %}
            "itemCondition": "https://schema.org/{% if product.metafields.custom.condition_state %}{% if product.metafields.custom.condition_state contains 'as is' or product.metafields.custom.condition_state contains 'As is' %}UsedCondition{% elsif product.metafields.custom.condition_state contains 'Remanufactured' %}RefurbishedCondition{% else %}{{ product.metafields.custom.condition_state }}Condition{% endif %}{% else %}NewCondition{% endif %}",
            "offers": {
              "@type": "Offer",
              "url": {{ request.origin | append: product.url | json }},
              "price": {{ product.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ shop.currency | default: 'USD' | json }},
              "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
            }
            {% if product.metafields.reviews.rating.value.rating and product.metafields.reviews.rating_count.value %}
            ,
            "aggregateRating": {
              "@type": "AggregateRating",
              "@id": {{ request.origin | append: product.url | append: '#aggregaterating' | json }},
              "name": {{ product.title | json }},
              "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
              "bestRating": 5,
              "worstRating": 1,
              "ratingCount": {{ product.metafields.reviews.rating_count.value | json }},
              "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
            }
            {% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      {% endpaginate %}
    ]
  }

  {% if collection.metafields.custom.seo_videos %}
  ,
  "subjectOf": [
    {% assign seo_videos = collection.metafields.custom.seo_videos.value %}
    {% for video in seo_videos %}
      {%- liquid
        assign video_title = video.title.value | default: video.title | default: collection.title | default: shop.name

          assign video_description = video.description.value | default: video.description | default: collection.description | default: shop.description
          assign video_description = video_description | strip_html | strip_newlines | strip | replace: '&amp;', '&' | truncate: 500

        if video_description == blank
          assign video_description = 'Video for ' | append: collection.title
        endif

        assign video_thumbnail = video.thumbnail_url.value | default: video.thumbnail_url

        if video_thumbnail == blank and collection.featured_image
          assign video_thumbnail = collection.featured_image | image_url: width: 1200
        endif

        assign video_upload_date = video.upload_date.value | default: video.upload_date | default: collection.updated_at | default: '2026-01-01T00:00:00Z'

        assign video_duration_seconds = video.duration_seconds.value | default: video.duration_seconds

        assign video_content_url = video.content_url.value | default: video.content_url | default: video.video_url.value | default: video.video_url
        assign video_embed_url = video.embed_url.value | default: video.embed_url | default: video.video_url.value | default: video.video_url

        assign publisher_logo_url = settings.logo | image_url: width: 800
      -%}
      {
        "@type": "VideoObject",
        "@id": {{ request.origin | append: collection.url | append: '#video-' | append: forloop.index | json }},
        "name": {{ video_title | strip | json }},
        "description": {{ video_description | json }},
        {% if video_thumbnail != blank %}
        "thumbnailUrl": [
          {% if video_thumbnail contains 'https://' or video_thumbnail contains 'http://' %}
            {{ video_thumbnail | json }}
          {% else %}
            {{ video_thumbnail | prepend: 'https:' | json }}
          {% endif %}
        ],
        {% endif %}
        "uploadDate": {{ video_upload_date | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        {% if video_duration_seconds != blank %}
        "duration": {{ 'PT' | append: video_duration_seconds | append: 'S' | json }},
        {% endif %}
        {% if video_content_url != blank %}
        "contentUrl": {% if video_content_url contains 'https://' or video_content_url contains 'http://' %}{{ video_content_url | json }}{% else %}{{ video_content_url | prepend: 'https:' | json }}{% endif %},
        {% endif %}
        {% if video_embed_url != blank %}
        "embedUrl": {% if video_embed_url contains 'https://' or video_embed_url contains 'http://' %}{{ video_embed_url | json }}{% else %}{{ video_embed_url | prepend: 'https:' | json }}{% endif %},
        {% endif %}
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }},
          {% if settings.logo %}
          "logo": {
            "@type": "ImageObject",
            "url": {% if publisher_logo_url contains 'https://' or publisher_logo_url contains 'http://' %}{{ publisher_logo_url | json }}{% else %}{{ publisher_logo_url | prepend: 'https:' | json }}{% endif %}
          }
          {% else %}
          "logo": {
            "@type": "ImageObject",
            "url": {{ request.origin | json }}
          }
          {% endif %}
        }
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
  {% endif %},

  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    "telephone": {{ shop.phone | default: '925-215-2927' | json }},
    "email": "sales@fitnesssuperstore.com",
    {% if settings.logo %}
      {%- assign org_logo_url = settings.logo | image_url: width: 800 -%}
      "image": {% if org_logo_url contains 'https://' or org_logo_url contains 'http://' %}{{ org_logo_url | json }}{% else %}{{ org_logo_url | prepend: 'https:' | json }}{% endif %},
    {% endif %}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "537 Stone Rd. STE F",
      "addressLocality": "Benicia",
      "addressRegion": "CA",
      "postalCode": "94510",
      "addressCountry": "US"
    }
  }
}
</script>