<style>
      .popover-container {
        position: relative;
        max-width: 470px;
        margin-top: 30px;
      }
      
      .popover-container .warning {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .popover-container p {
        font-family: 'Lato';
        font-weight: 700;
        font-size: 14px;
        display: flex;
        gap: 3px;
      }

      .prop65-trigger {
        color: #f1592a;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
        position: relative;
      }

      bubb-content {
        font-size: 14px;
      }
</style>
<div class="popover-container custom-anitakk" id="bobb-popover-container" data-bubb="toggle">
    <p>
      <span class="warning">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 0C4.47301 0 0 4.4725 0 10C0 15.5269 4.4725 20 10 20C15.527 20 20 15.5275 20 10C20 4.47309 15.5275 0 10 0ZM11.0269 13.9696C11.0269 14.2855 10.5662 14.6014 10.0002 14.6014C9.40785 14.6014 8.98668 14.2855 8.98668 13.9696V8.95445C8.98668 8.5859 9.40789 8.33574 10.0002 8.33574C10.5662 8.33574 11.0269 8.5859 11.0269 8.95445V13.9696ZM10.0002 7.12484C9.39473 7.12484 8.9209 6.6773 8.9209 6.17707C8.9209 5.67687 9.39477 5.2425 10.0002 5.2425C10.5926 5.2425 11.0665 5.67687 11.0665 6.17707C11.0665 6.6773 10.5925 7.12484 10.0002 7.12484Z" fill="#F1592A"/>
        </svg>
        California Residents</span>
      <span class="prop65-trigger">see Prop 65 WARNING</span>
    </p>
    <a id="download-pds" style="cursor:pointer;">Product Data Sheet {% render 'new-download-icon' %}</a>
  </div>
  <script defer src="https://s3.us-west-1.amazonaws.com/fitnesssuperstore.info/js/bubb.js"></script>
  <script defer>
    document.addEventListener("DOMContentLoaded", function () {
      bubb({ toggle: { text: 'WARNING: Cancer and Reproductive Harm - www.P65Warnings.ca.gov', _: { background: "rgb(53 53 53)", toggle: !0 } } })

       document.querySelector('.prop65-trigger').addEventListener('click', async (event) => {
        bubb.toggle("toggle");
        const bubbConteiner = document.getElementById("bobb-popover-container");
        if (bubbConteiner.getElementsByTagName('bubb-bobb')[0].checkVisibility({opacityProperty: true})) {
          bubbConteiner.style.marginBottom = '0px';
        } else {
          bubbConteiner.style.marginBottom = '70px';
        } 
      });
    });
  </script>