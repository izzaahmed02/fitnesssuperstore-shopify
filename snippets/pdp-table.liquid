{%- comment -%}
  Renders ONE pdp_table metaobject entry as a semantic, accessible table.

  Usage:
    {% render 'pdp-table', table: table_entry %}

  Data model (column-major):
    table.section_header            -> heading above the table
    table.table_type                -> "Table with header" | "Table without header"
    table.table_headers.value       -> list of COLUMNS (iterate, do NOT index)
        header.custom_title         -> column heading (may be blank)
        header.content.value        -> column's cells, top-to-bottom (iterate)
            cell.values  (rich text)    -> cell content (Package-style)
            cell.attribute (rich text)  -> cell content (Spec-style)

  NOTE: Shopify metaobject reference lists support ITERATION, not positional
  indexing (value[0] returns null). We flatten each column's cells into a
  delimited string while looping, then split back into rows. Columns may be
  ragged; table is sized to the longest column and short columns pad blank.
{%- endcomment -%}

{%- liquid
  assign cols = table.table_headers.value
  assign show_head = false
  if table.table_type == 'Table with header'
    assign show_head = true
  endif
-%}

{%- if cols != blank -%}

  {%- assign col_blobs = '' -%}
  {%- assign max_rows = 0 -%}
  {%- for col in cols -%}
    {%- assign cell_count = 0 -%}
    {%- capture this_col -%}
      {%- for cell in col.content.value -%}
        {%- assign cell_count = cell_count | plus: 1 -%}
        {%- if cell.values != blank -%}
          {{ cell.values | metafield_tag }}
        {%- elsif cell.attribute != blank -%}
          {{ cell.attribute | metafield_tag }}
        {%- endif -%}
        ~~CELL~~
      {%- endfor -%}
    {%- endcapture -%}
    {%- if cell_count > max_rows -%}
      {%- assign max_rows = cell_count -%}
    {%- endif -%}
    {%- assign col_blobs = col_blobs | append: this_col | append: '~~COL~~' -%}
  {%- endfor -%}

  {%- assign columns_data = col_blobs | split: '~~COL~~' -%}

  {%- if table.section_header != blank -%}
    <h3 class="pdp-table__heading product__extra_info-title">{{ table.section_header }}</h3>
  {%- endif -%}

  {%- if max_rows > 0 -%}
    <div class="pdp-table__scroll">
      <table class="pdp-table{% unless show_head %} pdp-table--no-head{% endunless %}">
        {%- if show_head -%}
          <thead>
            <tr>
              {%- for col in cols -%}
                <th scope="col">{{ col.custom_title }}</th>
              {%- endfor -%}
            </tr>
          </thead>
        {%- endif -%}
        <tbody>
          {%- for r in (1..max_rows) -%}
            {%- assign row_idx = forloop.index0 -%}
            <tr>
              {%- for col_blob in columns_data -%}
                {%- if col_blob != blank -%}
                  {%- assign cells = col_blob | split: '~~CELL~~' -%}
                  <td>{{ cells[row_idx] }}</td>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- endif -%}

{%- endif -%}

{%- stylesheet -%}
.pdp-table__heading { margin: 24px 0 8px; }
.pdp-table__scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.pdp-table {
  width: 100%;
  border-collapse: collapse;
  margin: 0 0 24px;
  font-size: 15px;
  line-height: 1.4;
}
.pdp-table thead th {
  text-align: left;
  font-weight: 700;
  padding: 10px 12px;
  border-bottom: 2px solid #ddd;
  vertical-align: top;
  white-space: nowrap;
}
.pdp-table tbody td {
  padding: 10px 12px;
  border-bottom: 2px solid #ddd;
  vertical-align: top;
}
.pdp-table td .metafield-rich_text_field p,
.pdp-table th .metafield-rich_text_field p { margin: 0; }
.pdp-table a { color: var(--primary-orange-500, #D83D0E); text-decoration: underline; }
.pdp-table--no-head td { padding-left: 0; }
@media (max-width: 600px) {
  .pdp-table { font-size: 14px; }
  .pdp-table thead th, .pdp-table tbody td { padding: 8px 10px; }
}
{%- endstylesheet -%}
