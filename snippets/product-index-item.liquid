<div class="product-index-item">
    {% if product.selected_or_first_available_variant.sku != blank %}
        <span class="product-index-item__sku">
      {{ product.selected_or_first_available_variant.sku }}
    </span>
    {% endif %}
    <div class="product-index-item__scrollable">
        <span class="product-index-item__price">{{ product.selected_or_first_available_variant.price | money }}</span>
        <a href="{{ product.url }}" class="product-index-item__title">{{ product.title }}</a>
    </div>
</div>
