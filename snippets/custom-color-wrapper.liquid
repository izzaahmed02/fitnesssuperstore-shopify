{% comment %} 
  custom-color-wrapper.liquid - Рефакторинг для отображения цветовых опций
{% endcomment %}
{% assign color_map =
        "black:#000000,
   white:#FFFFFF,
   red:#660F0A,
   green:#008000,
   blue:#3E77AA,
   yellow:#EEB241,
   gray:#808080,
   grey:#808080,
   silver:#E5E5E5,
   orange:#FFA500,
   purple:#800080,
   pink:#FFC0CB,
   navy:#000080,
   teal:#008080,
   maroon:#800000,
   burgundy:#800020"
%}

{% assign custom_color_price = nil %}
{% assign custom_color_variant_id = nil %}
{% assign has_custom_color = false %}

{% if products %}
    {% for variant in products %}
        {% if variant.title contains 'Custom Color' %}
            {% assign custom_color_price = variant.price | money_without_currency %}
            {% assign custom_color_variant_id = variant.id %}
            {% assign has_custom_color = true %}
            {% break %}
        {% endif %}
    {% endfor %}
{% endif %}

{% capture warning_icon_svg %}
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd"
              d="M6.00003 1.12109C5.53841 1.12109 5.20166 1.399 4.91355 1.76103C4.63174 2.11513 4.33186 2.63313 3.961 3.27374L3.94464 3.30199L1.91353 6.81027L1.89716 6.83854C1.52489 7.48153 1.22394 8.00133 1.05666 8.4233C0.885707 8.85455 0.812157 9.28615 1.04328 9.68702C1.2744 10.0879 1.68476 10.2405 2.14364 10.3086C2.59263 10.3753 3.19326 10.3752 3.93625 10.3752H3.96892H8.03113H8.06381C8.80679 10.3752 9.40742 10.3753 9.85642 10.3086C10.3153 10.2405 10.7257 10.0879 10.9568 9.68702C11.1879 9.28615 11.1143 8.85456 10.9434 8.42331C10.7761 8.00135 10.4752 7.48156 10.1029 6.8386L10.1029 6.83855L10.0865 6.81027L8.05541 3.302L8.03906 3.27374C7.6682 2.63313 7.36831 2.11513 7.08651 1.76103C6.7984 1.399 6.46165 1.12109 6.00003 1.12109ZM6.37503 4.50022C6.37503 4.29311 6.20713 4.12522 6.00003 4.12522C5.79292 4.12522 5.62503 4.29311 5.62503 4.50022V6.50022C5.62503 6.70732 5.79292 6.87522 6.00003 6.87522C6.20713 6.87522 6.37503 6.70732 6.37503 6.50022V4.50022ZM6.50003 8.00022C6.50003 8.27636 6.27617 8.50022 6.00003 8.50022C5.72388 8.50022 5.50003 8.27636 5.50003 8.00022C5.50003 7.72407 5.72388 7.50022 6.00003 7.50022C6.27617 7.50022 6.50003 7.72407 6.50003 8.00022Z"
              fill="#E9380D"/>
    </svg>
{% endcapture %}

{% capture plus_icon_svg %}
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 7H7M13 7H7M7 7V1M7 7V13" stroke="white" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round"/>
    </svg>
{% endcapture %}

{% capture close_icon_svg %}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd"
              d="M4.46967 4.46967C4.76256 4.17678 5.23744 4.17678 5.53033 4.46967L10 8.93934L14.4697 4.46967C14.7626 4.17678 15.2374 4.17678 15.5303 4.46967C15.8232 4.76256 15.8232 5.23744 15.5303 5.53033L11.0607 10L15.5303 14.4697C15.8232 14.7626 15.8232 15.2374 15.5303 15.5303C15.2374 15.8232 14.7626 15.8232 14.4697 15.5303L10 11.0607L5.53033 15.5303C5.23744 15.8232 4.76256 15.8232 4.46967 15.5303C4.17678 15.2374 4.17678 14.7626 4.46967 14.4697L8.93934 10L4.46967 5.53033C4.17678 5.23744 4.17678 4.76256 4.46967 4.46967Z"
              fill="black"/>
    </svg>
{% endcapture %}

<div class="color-options">
    {% if products %}
        {% for variant in products %}
            {% if variant.title != 'Custom Color' %}
                {% assign is_unavailable = false %}
                {% unless variant.available %}
                    {% assign is_unavailable = true %}
                {% endunless %}

                {% assign color_name = variant.title | downcase %}
                {% assign background_color = "#CCCCCC" %}

                {% if color_name contains "/" %}
                    {% assign color_parts = color_name | split: "/" %}
                    {% assign gradient_colors = "" %}

                    {% for part in color_parts %}
                        {% assign part_trimmed = part | strip %}
                        {% capture part_color %}
                            {% render 'get-color-by-name', part_name: part_trimmed, color_map: color_map %}
                        {% endcapture %}

                        {% if gradient_colors != "" %}
                            {% assign gradient_colors = gradient_colors | append: ", " %}
                        {% endif %}
                        {% assign gradient_colors = gradient_colors | append: part_color %}
                    {% endfor %}

                    {% if color_parts.size > 1 %}
                        {% assign gradient_colors_array = gradient_colors | split: ", " %}
                        {% assign background_color = "linear-gradient(to right, " | append: gradient_colors_array.first | append: " 50%, " | append: gradient_colors_array.last | append: " 50%)" %}
                    {% else %}
                        {% assign background_color = "linear-gradient(to right, " | append: gradient_colors | append: ")" %}
                    {% endif %}
                {% else %}
                    {% capture background_color %}
                        {% render 'get-color-by-name', part_name: color_name, color_map: color_map %}
                    {% endcapture %}
                {% endif %}

                <div class="swatch {% if is_unavailable %}unavailable{% endif %}"
                     data-color-name="{{ variant.title }}"
                     data-id="{{ variant.id }}"
                        {% if variant.id ==  default %}
                           data-checked
                        {% endif %}
                     data-color-price="{{ variant.price | money }}"
                     data-tool-tip="{% if is_unavailable %}{{ variant.title }} (unavailable or sold-out){% else %}{{ variant.title }} {{ variant.price | money }}{% endif %}"
                     data-title="{{ variant.title }}"
                     style="background: {{ background_color | replace: ');', ')' }}; {% if is_unavailable %}opacity: 0.6;{% endif %}">
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
</div>

<div class="custom-color-select-wrapper {{ group }}">
    <input type="hidden" data-variant="{{ custom_color_variant_id  }}" id="custom-color-{{ group }}-hidden" name="custom-color-{{ group }}-hidden"
           value="">
    {% if has_custom_color %}
        <div class="swatch swatch--custom-trigger custom-color-trigger" data-tool-tip="Add custom color">
            {{ plus_icon_svg }}
        </div>
    {% endif %}

    <div class="custom-color-input" style="display: none;">
        <div class="custom-color-input-header">
            <p>Custom color or code</p>
            {{ close_icon_svg }}
        </div>

        <div class="custom-color-input-field">
            <div class="custom-color-wrapper">
                <input
                        type="text"
                        class="custom-color-value"
                        data-price="{{ custom_color_price }}"
                        data-id="{{ custom_color_variant_id }}"
                        placeholder="Input custom color or code"
                        maxlength="40"
                        aria-label="Custom color input"
                >
            </div>
            <button type="button" class="add-custom-color" data-group="{{ group }}">Add</button>
        </div>

        <span class="custom-color-error_message">
      {{ warning_icon_svg }}
      This color is not in the palette, check again and enter the correct color
    </span>
        {% if variant.product.tags contains 'can_only_paint_uprights' %}
            <div><span style="color:red;">*can only paint uprights</span></div>
        {% endif %}
        <span class="custom-color-empty-error_message">
      {{ warning_icon_svg }}
      The color cannot be blank or empty
    </span>
        <p>Choose a color from this guide:</p>
        {% assign color_guide_url = "" %}
        {% if group == 'paint' %}
            {% assign color_guide_url = "https://drive.google.com/file/d/110TXCrGCkSF8faJSNBdyAuK68slvLhDH/view" %}
        {% elsif group == 'vinyl' %}
            {% assign color_guide_url = "https://drive.google.com/file/d/1HMZ43M2BBJ1AJr3tDrDhUknpEymn1KKU/view" %}
        {% elsif group == 'upholstery' %}
            {% assign color_guide_url = "https://drive.google.com/file/d/1HMZ43M2BBJ1AJr3tDrDhUknpEymn1KKU/view" %}
        {% endif %}
        {% if color_guide_url != "" %}
            <a href="{{ color_guide_url }}" target="_blank">
                See available colors pdf
            </a>
        {% endif %}
    </div>
</div>
