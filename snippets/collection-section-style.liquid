{% style %}
  .container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
  }
  .collection-wrapper {
    display: flex;
    justify-content: space-between;
    padding-bottom: 40px;
  }
  .collection-product-wrapper {
    max-width: 952px;
    width: 100%;
    gap: 20px;
  }
  .group-stars {
    display: flex;
    align-items: center;
  }
  .condition-tag.blue {
    background: #fff;
    color: #3e77aa;
  }
  .condition-tag svg {
    margin-right: 4px;
  }
  .group-stars .on {
    background-repeat: no-repeat;
    background-position-y: center;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M11.2736 2.57493C11.5595 1.95503 12.4405 1.95503 12.7264 2.57493L14.9159 7.32176C15.0325 7.5744 15.2719 7.74836 15.5482 7.78112L20.7393 8.3966C21.4172 8.47698 21.6895 9.31489 21.1883 9.77838L17.3503 13.3276C17.1461 13.5165 17.0546 13.7979 17.1089 14.0708L18.1276 19.198C18.2607 19.8676 17.5479 20.3855 16.9522 20.052L12.3908 17.4987C12.148 17.3628 11.852 17.3628 11.6092 17.4987L7.04779 20.052C6.4521 20.3855 5.73933 19.8676 5.87238 19.198L6.89115 14.0708C6.94537 13.7979 6.85392 13.5165 6.64965 13.3276L2.81174 9.77839C2.31054 9.31489 2.5828 8.47698 3.26071 8.3966L8.4518 7.78112C8.72809 7.74836 8.96752 7.5744 9.08406 7.32176L11.2736 2.57493Z" fill="%23FFC107"/></svg>');
    background-size: contain;
    min-width: 24px;
    height: 24px;
  }

  .group-stars .ind_cnt {
    text-align: left;
    margin-left: 4px;
    font-size: 16px;
    color: #b3b3b3;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    column-gap: 32px;
    row-gap: 48px;
  }

  #verticalTitle {
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #393940;
    text-transform: none;
    margin-bottom: 12px;
  }
  .heading-filter-count {
    color: #f3744c;
  }
  .facets__summary-label {
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    color: #393940;
  }
  .facets__summary .icon-caret {
    width: 12px;
  }
  .facets__selected {
    display: none;
  }
  .facets-wrap-vertical {
    margin-right: 0;
    padding: 0;
  }
  .filterSearchInput {
    width: 248px;
    height: 48px;
    border-radius: 8px;
    border: 1.5px solid #e5e5e5;
    background: #ffffff;
    margin-bottom: 12px;
    background-image: url('data:image/svg+xml;charset=UTF-8,%3Csvg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath fill-rule="evenodd" clip-rule="evenodd" d="M3.75 11C3.75 6.99594 6.99594 3.75 11 3.75C15.0041 3.75 18.25 6.99594 18.25 11C18.25 15.0041 15.0041 18.25 11 18.25C6.99594 18.25 3.75 15.0041 3.75 11ZM11 2.25C6.16751 2.25 2.25 6.16751 2.25 11C2.25 15.8325 6.16751 19.75 11 19.75C13.1462 19.75 15.112 18.9773 16.6342 17.6949L19.4697 20.5303C19.7626 20.8232 20.2374 20.8232 20.5303 20.5303C20.8232 20.2374 20.8232 19.7626 20.5303 19.4697L17.6949 16.6342C18.9773 15.112 19.75 13.1462 19.75 11C19.75 6.16751 15.8325 2.25 11 2.25Z" fill="%23B3B3B3"/%3E%3C/svg%3E');
    background-repeat: no-repeat;
    background-position: 12px center;
    padding-left: 44px;
  }
  #search-input {
    width: 248px;
    height: 48px;
    border-radius: 8px;
    border: 1.5px solid #e5e5e5;
    background: #ffffff;
    background-image: url('data:image/svg+xml;charset=UTF-8,%3Csvg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath fill-rule="evenodd" clip-rule="evenodd" d="M3.75 11C3.75 6.99594 6.99594 3.75 11 3.75C15.0041 3.75 18.25 6.99594 18.25 11C18.25 15.0041 15.0041 18.25 11 18.25C6.99594 18.25 3.75 15.0041 3.75 11ZM11 2.25C6.16751 2.25 2.25 6.16751 2.25 11C2.25 15.8325 6.16751 19.75 11 19.75C13.1462 19.75 15.112 18.9773 16.6342 17.6949L19.4697 20.5303C19.7626 20.8232 20.2374 20.8232 20.5303 20.5303C20.8232 20.2374 20.8232 19.7626 20.5303 19.4697L17.6949 16.6342C18.9773 15.112 19.75 13.1462 19.75 11C19.75 6.16751 15.8325 2.25 11 2.25Z" fill="%23B3B3B3"/%3E%3C/svg%3E');
    background-repeat: no-repeat;
    background-position: 12px center;
    padding-left: 44px;
  }
  .facet-checkbox__text-label {
    font-size: 16px;
    line-height: 24px;
    color: #393940;
  }
  #Filter-Price-LTE {
    width: 248px;
    height: 48px;
    border-radius: 8px;
    background: #f2f2f2;
    border: 1.5px solid #e5e5e5;
    padding: 12px;
  }
  #sel1 {
    width: 76px;
    height: 48px;
    border-radius: 8px;
    border: 1.5px solid #e5e5e5;
    padding: 12px;
    background: #ffffff;
  }
  #sel1:focus-visible {
    box-shadow: none;
    outline: none;
  }
  .collection-grid-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .facets-vertical-sort {
    margin-right: 32px;
  }
  .facet-filters__sort {
    width: 212px;
    height: 48px;
    border-radius: 8px;
    background: #ffffff;
    border: 1.5px solid #e5e5e5;
    padding-right: 16px;
  }
  .facet-filters__sort + svg {
    margin-right: 16px;
  }
  .facet-filters__sort:focus-visible {
    box-shadow: none !important;
    outline: none !important;
  }
  .sort-per-page .label {
    font-size: 16px;
    line-height: 24px;
    color: #393940;
  }
  .collection-grid-top .right-side {
    display: flex;
  }
  .sort-per-page .select {
    width: auto !important;
    margin-left: 8px;
    margin-right: 8px;
  }
  .sort-per-page .select select {
    appearance: none;
  }
  .sort-per-page .select:after {
    display: none;
  }
  .sort-per-page {
    display: flex;
    align-items: center;
  }
  .active-facets__button-remove span {
    display: flex;
    align-items: center;
  }
  .collecion-count {
    margin-top: 32px;
    color: #393940;
  }
  .collecion-count span {
    font-weight: 700;
  }
  .active-facets__button-remove span {
    font-size: 16px;
    font-weight: 700;
    color: #e9380d;
    line-height: 24px;
  }
  .active-facets__button-remove span svg {
    margin-left: 4px;
  }
  .related-products__body {
    position: relative;
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 48px;
    margin-left: auto;
    margin-right: auto;
  }
  .pagination a {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #393940;
  }
  .pagination .current {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: #f1592a;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #fff;
  }
  .pagination a:first-child {
    margin-right: 24px;
  }
  .pagination a:last-child {
    margin-left: 24px;
  }
  .product-item .image-wrap {
    max-width: 296px;
    height: 283px;
    margin-bottom: 16px;
  }
  .image-item {
    background: transparent;
    border-radius: 12px;
    height: 288px;
  }
  .product-item .image-wrap img {
    max-width: 100%;
    width: 100%;
    padding: 45px;
    height: 100%;
    max-height: 283px;
    object-fit: contain;
  }

  @media (max-width: 749px) {
    .product-item .image-wrap img {
      padding: 24px;
    }
  }

  .ship-wrapper {
    display: flex;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: #00a344;
    margin-bottom: 8px;
  }
  .ship-wrapper svg {
    margin-right: 4px;
    min-width: 20px;
  }
  .product-item {
    position: relative;
  }
  .product-item .title {
    display: block;
    margin-bottom: 12px;
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
    color: #23232b;
    margin-top: 0;
    text-decoration: uppercase;
  }
  .image-wrap {
    position: relative;
    border-radius: 12px;
  }
  .product-item .tags-wrapper {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    align-items: center;
  }
  .condition-tag {
    margin-right: 8px;
    padding: 5px 8px;
    display: flex;
    align-items: center;
    background: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    color: #f1592a;
    border-radius: 100px;
  }
  .sale-tag {
    padding: 5px 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    background: #feeae8;
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    color: #f52419;
    border-radius: 100px;
  }
  .review-container {
    display: flex;
    margin-bottom: 12px;
    align-items: center;
    gap: 5px;
  }
  .main-review-container {
    display: none;
  }
  .old-price-wrapper {
    font-size: 16px;
    line-height: 24px;
    color: #b3b3b3;
    text-decoration: line-through;
  }
  .old-price-wrapper.retail-price-blank {
    height: 20px;
  }
  .price-wrapper {
    font-size: 16px;
    line-height: 24px;
    color: #000000;
  }
  .price-wrapper .price-title {
    font-weight: 400;
    font-family: 'Lato';
    font-size: 16px;
  }
  .price-wrapper .price-value {
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #f1592a;
    margin-top: 4px;
    margin-left: 5px;
  }
  .image-wrap img {
    transition: opacity 0.3s ease-in-out;
    width: 100%;
    height: auto;
  }
  .product-item .slick-dots {
    bottom: 12px;
  }
  .product-item .slick-dots li button:before {
    display: none;
  }
  .product-item .slick-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  .product-item .slick-dots li {
    width: 8px;
    height: 8px;
    border-radius: 50px;
    background: #d3d9e5;
    margin: 0;
  }
  .product-item .slick-dots li button {
    display: none;
  }
  .product-item .slick-dots li.slick-active {
    background: #23232b;
  }
