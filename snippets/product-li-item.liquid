<li class="product-item product-li-item" data-brand="{{ product.metafields.custom.brand }}">
  <span class="model">
    {% unless product.metafields.custom.model == blank %}
      {{ product.metafields.custom.model }}
    {% else %}
      BFMG30
    {% endunless %}
  </span>

  <span class="price">{{ product.price | money }}</span>
  <span class=""
    ><a href="{{ product.url }}">{{ product.title }}</a></span
  >
</li>
