                    </div>
                  {% elsif first_media.media_type == 'model' %}
                    {% assign first_media_camera_orbit = first_media.presentation.camera_orbit
                      | default: default_camera_orbit
                    %}
                    <!-- Preload 3D model assets -->
                    {% assign first_3d_model = first_media %}
                    {%- if first_3d_model -%}
                      {% for source in first_3d_model.sources %}
                        {% if source.format == 'glb' %}
                          {{ source.url | preload_tag: as: 'fetch', type: 'model/gltf-binary' }}
                        {% endif %}
                      {% endfor %}
                      {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
                      <link
                        id="ModelViewerStyle"
                        rel="stylesheet"
                        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
                        media="print"
                        onload="this.media='all'"
                      >
                      <link
                        id="ModelViewerOverride"
                        rel="stylesheet"
                        href="{{ 'component-model-viewer-ui.css' | asset_url }}"
                        media="print"
                        onload="this.media='all'"
                      >
                    {%- endif -%}

                    <model-viewer
                      alt="{{ first_media.alt | json }}"
                      src="{% for source in first_media.sources %}{% if source.format == 'glb' %}{{ source.url }}{% endif %}{% endfor %}"
                      camera-controls="true"
                      camera-orbit="{{ first_media_camera_orbit }}"
                      data-shopify-feature="1.12"
                      data-js-focus-visible=""
                      ar-status="not-presenting"
                    >
                    </model-viewer>
                  {% elsif first_media.media_type == 'video' %}
                    {{ first_media | media_tag }}
                  {% else %}
                    <div class="media-placeholder">Preview available in popup only.</div>
                  {% endif %}
                </div>
              {% else %}
                <div
                  class="main-image-container{% if model.alt contains '3D' or model.alt contains '3d' %} threeD-image{% endif %}"
                  data-media-id="{{ model.id }}"
                >
                  {% assign model_camera_orbit = model.presentation.camera_orbit | default: default_camera_orbit %}
                  <model-viewer
                    alt="{{ model.alt | json }}"
                    src="{% for source in model.sources %}{% if source.format == 'glb' %}{{ source.url }}{% endif %}{% endfor %}"
                    camera-controls="true"
                    camera-orbit="{{ model_camera_orbit }}"
                    data-shopify-feature="1.12"
                    data-js-focus-visible=""
                    ar-status="not-presenting"
                  ></model-viewer>
                  {% if model.alt contains '3D' or model.alt contains '3d' %}
                    <span class="icon-3d main" aria-label="3D Icon">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        fill="#000000"
                        height="800px"
                        width="800px"
                        version="1.1"
                        id="Layer_1"
                        viewBox="0 0 480 480"
                        xml:space="preserve"
                      >
