        </div>

        <script type="application/json" data-product-media>
          [
            {% for media in product.media %}
              {
                "id": {{ media.id | json }},
                "media_type": {{ media.media_type | json }},
                "alt": {{ media.alt | json }},
                "preview_image": {
                  "src": {{ media.preview_image | image_url: width: 720 | json }},
                  "srcset": "{{ media.preview_image | image_url: width: 360 }} 360w, {{ media.preview_image | image_url: width: 540 }} 540w, {{ media.preview_image | image_url: width: 720 }} 720w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1080 }} 1080w, {{ media.preview_image | image_url: width: 1440 }} 1440w, {{ media.preview_image | image_url: width: 2048 }} 2048w",
                  "sizes": "(min-width: 1200px) 34vw, (min-width: 990px) 38vw, 100vw",
                  "width": {{ media.preview_image.width | json }},
                  "height": {{ media.preview_image.height | json }}
                }
                {% if media.media_type == 'model' %}
                {% assign media_camera_orbit = media.presentation.camera_orbit %}
                  , "url": {% for source in media.sources %}{% if source.format == 'glb' %}"{{ source.url }}"{% endif %}{% endfor %}
                  , "camera_orbit": {{ media_camera_orbit | json }}
                {% elsif media.media_type == 'video' %}
                  , "sources": [
                    {% for source in media.sources %}
                      {
                        "url": {{ source.url | json }},
                        "mime_type": {{ source.mime_type | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                {% elsif media.media_type == 'external_video' %}
                  , "host": {{ media.host | json }},
                    "external_id": {{ media.external_id | json }}
                {% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>

        {% comment %}
          Templates that hold the native Shopify model_viewer markup for each 3D media item.
          They are cloned on demand so camera orbit data defined in the admin is preserved.
        {% endcomment %}
        {% for media in product.media %}
          {% if media.media_type == 'model' %}
            <template id="ModelViewerTemplate-{{ media.id }}" data-model-viewer-template>
              {{
                media
                | model_viewer_tag:
                  image_size: '2048x',
                  reveal: 'auto',
                  toggleable: true,
                  interaction_prompt: 'auto',
                  loading: 'eager'
              }}
            </template>
          {% endif %}
        {% endfor %}
      </product-gallery>

      {%- comment -%} Mobile gallery (live main-product.liquid lines 701-719): the
          desktop <product-gallery> is hidden <=989px and this swipeable slick
          slider is built by product-mobile-gallery.js from the
          [data-product-media] JSON above. Was missing from the original copy
          (which stopped at line 695), so the gallery collapsed to 0x0 on
          mobile. {%- endcomment -%}
      {%- liquid
        assign mobile_gallery_featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media | default: product.media.first
        assign mobile_gallery_aspect_ratio = mobile_gallery_featured_media.preview_image.aspect_ratio | default: mobile_gallery_featured_media.aspect_ratio | default: 1
      -%}
      <mobile-gallery style="--mobile-gallery-aspect-ratio: {{ mobile_gallery_aspect_ratio }};">
        <div class="mobile-gallery-wrapper only-mobile">
          <div class="main-slider-arrow--left" type="button">
            <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 0.46967C7.48924 0.762563 7.48924 1.23744 7.19635 1.53033L2.72668 6L7.19635 10.4697C7.48924 10.7626 7.48924 11.2374 7.19635 11.5303C6.90345 11.8232 6.42858 11.8232 6.13569 11.5303L1.13569 6.53033C0.995033 6.38968 0.916016 6.19891 0.916016 6C0.916016 5.80109 0.995033 5.61032 1.13569 5.46967L6.13569 0.46967C6.42858 0.176777 6.90345 0.176777 7.19635 0.46967Z" fill="white"/>
            </svg>
          </div>

          <div class="mobile-gallery-slider image-skeleton-wrapper"></div>

          <div class="main-slider-arrow--right" type="button">
            <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M0.803654 0.46967C1.09655 0.176777 1.57142 0.176777 1.86431 0.46967L6.86431 5.46967C7.15721 5.76256 7.15721 6.23744 6.86431 6.53033L1.86431 11.5303C1.57142 11.8232 1.09655 11.8232 0.803654 11.5303C0.510761 11.2374 0.510761 10.7626 0.803654 10.4697L5.27332 6L0.803654 1.53033C0.510761 1.23744 0.510761 0.762563 0.803654 0.46967Z" fill="white"/>
            </svg>
          </div>

          <div class="mobile-gallery-dots"></div>
        </div>
      </mobile-gallery>

      {%- comment -%} Thumbnail strip under the mobile swipe gallery (Figma node
          19:22082). only-mobile. Built from product.media in the SAME order as
          the slick slides (renderSlides iterates the media JSON 1:1), so a
          thumb's data-index maps to its slide; pdp-new.js wires tap ->
          slickGoTo and highlights the active thumb on afterChange. {%- endcomment -%}
      <div class="pdp-new__mobile-thumbs only-mobile" data-mobile-thumbs>
        {%- for media in product.media -%}
          {%- if media.preview_image -%}
            <button
              type="button"
              class="pdp-new__mobile-thumb{% if forloop.first %} is-active{% endif %}{% if media.media_type == 'video' or media.media_type == 'external_video' %} is-video{% endif %}"
              data-mobile-thumb
              data-index="{{ forloop.index0 }}"
              data-media-id="{{ media.id }}"
              aria-label="{{ media.alt | default: product.title | escape }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 144 }}"
                alt="{{ media.alt | escape }}"
                width="72"
                height="72"
                loading="lazy"
              >
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="pdp-new__mobile-thumb-play" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="12" fill="rgba(0,0,0,0.55)"/><path d="M10 8.5v7l6-3.5-6-3.5z" fill="#fff"/></svg>
                </span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
