{%- comment -%}
  Renders a "Table with images" pdp_table entry as a responsive row of
  image + linked-caption cells (e.g. the "confirm stations of each machine" row).

  Usage:
    {% render 'pdp-table-images', table: tbl, heading: 'To confirm stations of each machine:' %}

  Data model:
    table.table_headers.value      -> columns (iterate)
      col.content.value            -> cells (iterate)
        cell.image_if_any          -> MediaImage (render via image_url)
        cell.values                -> rich text: linked caption

  Metaobject reference lists support iteration only (no indexing), so we iterate.
  Images render with alt text derived from the caption text for accessibility.
{%- endcomment -%}

{%- liquid
  assign cols = table.table_headers.value
-%}

{%- if cols != blank -%}
  {%- if heading != blank -%}
    <h2 class="product__extra_info-title pdp-itable__heading">{{ heading }}</h2>
  {%- elsif table.section_header != blank -%}
    <h2 class="product__extra_info-title pdp-itable__heading">{{ table.section_header }}</h2>
  {%- endif -%}

  <div class="pdp-itable">
    {%- for col in cols -%}
      {%- for cell in col.content.value -%}
        {%- comment -%} Derive plain-text alt from the caption rich text. {%- endcomment -%}
        {%- capture caption_txt -%}{{ cell.values | metafield_tag | strip_html | strip }}{%- endcapture -%}
        <div class="pdp-itable__cell">
          {%- if cell.image_if_any != blank -%}
            <div class="pdp-itable__img">
              <img
                src="{{ cell.image_if_any | image_url: width: 600 }}"
                alt="{{ caption_txt | escape }}"
                loading="lazy"
                width="600">
            </div>
          {%- endif -%}
          <div class="pdp-itable__caption">{{ cell.values | metafield_tag }}</div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{%- stylesheet -%}
.pdp-itable__heading { margin: 24px 0 12px; }
.pdp-itable {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 0 0 24px;
  border: 1px solid #ddd;
  padding: 16px;
}
.pdp-itable__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.pdp-itable__img { width: 100%; }
.pdp-itable__img img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}
.pdp-itable__caption { margin-top: 10px; }
.pdp-itable__caption .metafield-rich_text_field p { margin: 0; }
.pdp-itable__caption a {
  color: var(--primary-orange-500, #D83D0E);
  text-decoration: underline;
  font-weight: 600;
}
@media (max-width: 749px) {
  .pdp-itable { grid-template-columns: 1fr; gap: 20px; }
}
{%- endstylesheet -%}
