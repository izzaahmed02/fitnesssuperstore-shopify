{%- comment -%}
  Renders a "Table with images" pdp_table entry as a responsive row of
  image + linked-caption cells (the "confirm stations of each machine" row).
{%- endcomment -%}

{%- liquid
  assign cols = table.table_headers.value
-%}

{%- if cols != blank -%}
  {%- if heading != blank -%}
    <h2 class="product__extra_info-title pdp-itable__heading">{{ heading }}</h2>
  {%- elsif table.section_header != blank -%}
    <h2 class="product__extra_info-title pdp-itable__heading">{{ table.section_header }}</h2>
  {%- endif -%}

  <div class="pdp-itable">
    {%- for col in cols -%}
      {%- for cell in col.content.value -%}
        {%- capture caption_txt -%}{{ cell.values | metafield_tag | strip_html | strip }}{%- endcapture -%}
        <div class="pdp-itable__cell">
          {%- if cell.image_if_any != blank -%}
            <div class="pdp-itable__img">
              <img
                src="{{ cell.image_if_any | image_url: width: 600 }}"
                alt="{{ caption_txt | escape }}"
                loading="lazy"
                width="600">
            </div>
          {%- endif -%}
          <div class="pdp-itable__caption">{{ cell.values | metafield_tag }}</div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{%- stylesheet -%}
.pdp-itable__heading { margin: 24px 0 12px; }
.pdp-itable {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 0 0 24px;
  border: 1px solid #ddd;
  padding: 16px;
}
.pdp-itable__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.pdp-itable__img { width: 100%; }
.pdp-itable__img img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}
.pdp-itable__caption { margin-top: 10px; }
.pdp-itable__caption .metafield-rich_text_field p { margin: 0; }
.pdp-itable__caption a {
  color: var(--primary-orange-500, #D83D0E);
  text-decoration: underline;
  font-weight: 600;
}
@media (max-width: 749px) {
  .pdp-itable { grid-template-columns: 1fr; gap: 20px; }
}

.pdp-ctable__heading { margin: 24px 0 8px; }
.pdp-ctable__intro { margin: 0 0 12px; }
.pdp-ctable__intro .metafield-rich_text_field p { margin: 0 0 8px; }
.pdp-ctable__scroll { width: 100%; }
.pdp-ctable {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  margin: 0 0 12px;
  font-size: 15px;
  line-height: 1.4;
  border: 1px solid #ddd;
}
.pdp-ctable th,
.pdp-ctable td {
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
}
.pdp-ctable thead th {
  text-align: left;
  font-weight: 700;
  padding: 10px 12px;
  border: 1px solid #ddd;
  background: #f7f7f7;
  vertical-align: top;
}
.pdp-ctable tbody th.pdp-ctable__label {
  text-align: left;
  font-weight: 700;
  padding: 10px 12px;
  border: 1px solid #ddd;
  background: #fafafa;
  vertical-align: top;
}
.pdp-ctable tbody td {
  padding: 10px 12px;
  border: 1px solid #ddd;
  vertical-align: top;
}
.pdp-ctable .metafield-rich_text_field p { margin: 0; }
.pdp-ctable a { color: var(--primary-orange-500, #D83D0E); text-decoration: underline; }
.pdp-ctable__disclaimer {
  margin: 0 0 24px;
  font-size: 12px;
  line-height: 1.5;
  color: #666;
}
.pdp-ctable__disclaimer .metafield-rich_text_field p { margin: 0; }
@media (max-width: 600px) {
  .pdp-ctable { font-size: 13px; }
  .pdp-ctable thead th, .pdp-ctable tbody th.pdp-ctable__label, .pdp-ctable tbody td { padding: 8px 6px; }
  .pdp-ctable__disclaimer { font-size: 11px; }
}
{%- endstylesheet -%}