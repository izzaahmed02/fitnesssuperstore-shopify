<script>
  window.Shopify = window.Shopify || {theme: {id: {{ theme.id }}, role: '{{ theme.role }}' } };
  window._template = {
    directory: "{{ template.directory }}",
    name: "{{ template.name }}",
    suffix: "{{ template.suffix }}"
  };
  window.pricingReferenceHtml = "{{ 'pricing-reference.html' | asset_url }}";
</script>


<script>
  (function() {
    var intelligemsLoaded = false;

    function loadIntelligems() {
      if (intelligemsLoaded) return;
      intelligemsLoaded = true;

      var script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://cdn.intelligems.io/esm/af0d62f8eb94/bundle.js';
      script.async = true;
      document.head.appendChild(script);
    }

    ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(evt) {
      window.addEventListener(evt, loadIntelligems, { once: true, passive: true });
    });

    window.addEventListener('load', function() {
      window.setTimeout(loadIntelligems, 1200);
    }, { once: true });
  })();
</script>
