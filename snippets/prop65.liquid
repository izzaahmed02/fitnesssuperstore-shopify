<style>
      .popover-container {
        position: relative;
        max-width: 470px;
        margin-top: 30px;
      }
      
      .popover-container .warning {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .popover-container p {
        font-family: 'Lato';
        font-weight: 700;
        font-size: 14px;
        display: flex;
        gap: 3px;
      }

      .prop65-trigger {
        color: #f1592a;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
        position: relative;
      }

      bubb-content {
        font-size: 14px;
      }
</style>
