{%- assign domain_origin = request.origin -%}
{%- assign seller_logo_url = settings.logo | image_url: width: 800 -%}
{%- assign fallback_logo_url = 'logo.png' | asset_url -%}
{%- capture search_target -%}{{ request.origin }}/search?q={search_term_string}{%- endcapture -%}

{%- comment -%}
  AI channel / merchant-listing data.

  product.type is an internal bucket ("Product Index") and must never be emitted as the
  schema category. Prefer the Shopify taxonomy category that Shopify Catalog syndicates to
  ChatGPT / Copilot / Gemini, then the merchandising metafields, then a generic fallback.
{%- endcomment -%}
{%- liquid
  assign schema_category = product.metafields.custom.main_category
  if product.metafields.custom.sub_category != blank
    assign schema_category = schema_category | append: ' > ' | append: product.metafields.custom.sub_category
  endif
  if schema_category == blank
    assign schema_category = 'Fitness Equipment'
  endif

  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

  assign condition_state = product.metafields.custom.condition_state | downcase
  if condition_state contains 'as is'
    assign schema_condition = 'UsedCondition'
  elsif condition_state contains 'remanufactured'
    assign schema_condition = 'RefurbishedCondition'
  elsif condition_state != blank
    assign schema_condition = product.metafields.custom.condition_state | append: 'Condition'
  else
    assign schema_condition = 'NewCondition'
  endif

  comment
    Returns differ by condition. Per the published Cancellations, Returns & Refunds Policy:
    remanufactured commercial equipment is not returnable once delivered (warranty service
    only); everything else is a 14-day, buyer-paid return with a 25% restocking fee.
  endcomment
  if schema_condition == 'RefurbishedCondition'
    assign return_days = 0
  else
    assign return_days = 14
  endif

  comment
    Handling time comes from the merchandising lead-time metafield. Only emit it when the
    value matches a pattern we can convert to days - never guess a delivery window.
  endcomment
  assign handling_min = false
  assign handling_max = false
  assign lead_time = product.metafields.custom.processing_time | default: '' | downcase
  assign lead_digits = lead_time | remove: 'ships in ' | split: ' ' | first | split: '-'
  if lead_time contains 'week'
    assign handling_min = lead_digits[0] | times: 7
    assign handling_max = lead_digits | last | times: 7
  elsif lead_time contains 'business day' or lead_time contains 'day'
    assign handling_min = lead_digits[0] | times: 1
    assign handling_max = lead_digits | last | times: 1
  endif
  if handling_min == 0 or handling_max == 0
    assign handling_min = false
    assign handling_max = false
  endif
-%}

{%- capture merchant_return_policy -%}
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "@id": {{ request.origin | append: '#return-policy-' | append: schema_condition | json }},
          "applicableCountry": "US",
          "returnPolicyCountry": "US",
          "merchantReturnLink": {{ request.origin | append: '/pages/return-policy' | json }},
          {%- if return_days > 0 %}
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": {{ return_days }},
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibleForShipping",
          "restockingFee": {
            "@type": "MonetaryAmount",
            "currency": {{ shop.currency | default: 'USD' | json }},
            "value": 25,
            "unitText": "PERCENT"
          }
          {%- else %}
          "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
          {%- endif %}
        }
{%- endcapture -%}

{%- capture shipping_details -%}
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "@id": {{ request.origin | append: product.url | append: '#shipping' | json }},
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "US"
          }
          {%- if product.metafields.custom.ships != blank %},
          "shippingSettingsLink": {{ request.origin | append: '/pages/shipping-information' | json }}
          {%- endif %}
          {%- if handling_min and handling_max %},
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": {{ handling_min }},
              "maxValue": {{ handling_max }},
              "unitCode": "DAY"
            }
          }
          {%- endif %}
        }
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": {{ request.origin | append: product.url | append: '#product' | json }},
      "@type": "Product",
      "brand": {
        "@type": "Brand",
        "@id": {{ request.origin | append: product.url | append: '#brand' | json }},
        "name": {{ product.vendor | default: shop.name | json }}
      },

      {% if product.metafields.reviews.rating.value.rating and product.metafields.reviews.rating_count.value %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "@id": {{ request.origin | append: product.url | append: '#aggregaterating' | json }},
        "name": {{ product.title | json }},
        "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
        "bestRating": 5,
        "worstRating": 1,
        "ratingCount": {{ product.metafields.reviews.rating_count.value | json }},
        "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
      },
      {% endif %}

      "audience": {{ product.metafields.custom.audience | default: 'Fitness enthusiasts and commercial gym users' | json }},
      "category": {{ schema_category | json }},
      "description": {{ product.description | strip_html | strip_newlines | strip | replace: '&amp;', '&' | truncate: 500 | default: 'High-quality fitness equipment for home or commercial use.' | json }},
      "image": [
        {% for image in product.images %}
          {%- assign product_image_url = image.src | img_url: 'master' | split: '?' | first -%}
          {% if product_image_url contains 'https://' or product_image_url contains 'http://' %}
            {{ product_image_url | json }}
          {% else %}
            {{ product_image_url | prepend: 'https:' | json }}
          {% endif %}{% unless forloop.last %},{% endunless %}
        {% else %}
          {%- assign placeholder_url = 'product-placeholder.jpg' | asset_url | split: '?' | first -%}
          {% if placeholder_url contains 'https://' or placeholder_url contains 'http://' %}
            {{ placeholder_url | json }}
          {% else %}
            {{ placeholder_url | prepend: 'https:' | json }}
          {% endif %}
        {% endfor %}
      ],
      "name": {{ product.title | json }},
      "color": {{ product.metafields.custom.product_color | default: 'Not specified' | json }},
      "countryOfAssembly": {{ product.metafields.custom.country_of_assembly | default: 'US' | json }},
      "countryOfLastProcessing": {{ product.metafields.custom.country_of_last_processing | default: 'US' | json }},
      {% if product.metafields.custom.length_in != blank %}
      "depth": {
        "@type": "QuantitativeValue",
        "value": {{ product.metafields.custom.length_in | json }},
        "unitCode": "INH"
      },
      {% endif %}
      {% if product.metafields.custom.width_in != blank %}
      "width": {
        "@type": "QuantitativeValue",
        "value": {{ product.metafields.custom.width_in | json }},
        "unitCode": "INH"
      },
      {% endif %}
      {% if product.metafields.custom.height_in != blank %}
      "height": {
        "@type": "QuantitativeValue",
        "value": {{ product.metafields.custom.height_in | json }},
        "unitCode": "INH"
      },
      {% endif %}
      "keywords": [
        {%- assign keyword_list = product.metafields.custom.keywords.value -%}
        {%- if keyword_list != blank -%}
          {%- for keyword in keyword_list -%}
            {{ keyword | strip | replace: '&amp;', '&' | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- elsif product.tags.size > 0 -%}
          {%- for tag in product.tags -%}
            {{ tag | strip | replace: '&amp;', '&' | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- else -%}
          {%- assign words = product.title | split: ' ' -%}
          {%- for word in words -%}
            {{ word | strip | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ],
      "manufacturer": {
        "@type": "Organization",
        "@id": {{ request.origin | append: product.url | append: '#manufacturer' | json }},
        "name": {{ product.vendor | default: shop.name | json }}
      },
      {% if product.metafields.custom.product_weight_lbs != blank %}
      "weight": {
        "@type": "QuantitativeValue",
        "value": {{ product.metafields.custom.product_weight_lbs | json }},
        "unitCode": "LBR"
      },
      {% endif %}
      "mpn": {{ product.metafields.custom.mpn | default: product.selected_or_first_available_variant.sku | default: product.handle | json }},
      {% if product.selected_or_first_available_variant.barcode != blank %}
      "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
      {% elsif product.metafields.custom.upc_code != blank %}
      "gtin": {{ product.metafields.custom.upc_code | json }},
      {% endif %}
      "itemCondition": "https://schema.org/{{ schema_condition }}",

      {%- comment -%}
        The facts AI shopping agents ask for: who the machine is built for, how it ships,
        how long it takes, and what the warranty is. Sourced from merchandising metafields
        so the answer AI gives matches the PDP.
      {%- endcomment -%}
      "additionalProperty": [
        {%- capture ai_facts -%}
          {%- if product.metafields.custom.grade != blank -%}Equipment Grade|{{ product.metafields.custom.grade | strip }}~{%- endif -%}
          {%- if product.metafields.custom.condition_state != blank -%}Condition|{{ product.metafields.custom.condition_state | strip }}~{%- endif -%}
          {%- if product.metafields.custom.ships != blank -%}Shipping Method|{{ product.metafields.custom.ships | strip }}~{%- endif -%}
          {%- if product.metafields.custom.processing_time != blank -%}Lead Time|{{ product.metafields.custom.processing_time | strip }}~{%- endif -%}
          {%- if product.metafields.custom.warranty != blank -%}Warranty|{{ product.metafields.custom.warranty | strip }}~{%- endif -%}
        {%- endcapture -%}
        {%- assign ai_fact_list = ai_facts | split: '~' -%}
        {%- for fact in ai_fact_list -%}
          {%- assign fact_parts = fact | split: '|' -%}
          {
            "@type": "PropertyValue",
            "name": {{ fact_parts[0] | strip | json }},
            "value": {{ fact_parts[1] | strip | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],

      {% if product.has_only_default_variant %}
      "offers": {
        "@id": {{ request.origin | append: product.url | append: '?variant=' | append: product.selected_or_first_available_variant.id | append: '#offer' | json }},
        "@type": "Offer",
        "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/{{ schema_condition }}",
        "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ shop.currency | default: 'USD' | json }},
        "priceValidUntil": {{ price_valid_until | json }},
        {% if product.selected_or_first_available_variant.barcode != blank %}
        "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
        {% endif %}
{{ merchant_return_policy }},
{{ shipping_details }},

        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
        "priceSpecification": [
          {
            "@type": "UnitPriceSpecification",
            "priceType": "https://schema.org/ListPrice",
            "price": {{ product.selected_or_first_available_variant.compare_at_price | divided_by: 100.0 | json }},
            "priceCurrency": {{ shop.currency | default: 'USD' | json }}
          },
          {
            "@type": "UnitPriceSpecification",
            "priceType": "https://schema.org/SalePrice",
            "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ shop.currency | default: 'USD' | json }}
          }
        ],
        {% endif %}

        "url": {{ request.origin | append: product.url | append: '?variant=' | append: product.selected_or_first_available_variant.id | json }},
        "offeredBy": {
          "@type": "Organization",
          "@id": {{ request.origin | append: '#seller' | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          "logo": {% if seller_logo_url contains 'https://' or seller_logo_url contains 'http://' %}{{ seller_logo_url | json }}{% elsif seller_logo_url != blank %}{{ seller_logo_url | prepend: 'https:' | json }}{% elsif fallback_logo_url contains 'https://' or fallback_logo_url contains 'http://' %}{{ fallback_logo_url | json }}{% else %}{{ fallback_logo_url | prepend: 'https:' | json }}{% endif %},
          "description": {{ shop.description | default: 'Premium fitness equipment at competitive prices.' | strip_html | strip_newlines | strip | replace: '&amp;', '&' | json }},
          "founder": "Timothy French",
          "foundingDate": "2010",
          "sameAs": [
            {% if shop.metafields.custom.social_media %}
              {% for link in shop.metafields.custom.social_media %}
                {{ link | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            {% else %}
              "https://www.facebook.com/FitnessSuperstore",
              "https://x.com/fitsuperstore",
              "https://www.instagram.com/fitness.superstore/"
            {% endif %}
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": {{ shop.phone | default: '925-215-2927' | json }},
            "contactType": "Customer Service",
            "areaServed": {{ shop.metafields.custom.area_served | default: 'US' | json }},
            "availableLanguage": [{{ shop.metafields.custom.language | default: 'English' | json }}]
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ shop.address.street | default: '537 Stone Rd. STE F' | json }},
            "addressLocality": {{ shop.address.city | default: 'Benicia' | json }},
            "addressRegion": {{ shop.address.province_code | default: 'CA' | json }},
            "postalCode": {{ shop.address.zip | default: '94510' | json }},
            "addressCountry": {{ shop.address.country | default: 'US' | json }}
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ search_target | json }},
            "query-input": "required name=search_term_string"
          }
        }
      },
      {% else %}
      "offers": [
        {% for variant in product.variants %}
          {
            "@type": "Offer",
            "@id": {{ request.origin | append: product.url | append: '?variant=' | append: variant.id | append: '#offer' | json }},
            "name": {% if variant.title == 'Default Title' %}{{ product.title | json }}{% else %}{{ product.title | append: ' - ' | append: variant.title | json }}{% endif %},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ shop.currency | default: 'USD' | json }},
            "priceValidUntil": {{ price_valid_until | json }},

            {% if variant.compare_at_price > variant.price %}
            "priceSpecification": [
              {
                "@type": "UnitPriceSpecification",
                "priceType": "https://schema.org/ListPrice",
                "price": {{ variant.compare_at_price | divided_by: 100.0 | json }},
                "priceCurrency": {{ shop.currency | default: 'USD' | json }}
              },
              {
                "@type": "UnitPriceSpecification",
                "priceType": "https://schema.org/SalePrice",
                "price": {{ variant.price | divided_by: 100.0 | json }},
                "priceCurrency": {{ shop.currency | default: 'USD' | json }}
              }
            ],
            {% endif %}

            "url": {{ request.origin | append: product.url | append: '?variant=' | append: variant.id | json }},
            "sku": {{ variant.sku | default: product.handle | json }},
            {% if variant.barcode != blank %}
            "gtin": {{ variant.barcode | json }},
            {% endif %}
            "itemCondition": "https://schema.org/{{ schema_condition }}",
{{ merchant_return_policy }},
{{ shipping_details }},
            "offeredBy": {
              "@type": "Organization",
              "@id": {{ request.origin | append: '#seller' | json }},
              "name": {{ shop.name | json }},
              "url": {{ request.origin | json }},
              "logo": {% if seller_logo_url contains 'https://' or seller_logo_url contains 'http://' %}{{ seller_logo_url | json }}{% elsif seller_logo_url != blank %}{{ seller_logo_url | prepend: 'https:' | json }}{% elsif fallback_logo_url contains 'https://' or fallback_logo_url contains 'http://' %}{{ fallback_logo_url | json }}{% else %}{{ fallback_logo_url | prepend: 'https:' | json }}{% endif %},
              "description": {{ shop.description | default: 'Premium fitness equipment at competitive prices.' | strip_html | strip_newlines | strip | replace: '&amp;', '&' | json }},
              "founder": "Timothy French",
              "foundingDate": "2010",
              "sameAs": [
                {% if shop.metafields.custom.social_media %}
                  {% for link in shop.metafields.custom.social_media %}
                    {{ link | json }}{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                {% else %}
                  "https://www.facebook.com/FitnessSuperstore",
                  "https://x.com/fitsuperstore",
                  "https://www.instagram.com/fitness.superstore/"
                {% endif %}
              ],
              "contactPoint": {
                "@type": "ContactPoint",
                "telephone": {{ shop.phone | default: '925-215-2927' | json }},
                "contactType": "Customer Service",
                "areaServed": {{ shop.metafields.custom.area_served | default: 'US' | json }},
                "availableLanguage": [{{ shop.metafields.custom.language | default: 'English' | json }}]
              },
              "address": {
                "@type": "PostalAddress",
                "streetAddress": {{ shop.address.street | default: '537 Stone Rd. STE F' | json }},
                "addressLocality": {{ shop.address.city | default: 'Benicia' | json }},
                "addressRegion": {{ shop.address.province_code | default: 'CA' | json }},
                "postalCode": {{ shop.address.zip | default: '94510' | json }},
                "addressCountry": {{ shop.address.country | default: 'US' | json }}
              },
              "potentialAction": {
                "@type": "SearchAction",
                "target": {{ search_target | json }},
                "query-input": "required name=search_term_string"
              }
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      {% endif %}

      "sku": {{ product.selected_or_first_available_variant.sku | default: product.handle | json }},
      "url": {{ request.origin | append: product.url | json }}

      {% if product.metafields.custom.seo_videos %}
      ,
      "subjectOf": [
        {% for video in product.metafields.custom.seo_videos.value %}
          {%- liquid
            assign video_title = video.title.value | default: video.title | default: product.title | default: shop.name

            assign video_description = video.description.value | default: video.description | default: product.description | default: shop.description
            assign video_description = video_description | strip_html | strip_newlines | strip | replace: '&amp;', '&' | truncate: 500

            if video_description == blank
              assign video_description = 'Video for ' | append: product.title
            endif

            assign video_thumbnail = video.thumbnail_url.value | default: video.thumbnail_url

            if video_thumbnail == blank and product.featured_image
              assign video_thumbnail = product.featured_image.src | img_url: 'master' | split: '?' | first
            endif

            if video_thumbnail == blank
              assign video_thumbnail = 'product-placeholder.jpg' | asset_url | split: '?' | first
            endif

            assign video_upload_date = video.upload_date.value | default: video.upload_date | default: product.published_at | default: product.created_at | default: '2026-01-01T00:00:00Z'

            assign video_duration_seconds = video.duration_seconds.value | default: video.duration_seconds

            assign video_content_url = video.content_url.value | default: video.content_url
            assign video_embed_url = video.embed_url.value | default: video.embed_url | default: video.video_url.value | default: video.video_url

            assign publisher_logo_url = settings.logo | image_url: width: 800
          -%}
          {
            "@type": "VideoObject",
            "@id": {{ request.origin | append: product.url | append: '#video-' | append: forloop.index | json }},
            "name": {{ video_title | strip | json }},
            "description": {{ video_description | json }},
            "thumbnailUrl": [
              {% if video_thumbnail contains 'https://' or video_thumbnail contains 'http://' %}
                {{ video_thumbnail | json }}
              {% else %}
                {{ video_thumbnail | prepend: 'https:' | json }}
              {% endif %}
            ],
            "uploadDate": {{ video_upload_date | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
            {% if video_duration_seconds != blank %}
            "duration": {{ 'PT' | append: video_duration_seconds | append: 'S' | json }},
            {% endif %}
            {% if video_content_url != blank %}
            "contentUrl": {% if video_content_url contains 'https://' or video_content_url contains 'http://' %}{{ video_content_url | json }}{% else %}{{ video_content_url | prepend: 'https:' | json }}{% endif %},
            {% endif %}
            {% if video_embed_url != blank %}
            "embedUrl": {% if video_embed_url contains 'https://' or video_embed_url contains 'http://' %}{{ video_embed_url | json }}{% else %}{{ video_embed_url | prepend: 'https:' | json }}{% endif %},
            {% endif %}
            "publisher": {
              "@type": "Organization",
              "name": {{ shop.name | json }},
              "logo": {
                "@type": "ImageObject",
                "url": {% if publisher_logo_url contains 'https://' or publisher_logo_url contains 'http://' %}{{ publisher_logo_url | json }}{% elsif publisher_logo_url != blank %}{{ publisher_logo_url | prepend: 'https:' | json }}{% elsif fallback_logo_url contains 'https://' or fallback_logo_url contains 'http://' %}{{ fallback_logo_url | json }}{% else %}{{ fallback_logo_url | prepend: 'https:' | json }}{% endif %}
              }
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
      {% endif %}
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ request.origin | append: '/' | json }}
        }

        {%- assign position = 2 -%}
        {%- assign all_breadcrumb_objects = product.metafields.custom.breadcrumb_paths.value | sort: "priority" -%}
        {%- assign active_path = nil -%}
        {%- assign source_flag = "unset" -%}

        {%- if collection -%}
          {%- for b_path in all_breadcrumb_objects -%}
            {%- assign b_steps = b_path.steps.value -%}
            {%- assign latest_step = b_steps.last -%}
            {%- if latest_step and latest_step.handle == collection.handle -%}
              {%- assign active_path = b_path -%}
              {%- assign source_flag = "metaobject" -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if active_path == nil -%}
          {%- for fallback_path in all_breadcrumb_objects -%}
            {%- if fallback_path.steps and fallback_path.steps.value != blank -%}
              {%- assign active_path = fallback_path -%}
              {%- assign source_flag = "metaobject" -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if source_flag == "unset" and product.collections.first -%}
          {%- assign default_coll = product.collections.first -%}
          {%- assign source_flag = "default" -%}
        {%- endif -%}

        {%- if source_flag == "metaobject" -%}
          {%- assign nav_steps = active_path.steps.value -%}
          {%- assign nav_titles = active_path.custom_titles.value -%}
          {%- for nav_coll in nav_steps -%}
            {%- if nav_coll.handle != blank -%}
              ,
              {
                "@type": "ListItem",
                "position": {{ position }},
                "name": {{ nav_titles[forloop.index0] | default: nav_coll.title | json }},
                "item": {{ request.origin | append: '/collections/' | append: nav_coll.handle | json }}
              }
              {%- assign position = position | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

        {%- elsif source_flag == "default" -%}
          ,
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ default_coll.title | json }},
            "item": {{ request.origin | append: '/collections/' | append: default_coll.handle | json }}
          }
          {%- assign position = position | plus: 1 -%}
        {%- endif -%}

        ,
        {
          "@type": "ListItem",
          "position": {{ position }},
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
      ]
    }
  ]
}
</script>