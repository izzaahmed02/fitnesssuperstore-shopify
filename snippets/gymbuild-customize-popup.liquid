</style>

<script>
  (function () {
    var modal = document.getElementById('GymBuildCustomizeModal-{{ section.id }}');
    if (!modal) return;

    /* ------------------------------------------------------------------
       Mobile "Show Other Room Sizes" disclosure (Figma 3694:76997).
       The collapse itself is CSS and only applies under 750px, so this
       handler just flips the state; on desktop the toggle is
       display:none and never reachable. Labels swap between "Show" and
       "Hide" to match the chevron direction.
       ------------------------------------------------------------------ */
    var sizesWrap = modal.querySelector('[data-gymbuild-sizes]');
    var sizesToggle = modal.querySelector('[data-gymbuild-sizes-toggle]');

    if (sizesWrap && sizesToggle) {
      sizesToggle.addEventListener('click', function () {
        var expanded = sizesWrap.classList.toggle('is-expanded');
        sizesToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');

        var label = sizesToggle.querySelector('[data-gymbuild-sizes-toggle-label]');
        if (label) {
          label.textContent = expanded ? 'Hide Other Room Sizes' : 'Show Other Room Sizes';
        }
      });
    }

    var sizeRadios = modal.querySelectorAll('input[name="GymBuildCustomizeSize-{{ section.id }}"]');
    sizeRadios.forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (radio.checked && radio.dataset.variantUrl) {
          window.location.href = radio.dataset.variantUrl;
        }
      });
    });

    var tabs = Array.from(modal.querySelectorAll('[data-tab]'));
    var panels = Array.from(modal.querySelectorAll('[data-panel]'));

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          var isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach(function (panel) {
          var isActive = panel.dataset.panel === tab.dataset.tab;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });
      });
    });

    // "Swap to:" sub-view — same drawer, no new modal. See snippet's top
    // comment (Figma node 4544:92078) for the visual-only/TEMPORARY-data
    // caveats around this.
    var content = modal.querySelector('.gymbuild-customize-drawer__content');
    var footer = modal.querySelector('.gymbuild-customize-drawer__footer');
    var subtotalEl = modal.querySelector('[data-gymbuild-subtotal]');
    var swapCurrentEl = modal.querySelector('[data-gymbuild-swap-current]');
    var swapGridEl = modal.querySelector('[data-gymbuild-swap-grid]');
    var backBtn = modal.querySelector('[data-gymbuild-back]');
    var basePriceCents = footer ? parseInt(footer.dataset.basePrice, 10) || 0 : 0;
    var activeCard = null;

    function formatMoney(cents) {
      return '$' + (cents / 100).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    // A zero delta is a real, common outcome, not an absence of data: whole
    // categories are priced flat, so every alternative costs exactly what the
    // default costs (all seven Selectorized (Pin Loaded) items on the 1,000 and
    // 1,500 sq ft packages are like this). Returning '' left those swap cards
    // with no price line at all, which reads as broken rather than as
    // "swapping this changes nothing". Say so explicitly instead.
    function formatDelta(deltaCents) {
      if (deltaCents === 0) return 'No price change';
      var sign = deltaCents > 0 ? '+ ' : '- ';
      return sign + formatMoney(Math.abs(deltaCents));
    }

    // The subtotal is recomputed from the DOM on every change instead of
    // being kept as a running counter. The add-ons carousel sits outside
    // this drawer and can be toggled while the drawer is closed, so an
    // incremental total would drift out of sync with it. This reads the
    // same two sources the quote-review popup reads, so both surfaces
    // always agree.
    function selectedAddOnsTotalCents() {
      var total = 0;
      document
        .querySelectorAll('product-add-ons-quote [data-addon-state="selected"]')
        .forEach(function (btn) {
          total += parseInt(btn.dataset.addonPriceCents, 10) || 0;
        });
      return total;
    }

    function formatCount(qty) {
      return qty + (qty === 1 ? ' item' : ' items');
    }

    // Quantity is read on BOTH sides of the subtraction, not once: a
    // gymbuild_option carries its own quantity, so an alternative may ship a
    // different count than the default it replaces. Multiplying a per-unit
    // price delta by a single qty would silently misprice those swaps.
    function swapDeltaTotalCents() {
      var total = 0;
      modal.querySelectorAll('[data-gymbuild-item]').forEach(function (card) {
        var currentPrice = parseInt(card.dataset.itemPrice, 10) || 0;
        var currentQty = parseInt(card.dataset.itemQty, 10) || 1;
        var originalPrice = parseInt(card.dataset.originalPrice, 10) || 0;
        var originalQty = parseInt(card.dataset.originalQty, 10) || 1;
        total += (currentPrice * currentQty) - (originalPrice * originalQty);
      });
      return total;
    }

    function recalcSubtotal() {
      if (!subtotalEl) return;
      subtotalEl.textContent = formatMoney(
        basePriceCents + swapDeltaTotalCents() + selectedAddOnsTotalCents()
      );
    }

    function showMainView() {
      content.classList.remove('is-swap-view');
      activeCard = null;
    }

    function showSwapView(card) {
      var pool;
      try {
        pool = JSON.parse(card.dataset.itemPool || '[]');
      } catch (e) {
        pool = [];
      }

      var currentId = card.dataset.itemId;
      var currentPriceCents = parseInt(card.dataset.itemPrice, 10) || 0;
      var currentQty = parseInt(card.dataset.itemQty, 10) || 1;
      var currentLineCents = currentPriceCents * currentQty;
      var alternates = pool.filter(function (p) {
        return String(p.id) !== String(currentId);
      });

      if (!alternates.length) return;

      activeCard = card;

      if (swapCurrentEl) {
        swapCurrentEl.innerHTML =
          '<img class="gymbuild-customize-drawer__swap-current-image" src="' + card.dataset.itemImage + '" alt="" loading="lazy">' +
          '<div class="gymbuild-customize-drawer__swap-current-info">' +
          '<p class="gymbuild-customize-drawer__swap-current-title">' + card.dataset.itemTitle + '</p>' +
          '<p class="gymbuild-customize-drawer__swap-current-count">' + formatCount(currentQty) + '</p>' +
          '</div>';
      }

      if (swapGridEl) {
        swapGridEl.innerHTML = '';
        alternates.forEach(function (alt) {
          var altQty = parseInt(alt.qty, 10) || 1;
          // Line-level, not per-unit: the alternative's own quantity may differ
          // from the current one, so compare (price x qty) on each side.
          var deltaCents = (alt.price * altQty) - currentLineCents;
          var deltaClass = deltaCents > 0 ? 'is-increase' : (deltaCents < 0 ? 'is-decrease' : 'is-neutral');

          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gymbuild-customize-drawer__swap-card';
          btn.dataset.altId = alt.id;
          btn.dataset.altTitle = alt.title;
          btn.dataset.altImage = alt.image;
          btn.dataset.altPrice = alt.price;
          btn.innerHTML =
            '<div class="gymbuild-customize-drawer__swap-card-image-wrap">' +
            '<img class="gymbuild-customize-drawer__swap-card-image" src="' + alt.image + '" alt="" loading="lazy">' +
            '</div>' +
            '<p class="gymbuild-customize-drawer__swap-card-title">' + alt.title + '</p>' +
            '<p class="gymbuild-customize-drawer__swap-card-count">' + formatCount(altQty) + '</p>' +
            '<p class="gymbuild-customize-drawer__swap-card-delta ' + deltaClass + '">' + formatDelta(deltaCents) + '</p>';

          btn.addEventListener('click', function () {
            selectAlternate(alt);
          });

          swapGridEl.appendChild(btn);
        });
      }

      content.classList.add('is-swap-view');
    }

    function selectAlternate(alt) {
      if (!activeCard) return;

      var image = activeCard.querySelector('.gymbuild-customize-drawer__card-image');
      var title = activeCard.querySelector('.gymbuild-customize-drawer__card-title');
      var count = activeCard.querySelector('[data-gymbuild-item-count]');
      var altQty = parseInt(alt.qty, 10) || 1;

      if (image) {
        // image_tag renders a srcset/sizes pair, and the browser prefers those
        // over src — swapping src alone would leave the previous product's
        // image on screen. Drop both so the new src is what actually loads.
        image.removeAttribute('srcset');
        image.removeAttribute('sizes');
        image.setAttribute('src', alt.image);
      }
      if (title) title.textContent = alt.title;
      if (count) count.textContent = formatCount(altQty);

      activeCard.dataset.itemId = alt.id;
      activeCard.dataset.itemProductId = alt.product_id;
      activeCard.dataset.itemSku = alt.sku || '';
      activeCard.dataset.itemTitle = alt.title;
      activeCard.dataset.itemImage = alt.image;
      activeCard.dataset.itemPrice = alt.price;
      activeCard.dataset.itemQty = altQty;
      activeCard.dataset.itemWeight = alt.weight;

      recalcSubtotal();

      showMainView();
    }

    modal.querySelectorAll('[data-gymbuild-swap-btn]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var card = btn.closest('[data-gymbuild-item]');
        if (card) showSwapView(card);
      });
    });

    if (backBtn) {
      backBtn.addEventListener('click', showMainView);
    }

    // Add-ons are toggled out on the PDP, behind this drawer's overlay, so
    // refresh the footer whenever the drawer is about to be opened.
    // Delegated on document for the same reason the quote-review popup's
    // trigger listener is: the opener may be parsed after this script runs.
    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-modal="#GymBuildCustomizeModal-{{ section.id }}"]')) {
        recalcSubtotal();
      }
    });

    recalcSubtotal();
  })();
</script>
