  }

  .gymbuild-customize-drawer__swap-card-delta.is-decrease {
    color: #12693a;
  }

  /* Zero delta — informational, so it reads as a statement about the swap
     rather than as a price. Muted and not bold, unlike +/- amounts. */
  .gymbuild-customize-drawer__swap-card-delta.is-neutral {
    color: #808080;
    font-weight: 400;
