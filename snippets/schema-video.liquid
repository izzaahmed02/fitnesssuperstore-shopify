{% comment %}
  Usage: {% render 'schema-video', videos: article.metafields.custom.seo_videos.value %}
         {% render 'schema-video', videos: page.metafields.custom.seo_videos.value %}
{% endcomment %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {% for video in videos %}
    {
      "@type": "VideoObject",
      "name": "{{ video.title | escape }}",
      "description": "{{ video.description | escape }}",
      "thumbnailUrl": "{{ video.thumbnail_url | escape }}",
      "duration": "PT{{ video.duration_seconds | escape }}S",
      "contentUrl": "{{ video.video_url | escape }}",
      "embedUrl": "{{ video.video_url | escape }}",
      "uploadDate": "{{ video.upload_date | date: '%Y-%m-%d' }}",
      "publisher": {
        "@type": "Organization",
        "name": "{{ shop.name | escape }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ 'Logo_Main_Dark_Background.svg' | asset_url | escape }}"
        }
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>