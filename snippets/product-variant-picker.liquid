{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {%- liquid
    assign variant_help_list = product.metafields.custom.variant_help.value
  -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        assign variant_help_key = option.name | handleize
        assign matched_variant_help = null
        if variant_help_list != blank
          for entry in variant_help_list
            if entry.title == option.name
              assign matched_variant_help = entry
              break
            endif
          endfor
        endif
      -%}
      {%- capture variant_help_icon -%}
        {%- if matched_variant_help -%}
          <svg
            class="button--popup variant-help-icon"
            data-variant-help-open="{{ variant_help_key }}"
            role="button"
            tabindex="0"
            aria-label="More information about {{ option.name | escape }}"
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9 2.125C5.20304 2.125 2.125 5.20304 2.125 9C2.125 12.797 5.20304 15.875 9 15.875C12.797 15.875 15.875 12.797 15.875 9C15.875 5.20305 12.797 2.125 9 2.125ZM0.874999 9C0.874999 4.51269 4.51269 0.875001 9 0.875001C13.4873 0.875002 17.125 4.51269 17.125 9C17.125 13.4873 13.4873 17.125 9 17.125C4.51268 17.125 0.874998 13.4873 0.874999 9ZM9.83333 12.3333C9.83333 12.7936 9.46024 13.1667 9 13.1667C8.53976 13.1667 8.16667 12.7936 8.16667 12.3333C8.16667 11.8731 8.53976 11.5 9 11.5C9.46024 11.5 9.83333 11.8731 9.83333 12.3333ZM7.93333 7.33334C7.93333 6.74423 8.4109 6.26667 9 6.26667C9.5891 6.26667 10.0667 6.74423 10.0667 7.33334L10.0667 7.43444C10.0667 7.74415 9.94364 8.04117 9.72464 8.26017L8.57574 9.40907C8.34142 9.64339 8.34142 10.0233 8.57574 10.2576C8.81005 10.4919 9.18995 10.4919 9.42427 10.2576L10.5732 9.1087C11.0172 8.66466 11.2667 8.06241 11.2667 7.43444L11.2667 7.33334C11.2667 6.08149 10.2518 5.06667 9 5.06667C7.74816 5.06667 6.73333 6.08149 6.73333 7.33333L6.73333 7.75C6.73333 8.08137 7.00196 8.35 7.33333 8.35C7.6647 8.35 7.93333 8.08137 7.93333 7.75L7.93333 7.33334Z" fill="#D83D0E"></path>
          </svg>
        {%- endif -%}
      {%- endcapture -%}
      {%- if option.values.size == 1 -%}
        {%- comment -%}
          Single-choice option: render as inline "Label: Value" per Tim's
          May 13 direction. The <select> stays in the DOM (visually hidden)
          so variant-selects JS and form submission continue to receive
          options[Name] with the sole value — cart line-item properties
          pass through unchanged.
        {%- endcomment -%}
        <div class="product-form__input product-form__input--single-value" data-variant-options>
          <p class="product-form__inline-option">
            <span class="form__label">{{ option.name }}:</span>
            <span class="product-form__inline-option__value">{{- option.selected_value -}}</span>
            {{ variant_help_icon }}
          </p>
          <select
            class="visually-hidden"
            id="Option-{{ section.id }}-{{ forloop.index0 }}"
            name="options[{{ option.name | escape }}]"
            form="{{ product_form_id }}"
            aria-hidden="true"
            tabindex="-1"
          >
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: 'dropdown'
            %}
          </select>
        </div>
      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch" data-variant-options>
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
            {{ variant_help_icon }}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill" data-variant-options>
          <legend class="form__label">
            {{ option.name }}:
            {{ variant_help_icon }}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}:
            {{ variant_help_icon }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            {% render 'icon-caret' %}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>{{ product.selected_or_first_available_variant | json }}</script>
  </variant-selects>

  {%- for option in product.options_with_values -%}
    {%- liquid
      assign variant_help_key = option.name | handleize
      assign matched_variant_help = null
      if variant_help_list != blank
        for entry in variant_help_list
          if entry.title == option.name
            assign matched_variant_help = entry
            break
          endif
        endfor
      endif
    -%}
    {%- if matched_variant_help -%}
      <template data-variant-help-template="{{ variant_help_key }}">
        {%- if matched_variant_help.title != blank -%}
          <h3 class="variant-help-modal-title">{{ matched_variant_help.title }}</h3>
        {%- endif -%}
        {%- if matched_variant_help.help_text != blank -%}
          <div class="variant-help-modal-body">{{ matched_variant_help.help_text | newline_to_br }}</div>
        {%- endif -%}
      </template>
    {%- endif -%}
  {%- endfor -%}

  <style>
    .variant-help-icon { cursor: pointer; vertical-align: middle; margin-left: 6px; flex-shrink: 0; }
    .variant-help-modal-title { margin: 0 0 12px; padding-right: 32px; }
    .variant-help-modal-body { line-height: 1.5; }
  </style>

  <script>
    (function () {
      if (window.__variantHelpModalBound) return;
      window.__variantHelpModalBound = true;
      document.addEventListener('click', function (event) {
        var btn = event.target.closest && event.target.closest('[data-variant-help-open]');
        if (!btn) return;
        event.preventDefault();
        event.stopPropagation();
        var key = btn.getAttribute('data-variant-help-open');
        var tpl = document.querySelector('template[data-variant-help-template="' + key + '"]');
        var modal = document.querySelector('.modal-wrapper');
        var container = document.getElementById('dynamic-product-content');
        if (!tpl || !modal || !container) return;
        var closeTpl = document.getElementById('icon-close-template');
        var closeHtml = closeTpl ? closeTpl.innerHTML : '×';
        container.style.width = 'auto';
        container.innerHTML = tpl.innerHTML + '<span class="modal-close">' + closeHtml + '</span>';
        modal.style.display = 'flex';
        var closer = container.querySelector('.modal-close');
        if (closer) {
          closer.addEventListener('click', function (ev) {
            ev.stopPropagation();
            modal.style.display = 'none';
            container.innerHTML = '';
          });
        }
      });
    })();
  </script>
{%- endunless -%}
