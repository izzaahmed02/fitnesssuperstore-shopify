{%- comment -%}
  Cable Attachments bundle selector (NON-Avis) — data-driven.

  The set list is sourced entirely from the product metafield
  `custom.cable_attachment_sets` (a list of `cable_attachment_bundle`
  metaobjects). Each metaobject provides:
    - set_key           : stable id (A/B/C)
    - bundle_product     : the backend bundle product (price/image/variant/reviews)
    - badge              : optional card badge ("Best Value")
    - included_products  : the individual attachments shown in the popup

  Nothing about the sets (variant ids, prices, images, SKUs, handles) is
  hardcoded here — it all comes from the metaobjects, so the list is editable
  in Shopify admin. The visible design is the dev-usman-11-jan port
  (bundle-selector.css / bundle-selector.js) wrapped in the native
  product-options contract so selection flows to cart without Avis.

  Component gate (fail closed)
  ----------------------------
  A set is an all-or-nothing kit: the customer pays one bundle price and expects
  every piece. A set is therefore only offered when the bundle product itself is
  available AND every one of its included_products is available. If any single
  component is unavailable the whole set is dropped - no card, no radio, and no
  entry in the JSON config - so it cannot be selected, priced, or added to cart
  from this page. A set that lists no components at all is treated the same way,
  since an empty kit cannot be verified.

  This is deliberately generic rather than keyed to a specific SKU: the gate
  follows live inventory, so a set closes the moment a component goes
  unavailable and reopens on restock with no code change. It is the page-level
  half of the guarantee only - the matching variant-level containment in Shopify
  is what closes the direct-URL, hidden-parent, app and cart-transform paths.

  Params: product (required), section (required)
{%- endcomment -%}

{%- liquid
  assign sets = product.metafields.custom.cable_attachment_sets.value

  assign orderable_keys = '|'
  assign orderable_count = 0
  assign blocked_keys = ''

  for set in sets
    assign bundle = set.bundle_product.value
    assign components = set.included_products.value
    assign set_orderable = false

    if bundle != blank and bundle.available and components != blank and components.size > 0
      assign set_orderable = true
      for component in components
        unless component.available
          assign set_orderable = false
        endunless
      endfor
    endif

    if set_orderable
      assign orderable_keys = orderable_keys | append: set.set_key.value | append: '|'
      assign orderable_count = orderable_count | plus: 1
    else
      assign blocked_keys = blocked_keys | append: set.set_key.value | append: ' '
    endif
  endfor

  assign blocked_keys = blocked_keys | strip | split: ' ' | join: ','
-%}

{%- comment -%}
  orderable_count is the gate on the whole block: if every set is closed there is
  nothing valid left to offer, so the selector is not rendered at all and the
  page falls back to the plain trainer purchase.
{%- endcomment -%}
{%- if sets != blank and orderable_count > 0 -%}
  {{ 'bundle-selector.css' | asset_url | stylesheet_tag }}
  {{ 'slick.min.css' | asset_url | stylesheet_tag }}
  {{ 'slick-theme.min.css' | asset_url | stylesheet_tag }}

  <div
    id="Product-Options-cable-{{ section.id }}"
    class="cable-bundle"
    {%- comment -%} Surfaced for QA/proof: which sets the component gate closed on this render. {%- endcomment -%}
    data-cable-blocked-sets="{{ blocked_keys }}"
  >
    <div
      class="cable-bundle__group"
      data-option-accordion
      data-type="cable-attachments"
      data-cable-bundle
    >
      {%- comment -%} Native contract holder + hidden radios (from the metaobjects). {%- endcomment -%}
      <span class="visually-hidden" data-selected-options=""></span>
      {%- for set in sets -%}
        {%- assign set_token = '|' | append: set.set_key.value | append: '|' -%}
        {%- unless orderable_keys contains set_token -%}
          {%- continue -%}
        {%- endunless -%}
        {%- assign bp = set.bundle_product.value -%}
        {%- assign variant_id = bp.selected_or_first_available_variant.id -%}
        {%- assign price = bp.price | money_without_currency | replace: ',', '' -%}
        {%- assign field_name = bp.title | remove: 'French Fitness Cable Machine Attachment ' | remove: ' (New)' -%}
        <input
          type="radio"
          class="visually-hidden"
          name="Cable Attachments"
          data-bundle-set="{{ set.set_key.value }}"
          data-customization-option="{{ variant_id }}"
          data-field-name="{{ field_name | escape }}"
          value="{{ variant_id }}:::{{ price }}"
        >
      {%- endfor -%}
      <input type="radio" class="visually-hidden" name="Cable Attachments" data-cable-none data-customization-option="none" data-field-name="No Thanks" value="" checked>

      <details class="bundle-selector-dropdown" data-section-id="{{ section.id }}" open>
        <summary class="bundle-selector-summary">
          <span class="bundle-selector-summary__title" data-option-title>Cable Attachments</span>
        </summary>
        <div class="bundle-selector-dropdown__content">
          <div class="bundle-selector-container" data-section-id="{{ section.id }}">
            <div class="bundle-cards-wrapper">
              {%- for set in sets -%}
                {%- assign set_token = '|' | append: set.set_key.value | append: '|' -%}
                {%- unless orderable_keys contains set_token -%}
                  {%- continue -%}
                {%- endunless -%}
                {%- assign bp = set.bundle_product.value -%}
                <div class="bundle-card" data-bundle-set="{{ set.set_key.value }}">
                  {%- if set.badge.value != blank -%}
                    <div class="bundle-badge">{{ set.badge.value }}</div>
                  {%- endif -%}
                  <div class="bundle-card__image">
                    <img src="{{ bp.featured_image | image_url: width: 300 }}" alt="{{ bp.title | escape }}" width="300" height="300" loading="lazy">
                  </div>
                  <div class="bundle-card__content">
                    <h4 class="bundle-card__title">{{ bp.title }}</h4>
                    <a href="#" class="bundle-card__link" data-bundle-set="{{ set.set_key.value }}">See What's Included</a>
                    <div class="bundle-card__price">
                      <span class="bundle-price-current">{{ bp.price | money }} USD</span>
                      {%- assign retail = bp.metafields.custom.retail_price.value -%}
                      {%- if retail != blank -%}
                        <span class="bundle-price-original">{{ retail | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </details>
    </div>

    <div id="bundle-modal" class="bundle-modal" hidden style="display: none;">
      <div class="bundle-modal__backdrop"></div>
      <div class="bundle-modal__content">
        <button class="bundle-modal__close" aria-label="Close modal">&times;</button>
        <div class="bundle-modal__header">
          <h2 class="bundle-modal__title">ABOUT THIS BUNDLE</h2>
        </div>
        <div class="bundle-modal__body">
          <div class="bundle-modal__main-product">
            <div class="bundle-modal__product-image">
              <img id="bundle-main-image" src="" alt="" width="200" height="200" loading="lazy">
            </div>
            <div class="bundle-modal__product-info">
              <div class="bundle-modal__rating" id="bundle-main-rating"></div>
              <h3 id="bundle-main-title" class="bundle-modal__product-title"></h3>
              <p id="bundle-main-description" class="bundle-modal__product-description"></p>
            </div>
          </div>
          <div class="bundle-modal__included-section">
            <h4 class="bundle-modal__included-title">The set includes the following:</h4>
            <div class="bundle-modal__products-grid" id="bundle-products-grid"></div>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Data config for bundle-selector.js — all set/product data, no hardcoding. {%- endcomment -%}
    <script type="application/json" data-cable-config>
    {
      "sets": [
        {%- assign emitted = 0 -%}
        {%- for set in sets -%}
          {%- comment -%}
            Gated sets are left out of the config as well, so the popup and the
            selection handler in bundle-selector.js have no way to reach a set
            whose components are incomplete. Commas are tracked with `emitted`
            because forloop.last no longer marks the last rendered entry.
          {%- endcomment -%}
          {%- assign set_token = '|' | append: set.set_key.value | append: '|' -%}
          {%- unless orderable_keys contains set_token -%}
            {%- continue -%}
          {%- endunless -%}
          {%- if emitted > 0 -%},{%- endif -%}
          {%- assign emitted = emitted | plus: 1 -%}
          {%- assign bp = set.bundle_product.value -%}
          {%- assign bpbadge = bp.metafields.judgeme.badge -%}
          {%- assign bpbadgeval = bpbadge.value | default: bpbadge -%}
          {
            "key": {{ set.set_key.value | json }},
            "handle": {{ bp.handle | json }},
            "variantId": {{ bp.selected_or_first_available_variant.id | json }},
            "title": {{ bp.title | json }},
            "price": {{ bp.price | json }},
            "image": {{ bp.featured_image | image_url: width: 400 | json }},
            "description": {{ bp.description | json }},
            "badge": {{ bpbadgeval | json }},
            "included": [
              {%- for ip in set.included_products.value -%}
                {%- assign ipbadge = ip.metafields.judgeme.badge -%}
                {%- assign ipbadgeval = ipbadge.value | default: ipbadge -%}
                {
                  "handle": {{ ip.handle | json }},
                  "title": {{ ip.title | json }},
                  "sku": {{ ip.metafields.custom.product_code.value | default: ip.selected_or_first_available_variant.sku | json }},
                  "image": {{ ip.featured_image | image_url: width: 240 | json }},
                  "price": {{ ip.price | json }},
                  "badge": {{ ipbadgeval | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        {%- endfor -%}
      ]
    }
    </script>

    <script src="{{ 'bundle-selector.js' | asset_url }}" defer="defer"></script>
  </div>
{%- endif -%}
