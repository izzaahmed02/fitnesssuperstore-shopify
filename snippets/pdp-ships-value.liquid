{%- comment -%}
  PDP "Ships:" row value — crate / manual / crate-photo treatment.

  Per Tim French, canonical Gmail thread "Re: Remove Blanket Wrap Packaging on
  Most Products." (2026-09-03 → 2026-09-22).

  RULE (data-driven, no hardcoded product mapping):
  when custom.ships is exactly "New in Crate" or "New in Crates" AND the
  product carries supporting data (a usable assembly manual, crate photos, or
  both), the row renders the approved sentence

    Ships: New in Crate (Assembly Manual Link). Installation Options Available

  - The ships value is echoed verbatim, so multi-crate products carrying
    "New in Crates" render the plural. The field stays the single source of
    truth for singular vs plural.
  - "Assembly Manual Link" is a real link to that model's manual, from
    custom.manual_link or custom.manual_file.
  - When custom.crate_photos has entries, the ships value itself becomes the
    trigger for a popup showing that product's own crate photos. It reuses the
    theme's existing modal (.modal-wrapper / #dynamic-product-content), the
    same mechanism as "(More Info)".
  - With no crate photos the value renders as plain text with no link.
    Nothing falls back to the packaging video.
  - In every crate case the representative packaging video and the
    "Packaging details" disclosure are suppressed for that product.

  Any product that does not meet the crate conditions keeps its stored ships
  value and the existing PR #663 packaging-video behaviour untouched. That
  includes the packaging exceptions, whose stored values ("New in Wooden
  Crates (Assembly Options Available)" and similar) do not match the two
  exact crate values above.

  Callers: sections/main-product.liquid, main-product-comb.liquid and
  main-product-variants.liquid — the three PDP templates that render the
  packaging-video CTA. main-product-home-gym-packages.liquid is out of scope
  for the ships wording: it never renders the packaging video/disclosure and
  its products are not in the strength product line.
{%- endcomment -%}
{%- liquid
  assign ships_value = product.metafields.custom.ships
  assign ships_normalized = ships_value | strip_html | strip | downcase

  # Echoed so "New in Crates" renders plural. strip_html keeps a rich-text
  # field from injecting markup ahead of the manual link. A stored trailing
  # period is dropped so the label never doubles up with the punctuation this
  # snippet adds around the manual link.
  assign ships_label = ships_value | strip_html | strip | remove_last: '.'

  # The manual can be either a url-type metafield (custom.manual_link) or a
  # file_reference (custom.manual_file). Resolve both shapes to a plain URL
  # string, treating a file/link drop and a raw string the same way.
  assign manual_url = ''

  assign manual_link_value = product.metafields.custom.manual_link.value
  if manual_link_value != blank
    if manual_link_value.url != blank
      assign manual_url = manual_link_value.url
    else
      assign manual_url = manual_link_value
    endif
  endif

  if manual_url == blank
    assign manual_file_value = product.metafields.custom.manual_file.value
    if manual_file_value != blank
      if manual_file_value.url != blank
        assign manual_url = manual_file_value.url
      else
        assign manual_url = manual_file_value
      endif
    endif
  endif

  assign crate_photos = product.metafields.custom.crate_photos.value
  assign crate_photo_count = 0
  if crate_photos != blank
    assign crate_photo_count = crate_photos.size
  endif

  assign ships_is_crate = false
  if ships_normalized == 'new in crate' or ships_normalized == 'new in crate.'
    assign ships_is_crate = true
  elsif ships_normalized == 'new in crates' or ships_normalized == 'new in crates.'
    assign ships_is_crate = true
  endif

  assign is_crate_treatment = false
  if ships_is_crate
    if manual_url != blank or crate_photo_count > 0
      assign is_crate_treatment = true
    endif
  endif
-%}
{%- if is_crate_treatment -%}
  {%- if crate_photo_count > 0 -%}
    {%- assign crate_modal_id = 'CratePhotos-' | append: product.id -%}
    <button
      type="button"
      class="ships-crate__trigger"
      data-crate-photos-trigger
      aria-haspopup="dialog"
      aria-controls="{{ crate_modal_id }}"
    >{{ ships_label }}</button>
    <template id="{{ crate_modal_id }}">
      <div class="crate-photos">
        <h2 class="crate-photos__heading">{{ ships_label }} — {{ product.title | escape }}</h2>
        <div class="crate-photos__grid">
          {%- for photo in crate_photos -%}
            {%- liquid
              assign photo_src = photo | image_url: width: 1400
              if photo_src == blank
                assign photo_src = photo.url
              endif
              assign photo_alt = photo.alt
              if photo_alt == blank
                assign photo_alt = product.title | append: ' crate packaging photo'
              endif
            -%}
            {%- if photo_src != blank -%}
              <img
                class="crate-photos__image"
                src="{{ photo_src }}"
                alt="{{ photo_alt | escape }}"
                loading="lazy"
                width="1400"
                height="1400"
              >
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </template>
    <script src="{{ 'pdp-crate-photos.js' | asset_url }}" defer="defer"></script>
  {%- else -%}
    {{ ships_label }}
  {%- endif -%}
  {%- if manual_url != blank %} (<a
      class="ships-manual__link"
      href="{{ manual_url | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >Assembly Manual Link</a>).{% else %}.{% endif %} Installation Options Available
{%- else -%}
  {{ ships_value }}
  {% render 'shipping-packaging-video-link', product: product %}
{%- endif -%}
