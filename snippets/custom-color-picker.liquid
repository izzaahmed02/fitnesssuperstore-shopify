<div id="{{ products.product_title | handleize }}" class="custom-color-group">
    {% comment %}{{ products.product_option_variants.value | json }}{% endcomment %}
    {% assign has_custom_color_paint = false %}
    {% assign has_custom_color_vinyl = false %}

    {% if products.product_option_variants.value %}
        {% if products.product_option_title contains 'Paint' %}
            {% assign has_custom_color_paint = true %}
        {% endif %}
        {% if products.product_option_title contains 'Vinyl' %}
            {% assign has_custom_color_vinyl = true %}
        {% endif %}

    {% endif %}


    {% if products.product_option_title contains 'Paint' or has_custom_color_paint %}
        <div class="group-color-container" data-group-color-name="Paint">
            <div class="group-color">
                <span class="apo-title">Paint Color</span>
                <div class="option_selected-container" style="display: none;">
                    <p class="option_selected"></p>
                    <span class="option_selected-price"></span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                              d="M3.5771 3.57613C3.81142 3.34181 4.19132 3.34181 4.42563 3.57613L8.00137 7.15186L11.5771 3.57613C11.8114 3.34181 12.1913 3.34181 12.4256 3.57613C12.6599 3.81044 12.6599 4.19034 12.4256 4.42465L8.8499 8.00039L12.4256 11.5761C12.6599 11.8104 12.6599 12.1903 12.4256 12.4247C12.1913 12.659 11.8114 12.659 11.5771 12.4247L8.00137 8.84892L4.42563 12.4247C4.19132 12.659 3.81142 12.659 3.5771 12.4247C3.34279 12.1903 3.34279 11.8104 3.5771 11.5761L7.15284 8.00039L3.5771 4.42465C3.34279 4.19034 3.34279 3.81044 3.5771 3.57613Z"
                              fill="black"/>
                    </svg>
                </div>
            </div>

            <div class="color_options_container options_container">
                {% render 'custom-color-wrapper', group: 'paint',
                        products: products.product_option_variants.value,
                        title: products.product_option_title,
                        default: default
                %}
            </div>
        </div>
    {% endif %}

    {% if products.product_option_title contains 'Vinyl' or has_custom_color_vinyl %}
        <div class="group-color-container" data-group-color-name="Vinyl">
            <div class="group-color">
                <span class="apo-title">Vinyl Color</span>
                <div class="option_selected-container" style="display: none;">
                    <p class="option_selected"></p>
                    <span class="option_selected-price"></span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                              d="M3.5771 3.57613C3.81142 3.34181 4.19132 3.34181 4.42563 3.57613L8.00137 7.15186L11.5771 3.57613C11.8114 3.34181 12.1913 3.34181 12.4256 3.57613C12.6599 3.81044 12.6599 4.19034 12.4256 4.42465L8.8499 8.00039L12.4256 11.5761C12.6599 11.8104 12.6599 12.1903 12.4256 12.4247C12.1913 12.659 11.8114 12.659 11.5771 12.4247L8.00137 8.84892L4.42563 12.4247C4.19132 12.659 3.81142 12.659 3.5771 12.4247C3.34279 12.1903 3.34279 11.8104 3.5771 11.5761L7.15284 8.00039L3.5771 4.42465C3.34279 4.19034 3.34279 3.81044 3.5771 3.57613Z"
                              fill="black"/>
                    </svg>
                </div>
            </div>

            <div class="color_options_container options_container">
                {% render 'custom-color-wrapper', group: 'vinyl',
                        products: products.product_option_variants.value,
                        title: products.product_option_title,
                        default: default
                %}
            </div>
        </div>
    {% endif %}
</div>
