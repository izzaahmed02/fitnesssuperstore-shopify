<style>
    .custom-color-single {
      display: none;
    }

    .custom-color-group {
        display: none;
    }

    .color_options_container {
        margin-left: 0px;
        gap: 10px;
    }
    .color-option-container {
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        position: relative;
      }
      
      .swatch {
        position: relative; 
        width: 40px;       
        height: 40px;
        border-radius: 50%;
        border: 1px solid #E5E5E5; 
        box-sizing: border-box;
        cursor: pointer;
        display: flex;     
        align-items: center;
        justify-content: center;
        font-family: sans-serif;
        transition: border-color 0.2s;
      }
      
      .swatch:hover {
        border-color: #ff6600;
      }
     
      .swatch::after {
        content: attr(data-tool-tip);
        position: absolute;
        white-space: nowrap;
        top: 180%;
        left: 130%; 
        transform: translateY(-50%);
        background-color: #fff;
        color: #333;
        padding: 12px 18px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        font-size: 14px;
        font-family: 'Lato';
        color: #393940;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
        z-index: 9999;
      }
      
      .swatch:hover::after {
        opacity: 1;
      }
       
      .swatch:hover::before {
        opacity: 1;
      }     

      .options_heading span:first-child {
        font-weight: 400;
      }

      .custom-color-group .color-options-container {
        display: flex;
        gap: 10px;
      }

      .custom-color-group .group-color-container {
        display: flex;
        flex-direction: column;
        margin-top: 20px;
      }

      .custom-color-group .color_options_container {
        margin-top: 20px;
      }

      .custom-color-group .color_options_container .color-selected  {
        outline: 1px solid var(--primary-orange);
        outline-offset: 3px;
      }

      .custom-color-group .group-color-container .group-color {
        display: flex;
        align-items: baseline;
      }

      .custom-color-group .group-color-container .option_selected-container {
        margin-top: 0px;
      }
</style>
