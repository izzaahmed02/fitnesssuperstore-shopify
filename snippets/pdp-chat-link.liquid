{%- comment -%}
  Mobile options UI: inline "Chat with us" entry under Add to Cart (mobile PDP only; hidden at 750px+).
  Opens the existing Gorgias widget (GorgiasChat.open(), per Gorgias's "open chat link" help article).
  The widget itself is still loaded lazily by layout/theme.liquid - nothing here loads it.
  No cart, price or form data is read or written.
{%- endcomment -%}
<div class="pdp-chat-link">
  <button type="button" class="pdp-chat-link__button" data-pdp-chat-open>
    <svg class="pdp-chat-link__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.2 3.6a.5.5 0 0 1-.8-.4V16h0a2 2 0 0 1-2-2V5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="8.5" cy="9.5" r="1" fill="currentColor"/>
      <circle cx="12" cy="9.5" r="1" fill="currentColor"/>
      <circle cx="15.5" cy="9.5" r="1" fill="currentColor"/>
    </svg>
    <span>Chat with us</span>
  </button>
</div>
<script src="{{ 'pdp-chat-link.js' | asset_url }}" defer="defer"></script>
