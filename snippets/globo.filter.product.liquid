{%- comment -%}Do not edit this file{%- endcomment -%}
{% raw %}
  <li class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
    style="--animation-order: {{ forloop.index }};"
  {% endif %}>
    <div class="card-wrapper product-card-wrapper underline-links-hover">
      <div class="product-item card__inner" data-product-id="{{ product.id }}">
        <div class="image-wrap">
          {% assign images = product.images %}
          {% for item in product.images limit: 5 %}
            {% if item.src != blank %}
              <div class="image-item">
                <img
                  class="lazy-load"
                  src="{{ item.src }}"
                  srcset="
                    {{ item.src | replace: '.jpg', '_165x.jpg' }} 165w,
                    {{ item.src | replace: '.jpg', '_360x.jpg' }} 360w,
                    {{ item.src | replace: '.jpg', '_535x.jpg' }} 535w,
                    {{ item.src | replace: '.jpg', '_750x.jpg' }} 750w
                  "
                  sizes="(max-width: 750px) 100vw, 750px"
                  loading="lazy"
                  alt="{{ item.alt | escape }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        </div>
      
        <div class="tags-wrapper">
          {% if product.metafields.custom.condition_state contains "New" %}
            <div class="condition-tag">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
