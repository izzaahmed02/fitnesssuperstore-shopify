<div class="gl-card">
  <div class="gl-card-media">
    <div class="gl-card-thumbnail">
      <a class="spf-image-ratio" href="{{ product.url }}">
        <img src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.title }}">
      </a>
    </div>
  </div>
  <div class="gl-card-content gl-card-flex">
    <div class="gl-card-title"><a href="{{ product.url }}">{{ product.title }}</a></div>
    <div class="gf-search-item-product-vendor">{{ product.vendor }}</div>
    <div class="gl-card-pricing"><span class="gl-card-price">{{ product.price | money }}</span></div>
  </div>
</div>
