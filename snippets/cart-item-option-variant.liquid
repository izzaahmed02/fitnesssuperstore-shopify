{% comment %}
  Компонент для рендеринга варианта продукта
  Параметры:
    - variant: вариант продукта
    - product_option: родительская опция продукта
    - hide_quantity: флаг скрытия селектора количества
{% endcomment %}

{% liquid
  assign is_default_variant = variant.product.has_only_default_variant
  if is_default_variant
    assign product_title = variant.product.title
    assign featured_image = variant.product.featured_image
  else
    assign product_title = variant.title
    assign featured_image = variant.featured_image
  endif
  assign cleaned_title = product_title
  if product_title contains '($' or product_title contains '(+$'
    assign parts = product_title | split: ')'
    if parts.size > 1
      assign first_part = parts | first | append: ')'
      if first_part contains '$'
        assign cleaned_title = product_title | remove_first: first_part | strip
      endif
    endif
  endif

  if cleaned_title contains '($' or cleaned_title contains '(+$'
    assign last_bracket_index = cleaned_title | split: '(' | size | minus: 1
    if last_bracket_index > 0
      assign parts = cleaned_title | split: '('
      assign last_part = '(' | append: parts[last_bracket_index]
      if last_part contains '$' and last_part contains ')'
        assign cleaned_title = cleaned_title | remove: last_part | strip
      endif
    endif
  endif

  if product_title contains '(-$'
    assign cleaned_title = product_title | split: '(-$' | first
  endif
  assign default_quantity = 1
  for item in options_data
    if item.variantId contains variant.id
      assign default_quantity = item.quantity | plus: 0
      break
    endif
  endfor

  echo default_quantity
%}

<label
  class="product-options__swatch-wrapper {% if variant.available == false %}product-options__swatch-wrapper--soldout{% endif %}"
  {% if variant.available == false %}
    title="Sold out"
  {% endif %}
>
  <input
    type="{% if product_option.enable_multichoice == true %}checkbox{% else %}radio{% endif %}"
    data-customization-option="{{ variant.id }}"
    {% if product_option.enable_conditional_choice == true %}
      data-has-conditions="{{ variant.id | strip }}"
    {% endif %}
    {% if product_option.enable_multichoice == true %}
      data-has-multichoice
    {% endif %}
    data-field-name="{{ cleaned_title | escape | strip }}"
    {% if variant.price != 0 %}
      data-field-price="{{ variant.price | money }}"
    {% endif %}
    name="{{ product_option.product_option_title | handleize }}-{{ line_item.key }}"
    value="{{ variant.id }}{% if variant.metafields.custom.price_reduction_value != blank %}:::-{{variant.metafields.custom.price_reduction_value}}{% endif %}{% if variant.price > 0%}:::{{ variant.price | money_without_currency | replace: ',','' }}{% endif %}"
    autocomplete="off"
    {% if default_values contains variant.id %}
      checked
    {% endif %}
    class="product-options__swatch-input"
    {% if variant.available == false %}
      disabled="disabled"
    {% endif %}
  >

  {% if featured_image %}
    <div class="product-options__swatch-img-wrapper">
      <img src="{{ featured_image | image_url: width: 300, height: 300 }}">
    </div>
  {% endif %}
  {% if variant.price != 0 %}
    {% liquid
      assign price = variant.price
      if default_quantity != blank and default_quantity != '0' and default_quantity != 0
        assign default_quantity = default_quantity | plus: 0
        assign price = price | times: default_quantity
      endif

      echo default_quantity
    %}

    <span
      avis-price="{{ variant.price | money_without_currency | replace:',','' }}"
      avis-price-compare="0"
      class="product-options__swatch-price"
    >
      {{- price | money -}}
    </span>
  {% endif %}

  <span class="product-options__swatch-title">
    {{ cleaned_title }}
    {% if product_title contains '(-$' and variant.metafields.custom.price_reduction_value != blank %}
      <span class="price-substract"> Subtract -${{ variant.metafields.custom.price_reduction_value }}</span>
    {% endif %}
  </span>

  {% if variant.price > 0 and hide_quantity != true %}
    <div class="product-options__quantity-selector" data-quantity-selector>
      <button type="button" data-decrease-quantity="{{ variant.id }}" class="product-options__quantity-btn product-options__quantity-minus">
        {% render 'product-option-minus' %}
      </button>
      <input
        type="number"
        data-input-quantity="{{ variant.id }}"
        value="{% if default_quantity != blank and default_quantity != '0' and default_quantity != 0 %}{{default_quantity}}{%else%}1{% endif %}"
        min="1"
        max="{{ variant.metafields.custom.max_quantity | default: 999 }}"
        class="product-options__quantity-input"
      >
      <button type="button" data-increase-quantity="{{ variant.id }}" class="product-options__quantity-btn product-options__quantity-plus">
        {% render 'product-option-plus' %}
      </button>
    </div>
  {% endif %}
</label>
