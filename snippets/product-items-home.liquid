{% comment %}
                    <div class="comparable-custom-action">
          <input class="add-to-comparable comparable-inited in-comparison" type="checkbox" id="add-to-comparable-checkbox_{{ product.handle }}" data-product="{{ product.handle }}">
          <label for="add-to-comparable-checkbox_{{ product.handle }}">Compare</label>
        </div> {% endcomment %}
    
                    
    {%- if product.available != false -%}
        {% unless  product.metafields.custom.processing_time  == blank %}
        
        {% endunless %}
    {% endif %}
    <a href="{{ product.url }}">
                  <div class="prodInfo">  



                        <div class="tags-wrapperr">
            {% if product.compare_at_price != blank %}
              <div class="sale-tag">
