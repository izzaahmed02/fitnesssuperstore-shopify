<div class="main-comparison__item">
    <div class="main-comparison__item-img-wrapper">
        <img src="{{ block.settings.image | image_url: width: 400, height: 300 }}" alt=""
             class="main-comparison__item-img">
    </div>
    <span class="main-comparison__item-count">{{ block.settings.count }}</span>
    <h2 class="main-comparison__item-title">{{ block.settings.title }}</h2>
    <p class="main-comparison__item-copy">{{ block.settings.copy }}</p>
    <a href="{{ block.settings.url }}" class="main-comparison__item-link">
        See more
        {% render 'chevron-right' %}
    </a>
</div>
