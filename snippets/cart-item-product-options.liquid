{% liquid
  assign options = line_item.product.metafields.options.product_options.value
  assign warranty_index = 1
  assign color_index = 1
  assign assambly_index = 0
  assign title_downcase = line_item.product.title | downcase
  if title_downcase contains 'remanufactured'
    assign color_index = 2
  endif
  assign index = 1
  assign last_index = index
  assign has_color_option = false

  for category in options
    assign category_title_downcase = category.title | downcase
    if category_title_downcase contains 'color' or  category_title_downcase contains 'colors'
      assign has_color_option = true
    endif
    assign color_title = ''
    assign hidden_option = false
    for product_option in category.product_options.value
      assign title = product_option.product_option_title | downcase
      if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color'
        assign color_title = product_option.product_option_title
      else
        assign color_title = ''
      endif
      if product_option.hide_values
        assign hidden_option = true
      endif
    endfor
    unless has_color_option
      assign index = 0
    endunless
    unless category.hide_option
      unless hidden_option
        if color_title == '' and category_title_downcase != 'warranty'
          assign last_index = last_index | plus: 1
        endif
      endunless
    endunless
    assign assambly_index = last_index
  endfor
%}
<product-customization-options
  data-product-id="{{ line_item.key }}"
  data-variant-id="{{ line_item.variant.id }}"
  class="product-options"
  id="product-options"
  data-product="default"
  data-stamp="none"
>
  <div class="product-options__overlay" data-close-popup="{{ line_item.key }}"></div>
  <div class="product-options__popup-container">
    <div class="product-options__popup-container--header">
      <h3>{{ line_item.product.title }}</h3>
      <span class="avis-popupHeader-close" data-close-popup="{{ line_item.key }}">×</span>
    </div>
    <div class="product-options__popup-container--inner">
      {% unless has_color_option %}
        {% assign index = 0 %}
        {% assign assambly_index = assambly_index | minus: 1 %}
      {% endunless %}
      {% for category in options %}
        {% assign color_counter = 0 %}
        {% assign color_title = '' %}
        {% assign color_group = '' %}
        {% assign category_title_downcase = category.title | downcase %}
        {% assign hidden_option = false %}
        {% for product_option in category.product_options.value %}
          {% assign title = product_option.product_option_title | downcase %}
          {% if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color' %}
            {% assign color_counter = color_counter | plus: 1 %}
            {% assign color_title = product_option.product_option_title %}
            {% assign color_group = title | handleize %}
          {% else %}
            {% assign color_title = '' %}
          {% endif %}
          {% if product_option.hide_values %}
            {% assign hidden_option = true %}
          {% endif %}
        {% endfor %}

        {% unless category.hide_option %}
          {% unless hidden_option %}
            {% if color_title == '' and category_title_downcase != 'warranty' and category_title_downcase != 'assembly & room of choice installation needed?' %}
              {% assign index = index | plus: 1 %}
            {% endif %}
          {% endunless %}
        {% endunless %}

        {% if index == assambly_index %}
          {% assign index = index | minus: 1 %}
        {% endif %}

        <div
          class="product-option__item"
          {% unless category.hide_option %}
            style="order:  {% if color_title != blank %}{{ color_index }}{% elsif category_title_downcase == 'warranty' %}{{ warranty_index }}{% elsif category_title_downcase == 'assembly & room of choice installation needed?' %}{{ assambly_index }}{% else %}{{ index }}{% endif %};"
          {% endunless %}
        >
          {% if category.title != blank %}
            <h2
              class="product-options__category-title"
              {% if color_counter == 1 %}
                data-group-color-name="{{ color_group }}"
                data-color-name-title="{{ color_title }}"
              {% endif %}
              {% if category.hide_option %}
                style="display: none !important"
              {% endif %}
            >
              <span>
                {% unless category.hide_option %}
                  {%- if color_title != blank -%}
                    {{- color_index -}}
                  {%- elsif category_title_downcase == 'warranty' -%}
                    {{- warranty_index -}}
                  {%- elsif category_title_downcase == 'assembly & room of choice installation needed?' -%}
                    {{- assambly_index -}}
                  {%- else -%}
                    {{- index -}}
                  {%- endif -%}
                {% endunless -%}
              </span>
              {{- category.title }}

              {% if color_counter == 1 %}
                {% for product_option in category.product_options.value %}
                  {% assign title = product_option.product_option_title | downcase %}
                  {% if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color' %}
                    {% if product_option.product_option_sets_default.value.id %}
                      {% render 'related-products-button',
                        product_id: product.id,
                        product_handle: product.handle,
                        product_category: product.metafields.custom.option_category_id.value,
                        option_title: product_option.product_option_title
                      %}
                      <div class="option_selected-container" data-selected-color-option>
                        <p class="option_selected" data-option-id="{{ product_option.product_option_sets_default.value.id }}">
                          <div data-color-selected-title>
                            {{ product_option.product_option_sets_default.value.title }}
                          </div>
                          <div class="option_selected-price">
                            {% if product_option.product_option_sets_default.value.price > 0 %}
                              {{ product_option.product_option_sets_default.value.price }}
                            {% endif %}
                          </div>
                        </p>
                      </div>
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </h2>
          {% endif %}
          {% for product_option in category.product_options.value %}
            {% assign title = product_option.product_option_title | downcase %}
            {% if title == 'paint color' or title == 'paint colors' or title == 'color' %}
              {% render 'cart-item-color-picker',
                product: product_option.product_option_variants.value,
                products: product_option,
                color_type: 'paint',
                title: category.title,
                line_item: line_item,
                color_counter: color_counter
              %}
            {% endif %}
            {% if title == 'vinyl color' or title == 'vinyl colors' %}
              {% render 'cart-item-color-picker',
                product: product_option.product_option_variants.value,
                products: product_option,
                color_type: 'vinyl',
                title: category.title,
                line_item: line_item,
                color_counter: color_counter
              %}
            {% endif %}
            {% if title != 'paint color' and title != 'vinyl color' and title != 'paint colors' and title != 'vinyl colors' %}
              {% liquid
                assign options_data = null
                assign active_conditional_option = null
                for property in line_item.properties
                  if property.first == '_functionOperation'
                    assign options_data = property.last
                  endif
                endfor
                for product_option in category.product_options.value
                  assign option_handle = product_option.product_option_title | handleize
                  if options_data != blank and product_option.enable_conditional_choice
                    for item in options_data
                      if item.groupHandle == option_handle
                        if item.defaultValues != blank
                          assign default_values = item.defaultValues
                        endif
                      endif
                    endfor
                    for variant in product_option.product_option_variants.value
                      if default_values != blank and default_values contains variant.id
                        assign active_conditional_option = variant
                      endif
                    endfor
                  endif
                endfor
              %}
              {% render 'cart-item-product-option',
                category: category,
                product_option: product_option,
                forloop_index: forloop.index,
                product_id: line_item.product.id,
                line_item: line_item,
                color_counter: color_counter,
                active_conditional_option: active_conditional_option
              %}
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
    <div class="product-options__popup-container-footer">
      <button class="button button--cancel" data-close-popup="{{ line_item.key }}">Cancel</button>
      <button data-apply-changes="{{ line_item.key }}" class="button--options button button--primary cart-item__custom-options-popup-button">
        <span>Save changes</span>
        {% render 'loading-spinner' %}
      </button>
    </div>
  </div>
</product-customization-options>
