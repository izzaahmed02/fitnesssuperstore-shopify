{%- comment -%}
  DRAFT — NOT APPROVED FOR PUBLICATION — 2026-09-06.
  Source-aligned copy and link corrections for V3; no new eligibility rules.
  Based on benicia-showroom dc9f359a981914cbf0dca68b11e235a851bac7fa.
  Keep settings.return_policy_v3_live OFF until final human release.
  Blank/unrecognized classifications render nothing; they are launch exceptions,
  NOT evidence that a customer accepted final sale. No vendor-name inference.
  Preview QA must set return_policy_url to the approved V3 preview URL.
{%- endcomment -%}

{%- if settings.return_policy_v3_live -%}
  {%- assign policy_class = product.metafields.custom.return_policy_class.value | default: '' | strip | upcase -%}
  {%- assign disclosure_label = '' -%}
  {%- assign disclosure_text = '' -%}
  {%- assign disclosure_modifier = '' -%}
  {%- assign policy_url = settings.return_policy_url | default: '/pages/return-policy' -%}
  {%- liquid
    case policy_class
      when 'RETURN ELIGIBLE'
        assign disclosure_label = 'Return eligible — conditions apply'
        assign disclosure_text = 'Request a Return Authorization in writing within 14 calendar days after delivery. Eligibility is subject to all policy conditions. Approved voluntary returns carry a 25% restocking fee, actual outbound freight even when shipping was free, and customer responsibility for return removal, disassembly, professional repackaging, loading and freight. Completed delivery and installation charges are nonrefundable, and costs paid directly to an approved provider are not deducted again. Defect, damage, wrong-item and incomplete-shipment claims follow the applicable claim process and law.'
        assign disclosure_modifier = 'is-eligible'
      when 'FINAL SALE'
        assign disclosure_label = 'Final sale — no voluntary returns'
        assign disclosure_text = 'This item is not eligible for a voluntary return for fit, size, ceiling height, access, preference or changing your mind. Installation does not make it returnable. Defects, freight damage, wrong items and incomplete shipments follow the applicable warranty or order-correction process; rights that cannot lawfully be waived remain available.'
        assign disclosure_modifier = 'is-final'
      when 'CUSTOM/SPECIAL ORDER'
        assign disclosure_label = 'Custom / special order — final sale'
        assign disclosure_text = 'This item is not eligible for a voluntary return. Before shipment, any cancellation restriction is governed by the custom or special-order terms disclosed before purchase. After dispatch, the final-sale terms apply. Defects, freight damage, wrong items and incomplete shipments follow the applicable claim process and law.'
        assign disclosure_modifier = 'is-final'
      when 'REMANUFACTURED/USED/OPEN BOX'
        assign disclosure_label = 'Remanufactured / used / open box — final sale'
        assign disclosure_text = 'This item is not eligible for a voluntary return. Normal minor cosmetic characteristics of remanufactured equipment are not grounds for a preference return. Defects, freight damage, wrong items and incomplete shipments follow the coverage, condition disclosures and legal remedies applicable to the product. Report suspected freight damage promptly under the full policy below.'
        assign disclosure_modifier = 'is-final'
    endcase
  -%}
  {%- if disclosure_label != blank -%}
    <div class="return-disclosure return-disclosure--{{ disclosure_modifier }}">
      <p class="return-disclosure__label">{{ disclosure_label | escape }}</p>
      <p class="return-disclosure__text">{{ disclosure_text | escape }}</p>
      <p class="return-disclosure__text"><a href="{{ policy_url | escape }}">Read the full Cancellations, Returns &amp; Refunds Policy</a></p>
    </div>
    {%- style -%}
      .return-disclosure { border: 1px solid #e5e5e5; border-left: 4px solid #6b7280; border-radius: 8px; padding: 1.2rem 1.6rem; margin: 1.6rem 0; background: #fafafa; }
      .return-disclosure--is-final { border-left-color: #d83d0e; }
      .return-disclosure--is-eligible { border-left-color: #2e7d32; }
      .return-disclosure__label { margin: 0 0 .4rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 1.2rem; }
      .return-disclosure__text { margin: 0; font-size: 1.3rem; line-height: 1.5; }
      .return-disclosure__text + .return-disclosure__text { margin-top: .8rem; }
    {%- endstyle -%}
  {%- endif -%}
{%- endif -%}
