{% liquid
  assign options = product.metafields.options.product_options.value
  if product.selected_or_first_available_variant.metafields.options.product_options.value != blank
    assign options = product.selected_or_first_available_variant.metafields.options.product_options.value
  endif
  assign quantity_index = 0
  assign warranty_index = 1
  assign color_index = 1
  assign assambly_index = 0
  assign display_number = 0
  assign visible_total = 0
  assign has_warranty_visible = false
  assign title_downcase = product.title | downcase
  if title_downcase contains 'remanufactured'
    assign color_index = 2
  endif
  assign index = color_index
  assign last_index = index
  assign has_color_option = false

  for category in options
    assign category_title_downcase = category.title | downcase
    if category_title_downcase contains 'color' or category_title_downcase contains 'colors'
      assign has_color_option = true
    endif
    assign color_title = ''
    assign hidden_option = false
    for product_option in category.product_options.value
      assign title = product_option.product_option_title | downcase
      if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color'
        assign color_title = product_option.product_option_title
      else
        assign color_title = ''
      endif
      if product_option.hide_values
        assign hidden_option = true
      endif
    endfor
    unless category.hide_option
      unless hidden_option
        if color_title == '' and category_title_downcase != 'warranty'
          assign last_index = last_index | plus: 1
        endif
        assign visible_total = visible_total | plus: 1
        if category_title_downcase == 'warranty'
          assign has_warranty_visible = true
        endif
      endunless
    endunless
    assign assambly_index = last_index
  endfor
%}
<div id="Product-Options-{{ section.id }}">
  {% if visible_total > 0 %}
    <div class="product-options__bar">
      <span class="product-options__bar-title">Configure your order here.</span>
      <span class="product-options__bar-hint">
        <em>Click</em>
        <svg class="product-options__bar-icon" width="16" height="16" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9 2.125C5.20304 2.125 2.125 5.20304 2.125 9C2.125 12.797 5.20304 15.875 9 15.875C12.797 15.875 15.875 12.797 15.875 9C15.875 5.20305 12.797 2.125 9 2.125ZM0.874999 9C0.874999 4.51269 4.51269 0.875001 9 0.875001C13.4873 0.875002 17.125 4.51269 17.125 9C17.125 13.4873 13.4873 17.125 9 17.125C4.51268 17.125 0.874998 13.4873 0.874999 9ZM9.83333 12.3333C9.83333 12.7936 9.46024 13.1667 9 13.1667C8.53976 13.1667 8.16667 12.7936 8.16667 12.3333C8.16667 11.8731 8.53976 11.5 9 11.5C9.46024 11.5 9.83333 11.8731 9.83333 12.3333ZM7.93333 7.33334C7.93333 6.74423 8.4109 6.26667 9 6.26667C9.5891 6.26667 10.0667 6.74423 10.0667 7.33334L10.0667 7.43444C10.0667 7.74415 9.94364 8.04117 9.72464 8.26017L8.57574 9.40907C8.34142 9.64339 8.34142 10.0233 8.57574 10.2576C8.81005 10.4919 9.18995 10.4919 9.42427 10.2576L10.5732 9.1087C11.0172 8.66466 11.2667 8.06241 11.2667 7.43444L11.2667 7.33334C11.2667 6.08149 10.2518 5.06667 9 5.06667C7.74816 5.06667 6.73333 6.08149 6.73333 7.33333L6.73333 7.75C6.73333 8.08137 7.00196 8.35 7.33333 8.35C7.6647 8.35 7.93333 8.08137 7.93333 7.75L7.93333 7.33334Z" fill="currentColor"></path>
        </svg>
        <em>for more details</em>
      </span>
    </div>
    {%- comment -%} Mobile options UI (display only): mobile heading; desktop banner unchanged. Not a heading tag (SEO outline). {%- endcomment -%}
    <p class="product-options__mobile-heading">Choose your options</p>
  {% endif %}
  {%- comment -%} Mobile options UI: product-options--pdp scopes the mobile styles to the PDP (cart Modify renders its own markup). {%- endcomment -%}
  <product-customization-options
    data-product-id="{{ product.selected_or_first_available_variant.id }}"
    class="product-options product-options--pdp"
    data-product="default"
  >
    {% liquid
      unless has_color_option
        assign index = 0
        assign assambly_index = assambly_index | minus: 1
      endunless
      assign quantity_option = false
      if has_warranty_visible
        assign other_display_counter = 1
      else
        assign other_display_counter = 0
      endif
    %}

    {% for category in options %}
      {% liquid
        assign color_counter = 0
        assign color_title = ''
        assign color_group = ''
        assign category_title_downcase = category.title | downcase
        assign hidden_option = false

        for product_option in category.product_options.value
          assign title = product_option.product_option_title | downcase
          if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color'
            assign color_counter = color_counter | plus: 1
            assign color_title = product_option.product_option_title
            assign color_group = title | handleize
          else
            assign color_title = ''
          endif
          if product_option.hide_values
            assign hidden_option = true
          endif
          if product_option.option_type == 'Quantity input'
            assign quantity_option = true
          else
            assign quantity_option = false
          endif
        endfor
        unless category.hide_option
          unless hidden_option
            if color_title == '' and category_title_downcase != 'warranty' and category_title_downcase != 'assembly & room of choice installation needed?'
              assign index = index | plus: 1
            endif
            if category_title_downcase == 'warranty'
              assign display_number = 1
            elsif category_title_downcase == 'assembly & room of choice installation needed?'
              assign display_number = visible_total
            else
              assign other_display_counter = other_display_counter | plus: 1
              assign display_number = other_display_counter
            endif
          endunless
        endunless
        if index == assambly_index
          assign index = index | minus: 1
        endif

        if quantity_option
          assign quantity_index = 1
          assign color_index = color_index | plus: 1
        endif
      %}

      {% liquid
        # Mobile options UI (display only): short card labels and help-link targets.
        # The category matching above is unchanged; nothing here feeds pricing or cart data.
        assign mobile_label = ''
        assign is_delivery_category = false
        assign is_accessories_category = false
        if category_title_downcase == 'assembly & room of choice installation needed?'
          assign mobile_label = 'Delivery & setup'
          assign is_delivery_category = true
        elsif category_title_downcase == 'accessories / add ons'
          assign mobile_label = 'Accessories'
          assign is_accessories_category = true
        endif

        # Same popup key the category-level "?" below opens.
        assign category_popup_key = ''
        if category.help_text.value != blank
          assign category_popup_key = category.title
        else
          for product_option in category.product_options.value
            if product_option.option_type == 'Select' and product_option.help_text.value != blank
              assign category_popup_key = product_option.product_option_title
              break
            endif
          endfor
        endif

        # Field-level "?" (accordion headers) that open a popup the category "?" does not.
        assign field_popup_keys = '|'
        assign field_popup_count = 0
        assign field_popup_key = ''
        for product_option in category.product_options.value
          assign po_title_downcase = product_option.product_option_title | downcase
          assign po_is_accordion = false
          if product_option.option_type == blank or product_option.option_type == 'Accordion' or is_delivery_category
            assign po_is_accordion = true
          endif
          if po_title_downcase == 'paint color' or po_title_downcase == 'paint colors' or po_title_downcase == 'color' or po_title_downcase == 'vinyl color' or po_title_downcase == 'vinyl colors'
            assign po_is_accordion = false
          endif
          if po_is_accordion and product_option.help_text.value != blank and product_option.product_option_title != category_popup_key
            assign po_key_token = '|' | append: product_option.product_option_title | append: '|'
            unless field_popup_keys contains po_key_token
              assign field_popup_keys = field_popup_keys | append: product_option.product_option_title | append: '|'
              assign field_popup_count = field_popup_count | plus: 1
              assign field_popup_key = product_option.product_option_title
            endunless
          endif
        endfor

        # Hide field-level "?" on mobile only when every popup they open stays reachable:
        # duplicates of the category popup, or a single sole trigger moved to the card header
        # ("Optional" on Accessories, "Details" elsewhere). Anything else keeps its "?".
        assign header_popup_key = ''
        assign field_help_covered = false
        if field_popup_count == 0
          assign field_help_covered = true
        elsif field_popup_count == 1
          if is_accessories_category or category_popup_key == ''
            assign header_popup_key = field_popup_key
            assign field_help_covered = true
          endif
        endif
      %}

      {% liquid
        # Mobile options UI (display only): category-level collapse for cards with two or more
        # visible fields, or a colour picker. Single-field cards keep their field row as is.
        # The fields are wrapped, never hidden themselves: the mandatory, conditional and
        # add-to-cart checks read each accordion's own display and must see the same state.
        # A card with a required field that has no default renders open.
        assign is_collapsible = false
        assign collapsible_starts_open = false
        if category.title != blank
          unless category.hide_option
            assign collapsible_field_count = 0
            assign collapsible_has_color = false
            for product_option in category.product_options.value
              assign po_title_downcase = product_option.product_option_title | downcase
              if po_title_downcase == 'paint color' or po_title_downcase == 'paint colors' or po_title_downcase == 'color' or po_title_downcase == 'vinyl color' or po_title_downcase == 'vinyl colors'
                assign collapsible_has_color = true
              endif
              unless product_option.hide_values
                assign collapsible_field_count = collapsible_field_count | plus: 1
                if product_option.mandatory and product_option.product_option_sets_default.value == blank and product_option.tier_parent_products.value == blank
                  assign collapsible_starts_open = true
                endif
              endunless
            endfor
            if collapsible_field_count > 1 or collapsible_has_color
              assign is_collapsible = true
            endif
          endunless
        endif
        assign category_body_id = 'ProductOptionsCategory-' | append: section.id | append: '-' | append: forloop.index
      %}

      <div
        class="product-option__item{% if category.title != blank %}{% unless category.hide_option %} product-option__item--card{% endunless %}{% endif %}{% if is_delivery_category %} product-option__item--delivery{% endif %}{% if is_accessories_category %} product-option__item--accessories{% endif %}{% if field_help_covered %} product-option__item--field-help-covered{% endif %}{% if is_collapsible %} product-option__item--collapsible{% unless collapsible_starts_open %} product-option__item--collapsed{% endunless %}{% endif %}"
        {% unless category.hide_option %}
          style="order:  {% if color_title != blank %}{{ color_index }}{% elsif category_title_downcase == 'warranty' %}{{ warranty_index }}{% elsif category_title_downcase == 'assembly & room of choice installation needed?' %}{{ assambly_index }}{% elsif quantity_option %}0{% else %}{{ index }}{% endif %};"
        {% endunless %}
      >
        {% if category.title != blank %}
          {% comment %} Option-group label - kept as a styled div, not a heading, so it
             doesn't add UI heading tags to the PDP outline (SEO heading QA). {% endcomment %}
          <div
            class="product-options__category-title{% if mobile_label != blank %} product-options__category-title--short{% endif %}"
            {% if color_counter == 1 %}
              data-group-color-name="{{ color_group }}"
              data-color-name-title="{{ color_title }}"
            {% endif %}
            {% if category.hide_option %}
              style="display: none !important"
            {% endif %}
          >
            <span>
              {% unless category.hide_option %}
                {{- display_number -}}
              {% endunless %}
            </span>
            {{- category.title }}
            {%- comment -%} Mobile options UI (display only): short label; the category title text above stays as is. {%- endcomment -%}
            {% if mobile_label != blank %}
              <span class="product-options__mobile-label" aria-hidden="true">{{ mobile_label }}</span>
            {% endif %}
            {%- comment -%}
              Mobile options UI: "Details" / "Optional" reuse the existing data-popup-open keys. They must be
              rendered here (inside the component) because the constructor collects [data-popup-open] once.
            {%- endcomment -%}
            {% if category.help_text.value != blank %}
              {% render 'related-products-button',
                product_id: product.id,
                product_handle: product.handle,
                product_category: product.metafields.custom.option_category_id.value,
                option_title: category.title
              %}
              <button type="button" class="product-options__details-link" data-popup-open="{{ category.title }}">Details</button>
            {% else %}
              {% for product_option in category.product_options.value %}
                {% if product_option.option_type == 'Select' and product_option.help_text.value != blank %}
                  {% render 'related-products-button',
                    product_id: product.id,
                    product_handle: product.handle,
                    product_category: product.metafields.custom.option_category_id.value,
                    option_title: product_option.product_option_title
                  %}
                  <button type="button" class="product-options__details-link" data-popup-open="{{ product_option.product_option_title }}">Details</button>
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}
            {% if is_accessories_category %}
              {% if header_popup_key != blank %}
                <button
                  type="button"
                  class="product-options__optional-link"
                  data-popup-open="{{ header_popup_key }}"
                  aria-label="Optional: view {{ header_popup_key | escape }} details"
                >
                  Optional
                </button>
              {% else %}
                <span class="product-options__optional-tag">Optional</span>
              {% endif %}
            {% elsif header_popup_key != blank %}
              <button type="button" class="product-options__details-link" data-popup-open="{{ header_popup_key }}">Details</button>
            {% endif %}
            {% if color_counter == 1 %}
              {% for product_option in category.product_options.value %}
                {% assign title = product_option.product_option_title | downcase %}
                {% if title == 'paint color' or title == 'paint colors' or title == 'color' or title == 'vinyl colors' or title == 'vinyl color' %}
                  {% if product_option.product_option_sets_default.value.id %}
                    {% render 'related-products-button',
                      product_id: product.id,
                      product_handle: product.handle,
                      product_category: product.metafields.custom.option_category_id.value,
                      option_title: product_option.product_option_title
                    %}
                    <div class="option_selected-container" data-selected-color-option="{{ title | handleize }}">
                      <div class="option_selected" data-option-id="{{ product_option.product_option_sets_default.value.id }}">
                        <div data-color-selected-title>
                          {{ product_option.product_option_sets_default.value.title }}
                        </div>
                        <div class="option_selected-price">
                          {% if product_option.product_option_sets_default.value.price > 0 %}
                            {{ product_option.product_option_sets_default.value.price }}
                          {% endif %}
                        </div>
                      </div>
                    </div>
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}
        {%- if is_collapsible -%}
          {%- comment -%}
            Mobile options UI: the card's open/close row. Hidden at 750px and up, where the body
            below is display: contents, so desktop renders exactly as before. The summary is
            filled by handleCategoryCollapse() from the fields' own selected values.
          {%- endcomment -%}
          <button
            type="button"
            class="product-options__category-toggle"
            aria-expanded="{% if collapsible_starts_open %}true{% else %}false{% endif %}"
            aria-controls="{{ category_body_id }}"
            data-category-toggle
          >
            <span class="visually-hidden">{{ category.title }}:</span>
            <span class="product-options__category-summary" data-category-summary></span>
            <span class="product-options__accordion-icon">
              {%- render 'product-option-chevron' -%}
            </span>
          </button>
          <div class="product-options__category-body" id="{{ category_body_id }}" data-category-body>
        {%- endif -%}
        <div class="product-options__category-notification"></div>
        {% for product_option in category.product_options.value %}
          {% assign title = product_option.product_option_title | downcase %}
          {% if title == 'paint color' or title == 'paint colors' or title == 'color' %}
            {% if product_option.product_option_sets_default.value.id %}
              {% assign default = product_option.product_option_sets_default.value.id %}
            {% endif %}
            {% render 'custom-color-picker',
              product: product_option.product_option_variants.value,
              products: product_option,
              default: default,
              color_type: 'paint',
              title: category.title,
              color_counter: color_counter
            %}
          {% endif %}
          {% if title == 'vinyl color' or title == 'vinyl colors' %}
            {% if product_option.product_option_sets_default.value.id %}
              {% assign default = product_option.product_option_sets_default.value.id %}
            {% endif %}
            {% render 'custom-color-picker',
              product: product_option.product_option_variants.value,
              products: product_option,
              default: default,
              color_type: 'vinyl',
              title: category.title,
              color_counter: color_counter
            %}
          {% endif %}
          {% if title != 'paint color' and title != 'vinyl color' and title != 'paint colors' and title != 'vinyl colors' %}
            {% if product_option.product_option_sets_default.value.id %}
              {% assign default = product_option.product_option_sets_default.value.id %}
            {% endif %}
            {% render 'product-option-accordion', category: category, default: default, product_option: product_option, forloop_index: forloop.index, product_id: product.id %}
          {% endif %}
        {% endfor %}
        {%- if is_collapsible -%}
          </div>
        {%- endif -%}
      </div>
    {% endfor %}

    <div
      id="product-options-total-add"
      class="product-options__total-add product-options__total-add--hide"
    >
      Selection will add
      <span
        id="product-options-totalpriceadd"
        class="product-options__total-price-add"
        >$0.00</span
      >
      to the price
    </div>
    <input type="hidden" value="0" class="product-options__total-addcharge">
  </product-customization-options>
</div>
