{% comment %}
  Product breadcrumb navigation.
  Uses prioritized metaobject paths when available and falls back to the first
  product collection. Desktop keeps the full hierarchy. Mobile shows Home and
  the immediate parent collection in one compact row; the current product
  remains available to assistive technology without repeating the visible title.
{% endcomment %}

{% assign all_breadcrumb_objects = product.metafields.custom.breadcrumb_paths.value | sort: "priority" %}
{% assign active_path = nil %}
{% assign source_flag = "unset" %}

{% if collection %}
  {% for b_path in all_breadcrumb_objects %}
    {% assign b_steps = b_path.steps.value %}
    {% assign latest_step = b_steps.last %}

    {% if latest_step and latest_step.handle == collection.handle %}
      {% assign active_path = b_path %}
      {% assign source_flag = "metaobject" %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if active_path == nil %}
  {% for fallback_path in all_breadcrumb_objects %}
    {% if fallback_path.steps and fallback_path.steps.value != blank %}
      {% assign active_path = fallback_path %}
      {% assign source_flag = "metaobject" %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if source_flag == "unset" and product.collections.first %}
  {% assign default_coll = product.collections.first %}
  {% assign source_flag = "default" %}
{% endif %}

{% style %}
  @media screen and (max-width: 749px) {
    .pdp-breadcrumbs .page-width {
      padding-left: 16px;
      padding-right: 16px;
    }

    .pdp-breadcrumbs .custom-breadcrumbs__navigation {
      align-items: center;
      display: flex;
      min-height: 44px;
      min-width: 0;
      overflow: hidden;
      padding: 8px 0;
      white-space: nowrap;
    }

    .pdp-breadcrumbs .breadcrumb-segment--ancestor {
      display: none;
    }

    .pdp-breadcrumbs .breadcrumb-segment--parent {
      align-items: center;
      display: flex;
      min-width: 0;
    }

    .pdp-breadcrumbs .breadcrumb-segment--parent a {
      display: block;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .pdp-breadcrumbs .breadcrumb-current {
      border: 0;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      height: 1px;
      margin: -1px;
      overflow: hidden;
      padding: 0;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }
  }
{% endstyle %}

<nav class="customBreadcrumbs pdp-breadcrumbs" aria-label="Breadcrumb">
  <div class="custom-breadcrumbs">
    <div class="page-width">
      <div class="custom-breadcrumbs__wrapper">
        <div class="custom-breadcrumbs__navigation">
          {% assign domain_origin = request.origin %}

          {% if source_flag == "metaobject" %}
            <a class="breadcrumb-home" href="{{ domain_origin }}/">Home</a>
            {% assign nav_steps = active_path.steps.value %}
            {% assign nav_titles = active_path.custom_titles.value %}

            {% for nav_coll in nav_steps %}
              {% if nav_coll.handle != blank %}
                <span class="breadcrumb-segment{% unless forloop.last %} breadcrumb-segment--ancestor{% else %} breadcrumb-segment--parent{% endunless %}">
                  {% render 'icon-arrow-right-breadcrumbs' %}
                  {% assign idx = forloop.index0 %}
                  <a href="{{ domain_origin }}/collections/{{ nav_coll.handle }}">
                    {{ nav_titles[idx] | default: nav_coll.title }}
                  </a>
                </span>
              {% endif %}
            {% endfor %}
            <span class="breadcrumb-current">
              {% render 'icon-arrow-right-breadcrumbs' %}
              <span aria-current="page">{{ product.title }}</span>
            </span>

          {% elsif source_flag == "default" %}
            <a class="breadcrumb-home" href="{{ domain_origin }}/">Home</a>
            <span class="breadcrumb-segment breadcrumb-segment--parent">
              {% render 'icon-arrow-right-breadcrumbs' %}
              <a href="{{ domain_origin }}/collections/{{ default_coll.handle }}">{{ default_coll.title }}</a>
            </span>
            <span class="breadcrumb-current">
              {% render 'icon-arrow-right-breadcrumbs' %}
              <span aria-current="page">{{ product.title }}</span>
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</nav>
