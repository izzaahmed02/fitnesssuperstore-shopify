{% doc %}
  Presentation-only September 2026 card for the exact approved product IDs:
  the 119 members of /collections/sale (discount 1741840056636 scope) as of Sep 24.
  @param {product} product - Current product.
  @param {string} [section_id] - Section identifier used by variant refresh.
  @param {boolean} [hide_on_mobile] - Hide the desktop-layout copy on mobile.
{% enddoc %}
{% comment %}
  Reuses the existing LaborDaySaleCard update targets and card CSS.
  Caller selects this campaign instead of (never alongside) the Labor Day card.
  The data marker is also emitted for unavailable variants so the caller cannot
  fall back to an incorrect purchasable-offer card. No inventory or price writes.
{% endcomment %}
{%- liquid
  assign september_ids = '9875868123452,9878150218044,9878465675580,9878467903804,9878468526396,9878468985148,9878474031420,9878477603132,9878478487868,9878484517180,9878486417724,9878487761212,9878488187196,9878489104700,9878523642172,9878524231996,9878526034236,9878530031932,9878533341500,9878536126780,9878540484924,9878545924412,9878546940220,9878547661116,9878550970684,9878553035068,9878553624892,9878555459900,9878558015804,9878561325372,9878562865468,9878565224764,9878565814588,9878586425660,9878595567932,9878600319292,9878600778044,9878601302332,9878603956540,9878614245692,9878623027516,9878627320124,9878635807036,9878636200252,9878638264636,9878700917052,9878880977212,9878882287932,9878885728572,9878886515004,9878888448316,9878889693500,9878890283324,9878890905916,9878891561276,9878892183868,9878908666172,9878910697788,9878912893244,9878922264892,9878926229820,9878928818492,9878950281532,9878952575292,9878952968508,9879006282044,9879034462524,9879078175036,9879127425340,9879133028668,9879136600380,9879142203708,9879142990140,9879160783164,9879165763900,9879173660988,9879180771644,9879183065404,9879188177212,9879188865340,9879189487932,9879191159100,9879191945532,9879192797500,9879194698044,9879194960188,9879195681084,9879197188412,9879210131772,9879214227772,9879218684220,9879221240124,9929985360188,9929986539836,9972913996092,10060368249148,10162197168444,10191983214908,10196188168508,10204291203388,10211454189884,10213188501820,10219025727804,10221238124860,10226754683196,10226775687484,10240114000188,10242947907900,10243298099516,10244856348988,10290339905852,10310913360188,10323080479036,10338979610940,10339479781692,10346655973692,10354483953980,10354513838396,10380780503356' | split: ','
  assign september_product_id = product.id | append: ''
  assign september_now = 'now' | date: '%s' | plus: 0
  assign september_start = '2026-09-08T00:00:00-07:00' | date: '%s' | plus: 0
  assign september_end = '2026-09-30T23:59:59-07:00' | date: '%s' | plus: 0
  assign september_active = false
  if september_ids contains september_product_id
    if september_now >= september_start and september_now < september_end
      assign september_active = true
    endif
  endif
  assign september_variant = product.selected_or_first_available_variant
  assign september_available = false
  if september_variant != blank and september_variant.available
    assign september_available = true
    if september_variant.inventory_management == 'shopify' and september_variant.inventory_policy != 'continue'
      if september_variant.quantity_rule.min > september_variant.inventory_quantity
        assign september_available = false
      endif
    endif
  endif
-%}
{%- if september_active -%}
  <div
    {% if section_id != blank %}id="LaborDaySaleCard{% if hide_on_mobile %}-Desktop{% endif %}-{{ section_id }}"{% endif %}
    class="campaign-sale-container{% if hide_on_mobile %} hide-on-mobile{% endif %}"
    data-september-overstock-2026
  >
    {%- if september_available -%}
      {%- assign september_price = september_variant.price -%}
      {%- assign september_cart_price = september_price | times: 0.9 | round -%}
      <div class="labor-day-sale-card">
        <div class="labor-day-sale-card__row">
          <span class="labor-day-sale-card__badge">September overstock sale</span>
          <span class="labor-day-sale-card__was"><span class="visually-hidden">Regular price </span>{{ september_price | money }}</span>
          <span class="labor-day-sale-card__now"><span class="visually-hidden">Price after discount </span>{{ september_cart_price | money }} in cart</span>
        </div>
        <p class="labor-day-sale-card__meta">10% off applied automatically at checkout · Ends Sept. 30 · While supplies last</p>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
{% stylesheet %}
  .campaign-sale-container[data-september-overstock-2026]:empty {
    display: none !important;
    margin: 0 !important;
  }
{% endstylesheet %}
