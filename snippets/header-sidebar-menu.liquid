{% for link in linklists[settings.sidebarMenu].links %}
  <div class="submenu testt">
    {% if link.links.size > 0 %}
      <a href="{{ link.url }}" class="submenu-title">{{ link.title }}</a>
      <ul>  
        {% for childlink in link.links %}
          <li>
            <a class="submenu-item" href="{{ childlink.url }}">{{ childlink.title }}</a>
          </li>   
        {% endfor %}
      </ul>
    {% else %}
      <a href="{{ link.url }}" class="submenu-title">{{ link.title }}</a>
    {% endif %}
  </div>
{% endfor %}
