                            {% for link in linklists['header-menu-main'].links %}
                                <div class="submenu">
                                   {% if link.links.size > 0 %}
                                    <a href="/collections/all" class="submenu-title">{{ link.title }}</a>
                                    <ul>                                    
                                      <li>
                                         {% for childlink in link.links %}
                                             <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                                         {% endfor %}
                                      </li>                                       
                                    </ul>
                                  {% endif %}
                                </div>
                             {% endfor %}