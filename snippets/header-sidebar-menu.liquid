{% for link in linklists[settings.sidebarMenu].links %}
  <div class="submenu">
    {% if link.links.size > 0 %}
      {% if link.title == "Strength Equipment" %}
        {% assign link_url = "/collections/strength-training-equipment" %}
      {% else %}
        {% assign link_url = "/collections/all" %}
      {% endif %}
      <a href="{{ link_url }}" class="submenu-title">{{ link.title }}</a>
      <ul>  
        {% for childlink in link.links %}
          <li>
            <a class="submenu-item" href="{{ childlink.url }}">{{ childlink.title }}</a>
          </li>   
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endfor %}
