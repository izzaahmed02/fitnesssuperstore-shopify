<script>
document.addEventListener('DOMContentLoaded', () => {
  const subcategoriesDetails = document.querySelector('.collection-hero__related-collections-details');
  
  if (subcategoriesDetails) {
    document.addEventListener('click', (event) => {
      const isClickInside = subcategoriesDetails.contains(event.target);
      
      if (!isClickInside && subcategoriesDetails.hasAttribute('open')) {
        subcategoriesDetails.removeAttribute('open');
      }
    });

    // Ensure clicking the summary toggles the open state
    subcategoriesDetails.querySelector('.mobile-facets__summary').addEventListener('click', (event) => {
      event.preventDefault();
      subcategoriesDetails.toggleAttribute('open');
    });
  }
});
</script>
