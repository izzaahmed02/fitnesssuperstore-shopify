{%- comment -%}
  Optional product short description for the main purchase summary.
  Render only when the product has a nonblank custom.short_description.
  This is dynamic for all product pages using the PDP purchase-area sections;
  never hardcode product IDs or copy inside the theme.
{%- endcomment -%}
{%- assign pdp_short_description = product.metafields.custom.short_description.value -%}
{%- if pdp_short_description != blank -%}
  <p class="pdp-short-description" data-pdp-short-description>
    {{- pdp_short_description | escape | newline_to_br -}}
  </p>
{%- endif -%}
