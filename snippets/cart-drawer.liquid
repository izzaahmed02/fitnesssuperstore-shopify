            <span class="frequently-bought-item__rating-count">(${product.reviewCount} reviews)</span>
          </div>
          <div class="frequently-bought-item__prices">
            <span class="frequently-bought-item__compare-price">As high as: $${product.comparePrice.toFixed(2)}</span>
            <span class="frequently-bought-item__price">$${product.price.toFixed(2)}</span>
          </div>
          <button class="frequently-bought-item__add-btn" data-variant-id="${product.variantId}">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.70711 15.2929C4.07714 15.9229 4.52331 17 5.41421 17H17M17 17C15.8954 17 15 17.8954 15 19C15 20.1046 15.8954 21 17 21C18.1046 21 19 20.1046 19 19C19 17.8954 18.1046 17 17 17ZM9 19C9 20.1046 8.10457 21 7 21C5.89543 21 5 20.1046 5 19C5 17.8954 5.89543 17 7 17C8.10457 17 9 17.8954 9 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Add To Cart
          </button>
        </div>
      `;
    }).join('');

    desktopContainer.innerHTML = productsHTML;
    mobileContainer.innerHTML = productsHTML;

    // Add click event listeners to Add to Cart buttons
    document.querySelectorAll('.frequently-bought-item__add-btn').forEach(button => {
      button.addEventListener('click', async function(e) {
        e.preventDefault();
        const variantId = this.getAttribute('data-variant-id');
        await addToCart(variantId, this);
      });
    });
  }

  // Function to add product to cart
  async function addToCart(variantId, button) {
    button.disabled = true;
    button.innerHTML = 'Adding...';

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      });

      if (response.ok) {
        // Refresh cart
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();
        
        // Update cart UI
        button.innerHTML = '✓ Added';
        setTimeout(() => {
          button.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.70711 15.2929C4.07714 15.9229 4.52331 17 5.41421 17H17M17 17C15.8954 17 15 17.8954 15 19C15 20.1046 15.8954 21 17 21C18.1046 21 19 20.1046 19 19C19 17.8954 18.1046 17 17 17ZM9 19C9 20.1046 8.10457 21 7 21C5.89543 21 5 20.1046 5 19C5 17.8954 5.89543 17 7 17C8.10457 17 9 17.8954 9 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Add To Cart
          `;
          button.disabled = false;
        }, 2000);

        // Trigger cart update event
        document.dispatchEvent(new CustomEvent('cart:updated'));
        
        // Reload the cart drawer to show updated items
        location.reload();
      } else {
        throw new Error('Failed to add to cart');
      }
    } catch (error) {
      console.error('Error adding to cart:', error);
      button.innerHTML = 'Error - Try Again';
      button.disabled = false;
    }
  }

  // Setup mobile carousel navigation
  function setupMobileCarousel() {
    const prevBtn = document.querySelector('.frequently-bought-carousel__nav--prev');
    const nextBtn = document.querySelector('.frequently-bought-carousel__nav--next');
    const container = document.getElementById('FrequentlyBoughtProductsMobile');

    if (!prevBtn || !nextBtn || !container) return;

    prevBtn.addEventListener('click', () => {
      container.scrollBy({
        left: -220,
        behavior: 'smooth'
      });
    });

    nextBtn.addEventListener('click', () => {
      container.scrollBy({
        left: 220,
        behavior: 'smooth'
      });
    });
  }
</script>

