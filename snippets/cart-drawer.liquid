  <link rel="preload" href="{{ 'quantity-popover.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript>
  <link rel="stylesheet" href="{{ 'quantity-popover.css' | asset_url }}">
</noscript>
{% comment %} {{ 'component-card.css' | asset_url | stylesheet_tag }} {% endcomment %}
    <link
      rel="stylesheet"
      href="{{ 'component-card.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >


<script src="{{ 'cart.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>
<style>
    .drawer {
        visibility: hidden;
        display: none;
    }
    .extra-option-item.apo-cart-item-mini {
      display: none !important;
    }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
      <div class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
          role="dialog"
          aria-modal="true"
          aria-label="{{ 'sections.cart.title' | t }}"
          tabindex="-1"
        >
        {% if cart == empty %}
          <div class="drawer__inner-empty">
            <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
              <div class="cart-drawer__empty-content">
                <div class="cart__empty-text drawer__heading">{{ 'sections.cart.empty' | t }}</div>
                <div class="empty-cart__wrapper">
                  <a href="{{ routes.all_products_collection_url }}" class="button">
                    {{ 'general.continue_shopping' | t }}
                  </a>
                  <button class="drawer__close"
                    type="button"
                    onclick="this.closest('cart-drawer').close()"
                    aria-label="{{ 'accessibility.close' | t }}"
                  >
                      {% render 'drawer-close' %}
                  </button>
                </div>
                {% if shop.customer_accounts_enabled and customer == null %}
                  <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                  <p class="cart__login-paragraph">
                      {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                  </p>
                {% endif %}
              </div>
            </div>
            {% if settings.cart_drawer_collection != blank %}
                <div class="cart-drawer__collection">
                    {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
                </div>
            {% endif %}
          </div>
        {% endif %}
        <div class="drawer__header">
          <div class="drawer__heading">
            {% assign filtered_count = 0 %}
            {% for item in cart.items %}
              {% unless item.product.tags contains 'avisplus-product-options' %}
                  {% assign filtered_count = filtered_count | plus: item.quantity %}
              {% endunless %}
            {% endfor %}
            Cart preview (<span data-count="{{ filtered_count }}">{{ filtered_count }}</span>)
          </div>
          <button class="drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'drawer-close' %}
          </button>
        </div>
       
        <cart-drawer-items {% if cart == empty %} class="is-empty" {% endif %}>
          <form action="{{ routes.cart_url }}"
                  id="CartDrawer-Form"
                  class="cart__contents cart-drawer__form"
                  method="post"
          >
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              {% if cart != empty %}
                <div class="drawer__cart-items-wrapper">
                  <table class="cart-items" role="table">
                    <div role="rowgroup">
                      {% for item in cart.items %}
                       
                            <tr
                              id="CartDrawer-Item-{{ forloop.index }}"
                              class="cart-item
                              {% if item.product.tags contains 'avisplus-product-options' %} extra-option-item
                              {% else %} cart-item-new{% endif %}  apo-cart-item-mini"
                              data-key="{{ item.key }}"
                              role="row"
                            >
                            <!-- Product Image -->
                            <td class="cart-item__media" role="cell">
                              {% if item.image %}
                                <a href="{{ item.url }}" class="cart-item__link"
                                    tabindex="-1" aria-hidden="true"></a>
                                <div>
                                    <img
                                      class="cart-item__image"
                                      src="{{ item.image | image_url: width: 300 }}"
                                      alt="{{ item.image.alt | escape }}"
                                      loading="lazy"
                                      width="150"
                                      height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                                    >
                                </div>
                              {% endif %}
                            </td>
                            <!-- Product details -->
                            <td class="cart-item__details" role="cell">
                              <div class="cart-title">
                                {% if item.product.tags contains 'avisplus-product-options' %}
                                    <span class="cart-item__name extra-option-title h4 break">
                                      {{ item.variant.title | escape }}
                                    </span>
                                {% else %}
                                    <a href="{{ item.url }}"
                                      class="cart-item__name h4 break">
                                      {{ item.product.title | escape }}
                                    </a>
                                {% endif %}
                                <cart-remove-button>
                                    <button type="button"
                                        class="cart-remove-button"
                                        data-key="{{ item.key }}"
                                        aria-label="Remove {{ item.product.title }}"
                                    >
                                        {% render 'icon-remove' %}
                                    </button>
                                </cart-remove-button>
                              </div>
                                       {% if item.product.template_suffix contains 'variants' %}
                                          {% if item.product.metafields.custom.warranty %}
                                              <dl style="margin-bottom: 2px;">
                                                  <div class="product-option">
                                                <dt> Warranty</dt>
                                                <dd>  {{ item.product.metafields.custom.warranty }}</dd>
                                                </div>
                                                </dl>

                                          {% endif %}
                                          {%- if item.product.has_only_default_variant == false
                                                or item.properties.size != 0
                                                or item.selling_plan_allocation != null
                                                -%}
                                                    <dl>
                                                        {%- if item.product.has_only_default_variant == false -%}
                                                            {%- for option in item.options_with_values -%}
                                                                {% unless custom_color_found and option.name == 'Color' %}
                                                                    <div class="product-option">
                                                                        <dt>{{ option.name }}:</dt>
                                                                        <dd>{{ option.value }}</dd>
                                                                    </div>
                                                                {% endunless %}
                                                            {%- endfor -%}
                                                        {%- endif -%}
                                                    </dl>
                                                  {%- endif  -%}
                                          {% endif %}

{% comment %} ========== PROCESSING TIME - FIXED VERSION ========== {% endcomment %}
{% unless item.product.tags contains 'avisplus-product-options' %}
  {% comment %} Check if processing time is already in custom properties {% endcomment %}
  {% assign has_processing_time_property = false %}
  {% for prop in item.properties %}
    {% assign p_name = prop.first | downcase %}
    {% if p_name contains 'processing' or p_name contains 'ships' %}
      {% assign has_processing_time_property = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  
  {% comment %} Only show if NOT already in properties {% endcomment %}
  {% unless has_processing_time_property %}
    {% comment %} Get processing time - variant takes priority over product {% endcomment %}
    {% assign processing_time_to_show = null %}
    
    {% comment %} First try to get from variant metafield {% endcomment %}
    {% if item.variant.metafields.custom.processing_time_long_variant != blank %}
      {% assign processing_time_to_show = item.variant.metafields.custom.processing_time_long_variant %}
    {% comment %} Fall back to product metafield {% endcomment %}
    {% elsif item.product.metafields.custom.processing_time_long != blank %}
      {% assign processing_time_to_show = item.product.metafields.custom.processing_time_long %}
    {% endif %}
    
    {% comment %} Only display if we have a processing time to show {% endcomment %}
    {% if processing_time_to_show != blank %}
      <dl style="margin-bottom: 2px;">
        <div class="product-option">
          <dt>Processing Time:</dt>
          <dd>{{ processing_time_to_show }}</dd>
        </div>
      </dl>
    {% endif %}
  {% endunless %}
{% endunless %}
{% comment %} ========== END PROCESSING TIME ========== {% endcomment %}


                               
                            {% assign extra_props = "" %}
{% for prop in item.properties %}
  {% assign p_name = prop.first %}
  {% assign p_name_lower = p_name | downcase %}
  {% assign p_value = prop.last %}
  {% assign first_char = p_name | slice: 0, 1 %}
  
  {% comment %} Skip empty, hidden, and processing time properties {% endcomment %}
  {% if p_name == blank or p_value == blank or first_char == '_' %}
    {% continue %}
  {% endif %}
  
  {% comment %} Skip if property name contains processing or ships {% endcomment %}
  {% if p_name_lower contains 'processing' or p_name_lower contains 'ships from' or p_name_lower contains 'processing time' %}
    {% continue %}
  {% endif %}
  
  {% comment %} Add this property to the output {% endcomment %}
  {%- capture extra_props -%}
    {{ extra_props }}
    <div class="product-option">
      <dt>{{ p_name }}:</dt>
      <dd>{{ p_value }}</dd>
    </div>
  {%- endcapture -%}
{% endfor %}

{% comment %} Display filtered properties {% endcomment %}
{% if extra_props != "" %}
  <dl>
    {{ extra_props }}
  </dl>
{% endif %}
                              <quantity-popover class="cart-quantity-price {% if item.properties._apo_option and item.properties._apo_order %} apo-hide-item{% endif %}">
                                <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                                  <span class="quantity-text">QTY: </span>
                                
                                  <span class="quantity-text">{{ item.quantity }}</span>
                                
                                </div>
                                {% if item.original_price != item.final_price %}
                                  <div class="cart-item__discounted-prices">
                                    <s class="cart-item__old-price product-option">
                                      {{ item.original_price | money }}
                                    </s>
                                    <strong class="cart-item__final-price product-option">
                                      {{ item.final_price | money }}
                                    </strong>
                                  </div>
                                {% else %}
                                  {% unless item.product.tags contains 'avisplus-product-options' %}
                                    <div class="extra-price product-option">
                                      {{ item.original_price | money }}
                                    </div>
                                  {% endunless %}
                                {% endif %}
                              </quantity-popover>
                            </td>
                          </tr>
                     
                      {% endfor %}
                    </div>
                  </table>
                </div>
              {% endif %}
              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                  {{ 'accessibility.loading' | t }}
              </p>
            </div>
           
          </form>
        </cart-drawer-items>
        <div class="drawer__footer">
            <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
                {% unless cart == empty %}
                    <div class="total-wrapper">
                        Total <span class="cart-total">{{ cart.total_price | money }}</span>
                    </div>
                {% endunless %}
                <a class="cart-link" href="/cart">View/Edit cart</a>
            </div>
        </div>
    </div>
  </div>
</cart-drawer>

