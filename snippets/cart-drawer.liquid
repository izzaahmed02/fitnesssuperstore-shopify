<script>
	document.addEventListener("DOMContentLoaded", () => {
		const cartItems = document.querySelectorAll('.cart-item-new');
		let totalContentCount = 0;

		// Click event for "show-extra" buttons
		document.querySelectorAll('.cart-item-new .show-extra').forEach(button => {
			button.addEventListener('click', () => {
				button.classList.toggle('active');
				let nextElement = button.closest('.cart-item-new')?.nextElementSibling;

				while (nextElement && !nextElement.classList.contains('cart-item-new')) {
					if (nextElement.classList.contains('extra-option-item')) {
						nextElement.classList.toggle('toggle');
					}
					nextElement = nextElement.nextElementSibling;
				}
			});
		});

		// Iterate through each cart item and update its details
		cartItems.forEach(cartItem => {
			let count = 0;
			let totalSum = 0;
			let hasExtraContent = false;
			let nextElement = cartItem.nextElementSibling;

			while (nextElement && !nextElement.classList.contains('cart-item-new')) {
				if (nextElement.classList.contains('extra-option-item')) {
					hasExtraContent = true;
					count++;
					totalContentCount++;

					const priceElement = nextElement.querySelector('.extra-option-price');
					if (priceElement) {
						const price = parseFloat(priceElement.textContent.replace('$', '').trim());
						totalSum += isNaN(price) ? 0 : price;
					}
				}
				nextElement = nextElement.nextElementSibling;
			}

			// Update quantity display if the element exists
			const quantityDisplay = cartItem.querySelector('.extra-quantity .value');
			if (quantityDisplay) {
				quantityDisplay.textContent = count;
			}

			// Update price display if the element exists
			const priceDisplay = cartItem.querySelector('.options-price');
			if (priceDisplay) {
				priceDisplay.textContent = `$${totalSum.toFixed(2)}`;
			}

			// Show or hide the "show-extra" button based on extra content availability
			const showExtraButton = cartItem.querySelector('.show-extra');
			if (showExtraButton) {
				showExtraButton.style.display = hasExtraContent ? 'flex' : 'none';
			}
		});

		// Update total cart count in the UI
		updateCartCount(totalContentCount);

    // Initialize Frequently Bought Together
    frequentlyBoughtInstance = new FrequentlyBoughtTogether();

    // Listen for cart updates (from remove buttons, etc.)
    document.addEventListener('cart:updated', () => {
      console.log('[Frequently Bought] Cart updated event received');
      if (frequentlyBoughtInstance) {
        setTimeout(() => {
          frequentlyBoughtInstance.refresh();
        }, 300); // Small delay to let cart update complete
      }
    });

    // Also watch for changes to the cart items wrapper (catches removals)
    const cartItemsWrapper = document.querySelector('.drawer__cart-items-wrapper');
    if (cartItemsWrapper) {
      const observer = new MutationObserver((mutations) => {
        console.log('[Frequently Bought] Cart items changed, checking...');
        
        // Check if containers still exist
        const desktopExists = document.getElementById('FrequentlyBoughtProducts');
        const mobileExists = document.getElementById('FrequentlyBoughtProductsMobile');
        
        console.log('[Frequently Bought] Desktop container exists:', !!desktopExists);
        console.log('[Frequently Bought] Mobile container exists:', !!mobileExists);
        
        if (!desktopExists && !mobileExists) {
          console.log('[Frequently Bought] Containers removed, waiting for recreation...');
          // Containers were removed, wait a bit and try to reinitialize
          setTimeout(() => {
            const newDesktop = document.getElementById('FrequentlyBoughtProducts');
            const newMobile = document.getElementById('FrequentlyBoughtProductsMobile');
            
            if (newDesktop || newMobile) {
              console.log('[Frequently Bought] Containers recreated, reinitializing...');
              frequentlyBoughtInstance = new FrequentlyBoughtTogether();
            } else {
              console.log('[Frequently Bought] Containers still not found');
            }
          }, 1000);
        } else if (frequentlyBoughtInstance) {
          // Containers exist, just refresh
          setTimeout(() => {
            frequentlyBoughtInstance.refresh();
          }, 500);
        }
      });

      observer.observe(cartItemsWrapper, {
        childList: true,
        subtree: true
      });
      
      console.log('[Frequently Bought] MutationObserver attached to cart items');
    }

    // Listen for cart drawer opening (in case it was updated while closed)
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer) {
      const drawerObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'class') {
            const isOpen = cartDrawer.classList.contains('active') || 
                          cartDrawer.classList.contains('is-open') ||
                          !cartDrawer.classList.contains('is-empty');
            if (isOpen && frequentlyBoughtInstance) {
              console.log('[Frequently Bought] Drawer opened, refreshing...');
              setTimeout(() => {
                frequentlyBoughtInstance.refresh();
              }, 300);
            }
          }
        });
      });

      drawerObserver.observe(cartDrawer, {
        attributes: true,
        attributeFilter: ['class']
      });
    }
	});

	// Function to update the cart count in the drawer and header
	function updateCartCount(totalContentCount) {
    const cartCountBubble = document.querySelector('.cart-count-bubble')
    if (cartCountBubble) {
      const drawerHeadingSpan = document.querySelector('.drawer__heading span');
      if (drawerHeadingSpan) {
        cartCountBubble.querySelector('span').innerHTML = drawerHeadingSpan.innerHTML;
        cartCountBubble.classList.remove('hidden');
      }
    }
	}

  // Store instance globally so we can refresh it
  let frequentlyBoughtInstance = null;

  /**
   * Frequently Bought Together Class
   */
  class FrequentlyBoughtTogether {
    constructor() {
      this.desktopContainer = document.getElementById('FrequentlyBoughtProducts');
      this.mobileContainer = document.getElementById('FrequentlyBoughtProductsMobile');
      this.products = [];
      this.init();
    }

    init() {
      if (!this.desktopContainer && !this.mobileContainer) {
        console.warn('[Frequently Bought] Containers not found');
        return;
      }
      this.loadProducts();
      this.setupMobileCarousel();
    }

    // Method to refresh products (called after cart updates)
    refresh() {
      console.log('[Frequently Bought] Refreshing products...');
      
      // Re-get containers in case they were replaced in DOM
      this.desktopContainer = document.getElementById('FrequentlyBoughtProducts');
      this.mobileContainer = document.getElementById('FrequentlyBoughtProductsMobile');
      
      console.log('[Frequently Bought] Desktop container found:', !!this.desktopContainer);
      console.log('[Frequently Bought] Mobile container found:', !!this.mobileContainer);
      
      if (!this.desktopContainer && !this.mobileContainer) {
        console.warn('[Frequently Bought] Containers not found after refresh');
        return;
      }
      
      // Clear existing content
      if (this.desktopContainer) {
        this.desktopContainer.innerHTML = '';
      }
      if (this.mobileContainer) {
        this.mobileContainer.innerHTML = '';
      }
      
      // Reload products
      this.loadProducts();
    }

    async loadProducts() {
      try {
        console.log('[Frequently Bought] Starting to load products...');
        
        const cart = await this.getCart();
        console.log('[Frequently Bought] Cart data:', cart);
        
        if (!cart || cart.items.length === 0) {
          console.log('[Frequently Bought] Cart is empty');
          this.hideContainers();
          return;
        }

        this.products = await this.getCollectionProducts(cart);
        console.log('[Frequently Bought] Fetched products:', this.products);

        if (this.products.length === 0) {
          console.log('[Frequently Bought] No products found');
          this.hideContainers();
          return;
        }

        console.log('[Frequently Bought] Rendering', this.products.length, 'products');
        this.renderProducts();
      } catch (error) {
        console.error('[Frequently Bought] Error:', error);
        this.hideContainers();
      }
    }

    async getCart() {
      try {
        const response = await fetch('/cart.js');
        const cart = await response.json();
        
        if (cart.items && cart.items.length > 0) {
          console.log('[Frequently Bought] Sample cart item:', {
            handle: cart.items[0].handle,
            product_id: cart.items[0].product_id,
            title: cart.items[0].title
          });
        }
        
        return cart;
      } catch (error) {
        console.error('[Frequently Bought] Error fetching cart:', error);
        return null;
      }
    }

    async getCollectionProducts(cart) {
      try {
        console.log('[Frequently Bought] Getting collection products');
        
        const cartProductIds = cart.items.map(item => item.product_id);
        console.log('[Frequently Bought] Excluding IDs:', cartProductIds);

        const firstCartItem = cart.items[0];
        if (!firstCartItem) {
          console.log('[Frequently Bought] No cart item found');
          return [];
        }

        console.log('[Frequently Bought] Using item:', firstCartItem.handle);

        const productResponse = await fetch(`/products/${firstCartItem.handle}.js`);
        if (!productResponse.ok) {
          console.error('[Frequently Bought] Product fetch failed:', productResponse.status);
          return await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
        }
        
        const productData = await productResponse.json();
        console.log('[Frequently Bought] Product collections:', productData.collections);

        if (!productData.collections || productData.collections.length === 0) {
          console.warn('[Frequently Bought] No collections, using recommendations');
          return await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
        }

        const collectionHandle = productData.collections[0].handle;
        console.log('[Frequently Bought] Collection:', collectionHandle);

        const collectionProducts = await this.fetchCollectionProducts(collectionHandle, cartProductIds);
        console.log('[Frequently Bought] Found', collectionProducts.length, 'products');

        if (collectionProducts.length < 3) {
          const recommendations = await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
          const combined = [...collectionProducts, ...recommendations];
          return this.deduplicateProducts(combined).slice(0, 6);
        }

        return collectionProducts.slice(0, 6);
      } catch (error) {
        console.error('[Frequently Bought] Error:', error);
        return [];
      }
    }

    async fetchCollectionProducts(collectionHandle, excludeProductIds = []) {
      try {
        const url = `/collections/${collectionHandle}/products.json?limit=20`;
        console.log('[Frequently Bought] Fetching:', url);
        
        const response = await fetch(url);
        if (!response.ok) {
          console.error('[Frequently Bought] Fetch failed:', response.status);
          return [];
        }
        
        const data = await response.json();
        console.log('[Frequently Bought] Raw products:', data.products?.length || 0);

        if (!data.products || data.products.length === 0) {
          return [];
        }

        const products = data.products
          .filter(product => !excludeProductIds.includes(product.id))
          .filter(product => product.available)
          .map(product => this.formatProductData(product));

        console.log('[Frequently Bought] Filtered to:', products.length);
        return products;
      } catch (error) {
        console.error('[Frequently Bought] Fetch error:', error);
        return [];
      }
    }

    async getRecommendedProducts(productId, excludeProductIds = []) {
      try {
        const response = await fetch(`/recommendations/products.json?product_id=${productId}&limit=6`);
        const data = await response.json();

        if (!data.products || data.products.length === 0) {
          return [];
        }

        return data.products
          .filter(product => !excludeProductIds.includes(product.id))
          .filter(product => product.available)
          .map(product => this.formatProductData(product));
      } catch (error) {
        console.error('[Frequently Bought] Recommendations error:', error);
        return [];
      }
    }

    formatProductData(product) {
      const variant = product.variants.find(v => v.available) || product.variants[0];
      const comparePrice = variant.compare_at_price ? variant.compare_at_price / 100 : null;
      const price = variant.price / 100;
      const image = product.featured_image || product.images[0] || 'https://via.placeholder.com/300x300';

      return {
        id: `product-${product.id}`,
        productId: product.id,
        handle: product.handle,
        title: product.title,
        image: image,
        rating: null,
        reviewCount: 0,
        comparePrice: comparePrice,
        price: price,
        variantId: variant.id.toString(),
        available: variant.available
      };
    }

    renderProducts() {
      console.log('[Frequently Bought] Rendering products:', this.products.length);
      console.log('[Frequently Bought] Desktop container:', this.desktopContainer);
      console.log('[Frequently Bought] Mobile container:', this.mobileContainer);
      
      const productsHTML = this.products.map(product => this.createProductCard(product)).join('');
      console.log('[Frequently Bought] Generated HTML length:', productsHTML.length);

      if (this.desktopContainer) {
        this.desktopContainer.innerHTML = productsHTML;
        console.log('[Frequently Bought] Desktop products rendered');
      }

      if (this.mobileContainer) {
        this.mobileContainer.innerHTML = productsHTML;
        console.log('[Frequently Bought] Mobile products rendered');
      }

      this.attachEventListeners();
      console.log('[Frequently Bought] Event listeners attached');
    }

    createProductCard(product) {
      const comparePrice = product.comparePrice 
        ? `<span class="frequently-bought-item__compare-price">As high as: $${product.comparePrice.toFixed(2)}</span>`
        : '';

      const rating = product.rating 
        ? `<div class="frequently-bought-item__rating">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <span>${product.rating.toFixed(1)}</span>
            ${product.reviewCount > 0 ? `<span class="frequently-bought-item__rating-count">(${product.reviewCount} reviews)</span>` : ''}
          </div>`
        : '';

      return `
        <div class="frequently-bought-item" data-product-id="${product.id}">
          <div class="frequently-bought-item__image">
            <img src="${product.image}" alt="${product.title}" loading="lazy">
          </div>
          <h4 class="frequently-bought-item__title">${product.title}</h4>
          ${rating}
          <div class="frequently-bought-item__prices">
            ${comparePrice}
            <span class="frequently-bought-item__price">$${product.price.toFixed(2)}</span>
          </div>
          <button class="frequently-bought-item__add-btn" data-variant-id="${product.variantId}" data-product-title="${product.title}">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.70711 15.2929C4.07714 15.9229 4.52331 17 5.41421 17H17M17 17C15.8954 17 15 17.8954 15 19C15.8954 21 17 21C18.1046 21 19 20.1046 19 19C19 17.8954 18.1046 17 17 17ZM9 19C9 20.1046 8.10457 21 7 21C5.89543 21 5 20.1046 5 19C5 17.8954 5.89543 17 7 17C8.10457 17 9 17.8954 9 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Add To Cart
          </button>
        </div>
      `;
    }

    attachEventListeners() {
      document.querySelectorAll('.frequently-bought-item__add-btn').forEach(button => {
        button.addEventListener('click', (e) => this.handleAddToCart(e));
      });
    }

    async handleAddToCart(event) {
      event.preventDefault();
      const button = event.currentTarget;
      const variantId = button.getAttribute('data-variant-id');
      const productTitle = button.getAttribute('data-product-title');
      
      button.disabled = true;
      const originalHTML = button.innerHTML;
      button.innerHTML = 'Adding...';

      try {
        // Add to cart
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });

        if (!response.ok) throw new Error('Failed to add');

        // Get updated cart
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();
        console.log('[Frequently Bought] Cart updated:', cart);

        // Update cart count in header
        const cartCountBubble = document.querySelector('.cart-count-bubble');
        if (cartCountBubble) {
          const countSpan = cartCountBubble.querySelector('span');
          if (countSpan) {
            countSpan.textContent = cart.item_count;
            cartCountBubble.classList.remove('hidden');
          }
        }

        // Update drawer heading count
        const drawerHeadingSpan = document.querySelector('.drawer__heading span');
        if (drawerHeadingSpan) {
          drawerHeadingSpan.textContent = cart.item_count;
          drawerHeadingSpan.setAttribute('data-count', cart.item_count);
        }

        // Update cart total
        const cartTotal = document.querySelector('.cart-total');
        if (cartTotal) {
          cartTotal.textContent = this.formatMoney(cart.total_price);
        }

        // Refresh cart items without breaking frequently bought
        await this.updateCartItemsList(cart);

        // Show success message
        button.innerHTML = '✓ Added';
        
        // Trigger Shopify theme cart update (if your theme has this)
        if (typeof Shopify !== 'undefined' && Shopify.theme && Shopify.theme.cart) {
          Shopify.theme.cart.refresh();
        }

        // Trigger cart update event for other scripts
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        
        // Reset button after delay
        setTimeout(() => {
          button.innerHTML = originalHTML;
          button.disabled = false;
        }, 2000);

      } catch (error) {
        console.error('[Frequently Bought] Error adding to cart:', error);
        button.innerHTML = 'Error';
        setTimeout(() => {
          button.innerHTML = originalHTML;
          button.disabled = false;
        }, 2000);
      }
    }

    async updateCartItemsList(cart) {
      try {
        console.log('[Frequently Bought] Updating cart items list');
        
        // Fetch the cart section HTML to get updated cart items
        const response = await fetch(window.location.pathname + '?section_id=cart-drawer');
        const html = await response.text();
        
        // Parse the HTML
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        // Get the new cart items table
        const newCartItemsWrapper = doc.querySelector('.drawer__cart-items-wrapper');
        const currentCartItemsWrapper = document.querySelector('.drawer__cart-items-wrapper');
        
        if (newCartItemsWrapper && currentCartItemsWrapper) {
          // Replace only the cart items table
          currentCartItemsWrapper.innerHTML = newCartItemsWrapper.innerHTML;
          console.log('[Frequently Bought] Cart items list updated');
          
          // Re-run the cart items initialization script if it exists
          const cartItems = document.querySelectorAll('.cart-item-new');
          if (cartItems.length > 0) {
            // Re-initialize show-extra buttons
            document.querySelectorAll('.cart-item-new .show-extra').forEach(button => {
              button.addEventListener('click', () => {
                button.classList.toggle('active');
                let nextElement = button.closest('.cart-item-new')?.nextElementSibling;
                while (nextElement && !nextElement.classList.contains('cart-item-new')) {
                  if (nextElement.classList.contains('extra-option-item')) {
                    nextElement.classList.toggle('toggle');
                  }
                  nextElement = nextElement.nextElementSibling;
                }
              });
            });
          }
        }
      } catch (error) {
        console.error('[Frequently Bought] Error updating cart items list:', error);
      }
    }

    formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    setupMobileCarousel() {
      if (!this.mobileContainer || typeof jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') {
        console.log('[Frequently Bought] Slick not available');
        return;
      }

      setTimeout(() => {
        const $container = jQuery(this.mobileContainer);
        
        if ($container.hasClass('slick-initialized')) {
          $container.slick('unslick');
        }

        $container.slick({
          slidesToShow: 1,
          slidesToScroll: 1,
          arrows: true,
          dots: true,
          infinite: false,
          speed: 300,
          adaptiveHeight: true
        });
      }, 100);
    }

    deduplicateProducts(products) {
      const seen = new Set();
      return products.filter(product => {
        if (seen.has(product.productId)) return false;
        seen.add(product.productId);
        return true;
      });
    }

    hideContainers() {
      if (this.desktopContainer) {
        this.desktopContainer.closest('.frequently-bought-wrapper')?.classList.add('hidden');
      }
      if (this.mobileContainer) {
        this.mobileContainer.closest('.frequently-bought-wrapper')?.classList.add('hidden');
      }
    }
  }

</script>

