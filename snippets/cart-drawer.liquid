{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}


<script src="{{ 'cart.js' | asset_url }}" defer></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer></script>

<style>
    .drawer {
        visibility: hidden;
    }
</style>
<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
    <div id="CartDrawer" class="cart-drawer">
        <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
        <div
                class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
                role="dialog"
                aria-modal="true"
                aria-label="{{ 'sections.cart.title' | t }}"
                tabindex="-1">
            {% if cart == empty %}
                <div class="drawer__inner-empty">
                    <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
                        <div class="cart-drawer__empty-content">
                            <div class="cart__empty-text drawer__heading">{{ 'sections.cart.empty' | t }}</div>
                            <div class="empty-cart__wrapper">
                                <a href="{{ routes.all_products_collection_url }}" class="button">
                                    {{ 'general.continue_shopping' | t }}
                                </a>
                                <button
                                        class="drawer__close"
                                        type="button"
                                        onclick="this.closest('cart-drawer').close()"
                                        aria-label="{{ 'accessibility.close' | t }}">
                                    {% render 'drawer-close' %}
                                </button>
                            </div>
                            {% if shop.customer_accounts_enabled and customer == null %}
                                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                                <p class="cart__login-paragraph">
                                    {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    {% if settings.cart_drawer_collection != blank %}
                        <div class="cart-drawer__collection">
                            {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            <div class="drawer__header">
                <div class="drawer__heading">
                    Cart preview (<span data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>)
                </div>
                <button
                        class="drawer__close"
                        type="button"
                        onclick="this.closest('cart-drawer').close()"
                        aria-label="{{ 'accessibility.close' | t }}">
                    {% render 'drawer-close' %}
                </button>
            </div>
            {% comment %} <div data-count="{{ cart.item_count }}" class="cart-drawer__subheading">
              You have <span>{{ cart.item_count }}</span> items in your cart
            </div> {% endcomment %}
            <cart-drawer-items {% if cart == empty %} class="is-empty" {% endif %}>
                <form
                        action="{{ routes.cart_url }}"
                        id="CartDrawer-Form"
                        class="cart__contents cart-drawer__form"
                        method="post">
                    <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
                        {% if cart != empty %}
                            <div class="drawer__cart-items-wrapper">
                                <table class="cart-items" role="table">
                                    <div role="rowgroup">
                                        {% for item in cart.items %}
                                            {% if item.product.title != 'Warranty' and item.product.title != 'Full Assembly & Installation' or item.properties._is_color_option %}
                                                <tr id="CartDrawer-Item-{{ forloop.index }}" class="cart-item
                                                {% if item.properties._parent_product_id != blank or item.properties._option_title != blank %}
                                                  extra-option-item
                                                {% else %}
                                                  cart-item-new
                                                {% endif %}
                                                 {% if item.variant.title contains 'Custom Color' or item.variant.title contains 'Color' or item.variant.title contains 'color' %}
                                                 color-option-item
                                                 {% endif %}
                                                 apo-cart-item-mini"
                                                    data-key="{{ item.key }}"
                                                    data-index="{{ forloop.index }}"
                                                    role="row">
                                                    <!-- Product Image -->
                                                    <td class="cart-item__media" role="cell">
                                                        {% if item.image %}
                                                            <a href="{{ item.url }}" class="cart-item__link"
                                                               tabindex="-1" aria-hidden="true"></a>
                                                            <div>
                                                                <img
                                                                        class="cart-item__image"
                                                                        src="{{ item.image | image_url: width: 300 }}"
                                                                        alt="{{ item.image.alt | escape }}"
                                                                        loading="lazy"
                                                                        width="150"
                                                                        height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}">
                                                            </div>
                                                        {% else %}
                                                            <a href="{{ item.url }}" class="cart-item__link"
                                                               tabindex="-1" aria-hidden="true"></a>
                                                            <div>
                                                                {{ 'product-1' | placeholder_svg_tag }}
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                    <td class="cart-item__details" role="cell">
                                                        <div class="cart-title">


                                                            {% if item.properties._parent_product_id != blank or item.properties._option_title != blank %}
                                                                <span class="cart-item__name extra-option-title h4 break">
                                                                     {% assign cleaned_title = item.variant.title %}

                                                                    {% if product_title contains "($" or product_title contains "(+$" %}
                                                                        {% assign parts = product_title | split: ")" %}
                                                                        {% if parts.size > 1 %}
                                                                            {% assign first_part = parts | first | append: ")" %}
                                                                            {% if first_part contains "$" %}
                                                                                {% assign cleaned_title = product_title | remove_first: first_part | strip %}
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endif %}

                                                                    {% if cleaned_title contains "($" or cleaned_title contains "(+$" %}
                                                                        {% assign last_bracket_index = cleaned_title | split: "(" | size | minus: 1 %}
                                                                        {% if last_bracket_index > 0 %}
                                                                            {% assign parts = cleaned_title | split: "(" %}
                                                                            {% assign last_part = "(" | append: parts[last_bracket_index] %}
                                                                            {% if last_part contains "$" and last_part contains ")" %}
                                                                                {% assign cleaned_title = cleaned_title | remove: last_part | strip %}
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endif %}
                                                                    {{ cleaned_title | escape }}
                                                                </span>
                                                            {% else %}
                                                                <a href="{{ item.url }}"
                                                                   class="cart-item__name h4 break">
                                                                    {{ item.product.title | escape }}
                                                                </a>
                                                            {% endif %}
                                                            <cart-remove-button>
                                                                <button
                                                                        type="button"
                                                                        class="cart-remove-button"
                                                                        data-key="{{ item.key }}"
                                                                        aria-label="Remove {{ item.product.title }}">
                                                                    {% render 'icon-remove' %}
                                                                </button>
                                                            </cart-remove-button>
                                                        </div>
                                                        {% if extra_props != "" %}
                                                            <dl>
                                                                {%- if item.product.has_only_default_variant == false -%}
                                                                    {%- for option in item.options_with_values -%}
                                                                        {% unless item.properties._parent_product_id != blank or item.properties._option_title %}
                                                                            <div class="product-option">

                                                                                <dt>{{ option.name }}:</dt>
                                                                                <dd>
                                                                                    {{ option.value -}}
                                                                                    {%- unless forloop.last %}, {% endunless %}
                                                                                </dd>
                                                                            </div>
                                                                        {% endunless %}
                                                                    {%- endfor -%}
                                                                {%- endif -%}
                                                                {%- for property in item.properties -%}
                                                                    {%- assign property_first_char = property.first | slice: 0 -%}
                                                                    {%- if property.last != blank and property_first_char != '_' -%}
                                                                        {% if property.first contains 'Color' and item.properties._parent_product_id != blank %}
                                                                            {% assign last =  property.last | split: ':' | last | strip %}
                                                                            {% unless item.variant.title == last %}
                                                                            <div class="product-option">
                                                                                {{ property.last | split: ':' | last | strip }}
                                                                            </div>
                                                                            {% endunless %}
                                                                        {% else %}
                                                                            <div class="product-option">

                                                                                    <dt>{{ property.first }}:</dt>

                                                                                <dd>
                                                                                    {%- if property.last contains '/uploads/' -%}
                                                                                        <a
                                                                                                href="{{ property.last }}"
                                                                                                class="link"
                                                                                                target="_blank"
                                                                                                aria-describedby="a11y-new-window-message"
                                                                                        >
                                                                                            {{ property.last | split: '/' | last }}
                                                                                        </a>
                                                                                    {%- else -%}
                                                                                    {% if property.last contains 'Custom' %}

                                                                                        {{ property.last | split: ':' | last | strip }}
                                                                                        {% else %}
                                                                                        {{ property.last }}
                                                                                        {% endif %}
                                                                                    {%- endif -%}
                                                                                </dd>
                                                                            </div>
                                                                        {% endif %}
                                                                    {%- endif -%}
                                                                {%- endfor -%}
                                                            </dl>

                                                        {% endif %}
                                                        <quantity-popover class="cart-quantity-price {% if item.properties._apo_option and item.properties._apo_order %} apo-hide-item{% endif %}">
                                                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                                                                <quantity-input class="quantity cart-quantity">
                                                                    <button class="quantity__button" name="minus"
                                                                            type="button"
                                                                    {% if item.quantity == 1 %}
                                                                        disabled="disabled"
                                                                            {% endif %}>
                                                                      <span class="visually-hidden">
                                                                        {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                                                      </span>
                                                                        {% render 'icon-minus' %}
                                                                    </button>
                                                                    <input
                                                                            class="quantity__input"
                                                                            data-quantity-variant-id="{{ item.variant.id }}"
                                                                            type="number"
                                                                            name="updates[]"
                                                                            value="{{ item.quantity }}"
                                                                            {% # theme-check-disable                                                                 %}
                                                                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                                                            min="0"
                                                                            data-min="{{ item.variant.quantity_rule.min }}"
                                                                            {% if item.variant.quantity_rule.max != null %}
                                                                                max="{{ item.variant.quantity_rule.max }}"
                                                                            {% endif %}
                                                                            step="{{ item.variant.quantity_rule.increment }}"
                                                                            {% # theme-check-enable                                                                 %}
                                                                            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                                                            id="Quantity-{{ item.index | plus: 1 }}"
                                                                            data-index="{{ item.index | plus: 1 }}">
                                                                    <button class="quantity__button" name="plus"
                                                                            type="button">
                                                                  <span class="visually-hidden">
                                                                    {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                                                  </span>
                                                                        {% render 'icon-plus' %}
                                                                    </button>
                                                                </quantity-input>
                                                            </div>
                                                            {% if item.original_price != item.final_price %}
                                                                <div class="cart-item__discounted-prices">
                                                                    <s class="cart-item__old-price product-option">
                                                                        {{ item.original_price | money }}
                                                                    </s>
                                                                    <strong class="cart-item__final-price product-option">
                                                                        {{ item.final_price | money }}
                                                                    </strong>
                                                                </div>
                                                            {% else %}
                                                                <div class="extra-price product-option">
                                                                    {{ item.final_line_price | money }}
                                                                </div>
                                                            {% endif %}
                                                        </quantity-popover>
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </table>
                            </div>
                        {% endif %}
                        <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
                        <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                            {{ 'accessibility.loading' | t }}
                        </p>
                    </div>
                    {% comment %} <div id="CartDrawer-CartErrors" role="alert"></div> {% endcomment %}
                </form>
            </cart-drawer-items>
            <div class="drawer__footer">
                <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
                    {% unless cart == empty %}
                        <div class="total-wrapper">
                            Total <span class="cart-total">{{ cart.total_price | money }}</span>
                        </div>
                    {% endunless %}
                    <a class="cart-link" href="/cart">View cart</a>
                </div>
            </div>
        </div>
    </div>
</cart-drawer>

{% comment %}
