<script>
/**
 * Frequently Bought Together - Cart Drawer Enhancement
 * Handles loading, displaying, and managing frequently bought products
 */

class FrequentlyBoughtTogether {
  constructor() {
    this.desktopContainer = document.getElementById('FrequentlyBoughtProducts');
    this.mobileContainer = document.getElementById('FrequentlyBoughtProductsMobile');
    this.products = [];
    this.init();
  }

  init() {
    if (!this.desktopContainer && !this.mobileContainer) {
      console.warn('Frequently Bought Together containers not found');
      return;
    }

    this.loadProducts();
    this.setupMobileCarousel();
  }

  /**
   * Load frequently bought products
   * Automatically fetches products from the same collection as cart items
   */
  async loadProducts() {
    try {
      console.log('[Frequently Bought] Starting to load products...');
      
      // Get current cart
      const cart = await this.getCart();
      console.log('[Frequently Bought] Cart data:', cart);
      
      if (!cart || cart.items.length === 0) {
        console.log('[Frequently Bought] Cart is empty, hiding containers');
        this.hideContainers();
        return;
      }

      // Get products from same collection, excluding cart items
      this.products = await this.getCollectionProducts(cart);
      console.log('[Frequently Bought] Fetched products:', this.products);

      if (this.products.length === 0) {
        console.log('[Frequently Bought] No products found, hiding containers');
        this.hideContainers();
        return;
      }

      console.log('[Frequently Bought] Rendering', this.products.length, 'products');
      this.renderProducts();
    } catch (error) {
      console.error('[Frequently Bought] Error loading products:', error);
      this.hideContainers();
    }
  }

  /**
   * Get current cart data
   */
  async getCart() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      
      // Debug: Log first cart item structure to understand what's available
      if (cart.items && cart.items.length > 0) {
        console.log('[Frequently Bought] Sample cart item structure:', {
          handle: cart.items[0].handle,
          product_id: cart.items[0].product_id,
          has_product_tags: !!cart.items[0].product_tags,
          has_tags: !!cart.items[0].tags,
          has_properties: !!cart.items[0].properties,
          properties: cart.items[0].properties,
          // Show first few keys to understand structure
          available_keys: Object.keys(cart.items[0]).slice(0, 15)
        });
      }
      
      return cart;
    } catch (error) {
      console.error('[Frequently Bought] Error fetching cart:', error);
      return null;
    }
  }

  /**
   * Get products from the same collection as items in cart
   * Excludes products already in cart and 'avisplus-product-options'
   */
  async getCollectionProducts(cart) {
    try {
      console.log('[Frequently Bought] Getting collection products from cart');
      console.log('[Frequently Bought] Cart items count:', cart.items.length);
      
      // Helper function to check if item is an OPTION product (not a regular product with options)
      // We only want to exclude the extra option items that are added by the app, not the main products
      const isOptionProduct = (item) => {
        // The key indicator is if the item itself is an option product
        // Check if title indicates it's an option item
        if (item.title && (
          item.title.toLowerCase().includes('warranty only') ||
          item.title.toLowerCase().includes('assembly only') ||
          item.title.toLowerCase().includes('installation only')
        )) {
          return true;
        }
        
        // Check if properties indicate this is ONLY an option (not a main product)
        if (item.properties && item.properties._apo_option === true) {
          return true;
        }
        
        // Check product_type if it's available
        if (item.product_type && item.product_type.toLowerCase().includes('option')) {
          return true;
        }
        
        // If none of the above, it's a regular product (even if it has customization options)
        return false;
      };
      
      // Get all product IDs currently in cart (to exclude them)
      const allItems = cart.items.map((item, index) => ({
        index,
        title: item.title,
        handle: item.handle,
        product_id: item.product_id,
        isOption: isOptionProduct(item)
      }));
      
      console.log('[Frequently Bought] All cart items:', allItems);
      
      const cartProductIds = cart.items
        .filter(item => !isOptionProduct(item))
        .map(item => item.product_id);

      console.log('[Frequently Bought] Cart product IDs to exclude:', cartProductIds);
      console.log('[Frequently Bought] Valid items in cart:', cartProductIds.length);

      // Get the first main product in cart
      const firstCartItem = cart.items.find(item => !isOptionProduct(item));

      if (!firstCartItem) {
        console.log('[Frequently Bought] No valid cart item found - all items are option products');
        return [];
      }

      console.log('[Frequently Bought] First cart item:', {
        title: firstCartItem.title,
        handle: firstCartItem.handle,
        product_id: firstCartItem.product_id
      });

      // Fetch the product to get its collections
      const productResponse = await fetch(`/products/${firstCartItem.handle}.js`);
      
      if (!productResponse.ok) {
        console.error('[Frequently Bought] Failed to fetch product:', productResponse.status);
        return await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
      }
      
      const productData = await productResponse.json();

      console.log('[Frequently Bought] Product title:', productData.title);
      console.log('[Frequently Bought] Product collections:', productData.collections);

      if (!productData.collections || productData.collections.length === 0) {
        console.warn('[Frequently Bought] Product has no collections, falling back to recommendations');
        return await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
      }

      // Get the first collection
      const collectionHandle = productData.collections[0].handle;
      console.log('[Frequently Bought] Using collection:', collectionHandle);

      // Fetch products from the collection
      const collectionProducts = await this.fetchCollectionProducts(collectionHandle, cartProductIds);
      console.log('[Frequently Bought] Collection products found:', collectionProducts.length);

      // If not enough products from collection, supplement with recommendations
      if (collectionProducts.length < 3) {
        console.log('[Frequently Bought] Not enough collection products, fetching recommendations');
        const recommendations = await this.getRecommendedProducts(firstCartItem.product_id, cartProductIds);
        console.log('[Frequently Bought] Recommendations found:', recommendations.length);
        
        // Combine and deduplicate
        const combined = [...collectionProducts, ...recommendations];
        const uniqueProducts = this.deduplicateProducts(combined);
        console.log('[Frequently Bought] Combined unique products:', uniqueProducts.length);
        return uniqueProducts.slice(0, 6); // Max 6 products
      }

      return collectionProducts.slice(0, 6); // Max 6 products
    } catch (error) {
      console.error('[Frequently Bought] Error in getCollectionProducts:', error);
      console.error('[Frequently Bought] Error stack:', error.stack);
      return [];
    }
  }

  /**
   * Fetch products from a specific collection
   */
  async fetchCollectionProducts(collectionHandle, excludeProductIds = []) {
    try {
      console.log('[Frequently Bought] Fetching from collection:', collectionHandle);
      console.log('[Frequently Bought] Excluding product IDs:', excludeProductIds);
      
      // Fetch collection with products (using the products.json endpoint)
      const url = `/collections/${collectionHandle}/products.json?limit=20`;
      console.log('[Frequently Bought] Fetching URL:', url);
      
      const response = await fetch(url);
      
      if (!response.ok) {
        console.error('[Frequently Bought] Collection fetch failed:', response.status, response.statusText);
        return [];
      }
      
      const data = await response.json();
      console.log('[Frequently Bought] Raw products from collection:', data.products ? data.products.length : 0);

      if (!data.products || data.products.length === 0) {
        console.log('[Frequently Bought] No products in collection');
        return [];
      }

      // Filter out products already in cart and format them
      const products = data.products
        .filter(product => {
          const isExcluded = excludeProductIds.includes(product.id);
          if (isExcluded) {
            console.log('[Frequently Bought] Excluding product (in cart):', product.title);
          }
          return !isExcluded;
        })
        .filter(product => {
          const hasAvisTag = product.tags && product.tags.some(tag => 
            tag.includes('avisplus-product-options') || tag.includes('avisplus')
          );
          if (hasAvisTag) {
            console.log('[Frequently Bought] Excluding product (avisplus):', product.title);
          }
          return !hasAvisTag;
        })
        .filter(product => {
          if (!product.available) {
            console.log('[Frequently Bought] Excluding product (not available):', product.title);
          }
          return product.available;
        })
        .map(product => {
          const formatted = this.formatProductData(product);
          console.log('[Frequently Bought] Including product:', formatted.title);
          return formatted;
        });

      console.log('[Frequently Bought] Final filtered products:', products.length);
      return products;
    } catch (error) {
      console.error('[Frequently Bought] Error fetching collection products:', error);
      console.error('[Frequently Bought] Error stack:', error.stack);
      return [];
    }
  }

  /**
   * Get recommended products using Shopify's recommendations API
   */
  async getRecommendedProducts(productId, excludeProductIds = []) {
    try {
      const response = await fetch(`/recommendations/products.json?product_id=${productId}&limit=6`);
      const data = await response.json();

      if (!data.products || data.products.length === 0) {
        return [];
      }

      // Filter and format products
      const products = data.products
        .filter(product => !excludeProductIds.includes(product.id))
        .filter(product => !product.tags.includes('avisplus-product-options'))
        .filter(product => product.available)
        .map(product => this.formatProductData(product));

      return products;
    } catch (error) {
      console.error('Error fetching recommended products:', error);
      return [];
    }
  }

  /**
   * Format product data from Shopify API to our format
   */
  formatProductData(product) {
    // Get the first available variant
    const variant = product.variants.find(v => v.available) || product.variants[0];
    
    // Get compare at price (if exists)
    const comparePrice = variant.compare_at_price 
      ? variant.compare_at_price / 100 
      : null;

    // Get product price
    const price = variant.price / 100;

    // Get featured image
    const image = product.featured_image || product.images[0] || '';

    // Try to get rating from metafields (if you have a review app)
    const rating = this.getProductRating(product);
    const reviewCount = this.getProductReviewCount(product);

    return {
      id: `product-${product.id}`,
      productId: product.id,
      handle: product.handle,
      title: product.title,
      image: image,
      rating: rating,
      reviewCount: reviewCount,
      comparePrice: comparePrice,
      price: price,
      variantId: variant.id.toString(),
      available: variant.available,
      tags: product.tags || []
    };
  }

  /**
   * Get product rating from metafields or product data
   * Customize this based on your review app
   */
  getProductRating(product) {
    // Example for Judge.me
    if (product.metafields?.judgeme?.rating) {
      return parseFloat(product.metafields.judgeme.rating);
    }
    
    // Example for Shopify Product Reviews
    if (product.metafields?.reviews?.rating) {
      return parseFloat(product.metafields.reviews.rating);
    }

    // Example for Yotpo
    if (product.metafields?.yotpo?.rating) {
      return parseFloat(product.metafields.yotpo.rating);
    }

    // Default fallback - you can set a default or return null
    return null; // Return null to hide rating if not available
  }

  /**
   * Get product review count from metafields
   */
  getProductReviewCount(product) {
    // Example for Judge.me
    if (product.metafields?.judgeme?.review_count) {
      return parseInt(product.metafields.judgeme.review_count);
    }
    
    // Example for Shopify Product Reviews
    if (product.metafields?.reviews?.review_count) {
      return parseInt(product.metafields.reviews.review_count);
    }

    // Example for Yotpo
    if (product.metafields?.yotpo?.reviews_count) {
      return parseInt(product.metafields.yotpo.reviews_count);
    }

    return 0;
  }

  /**
   * Remove duplicate products based on product ID
   */
  deduplicateProducts(products) {
    const seen = new Set();
    return products.filter(product => {
      if (seen.has(product.productId)) {
        return false;
      }
      seen.add(product.productId);
      return true;
    });
  }

  /**
   * Render products in both desktop and mobile containers
   */
  renderProducts() {
    if (this.products.length === 0) {
      this.hideContainers();
      return;
    }

    const productsHTML = this.products.map(product => this.createProductCard(product)).join('');

    if (this.desktopContainer) {
      this.desktopContainer.innerHTML = productsHTML;
    }

    if (this.mobileContainer) {
      this.mobileContainer.innerHTML = productsHTML;
    }

    this.attachEventListeners();
  }

  /**
   * Create HTML for a single product card
   */
  createProductCard(product) {
    const comparePrice = product.comparePrice 
      ? `<span class="frequently-bought-item__compare-price">As high as: $${this.formatPrice(product.comparePrice)}</span>`
      : '';

    return `
      <div class="frequently-bought-item" data-product-id="${product.id}">
        <div class="frequently-bought-item__image">
          <img 
            src="${product.image}" 
            alt="${this.escapeHtml(product.title)}" 
            loading="lazy"
            onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'"
          >
        </div>
        <h4 class="frequently-bought-item__title">${this.escapeHtml(product.title)}</h4>
        ${this.createRatingHTML(product.rating, product.reviewCount)}
        <div class="frequently-bought-item__prices">
          ${comparePrice}
          <span class="frequently-bought-item__price">$${this.formatPrice(product.price)}</span>
        </div>
        <button 
          class="frequently-bought-item__add-btn" 
          data-variant-id="${product.variantId}"
          data-product-title="${this.escapeHtml(product.title)}"
        >
          ${this.getCartIcon()}
          Add To Cart
        </button>
      </div>
    `;
  }

  /**
   * Create rating stars HTML
   */
  createRatingHTML(rating, reviewCount) {
    if (!rating || rating === 0) return ''; // Don't show rating if not available

    return `
      <div class="frequently-bought-item__rating">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
        </svg>
        <span>${rating.toFixed(1)}</span>
        ${reviewCount > 0 ? `<span class="frequently-bought-item__rating-count">(${reviewCount} reviews)</span>` : ''}
      </div>
    `;
  }

  /**
   * Get cart icon SVG
   */
  getCartIcon() {
    return `
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.70711 15.2929C4.07714 15.9229 4.52331 17 5.41421 17H17M17 17C15.8954 17 15 17.8954 15 19C15 20.1046 15.8954 21 17 21C18.1046 21 19 20.1046 19 19C19 17.8954 18.1046 17 17 17ZM9 19C9 20.1046 8.10457 21 7 21C5.89543 21 5 20.1046 5 19C5 17.8954 5.89543 17 7 17C8.10457 17 9 17.8954 9 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
  }

  /**
   * Attach event listeners to add to cart buttons
   */
  attachEventListeners() {
    const buttons = document.querySelectorAll('.frequently-bought-item__add-btn');
    buttons.forEach(button => {
      button.addEventListener('click', (e) => this.handleAddToCart(e));
    });
  }

  /**
   * Handle add to cart button click
   */
  async handleAddToCart(event) {
    event.preventDefault();
    const button = event.currentTarget;
    const variantId = button.getAttribute('data-variant-id');
    const productTitle = button.getAttribute('data-product-title');

    if (!variantId) {
      console.error('No variant ID found');
      return;
    }

    await this.addToCart(variantId, button, productTitle);
  }

  /**
   * Add product to cart
   */
  async addToCart(variantId, button, productTitle) {
    // Disable button and show loading state
    button.disabled = true;
    button.classList.add('loading');
    const originalHTML = button.innerHTML;
    button.innerHTML = 'Adding...';

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      });

      if (!response.ok) {
        throw new Error('Failed to add to cart');
      }

      const result = await response.json();
      
      // Show success state
      button.classList.remove('loading');
      button.classList.add('success');
      button.innerHTML = '✓ Added';

      // Update cart count and total
      await this.updateCartUI();

      // Show success notification (optional)
      this.showNotification(`${productTitle} added to cart`, 'success');

      // Reset button after delay
      setTimeout(() => {
        button.classList.remove('success');
        button.innerHTML = originalHTML;
        button.disabled = false;
      }, 2000);

      // Reload cart drawer to show updated items
      setTimeout(() => {
        location.reload();
      }, 1500);

    } catch (error) {
      console.error('Error adding to cart:', error);
      
      // Show error state
      button.classList.remove('loading');
      button.innerHTML = 'Error - Try Again';
      
      // Show error notification
      this.showNotification('Failed to add to cart. Please try again.', 'error');

      // Reset button after delay
      setTimeout(() => {
        button.innerHTML = originalHTML;
        button.disabled = false;
      }, 2000);
    }
  }

  /**
   * Update cart UI elements (count, total, etc.)
   */
  async updateCartUI() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();

      // Update cart count
      const cartCountElements = document.querySelectorAll('.cart-count-bubble span, .drawer__heading span');
      cartCountElements.forEach(element => {
        element.textContent = cart.item_count;
      });

      // Update cart total
      const cartTotalElements = document.querySelectorAll('.cart-total');
      cartTotalElements.forEach(element => {
        element.textContent = this.formatMoney(cart.total_price);
      });

      // Dispatch custom event for other scripts
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));

    } catch (error) {
      console.error('Error updating cart UI:', error);
    }
  }

  /**
   * Setup mobile carousel with Slick
   */
  setupMobileCarousel() {
    if (!this.mobileContainer) return;

    // Check if Slick is available
    if (typeof jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') {
      console.warn('Slick Carousel not found. Please ensure jQuery and Slick are loaded.');
      return;
    }

    // Wait for products to be rendered
    setTimeout(() => {
      const $mobileContainer = jQuery(this.mobileContainer);
      
      // Destroy existing slick instance if any
      if ($mobileContainer.hasClass('slick-initialized')) {
        $mobileContainer.slick('unslick');
      }

      // Initialize Slick Carousel
      $mobileContainer.slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: true,
        dots: true,
        infinite: false,
        speed: 300,
        cssEase: 'ease-in-out',
        adaptiveHeight: true,
        prevArrow: '<button type="button" class="slick-prev">Previous</button>',
        nextArrow: '<button type="button" class="slick-next">Next</button>',
        responsive: [
          {
            breakpoint: 750,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1,
              dots: true
            }
          },
          {
            breakpoint: 550,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1,
              dots: true,
              arrows: true
            }
          }
        ]
      });

      // Track slide changes for analytics (optional)
      $mobileContainer.on('afterChange', (event, slick, currentSlide) => {
        console.log('Viewing product:', currentSlide + 1, 'of', slick.slideCount);
      });
    }, 100);
  }

  /**
   * Update navigation button visibility - Not needed with Slick
   * Slick handles this automatically
   */
  updateNavButtons(container, prevBtn, nextBtn) {
    // This method is no longer needed with Slick
    // Slick automatically manages arrow states
  }

  /**
   * Hide containers if no products
   */
  hideContainers() {
    if (this.desktopContainer) {
      this.desktopContainer.closest('.frequently-bought-wrapper')?.classList.add('hidden');
    }
    if (this.mobileContainer) {
      this.mobileContainer.closest('.frequently-bought-wrapper')?.classList.add('hidden');
    }
  }

  /**
   * Show notification message
   */
  showNotification(message, type = 'success') {
    // You can implement a custom notification system here
    // For now, we'll use a simple console log
    console.log(`[${type.toUpperCase()}] ${message}`);
    
    // Optional: Show browser notification
    // if ('Notification' in window && Notification.permission === 'granted') {
    //   new Notification('Cart Update', { body: message });
    // }
  }

  /**
   * Format price with 2 decimal places
   */
  formatPrice(price) {
    return parseFloat(price).toFixed(2);
  }

  /**
   * Format money in shop currency format
   */
  formatMoney(cents) {
    const dollars = cents / 100;
    return `$${dollars.toFixed(2)}`;
  }

  /**
   * Escape HTML to prevent XSS
   */
  escapeHtml(text) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, m => map[m]);
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  new FrequentlyBoughtTogether();
});

// Export for use in other scripts
if (typeof module !== 'undefined' && module.exports) {
  module.exports = FrequentlyBoughtTogether;
}
</script>