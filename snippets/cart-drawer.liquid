        </div>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'drawer-close' %}
        </button>
      </div>
      {% comment %}
        <div data-count="{{ cart.item_count }}" class="cart-drawer__subheading">
          You have <span>{{ cart.item_count }}</span> items in your cart
        </div>
      {% endcomment %}
      <cart-drawer-items
        {% if cart == empty %}
          class="is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {% if cart != empty %}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <div role="rowgroup">
                    {% for item in cart.items %}
                      {% comment %}
                        {% if item.product.title != 'Warranty' and
                            item.product.title != 'Full Assembly & Installation' and
                            item.product.title != 'Color' and
                            item.product.title != 'Custom Color' and
                            item.product.title != 'Custom Paint Color' and
                            item.product.title != 'Custom Vinyl Color' and
                            item.product.title != 'Custom Upholstery Color' %}
                      {% endcomment %}
                      <tr
                        id="CartDrawer-Item-{{ forloop.index }}"
                        class="
                          cart-item
                          {% if item.product.tags contains 'avisplus-product-options' %} extra-option-item
                          {% else %} cart-item-new{% endif %}  apo-cart-item-mini
                        "
                        data-key="{{ item.key }}"
                        role="row"
                      >
                        <!-- Product Image -->
                        <td class="cart-item__media" role="cell">
                          {% if item.image %}
                            <a
                              href="{{ item.url }}"
                              class="cart-item__link"
                              tabindex="-1"
                              aria-hidden="true"
                            ></a>
                            <div>
                              <img
                                class="cart-item__image"
                                src="{{ item.image | image_url: width: 300 }}"
                                alt="{{ item.image.alt | escape }}"
                                loading="lazy"
                                width="150"
                                height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                              >
                            </div>
                          {% endif %}
                        </td>
                        <!-- Product details -->
                        <td class="cart-item__details" role="cell">
                          <div class="cart-title">
                            {% if item.product.tags contains 'avisplus-product-options' %}
                              <span class="cart-item__name extra-option-title h4 break">
                                {{ item.variant.title | escape }}
                              </span>
                            {% else %}
                              <a
                                href="{{ item.url }}"
                                class="cart-item__name h4 break"
                              >
                                {{ item.product.title | escape }}
                              </a>
                            {% endif %}
                            {% if item.original_price != item.final_price %}
                              <div class="cart-item__discounted-prices">
                                <s class="cart-item__old-price product-option">
                                  {{ item.original_price | money }}
                                </s>
                                <strong class="cart-item__final-price product-option">
                                  {{ item.final_price | money }}
                                </strong>
                              </div>
                            {% else %}
                              {% unless item.product.tags contains 'avisplus-product-options' %}
