{% assign color_value = "#CCCCCC" %}
{% assign color_parts = color_map | split: "," %}
{% for part in color_parts %}
    {% assign color_pair = part | split: ":" %}
    {% assign color_name = color_pair[0] | strip %}
    {% if part_name contains color_name %}
        {% assign color_value = color_pair[1] | strip %}
        {% break %}
    {% endif %}
{% endfor %}
{{ color_value }}