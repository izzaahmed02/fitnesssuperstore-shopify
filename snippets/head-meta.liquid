<meta charset="utf-8">
{% render 'optimization', postpone_loading: 'init' %}         
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="">

{% assign base_url = shop.url | replace: 'http://', 'https://' %}

{% if template contains 'product' and product and product.featured_media %}
  <link rel="dns-prefetch" href="https://cdn.shopify.com">
  <link
    rel="preload"
    as="image"
    href="{{ product.featured_media | image_url: width: 1200 }}"
    imagesrcset="{{ product.featured_media | image_url: width: 533 }} 533w, {{ product.featured_media | image_url: width: 720 }} 720w, {{ product.featured_media | image_url: width: 940 }} 940w, {{ product.featured_media | image_url: width: 1066 }} 1066w, {{ product.featured_media | image_url: width: 1200 }} 1200w"
    imagesizes="(min-width: 990px) 50vw, 100vw"
    fetchpriority="high"
  >
{% endif %}


{% assign url_parts = canonical_url | split: '?' %}
{% if url_parts.size > 1 %}
  {% assign query = url_parts[1] %}
  {% if query contains 'page=' %}
    <meta name="robots" content="noindex,follow">
  {% endif %}
{% endif %}

{% if template contains 'product' %}
  <script>
    (function() {
      if (window.location.search.includes('variant=')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex,follow';
        document.head.appendChild(meta);
      }
    })();
  </script>
{% endif %}

{% if template == 'search' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}

{% if template contains 'product' and product %}
  {% assign custom_canonical = null %}
  {% if product and product.metafields.custom.product_canonical_url != blank %}
    {% assign custom_canonical = product.metafields.custom.product_canonical_url %}
  {% endif %}

  {% if custom_canonical %}
    <link rel="canonical" href="{{ custom_canonical }}">
  {% else %}
    <link rel="canonical" href="{{ base_url }}/products/{{ product.handle }}">
  {% endif %}

{% elsif template == 'collection' %}
  <link rel="canonical" href="{{ collection.url | prepend: base_url }}">

{% elsif page and page.handle == 'homepage' %}
  <link rel="canonical" href="{{ base_url }}">
  
{% else %}
  <link rel="canonical" href="{{ canonical_url }}">
{% endif %}

{%- if settings.favicon != blank -%}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
{%- endif -%}

{%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- endunless -%}