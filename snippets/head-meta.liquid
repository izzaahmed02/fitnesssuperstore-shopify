<meta charset="utf-8">
{% render 'optimization', postpone_loading: 'init' %}         
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="">


{% assign url_parts = canonical_url | split: '?' %}
{% if url_parts.size > 1 %}
  {% assign query = url_parts[1] %}
  {% if query contains 'page=' %}
    <meta name="robots" content="noindex,follow">
  {% endif %}
{% endif %}

{% if template contains 'product' %}
  <script>
    (function() {
      if (window.location.search.includes('variant=')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex,follow';
        document.head.appendChild(meta);
      }
    })();
  </script>
{% endif %}

{% if template == 'search' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}

{% if template contains 'product' and product %}
  {% assign custom_canonical = null %}
  {% if product and product.metafields.custom.product_canonical_url != blank %}
    {% assign custom_canonical = product.metafields.custom.product_canonical_url %}
  {% endif %}

  {% if custom_canonical %}
    <link rel="canonical" href="{{ custom_canonical }}">
  {% else %}
    <link rel="canonical" href="{{ shop.url }}/products/{{ product.handle }}">
  {% endif %}

{% elsif template == 'collection' %}
  <link rel="canonical" href="{{ collection.url | prepend: shop.url }}">
  
{% else %}
  <link rel="canonical" href="{{ canonical_url }}">
{% endif %}

{%- if settings.favicon != blank -%}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
{%- endif -%}

{%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{%- endunless -%}