<meta charset="utf-8">
{% render 'optimization', postpone_loading: 'init' %}         
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="">

{% assign base_url = shop.url | replace: 'http://', 'https://' %}
{% assign https_canonical_url = canonical_url | replace_first: 'http://', 'https://' %}

{% assign bounded_pdp_template = false %}
{% if template.suffix == 'combined-listings' or template.suffix == 'variants' or template.suffix == 'variants-pulley' or template.suffix == 'gift_cards' %}
  {% assign bounded_pdp_template = true %}
{% endif %}

{% if template contains 'product' and product %}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {% if bounded_pdp_template %}
    {% assign initial_media = product.media.first %}
    {% assign initial_model = product.media | where: 'media_type', 'model' | first %}

    {% if initial_media and initial_media.media_type == 'image' %}
      <link
        rel="preload"
        as="image"
        media="(max-width: 989px)"
        href="{{ initial_media.preview_image | image_url: width: 580 }}"
        imagesrcset="{{ initial_media.preview_image | image_url: width: 280 }} 280w, {{ initial_media.preview_image | image_url: width: 320 }} 320w, {{ initial_media.preview_image | image_url: width: 480 }} 480w, {{ initial_media.preview_image | image_url: width: 490 }} 490w, {{ initial_media.preview_image | image_url: width: 580 }} 580w, {{ initial_media.preview_image | image_url: width: 800 }} 800w, {{ initial_media.preview_image | image_url: width: 980 }} 980w, {{ initial_media.preview_image | image_url: width: 1160 }} 1160w"
        imagesizes="(max-width: 768px) 100vw, 800px"
        fetchpriority="high"
      >
    {% endif %}

    {% if initial_model == blank and initial_media and initial_media.media_type == 'image' %}
      <link
        rel="preload"
        as="image"
        media="(min-width: 990px)"
        href="{{ initial_media.preview_image | image_url: width: 580 }}"
        imagesrcset="{{ initial_media.preview_image | image_url: width: 280 }} 280w, {{ initial_media.preview_image | image_url: width: 320 }} 320w, {{ initial_media.preview_image | image_url: width: 480 }} 480w, {{ initial_media.preview_image | image_url: width: 490 }} 490w, {{ initial_media.preview_image | image_url: width: 580 }} 580w, {{ initial_media.preview_image | image_url: width: 800 }} 800w, {{ initial_media.preview_image | image_url: width: 980 }} 980w, {{ initial_media.preview_image | image_url: width: 1160 }} 1160w"
        imagesizes="(min-width: 1290px) 580px, (min-width: 990px) calc(100vw - 710px), 100vw"
        fetchpriority="high"
      >
    {% endif %}
  {% elsif product.featured_media %}
    <link
      rel="preload"
      as="image"
      href="{{ product.featured_media.preview_image | image_url: width: 1440 }}"
      imagesrcset="{{ product.featured_media.preview_image | image_url: width: 360 }} 360w, {{ product.featured_media.preview_image | image_url: width: 540 }} 540w, {{ product.featured_media.preview_image | image_url: width: 720 }} 720w, {{ product.featured_media.preview_image | image_url: width: 900 }} 900w, {{ product.featured_media.preview_image | image_url: width: 1080 }} 1080w, {{ product.featured_media.preview_image | image_url: width: 1440 }} 1440w"
      imagesizes="(min-width: 1200px) 34vw, (min-width: 990px) 38vw, 100vw"
      fetchpriority="high"
    >
  {% endif %}
{% endif %}


{% assign url_parts = canonical_url | split: '?' %}
{% if url_parts.size > 1 %}
  {% assign query = url_parts[1] %}
  {% if query contains 'page=' %}
    <meta name="robots" content="noindex,follow">
  {% endif %}
{% endif %}

{% if template contains 'product' %}
  <script>
    (function() {
      var search = window.location.search;
      if (search.includes('variant=')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex,follow';
        document.head.appendChild(meta);
      }
      try {
        var url = new URL(window.location.href);
        if (url.searchParams.has('option_values')) {
          url.searchParams.delete('option_values');
          var clean = url.pathname + (url.search ? url.search : '') + url.hash;
          window.history.replaceState({}, '', clean);
        }
      } catch (e) {}
    })();
  </script>
{% endif %}

{% if template == 'search' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}

{% if template contains 'product' and product %}
  {% assign custom_canonical = null %}
  {% if product and product.metafields.custom.product_canonical_url != blank %}
    {% assign custom_canonical = product.metafields.custom.product_canonical_url %}
  {% endif %}

  {% if custom_canonical %}
    <link rel="canonical" href="{{ custom_canonical }}">
  {% else %}
    <link rel="canonical" href="{{ base_url }}/products/{{ product.handle }}">
  {% endif %}

{% elsif template == 'collection' %}
  <link rel="canonical" href="{{ collection.url | prepend: base_url }}">

{% elsif request.page_type == 'index' or template == 'index' %}
  <link rel="canonical" href="{{ base_url }}">

{% else %}
  <link rel="canonical" href="{{ https_canonical_url }}">
{% endif %}

{%- if settings.favicon != blank -%}
  {%- comment -%}
    Google Search only considers favicons that are square and a multiple of 48 px.
    The previous 32 px-only output was below that threshold, so expose 96 px and
    192 px renders of the same stable source file instead.
    https://developers.google.com/search/docs/appearance/favicon-in-search
  {%- endcomment -%}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 96, height: 96 }}" type="image/png" sizes="96x96">
  <link rel="icon" href="{{ settings.favicon | image_url: width: 192, height: 192 }}" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}" sizes="180x180">
{%- endif -%}

{%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
  <link href="https://fonts.shopifycdn.com" crossorigin>
{%- endunless -%}