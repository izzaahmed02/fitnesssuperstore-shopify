{%- comment -%}
  PDP shipping-row enhancement and compact information-block styling.

  Controlled behavior:
    1. A crate/manual presentation is data-driven. It appears only when:
       - custom.ships is exactly "New in Crate" (case-insensitive), and
       - custom.manual_link or custom.manual_file contains a usable manual URL.
       Visible result after the existing "Ships:" label:
       New in Crate (Assembly Manual Link). Installation Options Available

    2. In crate/manual mode, the representative packaging video and packaging
       disclosure are suppressed. Otherwise the existing Shop by Strength
       Product Line packaging-video behavior remains unchanged.

    3. No SKU or product-handle production exceptions are hardcoded here.
       Product eligibility is controlled through product metafields.

    4. The CSS below changes spacing and alignment only. It does not hide,
       truncate, reorder, or rewrite PDP information-block content.

  Source thread: "Remove Blanket Wrap Packaging on Most Products."
  Production remains gated by unpublished-theme QA and Tim approval.
{%- endcomment -%}

{%- liquid
  assign shipping_value = product.metafields.custom.ships.value | default: product.metafields.custom.ships | strip
  assign normalized_shipping_value = shipping_value | downcase

  assign manual_url = product.metafields.custom.manual_link.value
  if manual_url == blank
    assign manual_file = product.metafields.custom.manual_file.value
    if manual_file != blank
      assign manual_url = manual_file.url
    endif
  endif

  assign crate_manual_mode = false
  if normalized_shipping_value == 'new in crate' and manual_url != blank
    assign crate_manual_mode = true
  endif

  assign in_strength_line = false
  for collection in product.collections
    if collection.handle contains 'shop-by-strength-product-line'
      assign in_strength_line = true
      break
    endif
  endfor

  assign is_exception = false
  if product.metafields.custom.packaging_video_exception.value == true
    assign is_exception = true
  endif

  assign show_packaging_video = false
  if in_strength_line and is_exception == false and crate_manual_mode == false
    assign show_packaging_video = true
  endif

  assign packaging_video_url = product.metafields.custom.watch_packaging_video.value
  if packaging_video_url == blank
    assign packaging_video_url = 'https://cdn.shopify.com/videos/c/o/v/ac6b9c86a3c741059abf9f9fd23b51ec.mp4'
  endif

  assign packaging_disclaimer = product.metafields.custom.packaging_disclaimer.value
  if packaging_disclaimer == blank
    assign packaging_disclaimer = 'All French Fitness strength product-line equipment receives protective blanket wrapping for freight transit. Depending on the model and shipment, primary packaging may also include manufacturer cartons, a pallet or wood frame, and/or a wooden crate. Some components or hardware may arrive pre-installed for transport and assembly. This video shows a representative packaging example; exact packaging may vary by model and shipment.'
  endif
-%}

{%- if crate_manual_mode -%}
  <span class="pdp-crate-manual">
    (<a
      class="pdp-crate-manual__link"
      href="{{ manual_url | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >Assembly Manual Link</a>). Installation Options Available
  </span>
{%- elsif show_packaging_video -%}
  <span class="packaging-video">
    —
    <a
      class="packaging-video__link"
      href="{{ packaging_video_url | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >Watch Packaging Example</a>
  </span>
  <details class="packaging-video__details">
    <summary class="packaging-video__summary">Packaging details <span class="packaging-video__caret" aria-hidden="true">{% render 'icon-caret' %}</span></summary>
    <span class="packaging-video__disclaimer">{{ packaging_disclaimer | escape | newline_to_br }}</span>
  </details>
{%- endif -%}

<style id="pdp-info-compact-v1">
  .metainfo-wrapper {
    margin-bottom: 14px;
    border-top: 1px solid rgba(35, 35, 43, 0.12);
  }

  .metainfo-wrapper .item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 !important;
    padding: 8px 0;
    border-bottom: 1px solid rgba(35, 35, 43, 0.10);
  }

  .metainfo-wrapper .item__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    max-width: 18px;
    flex: 0 0 18px;
    min-height: 20px;
    margin-top: 0 !important;
    color: #68686f;
  }

  .metainfo-wrapper .item__icon-wrap svg {
    width: 18px;
    max-width: 18px;
    max-height: 18px;
  }

  .metainfo-wrapper .item__text {
    min-width: 0;
    padding-left: 0 !important;
    font-size: 14px;
    line-height: 1.45;
    color: #393940;
  }

  .metainfo-wrapper .item__text .title {
    display: inline-block;
    margin-right: 5px;
    font-weight: 700;
    color: #111116;
  }

  .metainfo-wrapper .more-info,
  .metainfo-wrapper a,
  .pdp-crate-manual__link,
  .packaging-video__link,
  .packaging-video__summary {
    color: #111116;
    font-weight: 700;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .pdp-crate-manual {
    white-space: normal;
  }

  .packaging-video__details {
    margin-top: 3px;
  }

  .packaging-video__summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }

  .packaging-video__disclaimer {
    display: block;
    max-width: 70ch;
    padding: 6px 0 1px;
    font-size: 13px;
    line-height: 1.45;
    color: #4a4a52;
  }

  .packaging-video__caret {
    display: inline-flex;
    vertical-align: middle;
    transition: transform 0.15s ease;
  }

  .packaging-video__details[open] .packaging-video__caret {
    transform: rotate(180deg);
  }

  .showroom {
    align-items: flex-start;
    margin-top: 12px !important;
    padding-top: 11px;
    border-top: 1px solid rgba(216, 61, 14, 0.22);
    font-size: 14px;
    line-height: 1.4;
  }

  .showroom .img-wrap {
    width: 18px;
    max-width: 18px;
    flex: 0 0 18px;
    margin-top: 0 !important;
  }

  .showroom .img-wrap svg {
    width: 18px;
    max-height: 18px;
  }

  .showroom-text {
    padding-left: 8px;
  }

  @media screen and (min-width: 750px) {
    .metainfo-wrapper .item__text .title {
      min-width: 112px;
    }
  }

  @media screen and (max-width: 749px) {
    .metainfo-wrapper {
      margin-bottom: 12px;
    }

    .metainfo-wrapper .item {
      gap: 7px;
      padding: 7px 0;
    }

    .metainfo-wrapper .item__text {
      font-size: 13.5px;
      line-height: 1.42;
    }

    .showroom {
      margin-top: 10px !important;
      padding-top: 10px;
    }
  }

  .metainfo-wrapper a:focus-visible,
  .packaging-video__summary:focus-visible,
  .showroom a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
