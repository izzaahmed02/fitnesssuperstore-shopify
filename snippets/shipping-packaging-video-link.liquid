{%- comment -%}
  PREVIEW-ONLY OVERLAY — DO NOT MERGE THIS BRANCH.

  This file contains the production-candidate data-driven behavior from PR #788,
  plus a temporary product-handle preview mapping for FFT-ACD and both FF-SC15
  PDPs. The mapping is required only because Shopify product metafields are global
  and must not be changed before Tim approves the unpublished-theme preview.

  The production branch has no hardcoded SKU/handle mappings. After approval,
  product metafields will be updated with compareDigest protection and this
  preview-only overlay will be discarded.

  Compact information-block styling is loaded on every product page from
  assets/pdp-info-compact.css through layout/theme.liquid.
{%- endcomment -%}

{%- liquid
  assign shipping_value = product.metafields.custom.ships.value | default: product.metafields.custom.ships | strip
  assign normalized_shipping_value = shipping_value | downcase

  assign manual_url = product.metafields.custom.manual_link.value
  if manual_url == blank
    assign manual_file = product.metafields.custom.manual_file.value
    if manual_file != blank
      assign manual_url = manual_file.url
    endif
  endif

  assign crate_manual_mode = false
  if normalized_shipping_value == 'new in crate' and manual_url != blank
    assign crate_manual_mode = true
  endif

  assign preview_override = false
  case product.handle
    when 'french-fitness-tahoe-assisted-chin-dip-new'
      assign preview_override = true
      assign manual_url = 'https://fitnesssuperstore.info/pdfs/French%20Fitness%20Shasta%20%26%20Tahoe%20Assisted%20Chin%20Dip%20Assembly%20and%20Exercise%20Manual.pdf'
    when 'french-fitness-ff-sc15-stretch-cage-black-new'
      assign preview_override = true
      assign manual_url = 'https://fitnesssuperstore.info/pdfs/French%20Fitness%20SC15%20Stretch%20Cage%20Assembly%20Manual.pdf'
    when 'french-fitness-ff-sc15-stretch-cage-silver-new'
      assign preview_override = true
      assign manual_url = 'https://fitnesssuperstore.info/pdfs/French%20Fitness%20SC15%20Stretch%20Cage%20Assembly%20Manual.pdf'
  endcase

  assign in_strength_line = false
  for collection in product.collections
    if collection.handle contains 'shop-by-strength-product-line'
      assign in_strength_line = true
      break
    endif
  endfor

  assign is_exception = false
  if product.metafields.custom.packaging_video_exception.value == true
    assign is_exception = true
  endif

  assign show_packaging_video = false
  if in_strength_line and is_exception == false and crate_manual_mode == false and preview_override == false
    assign show_packaging_video = true
  endif

  assign packaging_video_url = product.metafields.custom.watch_packaging_video.value
  if packaging_video_url == blank
    assign packaging_video_url = 'https://cdn.shopify.com/videos/c/o/v/ac6b9c86a3c741059abf9f9fd23b51ec.mp4'
  endif

  assign packaging_disclaimer = product.metafields.custom.packaging_disclaimer.value
  if packaging_disclaimer == blank
    assign packaging_disclaimer = 'All French Fitness strength product-line equipment receives protective blanket wrapping for freight transit. Depending on the model and shipment, primary packaging may also include manufacturer cartons, a pallet or wood frame, and/or a wooden crate. Some components or hardware may arrive pre-installed for transport and assembly. This video shows a representative packaging example; exact packaging may vary by model and shipment.'
  endif
-%}

{%- if preview_override -%}
  <script>
    (() => {
      const script = document.currentScript;
      const row = script && script.closest('.item__text');
      if (!row) return;

      const title = document.createElement('span');
      title.className = 'title';
      title.textContent = 'Ships:';

      const text = document.createTextNode(' New in Crate (');

      const link = document.createElement('a');
      link.className = 'pdp-crate-manual__link';
      link.href = {{ manual_url | json }};
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = 'Assembly Manual Link';

      const suffix = document.createTextNode('). Installation Options Available');

      row.replaceChildren(title, text, link, suffix);
    })();
  </script>
{%- elsif crate_manual_mode -%}
  <span class="pdp-crate-manual">
    (<a
      class="pdp-crate-manual__link"
      href="{{ manual_url | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >Assembly Manual Link</a>). Installation Options Available
  </span>
{%- elsif show_packaging_video -%}
  <span class="packaging-video">
    —
    <a
      class="packaging-video__link"
      href="{{ packaging_video_url | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >Watch Packaging Example</a>
  </span>
  <details class="packaging-video__details">
    <summary class="packaging-video__summary">Packaging details <span class="packaging-video__caret" aria-hidden="true">{% render 'icon-caret' %}</span></summary>
    <span class="packaging-video__disclaimer">{{ packaging_disclaimer | escape | newline_to_br }}</span>
  </details>
{%- endif -%}
