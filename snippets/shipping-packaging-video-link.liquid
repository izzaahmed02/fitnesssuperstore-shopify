{%- liquid
  assign in_strength_line = false
  for collection in product.collections
    if collection.handle contains 'shop-by-strength-product-line'
      assign in_strength_line = true
      break
    endif
  endfor

  assign show_packaging_video = false
  if in_strength_line
    assign excluded_handles = 'french-fitness-marin-seated-leg-curl-extension-plate-loaded-new,french-fitness-napa-seated-leg-curl-extension-plate-loaded-new,french-fitness-napa-hip-abductor-adductor-plate-loaded-new,french-fitness-marin-hip-abductor-adductor-plate-loaded-new,french-fitness-ffs-silver-4-stack-multi-jungle-gym-new,french-fitness-ffs-silver-5-stack-multi-jungle-gym-new,french-fitness-ffb-black-4-stack-multi-jungle-gym-new,french-fitness-ffs-silver-8-stack-multi-jungle-gym-new,french-fitness-ffs-silver-12-stack-multi-jungle-gym-new,french-fitness-ffb-black-12-stack-multi-jungle-gym-new,french-fitness-ffb-black-5-stack-multi-jungle-gym-new,french-fitness-ffb-dfib-15-to-90-degree-adjustable-decline-bench-new,french-fitness-ffb-black-8-stack-multi-jungle-gym-new,french-fitness-ffb-black-pendulum-squat-leg-press-machine-new,french-fitness-ffb-black-leverage-squat-calf-machine-new' | split: ','
    assign is_excluded = false
    for handle in excluded_handles
      if handle == product.handle
        assign is_excluded = true
        break
      endif
    endfor
    unless is_excluded
      assign show_packaging_video = true
    endunless
  endif
-%}
{%- if show_packaging_video -%}
  {%- comment -%}
    The dash stays outside .more-info: that class is underlined and clickable, so
    keeping the dash inside it made the dash look like part of the link.
  {%- endcomment -%}
  —<span class="more-info" data-customfield="Shipping">Watch Packaging Video</span>
  <script>
    var attachClickHandler = setInterval(function () {
      var $target = $('.custom_shipping_container');
      if ($target.length > 0) {
        var $clickTarget = $target.parent().parent();

        $clickTarget.off('click.clearContent').on('click.clearContent', function () {
          $('#dynamic-product-content').empty();
        });

        clearInterval(attachClickHandler);
      }
    }, 200);
  </script>
{%- endif -%}
