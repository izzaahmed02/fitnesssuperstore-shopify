<style>
  .index-wrapper{
    column-count: 2;
  }
  .coll-depth-1{
    font-size: 16px;
    font-weight: 700;
    color: #3E77AA;
    line-height: 24px;
    text-decoration: none;
    position: relative;
    margin-bottom: 12px;
  }
  .coll-depth-2{
    font-size: 14px;
    font-weight: 700;
    color: #3E77AA;
    line-height: 24px;
    text-decoration: none;
    padding-left: 32px;
    position: relative;
    margin-bottom: 8px;
  }
  .coll-depth-2:before{
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    background: #F1592A;
    border-radius: 50%;
    position: absolute;
    top: 6px;
    left: 16px;
  }
  .coll-depth-3{
    font-size: 14px;
    font-weight: 700;
    color: #3E77AA;
    line-height: 24px;
    text-decoration: none;
    padding-left: 48px;
    position: relative;
    margin-bottom: 8px;
  }
  .coll-depth-3:before{
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    background: #F58E6E;
    border-radius: 50%;
    position: absolute;
    top: 6px;
    left: 32px;
  }
  .coll-depth-4{
    font-size: 14px;
    font-weight: 700;
    color: #3E77AA;
    line-height: 24px;
    text-decoration: none;
    padding-left: 64px;
    position: relative;
    margin-bottom: 8px;
  }
  .coll-depth-4:before{
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    background: #FAC3B2;
    border-radius: 50%;
    position: absolute;
    top: 6px;
    left: 48px;
  }
  .coll-depth-5{
    font-size: 14px;
    font-weight: 700;
    color: #3E77AA;
    line-height: 24px;
    text-decoration: none;
    padding-left: 80px;
    position: relative;
    margin-bottom: 8px;
  }
  .coll-depth-5:before{
    content: ""; 
    display: block;
    width: 8px;
    height: 8px;
    background: #FCE6DE;
    border-radius: 50%;
    position: absolute; 
    top: 6px;
    left: 64px;
  }
  .alpha-header{
    margin-top: 0;
    margin-bottom: 16px;
    font-size: 28px;
    color: #393940;
    font-weight: 700;
    line-height: 36px;
  }
  .alpha-item{
    display: flex;
    flex-direction: column;
    margin-bottom: 32px;
    flex: 1 1 calc(50% - 20px);
  }
</style>

<div class="container">
  <h2 class="title">{{ section.settings.title }}</h2>

 <div class="index-wrapper">

     {% for block in section.blocks %}
      {%- case block.type -%}
        {%- when "item" -%}
        <div class="alpha-item">
         <h2 class="alpha-header">{{ block.settings.title }}</h2>
         {% assign collectionsArr = block.settings.list_of_col | replace: ' ', '' | split: "," %}
    
       
         
         {% for item in collectionsArr %}
            <a class="coll-depth-{{ collections[item].metafields.custom.navigation_level }}" href="/collections/{{ collections[item].handle }}">{{ collections[item].title }}</a>
         {% endfor %}
         </div>
       {% endcase %}
     {% endfor %}
     
  </div>
</div>

<style>
  #shopify-section-{{ section.id }}{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    border-bottom: 1px solid #E5E5E5;
  }
  
</style>

{% schema %}
  {
    "name": "Index section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Heading"
          },
          {
            "type": "text",
            "id": "list_of_col",
            "label": "List of collections"
          }, 
        ]
      }
    ],
    "presets": [
      {
        "name": "Index section"
      }
    ]
  }
{% endschema %}