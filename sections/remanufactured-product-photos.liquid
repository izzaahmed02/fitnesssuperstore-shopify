             <a href="/pages/remanufactured-photos">{{ section.settings.product_title }}</a>     
        </div>
      </div>
    </div>
  </div>
<section class="product-photos-page">
  <h1 class="product-title">{{ section.settings.product_title }}</h1>
  <div class="product-photos">
    {% for block in section.blocks %}
      <div class="photo-item scroll-trigger animate--slide-in">
        <img height="" width="" src="{{ block.settings.photo | image_url }}" alt="{{ section.settings.product_title }}" />
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Reman Product Photos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Product Name"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reman Product Photos"
    }
  ]
}
{% endschema %}
