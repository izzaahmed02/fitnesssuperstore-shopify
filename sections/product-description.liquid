{% style %}
  .product-description{
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    display: grid;
    grid-template-colums: 1fr 1fr;
    margin-top: 80px;
  }
  .product-description__wrapper{
    width: 50%;
  }
  .yt-video{
    width: 100%!important;
  }
  .product-description__wrapper p{
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #393940!important;
    background: transparent!important;
    letter-spacing: normal!important;
    word-spacing: normal!important;
    text-indent: unset!important;
    margin-top: 5px!important;
    margin-bottom: 5px!important;
    text-transform: none!important;
  }
  
  .product-description__wrapper p b{
    font-weight: 700;
  }
  .product-description__wrapper br{
    display: none;
  }
  .product-description__wrapper ul li{
    padding-left: 16px;
    margin-bottom: 8px;
    position: relative;
  }
  .product-description__wrapper ul li:before{
    content: "";
    position: absolute;
    left: 0px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50px;
    background: #3E77AA;
  }
{% endstyle %}

<div class="product-description">
  <div class="product-description__wrapper">
    {{ product.description }}
  </div>
</div>

{% schema %}
  {
    "name": "Product description",
    "settings": [
      
    ],
    "presets": [
      {
        "name": "Product description",
      }
    ]
  }
{% endschema %}