<style>
    #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.bg }};
    }

    .fake-breadcrumbs__url {
        font-family: 'Lato';
        font-style: normal;
        font-weight: 400;
        font-size: 14px;
        line-height: 20px;
        color: #000;
        margin: 0;
    }

    .second-breadcrumb {
        font-family: 'Lato';
        font-style: normal;
        font-weight: 700;
        font-size: 14px;
        margin: 0;
        line-height: 20px;
        color: #D83D0E;
    }

    .fake-breadcrumbs__wrapper {
        display: flex;
      flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .breadcrumb-icon {
        width: 20px;
        height: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @media (max-width: 999px) {
        .fake-breadcrumbs__url,
        .second-breadcrumb {
            font-size: 12px;
            line-height: 1.2;
            white-space: normal;
        }
    }

    /* Mobile: one compact 44px row instead of a wrapped multi-line block.
       Matches the PDP treatment shipped in PR #819. When the section has a
       middle crumb, that crumb is the immediate parent, so the current page
       title - which the H1 below already shows - drops out of the visual row
       and stays in the accessibility tree. With no middle crumb there is
       nothing to fall back to, so the title stays visible and truncates. */
    @media screen and (max-width: 749px) {
        .fake-breadcrumbs__wrapper {
            flex-wrap: nowrap;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
        }

        /* Only the collapsing case needs the 44px tap row. A Home + title pair
           already fits one line, so leave its height alone. */
        .fake-breadcrumbs--has-parent {
            min-height: 44px;
            padding-bottom: 0;
        }

        .fake-breadcrumbs__wrapper > .fake-breadcrumbs__url,
        .fake-breadcrumbs__wrapper > .second-breadcrumb {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .fake-breadcrumbs__wrapper > .fake-breadcrumbs__home,
        .fake-breadcrumbs__wrapper > .breadcrumb-icon {
            flex-shrink: 0;
        }

        /* Visually hidden, still announced. */
        .fake-breadcrumbs--has-parent .second-breadcrumb,
        .fake-breadcrumbs--has-parent .breadcrumb-icon--current {
            border: 0;
            clip: rect(0 0 0 0);
            clip-path: inset(50%);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            white-space: nowrap;
            width: 1px;
        }
    }
</style>

{%- comment -%}
  When a middle ("first item") crumb is configured it is the immediate parent,
  so mobile can collapse to Home > parent and hide the current page title.
  Without it, Home is the only thing left, so nothing is hidden.

  The current crumb is also only hidden when it has no url - every comparison
  chart template leaves it blank, so it renders as a <p>. If it were a real
  link, hiding it would leave mobile keyboard focus on a clipped element.
{%- endcomment -%}
{%- assign has_parent_crumb = false -%}
{%- if section.settings.home_item_text != blank and section.settings.first_item_text != blank and section.settings.second_item_text != blank and section.settings.second_item_url == blank -%}
  {%- assign has_parent_crumb = true -%}
{%- endif -%}

<section class="page-width-dc fake-breadcrumbs section-{{ section.id }}-padding">
    <div class="fake-breadcrumbs__wrapper{% if has_parent_crumb %} fake-breadcrumbs--has-parent{% endif %}">

        {% if section.settings.home_item_text != blank %}
        <{% if section.settings.home_item_url != blank %}a href="{{ section.settings.home_item_url }}" {% else %}p{% endif %}
                class="fake-breadcrumbs__url fake-breadcrumbs__home">
            {{ section.settings.home_item_text }}
            </{% if section.settings.home_item_url != blank %}a{% else %}p{% endif %}>

            <span class="breadcrumb-icon{% unless section.settings.first_item_text != blank %} breadcrumb-icon--current{% endunless %}">
        {% render 'icon-breadcrumb-arrow' %}
      </span>
            {% endif %}

            {% if section.settings.first_item_text != blank %}
            <{% if section.settings.first_item_url != blank %}a href="{{ section.settings.first_item_url }}" {% else %}p{% endif %}
                    class="fake-breadcrumbs__url">
                {{ section.settings.first_item_text }}
                </{% if section.settings.first_item_url != blank %}a{% else %}p{% endif %}>

                <span class="breadcrumb-icon breadcrumb-icon--current">
        {% render 'icon-breadcrumb-arrow' %}
      </span>
                {% endif %}


                {% if section.settings.second_item_text != blank %}
                <{% if section.settings.second_item_url != blank %}a href="{{ section.settings.second_item_url }}" {% else %}p{% endif %}
                        class="fake-breadcrumbs__url second-breadcrumb" aria-current="page">
                    {{ section.settings.second_item_text }}
                    </{% if section.settings.second_item_url != blank %}a{% else %}p{% endif %}>
                    {% endif %}
    </div>
</section>

{%- style -%}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    }
{%- endstyle -%}

{% schema %}
{
  "name": "Fake breadcrumbs dc",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "home_item_text",
      "label": "Home item text"
    },
    {
      "type": "url",
      "id": "home_item_url",
      "label": "Home item url"
    },
    {
      "type": "text",
      "id": "first_item_text",
      "label": "First item text"
    },
    {
      "type": "url",
      "id": "first_item_url",
      "label": "First item url"
    },
    {
      "type": "text",
      "id": "second_item_text",
      "label": "Second item text"
    },
    {
      "type": "url",
      "id": "second_item_url",
      "label": "Second item url"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Fake breacrumbs dc"
    }
  ]
}
{% endschema %}
