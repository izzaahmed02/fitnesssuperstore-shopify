<script>
document.addEventListener('DOMContentLoaded', () => {

  function gallerySlickInit() {
    $('.gallery-wrapper').slick({
      dots: false,
      infinite: true,
      slidesToShow: 2,
      slidesToScroll: 1,
      centerMode: false,
      centerPadding: '202px',
      appendArrows: $('.slick-slider-nav'),
      prevArrow: `<button class='slick-prev btn btn-white rounded-circle'><svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="48" height="48" rx="24" fill="#616166"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M26.5303 17.4697C26.8232 17.7626 26.8232 18.2374 26.5303 18.5303L21.0607 24L26.5303 29.4697C26.8232 29.7626 26.8232 30.2374 26.5303 30.5303C26.2374 30.8232 25.7626 30.8232 25.4697 30.5303L19.4697 24.5303C19.1768 24.2374 19.1768 23.7626 19.4697 23.4697L25.4697 17.4697C25.7626 17.1768 26.2374 17.1768 26.5303 17.4697Z" fill="white"/>
</svg>
</button>`,
      nextArrow: `<button class='slick-next btn btn-white rounded-circle'><svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="48" height="48" rx="24" fill="#616166"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M21.4697 17.4697C21.7626 17.1768 22.2374 17.1768 22.5303 17.4697L28.5303 23.4697C28.8232 23.7626 28.8232 24.2374 28.5303 24.5303L22.5303 30.5303C22.2374 30.8232 21.7626 30.8232 21.4697 30.5303C21.1768 30.2374 21.1768 29.7626 21.4697 29.4697L26.9393 24L21.4697 18.5303C21.1768 18.2374 21.1768 17.7626 21.4697 17.4697Z" fill="white"/>
</svg></button>`,
      responsive: [
        {
          breakpoint: 750,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            centerPadding: '0px',
            arrows: true, // now arrows will show on mobile
          },
        },
      ],
    });
  }

  gallerySlickInit(); // initialize on page load

});
</script>


{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .contact__heading{
    text-align: center;
    margin-top: 0;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} p{
    text-align: center;
    margin-top: 0;
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .btn__link{
    font-family: "Lato";
    line-height: 24px;
    color: #ffffff;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    background: #F1592A;
    border-radius: 8px;
    margin: 24px 0;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .contact-content .item{
    display: flex;
    align-items: center;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .contact-content .item img{
    margin-right: 12px;
  }
  .contact-wrapper{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    margin-top: 24px;
  }
  .contact-content .title{
    font-family: "Lato";

    color: #000000;
    margin-bottom: 16px;
    display: block;
    margin-top: 0;
  }
  .contact-content .name{
    font-family: "Lato";

    color: #393940;
    margin-right: 12px;
    display: block;
  }

  .gallery-wrapper{
    margin-top: 24px;
    /* padding-left: 100px;
    padding-right: 100px; */
  }
  .gallery-wrapper .item{
    border-radius: 24px;
    margin-left: 16px;
    margin-right: 16px;
  }
  .gallery-wrapper .item img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
    image-rendering: pixelated;
  }
  #shopify-section-{{ section.id }} .slick-dots{
    bottom: unset;
  }
  #shopify-section-{{ section.id }} .slick-dots li{
    width: 12px;
    height: 12px;
  }
  #shopify-section-{{ section.id }} .slick-dots{
    position: static;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .slick-dotted.slick-slider{
    margin-bottom: 52px;
  }
  #shopify-section-{{ section.id }} .slick-dots li button{
    width: 12px;
    height: 12px;
    background: #000000!important;
    opacity: 20%;
    border-radius: 50%;
  }
  #shopify-section-{{ section.id }} .slick-dots li.slick-active button{
    opacity: 100%;
  }
  .slick-dots li button:before{
    width: 12px;
    height: 12px;
  }
  #shopify-section-{{ section.id }} .gallery-wrapper-main{
    position: relative;
  }
  #shopify-section-{{ section.id }} .slick-slider-nav{
    position: absolute;
    top: 42%;
    left: 0px;
    width: 100%;
  }
  .slick-next:before, .slick-prev:before{
    display: none!important;
  }
  #shopify-section-{{ section.id }} .slick-prev{
    left: -40px;
  }
  #shopify-section-{{ section.id }} .slick-next{
    right: -13px;
  }

  .gallery-bg {
    background: #edeff3;
    padding: 20px;
    border-radius: 24px;
  }

  @media screen and (max-width: 750px) {

    #shopify-section-{{ section.id }} {
    padding-top: 24px;
    padding-bottom: 24px;
  }

 

    .gallery-wrapper {
      margin-top: 0;
    }
    .gallery-wrapper .item {
      height: 208px;
      border-radius: 16px;
      margin-left: 0;
      margin-right: 0;
      margin-bottom: 20px;
      padding: 0; /* Remove padding on mobile */
      background: #edeff3;
    }

    .gallery-wrapper .item img {
      height: 208px;
      border-radius: 16px;
      object-position: bottom;
    }
  }
{%- endstyle -%}

<div class="page-width">
  <div class="gallery-bg">
    <div class="container">
      <h2 class="contact__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.href }}" class="btn__link">{{ section.settings.link }}</a>
      {% endif %}
    </div>
    <div class="gallery-wrapper-main">
      <div class="gallery-wrapper">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when 'item' -%}
              <div class="item">{{ block.settings.image | image_url: width: auto | image_tag }}</div>
          {% endcase %}
        {% endfor %}
      </div>
      <div class="slick-slider-nav"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gallery section",
  "tag": "section",
  "class": "gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link",
      "label": "CTA Title"
    },
    {
      "type": "url",
      "id": "href",
      "label": "CTA Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Slider item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery section"
    }
  ]
}
{% endschema %}
