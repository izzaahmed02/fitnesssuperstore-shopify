{{ 'homepage-categories.css' | asset_url | stylesheet_tag }}

<div class="page-width">
    <div class="homepage-categories__wrapper">
        <div class="homepage-categories__header">
            <h2 class="homepage-categories__title">
                {{ section.settings.title }}
            </h2>
            <div class="homepage-categories__tabs-header">
                <button class="homepage-categories__tab-btn active" data-tab="tab1" type="button">{{ section.settings.tab_title_1 }}</button>
                <button class="homepage-categories__tab-btn" data-tab="tab2" type="button">{{ section.settings.tab_title_2 }}</button>
            </div>
        </div>
        <div class="homepage-categories__tabs">
            <div class="homepage-categories__tab homepage-categories__tab-active" data-tab="tab1">
                <div class="swiper homepage-categories__swiper-1">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks limit: 5 %}
                            <div class="swiper-slide homepage-categories__item">
                                <div class="homepage-categories__item-img-wrapper">
                                    <img src="{{ block.settings.img | image_url: width: 500, height: 500 }}"
                                         alt="{{ block.settings.img }}"
                                         loading="lazy"
                                         class="homepage-categories__item-img">
                                </div>
                                <a href="{{ block.settings.url }}"
                                   class="homepage-categories__item-link">{{ block.settings.title }}</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="homepage-categories__tab" data-tab="tab2">
                <div class="swiper homepage-categories__swiper-2">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks offset: 5 limit: 8 %}
                            <div class="swiper-slide homepage-categories__item">
                                <div class="homepage-categories__item-img-wrapper">
                                    <img src="{{ block.settings.img | image_url: width: 500, height: 500 }}"
                                         alt="{{ block.settings.img }}"
                                         loading="lazy"
                                         class="homepage-categories__item-img">
                                </div>
                                <a href="{{ block.settings.url }}"
                                   class="homepage-categories__item-link">{{ block.settings.title }}</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function() {
        // Initialize Slick sliders for each tab
        $('.homepage-categories__swiper-1 .swiper-wrapper').slick({
            infinite: true,
            slidesToShow: 4,
            slidesToScroll: 1
        });
        $('.homepage-categories__swiper-2 .swiper-wrapper').slick({
            infinite: true,
            slidesToShow: 4,
            slidesToScroll: 1
        });

        // Tab switching logic
        $('.homepage-categories__tab-btn').on('click', function() {
            // Remove active class from all buttons and tabs
            $('.homepage-categories__tab-btn').removeClass('active');
            $('.homepage-categories__tab').removeClass('homepage-categories__tab-active');

            // Add active class to clicked button
            $(this).addClass('active');

            // Show corresponding tab content
            const tabId = $(this).data('tab');
            $(`.homepage-categories__tab[data-tab="${tabId}"]`).addClass('homepage-categories__tab-active');

            // Refresh Slick slider for the active tab to ensure proper rendering
            $(`.homepage-categories__tab[data-tab="${tabId}"] .swiper-wrapper`).slick('refresh');
        });
    });
</script>

{% schema %}
{
  "name": "Homepage categories",
  "tag": "section",
  "class": "section homepage-categories",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "tab_title_1",
      "label": "Section First Tab Title"
    },
    {
      "type": "text",
      "id": "tab_title_2",
      "label": "Section Second Tab Title"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Category Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Category URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories"
    }
  ]
}
{% endschema %}