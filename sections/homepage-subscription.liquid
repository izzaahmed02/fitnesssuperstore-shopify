{{ 'homepage-subscription.css' | asset_url | stylesheet_tag }}

<div class="page-width">
    <div class="homepage-subscription__wrapper">
        <h2 class="homepage-subscription__title h2">{{ section.settings.title }}</h2>
        <form action="#" class="homepage-subscription__form" data-error-message="{{ section.settings.error-message | escape }}">
            <label for="HomepageSubscriptionEmail-{{ section.id }}" class="visually-hidden">Email address</label>
            <input placeholder="Enter your email" type="email" id="HomepageSubscriptionEmail-{{ section.id }}" class="homepage-subscription__input" aria-describedby="HomepageSubscriptionError-{{ section.id }}" required>
            <div id="HomepageSubscriptionError-{{ section.id }}" class="error-message" role="alert" hidden></div>
            <button class="homepage-subscription__button" type="submit">Subscribe
                {% render 'chevron-button' %}
            </button>
        </form>
        <span class="homepage-subscription__form-copy">
        {% render 'form-checkmark' %}
            {{ section.settings.label }}
        </span>
        <div class="homepage-subscription__original-form">
            <div class="klaviyo-form-Ud8shK"></div>
        </div>
    </div>
    <div class="homepage-subscription__message">
        <div class="homepage-subscription__message-title h2">{{ section.settings.thank-you }}</div>
        <p class="homepage-subscription__message-copy">{{ section.settings.thank-you-copy }}</p>
    </div>
</div>


<script src="{{ 'homepage-subscription.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Homepage Subscription",
  "tag": "section",
  "class": "section homepage-subscription",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section  Label"
    },
    {
      "type": "text",
      "id": "thank-you",
      "default": "Thanks for subscribing!",
      "label": "Section  Message Title"
    },
    {
      "type": "text",
      "id": "thank-you-copy",
      "default": "Check your email for a confirmation message.",
      "label": "Section  Message Copy"
    },
    {
      "type": "text",
      "id": "error-message",
      "default": "We could not subscribe you. Please try again.",
      "label": "Section Error Message"
    }
  ],
  "presets": [
    {
      "name": "Homepage Subscription"
    }
  ]
}
{% endschema %}
