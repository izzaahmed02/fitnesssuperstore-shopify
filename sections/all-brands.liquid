{%- style -%}
  .container_all_brands_{{ section.id }} {
    padding: 30px 0 48px;
  }

  .container_all_brands_{{ section.id }} .all-brand-page-title {
    margin: 0 0 24px;
    text-align: center;
    text-transform: uppercase;
  }

  .container_all_brands_{{ section.id }} .all-brands-content {
    width: 100%;
    overflow: visible;
  }

  .container_all_brands_{{ section.id }} .all-brands-content::after {
    display: block;
    clear: both;
    content: '';
  }

  .container_all_brands_{{ section.id }} .all_brands__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px;
    padding: 30px 10px;
    background-color: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    margin: 0 8px;
  }

  .container_all_brands_{{ section.id }} .all_brands_wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.3rem;
  }

  .container_all_brands_{{ section.id }} .brand-logos {
    width: 40px;
    height: 35px;
    object-fit: contain;
  }

  .container_all_brands_{{ section.id }} .brand-title {
    color: #3e77aa;
    font-family: Lato, sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: capitalize;
    line-height: normal;
    margin: 0;
  }

  @media (max-width: 1200px) {
    .container_all_brands_{{ section.id }} .all_brands__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .container_all_brands_{{ section.id }} {
      padding-bottom: 36px;
    }

    .container_all_brands_{{ section.id }} .all_brands__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px 20px;
      align-items: flex-start;
      padding: 25px 20px;
    }

    .container_all_brands_{{ section.id }} .all_brands_wrapper {
      flex-direction: column;
      align-items: flex-start;
    }

    .container_all_brands_{{ section.id }} .brand-logos {
      width: 45px;
      height: 33px;
    }
  }

  @media (max-width: 480px) {
    .container_all_brands_{{ section.id }} .all_brands__list {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="container_all_brands container_all_brands_{{ section.id }} page-width">
  <h1 class="all-brand-page-title">{{ page.title }}</h1>

  {% if page.content != blank %}
    <div class="all-brands-content">
      {{ page.content }}
    </div>
  {% else %}
    <div class="all_brands__list">
      {% for block in section.blocks %}
        {% if block.settings.url != blank %}
          <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            <div class="all_brands_wrapper">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 90
                  | image_tag:
                    class: 'brand-logos',
                    width: 40,
                    height: 35,
                    alt: block.settings.image.alt
                }}
              {% endif %}
              <h2 class="brand-title">{{ block.settings.name }}</h2>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "All Brands",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand Name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "All Brands"
    }
  ]
}
{% endschema %}
