{{ 'homepage-faqs.css' | asset_url | stylesheet_tag }}
{{ 'accordion.css' | asset_url | stylesheet_tag }}

<style>
  .accordion-content-inner a {
    position: relative;
    padding-right: 28px;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #D83D0E;
    font-family: Lato, sans-serif;
  }
  .accordion-content-inner a:after {
    position: absolute;
    content: '';
    width: 24px;
    height: 24px;
    background: url("{{ 'link-chevron.svg' | asset_url }}");
    top: -1px;
    right: 0;
  }

  /* Closed-state thumbnail in header */
  .accordion-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .accordion-thumb-closed {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f1f1f1;
  }
  .accordion-thumb-closed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .accordion-thumb-closed--empty {
    border: 1px dashed #ccc;
  }

  /* Option A: expanded body layout */
  .accordion-body-inner {
    display: flex;
    gap: 16px;
    padding: 16px;
    align-items: flex-start;
  }
  .accordion-thumb-large {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f1f1f1;
    border: 1px solid #e5e5e5;
  }
  .accordion-thumb-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .accordion-thumb-large--empty {
    display: none;
  }
  .accordion-body-text {
    flex: 1;
    min-width: 0;
  }
  .accordion-body-tag {
    display: inline-block;
    font-size: 11px;
    color: #0F6E56;
    background: #E1F5EE;
    border-radius: 20px;
    padding: 2px 10px;
    margin-top: 8px;
  }
</style>

<div class="page-width">
  <h2 class="homepage-faqs__title">{{ section.settings.title }}</h2>
  <div class="homepage-faqs__accordions">
    {% for block in section.blocks %}
      {% assign has_image = false %}
      {% if block.settings.image != blank %}
        {% assign has_image = true %}
      {% endif %}

      <div class="homepage-faqs__accordion-item accordion">
        <button
          class="accordion-header"
          type="button"
          aria-expanded="false"
          aria-controls="accordion-content-{{ forloop.index }}">

          {% comment %} Small closed-state thumbnail {% endcomment %}
          <span class="accordion-thumb-closed {% unless has_image %}accordion-thumb-closed--empty{% endunless %}">
            {% if has_image %}
              {{ block.settings.image | image_url: width: 72 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% endif %}
          </span>

          <span class="accordion-title">{{ block.settings.title }}</span>
          {% render 'chevron' %}
        </button>

        <div
          id="accordion-content-{{ forloop.index }}"
          class="accordion-content"
          aria-hidden="true">

          <div class="accordion-body-inner">
            {% comment %} Large thumbnail shown when expanded {% endcomment %}
            <div class="accordion-thumb-large {% unless has_image %}accordion-thumb-large--empty{% endunless %}">
              {% if has_image %}
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {% endif %}
            </div>

            <div class="accordion-body-text">
              {% assign faq_link_start = '<a class="accordion-link" aria-label="Learn more about '
                | append: block.settings.title
                | append: '" tabindex="-1" '
              %}
              <div class="accordion-content-inner">
                {{ block.settings.copy | replace: '<a ', faq_link_start }}
              </div>
              {% if block.settings.tag != blank %}
                <span class="accordion-body-tag">{{ block.settings.tag }}</span>
              {% endif %}
            </div>
          </div>

        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.url %}
    <a href="{{ section.settings.url }}" class="homepage-faqs__link">
      {{ section.settings.label }}
      {% render 'chevron-button' %}
    </a>
  {% endif %}
</div>

<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "FAQs With Image",
  "tag": "section",
  "class": "section homepage-faqs image-faqs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Link Label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Link URL"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image",
          "info": "Shown as a small thumbnail in the closed state and a 100×100px preview when expanded. Recommended size: 200×200px square."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label tag (optional)",
          "info": "Short category label shown below the copy, e.g. 'Inspection' or 'Rebuild'"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs with Image"
    }
  ]
}
{% endschema %}