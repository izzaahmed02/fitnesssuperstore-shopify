{{ 'homepage-faqs.css' | asset_url | stylesheet_tag }}
{{ 'accordion.css' | asset_url | stylesheet_tag }}

<style>
  .accordion-content-inner a {
    position: relative;
    padding-right: 28px;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #D83D0E;
    font-family: Lato, sans-serif;
  }
  .accordion-content-inner a:after {
    position: absolute;
    content: '';
    width: 24px;
    height: 24px;
    background: url("{{ 'link-chevron.svg' | asset_url }}");
    top: -1px;
    right: 0;
  }

  /* Closed-state thumbnail inside header */
  .accordion-header {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-start;
  }

  .image-faqs .accordion-header svg {
    margin-left: auto;
  }

  .accordion-thumb-closed {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    border: 1px solid #e5e5e5;
  }
  .accordion-thumb-closed--empty {
    border: 1px dashed #ccc;
  }
  .accordion-thumb-closed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Option A expanded layout — scoped tightly so accordion.css can't interfere */
  .image-faq-body {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    gap: 16px !important;
    padding: 16px !important;
    box-sizing: border-box;
  }
  .image-faq-thumb {
    width: 100px !important;
    height: 100px !important;
    min-width: 100px !important;
    border-radius: 8px;
    overflow: hidden;
    background: #f1f1f1;
    border: 1px solid #e5e5e5;
    flex-shrink: 0;
  }
  .image-faq-thumb img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }
  .image-faq-text {
    flex: 1;
    min-width: 0;
  }
  .image-faq-tag {
    display: inline-block;
    font-size: 11px;
    color: #0F6E56;
    background: #E1F5EE;
    border-radius: 20px;
    padding: 2px 10px;
    margin-top: 8px;
  }
</style>

<div class="page-width">
  <h2 class="homepage-faqs__title">{{ section.settings.title }}</h2>
  <div class="homepage-faqs__accordions">
    {% for block in section.blocks %}
      {% assign has_image = false %}
      {% if block.settings.image != blank %}
        {% assign has_image = true %}
      {% endif %}

      <div class="homepage-faqs__accordion-item accordion">
        <button
          class="accordion-header"
          type="button"
          aria-expanded="false"
          aria-controls="accordion-content-{{ forloop.index }}">

          <span class="accordion-thumb-closed {% unless has_image %}accordion-thumb-closed--empty{% endunless %}">
            {% if has_image %}
              {{ block.settings.image | image_url: width: 72 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% endif %}
          </span>

          <span class="accordion-title">{{ block.settings.title }}</span>
          {% render 'chevron' %}
        </button>

        <div
          id="accordion-content-{{ forloop.index }}"
          class="accordion-content"
          aria-hidden="true">

          {% comment %}
            .image-faq-body sits OUTSIDE .accordion-content-inner so accordion.css
            padding/display rules on that class don't collapse the flex row.
          {% endcomment %}
          <div class="image-faq-body">

            {% if has_image %}
              <div class="image-faq-thumb">
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.title }}
              </div>
            {% endif %}

            <div class="image-faq-text">
              {% assign faq_link_start = '<a class="accordion-link" aria-label="Learn more about '
                | append: block.settings.title
                | append: '" tabindex="-1" '
              %}
              <div class="accordion-content-inner">
                {{ block.settings.copy | replace: '<a ', faq_link_start }}
              </div>
              {% if block.settings.tag != blank %}
                <span class="image-faq-tag">{{ block.settings.tag }}</span>
              {% endif %}
            </div>

          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.url %}
    <a href="{{ section.settings.url }}" class="homepage-faqs__link">
      {{ section.settings.label }}
      {% render 'chevron-button' %}
    </a>
  {% endif %}
</div>

<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "FAQs With Image",
  "tag": "section",
  "class": "section homepage-faqs image-faqs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Link Label"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Link URL"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image",
          "info": "Shown as a 36px thumbnail in the closed state and 100x100px when expanded. Recommended: 200x200px square."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label tag (optional)",
          "info": "Short label shown below the copy, e.g. 'Inspection' or 'Rebuild'"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs with Image"
    }
  ]
}
{% endschema %}