<style>
.comparison-container .comp-head,
.comparison-container .comp-title {
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
  font-size: 28px;
  text-align: center;
  margin: 40px 0 24px;
}

.comparison-container.comp-container {
  max-width: var(--page-width);
  margin: 0 auto 50px;
  padding: 0 5rem;
}

.comparison-container .comparison-table.comp-table {
  min-width: 1200px;
  width: 100%;
  border-collapse: collapse;
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
}

.comparison-container th,
.comparison-container td {
  border: 1px solid #E5E5E5;
  padding: 12px 10px;
  text-align: left;
  vertical-align: top;
}

.comparison-container thead th {
  font-weight: 700;
}

.comparison-container tbody th {
  font-weight: 700;
}

.comparison-container ul {
  margin: 0;
  padding: 0;
}

.comparison-container .comparison-wrapper.table-wrapper {
  overflow: hidden;
}

@media (max-width: 1300px) {
  .comparison-container .comparison-wrapper.table-wrapper {
    overflow: scroll;
  }
}

@media (max-width: 768px) {
  .comparison-container .comp-head,
  .comparison-container .comp-title {
    font-size: 22px;
    margin: 24px 0 16px;
  }
  .comparison-container .comparison-wrapper.table-wrapper {
    overflow: scroll;
  }
  .comparison-container .comp-container {
    padding: 0 20px !important;
  }
}

  
</style>

