                  <li class="cgb-select__option" role="option" data-value="9-11 ft">9-11 ft</li>
                  <li class="cgb-select__option" role="option" data-value="12-14 ft">12-14 ft</li>
                  <li class="cgb-select__option" role="option" data-value="15-20 ft">15-20 ft</li>
                  <li class="cgb-select__option" role="option" data-value="Over 20 ft">Over 20 ft</li>
                </ul>
                <input type="hidden" name="contact[ceiling_height]" data-cgb-required value="">
              </div>
              <p class="cgb-field__error" data-cgb-error>Select a ceiling height</p>
