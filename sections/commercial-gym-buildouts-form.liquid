            <div class="cgb-field" data-cgb-field>
              <label class="cgb-field__label" id="CGBBudgetRangeLabel-{{ section.id }}">Budget range <span class="cgb-field__required">*</span></label>
              <div class="cgb-select" data-cgb-select>
                <button type="button" class="cgb-field__input cgb-select__trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="CGBBudgetRangeLabel-{{ section.id }}" data-cgb-select-trigger>
                  <span class="cgb-select__value cgb-select__value--placeholder" data-cgb-select-value data-placeholder="Select a budget range">Select a budget range</span>
                  <svg class="cgb-select__chevron" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#393940" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <ul class="cgb-select__list" role="listbox" hidden data-cgb-select-list>
                  <li class="cgb-select__option" role="option" data-value="Under $25,000">Under $25,000</li>
                  <li class="cgb-select__option" role="option" data-value="$25,000-$50,000">$25,000-$50,000</li>
                  <li class="cgb-select__option" role="option" data-value="$50,000-$100,000">$50,000-$100,000</li>
                  <li class="cgb-select__option" role="option" data-value="$100,000-$250,000">$100,000-$250,000</li>
