          <p class="cgb-form__step-heading cgb-form__step-heading--spaced">Your contact details</p>

          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" for="CGBFullName-{{ section.id }}">Full name <span class="cgb-field__required">*</span></label>
            <input type="text" id="CGBFullName-{{ section.id }}" name="contact[name]" class="cgb-field__input" placeholder="Enter your full name" data-cgb-required>
