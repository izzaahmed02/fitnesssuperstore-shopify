            <textarea id="CGBNotes-{{ section.id }}" name="contact[notes]" class="cgb-field__input cgb-field__textarea" placeholder="Add a notes" maxlength="1200"></textarea>
            <p class="cgb-field__hint">Anything else that would help us plan the room</p>
