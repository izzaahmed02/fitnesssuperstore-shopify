          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" id="CGBDeliveryInstallLabel-{{ section.id }}">Delivery, assembly or installation <span class="cgb-field__required">*</span></label>
            <div class="cgb-select" data-cgb-select>
