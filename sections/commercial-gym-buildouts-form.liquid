          <div class="cgb-form__field-row">
            <div class="cgb-field" data-cgb-field>
              <label class="cgb-field__label" for="CGBPhone-{{ section.id }}">Phone <span class="cgb-field__required">*</span></label>
              <input type="tel" id="CGBPhone-{{ section.id }}" name="contact[phone]" class="cgb-field__input" placeholder="(925) 555-0100" data-cgb-required data-cgb-pattern="^[0-9()\-\s+]{7,}$">
              <p class="cgb-field__error" data-cgb-error>Enter a valid phone number</p>
            </div>

            <div class="cgb-field" data-cgb-field>
              <label class="cgb-field__label" for="CGBEmail-{{ section.id }}">Email <span class="cgb-field__required">*</span></label>
              <input type="email" id="CGBEmail-{{ section.id }}" name="contact[email]" class="cgb-field__input" placeholder="your@gmail.com" data-cgb-required data-cgb-pattern="^[^\s@]+@[^\s@]+\.[^\s@]{2,}$">
              <p class="cgb-field__error" data-cgb-error>Enter a valid email address</p>
            </div>
