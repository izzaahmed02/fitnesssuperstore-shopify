          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" for="CGBOrganization-{{ section.id }}">Organization <span class="cgb-field__required">*</span></label>
            <input type="text" id="CGBOrganization-{{ section.id }}" name="contact[organization]" class="cgb-field__input" placeholder="Enter your organization" data-cgb-required>
            <p class="cgb-field__error" data-cgb-error>Enter your organization</p>
