          <div class="cgb-form__buttons-row">
            <button type="button" class="button cgb-form__back" data-cgb-back>Back</button>
            <button type="button" class="button button--primary" data-cgb-submit disabled title="Submission is disabled until wiring is fully reviewed and approved">Request My Layout &amp; Quote</button>
          </div>
