        <div class="cgb-form__status" data-cgb-status="loading" hidden>
          <div class="cgb-form__status-icon">
            <svg class="cgb-form__status-spinner" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" stroke="#fce6de" stroke-width="3"/>
              <path d="M22 12a10 10 0 0 0-10-10" stroke="#f1592a" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <p class="cgb-form__status-heading">Sending your request</p>
          <p class="cgb-form__status-text">You receive a tailored quote to review by your preferred contact method.</p>
          <button type="button" class="button button--primary cgb-form__status-action" disabled>Request My Layout &amp; Quote</button>
        </div>

        <div class="cgb-form__status" data-cgb-status="error" hidden>
          <div class="cgb-form__status-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" fill="#e9380d"/>
              <rect x="11" y="6" width="2" height="8" rx="1" fill="#ffffff"/>
              <circle cx="12" cy="16.5" r="1.25" fill="#ffffff"/>
            </svg>
          </div>
          <p class="cgb-form__status-heading">That did not send</p>
          <p class="cgb-form__status-text">Something went wrong on our end. Try again, or call +1-925-215-2927 and we will take the details over the phone.</p>
          <button type="button" class="button button--primary cgb-form__status-action" data-cgb-try-again>Try again</button>
        </div>

        <div class="cgb-form__status" data-cgb-status="success" hidden>
          <div class="cgb-form__status-icon">
            <svg viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
              <circle cx="26" cy="26" r="24" fill="none" stroke="#28a745" stroke-width="3"/>
              <path fill="none" stroke="#28a745" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M14 27l7 7 16-16"/>
            </svg>
          </div>
          <p class="cgb-form__status-heading">Your request is in</p>
          <p class="cgb-form__status-text">A Fitness Superstore gym specialist will review your room details and follow up to discuss your equipment mix, conceptual placement and a tailored quote. If you would like to talk sooner, call +1-925-215-2927.</p>
        </div>

        {%- if request.design_mode -%}
          <div class="cgb-form__status-preview">
            <button type="button" data-cgb-preview="1">Preview: Step 1</button>
            <button type="button" data-cgb-preview="2">Preview: Step 2</button>
            <button type="button" data-cgb-preview="loading">Preview: Loading</button>
            <button type="button" data-cgb-preview="error">Preview: Error</button>
            <button type="button" data-cgb-preview="success">Preview: Success</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    var form = root.querySelector('.cgb-form__form');
    var banner = root.querySelector('[data-cgb-error-banner]');
    var stepLabel = root.querySelector('[data-cgb-step-label]');
    var progressFill = root.querySelector('[data-cgb-progress-fill]');
    var step1 = root.querySelector('[data-cgb-step="1"]');
    var step2 = root.querySelector('[data-cgb-step="2"]');
    var continueBtn = root.querySelector('[data-cgb-continue]');
    var backBtn = root.querySelector('[data-cgb-back]');
    var submitBtn = root.querySelector('[data-cgb-submit]');
    var progressRow = root.querySelector('.cgb-form__progress-row');
    var statusPanels = root.querySelectorAll('[data-cgb-status]');
    var tryAgainBtn = root.querySelector('[data-cgb-try-again]');

    function showPanel(name) {
      step1.hidden = name !== '1';
      step2.hidden = name !== '2';
      progressRow.hidden = name === 'loading' || name === 'error' || name === 'success';
      banner.hidden = true;

      statusPanels.forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-cgb-status') !== name;
      });
    }

    function validateField(field) {
      var input = field.querySelector('[data-cgb-required]');
      if (!input) return true;

      var valid;

      if (input.hasAttribute('data-cgb-tag-group')) {
        valid = !!input.querySelector('.cgb-tag[aria-pressed="true"]');
      } else {
        var value = input.value.trim();
        valid = value !== '';

        var pattern = input.getAttribute('data-cgb-pattern');
        if (valid && pattern) {
          valid = new RegExp(pattern).test(value);
        }
      }

      field.classList.toggle('cgb-field--error', !valid);
      return valid;
    }

    function validateStep(step) {
      var fields = step.querySelectorAll('[data-cgb-field]');
      var allValid = true;

      fields.forEach(function (field) {
        if (!validateField(field)) {
          allValid = false;
        }
      });

      banner.hidden = allValid;
      return allValid;
    }

    function syncTagValue(group) {
      var valueInput = group.querySelector('[data-cgb-tag-value]');
      if (!valueInput) return;

      var selected = [];
      group.querySelectorAll('.cgb-tag[aria-pressed="true"]').forEach(function (t) {
        selected.push(t.getAttribute('data-value'));
      });

      valueInput.value = selected.join(', ');
    }

    function setSelectOpen(select, isOpen) {
      var list = select.querySelector('[data-cgb-select-list]');
      var trigger = select.querySelector('[data-cgb-select-trigger]');
      list.hidden = !isOpen;
      trigger.setAttribute('aria-expanded', String(isOpen));
      select.classList.toggle('cgb-select--open', isOpen);
    }

    function closeAllSelects(except) {
      root.querySelectorAll('[data-cgb-select]').forEach(function (sel) {
        if (sel !== except) setSelectOpen(sel, false);
      });
    }

    root.querySelectorAll('[data-cgb-select]').forEach(function (select) {
      var trigger = select.querySelector('[data-cgb-select-trigger]');
      var list = select.querySelector('[data-cgb-select-list]');
      var valueEl = select.querySelector('[data-cgb-select-value]');
      var hiddenInput = select.querySelector('[data-cgb-required]');
      var field = select.closest('[data-cgb-field]');

      trigger.addEventListener('click', function () {
        var willOpen = list.hidden;
        closeAllSelects(select);
        setSelectOpen(select, willOpen);
      });

      list.querySelectorAll('[data-value]').forEach(function (option) {
        option.addEventListener('click', function () {
          var value = option.getAttribute('data-value');
          hiddenInput.value = value;
          valueEl.textContent = value || valueEl.getAttribute('data-placeholder');
          valueEl.classList.toggle('cgb-select__value--placeholder', value === '');
          setSelectOpen(select, false);
          if (field) field.classList.remove('cgb-field--error');
        });
      });
    });

    document.addEventListener('click', function (e) {
      root.querySelectorAll('[data-cgb-select]').forEach(function (sel) {
        if (!sel.contains(e.target)) setSelectOpen(sel, false);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAllSelects(null);
    });

    root.querySelectorAll('.cgb-tag').forEach(function (tag) {
      tag.addEventListener('click', function () {
        var group = tag.closest('[data-cgb-tag-group]');
        var isSingle = group.getAttribute('data-cgb-tag-mode') === 'single';

        if (isSingle) {
          group.querySelectorAll('.cgb-tag').forEach(function (t) {
            t.setAttribute('aria-pressed', 'false');
          });
          tag.setAttribute('aria-pressed', 'true');
        } else {
          var pressed = tag.getAttribute('aria-pressed') === 'true';
          tag.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        }

        syncTagValue(group);
      });
    });

    continueBtn.addEventListener('click', function () {
      if (!validateStep(step1)) return;

      showPanel('2');
      stepLabel.textContent = 'Step 2/2';
      progressFill.style.width = '100%';
    });

    backBtn.addEventListener('click', function () {
      showPanel('1');
      stepLabel.textContent = 'Step 1/2';
      progressFill.style.width = '50%';
    });

    var CGB_FORM_ID = 'commercial_gym_buildouts_form';

    function getAttributionParams() {
      var params = new URLSearchParams(window.location.search);
      var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'oppref'];
      var out = {};

      keys.forEach(function (key) {
        var value = params.get(key);
        if (value) out[key] = value;
      });

      return out;
    }

    function makeEventId() {
      if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
      return 'cgb-' + Date.now() + '-' + Math.random().toString(16).slice(2);
    }

    // Reads Shopify's native Customer Privacy API only. Deliberately does not
    // integrate with any third-party consent app (e.g. a store's cookie-banner
    // app) — if this store's consent banner is handled by such an app instead
    // of Shopify's native privacy settings, this stays 'unavailable' on hold.
    function getConsentState() {
      try {
        if (window.Shopify && window.Shopify.customerPrivacy &&
            typeof window.Shopify.customerPrivacy.currentVisitorConsent === 'function') {
          var consent = window.Shopify.customerPrivacy.currentVisitorConsent();
          return {
            marketing: !!consent.marketing,
            analytics: !!consent.analytics,
            preferences: !!consent.preferences,
            sale_of_data: !!consent.sale_of_data
          };
        }
      } catch (e) {}

      return 'unavailable';
    }

    // Fires only once acceptance has already been confirmed by the
    // provider-confirmed hook below — never on click, animation, timeout,
    // or a failed/rejected response. No form field values are included,
    // per the locked no-PII measurement contract.
    function fireLeadEvents(eventId) {
      var dedupeKey = 'cgbLeadFired:' + eventId;

      try {
        if (window.sessionStorage && window.sessionStorage.getItem(dedupeKey)) return;
      } catch (e) {}

      var basePayload = Object.assign({
        provider_submission_id: eventId,
        form_id: CGB_FORM_ID,
        page_path: window.location.pathname,
        event_timestamp: new Date().toISOString(),
        consent_state: getConsentState()
      }, getAttributionParams());

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: 'lead_created' }, basePayload));
      window.dataLayer.push(Object.assign({ event: 'fss_commercial_buildout_lead_success' }, basePayload));

      try {
        if (window.sessionStorage) window.sessionStorage.setItem(dedupeKey, '1');
      } catch (e) {}
    }

    submitBtn.addEventListener('click', function () {
      if (submitBtn.disabled) return;
      if (!validateStep(step2)) return;

      showPanel('loading');

      var eventId = makeEventId();
      var formData = new FormData(form);

      fetch(form.getAttribute('action') || window.location.pathname, {
        method: 'POST',
        credentials: 'same-origin',
        body: formData
      })
        .then(function (response) {
          return response.text();
        })
        .then(function (html) {
          var parsed = new DOMParser().parseFromString(html, 'text/html');
          var marker = parsed.querySelector('[data-cgb-form-posted]');
          var accepted = !!marker && marker.getAttribute('value') === 'true';

          if (accepted) {
            fireLeadEvents(eventId);
            showPanel('success');
          } else {
            showPanel('error');
          }
        })
        .catch(function () {
          showPanel('error');
        });
    });

    if (tryAgainBtn) {
      tryAgainBtn.addEventListener('click', function () {
        showPanel('2');
        stepLabel.textContent = 'Step 2/2';
        progressFill.style.width = '100%';
      });
    }

    root.querySelectorAll('[data-cgb-preview]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-cgb-preview');
        showPanel(target);
        if (target === '1' || target === '2') {
          stepLabel.textContent = target === '1' ? 'Step 1/2' : 'Step 2/2';
          progressFill.style.width = target === '1' ? '50%' : '100%';
        }
      });
    });
  });
</script>

