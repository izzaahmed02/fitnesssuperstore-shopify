{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.section_padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.section_padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.section_padding_top }}px;
      padding-bottom: {{ section.settings.section_padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
  }

  /* title-wrapper-with-link is Dawn's heading+side-link flex row
     (justify-content: space-between); this section has no side link,
     so force it to stack heading/subheading as a centered column
     on all screen sizes instead of the two sitting side by side. */
  #shopify-section-{{ section.id }} .title-wrapper-with-link {
    flex-direction: column;
    align-items: center;
    gap: 0;
    /* The theme gives this wrapper a 30px bottom margin, which collapsed against the
       steps row's 28px top margin and won, putting the row 30px below the heading
       block instead of Figma's 28px. Zero it so the row's own margin governs. */
    margin-bottom: 0;
  }

  /* Figma node 4585:80564 "Heading" — Oswald SemiBold 38px/50px desktop */
  #shopify-section-{{ section.id }} .title.h1 {
    font-size: 20px;
    line-height: 26px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .title.h1 {
      font-size: 38px;
      line-height: 50px;
    }
  }

  /* Figma node 4612:86205 (mobile) — Lato Regular 14px/20px, #4f4f55 */
  #shopify-section-{{ section.id }} .cgb-form__subheading {
    text-align: center;
    max-width: 800px;
    margin: 12px auto 0;
    font-family: 'Lato', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #4f4f55;
  }

  /* Figma node 4585:80564 (desktop) — Lato Regular 16px/24px, #393940 */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cgb-form__subheading {
      font-size: 16px;
      line-height: 24px;
      color: #393940;
    }
  }

  /* Figma node 4612:86220 (mobile) — stacked column, 4px gap, chevron rotated
     90deg as a downward separator between lines */
  #shopify-section-{{ section.id }} .cgb-form__phases {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 20px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cgb-form__phase {
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #4f4f55;
  }

  #shopify-section-{{ section.id }} .cgb-form__phase-chevron {
    flex: none;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4f4f55;
    transform: rotate(90deg);
  }

  #shopify-section-{{ section.id }} .cgb-form__phase-chevron svg {
    width: 8px;
    height: 14px;
  }

  /* Figma node 4585:80582 (desktop) — single row, Lato Bold 20px/26px,
     chevron connector (24x24, #4f4f55) upright, 20px gap each side */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cgb-form__phases {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 28px;
      /* Figma node 4585:80582 — the steps frame is 50px tall with its 26px labels
         centred inside it, i.e. 12px above and below. Without this the row was only
         as tall as the labels, leaving the heading-to-card distance 26px short of
         Figma's 106px (28 + 50 + 28). */
      padding-top: 12px;
      padding-bottom: 12px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cgb-form__phase {
      font-size: 20px;
      line-height: 26px;
    }

    #shopify-section-{{ section.id }} .cgb-form__phase-chevron {
      transform: rotate(0deg);
    }
  }

  /* Figma node 4585:80472 "inputs" — 624px white card, radius 12, 32px padding */
  #shopify-section-{{ section.id }} .cgb-form__card {
    width: 100%;
    max-width: 624px;
    /* Figma node 4585:80472 — 28px below the steps frame (frame ends 12647, card
       starts 12675), not the theme's 2.4rem/24px. */
    margin: 28px auto 0;
    background-color: #ffffff;
    border-radius: 12px;
    padding: 32px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cgb-form__step-label {
    margin: 0 0 4px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #000000;
  }

  #shopify-section-{{ section.id }} .cgb-form__progress-track {
    width: 100%;
    height: 4px;
    background-color: #fce6de;
    border-radius: 2px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cgb-form__progress-fill {
    width: 50%;
    height: 100%;
    background-color: #f1592a;
    transition: width 0.3s ease;
  }

  #shopify-section-{{ section.id }} .cgb-form__progress-row {
    margin-bottom: 24px;
  }

  /* Figma "Check the highlighted fields and try again" error banner */
  #shopify-section-{{ section.id }} .cgb-form__banner {
    margin-bottom: 20px;
    padding: 12px 16px;
    background-color: #fdece7;
    border: 1px solid #d83d0e;
    border-radius: 8px;
    color: #d83d0e;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
  }

  #shopify-section-{{ section.id }} .cgb-form__step-heading {
    margin: 0 0 16px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: #000000;
  }

  #shopify-section-{{ section.id }} .cgb-field {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .cgb-field__label {
    display: block;
    margin-bottom: 6px;
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    line-height: 18px;
    color: #393940;
  }

  #shopify-section-{{ section.id }} .cgb-field__required {
    color: #d83d0e;
  }

  #shopify-section-{{ section.id }} .cgb-field__optional {
    color: #b3b3b3;
  }

  #shopify-section-{{ section.id }} .cgb-field__input {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: 48px;
    padding: 0 16px;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    background-color: #ffffff;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #393940;
    box-sizing: border-box;
  }

  /* Custom dropdown (replaces native <select>) — a native select's open-state
     options list is rendered by the OS/browser, not page CSS, so it can't be
     made reliably responsive across mobile devices. Building it ourselves
     (button trigger + an absolutely-positioned, self-sized list) guarantees
     it always stays within the field's own width and the viewport. */
  #shopify-section-{{ section.id }} .cgb-select {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cgb-select__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .cgb-select__value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #393940;
  }

  #shopify-section-{{ section.id }} .cgb-select__value--placeholder {
    color: #b3b3b3;
  }

  #shopify-section-{{ section.id }} .cgb-select__chevron {
    flex: none;
    width: 14px;
    height: 8px;
    transition: transform 0.15s ease;
  }

  #shopify-section-{{ section.id }} .cgb-select--open .cgb-select__chevron {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .cgb-select__list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 20;
    margin: 0;
    padding: 4px;
    list-style: none;
    max-width: 100%;
    max-height: 240px;
    overflow-y: auto;
    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cgb-select__option {
    padding: 10px 12px;
    border-radius: 6px;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #393940;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .cgb-select__option:hover {
    background-color: #f7f7f7;
  }

  #shopify-section-{{ section.id }} .cgb-field--error .cgb-select__trigger {
    border-color: #d83d0e;
  }

  #shopify-section-{{ section.id }} .cgb-field__hint {
    margin: 6px 0 0;
    font-family: 'Lato', sans-serif;
    font-size: 10px;
    line-height: 14px;
    color: #808080;
  }

  #shopify-section-{{ section.id }} .cgb-field__error {
    display: none;
    margin: 6px 0 0;
    font-family: 'Lato', sans-serif;
    font-size: 10px;
    line-height: 14px;
    color: #d83d0e;
  }

  #shopify-section-{{ section.id }} .cgb-field--error .cgb-field__input {
    border-color: #d83d0e;
  }

  #shopify-section-{{ section.id }} .cgb-field--error .cgb-field__hint {
    display: none;
  }

  #shopify-section-{{ section.id }} .cgb-field--error .cgb-field__error {
    display: block;
  }

  #shopify-section-{{ section.id }} .cgb-form__continue {
    display: block;
    width: 100%;
    margin-top: 24px;
  }

  /* Figma nodes 4585:80749 / 4585:81167 — button labels are Lato Bold 16/24. The
     theme's .button rule declares no font-family, and a <button> does not inherit
     one the way the hero's <a class="button"> does, so these fell back to the
     browser default (Arial). */
  #shopify-section-{{ section.id }} .button {
    font-family: 'Lato', sans-serif;
  }

  /* Figma node 4585:80755 "inputs" (Step 2) — Ceiling height / Budget range and
     Phone / Email sit in a two-up row on desktop (16px gap), stacked on mobile
     since no mobile frame was given for this node (same convention as elsewhere). */
  #shopify-section-{{ section.id }} .cgb-form__field-row {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cgb-form__field-row {
      flex-direction: row;
    }

    #shopify-section-{{ section.id }} .cgb-form__field-row .cgb-field {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  /* 48px gap between the "Your project" and "Your contact details" field groups */
  #shopify-section-{{ section.id }} .cgb-form__step-heading--spaced {
    margin-top: 48px;
  }

  #shopify-section-{{ section.id }} .cgb-field__textarea {
    height: 72px;
    min-height: 72px;
    padding-top: 12px;
    padding-bottom: 12px;
    resize: vertical;
    font-family: inherit;
  }

  /* Figma node 4585:80955 "Equipment Zone Group" / 4585:81546 "Contact method
     container" — pill-style toggle tags, 8px gap, radius 6, #f2f2f2 border */
  #shopify-section-{{ section.id }} .cgb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .cgb-tag {
    padding: 6px 12px;
    border: 1px solid #f2f2f2;
    border-radius: 6px;
    background-color: #ffffff;
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    line-height: 20px;
    color: #393940;
    cursor: pointer;
  }

  /* Figma node 4585:82176 "General forms / tag" selected state — solid fill,
     white border/text, confirmed via the filled-state example (Cardio,
     Selectorized and plate-loaded strength, Free weights and benches,
     and the Email contact-method tag all shown selected) */
  #shopify-section-{{ section.id }} .cgb-tag[aria-pressed="true"] {
    border-color: #ffffff;
    background-color: #d83d0e;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .cgb-field--error .cgb-tags {
    outline: 1px solid #d83d0e;
    outline-offset: 4px;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .cgb-form__disclaimer {
    margin: 24px 0 0;
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    line-height: 20px;
    color: #393940;
  }

  #shopify-section-{{ section.id }} .cgb-form__disclaimer a {
    color: #d83d0e;
  }

  #shopify-section-{{ section.id }} .cgb-form__buttons-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .cgb-form__back {
    flex: none;
  }

  /* Figma nodes 4585:81213 (loading), 4598:83423 (error), 4598:83503 (success) —
     full-card replacements, no step indicator/progress bar in any of them */
  #shopify-section-{{ section.id }} .cgb-form__status {
    text-align: center;
    padding: 48px 0 8px;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-icon svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-spinner {
    animation: cgb-form-spin 0.9s linear infinite;
  }

  @keyframes cgb-form-spin {
    to {
      transform: rotate(360deg);
    }
  }

  #shopify-section-{{ section.id }} .cgb-form__status-heading {
    margin: 0 0 8px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 28px;
    line-height: 36px;
    color: #393940;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-text {
    margin: 0 auto;
    max-width: 480px;
    font-family: 'Lato', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 26px;
    color: #808080;
  }

  #shopify-section-{{ section.id }} .cgb-form__status[data-cgb-status="error"] .cgb-form__status-text,
  #shopify-section-{{ section.id }} .cgb-form__status[data-cgb-status="success"] .cgb-form__status-text {
    max-width: 560px;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-action {
    display: block;
    width: 100%;
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-action[disabled] {
    opacity: 0.7;
    cursor: default;
  }

  /* Theme-editor-only QA aid so Success/Error can be reviewed before real
     submission wiring exists; not rendered on the live storefront. */
  #shopify-section-{{ section.id }} .cgb-form__status-preview {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px dashed #e5e5e5;
  }

  #shopify-section-{{ section.id }} .cgb-form__status-preview button {
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    padding: 6px 10px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    background: #ffffff;
    color: #393940;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="cgb-form" id="commercial-gym-buildouts-form">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext h1">{{ section.settings.heading }}</h2>
        {%- unless section.settings.subheading == blank -%}
          <div class="cgb-form__subheading rte">{{ section.settings.subheading }}</div>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    <div class="cgb-form__phases">
      <span class="cgb-form__phase">{{ section.settings.phase_1_text }}</span>
      <span class="cgb-form__phase-chevron" aria-hidden="true">
        <svg viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="cgb-form__phase">{{ section.settings.phase_2_text }}</span>
      <span class="cgb-form__phase-chevron" aria-hidden="true">
        <svg viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="cgb-form__phase">{{ section.settings.phase_3_text }}</span>
    </div>

    <div class="cgb-form__card">
      {%- assign cgb_form_dom_id = 'CommercialGymBuildoutsForm-' | append: section.id -%}
      {%- form 'contact', id: cgb_form_dom_id, class: 'cgb-form__form' -%}
        {%- comment -%}
          Accepted-submission hook: reflects the real, server-confirmed
          form.posted_successfully? state on every render of this page,
          including the redirect Shopify performs back to this page after
          a POST to /contact. The AJAX handler below parses the response
          HTML for this exact marker to decide loading -> success vs error;
          it never treats a resolved fetch or absence of a thrown JS error
          as acceptance on its own.
        {%- endcomment -%}
        <input type="hidden" data-cgb-form-posted value="{{ form.posted_successfully? }}">

        <div class="cgb-form__progress-row">
          <p class="cgb-form__step-label" data-cgb-step-label>Step 1/2</p>
          <div class="cgb-form__progress-track">
            <div class="cgb-form__progress-fill" data-cgb-progress-fill></div>
          </div>
        </div>

        <div class="cgb-form__banner" data-cgb-error-banner hidden>Check the highlighted fields and try again</div>

        <div class="cgb-form__step" data-cgb-step="1">
          <p class="cgb-form__step-heading">Tell us about your space</p>

          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" id="CGBFacilityTypeLabel-{{ section.id }}">Facility type <span class="cgb-field__required">*</span></label>
            <div class="cgb-select" data-cgb-select>
              <button type="button" class="cgb-field__input cgb-select__trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="CGBFacilityTypeLabel-{{ section.id }}" data-cgb-select-trigger>
                <span class="cgb-select__value cgb-select__value--placeholder" data-cgb-select-value data-placeholder="Select your facility type">Select your facility type</span>
                <svg class="cgb-select__chevron" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#393940" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="cgb-select__list" role="listbox" hidden data-cgb-select-list>
                <li class="cgb-select__option" role="option" data-value="Commercial Gyms &amp; Training Studios">Commercial Gyms &amp; Training Studios</li>
                <li class="cgb-select__option" role="option" data-value="Apartments, HOAs &amp; Multifamily">Apartments, HOAs &amp; Multifamily</li>
                <li class="cgb-select__option" role="option" data-value="Hotels &amp; Hospitality">Hotels &amp; Hospitality</li>
                <li class="cgb-select__option" role="option" data-value="Schools &amp; Universities">Schools &amp; Universities</li>
                <li class="cgb-select__option" role="option" data-value="Fire, Police &amp; Municipal">Fire, Police &amp; Municipal</li>
                <li class="cgb-select__option" role="option" data-value="Corporate, Medical &amp; Senior Living">Corporate, Medical &amp; Senior Living</li>
              </ul>
              <input type="hidden" name="contact[facility_type]" data-cgb-required value="">
            </div>
            <p class="cgb-field__error" data-cgb-error>Select your facility type</p>
          </div>

          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" for="CGBRoomSize-{{ section.id }}">Approximate room size <span class="cgb-field__required">*</span></label>
            <input type="text" id="CGBRoomSize-{{ section.id }}" name="contact[room_size]" class="cgb-field__input" placeholder="Enter your approximate room size" data-cgb-required>
            <p class="cgb-field__hint">Square footage or room dimensions, for example 1,200 sq ft or 40 x 30</p>
            <p class="cgb-field__error" data-cgb-error>Enter your approximate room size</p>
          </div>

          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" for="CGBDeliveryZip-{{ section.id }}">Delivery ZIP <span class="cgb-field__required">*</span></label>
            <input type="text" id="CGBDeliveryZip-{{ section.id }}" name="contact[delivery_zip]" class="cgb-field__input" placeholder="Enter your delivery ZIP" inputmode="numeric" maxlength="5" data-cgb-required data-cgb-pattern="^\d{5}$">
            <p class="cgb-field__error" data-cgb-error>Enter a valid 5-digit ZIP code</p>
          </div>

          <div class="cgb-field" data-cgb-field>
            <label class="cgb-field__label" id="CGBTargetWindowLabel-{{ section.id }}">Target opening or completion <span class="cgb-field__required">*</span></label>
            <div class="cgb-select" data-cgb-select>
              <button type="button" class="cgb-field__input cgb-select__trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="CGBTargetWindowLabel-{{ section.id }}" data-cgb-select-trigger>
                <span class="cgb-select__value cgb-select__value--placeholder" data-cgb-select-value data-placeholder="Select a target window">Select a target window</span>
                <svg class="cgb-select__chevron" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#393940" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="cgb-select__list" role="listbox" hidden data-cgb-select-list>
                <li class="cgb-select__option" role="option" data-value="As soon as possible">As soon as possible</li>
                <li class="cgb-select__option" role="option" data-value="1-3 months">1-3 months</li>
                <li class="cgb-select__option" role="option" data-value="3-6 months">3-6 months</li>
