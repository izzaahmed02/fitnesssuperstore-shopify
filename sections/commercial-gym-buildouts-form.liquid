          <div class="cgb-field" data-cgb-field>
            <p class="cgb-field__label">Preferred contact method <span class="cgb-field__required">*</span></p>
            <div class="cgb-tags" data-cgb-tag-group data-cgb-tag-mode="single" data-cgb-required>
              <input type="hidden" name="contact[preferred_contact_method]" data-cgb-tag-value value="">
