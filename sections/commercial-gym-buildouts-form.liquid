          <p class="cgb-form__disclaimer">
            We use your details to prepare your quote and to contact you about this request.
            {%- if shop.policies.privacy_policy.url != blank %}
              See our <a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>.
            {%- else %}
              See our Privacy Policy.
            {%- endif %}
