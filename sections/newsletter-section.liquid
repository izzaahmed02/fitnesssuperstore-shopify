{%- liquid
  assign sbg_source = section.settings.source | default: 'footer'
  assign nl_tags = 'newsletter'
  if section.settings.guide_capture
    assign nl_tags = nl_tags | append: ',smart_buyers_guide_requested,smart_buyers_guide_source_' | append: sbg_source
  endif
-%}
<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #FAF9F9;
  }
  #shopify-section-{{ section.id }} .newsletter-subtext {
    margin: 8px 0 0;
    max-width: 560px;
    font-size: 16px;
    font-weight: 400;
    line-height: 150%;
    color: #393940;
  }
  #shopify-section-{{ section.id }} .sbg-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 12px 24px;
    background: #D83D0E;
    border-radius: 8px;
    font-weight: 700;
    font-size: 16px;
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }}
  .container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;

  }
  #shopify-section-{{ section.id }}
  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  #shopify-section-{{ section.id }}
  .title {
   
    font-weight: 600;
  
    margin-top: 0;
    margin-bottom: 0;
  }
  .newsletter-form__wrapper .form__input {
    width: 522px;
    height: 48px;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px;
    background: #fff;
    padding-left: 12px;
  }
  .newsletter-form__wrapper button {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #D83D0E !important;
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    color: #fff;
    width: 138px;
    height: 48px;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .newsletter-form__wrapper button svg {
    margin-left: 17px;
    width: 8px;
  }
  .form-field {
    position: relative;
  }
  ::placeholder {
    color: #B3B3B3;
  }
  .form-note {
    display: flex;
    align-items: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #393940;
    margin-top: 12px;
  }
  .form-note svg {
    margin-right: 8px;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .title {
      font-size: 40px;
      font-weight: 600;
      line-height: 48px;
      margin-top: 0;
      margin-bottom: 0;
    }

    .newsletter-form__wrapper .form__input {
      width: 422px;
      height: 48px;
    }
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .title {
      font-size: 38px;
      font-weight: 600;
      line-height: 48px;
      margin-top: 0;
      margin-bottom: 0;
    }

    .newsletter-form__wrapper .form__input {
      width: 322px;
      height: 48px;
    }
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }

    #shopify-section-{{ section.id }}
    .wrapper {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }}
    .title {
      font-size: 20px;
      line-height: 26px;
      text-align: center;
      padding-inline: 20px;
      margin-bottom: 24px;
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }}
    .form-field {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .newsletter-form__wrapper button {
      position: static;
      width: 100%;
      border-radius: 8px;
    }

    .newsletter-form__wrapper .form__input {
      width: 100%;
    }

    .newsletter-form-wrapper {
      width: 100%;
    }
  }
</style>

<div class="page-width">
  <div class="wrapper">
    <div class="newsletter-heading">
      <h2 class="title">
        {{ section.settings.title }}
      </h2>
      {%- if section.settings.subtext != blank -%}
        <div class="newsletter-subtext">{{ section.settings.subtext }}</div>
      {%- endif -%}
    </div>
    <div
      class="newsletter-form-wrapper"
      {% if section.settings.guide_capture %}data-sbg-capture data-sbg-source="{{ sbg_source }}"{% endif %}
    >
      {% form 'customer'
        , class: 'newsletter-custom-form' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="{{ nl_tags }}">
        {%- if section.settings.guide_capture -%}
          <input type="hidden" name="contact[note]" value="Smart Buyer's Guide request — source: {{ sbg_source }}">
        {%- endif -%}
        <div class="newsletter-form__wrapper">
          <div class="form-field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="form__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
              aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              id="Subscribe"
              {% if section.settings.guide_capture %}data-sbg-submit data-sbg-source="{{ sbg_source }}"{% endif %}
              aria-label="{{ 'newsletter.button_label' | t }}">
              {{ section.settings.button_label | default: 'Subscribe' }}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="8"
                height="14"
                viewBox="0 0 8 14"
                fill="none">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7.53033 6.46967C7.82322 6.76256 7.82322 7.23744 7.53033 7.53033L1.53033 13.5303C1.23744 13.8232 0.762563 13.8232 0.46967 13.5303C0.176777 13.2374 0.176777 12.7626 0.46967 12.4697L5.93934 7L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z"
                  fill="white" />
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
              {%- render 'icon-error' -%}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="Newsletter-success--{{ section.id }}"
            {% if section.settings.guide_capture %}data-sbg-success{% endif %}
            tabindex="-1"
            autofocus>
            {% render 'icon-success' -%}
            {{- 'newsletter.success' | t }}
          </h3>
          {%- if section.settings.guide_capture and section.settings.show_guide_download and section.settings.guide_pdf_url != blank -%}
            <a
              class="sbg-download"
              href="{{ section.settings.guide_pdf_url }}"
              target="_blank"
              rel="noopener"
              data-sbg-download
              data-sbg-source="{{ sbg_source }}">
              {{ section.settings.download_label | default: 'Download the guide (PDF)' }}
            </a>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
      <div class="form-note">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none">
          <rect
            x="0.5"
            y="0.5"
            width="17"
            height="17"
            rx="8.5"
            fill="#D83D0E" />
          <rect
            x="0.5"
            y="0.5"
            width="17"
            height="17"
            rx="8.5"
            stroke="#D83D0E" />
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M13.9629 5.1775C14.1411 5.34077 14.1531 5.61752 13.9898 5.79563L7.57316 12.7956C7.49252 12.8836 7.37946 12.9348 7.26016 12.9374C7.14085 12.94 7.02567 12.8937 6.94129 12.8094L4.02463 9.8927C3.85377 9.72184 3.85377 9.44483 4.02463 9.27398C4.19548 9.10312 4.47249 9.10312 4.64334 9.27398L7.23691 11.8675L13.3448 5.20437C13.5081 5.02626 13.7848 5.01423 13.9629 5.1775Z"
            fill="white" />
        </svg>

        {{ section.settings.note }}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.guide_capture -%}
  <script src="{{ 'smart-buyers-guide-tracking.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
  {
    "name": "Newsletter",
    "class": "newsletter-section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      }, {
        "type": "richtext",
        "id": "subtext",
        "label": "Subtext"
      }, {
        "type": "text",
        "id": "note",
        "label": "Note"
      }, {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Subscribe"
      }, {
        "type": "header",
        "content": "Smart Buyer's Guide"
      }, {
        "type": "checkbox",
        "id": "guide_capture",
        "label": "Enable Smart Buyer's Guide capture",
        "info": "Adds smart_buyers_guide_requested + smart_buyers_guide_source_* tags at submission for Klaviyo.",
        "default": false
      }, {
        "type": "select",
        "id": "source",
        "label": "Lead source (Klaviyo attribution)",
        "options": [
          { "value": "footer", "label": "Footer / newsletter" },
          { "value": "comparison_charts", "label": "Comparison Charts page" },
          { "value": "blog", "label": "Blog page" },
          { "value": "welcome_email", "label": "Welcome email" },
          { "value": "existing_subscriber_campaign", "label": "Existing-subscriber campaign" }
        ],
        "default": "footer"
      }, {
        "type": "checkbox",
        "id": "show_guide_download",
        "label": "Show download button after submit",
        "default": false
      }, {
        "type": "text",
        "id": "guide_pdf_url",
        "label": "Guide PDF (Shopify CDN URL)",
        "info": "Use the exact versioned Shopify Files CDN URL — not the Google Drive link.",
        "default": "https://cdn.shopify.com/s/files/1/0884/2012/2940/files/fitness-superstore-smart-buyers-guide-to-fitness-equipment.pdf?v=1784326414"
      }, {
        "type": "text",
        "id": "download_label",
        "label": "Download button label",
        "default": "Download the guide (PDF)"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Newsletter"
      }
    ]
  }
{% endschema %}