<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #FAF9F9;
  }

  #shopify-section-{{ section.id }}
  .container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;

  }
  #shopify-section-{{ section.id }}
  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  #shopify-section-{{ section.id }}
  .title {
    font-size: 48px;
    font-weight: 600;
    line-height: 68px;
    margin-top: 0;
    margin-bottom: 0;
  }
  .newsletter-form__wrapper .form__input {
    width: 522px;
    height: 48px;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px;
    background: #fff;
    padding-left: 12px;
  }
  .newsletter-form__wrapper button {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #F1592A !important;
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    color: #fff;
    width: 138px;
    height: 48px;
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .newsletter-form__wrapper button svg {
    margin-left: 17px;
    width: 8px;
  }
  .form-field {
    position: relative;
  }
  ::placeholder {
    color: #B3B3B3;
  }
  .form-note {
    display: flex;
    align-items: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #393940;
    margin-top: 12px;
  }
  .form-note svg {
    margin-right: 8px;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .title {
      font-size: 40px;
      font-weight: 600;
      line-height: 48px;
      margin-top: 0;
      margin-bottom: 0;
    }

    .newsletter-form__wrapper .form__input {
      width: 422px;
      height: 48px;
    }
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .title {
      font-size: 38px;
      font-weight: 600;
      line-height: 48px;
      margin-top: 0;
      margin-bottom: 0;
    }

    .newsletter-form__wrapper .form__input {
      width: 322px;
      height: 48px;
    }
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }

    #shopify-section-{{ section.id }}
    .wrapper {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }}
    .title {
      font-size: 20px;
      line-height: 26px;
      text-align: center;
      padding-inline: 20px;
      margin-bottom: 24px;
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }}
    .form-field {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .newsletter-form__wrapper button {
      position: static;
      width: 100%;
      border-radius: 8px;
    }

    .newsletter-form__wrapper .form__input {
      width: 100%;
    }

    .newsletter-form-wrapper {
      width: 100%;
    }
  }
</style>

<div class="page-width">
  <div class="wrapper">
    <h2 class="title">
      {{ section.settings.title }}
    </h2>
    <div class="newsletter-form-wrapper">
      {% form 'customer'
        , class: 'newsletter-custom-form' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter">
        <div class="newsletter-form__wrapper">
          <div class="form-field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="form__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
              aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              id="Subscribe"
              aria-label="{{ 'newsletter.button_label' | t }}">
              Subscribe
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="8"
                height="14"
                viewBox="0 0 8 14"
                fill="none">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7.53033 6.46967C7.82322 6.76256 7.82322 7.23744 7.53033 7.53033L1.53033 13.5303C1.23744 13.8232 0.762563 13.8232 0.46967 13.5303C0.176777 13.2374 0.176777 12.7626 0.46967 12.4697L5.93934 7L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z"
                  fill="white" />
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
              {%- render 'icon-error' -%}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="Newsletter-success--{{ section.id }}"
            tabindex="-1"
            autofocus>
            {% render 'icon-success' -%}
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {% endform %}
      <div class="form-note">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none">
          <rect
            x="0.5"
            y="0.5"
            width="17"
            height="17"
            rx="8.5"
            fill="#F1592A" />
          <rect
            x="0.5"
            y="0.5"
            width="17"
            height="17"
            rx="8.5"
            stroke="#F1592A" />
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M13.9629 5.1775C14.1411 5.34077 14.1531 5.61752 13.9898 5.79563L7.57316 12.7956C7.49252 12.8836 7.37946 12.9348 7.26016 12.9374C7.14085 12.94 7.02567 12.8937 6.94129 12.8094L4.02463 9.8927C3.85377 9.72184 3.85377 9.44483 4.02463 9.27398C4.19548 9.10312 4.47249 9.10312 4.64334 9.27398L7.23691 11.8675L13.3448 5.20437C13.5081 5.02626 13.7848 5.01423 13.9629 5.1775Z"
            fill="white" />
        </svg>

        {{ section.settings.note }}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Newsletter",
    "class": "newsletter-section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      }, {
        "type": "text",
        "id": "note",
        "label": "Note"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Newsletter"
      }
    ]
  }
{% endschema %}