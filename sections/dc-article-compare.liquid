  .compareChart .scroll-container {
    position: relative;
    width: 100%;
    max-height: 100%;
  }

  .compareChart .comparison-chart-wrapper {
    height: auto;
    width: 100%;  
    border-radius: 12px;
    overflow-x: auto;
    overflow-y: visible;
