

{% assign chart = page.metafields.custom.comparison_chart.value %}
{% assign products = chart.products %}


{% assign chart = page.metafields.custom.comparison_chart.value %}
{% if chart %}
  <div>
    <h2>Comparison Chart Loaded</h2>
    {% for product in chart.products.value %}
      <div>
        <h3>{{ product.title.value }}</h3>
        <img src="{{ product.image | image_url: width: 200 }}" alt="{{ product.title.value }}">
        <p><a href="{{ product.product_url.value }}">View Product</a></p>

        <ul>
          {% for feature in product.features.value %}
            <li><strong>{{ feature.name.value }}:</strong> {{ feature.value.value }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No chart found.</p>
{% endif %}


{%- comment -%}
Step 1: Get all unique feature names across all products
{%- endcomment -%}
{% assign all_keys_string = "" %}
{% assign all_keys = "" | split: "," %}
{% for product in products %}
  {% for feature in product.features %}
    {% assign key = feature.name | strip %}
    {% unless all_keys_string contains key %}
      {% assign all_keys = all_keys | join: '|' | append: '|' | append: key | split: '|' %}
      {% assign all_keys_string = all_keys_string | append: key | append: "|" %}
    {% endunless %}
  {% endfor %}
{% endfor %}

<div class="comparison-wrapper">
  <div class="comparison-scroll-area">
    <table class="comparison-table">
      <thead>
        <tr>
          <th class="sticky-col param-col"></th>
          {% for product in products %}
            <th>
              <h4 style="text-align: center;">
                {% if product.product_url %}
                  <a href="{{ product.product_url }}" target="_blank">{{ product.title }}</a>
                {% else %}
                  {{ product.title }}
                {% endif %}
              </h4>
              {% if product.image %}
                <p>
                  <img src="{{ product.image | image_url: width: 160 }}" alt="{{ product.title }}" style="margin: auto; margin-bottom: 16px;">
                </p>
              {% endif %}
            </th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for key in all_keys %}
          <tr>
            <th class="sticky-col param-col">{{ key }}</th>
            {% for product in products %}
              {% assign value = '' %}
              {% for feature in product.features %}
                {% if feature.name == key %}
                  {% assign value = feature.value %}
                  {% break %}
                {% endif %}
              {% endfor %}
              <td>{{ value }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>






{% comment %}
{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>


<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>
{% endcomment %}

{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
