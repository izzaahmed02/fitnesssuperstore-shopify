{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


{% assign rows = page.metafields.custom.comparison_rows.value %}

{% if rows.size > 0 %}
  {% assign first_row = rows.first %}

  {% assign product_1 = first_row.product_1.value %}
  {% assign product_2 = first_row.product_2.value %}
  {% assign product_3 = first_row.product_3.value %}
  {% assign product_4 = first_row.product_4.value %}

  <table class="comparison-table" style="width:100%; border-collapse: collapse; text-align: left;">
    <thead>
      <tr>
        <th style="border: 1px solid #ddd; padding: 10px;">Feature</th>

        {% if product_1 %}
          <th style="border: 1px solid #ddd; padding: 10px;">
            {% if product_1.featured_image %}
              <img src="{{ product_1.featured_image | image_url: width: 120 }}" alt="{{ product_1.title }}" style="max-width: 100px;"><br>
            {% endif %}
            <div style="font-weight: bold;">{{ product_1.title }}</div>
            <div>{{ product_1.price | money }}</div>
            <div><a href="{{ product_1.url }}" target="_blank">View Product</a></div>
          </th>
        {% endif %}

        {% if product_2 %}
          <th style="border: 1px solid #ddd; padding: 10px;">
            {% if product_2.featured_image %}
              <img src="{{ product_2.featured_image | image_url: width: 120 }}" alt="{{ product_2.title }}" style="max-width: 100px;"><br>
            {% endif %}
            <div style="font-weight: bold;">{{ product_2.title }}</div>
            <div>{{ product_2.price | money }}</div>
            <div><a href="{{ product_2.url }}" target="_blank">View Product</a></div>
          </th>
        {% endif %}

        {% if product_3 %}
          <th style="border: 1px solid #ddd; padding: 10px;">
            {% if product_3.featured_image %}
              <img src="{{ product_3.featured_image | image_url: width: 120 }}" alt="{{ product_3.title }}" style="max-width: 100px;"><br>
            {% endif %}
            <div style="font-weight: bold;">{{ product_3.title }}</div>
            <div>{{ product_3.price | money }}</div>
            <div><a href="{{ product_3.url }}" target="_blank">View Product</a></div>
          </th>
        {% endif %}

        {% if product_4 %}
          <th style="border: 1px solid #ddd; padding: 10px;">
            {% if product_4.featured_image %}
              <img src="{{ product_4.featured_image | image_url: width: 120 }}" alt="{{ product_4.title }}" style="max-width: 100px;"><br>
            {% endif %}
            <div style="font-weight: bold;">{{ product_4.title }}</div>
            <div>{{ product_4.price | money }}</div>
            <div><a href="{{ product_4.url }}" target="_blank">View Product</a></div>
          </th>
        {% endif %}
      </tr>
    </thead>

    <tbody>
      {% for row in rows %}
        <tr>
          <td style="border: 1px solid #ddd; padding: 10px; font-weight: bold;">{{ row.row_label }}</td>
          {% if product_1 %}<td style="border: 1px solid #ddd; padding: 10px;">{{ row.column_1 }}</td>{% endif %}
          {% if product_2 %}<td style="border: 1px solid #ddd; padding: 10px;">{{ row.column_2 }}</td>{% endif %}
          {% if product_3 %}<td style="border: 1px solid #ddd; padding: 10px;">{{ row.column_3 }}</td>{% endif %}
          {% if product_4 %}<td style="border: 1px solid #ddd; padding: 10px;">{{ row.column_4 }}</td>{% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p>No comparison data available.</p>
{% endif %}




<style>
  .comparison-wrapper {
  overflow-x: auto;
  margin: 2rem 0;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-family: Arial, sans-serif;
  font-size: 14px;
}

.comparison-table thead th {
  background-color: #f4f4f4;
  padding: 12px;
  border: 1px solid #ddd;
  font-weight: bold;
}

.comparison-table td {
  padding: 12px;
  border: 1px solid #ddd;
  vertical-align: top;
}

.comparison-table tr:nth-child(even) {
  background-color: #fafafa;
}

</style>


{% comment %}

<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>


<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>

{% endcomment %}


{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
