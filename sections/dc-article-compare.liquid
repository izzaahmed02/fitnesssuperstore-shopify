{% assign chart = product.metafields.custom.comparison_chart.value %}
{% if chart %}
  <p>✅ Chart found: {{ chart.id }}</p>

  {% assign products = chart.products.value %}
  <p>Found {{ products.size }} comparison products</p>

  {% assign all_features = shop.metaobjects.comparison_feature.values %}
  <p>Found {{ all_features.size }} total features</p>

  <div class="comparison-chart">
    {% for product in products %}
      <div class="comparison-column">
        <h3>{{ product.title }}</h3>

        <p><code>Raw URL:</code> {{ product.product_url }}</p>

        {% assign handle = product.product_url | split: '/' | last %}
        <p><code>Parsed Handle:</code> {{ handle }}</p>

        {% assign matching_features = all_features | where: "product_name", handle %}
        <p><code>Features Found:</code> {{ matching_features.size }}</p>

        {% if product.image %}
          <img src="{{ product.image | image_url: width: 400 }}" alt="{{ product.title }}">
        {% else %}
          <p>No image found</p>
        {% endif %}

        <p><a href="{{ product.product_url }}">View Product</a></p>

        <ul class="comparison-features">
          {% for feature in matching_features %}
            <li><strong>{{ feature.name }}:</strong> {{ feature.value }}</li>
          {% endfor %}
          {% if matching_features.size == 0 %}
            <li>No features listed</li>
          {% endif %}
        </ul>
      </div>
    {% endfor %}
  </div>

{% else %}
  <p>❌ No comparison chart metafield linked on this product.</p>
{% endif %}




{% comment %}
{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>


<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>
{% endcomment %}

{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
