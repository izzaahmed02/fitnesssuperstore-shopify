{% assign chart = page.metafields.custom.comparison_chart.value %}
{% if chart %}
  <div class="comparison-chart">
    {% for linked_product in chart.products.value %}
      {% assign product = all_products[linked_product.handle] %}
      {% assign comparison_product = product.metafields.custom.comparison_features.value %}
<pre>{{ comparison_product | json }}</pre>

      <div class="comparison-column">

        <!-- Metaobject title -->
        <h3>
          {% if comparison_product.title %}
            {{ comparison_product.title }}
          {% else %}
            {{ product.title }}
          {% endif %}
        </h3>

        <!-- Metaobject image -->
        {% if comparison_product.image %}
          <img src="{{ comparison_product.image | image_url: width: 400 }}" alt="{{ comparison_product.title }}">
        {% endif %}

        <!-- Metaobject product URL -->
        {% if comparison_product.product_url %}
          <p><a href="{{ comparison_product.product_url }}">View Product</a></p>
        {% endif %}

        <!-- Features -->
        <ul class="comparison-features">
          {% if comparison_product.features %}
            {% for feature in comparison_product.features %}
              
              <li><strong>{{ feature.name }}:</strong> {{ feature.value }}</li>
            {% endfor %}
          {% else %}
            <li>No features listed</li>
          {% endif %}
        </ul>

      </div>
    {% endfor %}
  </div>
{% else %}
  <p>❌ No comparison chart metafield linked on this page.</p>
{% endif %}


{% comment %}
{% assign chart = page.metafields.custom.comparison_chart.value %}
{% if chart %}
  <div class="comparison-chart">
    {% for product in chart.products.value %}
      <div class="comparison-column">
        <h3>{{ product.title }}</h3>

        {% if product.featured_image %}
          <img src="{{ product.featured_image }}" alt="{{ product.title }}">
        {% elsif product.images[0] %}
          <img src="{{ product.images[0] }}" alt="{{ product.title }}">
        {% endif %}

        <p>
          <a href="/products/{{ product.handle }}">View Product</a>
        </p>

        <ul class="comparison-features">
          {% assign features = product.metafields.custom.comparison_features.value %}
          {% if features %}
            {% for feature in features %}
              <li><strong>{{ feature.name }}:</strong> {{ feature.value }}</li>
            {% endfor %}
          {% else %}
            <li>No features listed</li>
          {% endif %}
        </ul>
      </div>
    {% endfor %}
  </div>
{% endif %}
{% endcomment %}

{% comment %}
{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>


<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>
{% endcomment %}

{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
