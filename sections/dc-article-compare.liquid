{%  if page.metafields.custom.comparison_products.value %}

<style>


.comparison-chart-outer{
    padding: 0px 16px;
  }

  .feature-col{
    width: 193px;
  }

  .product-header{
    width: 163.6px;
  }

  thead, .even-class{
    background: #EDEFF3;

  }
.comparison-chart-outer {
  width: 100%;
  overflow-y: visible;
  position: relative;
}

.comparison-chart-wrapper {
 overflow-x: auto;
  width: 100%;
  border-radius: 12px;

}

.comparison-table {
  width: max-content;
  border-collapse: collapse;
  table-layout: fixed;
}

.comparison-table th{
  padding: 12px;
  border: 1px solid #e5e5e5;
  text-align: center;
  vertical-align: top;

  word-wrap: break-word;
  white-space: normal;
}

.comparison-table td {
  padding: 12px;
  border: 1px solid #e5e5e5;
  text-align: left;
  vertical-align: top;

  word-wrap: break-word;
  white-space: normal;
}

.feature-col {
  font-weight: 600;
  text-align: left;
  position: sticky;
    left: 0;
    z-index: 1;

}

   .comparison-table thead th.feature-col {
    z-index: 1;
     background: #EDEFF3;
  }

.feature-label {
  text-align: left;
color: #000;
  font-family: Lato;
font-weight: 700;
font-style: Bold;
font-size: 16px;
line-height: 24px;
letter-spacing: 0;
vertical-align: middle;
    position: sticky;
    left: 0;
    z-index: 1;
}

  .even-class .feature-label {
       background-color: #EDEFF3;
  }

  .odd-class .feature-label {
    background-color: #fff;
  }

.feature-value {
  color: #000;
  font-family: Lato;
  font-weight: 400;
  font-style: Regular;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  vertical-align: middle;
}

.product-header {
  text-align: center;
}

.product-title {
  font-family: Lato;
font-weight: 700;
font-style: Bold;
font-size: 18px;
line-height: 24px;
letter-spacing: 0px;
text-align: center;
  color: #000;
  margin-bottom: 24px;

}

.product-header-image img {
  max-width: 100px;
  width: 91px;
    height: 120px;

}

  .customTitle{
font-family: Oswald;
font-weight: 600;
font-size: 48px;
margin-bottom: 52px;
line-height: 68px;
letter-spacing: 0;
text-align: center;
text-transform: uppercase;
    

  }

  .comparisonDescp{
    max-width: 842px;
    margin: 0 auto;
  }

  .customContent{
font-family: Lato;
font-weight: 400;
font-size: 16px;
line-height: 24px;
letter-spacing: 0px;
text-align: center;

  }

.right_arrow svg {
  width: 20px;
  animation: move 1s linear infinite;
  transform-origin: center;
}

  .right_arrow{
    text-align: right;
    margin-right: 10px;
  }

@keyframes move {
  0% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(5px);
  }
  100% {
    transform: translateX(0);
  }
}

  @media (max-width: 1100px) {
  .feature-col {
    width: 165px;
}
}

@media (max-width: 768px) {

   .customTitle{
font-family: Oswald;
font-weight: 600;
font-size: 24px;
margin-bottom: 20px;
line-height: 32px;
letter-spacing: 0;
text-align: center;
text-transform: uppercase;
    

  }

      .comparisonDescp {
        padding: 0 16px;
    }
  .product-header-image img {
    max-width: 80px;
  }

  .feature-col {
    width: 100px;
}

.product-header {
    width: 155px;
}
}


  @media (max-width: 500px) {

  .feature-col {
    width: 80px;
}

.product-header {
    width: 124px;
}
}

</style>

<div class="comparisonDescp">
<h1 class="main-page-title page-title customTitle{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>

  <div class="customContent">{{ page.content }}</div>
  </div>

<div class="comparison-chart-outer">
  <div class="right_arrow">
    <svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 5H15M15 5L11 9M15 5L11 1" stroke="#202A39" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>

  <div class="comparison-chart-wrapper">
    <table class="comparison-table">
      <thead>
        <tr>
          <th class="feature-col"></th>
          {% assign products = page.metafields.custom.comparison_products.value %}
          {% assign feature_names = '' %}
          {% assign product_features_map = '' %}
          {% for product in products %}
            {% assign feature_map = '' %}
            {% for feature in product.features.value %}
              {% assign fname = feature.name %}
              {% assign fvalue = feature.value %}
              {% unless feature_names contains fname %}
                {% assign feature_names = feature_names | append: fname | append: '||' %}
              {% endunless %}
              {% assign feature_map = feature_map | append: fname | append: '::' | append: fvalue | append: '||' %}
            {% endfor %}
            {% assign product_features_map = product_features_map | append: feature_map | append: '##' %}
          {% endfor %}
          {% assign feature_names = feature_names | split: '||' | uniq %}
          {% assign product_feature_blocks = product_features_map | split: '##' | reject: '' %}

          {% for product in products %}
            <th class="product-header">
              <div class="product-title">{{ product.custom_title }}</div>
              {% if product.image %}
                <div class="product-header-image">
                  <img
                    src="{{ product.image | image_url: width: 200 }}"
                    alt="{{ product.custom_title | escape }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}
            </th>
          {% endfor %}
        </tr>
      </thead>
     <tbody>
  {% for fname in feature_names %}
    {% unless fname == blank %}
      {% assign mod = forloop.index | modulo: 2 %}
      <tr class="{% if mod == 0 %}even-class{% else %}odd-class{% endif %}">
        <td class="feature-label">{{ fname }}</td>
        {% for product in products %}
          {% assign match = '—' %}
          {% for feature in product.features.value %}
            {% if feature.name == fname %}
              {% assign match = feature.value %}
              {% break %}
            {% endif %}
          {% endfor %}
          <td class="feature-value">{{ match }}</td>
        {% endfor %}
      </tr>
    {% endunless %}
  {% endfor %}
</tbody>

    </table>
  </div>
</div>





{% else %}


{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>


<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>

  {% endif %}


{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
