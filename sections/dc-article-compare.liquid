{{ 'main-article-compare.css' | asset_url | stylesheet_tag }}


<div class="comparison-scroll-area">
  <table class="comparison-table">
    <thead>
      <tr>
        {% for header in page.metafields.custom.comparison_table.headers %}
          <th class="{% if forloop.first %}sticky-col param-col{% endif %}" style="text-align: center;">
            {{ header }}
          </th>
        {% endfor %}
      </tr>
      <tr>
        <th class="sticky-col param-col" style="text-align: center;">Model</th>
        {% for model in page.metafields.custom.comparison_table.models %}
          <th style="text-align: center;">
            <div class="model-block">
              <h3 style="text-align: center;">
                <a href="{{ model.url }}" data-acsb-clickable="true" data-acsb-navigable="true">{{ model.name }}</a>
              </h3>
              {% if model.image %}
                <img src="{{ model.image | img_url: '160x160' }}" style="margin-bottom: 16px; display: block; margin-left: auto; margin-right: auto;" alt="{{ model.name }}">
              {% endif %}
            </div>
          </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for header in page.metafields.custom.comparison_table.headers %}
        {% unless forloop.first %}
          <tr style="text-align: center;">
            <th class="sticky-col param-col">{{ header }}</th>
            {% for model in page.metafields.custom.comparison_table.models %}
              {% assign attribute_value = '' %}
              {% for attr in model.attributes %}
                {% if attr contains header %}
                  {% assign parts = attr | split: ': ' %}
                  {% if parts.size > 1 %}
                    {% assign attribute_value = parts[1] %}
                  {% endif %}
                {% endif %}
              {% endfor %}
              <td>{{ attribute_value }}</td>
            {% endfor %}
          </tr>
        {% endunless %}
      {% endfor %}
    </tbody>
  </table>
</div>

<style>
.comparison-scroll-area {
  overflow-x: auto;
  max-width: 100%;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
}

.comparison-table th, .comparison-table td {
  border: 1px solid #ddd;
  padding: 8px;
  vertical-align: middle;
}

.sticky-col {
  position: sticky;
  left: 0;
  background: #f8f8f8;
  z-index: 1;
}

.param-col {
  font-weight: bold;
}

.model-block img {
  max-width: 160px;
  height: auto;
}
</style>





{% comment %}



<div class="page-width">
    <div class="comparison-main__wrapper">
        <h1 class="comparison-main__title">
            {{ page.title }}
        </h1>
        {{ page.content }}
    </div>
</div>





<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scrollArea = document.querySelector('.comparison-scroll-area');
		const btnLeft = document.querySelector('.scroll-btn--left');
		const btnRight = document.querySelector('.scroll-btn--right');
		const tableHeaderRow = document.querySelector('.comparison-table thead tr');
		const columns = tableHeaderRow.querySelectorAll('th:not(.sticky-col)');
		const colCount = columns.length;
		if (colCount <= 4) {
			btnLeft.style.display = 'none';
			btnRight.style.display = 'none';
			return;
		}
		const firstCol = columns[0];
		let scrollStep = firstCol.offsetWidth;

		function updateArrows() {
			if (scrollArea.scrollLeft <= 0) {
				btnLeft.classList.add('disabled');
			} else {
				btnLeft.classList.remove('disabled');
			}
			const atRightEdge = scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;
			if (atRightEdge) {
				btnRight.classList.add('disabled');
			} else {
				btnRight.classList.remove('disabled');
			}
		}

		updateArrows();
		scrollArea.addEventListener('scroll', updateArrows);
		btnLeft.addEventListener('click', () => {
			if (btnLeft.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: -scrollStep,
				behavior: 'smooth'
			});
		});
		btnRight.addEventListener('click', () => {
			if (btnRight.classList.contains('disabled')) return;
			scrollArea.scrollBy({
				left: scrollStep,
				behavior: 'smooth'
			});
		});
	});
</script>

{% endcomment %}


{% schema %}
{
  "name": "Comparison Inner",
  "class": "section comparison-main",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
