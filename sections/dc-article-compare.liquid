      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
