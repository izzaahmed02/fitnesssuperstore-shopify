  position: fixed;
  top: 0; /* Change this to match .section-header height */
  z-index: 2000;
  background: #EDEFF3;

  overflow-x: auto;
  overflow-y: hidden;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .compareChart .sticky-header.visible {
background: #fff;
  opacity: 1;
  visibility: visible;
  }

  .compareChart .sticky-header table {
    width: max-content;
    border-collapse: collapse;
    table-layout: fixed;
    margin: 0;
  }

  .compareChart .sticky-header th {
    padding: 12px;
    border: 1px solid #e5e5e5;
    text-align: center;
    vertical-align: top;
    max-width: 163.6px;
    word-wrap: break-word;
    white-space: normal;
    background: #EDEFF3 !important;
  }

  .compareChart .sticky-header .feature-col {
    position: sticky;
    left: 0;
    z-index: 2001;
    background: #EDEFF3 !important;
  }

