  }
</style>

<!-- Calculate product count once -->
{% assign products = page.metafields.custom.comparison_products.value %}
{% assign product_count = products.size %}

<!-- Determine column class based on count -->
{% assign column_class = 'cols-' | append: product_count %}

<div class="comparisonDescp">
  <h1 class="main-page-title page-title customTitle{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="customContent">{{ page.content }}</div>
</div>

<!-- Sticky header that appears when scrolling -->
<div class="compareChart sticky-header {{ column_class }}" id="stickyHeader">
  <table>
    <colgroup>
      <col class="col-feature">
      {% assign products = page.metafields.custom.comparison_products.value %}
      {% for product in products %}
        <col class="col-product">
      {% endfor %}
    </colgroup>
    <thead>
      <tr>
        <th class="feature-col"></th>
        {% for product in products %}          
          <th class="product-header">
             <a href="{{ product.url }}">
            <div class="product-title">{{ product.custom_title }}</div>
            {% if product.image %}
              <div class="product-header-image">
                <img
                  src="{{ product.image | image_url: width: 200 }}"
                  alt="{{ product.custom_title | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
             </a>
          </th>           
        {% endfor %}
      </tr>
    </thead>
  </table>
</div>

<div class="comparison-chart-outer compareChart {{ column_class }}">

  <div class="scroll-arrows sticky" id="stickyScrollArrows" style="display: none;">
    <button class="scroll-btn left" aria-label="Scroll left">&larr;</button>
    <button class="scroll-btn right" aria-label="Scroll right">&rarr;</button>
  </div>

  <div class="scroll-container">
    <div class="comparison-chart-wrapper" id="scrollableContent">
      <table class="comparison-table" id="mainTable">
        <colgroup>
          <col class="col-feature">
          {% assign products = page.metafields.custom.comparison_products.value %}
          {% for product in products %}
            <col class="col-product">
          {% endfor %}
        </colgroup>

        <thead>
          <tr>
            <th class="feature-col"></th>
            {% assign products = page.metafields.custom.comparison_products.value %}
            {% assign feature_names = '' %}
            {% assign product_features_map = '' %}
            {% for product in products %}
              {% assign feature_map = '' %}
              {% for feature in product.features.value %}
                {% assign fname = feature.name %}
                {% assign fvalue = feature.value1 %}
                {% assign fname_with_delimiters = '|||' | append: fname | append: '|||' %}
                {% unless feature_names contains fname_with_delimiters %}
                  {% assign feature_names = feature_names | append: '|||' | append: fname | append: '|||' %}
                {% endunless %}
                {% assign feature_map = feature_map | append: fname | append: '::' | append: fvalue | append: '||' %}
              {% endfor %}
              {% assign product_features_map = product_features_map | append: feature_map | append: '##' %}
            {% endfor %}
            {% assign feature_names = feature_names | split: '|||' | uniq | compact %}
            {% assign product_feature_blocks = product_features_map | split: '##' | reject: '' %}

            {% for product in products %}          
              <th class="product-header">
                 <a href="{{ product.url }}">
                <div class="product-title">{{ product.custom_title }}</div>
                {% if product.image %}
                  <div class="product-header-image">
                    <img
                      src="{{ product.image | image_url: width: 200 }}"
                      alt="{{ product.custom_title | escape }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}
                 </a>
              </th>           
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for fname in feature_names %}
            {% unless fname == blank %}
              {% assign mod = forloop.index | modulo: 2 %}
              <tr class="{% if mod == 0 %}even-class{% else %}odd-class{% endif %}">
                <td class="feature-label">{{ fname }}</td>
                {% for product in products %}
                  {% assign match = '—' %} 
                  {% for feature in product.features.value %}
                    {% if feature.name == fname %}
                      {% assign match = feature.value1 | metafield_tag %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  <td class="feature-value">{{ match }}</td>
                {% endfor %}
              </tr>
            {% endunless %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  
  <div class="scroll-arrows bottom-arrows" id="bottomScrollArrows">
    <button class="scroll-btn left bottom" aria-label="Scroll left">&larr;</button>
    <button class="scroll-btn right bottom" aria-label="Scroll right">&rarr;</button>
  </div>
</div>

{% if page.metafields.custom.below_the_fold_content %}
<div class="belowfoldCharts">
{{ page.metafields.custom.below_the_fold_content }}
  </div>
{% endif %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  const scrollableContent = document.getElementById("scrollableContent");
  const stickyScrollArrows = document.getElementById("stickyScrollArrows");
  const bottomScrollArrows = document.getElementById("bottomScrollArrows");
  const stickyHeader = document.getElementById("stickyHeader");
  const mainTable = document.getElementById("mainTable");

  const allLeftBtns = document.querySelectorAll(".scroll-btn.left");
  const allRightBtns = document.querySelectorAll(".scroll-btn.right");

  // Check if we have 5 or more columns (products + feature column)
  const productCount = document.querySelectorAll(".col-product").length;
  const shouldShowStickyArrows = productCount >= 4; // 4+ products = 5+ columns total

  if (shouldShowStickyArrows) {
    stickyScrollArrows.style.display = "flex";
    bottomScrollArrows.classList.add("hidden");
  }

  // Handle sticky header visibility and positioning based on page scroll
  function handleStickyHeader() {
    const scrollContainer = document.querySelector('.scroll-container');
    const scrollContainerRect = scrollContainer.getBoundingClientRect();
    const tableRect = mainTable.getBoundingClientRect();
    const tableBottom = tableRect.bottom;
    
    // Get section header height dynamically
    const sectionHeader = document.querySelector('.section-header');
    const sectionHeaderHeight = sectionHeader ? sectionHeader.offsetHeight : 0;
    
    // Show sticky header when:
    // 1. scroll-container top reaches or goes above the section header bottom
    // 2. We haven't scrolled past the entire table
    const shouldShowSticky = scrollContainerRect.top <= sectionHeaderHeight && tableBottom > (sectionHeaderHeight + 100);
    
    if (shouldShowSticky) {
      if (!stickyHeader.classList.contains('visible')) {
        stickyHeader.classList.add('visible');
        
        // Get the exact position of the scrollable content area
        const scrollableRect = scrollableContent.getBoundingClientRect();
        stickyHeader.style.left = scrollableRect.left + 'px';
        stickyHeader.style.width = scrollableRect.width + 'px';
        stickyHeader.style.top = sectionHeaderHeight + 'px';
      }
    } else {
      if (stickyHeader.classList.contains('visible')) {
        stickyHeader.classList.remove('visible');
      }
    }
  }

  // Sync horizontal scroll between main table and sticky header
  function syncHorizontalScroll() {
    const stickyTable = stickyHeader.querySelector('table');
    if (stickyTable) {
      stickyHeader.scrollLeft = scrollableContent.scrollLeft;
    }
  }

  function updateArrowStates() {
    const scrollLeft = scrollableContent.scrollLeft;
    const maxScrollLeft = scrollableContent.scrollWidth - scrollableContent.clientWidth;

    allLeftBtns.forEach(btn => {
      if (scrollLeft <= 0) {
        btn.disabled = true;
        btn.classList.add("disabled");
      } else {
        btn.disabled = false;
        btn.classList.remove("disabled");
      }
    });

    allRightBtns.forEach(btn => {
      if (scrollLeft >= maxScrollLeft - 1) {
        btn.disabled = true;
        btn.classList.add("disabled");
      } else {
        btn.disabled = false;
        btn.classList.remove("disabled");
      }
    });
  }

  function scrollContentBy(amount) {
    scrollableContent.scrollBy({
      left: amount,
      behavior: "smooth"
    });
  }

  allLeftBtns.forEach(btn => {
    btn.addEventListener("click", () => scrollContentBy(-200));
  });

  allRightBtns.forEach(btn => {
    btn.addEventListener("click", () => scrollContentBy(200));
  });

  // Listen to horizontal scroll on the table container
  scrollableContent.addEventListener("scroll", () => {
    updateArrowStates();
    syncHorizontalScroll();
  });
  
  // Listen to page scroll for sticky header
  window.addEventListener("scroll", handleStickyHeader);
  window.addEventListener("resize", updateArrowStates);

  updateArrowStates(); // Initial call
  handleStickyHeader(); // Initial call
});

document.addEventListener("DOMContentLoaded", function () {
  const titles = document.querySelectorAll(".product-title");
  let maxHeight = 0;

  titles.forEach(title => {
    const height = title.offsetHeight;
    if (height > maxHeight) {
      maxHeight = title.offsetHeight;
    }
  });

  titles.forEach(title => {
    title.style.height = maxHeight + "px";
  });
});
</script>




