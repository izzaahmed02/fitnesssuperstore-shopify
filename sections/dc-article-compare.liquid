  }

  .compareChart .custom-scrollbar.horizontal {
    height: 5px;
    top: 0;
    left: 0;
    border-radius: 4px;
    background: #aaa;
    z-index: 1;
  }

  .compareChart .custom-scrollbar.vertical {
    width: 5px;
    top: 0;
    right: 0;
    border-radius: 4px;
    background: #aaa;
    z-index: 1;
  }

  .compareChart .scrollbar-container {
    position: relative;
  }

  .compareChart .comparison-chart-outer{
    padding: 0px 16px;
  }

  .compareChart .feature-col{
    max-width: 100%;
    font-weight: 600;
    text-align: left;
    position: sticky;
    left: 0;
    z-index: 2;
  }

  .compareChart thead, .compareChart .even-class{
    background: #EDEFF3;
  }

  .compareChart .comparison-chart-outer {
    width: 100%;
    overflow-y: visible;
    position: relative;
    margin-bottom: 50px;
  }

  .compareChart .comparison-table {
    width: max-content;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .compareChart .comparison-table th{
    padding: 12px;
    border: 1px solid #e5e5e5;
    text-align: center;
    vertical-align: top;
    word-wrap: break-word;
    white-space: normal;
     max-width: 163.6px;
    background: #EDEFF3 !important;
  }

  .compareChart .comparison-table td {
    padding: 12px;
    border: 1px solid #e5e5e5;
    text-align: left;
    vertical-align: top;
    word-wrap: break-word;
    white-space: normal;
    max-width: 163.6px;
  }

  .compareChart .feature-label {
    text-align: left;
    color: #000;
    font-family: Lato;
    font-weight: 700;
    font-style: Bold;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    vertical-align: middle;
    position: sticky;
    left: 0;
    z-index: 2;
  }

  .compareChart .even-class .feature-label {
    background-color: #EDEFF3;
  }

  .compareChart .odd-class .feature-label {
    background-color: #fff;
  }

  .compareChart .feature-value {
    color: #000;
    font-family: Lato;
    font-weight: 400;
    font-style: Regular;
    font-size: 16px;
    line-height: 24px;
