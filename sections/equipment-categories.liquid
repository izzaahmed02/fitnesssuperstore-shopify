<section
  class="section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <style>
      /* Black table borders */
      #equipment-table,
      #equipment-table th,
      #equipment-table td {
        border: 1px solid #000;
      }
      #equipment-table {
        border-collapse: collapse;
        width: 100%;
      }
      #equipment-table th,
      #equipment-table td {
        padding: 10px;
        vertical-align: top;
      }
      #equipment-table th {
        font-weight: 700;
      }
      #equipment-table td strong {
        font-weight: 700;
      }
    </style>

    <div class="rte">
      <table id="equipment-table" role="table" aria-label="Equipment categories table">
        <thead>
          <tr>
            <th scope="col">Category</th>
            <th scope="col">Popular Models / Collections</th>
            <th scope="col">Best For</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td><strong>Functional Trainers &amp; Multi-Gyms</strong></td>
            <td>French Fitness FSR90, FSR100</td>
            <td>Home gyms, compact spaces, all-in-one training</td>
          </tr>

          <tr>
            <td><strong>Strength Equipment</strong></td>
            <td>French Fitness Plate-Loaded Line, Body-Solid Racks, Benches &amp; Smith Machines</td>
            <td>Powerlifting, commercial use, full-body strength</td>
          </tr>

          <tr>
            <td><strong>Treadmills</strong></td>
            <td>Life Fitness Integrity, Precor TRM Series</td>
            <td>Indoor cardio, walking, running, year-round conditioning</td>
          </tr>

          <tr>
            <td><strong>Exercise Bikes &amp; Air Bikes</strong></td>
            <td>Schwinn AC Series, French Fitness Air Bike</td>
            <td>Low-impact cardio, HIIT, multi-user environments</td>
          </tr>

          <tr>
            <td><strong>Free Weights &amp; Accessories</strong></td>
            <td>Rubber Hex Dumbbells, Urethane Barbells, Adjustable Benches</td>
            <td>Garage gyms, strength zones, PT rooms</td>
          </tr>

          <tr>
            <td><strong>Commercial Gym Packages</strong></td>
            <td>French Fitness Commercial Packages</td>
            <td>Training studios, facilities, schools, and corporate fitness</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Equipment Categories",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Equipment Categories"
    }
  ]
}
{% endschema %}
