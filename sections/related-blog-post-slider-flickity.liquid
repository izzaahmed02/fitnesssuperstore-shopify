{% comment %}
Blog Slider using Flickity
– Visible overflow (peek next slide)
– No page horizontal scroll
– Shopify-safe
{% endcomment %}

<link rel="stylesheet" href="https://npmcdn.com/flickity@2/dist/flickity.css">
<script src="https://npmcdn.com/flickity@2/dist/flickity.pkgd.js" defer></script>

{% assign blog = blogs[section.settings.blog] %}

<section class="related-articles section-{{ section.id }}">

  <div class="page-width">

    <!-- CLIP WRAPPER (critical to stop page scroll) -->
    <div class="carousel-clip">

      <!-- Flickity -->
      <div
        class="carousel js-flickity"
        data-flickity='{
          "cellAlign": "left",
          "contain": true,
          "pageDots": false,
          "prevNextButtons": true
        }'
      >

        {% for article in blog.articles %}
          <div class="carousel-cell">
            <article class="card-wrapper">
              <a href="{{ article.url }}" class="card">

                {% if article.image %}
                  <div class="card__media">
                    <img
                      src="{{ article.image | img_url: '720x' }}"
                      alt="{{ article.image.alt | default: article.title }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div class="card__content">
                  <h3 class="card__heading">
                    {{ article.title }}
                  </h3>

                  {% if article.published_at or article.author %}
                    <p class="card__meta">
                      {% if article.published_at %}
                        <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                      {% endif %}
                      {% if article.author %}
                        <span> · {{ article.author }}</span>
                      {% endif %}
                    </p>
                  {% endif %}

                  {% if section.settings.show_excerpt %}
                    <div class="card__excerpt">
                      {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                    </div>
                  {% endif %}

                  <span class="link">
                    {{ section.settings.read_more_text }}
                  </span>
                </div>

              </a>
            </article>
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
/* === HARD STOP PAGE SCROLL === */
.related-articles,
.related-articles .page-width,
.carousel-clip {
  overflow-x: hidden;
}

/* === ALLOW PEEKING SLIDES === */
.carousel-clip .flickity-viewport {
  overflow: visible;
}

/* === CAROUSEL === */
.carousel {
  width: 100%;
}

/* === SLIDES === */
.carousel-cell {
  width: 25%;
  margin-right: 16px;
}

@media (max-width: 1024px) {
  .carousel-cell {
    width: 40%;
  }
}

@media (max-width: 768px) {
  .carousel-cell {
    width: 85%;
  }
}

/* === CARD IMAGE FIX === */
.card__media img {
  width: 100%;
  height: auto;
  display: block;
}
</style>

{% schema %}
{
  "name": "Blog Slider Flickity",
  "class": "related-articles",
  "settings": [
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    }
  ],
  "presets": [
    {
      "name": "Blog Slider Flickity",
      "category": "Blog"
    }
  ]
}
{% endschema %}
