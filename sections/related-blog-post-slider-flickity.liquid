


<link rel="stylesheet" href="https://npmcdn.com/flickity@2/dist/flickity.css">
<script src="https://npmcdn.com/flickity@2/dist/flickity.pkgd.js" defer> </script>










{% schema %}
{
  "name": "Blog Slider flickity",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Blog Slider flickity",
      "category": "Blog"
    }
  ]
}
{% endschema %}
