


<link rel="stylesheet" href="https://npmcdn.com/flickity@2/dist/flickity.css">
<script src="https://npmcdn.com/flickity@2/dist/flickity.pkgd.js" defer> </script>
{% assign blog = blogs[section.settings.blog] %}

<div class="page-width">
<!-- Flickity HTML init -->
<div class="carousel"
  data-flickity='{ "cellAlign": "left" }'>
  {% for article in blog.articles %}
  <div class="carousel-cell">
<article class="card-wrapper">
                <a href="{{ article.url }}" class="card">

                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">

                    <h3 class="card__heading">
                      {{ article.title }}
                    </h3>

                    {% if article.published_at or article.author %}
                      <p class="card__meta publish-info">
                        {% if article.published_at %}
                          <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                        {% endif %}
                        {% if article.author %}
                          <span>{{ article.author }}</span>
                        {% endif %}
                      </p>
                    {% endif %}

                    {% if section.settings.show_excerpt %}
                      <div class="card__excerpt">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>

                  </div>
                </a>
              </article>
  </div>
  {% endfor %}
</div>
</div>


<style>
.carousel {
  background: #FAFAFA;
}

.flickity-viewport {
overflow: visible;
}

.carousel-cell {
  width: 25%;
  height: 200px;
  margin-right: 10px;
  border-radius: 5px;
  counter-increment: carousel-cell;
}
</style>





{% schema %}
{
  "name": "Blog Slider flickity",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Blog Slider flickity",
      "category": "Blog"
    }
  ]
}
{% endschema %}
