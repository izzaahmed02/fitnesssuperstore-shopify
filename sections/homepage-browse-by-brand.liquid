{{ 'homepage-browse-by-brand.css' | asset_url | stylesheet_tag }}

<div class="browse-by-brand">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="category-tabs">
             <a href="{{ section.settings.url }}"
               class="homepage-brands__button button button--secondary">
                {{ section.settings.label }}
                {% render 'chevron-button' %}
            </a>
  </div>
</div>
  
 
    <div class="category-tab-content">     
        {% for block in section.blocks %}  
         {% assign collection_handle = block.settings.link | split: '/' | last %}
  {% assign linked_collection = collections[collection_handle] %}

  <a aria-label="View {{ linked_collection.title | default: collection_handle }} collection" href="{{ block.settings.link }}">
 
      <div class="main-card">
            <div class="category-card">
              
                {% if block.settings.image != blank %}
                  <img class="brand-image ss" src="{{ block.settings.image | img_url: "master" }}" alt="{{ image.alt }}" decoding="async">
                {% endif %}
              
            </div>

            
                {% if block.settings.logo != blank %}
                 <img class="brand-logo" src="{{ block.settings.logo | image_url }}" alt="{{ image.alt }}" decoding="async">
                {% endif %}
             
          </div>
        </a>
        {% endfor %}
      </div>
</div>

<script src="{{ 'homepage-browse-by-brand.js' | asset_url }}" defer="defer"></script>


{% schema %}
{
  "name": "Homepage Browse by Brand",
  "class": "homepage-browse-brand",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Browse by Brand"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
     {
      "type": "url",
      "id": "url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
       
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Browse by Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}