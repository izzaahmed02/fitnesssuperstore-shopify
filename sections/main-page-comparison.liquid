{{ 'comparison-main.css' | asset_url | stylesheet_tag }}
{{ 'comparison-item.css' | asset_url | stylesheet_tag }}

<div class="page-width">
<div class="main-comparison__wrapper">
    {% for block in section.blocks %}
        {% render 'comparison-item', block: block %}
    {% endfor %}
</div>
</div>

{% schema %}
{
  "name": "Comparison Charts Main",
  "tag": "section",
  "class": "section main-comparison",
  "settings": [
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Comparison Chart",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Block Count"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Block Copy"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Block URL"
        }
      ]
    }
  ]
}
{% endschema %}
