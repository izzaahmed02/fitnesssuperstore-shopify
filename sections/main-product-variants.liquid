<script>
(function(){

/* ===============================
  Helpers (UNCHANGED)
================================ */

function getMediaManifest(r){
  const e=(r||document).querySelector('script[data-product-media]');
  if(!e) return [];
  try{ return JSON.parse(e.textContent||"[]"); }
  catch{ return []; }
}

function safePath(u){
  try{ return new URL(u,location.origin).pathname; }
  catch{ return String(u||""); }
}

/* ===============================
  Media maps (UNCHANGED)
================================ */

const galleryRoot =
  document.querySelector('product-gallery') || document;

const mediaList = getMediaManifest(galleryRoot);

const mediaById = new Map(
  mediaList.map(m=>[String(m.id),m])
);

const mediaBySrcImg = new Map(
  mediaList
    .filter(m=>m.media_type==="image" && m.preview_image?.src)
    .map(m=>[safePath(m.preview_image.src),m])
);

const variantImageMediaId = new Map();

if(window.product && Array.isArray(window.product.variants)){
  for(const v of window.product.variants){
    let imgId=null;

    if(v.featured_image?.src){
      const match=mediaBySrcImg.get(
        safePath(v.featured_image.src)
      );
      if(match) imgId=String(match.id);
    }

    if(!imgId){
      const firstImg=mediaList.find(
        m=>m.media_type==="image"
      );
      if(firstImg) imgId=String(firstImg.id);
    }

    if(imgId){
      variantImageMediaId.set(String(v.id),imgId);
    }
  }
}

/* ===============================
  Popup suppression (UNCHANGED)
================================ */

let suppressPopupUntil=0;
function suppressPopupFor(ms){
  suppressPopupUntil=Date.now()+(ms||400);
}

document.addEventListener("click",function(e){
  if(Date.now()<suppressPopupUntil){
    const btn=e.target?.closest?.("[data-popup-open]");
    if(btn){
      e.preventDefault();
      e.stopImmediatePropagation();
      return false;
    }
  }
},true);

/* ===============================
  Desktop renderer (UNCHANGED)
================================ */

function renderMainFromManifest(media){
  if(!media) return;

  const c=
    galleryRoot.querySelector(".custom-gallery-main") ||
    galleryRoot.querySelector("[data-main-media-wrapper]");

  if(!c) return;

  c.innerHTML="";

  const wrap=document.createElement("div");
  wrap.className="main-image-container";
  wrap.dataset.mediaId=media.id;

  if(media.media_type==="image"){
    const img=document.createElement("img");
    img.src=media.preview_image?.src||"";
    img.alt=media.alt||"";
    img.loading="eager";
    img.width=media.preview_image?.width||"";
    img.height=media.preview_image?.height||"";
    wrap.appendChild(img);
  }

  c.appendChild(wrap);
}

/* =====================================================
  ✅ MOBILE FIX — SCROLL SNAP SAFE
===================================================== */

function activateMobileById(id){
  const slide=document.querySelector(
    '.mobile-gallery-slide[data-media-id="'+id+'"]'
  );
  if(!slide) return;

  const wrap=slide.closest(".mobile-gallery-slide-wrap");
  if(!wrap) return;

  /* Native snap-safe scrolling */
  wrap.scrollIntoView({
    behavior: "auto",
    inline: "start",
    block: "nearest"
  });

  const slider=document.querySelector(".mobile-gallery-slider");
  if(slider){
    slider
      .querySelectorAll(".mobile-gallery-slide-wrap")
      .forEach(el =>
        el.classList.remove("is-active","active","current")
      );
  }

  wrap.classList.add("is-active");

  const dots=document.querySelector(".mobile-gallery-dots");
  if(dots && slider){
    const wraps=[
      ...slider.querySelectorAll(".mobile-gallery-slide-wrap")
    ];
    const idx=wraps.indexOf(wrap);

    [...dots.children].forEach(d =>
      d.classList.remove("is-active","active","current")
    );

    if(dots.children[idx]){
      dots.children[idx].classList.add("is-active");
    }
  }
}

/* ===============================
  Variant logic (UNCHANGED)
================================ */

function resolveMediaIdFromVariant(variant){
  if(!variant) return null;

  const hit=variantImageMediaId.get(String(variant.id));
  if(hit) return hit;

  if(variant.featured_image?.src){
    const match=mediaBySrcImg.get(
      safePath(variant.featured_image.src)
    );
    if(match) return String(match.id);
  }

  const first=mediaList.find(m=>m.media_type==="image");
  return first ? String(first.id) : null;
}

function activateMediaById(id){
  const media=mediaById.get(String(id));
  if(!media) return;

  /* DESKTOP */
  renderMainFromManifest(media);

  /* MOBILE */
  activateMobileById(id);
}

/* ===============================
  Variant listeners (UNCHANGED)
================================ */

function onVariantChange(e){
  suppressPopupFor(600);

  const variant =
    e?.detail?.variant ||
    e?.detail ||
    null;

  const mediaId=resolveMediaIdFromVariant(variant);
  if(mediaId) activateMediaById(mediaId);
}

document.addEventListener("variant:change",onVariantChange);
document.addEventListener("variant-change",onVariantChange);

/* ===============================
  Form fallback (UNCHANGED)
================================ */

const productForm=document.querySelector(
  'form[action*="/cart/add"]'
);

if(productForm && !productForm.__variantSyncBound){
  productForm.__variantSyncBound=true;

  productForm.addEventListener("change",function(){
    setTimeout(()=>{
      suppressPopupFor(600);

      const idEl=productForm.querySelector(".product-variant-id");
      if(!idEl) return;

      const variant=window.product?.variants?.find(
        v=>String(v.id)===String(idEl.value)
      );

      const mediaId=resolveMediaIdFromVariant(variant);
      if(mediaId) activateMediaById(mediaId);

    },50);
  });
}

})();
</script>
