{% style %}
  #shopify-section-{{ section.id }} .product-main-container{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
  }
  #shopify-section-{{ section.id }} .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .product-main-right{
    padding-top: 20px;
    padding-left: 80px;
    background: #FAF9F9;
  }

  #shopify-section-{{ section.id }} .product-main-right .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .mpe {
    margin-top: -20px;
    margin-bottom: 40px;
  }


{% endstyle %}

{% render 'metaobjects-breadcrumbs', with product: product %}

<script type="application/json" data-product-json>{{ product | json }}</script>

<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} prodTemplate"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if template.suffix == 'variants' %}
    data-pdp-template="variants"
  {% endif %}
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {% if template.suffix == 'variants' %}
    {%- comment -%}
      Slim variant map used by variant-fallback-intercept.js to detect an
      impossible combination (no variant matches the selected option values)
      vs a variant that simply exists but is sold out. Only the fields needed
      for that lookup are emitted, to keep the inline payload small.
    {%- endcomment -%}
    <script type="application/json" data-product-variants-map>
      [{%- for variant in product.variants -%}
        {"o1":{{ variant.option1 | json }},"o2":{{ variant.option2 | json }},"o3":{{ variant.option3 | json }},"a":{{ variant.available }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}]
    </script>
  {% endif %}
  <span id="Availability-Meta-{{ section.id }}">
    {%- if product.selected_or_first_available_variant.available -%}
      <meta itemprop="availability" content="InStock">
    {%- else -%}
      <meta itemprop="availability" content="OutOfStock">
    {%- endif -%}
  </span>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-accordion.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-accordion.css' | asset_url | stylesheet_tag }}</noscript>
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
  <link rel="stylesheet" href="{{ 'component-rating.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-rating.css' | asset_url | stylesheet_tag }}</noscript>
  <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}</noscript>

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

 
  {{ 'custom-main-product-page.css' | asset_url | stylesheet_tag }}
  {{ 'custom-product-gallery.css' | asset_url | stylesheet_tag }}
  {{ 'custom-option-picker-snippet.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'paylater-modal.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'paylater-modal.css' | asset_url | stylesheet_tag }}</noscript>

   {% assign hide_product_options = false %}
  {% for item in cart.items %}
    {% for property in item.properties %}
      {% if property.first == '_functionOperation' %}
        {% assign hide_product_options = true %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% unless hide_product_options %}
    {{ 'product-options.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 990px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    {% if template.suffix == 'variants' %}
      .product-form__input--pill input[type=radio] + label,
      .product-form__input--swatch .swatch,
      .product-form__input--swatch .swatch-input__label {
        transition: border var(--duration-short) ease, background-color var(--duration-short) ease, color var(--duration-short) ease, box-shadow var(--duration-short) ease, transform var(--duration-short) ease;
      }

      @keyframes pdp-variant-fallback-pulse {
        0%   { box-shadow: 0 0 0 0 rgba(227, 82, 5, 0.55); transform: scale(1); }
        35%  { transform: scale(1.04); }
        100% { box-shadow: 0 0 0 14px rgba(227, 82, 5, 0); transform: scale(1); }
      }

      .product-form__input--pill input[type=radio].pdp-variant-fallback-pulse + label,
      .product-form__input--pill input[type=radio] + label.pdp-variant-fallback-pulse,
      .product-form__input--swatch label.pdp-variant-fallback-pulse,
      .product-form__input--swatch .swatch-input__label.pdp-variant-fallback-pulse,
      .swatch.pdp-variant-fallback-pulse {
        animation: pdp-variant-fallback-pulse 1.4s ease-out;
        will-change: transform, box-shadow;
      }

      .pdp-variant-fallback-toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        transform: translate(-50%, 16px);
        background: #1f1f1f;
        color: #fff;
        padding: 12px 18px;
        border-radius: 999px;
        font-size: 1.3rem;
        line-height: 1.4;
        letter-spacing: .02em;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
        opacity: 0;
        pointer-events: none;
        transition: opacity .28s ease, transform .28s ease;
        z-index: 9999;
        max-width: calc(100vw - 32px);
        text-align: center;
      }
      .pdp-variant-fallback-toast.is-visible {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      @media (prefers-reduced-motion: reduce) {
        .product-form__input--pill input[type=radio].pdp-variant-fallback-pulse + label,
        .product-form__input--pill input[type=radio] + label.pdp-variant-fallback-pulse,
        .product-form__input--swatch label.pdp-variant-fallback-pulse,
        .product-form__input--swatch .swatch-input__label.pdp-variant-fallback-pulse,
        .swatch.pdp-variant-fallback-pulse {
          animation: none;
          outline: 2px solid rgba(227, 82, 5, 0.9);
          outline-offset: 2px;
        }
      }
    {% endif %}
  {%- endstyle -%}

  {%- assign enable_product_form_js = true -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'tile_calculator' -%}
        {% if block.settings.disable_product_form_js %}
          {%- assign enable_product_form_js = false -%}
        {% endif %}
    {%- endcase -%}
  {%- endfor -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  {% if template.suffix == 'variants' %}
    <script src="{{ 'variant-fallback-intercept.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {% if enable_product_form_js %}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  <script src="{{ 'product-sticky.js' | asset_url }}" defer="defer"></script>

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  {% assign is_gift_cards_template = false %}
  {% if template.suffix == 'gift_cards' %}
    {% assign is_gift_cards_template = true %}
  {% endif %}


  {% comment %} pdp-page-width main-container {% endcomment %}
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      {% comment %} Single semantic product-title heading: visually hidden but present and
         accessible at every breakpoint. The visible titles below (mobile + desktop) are
         non-heading .product__title-text divs styled identically, so the DOM has exactly one
         H1 for the product title. (Heading Optimization - SEO Audit.) {% endcomment %}
      <h1 class="visually-hidden">{{ product.title | escape }}</h1>
      <div class="product__info-wrapper--mobile">
        <div class="product__info-container--mobile">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                   {% if is_gift_cards_template %}
                    <div class="product__title-text">{{ product.title | escape }}</div>
                  {% else %}
                    <div class="product__title-text">{{ product.title | escape }}</div>
                    <a href="{{ product.url }}" class="product__title">
                      {% comment %} Non-heading duplicate of the title (single-H1 SEO). div.h1
                         renders identically to the former h2.h1: the grouped heading rule and
                         .h1 class pin font/size/weight/color, and the universal margin reset
                         zeroes margins for this only-child. {% endcomment %}
                      <div class="h1">
                        {{ product.title | escape }}
                      </div>
                    </a>
                  {% endif %}
                </div>
              {%- when 'review_widget' -%}
                {%- assign hide_avail_mobile = false -%}
                {%- if product.tags contains 'avisplus-product-options' or is_gift_cards_template -%}
                  {%- assign hide_avail_mobile = true -%}
                {%- endif -%}
                {%- assign stock_badge_mobile_id = 'Stock-Badge-Mobile-' | append: section.id -%}
                {% render 'product-availability-badge',
                  product: product,
                  available: product.selected_or_first_available_variant.available,
                  wrapper_id: stock_badge_mobile_id,
                  hide_badge: hide_avail_mobile
                %}
              {% when 'price' %}
                {% unless is_gift_cards_template %}
                  <p class="affirm-as-low-as" data-page-type="product" data-amount="{{ product.price }}"></p>
                {% endunless %}

                {% assign campaign_text = '' %}

                {% if product.title contains 'French Fitness' %}
                  {% assign campaign_text = settings.sale_promo_ff %}
                {% elsif product.title contains 'Remanufactured' %}
                  {% assign campaign_text = settings.sale_promo_reman %}
                {% else %}
                  {% assign campaign_text = settings.sale_promo_default %}
                {% endif %}

                {% unless campaign_text == blank %}
                  <div class="campaign-sale-container hide-on-mobile">
                    <p>{{ campaign_text | escape }}</p>
                  </div>
                {% endunless %}

                <div class="product__prices here">
                  {%comment %}
                  {% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price %}
                   {%endcomment %}
                    {% unless is_gift_cards_template %}
                      <span class="pr_custom_compare_price{% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} pm-empty{% endunless %}"
                        >As high as:
                        <s>{{ product.metafields.custom.retail_price | money_with_currency -}}</s>
                      </span>
                    {% endunless %}
                    {% comment %}
                  {% endif %}
                   {%endcomment %}



                  {% if product.metafields.custom.saleprice_name != blank %}
                    {% render 'super-sale',
                      sale_name: product.metafields.custom.saleprice_name,
                      current_price: product.selected_or_first_available_variant.compare_at_price,
                      sale_price: product.metafields.custom.sale_price
                    %}
                  {% else %}
                    <div class="price-container test2">
                      {%- render 'price',
                        product: product,
                        use_variant: true,
                        show_badges: true,
                        price_class: 'price--large'
                      -%}

                      {% comment %}{% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price %} {% endcomment %}

                       <div>


                      <span class="you-save pm-empty"></span>

                    </div>

                      {% endif %}
                    </div>
                </div>


            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="product-main-left-container">


        <product-gallery data-product-title="{{ product.title | escape }}">
          <div class="custom-product-gallery">
            <div class="custom-gallery-wrapper">
              <!-- Thumbnails -->
              {%- assign image_media = product.media | where: 'media_type', 'image' -%}

              <div class="custom-gallery-thumbnails only-desktop">
                {% assign model = product.media | where: 'media_type', 'model' | first %}
                {%- if model -%}
                  {% assign preview = model.preview_image %}

                  <button
                    class="thumbnail-btn is-active"
                    data-media-id="{{ model.id }}"
                    type="button"
                  >
                    <div class="image-skeleton-wrapper">
                      <img
                        src="{{ preview | image_url: width: 100 }}"
                        alt="{{ model.alt | escape }}"
                        width="{{ preview.width }}"
                        height="{{ preview.height }}"
                        loading="lazy"
                        onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                      >
                    </div>
                  </button>

                {%- endif -%}
                {%- assign image_limit = 4 -%}
                {%- for media in image_media limit: image_limit -%}
                  {% assign preview = media.preview_image %}
                  {% assign is_last = forloop.last %}
                  {% assign remaining = image_media.size | minus: image_limit %}

                  <button
                    class="thumbnail-btn{% if model %}{% else %}{% if forloop.first %} is-active{% endif %}{% endif %}"
                    data-media-id="{{ media.id }}"
                    type="button"
                  >
                    <div class="image-skeleton-wrapper">
                      <img
                        src="{{ preview | image_url: width: 100 }}"
                        alt="{{ media.alt | escape }}"
                        width="{{ preview.width }}"
                        height="{{ preview.height }}"
                        loading="lazy"
                        onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                      >
                    </div>

                    {%- if is_last and image_media.size > image_limit -%}
                      <div class="thumbnail-overlay">+{{ remaining }}</div>
                    {%- endif -%}
                  </button>
                {%- endfor -%}

                {% assign video_count = 0 %}
                {% for media in product.media %}
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                    {% assign video_count = video_count | plus: 1 %}

                    {% if video_count == 1 %}
                      <button
                        class="thumbnail-btn is-video"
                        data-media-id="{{ media.id }}"
                        data-popup-open="video"
                        type="button"
                      >
                        <div class="thumbnail-btn__warp">
                          <img
                            src="{{ media.preview_image | image_url: width: 100 }}"
                            alt="{{ media.alt | escape }}"
                            width="{{ media.preview_image.width }}"
                            height="{{ media.preview_image.height }}"
                            loading="lazy"
                          >
                        </div>

                        {%- assign shopify_video_count = product.media | where: 'media_type', 'video' | size -%}
                        {%- assign external_video_count = product.media
                          | where: 'media_type', 'external_video'
                          | size
                        -%}
                        {%- assign video_count = shopify_video_count | plus: external_video_count -%}

                        {% if video_count > 1 %}
                          <span class="thumbnail-video-count">{{ video_count }} videos</span>
                        {% endif %}
                      </button>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>

              <!-- Main image -->
              <div class="custom-gallery-main" data-main-media-wrapper>
                {% if model %}
                  <div
                    class="main-image-container"
                    data-media-id="{{ model.id }}"
                  >
                    <model-viewer alt="{{ model.alt | json }}" src="{% for source in model.sources %}{% if source.format == 'glb' %}{{ source.url }}{% endif %}{% endfor %}" camera-controls="true" camera-orbit="0deg 75deg 4m" data-shopify-feature="1.12" data-js-focus-visible="" ar-status="not-presenting"></model-viewer>
                  </div>
                {% else %}
                  {% assign first_media = product.media.first %}
                  {% assign preview = first_media.preview_image %}

                  <div
                    class="main-image-container"
                    data-media-id="{{ first_media.id }}"
                    data-zoom-container
                  >
                    {% if first_media.media_type == 'image' %}
                      <div class="image-skeleton-wrapper">
                        <img
                          src="{{ preview | image_url: width: 800 }}"
                          alt="{{ first_media.alt | escape }}"
                          class="main-product-image"
                          width="{{ preview.width }}"
                          height="{{ preview.height }}"
                          loading="eager"
                          onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                        >
                      </div>
                    {% elsif first_media.media_type == 'video' %}
                      {{ first_media | media_tag }}
                    {% else %}
                      <div class="media-placeholder">Preview available in popup only.</div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          <script type="application/json" data-product-media>
            [
              {% assign model = product.media | where: 'media_type', 'model' | first %}
              {% if model %}
                {
                  "id": {{ model.id | json }},
                  "media_type": {{ model.media_type | json }},
                  "alt": {{ model.alt | json }},
                  "preview_image": {
                    "src": {{ model.preview_image | image_url: width: 800 | json }},
                    "srcset": "{{ model.preview_image | image_url: width: 800 }} 800w, {{ model.preview_image | image_url: width: 1200 }} 1200w, {{ model.preview_image | image_url: width: 1600 }} 1600w, {{ model.preview_image | image_url: width: 2048 }} 2048w",
                    "sizes": "(min-width: 990px) 800px, 100vw",
                    "width": {{ model.preview_image.width | json }},
                    "height": {{ model.preview_image.height | json }}
                  },
                  "url": {% for source in model.sources %}{% if source.format == 'glb' %}"{{ source.url }}"{% endif %}{% endfor %}
                },
              {% endif %}
              {% for media in product.media %}
                {
                  "id": {{ media.id | json }},
                  "media_type": {{ media.media_type | json }},
                  "alt": {{ media.alt | json }},
                  "preview_image": {
                    "src": {{ media.preview_image | image_url: width: 800 | json }},
                    "srcset": "{{ media.preview_image | image_url: width: 800 }} 800w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1600 }} 1600w, {{ media.preview_image | image_url: width: 2048 }} 2048w",
                    "sizes": "(min-width: 990px) 800px, 100vw",
                    "width": {{ media.preview_image.width | json }},
                    "height": {{ media.preview_image.height | json }}
                  }
                  {% if media.media_type == 'video' %}
                    , "sources": [
                      {% for source in media.sources %}
                        {
                          "url": {{ source.url | json }},
                          "mime_type": {{ source.mime_type | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  {% elsif media.media_type == 'external_video' %}
                    , "host": {{ media.host | json }},
                      "external_id": {{ media.external_id | json }}
                  {% endif %}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>
        </product-gallery>

        {%- liquid
          assign mobile_gallery_featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media | default: product.media.first
          assign mobile_gallery_aspect_ratio = mobile_gallery_featured_media.preview_image.aspect_ratio | default: mobile_gallery_featured_media.aspect_ratio | default: 1
        -%}
        <mobile-gallery style="--mobile-gallery-aspect-ratio: {{ mobile_gallery_aspect_ratio }};">
          <div class="mobile-gallery-wrapper only-mobile">
            <div class="main-slider-arrow--left" type="button">
              <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 0.46967C7.48924 0.762563 7.48924 1.23744 7.19635 1.53033L2.72668 6L7.19635 10.4697C7.48924 10.7626 7.48924 11.2374 7.19635 11.5303C6.90345 11.8232 6.42858 11.8232 6.13569 11.5303L1.13569 6.53033C0.995033 6.38968 0.916016 6.19891 0.916016 6C0.916016 5.80109 0.995033 5.61032 1.13569 5.46967L6.13569 0.46967C6.42858 0.176777 6.90345 0.176777 7.19635 0.46967Z" fill="white"/>
              </svg>
            </div>

            <div class="mobile-gallery-slider image-skeleton-wrapper">
              {% for media in product.media %}
                {% case media.media_type %}
                  {% when 'image' %}
                
                       <div class="mobile-gallery-slide-wrap">
                    <div class="image-skeleton-wrapper">
                      <div class="mobile-gallery-slide" data-media-id="{{ media.id }}">
                        {% assign is_first = forloop.first %}

                        <img
                          src="{{ media.preview_image | image_url: width: 480 }}"
                          srcset="
                            {{ media.preview_image | image_url: width: 320 }} 320w,
                            {{ media.preview_image | image_url: width: 480 }} 480w,
                            {{ media.preview_image | image_url: width: 800 }} 800w
                          "
                          sizes="(max-width: 768px) 100vw, 800px"
                          alt="{{ media.alt | escape }}"
                           {% if is_first %}
                            fetchpriority="high"
                          {% else %}
                            loading="lazy"
                          {% endif %}
                          width="{{ media.preview_image.width }}"
                          height="{{ media.preview_image.height }}"
                          onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                        >
                      </div>
                    </div>
                  </div>


                  {% when 'video' %}
                    <div class="mobile-gallery-slide-wrap">
                      <div class="mobile-gallery-slide" data-media-id="{{ media.id }}">
                        <video
                          src="{{ media.sources[1].url }}"
                          controls
                          muted
                          playsinline
                          preload="metadata"
                          poster="{{ media.preview_image | image_url: width: 800 }}"
                        ></video>
                      </div>
                    </div>

                  {% when 'external_video' %}
                    <div class="mobile-gallery-slide-wrap">
                      <div class="mobile-gallery-slide external-video" data-media-id="{{ media.id }}">
                        <div class="video-wrapper">
                          <div class="video-iframe-overlay" aria-hidden="true"></div>
