<script>
document.addEventListener('DOMContentLoaded', function() {
  const skuElement = document.querySelector('[id^="Sku-"]');
  const processingTimeElement = document.querySelector('[id^="ProcessingTime-"]');
  
  if (!skuElement || !processingTimeElement) {
    console.log('SKU or Processing Time element not found');
    return;
  }
  
  // Helper function to extract just the SKU text (excluding the visually-hidden label)
  function getSkuText(element) {
    // Clone the element to avoid modifying the DOM
    const clone = element.cloneNode(true);
    // Remove the visually-hidden span
    const hiddenSpan = clone.querySelector('.visually-hidden');
    if (hiddenSpan) {
      hiddenSpan.remove();
    }
    return clone.textContent.trim();
  }
  
  // Create variant metafields lookup indexed by SKU
  const variantMetafields = {
    {% for variant in product.variants %}
      "{{ variant.sku }}": {
        "processing_time": {{ variant.metafields.custom.processing_time_long_variant | json }},
        "sku": "{{ variant.sku }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
  
  const productProcessingTime = {{ product.metafields.custom.processing_time_long | json }};
  
  function updateProcessingTime() {
    const newSku = getSkuText(skuElement);
    
    console.log('SKU detected:', newSku);
    
    if (!newSku) return;
    
    const variantData = variantMetafields[newSku];
    const newProcessingTime = variantData?.processing_time || productProcessingTime;
    
    console.log('Variant data:', variantData);
    console.log('New processing time:', newProcessingTime);
    
    if (newProcessingTime) {
      const currentText = processingTimeElement.textContent.trim();
      
      if (newProcessingTime !== currentText) {
        processingTimeElement.textContent = newProcessingTime;
        processingTimeElement.setAttribute('data-sku', newSku);
        
        // Update more info attribute
        const moreInfo = processingTimeElement.nextElementSibling;
        if (moreInfo && moreInfo.classList.contains('more-info')) {
          if (variantData?.processing_time) {
            moreInfo.setAttribute('data-processingtime', variantData.processing_time);
          } else {
            moreInfo.setAttribute('data-processingtime', productProcessingTime || '');
          }
        }
        
        console.log('✅ Processing time updated to:', newProcessingTime);
      } else {
        console.log('Processing time already correct');
      }
    }
  }
  
  // Watch for SKU changes using MutationObserver
  const observer = new MutationObserver(function(mutations) {
    console.log('SKU element changed, updating processing time...');
    updateProcessingTime();
  });
  
  observer.observe(skuElement, {
    childList: true,
    characterData: true,
    subtree: true
  });
  
  // Also update on initial load
  updateProcessingTime();
  
  console.log('✅ Processing time updater initialized');
  console.log('Available variants:', variantMetafields);
});
</script>

