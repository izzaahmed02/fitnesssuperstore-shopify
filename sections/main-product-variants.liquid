                            (Minimum order $200 to qualify)
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endunless %}
                {% endfor %}

                <div class="metainfo-wrapper">
                  {% if product.metafields.custom.condition_state != blank %}
                    <div class="item">
                      <div class="item__icon-wrap">{% render 'icon-star' %}</div>
                      <div class="item__text">
                        <span class="title">Condition:</span>
                        {{
                          product.metafields.custom.condition_state
                          | strip_html
                          | replace: ' (See Description for Details)', ''
                          | replace: '(What Does this Mean?)', ''
                        }}
                      </div>
                    </div>
                  {% endif %}
                  {% if product.metafields.custom.grade != blank %}
                    <div class="item">
                      <div class="item__icon-wrap">{% render 'icon-chart' %}</div>
                      <div class="item__text">
                        <span class="title">Grade:</span>
                        {{ product.metafields.custom.grade }}
                        <span class="more-info" data-customfield="Grade">(More Info)</span>
                      </div>
                    </div>
                  {% endif %}
                  {% if product.metafields.custom.warranty != blank %}
                    <div class="item">
                      <div class="item__icon-wrap">{% render 'icon-verified' %}</div>
                      <div class="item__text">
                        <span class="title">Warranty:</span>
                        {{
                          product.metafields.custom.warranty
                          | strip_html
                          | replace: ' (See Description for Details)', ''
                        }}
                        <span class="more-info" data-customfield="Warranty">(More Info)</span>
                      </div>
                    </div>
                  {% endif %}
                  {% if product.metafields.custom.ships != blank %}
                    <div class="item">
                      <div class="item__icon-wrap">{% render 'icon-box' %}</div>
                      <div class="item__text">
                        <span class="title">Ships:</span>
                        {{ product.metafields.custom.ships }}
                        {% render 'shipping-packaging-video-link', product: product %}
                      </div>
                    </div>
                  {% endif %}
                {% assign current_variant = product.selected_or_first_available_variant %}
{% if current_variant.metafields.custom.processing_time_long_variant != blank or product.metafields.custom.processing_time_long != blank %}
  <div class="item">
    <div class="item__icon-wrap">{% render 'icon-timer' %}</div>
    <div class="item__text">
      <span class="title">Processing Time:</span>
      <span id="ProcessingTime-{{ section.id }}" data-sku="{{ current_variant.sku }}">
        {{ current_variant.metafields.custom.processing_time_long_variant | default: product.metafields.custom.processing_time_long }}
      </span>
      <span class="more-info" data-customfield="Processing Time" data-processingtime="{{ current_variant.metafields.custom.processing_time_long_variant }}">(More Info)</span>
    </div>
  </div>
{% endif %}

                  {% if product.metafields.custom.product_code != blank %}
                    <div class="item">
                      <div class="item__icon-wrap">{% render 'icon-hashtag' %}</div>
                      <div class="item__text">
                        <span class="title">Product Code:</span>
                        {%comment %}{{ product.metafields.custom.product_code }}{%endcomment%}
                        <span
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </span>
                      </div>
                    </div>
                  {% endif %}
                </div>

                {% assign metaObject3rdParty = product.metafields.custom['3rd_party'].value %}
