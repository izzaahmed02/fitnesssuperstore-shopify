{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 3, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Four shopping-path cards directly after the hero. Self-contained per spec R3.
  No shared stylesheet import, no device-targeting CSS (spec R2), no analytics
  helper (spec §8) — the data-fss-hp-* attributes are inert during S1.

  Gym Packages: the card links to /pages/gym-packages only. Per Tim (Jul 27 and
  Jul 29 item 5) there is no direct Room Planner CTA here, and the body copy
  must not imply the planner delivers a finished custom design, quote, safety
  validation, or fulfillment workflow. The Gym Layout / Room Planner thread
  remains the canonical remediation record.
{% endcomment %}

<section class="fssd-shopping-paths" aria-labelledby="fssd-shopping-paths-heading-{{ section.id }}">
  <div class="fssd-shopping-paths__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fssd-shopping-paths__heading" id="fssd-shopping-paths-heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="fssd-shopping-paths__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <ul class="fssd-shopping-paths__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'path_card' -%}
          <li class="fssd-shopping-paths__item" {{ block.shopify_attributes }}>
            <a
              class="fssd-shopping-paths__card"
              href="{{ block.settings.link }}"
              data-fss-hp-event="fss_hp_path_click"
              data-fss-hp-props='{"path": {{ block.settings.path | json | escape }}}'
            >
              {%- if block.settings.image != blank -%}
                <span class="fssd-shopping-paths__media">
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 300 }} 300w,
                      {{ block.settings.image | image_url: width: 600 }} 600w
                    "
                    sizes="(min-width: 990px) 25vw, 50vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                </span>
              {%- endif -%}

              <span class="fssd-shopping-paths__body">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="fssd-shopping-paths__eyebrow">{{ block.settings.eyebrow }}</span>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <span class="fssd-shopping-paths__title">{{ block.settings.title }}</span>
                {%- endif -%}

                {%- if block.settings.body != blank -%}
                  <span class="fssd-shopping-paths__text">{{ block.settings.body }}</span>
                {%- endif -%}

                {%- if block.settings.cta_label != blank -%}
                  <span class="fssd-shopping-paths__cta">{{ block.settings.cta_label }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .fssd-shopping-paths {
    --fssd-paths-accent: #d83d0e;
    --fssd-paths-border: #e5e5e5;
    --fssd-paths-muted: #616166;
    padding: 40px 0;
  }
  .fssd-shopping-paths__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .fssd-shopping-paths__heading {
    margin: 0 0 8px;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.2;
  }
  .fssd-shopping-paths__subheading {
    max-width: 72ch;
    margin: 0 0 24px;
    color: var(--fssd-paths-muted);
    font-size: 15px;
    line-height: 22px;
  }
  .fssd-shopping-paths__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fssd-shopping-paths__item {
    display: flex;
  }
  .fssd-shopping-paths__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--fssd-paths-border);
    border-radius: 12px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: #ffffff;
  }
  .fssd-shopping-paths__card:hover {
    border-color: var(--fssd-paths-accent);
  }
  .fssd-shopping-paths__card:focus-visible {
    outline: 3px solid var(--fssd-paths-accent);
    outline-offset: 2px;
  }
  .fssd-shopping-paths__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: #f4f4f5;
  }
  .fssd-shopping-paths__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fssd-shopping-paths__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 6px;
    padding: 16px;
  }
  .fssd-shopping-paths__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fssd-paths-accent);
  }
  .fssd-shopping-paths__title {
    font-size: 17px;
    font-weight: 700;
    line-height: 22px;
  }
  .fssd-shopping-paths__text {
    flex: 1 1 auto;
    color: var(--fssd-paths-muted);
    font-size: 14px;
    line-height: 20px;
  }
  .fssd-shopping-paths__cta {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--fssd-paths-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media screen and (max-width: 1199px) {
    .fssd-shopping-paths__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .fssd-shopping-paths__inner {
      padding: 0 20px;
    }
    .fssd-shopping-paths__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Shopping Paths",
  "class": "fssd-shopping-paths-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Choose How You Want to Shop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Start with the path that best matches your project. You can still browse every brand and product category."
    }
  ],
  "blocks": [
    {
      "type": "path_card",
      "name": "Path Card",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body Copy"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "select",
          "id": "path",
          "label": "Path value (fss_hp_path_click property)",
          "options": [
            { "value": "remanufactured", "label": "Remanufactured" },
            { "value": "new", "label": "New" },
            { "value": "french_fitness", "label": "French Fitness" },
            { "value": "gym_packages", "label": "Gym Packages" }
          ],
          "default": "remanufactured"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shopping Paths",
      "category": "Custom",
      "blocks": [
        {
          "type": "path_card",
          "settings": {
            "eyebrow": "CONDITION",
            "title": "Remanufactured Equipment",
            "body": "Commercial machines remanufactured in our Benicia facility.",
            "cta_label": "Shop Remanufactured",
            "link": "/collections/products-remanufactured",
            "path": "remanufactured"
          }
        },
        {
          "type": "path_card",
          "settings": {
            "eyebrow": "CONDITION",
            "title": "New Equipment",
            "body": "New cardio, strength, and free-weight equipment.",
            "cta_label": "Shop New Equipment",
            "link": "/collections/new-equipment",
            "path": "new"
          }
        },
        {
          "type": "path_card",
          "settings": {
            "eyebrow": "OUR BRAND",
            "title": "French Fitness",
            "body": "Our own line of new, U.S.-assembled commercial gym equipment.",
            "cta_label": "Browse French Fitness",
            "link": "/collections/french-fitness",
            "path": "french_fitness"
          }
        },
        {
          "type": "path_card",
          "settings": {
            "eyebrow": "FULL FACILITY",
            "title": "Gym Packages",
            "body": "Explore equipment packages by gym size and customize the equipment mix for your space.",
            "cta_label": "View Gym Packages",
            "link": "/pages/gym-packages",
            "path": "gym_packages"
          }
        }
      ]
    }
  ]
}
{% endschema %}
