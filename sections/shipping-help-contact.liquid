{%- liquid
  assign contact_blocks = section.blocks | where: 'type', 'contact'
  assign hours_blocks = section.blocks | where: 'type', 'hours'
-%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .help-contact__inner {
    background-color: {{ section.settings.bg_color }};
    border: 1px solid #ececec;
    border-radius: 24px;
    padding: 48px;
  }

  #shopify-section-{{ section.id }} .help-contact__title {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 38px;
    line-height: 50px;
    text-transform: uppercase;
    text-align: center;
    color: #23232b;
    margin: 0 0 24px;
  }

  #shopify-section-{{ section.id }} .help-contact__methods {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .help-contact__hours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    background-color: {{ section.settings.hours_bg_color }};
    border-radius: 16px;
    padding: 24px 28px;
  }

  #shopify-section-{{ section.id }} .help-contact__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .help-contact__head svg {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .help-contact__label {
    font-family: Lato, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #23232b;
  }

  #shopify-section-{{ section.id }} .help-contact__value,
  #shopify-section-{{ section.id }} .help-contact__value p {
    color: #555a60;
    font-size: 17px;
    line-height: 1.5;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .help-contact__value {
    margin-top: 8px;
    padding-left: 34px;
  }

  #shopify-section-{{ section.id }} .help-contact__value a {
    color: inherit;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .help-contact__inner {
      padding: 24px 20px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .help-contact__title {
      font-size: 24px;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .help-contact__methods,
    #shopify-section-{{ section.id }} .help-contact__hours {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
{%- endstyle -%}

{%- capture icon_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="#D83D0E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/></svg>{%- endcapture -%}

<div class="help-contact section-{{ section.id }}-padding scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="help-contact__inner">
      {%- if section.settings.title != blank -%}
        <h2 class="help-contact__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if contact_blocks.size > 0 -%}
        <div class="help-contact__methods">
          {%- for block in contact_blocks -%}
            <div class="help-contact__method" {{ block.shopify_attributes }}>
              <div class="help-contact__head">
                {%- case block.settings.icon -%}
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#D83D0E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#D83D0E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/><line x1="8" y1="10" x2="14" y2="10"/><line x1="8" y1="13.5" x2="12" y2="13.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#D83D0E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                {%- endcase -%}
                <span class="help-contact__label">{{ block.settings.label | escape }}</span>
              </div>
              {%- if block.settings.value != blank -%}
                <div class="help-contact__value rte">{{ block.settings.value }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if hours_blocks.size > 0 -%}
        <div class="help-contact__hours">
          {%- for block in hours_blocks -%}
            <div class="help-contact__hours-item" {{ block.shopify_attributes }}>
              <div class="help-contact__head">
                {{ icon_clock }}
                <span class="help-contact__label">{{ block.settings.label | escape }}</span>
              </div>
              {%- if block.settings.value != blank -%}
                <div class="help-contact__value rte">{{ block.settings.value }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shipping help contact",
  "class": "shipping-help-contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Use <br> to control the line break.",
      "default": "Have questions or need assistance?<br>Our team is here to help!"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hours_bg_color",
      "label": "Hours band background",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact method",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "chat", "label": "Text / Chat" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "Value"
        }
      ]
    },
    {
      "type": "hours",
      "name": "Hours",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "richtext",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping help contact"
    }
  ]
}
{% endschema %}
