  <div class="pagination"></div>
</div>

<script>
  // Sort Dropdown
  const sortSelect = document.querySelector('#sort-select');
  const sortTrigger = sortSelect.querySelector('.custom-select-trigger');
  const sortSelectedOption = sortTrigger.querySelector('.selected-option');
  const sortOptions = sortSelect.querySelector('.custom-options');
  const sortArrow = sortSelect.querySelector('svg');

  sortTrigger.addEventListener('click', () => {
    sortOptions.style.display = sortOptions.style.display === 'block' ? 'none' : 'block';
    sortArrow.classList.toggle('active');
  });

  sortSelect.querySelectorAll('.custom-option').forEach((option) => {
    option.addEventListener('click', (event) => {
      const value = event.target.dataset.value;

      // Update the selected option text
      sortSelectedOption.innerHTML = `<strong>${event.target.textContent}</strong>`;
      sortTrigger.dataset.value = value;
      sortOptions.style.display = 'none';
      sortArrow.classList.toggle('active');

      // Dispatch a custom change event
      const changeEvent = new CustomEvent('change', {
        detail: { value },
      });
      sortSelect.dispatchEvent(changeEvent);
    });
  });

  document.addEventListener('click', (e) => {
    if (!sortSelect.contains(e.target)) {
      if (sortOptions.style.display == 'block') {
        sortOptions.style.display = 'none';
        sortArrow.classList.toggle('active');
      }
    }
  });

  const fromSelect = document.querySelector('#from-filter');
  const fromTrigger = fromSelect.querySelector('.custom-select-trigger');
  const fromOptions = fromSelect.querySelector('.custom-options');
  const fromArrow = fromSelect.querySelector('svg');

  fromTrigger.addEventListener('click', () => {
    fromOptions.style.display = fromOptions.style.display === 'block' ? 'none' : 'block';
    fromArrow.classList.toggle('active');
  });

  fromSelect.querySelectorAll('.custom-option').forEach((option) => {
    option.addEventListener('click', (event) => {
      const value = event.target.dataset.value;

      fromTrigger.querySelector('strong').innerHTML = event.target.innerHTML;
      fromOptions.style.display = 'none';
      fromArrow.classList.toggle('active');

        // Dispatch a custom change event
        const changeEvent = new CustomEvent('change', {
          detail: { value },
        });
        fromSelect.dispatchEvent(changeEvent);
    });
  });

  
  document.addEventListener('click', (e) => {
    if (!fromSelect.contains(e.target)) {
      if (fromOptions.style.display == 'block') {
        fromOptions.style.display = 'none';
        fromArrow.classList.toggle('active');
      }
    }
  });
</script>

