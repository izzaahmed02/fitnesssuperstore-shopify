<script>
  document.addEventListener("DOMContentLoaded", async (event) => {
      let allReviews = [];
      const reviewsPerPage = 5;
      let currentPage = 1;
      let filteredReviews = allReviews;
      const preloader = document.getElementById("preloader");
      let sortOrder = 'recent'; 
  
      function showPreloader() {
          preloader.classList.add("active");
      }
  
      function hidePreloader() {
          preloader.classList.remove("active");
      } 
  
      async function fetchReviews() {
          showPreloader();
          try {
              const response = await fetch(`https://fitnesssuperstore-api.azurewebsites.net/api/reviews/all?from=&orderBy=${sortOrder}`);
              if (!response.ok) throw new Error(`error: ${response.status}`);
              allReviews = await response.json();
              filteredReviews = allReviews;
              renderReviews();
          } catch (error) {
              console.error('Loading error:', error);
          } finally {
              hidePreloader();
          }
      }
  
      function createReviewHTML(review) {
          let date = review.dateReviewed || "";
  
          if (review.imageUrl) {
              return `
                  <div class="review-item">
                      <div class="review-item__wrapper">
                          <div class="stars">
                              <div class="Stars" style="--rating: ${review.rating};" aria-label="Rating of this product is ${review.rating} out of 5."></div>
                          </div>
                          <span class="review-text">${review.comment}</span>
                          <span class="name">${review.reviewer}</span>
                          <span class="review-date">${date}</span>
                          <div class="img-wrapper">
                              <img src="${review.imageUrl}">
                          </div>
                      </div>
                  </div>
              `;
          } else {
              return `
                  <div class="review-item">
                      <div class="review-item__wrapper">
                          <div class="stars">
                              <div class="Stars" style="--rating: ${review.rating};" aria-label="Rating of this product is ${review.rating} out of 5."></div>
                          </div>
                          <span class="review-text">${review.comment}</span>
                          <span class="name">${review.reviewer}</span>
                          <span class="review-date">${date}</span>
                      </div>
                  </div>
              `;
          }
      }
  
      function renderReviews() {
          const reviewsWrapper = document.querySelector('.reviews-wrapper');
          const startIndex = (currentPage - 1) * reviewsPerPage;
          const endIndex = Math.min(startIndex + reviewsPerPage, filteredReviews.length);
  
          reviewsWrapper.innerHTML = ""; 
          if (filteredReviews.length) {
              for (let i = startIndex; i < endIndex; i++) {
                  reviewsWrapper.innerHTML += createReviewHTML(filteredReviews[i]);
              }
          } else {
              reviewsWrapper.innerHTML = `<h3>No reviews available</h3>`;
          }
  
          updatePagination();
      }
  
      function updatePagination() {
    const paginationWrapper = document.querySelector('.pagination');
    const totalPages = Math.ceil(filteredReviews.length / reviewsPerPage);
    let paginationHTML = '';


    // Previous Arrow
    paginationHTML += `<div class="prev ${currentPage > 1 ? 'active' : 'inactive'}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_5595_63891)">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z" 
                    fill="${currentPage > 1 ? '#F1592A' : '#CCCCCC'}"/>
            </g>
            <defs>
                <clipPath id="clip0_5595_63891">
                    <rect width="24" height="24" rx="4" fill="white"/>
                </clipPath>
            </defs>
        </svg>
    </div>`;

    // Define the range of pages to display
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    // Show ellipsis if current page is greater than the range
    if (startPage > 1) {
        paginationHTML += `<div class="page-number" data-page="1">1</div>`;
        if (startPage > 2) {
            paginationHTML += `<div class="dots">...</div>`;
        }
    }

    // Render the range of pages around the current page
    for (let i = startPage; i <= endPage; i++) {
        paginationHTML += `<div class="page-number ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</div>`;
    }

    // Show ellipsis if there are pages remaining after the current range
    if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
            paginationHTML += `<div class="dots">...</div>`;
        }
        paginationHTML += `<div class="page-number" data-page="${totalPages}">${totalPages}</div>`;
    }

    // Next Arrow
    paginationHTML += `<div class="next ${currentPage < totalPages ? 'active' : 'inactive'}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" 
                fill="${currentPage < totalPages ? '#F1592A' : '#CCCCCC'}"/>
        </svg>
    </div>`;

    paginationWrapper.innerHTML = paginationHTML;

    // Event Listeners for Page Numbers and Arrows
    paginationWrapper.querySelectorAll('.page-number').forEach(page => {
        page.addEventListener('click', (e) => {
            currentPage = parseInt(e.target.dataset.page);
            renderReviews();
        });
    });

    const prev = paginationWrapper.querySelector('.prev');
    const next = paginationWrapper.querySelector('.next');
    
    if (prev && prev.classList.contains('active')) {
        prev.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                renderReviews();
            }
        });
    }

    if (next && next.classList.contains('active')) {
        next.addEventListener('click', () => {
            if (currentPage < totalPages) {
                currentPage++;
                renderReviews();
            }
        });
    }
}
  
      document.querySelector('#sort-select').addEventListener('change', (event) => {
          sortOrder = event.target.value; 
          currentPage = 1; 
          fetchReviews(); 
      });
  
      await fetchReviews();
  });

</script>

<style>
  /* Add your previous styling */
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .container {
    margin-left: auto;
    margin-right: auto;
    max-width: 1280px;
    padding: 0 15px;
    box-sizing: content-box;
  }
  .reviews-section .review-item {
    width: auto;
    height: 100%;
  }
  .reviews-section .review-text {
    height: auto;
    overflow: hidden;
  }
  .reviews-section .reviews-wrapper {
    display: flex;
    flex-direction: column;
    row-gap: 12px;
  }
  .filter-wrapper {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  #rating-filter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: 20px;
    margin-bottom: 10px;
  }
  #rating-filter span {
    margin-right: 4px;
  }
  #rating-filter .rating-filter-button {
    width: 80px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--black-color);
    border: 2px solid rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    cursor: pointer;
  }
  #rating-filter .rating-filter-button.active {
    border: 2px solid var(--main-color);
  }
  #sort-select {
    width: 294px;
    height: 48px;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px;
    padding: 12px;
    background-repeat: no-repeat;
    background-position: right 0.7rem top 50%;
    cursor: pointer;
    box-sizing: border-box;
  }
  #rating-select{
    width: 294px;
    height: 48px;
    border-radius: 8px;
    padding: 12px;
    border: 1.5px solid #E5E5E5;
    box-sizing: border-box;
  }
  .review-item .img-wrapper img {
    display: flex;
  }
  .review-item .img-wrapper img {
    height: 170px;
    object-fit: contain;
    margin-top: 20px;
  }
  .review-location {
    color: rgba(0, 0, 0, 0.7);
  }
  /* Pagination styles */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 32px;
  }
  .pagination .page-number {
    padding: 8px 16px;
    margin: 0 5px;
    cursor: pointer;
    border-radius: 4px;
  }
  .pagination .page-number.active {
    background-color: #F1592A;
    color: #ffffff;
  }
  .pagination .dots {
    padding: 8px 16px;
  }
  .pagination .prev, .pagination .next {
    padding: 8px 16px;
    cursor: pointer;
    border-radius: 4px;
  }
  .pagination .disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .reviews-wrapper .review-item .name{
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    line-height: 24px;
    margin-top: 16px;
    
  }
  .reviews-wrapper .review-item .review-text{
    color: #393940;
    
  }
  .review-date{
    color: #393940;
    margin-bottom: 0;
  }

  .preloader {
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .preloader.active {
    display: flex;
    opacity: 1;
    visibility: visible;
  }
  
  .spinner { 
    display: block!important;
    border: 6px solid #f3f3f3;
    border-top: 6px solid #f1592a;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  @media(max-width: 767px){
    #shopify-section-{{ section.id }} {
      padding-top: 20px;
      padding-bottom: 48px;
    }
    #rating-select{
      width: 100%;
      max-width: 400px;    
    }
    #rating-filter {
      width: 100%;
    }
    #sort-select {
      width: 100%;
      max-width: 400px;
    }
  }
</style>

<div class="container">
  <div class="filter-wrapper">
    <div id="rating-filter">
      <select id="rating-select">
        <option value="all">All Ratings</option>
        <option value="5">5 stars</option>
        <option value="4">4 stars</option>
        <option value="3">3 stars</option>
        <option value="2">2 stars</option>
        <option value="1">1 star</option>
      </select>
    </div>

    <select id="sort-select">
      <option value="recent">Sort by Most Recent</option>
      <option value="oldest">Sort by Oldest</option>
    </select>
  </div>
  <div class="preloader" id="preloader">
    <div class="spinner"></div>
  </div>
  <div class="reviews-wrapper"></div>
  <div class="pagination"></div>
</div>

