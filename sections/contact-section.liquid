{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .contact__heading{
    text-align: center;
    margin-top: 0;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} p{
    text-align: center;
    margin-top: 0;
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .btn__link{
    font-family: "Lato";
    line-height: 24px;
    color: #ffffff;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    background: #F1592A;
    border-radius: 8px;
    margin-top: 24px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .contact-content .item{
    display: flex;
    align-items: center;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .contact-content .item img{
    margin-right: 12px;
  }
  .contact-wrapper{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    margin-top: 24px;
  }
  .contact-content .title{
    font-family: "Lato";
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #000000;
    margin-bottom: 16px;
    display: block;
    margin-top: 0;
  }
  .contact-content .name{
    font-family: "Lato";
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    color: #393940;
    margin-right: 12px;
    display: block;
  }
  .contact-content .text{
    font-family: "Lato";
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #393940;
    margin-right: 12px;
    display: flex;
    align-items: center;
  }
  .circle{
    display: block!important;
    width: 10px;
    height: 10px;
    margin-right: 12px;
    background: #D3D9E5;
    border-radius: 50%;
  }
  .schedule{
    margin-top: 32px;
  }
  .schedule .title{
    font-family: "Lato";
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #000000;
    margin-bottom: 16px;
  }
  .schedule-wrapper{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
  }
  .schedule-item{
     display: flex;
     flex-direction: column;
     align-items: center;
    background: #EDEFF3;
    padding: 16px 24px;
    border-radius: 12px;
  }
  .schedule-item .day{
    font-family: "Lato";
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
    color: #000000;
    display: block;
    margin-bottom: 8px;
  }
  .schedule-item .work-hours{
    font-family: "Lato";
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #393940;
    display: block;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="container">
  <h2 class="contact__heading">{{ section.settings.heading }}</h2>
  {% if section.settings.text != blank %}
    <p>{{ section.settings.text }}</p>
  {% endif %}
  {% if section.settings.link != blank %}
    <a href="{{ section.settings.href }}" class="btn__link">{{ section.settings.link }}</a>
  {% endif %}
  </div>
  <div class="contact-wrapper">
    <div class="contact-content">
      <span class="title">Contacts</span>
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when "info" -%}
            <div class="item">
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: auto | image_tag }}{% endif %}
              <span class="name">{{ block.settings.name }}</span>
              <div class="text">{{ block.settings.text1 }}</div>
              {% if block.settings.text2 != blank %}
              <div class="text">
                <div class="circle"></div>
                {{ block.settings.text2 }}
              </div>
              {% endif %}
            </div>
          {%- when "schedule" -%}
            <div class="schedule">
              <div class="title">{{ block.settings.title }}</div>
              <div class="schedule-wrapper">
                <div class="schedule-item">
                  <span class="day">Mon-Fri</span>
                  <span class="work-hours">{{ block.settings.mon }}</span>
                </div>
                <div class="schedule-item">
                  <span class="day">Sat</span>
                  <span class="work-hours">{{ block.settings.sat }}</span>
                </div>
                <div class="schedule-item">
                  <span class="day">Sun</span>
                  <span class="work-hours">{{ block.settings.sun }}</span>
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="contact-image">
      {{ section.settings.image | image_url: width: auto | image_tag }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "contact-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "href",
      "label": "Href"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    },
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Contact info",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "text1",
          "label": "Text 1"
        },
        {
          "type": "text",
          "id": "text2",
          "label": "Text 2"
        },
      ]
    },
    {
      "type": "schedule",
      "name": "Schedule",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "mon",
          "label": "Mon-Fri"
        },
        {
          "type": "text",
          "id": "sat",
          "label": "Sat"
        },
        {
          "type": "text",
          "id": "sun",
          "label": "Sun"
        },
      ]
    },
  ],
  "presets": [
    {
      "name": "Contact section"
    }
  ]
}
{% endschema %}