<style>
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px 16px;
  width: 100%;
  max-width: 1044px;
  margin: 0 auto;
}

.image {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 52px 16px;
  gap: 10px;
  width: 100%;
  height: 440px;
  background-size: cover;
  background-position: center;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0px;
  gap: 32px;
  width: 100%;
  max-width: 604px;
}

.description {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  gap: 4px;
  width: 100%;
  max-width: 389px;
  height: 40px;
  background: rgba(171, 171, 171, 0.51);
  border: 1px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(5px);
  border-radius: 8px;
}

.rating {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0px;
  width: 80px;
  height: 16px;
}

.star {
  position: relative;
  width: 16px;
  height: 16px;
}

.star div {
  position: absolute;
  width: 14.67px;
  height: 14.67px;
  left: 0.67px;
  top: 0.67px;
  border-radius: 0.533333px;
}

.description span {
  width: 100%;
  max-width: 281px;
  height: 24px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #FFFFFF;
}

.title {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0px;
  gap: 16px;
  width: 100%;
  max-width: 604px;
}

.title h1 {
  width: 100%;
  max-width: 604px;
  height: auto;
  font-family: 'Oswald';
  font-style: normal;
  font-weight: 600;
  font-size: 48px;
  line-height: 68px;
  display: flex;
  align-items: center;
  text-transform: uppercase;
  color: #FFFFFF;
}

.simple-button {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 12px 12px 12px 24px;
  gap: 8px;
  width: 142px;
  height: 48px;
  border-radius: 8px;
  text-decoration: none;
}

.simple-button span {
  width: 74px;
  height: 24px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #FFFFFF;
}

.chevron {
  width: 24px;
  height: 24px;
}

.chevron div:first-child {
  position: absolute;
  width: 7.5px;
  height: 13.5px;
  left: 9.25px;
  top: 5.25px;
  background: #FFFFFF;
}

.chevron div:last-child {
  position: absolute;
  left: 41.67%;
  right: 33.33%;
  top: 25%;
  bottom: 25%;
  border: 1.5px solid #000000;
}

.questions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  padding: 60px 16px;
  gap: 24px;
  width: 100%;
  max-width: 1012px;
  height: auto;
  background: #53565A;
  flex-wrap: wrap;
}

.benefit-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px;
  gap: 24px;
  width: 100%;
  max-width: 310.67px;
  height: auto;
  background: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  margin-bottom: 24px;
}

.text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0px;
  gap: 8px;
  width: 100%;
  max-width: 262.67px;
  height: auto;
}

.text h5 {
  width: 100%;
  max-width: 262.67px;
  height: auto;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  font-size: 20px;
  line-height: 26px;
  text-align: center;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #000000;
}

.text p {
  width: 100%;
  max-width: 262.67px;
  height: auto;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  text-align: center;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #393940;
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-section {
    padding: 16px;
    width: 100%;
  }

  .image {
    padding: 24px 16px;
    height: 300px;
  }

  .content {
    gap: 16px;
    max-width: 100%;
  }

  .description {
    padding: 6px 10px;
    max-width: 100%;
  }

  .title h1 {
    font-size: 32px;
    line-height: 40px;
    max-width: 100%;
  }

  .simple-button {
    padding: 8px 12px;
    width: 120px;
    height: 40px;
  }

  .questions {
    padding: 30px 16px;
    flex-direction: column;
    align-items: center;
  }

  .benefit-card {
    max-width: 100%;
    margin-bottom: 16px;
  }

  .text {
    max-width: 100%;
  }

  .text h5 {
    font-size: 18px;
    line-height: 22px;
  }

  .text p {
    font-size: 14px;
    line-height: 20px;
  }
}

@media (max-width: 480px) {
  .image {
    height: 200px;
  }

  .title h1 {
    font-size: 24px;
    line-height: 32px;
  }

  .simple-button {
    width: 100px;
    height: 36px;
  }

  .benefit-card {
    padding: 16px;
  }
}
</style>


{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Number of Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Elevate Your Fitness. Buy Top Quality Gym Equipment."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color",
      "default": "#F1592A"
    },
    {
      "type": "text",
      "id": "why_choose_us",
      "label": "Why Choose Us Text",
      "default": "Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available"
    },
    {
      "type": "text",
      "id": "warranty_text",
      "label": "Warranty Text",
      "default": "Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years"
    },
    {
      "type": "text",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "Our mission is to ensure every customer is satisfied and sees the customer value in their purchase"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "settings": {
        "rating_text": "4.9/5 by Thousands of happy customers",
        "rating_stars": 4,
        "title_text": "Elevate Your Fitness. Buy Top Quality Gym Equipment.",
        "button_text": "Shop Now",
        "button_link": "/collections/all",
        "button_color": "#F1592A",
        "why_choose_us": "Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available",
        "warranty_text": "Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years",
        "mission_text": "Our mission is to ensure every customer is satisfied and sees the customer value in their purchase"
      }
    }
  ]
}
{% endschema %}

<div class="hero-section">
  <div class="image" style="background-image: url('{{ section.settings.background_image | img_url: 'large' }}');">
    <div class="content">
      <div class="description">
        <div class="rating">
          {% for i in (1..section.settings.rating_stars) %}
            <div class="star" style="background: #FFC107; width: 16px; height: 16px; border-radius: 0.533333px;"></div>
          {% endfor %}
          {% if section.settings.rating_stars < 5 %}
            {% for i in (section.settings.rating_stars..4) %}
              <div class="star" style="border: 1px solid #FFC107; width: 16px; height: 16px; border-radius: 0.533333px;"></div>
            {% endfor %}
          {% endif %}
        </div>
        <span>{{ section.settings.rating_text }}</span>
      </div>
      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
      </div>
      <a class="simple-button" href="{{ section.settings.button_link }}" style="background-color: {{ section.settings.button_color }};">
        <span>{{ section.settings.button_text }}</span>
        <div class="chevron"></div>
      </a>
    </div>
  </div>
  <div class="questions">
    <div class="benefit-card">
      <div class="text">
        <h5>Why Choose Us</h5>
        <p>{{ section.settings.why_choose_us }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h5>Warranty</h5>
        <p>{{ section.settings.warranty_text }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h5>Mission</h5>
        <p>{{ section.settings.mission_text }}</p>
      </div>
    </div>
  </div>
</div>