{{ 'section-hero.css' | asset_url | stylesheet_tag: preload: true }}

<div class="hero-section">
  <div class="image-wrapper">
    {% assign hero_image = section.settings.background_image %}
    <picture>
      {%- comment -%} Serve WebP first with PNG/JPEG fallback {%- endcomment -%}
      <source
        srcset="{{ hero_image | image_url: width: 768, format: 'webp' }} 768w, {{ hero_image | image_url: width: 1200, format: 'webp' }} 1200w, {{ hero_image | image_url: width: 1600, format: 'webp' }} 1600w"
        sizes="100vw"
        type="image/webp"
      >
      {{
        hero_image
        | image_url: width: 1600
        | image_tag:
          alt: section.settings.title_text,
          class: 'hero-bg',
          loading: 'eager',
          fetchpriority: 'high',
          decoding: 'async',
          widths: '768, 1200, 1600, 2000',
          sizes: '100vw'
      }}
    </picture>

    <div class="overlay"></div> 

    <div class="content">
      <div class="description">
        {% if section.settings.rating_link != blank %}
        <a class="rating-button-link" href="{{ section.settings.rating_link }}">
        {% endif %}
          <div class="ratingBlock">
            <div class="rating">
              {% render 'rating' %}
            </div>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% if section.settings.rating_link != blank %}
        </a>
        {% endif %}
        <a href="{{ section.settings.button_link }}" class="bannerBtn mobile button button--secondary">
            {{ section.settings.button_text }}
            {% render 'chevron-button' %}
        </a>
      </div>

      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
        <p class="copyText">{{ section.settings.copy_text }}</p>
      </div>

      <a href="{{ section.settings.button_link }}" class="bannerBtn desktop button button--secondary">
        {{ section.settings.button_text }}
        {% render 'chevron-button' %}
      </a>
    </div>
  </div>

  <div class="questions">
    <div class="benefit-card">
      <div class="text">
        <h2>Why Choose Us</h2>
        <p>{{ section.settings.why_choose_us }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h2>Warranty</h2>
        <p>{{ section.settings.warranty_text }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h2>Mission</h2>
        <p>{{ section.settings.mission_text }}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .image-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    width: 100%;
  }
  .image-wrapper picture {
    width:100%;
    position: absolute;
    top: 0;
    height: 100%;
}

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .image-wrapper .content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 20px;
    width: 100%;
    background: linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.4) 50%), linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.3) 68.4%);
  }
</style>



{% schema %}
{
  "name": "Hero Section",
  "class": "heroSection",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Rating Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Elevate Your Fitness. Buy Top Quality Gym Equipment."
    },
     {
      "type": "text",
      "id": "copy_text",
      "label": "Text",
      "default": "Transform your space with new, used, or remanufactured top gym equipment from brands like Precor, Life Fitness & more. Fitness Superstore offers 5-star service, nationwide delivery, and industry-leading warranties, giving unmatched value for home or commercial setups."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "richtext",
      "id": "why_choose_us",
      "label": "Why Choose Us Text",
      "default": "<p>Shop new and remanufactured equipment, global shipping and full delivery service options available</p>"
    },
    {
      "type": "richtext",
      "id": "warranty_text",
      "label": "Warranty Text",
      "default": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "settings": {
        "rating_text": "4.9/5 by Thousands of happy customers",
        "title_text": "Elevate Your Fitness. Buy Top Quality Gym Equipment.",
        "button_text": "Shop Now",
        "button_link": "/collections/all",
        "why_choose_us": "<p>Shop new and remanufactured equipment, global shipping and full delivery service options available</p>",
        "warranty_text": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>",
        "mission_text": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
      }
    }
  ]
}
{% endschema %}
