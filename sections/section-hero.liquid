<style>
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px 16px;
  width: 100%;
  max-width: 1044px;
  margin: 0 auto;
}

.image {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 52px 16px;
  gap: 10px;
  width: 1012px;
  height: 440px;
  background: linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.3) 68.4%), linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.4) 50%), url('{{ section.settings.background_image | img_url: 'large' }}');
  background-size: cover;
  background-position: center;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0px;
  gap: 32px;
  width: 604px;
  height: 288px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.description {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  gap: 4px;
  width: 389px;
  height: 40px;
  background: rgba(171, 171, 171, 0.51);
  border: 1px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(5px);
  border-radius: 8px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.rating {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0px;
  width: 80px;
  height: 16px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.star {
  position: relative;
  width: 16px;
  height: 16px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.star div {
  position: absolute;
  width: 14.67px;
  height: 14.67px;
  left: 0.67px;
  top: 0.67px;
  border-radius: 0.533333px;
}

.description span {
  width: 281px;
  height: 24px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #FFFFFF;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.title {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0px;
  gap: 16px;
  width: 604px;
  height: 136px;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.title h1 {
  width: 604px;
  height: 136px;
  font-family: 'Oswald';
  font-style: normal;
  font-weight: 600;
  font-size: 48px;
  line-height: 68px;
  display: flex;
  align-items: center;
  text-transform: uppercase;
  color: #FFFFFF;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.simple-button {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 12px 12px 12px 24px;
  gap: 8px;
  width: 142px;
  height: 48px;
  background: #F1592A;
  border-radius: 8px;
  text-decoration: none;
  flex: none;
  order: 2;
  flex-grow: 0;
}

.simple-button span {
  width: 74px;
  height: 24px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #FFFFFF;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.chevron {
  width: 24px;
  height: 24px;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.chevron div:first-child {
  position: absolute;
  width: 7.5px;
  height: 13.5px;
  left: 9.25px;
  top: 5.25px;
  background: #FFFFFF;
}

.chevron div:last-child {
  position: absolute;
  left: 41.67%;
  right: 33.33%;
  top: 25%;
  bottom: 25%;
  border: 1.5px solid #000000;
}

.questions {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  padding: 60px 16px;
  gap: 24px;
  width: 1012px;
  height: 322px;
  background: #53565A;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.benefit-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px;
  gap: 24px;
  width: 310.67px;
  height: 202px;
  background: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 1;
}

.text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0px;
  gap: 8px;
  width: 262.67px;
  height: 154px;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.text h5 {
  width: 262.67px;
  height: 26px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  font-size: 20px;
  line-height: 26px;
  text-align: center;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #000000;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.text p {
  width: 262.67px;
  height: 120px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  text-align: center;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #393940;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .image {
    width: 100%;
    height: auto;
    padding: 32px 16px;
  }

  .content {
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .description {
    width: 100%;
    max-width: 100%;
  }

  .title {
    width: 100%;
    max-width: 100%;
  }

  .title h1 {
    width: 100%;
    max-width: 100%;
    font-size: 36px;
    line-height: 48px;
    height: auto;
  }

  .questions {
    width: 100%;
    height: auto;
    padding: 40px 16px;
    flex-direction: column;
    align-items: center;
  }

  .benefit-card {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-bottom: 24px;
  }

  .text {
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .text h5 {
    width: 100%;
    max-width: 100%;
  }

  .text p {
    width: 100%;
    max-width: 100%;
    height: auto;
  }
}

@media (max-width: 768px) {
  .image {
    padding: 24px 16px;
    height: 300px;
  }

  .title h1 {
    font-size: 32px;
    line-height: 40px;
  }

  .simple-button {
    padding: 8px 12px;
    width: 120px;
    height: 40px;
  }

  .benefit-card {
    margin-bottom: 16px;
  }
}

@media (max-width: 480px) {
  .image {
    height: 200px;
  }

  .title h1 {
    font-size: 24px;
    line-height: 32px;
  }

  .simple-button {
    width: 100px;
    height: 36px;
  }

  .benefit-card {
    padding: 16px;
  }
}
</style>


