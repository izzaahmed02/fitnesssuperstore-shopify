<style>
.heroSection .hero-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px 16px;
  width: 100%;
  max-width: 1044px;
  margin: 0 auto;
}

.heroSection .image {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 24px 16px;
  gap: 20px;
  width: 343px;
  height: 440px;
  background: linear-gradient(1.19deg, rgba(35, 35, 43, 0) 1.33%, rgba(35, 35, 43, 0.4) 99.31%), 
              linear-gradient(179.61deg, rgba(35, 35, 43, 0) 0.21%, rgba(35, 35, 43, 0.4) 99.55%), 
              url('{{ section.settings.background_image | img_url: 'large' }}');
  background-size: cover;
  background-position: center;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  gap: 20px;
  width: 311px;
  height: 106px;
  margin: 0 auto;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .description {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0;
  gap: 2px;
  width: 244px;
  height: 38px;
  backdrop-filter: blur(5px);
  border-radius: 12px;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.heroSection .rating {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0;
  width: 80px;
  height: 16px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.heroSection .star {
  position: relative;
  width: 16px;
  height: 16px;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.heroSection .star div {
  position: absolute;
  width: 14.67px;
  height: 14.67px;
  left: 0.67px;
  top: 0.67px;
  background: #FFC107;
  border-radius: 0.533333px;
}

.heroSection .star.empty div {
  background: none;
  border: 1px solid #FFC107;
}

.heroSection .description span {
  width: 244px;
  height: 20px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  text-decoration-line: underline;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #FFFFFF;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.heroSection .title {
  margin: 0 auto;
  width: 311px;
  height: 102px;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .title h1 {
  font-family: 'Oswald';
  font-style: normal;
  font-weight: 600;
  font-size: 28px;
  line-height: 34px;
  display: flex;
  align-items: center;
  text-align: center;
  text-transform: uppercase;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #FFFFFF;
  margin: 0;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .simple-button {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 12px 12px 12px 24px;
  gap: 8px;
  width: 311px;
  height: 48px;
  background: #F1592A;
  border-radius: 8px;
  text-decoration: none;
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
}

  .heroSection .bannerBtn{
    order: 2;
  }

.heroSection .simple-button span {
  width: 74px;
  height: 24px;
  font-family: 'Lato';
  font-style: normal;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  font-feature-settings: 'pnum' on, 'lnum' on;
  color: #FFFFFF;
  flex: none;
  order: 0;
  flex-grow: 0;
}

.heroSection .chevron {
  width: 24px;
  height: 24px;
  flex: none;
  order: 1;
  flex-grow: 0;
}

.heroSection .chevron div:first-child {
  position: absolute;
  width: 7.5px;
  height: 13.5px;
  left: 9.25px;
  top: 5.25px;
  background: #FFFFFF;
}

.heroSection .chevron div:last-child {
  position: absolute;
  left: 41.67%;
  right: 33.33%;
  top: 25%;
  bottom: 25%;
  border: 1.5px solid #000000;
}

.heroSection .questions {
  display: grid;
  grid-template-columns: 1fr;
  justify-content: center;
  align-items: flex-start;
  padding: 40px 16px;
  gap: 24px;
  background: #53565A;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .benefit-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24px;
  gap: 24px;
  background: #FFFFFF;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  flex: none;
  align-self: stretch;
  flex-grow: 1;
}

.heroSection .text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0;
  gap: 8px;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

.heroSection .text h2 {
  font-family: 'Lato';
  font-weight: 700;
  font-size: 20px;
  line-height: 26px;
  text-align: center;
  margin: 0;
  width: 100%;
}

.heroSection .text p {
  font-family: 'Lato';
  font-style: normal;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  text Fleet: 0px;
  text-align: center;
  color: #393940;
  margin: 0;
}

.heroSection .benefit-card .text a {
  color: #F1592A;
  text-decoration: underline;
}


@media (max-width: 768px) {

  .heroSection .hero-section{
    padding: 8px 16px;
  }
  .heroSection .image {
    width: 100%;
    max-width: 343px;
    height: 440px;
    padding: 24px 16px;
  }

  .heroSection .bannerBtn{
    order: 1;
  }

  .heroSection .content {
    width: 100%;
    max-width: 311px;
    height: 100%;
        justify-content: space-between;
  }

  .heroSection .description {
    width: 100%;
    max-width: 244px;
    order: 2;
  }

  .heroSection .title {
    width: 100%;
    max-width: 311px;
    height: auto;
  }

  .heroSection .title h1 {
    font-size: 28px;
    line-height: 34px;
  }

  .heroSection .simple-button {
    width: 100%;
    max-width: 311px;
    height: 48px;
    padding: 12px 12px 12px 24px;
  }

  .heroSection .questions {
    padding: 40px 16px;
  }

  .heroSection .benefit-card {
    margin-bottom: 16px;
  }
}

@media (max-width: 480px) {
  .heroSection .image {
    height: 440px;
            width: 100%;
        max-width: 100%;
  }

  .heroSection .title h1 {
    font-size: 24px;
    line-height: 32px;
  }

  .heroSection .simple-button {
    width: 100%;
    height: 48px;
  }

  .heroSection .benefit-card {
    padding: 16px;
  }
}
</style>


{% schema %}
{
  "name": "Hero Section",
  "class": "heroSection",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
   
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Elevate Your Fitness. Buy Top Quality Gym Equipment."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color",
      "default": "#F1592A"
    },
    {
      "type": "richtext",
      "id": "why_choose_us",
      "label": "Why Choose Us Text",
      "default": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>"
    },
    {
      "type": "richtext",
      "id": "warranty_text",
      "label": "Warranty Text",
      "default": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "settings": {
        "rating_text": "4.9/5 by Thousands of happy customers",
        "title_text": "Elevate Your Fitness. Buy Top Quality Gym Equipment.",
        "button_text": "Shop Now",
        "button_link": "/collections/all",
        "button_color": "#F1592A",
        "why_choose_us": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>",
        "warranty_text": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>",
        "mission_text": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
      }
    }
  ]
}
{% endschema %}

<div class="hero-section">
  <div class="image" style="background-image: url('{{ section.settings.background_image | img_url: 'large' }}');">
    <div class="content">

      <div>
            <div class="description">
              <div class="rating">          
                 {% render 'rating'%}
              </div>
              <span>{{ section.settings.rating_text }}</span>
            </div>
            <a class="bannerBtn button button--secondary mobileBtn" href="{{ section.settings.button_link }}">
                 {{ section.settings.button_text }}
                {% render 'chevron-button' %}
            </a>
    </div>
      
      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
      </div>





            <a class="bannerBtn button button--secondary desktopBtn" href="{{ section.settings.button_link }}">
                 {{ section.settings.button_text }}
                {% render 'chevron-button' %}
            </a>
      
    </div>
  </div>
  <div class="questions">
    <div class="benefit-card">
      <div class="text">
        <h2>Why Choose Us</h2>
        <p>{{ section.settings.why_choose_us }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h2>Warranty</h2>
        <p>{{ section.settings.warranty_text }}</p>
      </div>
    </div>
    <div class="benefit-card">
      <div class="text">
        <h2>Mission</h2>
        <p>{{ section.settings.mission_text }}</p>
      </div>
    </div>
  </div>
</div>