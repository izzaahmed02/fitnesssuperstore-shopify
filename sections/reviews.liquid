{% stylesheet %}

.homepage-reviews__item-copy.hide {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.homepage-reviews__item-copy-btn {
  display: none;
  color: #F1592A;
  font-size: 14px;
  font-weight: 600;
  text-decoration: underline;
  cursor: pointer;
}

.homepage-reviews__item-copy-btn.active {
  display: inline-block;
}

  



  .reviewsHome{
background-color: #FAF9F9;
  }
  
.reviewsHome .browse-by-category {
  padding: 60px 16px;
}
.reviewsHome .category-tabs {
  display: flex;
  gap: 24px;
  margin-bottom: 0px;
  flex-wrap: wrap;
}

  .reviewsHome .category-tabs button.active{
    font-weight: 700;
  }

   .reviewsHome .homepage-reviews__item-label {
    display: flex;
    align-items: center;
    column-gap: 4px;
}

  .reviewsHome .homepage-reviews__item-label-text {
    font-family: Lato;
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: #00a344;
}


.reviewsHome .category-tabs button {
  position: relative;
  padding-bottom: 8px; 
  background: transparent;
  font-weight: 400;
  text-align: center;
  vertical-align: middle;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-family: Lato;
  border: none;
  cursor: pointer;
}

.reviewsHome .category-tabs button.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 4px;
  width: 100%;
  background-color: #F1592A;
  border-radius: 4px;
}

  
.reviewsHome .category-tab-content {
  display: none;
}
.reviewsHome .category-tab-content.active {
  display: block;
}
.reviewsHome .category-card {
  text-align: center;
  background: #fff;
  padding: 24px 34px;
  padding-bottom: 24px !important;
  border-radius: 20px;
  margin: 8px;
}
.reviewsHome .category-card img {
  width: 120px;
  height: 120px;
  object-fit: contain;
  background: transparent;
  display: block;
  margin: 0 auto 10px;
}

.reviewsHome .category-card p {
  font-family: Lato;
font-weight: 700;
font-size: 20px;
line-height: 26px;
  margin: 0px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

}

.reviewsHome .tab-header{
  display: flex;
    align-items: center;
    justify-content: space-between;
  margin-bottom: 32px;
  padding-right: 8px;
}

  .reviewsHome .slick-prev {
    left: 25px!important;
    z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .reviewsHome .slick-next {
    right: 25px!important;
     z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .reviewsHome .tab-header h2{
    margin-left: 8px;
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (max-width: 1050px) {

    .reviewsHome .tab-header{
      display: block;
    }

    .reviewsHome .tab-header h2 {
    margin-left: auto;
    margin-bottom: 20px;
}
  }
{% endstylesheet %}

<div class="browse-by-category">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign tab_data = "" %}
  {% assign separator = "" %}
  {% for block in section.blocks %}
    {% if block.settings.tab_handle != blank %}
      {% assign handle = block.settings.tab_handle | handleize %}
      {% unless tab_data contains handle %}
        {% capture tab_data %}{{ tab_data }}{{ separator }}{{ handle }}::{{ block.settings.tab_title }}{% endcapture %}
        {% assign separator = "|" %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% assign tab_list = tab_data | split: "|" | compact %}

  <div class="category-tabs">
    {% for tab in tab_list %}
      {% assign parts = tab | split: "::" %}
      {% assign handle = parts[0] %}
      {% assign title = parts[1] %}
      <button type="button" class="{% if forloop.first %}active{% endif %}" data-tab="tab-{{ handle }}">
        {{ title }}
      </button>
    {% endfor %}
  </div>
</div>
  
  {% for tab in tab_list %}
    {% assign parts = tab | split: "::" %}
    {% assign handle = parts[0] %}
    <div class="category-tab-content {% if forloop.first %}active{% endif %}" id="tab-{{ handle }}">
      <div class="slider-tab-{{ handle }}">
        {% for block in section.blocks %}
          {% assign card_handle = block.settings.tab_handle | handleize %}
          {% if card_handle == handle %}
            <div class="category-card">
             
                {% assign star_count = block.settings.stars %}
                                {% if star_count > 5 %}
                                    {% assign star_count = 5 %}
                                {% endif %}
                                <div class="homepage-reviews__item-rating">
                                    {% for i in (1..star_count) %}
                                        {% render 'review-star' %}
                                    {% endfor %}
                                </div>
                {% if block.settings.title != blank %}
                  <p>{{ block.settings.title }}</p>
                {% endif %}

                          {% if block.settings.copy != blank %}
                            <p class="homepage-reviews__item-copy">
                              {{ block.settings.copy }}
                            </p>
                            <a href="#" class="homepage-reviews__item-copy-btn">Read More</a>
                          {% endif %}


               <span class="homepage-reviews__item-author">{{ block.settings.author }}</span>
              

               <div class="homepage-reviews__item-label">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-acsb-hidden="true" data-acsb-force-hidden="true">
