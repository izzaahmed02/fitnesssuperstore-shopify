{% comment %}
  Module 2 — Variant B compact hero. Forked from homepage-section-hero.liquid
  so this experiment never touches the shared section (also used by the
  stale templates/page.homepage.json). Single CTA, no benefit-card carousel
  (superseded by Module 7's compact trust chips).
{% endcomment %}
{{ 'homepage-section-hero.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'fss-hp-device-targeting.css' | asset_url | stylesheet_tag: preload: true }}

<script>window.fssHpVariant = 'B';</script>
<script src="{{ 'fss-hp-analytics.js' | asset_url }}" defer="defer"></script>

<div class="hero-section">
  <div class="image-wrapper">
    <picture>
      {%- comment -%} Serve WebP first with PNG/JPEG fallback {%- endcomment -%}
      <source srcset="{{ section.settings.background_image | image_url: width: 1000, format: 'webp' }}" type="image/webp">
      <img
        src="{{ section.settings.background_image | image_url: width: 1000 }}"
        alt="{{ section.settings.title_text | escape }}"
        class="hero-bg"
        loading="eager"
        fetchpriority="high"
        width="1030"
        height="auto"
      >
    </picture>

    <div class="overlay"></div>

    <div class="content">
      <div class="description">
        {% if section.settings.rating_link != blank %}
        <a class="rating-button-link" href="{{ section.settings.rating_link }}">
        {% endif %}
          <div class="ratingBlock">
            <div class="rating">
              {% render 'rating' %}
            </div>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% if section.settings.rating_link != blank %}
        </a>
        {% endif %}
        <a
          href="{{ section.settings.button_link_1 }}"
          class="bannerBtn mobile button button--primary"
          data-fss-hp-event="fss_hp_primary_cta"
          data-fss-hp-props='{"destination": "{{ section.settings.button_link_1 }}"}'
        >
            {{ section.settings.button_text_1 }}
            {% render 'chevron-button' %}
        </a>
      </div>

      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
        <p class="copyText">{{ section.settings.copy_text }}</p>
      </div>

      <div class="btn-container">

      <a
        href="{{ section.settings.button_link }}"
        class="bannerBtn desktop button button--secondary"
        data-fss-hp-event="fss_hp_primary_cta"
        data-fss-hp-props='{"destination": "{{ section.settings.button_link }}"}'
      >
        {{ section.settings.button_text }}
        {% render 'chevron-button' %}
      </a>


      </div>

    </div>
  </div>
</div>

<style>
.homepageHeroSection .btn-container {
  display: flex;
  order: 3;
  gap: 8px;
}
.homepageHeroSection .cta-description {
order: 4;
font-size: 14px;
color: #B0B0B0;
}
.homepageHeroSection .cta-description span {
color: #D83D0E;
margin-left: 3px;
margin-right: 3px;
}
.homepageHeroSection .cta-description p {
margin-top: 0px;
margin-bottom: 0px;
}
.homepageHeroSection .btn-container .bannerBtn.button--primary {
  background-color: #fff !important;
    color: #D83D0E;
}
.homepageHeroSection .content .description .bannerBtn.button--secondary {
  background-color: #fff !important;
    color: #D83D0E;
}
.homepageHeroSection .content .description .bannerBtn.button--primary svg path {
  fill: #fff;
}
.homepageHeroSection .content .description .bannerBtn.button--secondary svg path {
  fill: #D83D0E;
}

.homepageHeroSection .button--primary svg path {
  fill: #D83D0E;
}
  .homepageHeroSection .image-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    width: 100%;
  }
  .homepageHeroSection .image-wrapper picture {
    width:100%;
    position: absolute;
    top: 0;
    height: 100%;
}

  .homepageHeroSection .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .homepageHeroSection .image-wrapper .content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 20px 20px;
    width: 100%;
    background: linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.4) 50%), linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.3) 68.4%);
  }

  @media screen and (max-width: 767px) {
  .homepageHeroSection .cta-description p {
    text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Homepage Hero Compact",
  "class": "homepageHeroSection",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Rating Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Shop New & Remanufactured Gym Equipment"
    },
    {
      "type": "text",
      "id": "copy_text",
      "label": "Text",
      "default": "Save up to 60% off MSRP on new and remanufactured commercial gym equipment. Nationwide delivery, warranty options, and expert help available."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All Equipment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "Mobile Button Text",
      "default": "Shop All Equipment"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Mobile Button Link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Hero Compact"
    }
  ]
}
{% endschema %}
