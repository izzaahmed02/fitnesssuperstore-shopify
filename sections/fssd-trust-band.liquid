{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 6, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Compact horizontal trust band. Replaces the three tall Why Choose Us /
  Warranty / Mission cards so the space goes to shopping rather than repeating
  long trust content near the top. Self-contained per spec R3; no shared
  stylesheet import, no device-targeting CSS (spec R2).

  No analytics attributes — spec §8 defines no event for this module.

  Copy constraint (spec §6): chip wording must stay no stronger than the
  current live pages. Do not add or strengthen any warranty, delivery,
  installation, inventory, financing, certification, return, or lead-time
  claim. The defaults below are deliberately non-specific and still require
  Larianne's approval.
{% endcomment %}

<section class="fssd-trust-band" aria-labelledby="fssd-trust-band-heading-{{ section.id }}">
  <div class="fssd-trust-band__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fssd-trust-band__heading" id="fssd-trust-band-heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="fssd-trust-band__heading fssd-trust-band__heading--visually-hidden" id="fssd-trust-band-heading-{{ section.id }}">
        Why shop with Fitness Superstore
      </h2>
    {%- endif -%}

    <ul class="fssd-trust-band__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_chip' -%}
          <li class="fssd-trust-band__chip" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="fssd-trust-band__icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt="{{ block.settings.icon.alt | escape }}"
                  width="{{ block.settings.icon.width }}"
                  height="{{ block.settings.icon.height }}"
                  loading="lazy"
                  decoding="async"
                >
              </span>
            {%- endif -%}

            <span class="fssd-trust-band__chip-body">
              {%- if block.settings.title != blank -%}
                <span class="fssd-trust-band__chip-title">{{ block.settings.title }}</span>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <span class="fssd-trust-band__chip-text">{{ block.settings.body }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .fssd-trust-band {
    --fssd-trust-border: #e5e5e5;
    --fssd-trust-muted: #616166;
    padding: 24px 0;
  }
  .fssd-trust-band__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .fssd-trust-band__heading {
    margin: 0 0 16px;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.3;
  }
  .fssd-trust-band__heading--visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .fssd-trust-band__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 16px 0;
    list-style: none;
    border-top: 1px solid var(--fssd-trust-border);
    border-bottom: 1px solid var(--fssd-trust-border);
  }
  .fssd-trust-band__chip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .fssd-trust-band__icon {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
  }
  .fssd-trust-band__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .fssd-trust-band__chip-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fssd-trust-band__chip-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
  }
  .fssd-trust-band__chip-text {
    color: var(--fssd-trust-muted);
    font-size: 13px;
    line-height: 18px;
  }
  @media screen and (max-width: 1199px) {
    .fssd-trust-band__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .fssd-trust-band__inner {
      padding: 0 20px;
    }
    .fssd-trust-band__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Desktop Trust Band",
  "class": "fssd-trust-band-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading (leave blank to hide visually)"
    }
  ],
  "blocks": [
    {
      "type": "trust_chip",
      "name": "Trust Chip",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Chip Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Chip Body"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Chip Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop Trust Band",
      "category": "Custom",
      "blocks": [
        {
          "type": "trust_chip",
          "settings": {
            "title": "New & Remanufactured",
            "body": "Choose the condition that fits"
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Warranty Options",
            "body": "See product-specific coverage"
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Nationwide Delivery",
            "body": "Shipping options across the U.S."
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Expert Help",
            "body": "Get help choosing equipment"
          }
        }
      ]
    }
  ]
}
{% endschema %}
