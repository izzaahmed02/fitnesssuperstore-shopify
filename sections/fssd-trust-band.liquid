{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 6, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Compact horizontal trust band. Replaces the three tall Why Choose Us /
  Warranty / Mission cards so the space goes to shopping rather than repeating
  long trust content near the top. Self-contained per spec R3; no shared
  stylesheet import, no device-targeting CSS (spec R2).

  No analytics attributes — spec §8 defines no event for this module.

  Copy constraint (spec §6): chip wording must stay no stronger than the
  current live pages. Do not add or strengthen any warranty, delivery,
  installation, inventory, financing, certification, return, or lead-time
  claim. The defaults below are deliberately non-specific and still require
  Larianne's approval.
{% endcomment %}

<section class="fssd-trust-band" aria-labelledby="fssd-trust-band-heading-{{ section.id }}">
  <div class="fssd-trust-band__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fssd-trust-band__heading" id="fssd-trust-band-heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="fssd-trust-band__heading fssd-trust-band__heading--visually-hidden" id="fssd-trust-band-heading-{{ section.id }}">
        Why shop with Fitness Superstore
      </h2>
    {%- endif -%}

    <ul class="fssd-trust-band__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_chip' -%}
          <li class="fssd-trust-band__chip" {{ block.shopify_attributes }}>
            {%- comment -%}
              Decorative only — aria-hidden, empty alt. The adjacent chip title
              and body carry the meaning. An uploaded image overrides the
              selected inline SVG, so design assets drop in with no code change.
            {%- endcomment -%}
            <span class="fssd-trust-band__icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 96 }}"
                  alt=""
                  width="{{ block.settings.icon_image.width }}"
                  height="{{ block.settings.icon_image.height }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'compare' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 9h13l-3-3"/><path d="M20 15H7l3 3"/></svg>
                {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
                {%- when 'question' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.8a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.9-.9 1.5v.5"/><path d="M12 17h.01"/></svg>
              {%- endcase -%}
              {%- endif -%}
            </span>

            <span class="fssd-trust-band__chip-body">
              {%- if block.settings.title != blank -%}
                <span class="fssd-trust-band__chip-title">{{ block.settings.title }}</span>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <span class="fssd-trust-band__chip-text">{{ block.settings.body }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .fssd-trust-band {
    --fssd-trust-accent: #d83d0e;
    --fssd-trust-border: #e5e5e5;
    --fssd-trust-muted: #616166;
    padding: 24px 0;
  }
  .fssd-trust-band__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .fssd-trust-band__heading {
    margin: 0 0 16px;
    font-size: 20px;
    line-height: 26px;
  }
  .fssd-trust-band__heading--visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .fssd-trust-band__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 16px 0;
    list-style: none;
    border-top: 1px solid var(--fssd-trust-border);
    border-bottom: 1px solid var(--fssd-trust-border);
  }
  .fssd-trust-band__chip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .fssd-trust-band__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #edeff3;
    color: var(--fssd-trust-accent);
  }
  .fssd-trust-band__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  .fssd-trust-band__icon img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    display: block;
  }
  .fssd-trust-band__chip-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fssd-trust-band__chip-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
  }
  .fssd-trust-band__chip-text {
    color: var(--fssd-trust-muted);
    font-size: 13px;
    line-height: 18px;
  }
  @media screen and (max-width: 989px) {
    .fssd-trust-band__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .fssd-trust-band__inner {
      padding: 0 16px;
    }
    .fssd-trust-band__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Desktop Trust Band",
  "class": "fssd-trust-band-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading (leave blank to hide visually)"
    }
  ],
  "blocks": [
    {
      "type": "trust_chip",
      "name": "Trust Chip",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Chip Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Chip Body"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Decorative inline SVG. Overridden if a Chip Icon Image is uploaded.",
          "options": [
            { "value": "compare", "label": "Condition / compare" },
            { "value": "shield", "label": "Warranty / shield" },
            { "value": "truck", "label": "Delivery / truck" },
            { "value": "question", "label": "Help / question" }
          ],
          "default": "compare"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Chip Icon Image (overrides the icon)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop Trust Band",
      "category": "Custom",
      "blocks": [
        {
          "type": "trust_chip",
          "settings": {
            "title": "New & Remanufactured",
            "body": "Compare available condition options",
            "icon": "compare"
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Warranty Information",
            "body": "See product-specific coverage",
            "icon": "shield"
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Delivery Options",
            "body": "Review available services by destination",
            "icon": "truck"
          }
        },
        {
          "type": "trust_chip",
          "settings": {
            "title": "Equipment Help",
            "body": "Get help comparing equipment",
            "icon": "question"
          }
        }
      ]
    }
  ]
}
{% endschema %}
