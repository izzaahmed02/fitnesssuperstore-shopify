{{ 'section-contact-form1.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-form.css' | asset_url | stylesheet_tag }}
{{ 'section-address.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.3 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.3 | round: 0 }}px;
}

#address-map-{{ section.id }} {
  min-height: 208px;
  height: 100%;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{%- endstyle -%}

{% assign contact_blocks = section.blocks | where: 'type', 'contact-info' %}
{% assign hours_blocks = section.blocks | where: 'type', 'hours-info' %}

<div class="page-width section-{{ section.id }}-padding scroll-trigger animate--slide-in">
  <div class="contact-form">

    <!-- CONTACT INFO -->
    <div class="contact-info">
      <h1 class="contact-title small-hide">
        {{ section.settings.heading }}
      </h1>

      <p class="contact-subtitle small-hide">
        {{ section.settings.subheading }}
      </p>

      <div>
        <div>
          <h3 class="contact_info_title">Contact information</h3>

          {% for block in contact_blocks %}
            <div class="contact-info-block">
              <img
                src="{{ block.settings.icon | image_url }}"
                alt="{{ block.settings.icon.alt | escape }}"
                width="24"
                height="24"
              >

              <h4>{{ block.settings.heading }}</h4>

              {% assign content = block.settings.content | replace: '|', '<span class="contact-content-divder"></span>' %}
              <div>{{ content }}</div>
            </div>
          {% endfor %}
        </div>

        {% for block in hours_blocks %}
          <div>
            <h5 class="content_hours_title">
              {{ block.settings.heading }}
            </h5>

            <div class="contact_content_blocks">
              {% for i in (1..3) %}
                {% liquid
                  assign content_key = 'content' | append: i
                  assign title_key = 'content_title' | append: i
                  assign content_value = block.settings[content_key]
                  assign title_value = block.settings[title_key]
                %}

                {% if content_value != blank %}
                  <div class="content_hours_block">
                    <p>{{ title_value }}</p>
                    <span>{{ content_value }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- CONTACT FORM -->
    <div class="contact-form-wrapper">
      <h1 class="contact-title medium-hide large-up-hide">
        {{ section.settings.heading }}
      </h1>

      <p class="contact-subtitle medium-hide large-up-hide">
        {{ section.settings.subheading }}
      </p>

      <h2 class="contact-form-heading">FILL OUT THE FORM</h2>

      <p class="form-microcopy">
        ⏱ Typical response time: same business day during phone hours.
        <span class="urgent">Urgent? Call or text.</span>
      </p>

      <div class="globo-formbuilder" data-id="NjI3MzM="></div>
    </div>

    <!-- ADDRESS SECTION -->
    <div class="address-section">
      <div class="map-scroll-outer">
        <div class="map-scroll-inner">
          <iframe
            id="contact-us-map"
            title="Contact Map"
            width="598"
            height="410"
            loading="lazy"
            allowfullscreen
            style="border:0"
            src="https://www.google.com/maps/embed/v1/place?q=place_id:ChIJH2R-trpnhYAR7FXEjyeAx-U&key=AIzaSyCxpuu9NKFdMHYGp8eCw19CYciM4JUoYaU">
          </iframe>
        </div>
      </div>

      <div>
        <h2 class="address_title">Location</h2>

        {% for block in section.blocks %}
          {% if block.type == 'address_item' %}
            <div class="address-info-container">
              <h2>{{ block.settings.title }}</h2>
              <div>{{ block.settings.text }}</div>

              {% if block.settings.location != blank %}
                <div class="address_info_block">
                  <img
                    src="{{ block.settings.location_icon | image_url }}"
                    alt="{{ block.settings.location_icon.alt | escape }}"
                  >
                  <p>{{ block.settings.location }}</p>
                </div>
              {% endif %}

              {% if block.settings.work_time != blank %}
                <div class="address_info_block">
                  <img
                    src="{{ block.settings.work_time_icon | image_url }}"
                    alt="{{ block.settings.work_time_icon.alt | escape }}"
                  >
                  <p>{{ block.settings.work_time }}</p>
                </div>
              {% endif %}

              {% if block.settings.url != blank %}
                <a href="{{ block.settings.url }}" class="address_info_link">
                  {{ block.settings.link }}
                  {% render 'icon-link-arrow' %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<script src="{{ 'contact-form.js' | asset_url }}" defer></script>

<script defer>
  setTimeout(() => {
    const block = document.querySelector(
      '#shopify-block-AeHFodG1vTTNuUkNKM__powerful_form_builder_app_block_yMzf9w'
    );
    if (block) block.style.display = 'none';
  }, 100);
</script>
