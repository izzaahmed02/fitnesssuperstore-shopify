
{% assign buyingGuide = product.metafields.custom.features_specs.value.buying_guide.value %}
<div class="buying-guide">
    {% if buyingGuide != blank %}
        <div class="product__extra_tech extra-info-width">
        <div>{{ buyingGuide }}</div>
        </div>
    {% endif %}
</div>
<style>
.buying-guide{
    padding: 16px;
}
</style>
{% schema %}
{
    "name": "Buying Guide",
    "settings": [],
     "presets": [
      {
        "name": "Buying Guide",
        "category": "Product"
      }
    ]
}
{% endschema %}