{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pot-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .pot-header {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .pot-title {
    font-size: 38px;
    line-height: 50px;
    letter-spacing: 0px;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .pot-description {
    font-size: 16px;
    color: #5b6fa6;
    font-weight: 600;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .pot-body {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .pot-left-block {
    width: 187px;
    flex-shrink: 0;
    position: relative;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .pot-label {
    position: absolute;
    right: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(-50%);
    width: 187px;
    justify-content: space-between;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .pot-label__text {
    font-family: var(--font-body-family);
    font-size: 20px;
    line-height: 26px;
    color: #1a1a2e;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .pot-label__arrow svg {
    width: 35px;
    height: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .pot-label__arrow--down,
  #shopify-section-{{ section.id }} .pot-label__arrow--up  { display: none; }
  #shopify-section-{{ section.id }} .pot-label__arrow--right { display: inline-flex; }

  #shopify-section-{{ section.id }} .pot-or-divider {
    position: absolute;
    right: 0;
    font-size: 14px;
    color: #1a1a2e;
    font-weight: 500;
    transform: translateY(-50%);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .pot-right-block {
    max-width: 405px;
    width: 405px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pot-mobile-label { display: none; }
  #shopify-section-{{ section.id }} .pot-mobile-arrow-svg { display: none; }

  #shopify-section-{{ section.id }} .pot-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 20px 20px 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  #shopify-section-{{ section.id }} .pot-card__heading {
    font-weight: 700;
    font-size: 16px;
    color: #1a1a2e;
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .pot-payment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .pot-payment-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    border: 1.5px solid #e5e5e5;
    border-radius: 8px;
    background: #fff;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a2e;
  }
  #shopify-section-{{ section.id }} .pot-payment-item--highlighted {
    border-color: #F1592A;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pot-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #ccc;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .pot-radio--active { border-color: #F1592A; }
  #shopify-section-{{ section.id }} .pot-radio__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #F1592A;
  }

  #shopify-section-{{ section.id }} .pot-footer {
    text-align: center;
    margin-top: 32px;
  }
  #shopify-section-{{ section.id }} .pot-footer__text {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 16px;
    margin: 0;
    border-width: 1.5px;
    border-style: solid;
  }

  /* =====================================================================
     MOBILE ≤ 749px
  ===================================================================== */
  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .pot-card { 
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .pot-payment-item {
      padding: 6.5px 12px;
    }

    #shopify-section-{{ section.id }} .pot-card__heading {
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .pot-container {
      padding: 0 16px;
    }

    .pot-mobile-arrow-down {
      position: absolute;
      right: 30px;
      top: 10px;
    }

    pot-mobile-arrow-up {
      position: absolute;
      right: 30px;
      bottom: 10px;
    }

    #shopify-section-{{ section.id }} .pot-body {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .pot-left-block { display: none; }

    #shopify-section-{{ section.id }} .pot-right-block {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .pot-title {
      font-size: 20px;
      line-height: 26px;
      margin-bottom: 4px;
    }

    #shopify-section-{{ section.id }} .pot-header {
      text-align: left;
      margin-bottom: 20px;
    }

    /*
      Mobile label rows: flex row, text + arrow, flush right.
      The label+arrow sit outside the card (above/below).
      Arrow is pinned 30px from the right edge of the container via padding-right.
    */
    #shopify-section-{{ section.id }} .pot-mobile-label {
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      width: 100%;
      gap: 6px;
      position: relative;
    }
    #shopify-section-{{ section.id }} .pot-mobile-label--top {
      align-items: flex-end;
      margin-bottom: 0;
    }
    #shopify-section-{{ section.id }} .pot-mobile-label--bottom {
      align-items: flex-start;
      margin-top: 0;
    }
    #shopify-section-{{ section.id }} .pot-mobile-label__text {
      font-weight: 700;
      font-size: 16px;
      line-height: 24px;
      color: #393940;
      white-space: nowrap;
      margin-top: 12px;
      margin-bottom: 12px;
      margin-right: 48px;
    }
    /* Arrow SVGs: shown on mobile, height set by JS */
    #shopify-section-{{ section.id }} .pot-mobile-arrow-svg {
      display: block;
      flex-shrink: 0;
      width: 14px;
    }
  }
{%- endstyle -%}

<div class="pot-section">
  <div class="pot-container">

    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="pot-header">
        {%- if section.settings.title != blank -%}
          <h2 class="pot-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="pot-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pot-body">

      {%- comment %} ── LEFT BLOCK (desktop only) ── {% endcomment -%}
      <div class="pot-left-block" id="potLeftBlock-{{ section.id }}">

        {%- for block in section.blocks -%}
          {%- if block.type == 'label_shoppay' -%}
            <div class="pot-label" id="labelShopPay-{{ section.id }}">
              <span class="pot-label__text">{{ block.settings.label_text }}</span>
              <span class="pot-label__arrow pot-label__arrow--right">
                <svg width="35" height="14" viewBox="0 0 35 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M27.2197 0.21967C27.5126 -0.0732232 27.9874 -0.0732232 28.2803 0.21967L34.2803 6.21967C34.5731 6.51257 34.5731 6.98736 34.2803 7.28022L28.2803 13.2802C27.9874 13.573 27.5126 13.573 27.2197 13.2802C26.9269 12.9874 26.9269 12.5126 27.2197 12.2197L31.9395 7.49994H0.75C0.335857 7.49994 0.000114441 7.16406 0 6.74994C0 6.33573 0.335787 5.99994 0.75 5.99994H31.9395L27.2197 1.28022C26.9269 0.987358 26.9269 0.512571 27.2197 0.21967Z" fill="#F1592A"/>
                </svg>
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="pot-or-divider" id="potOrDivider-{{ section.id }}">or</div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'label_affirm' -%}
            <div class="pot-label" id="labelAffirm-{{ section.id }}">
              <span class="pot-label__text">{{ block.settings.label_text }}</span>
              <span class="pot-label__arrow pot-label__arrow--right">
                <svg width="35" height="14" viewBox="0 0 35 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M27.2197 0.21967C27.5126 -0.0732232 27.9874 -0.0732232 28.2803 0.21967L34.2803 6.21967C34.5731 6.51257 34.5731 6.98736 34.2803 7.28022L28.2803 13.2802C27.9874 13.573 27.5126 13.573 27.2197 13.2802C26.9269 12.9874 26.9269 12.5126 27.2197 12.2197L31.9395 7.49994H0.75C0.335857 7.49994 0.000114441 7.16406 0 6.74994C0 6.33573 0.335787 5.99994 0.75 5.99994H31.9395L27.2197 1.28022C26.9269 0.987358 26.9269 0.512571 27.2197 0.21967Z" fill="#F1592A"/>
                </svg>
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>

      {%- comment %} ── RIGHT BLOCK ── {% endcomment -%}
      <div class="pot-right-block">

        {%- comment %} Mobile: Shop Pay label ABOVE card {% endcomment -%}
        <div class="pot-mobile-label pot-mobile-label--top" id="potMobileLabelTop-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'label_shoppay' -%}
              <span class="pot-mobile-label__text" id="potMobileTextTop-{{ section.id }}">{{ block.settings.label_text }}</span>
              <svg class="pot-mobile-arrow-svg pot-mobile-arrow-down" id="potMobileArrowDown-{{ section.id }}"
                   width="14" viewBox="0 0 14 126" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13.2803 118.22C13.573 118.513 13.573 118.987 13.2803 119.28L7.28027 125.28C6.98742 125.573 6.5126 125.573 6.21972 125.28L0.219721 119.28C-0.0730338 118.987 -0.0730566 118.513 0.219721 118.22C0.512585 117.927 0.987405 117.927 1.28027 118.22L5.99999 122.939L6 0.75C6 0.335786 6.33579 -2.53553e-07 6.75 -2.95052e-07C7.16418 4.48954e-05 7.5 0.335814 7.5 0.75L7.49999 122.939L12.2197 118.22C12.5126 117.927 12.9874 117.927 13.2803 118.22Z" fill="#F1592A"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pot-card" id="potCard-{{ section.id }}">
          <p class="pot-card__heading">
            {%- for block in section.blocks -%}
              {%- if block.type == 'card_title' -%}{{ block.settings.card_title }}{%- endif -%}
            {%- endfor -%}
          </p>

          <ul class="pot-payment-list">
            {%- assign option_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'payment_option' -%}
                {%- assign item_id = '' -%}
                {%- if block.settings.highlighted -%}
                  {%- if option_index == 0 -%}
                    {%- assign item_id = 'potItemShopPay-' | append: section.id -%}
                  {%- else -%}
                    {%- assign item_id = 'potItemAffirm-' | append: section.id -%}
                  {%- endif -%}
                  {%- assign option_index = option_index | plus: 1 -%}
                {%- endif -%}
                <li class="pot-payment-item{% if block.settings.highlighted %} pot-payment-item--highlighted{% endif %}"
                    {%- if item_id != '' %} id="{{ item_id }}"{% endif -%}>
                  <span class="pot-radio{% if block.settings.highlighted %} pot-radio--active{% endif %}">
                    {%- if block.settings.highlighted -%}<span class="pot-radio__dot"></span>{%- endif -%}
                  </span>
                  <span>{{ block.settings.option_text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        {%- comment %} Mobile: Affirm label BELOW card {% endcomment -%}
        <div class="pot-mobile-label pot-mobile-label--bottom" id="potMobileLabelBottom-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'label_affirm' -%}
              <span class="pot-mobile-label__text" id="potMobileTextBottom-{{ section.id }}">{{ block.settings.label_text }}</span>
              <svg class="pot-mobile-arrow-svg pot-mobile-arrow-up" id="potMobileArrowUp-{{ section.id }}"
                   width="14" viewBox="0 0 14 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.219723 7.28003C-0.0730703 6.98717 -0.0730367 6.51236 0.219723 6.21948L6.21972 0.219482C6.51261 -0.0732196 6.98743 -0.0732959 7.28027 0.219482L13.2803 6.21948C13.573 6.51232 13.5729 6.98716 13.2803 7.28003C12.9874 7.57278 12.5126 7.57278 12.2197 7.28003L7.5 2.5603L7.5 88.7498C7.5 89.1639 7.16416 89.4997 6.75 89.4998C6.33579 89.4998 6 89.164 6 88.7498L6 2.5603L1.28027 7.28003C0.987406 7.57278 0.512587 7.57278 0.219723 7.28003Z" fill="#F1592A"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>

    </div>

    {%- if section.settings.bottom_text != blank -%}
      <div class="pot-footer">
        <p class="pot-footer__text"
           style="background-color:{{ section.settings.bottom_bg_color }};border-color:{{ section.settings.bottom_border_color }};">
          {{ section.settings.bottom_text }}
        </p>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
(function() {
  var sid = '{{ section.id }}';

  function gel(prefix) {
    return document.getElementById(prefix + '-' + sid);
  }

  function alignDesktop() {
    if (window.innerWidth <= 749) return;

    var leftBlock   = gel('potLeftBlock');
    var card        = gel('potCard');
    var itemShopPay = gel('potItemShopPay');
    var itemAffirm  = gel('potItemAffirm');
    var lblShopPay  = gel('labelShopPay');
    var lblAffirm   = gel('labelAffirm');
    var orDiv       = gel('potOrDivider');

    if (!leftBlock || !card || !itemShopPay || !itemAffirm) return;

    var leftTop = leftBlock.getBoundingClientRect().top;
    var cardH   = card.getBoundingClientRect().height;
    var spRect  = itemShopPay.getBoundingClientRect();
    var afRect  = itemAffirm.getBoundingClientRect();

    leftBlock.style.height = cardH + 'px';

    var spMid = (spRect.top + spRect.height / 2) - leftTop;
    var afMid = (afRect.top + afRect.height / 2) - leftTop;

    if (lblShopPay) lblShopPay.style.top = spMid + 'px';
    if (lblAffirm)  lblAffirm.style.top  = afMid + 'px';
    if (orDiv)      orDiv.style.top      = ((spMid + afMid) / 2) + 'px';
  }

  function scaleMobileArrows() {
    if (window.innerWidth > 749) return;

    var textTop     = gel('potMobileTextTop');
    var textBot     = gel('potMobileTextBottom');
    var arrowDown   = gel('potMobileArrowDown');
    var arrowUp     = gel('potMobileArrowUp');
    var itemShopPay = gel('potItemShopPay');
    var itemAffirm  = gel('potItemAffirm');

    if (!textTop || !textBot || !arrowDown || !arrowUp || !itemShopPay || !itemAffirm) return;

    /* Hide arrows during measurement so they don't skew rects */
    arrowDown.style.display = 'none';
    arrowUp.style.display   = 'none';

    var textTopRect = textTop.getBoundingClientRect();
    var spRect      = itemShopPay.getBoundingClientRect();
    var afRect      = itemAffirm.getBoundingClientRect();
    var textBotRect = textBot.getBoundingClientRect();

    /*
      DOWN arrow
      Starts at: bottom of "Select Shop Pay" text
      Ends at:   vertical midpoint of Shop Pay highlighted row
    */
    var downH = Math.max(Math.round((spRect.top + spRect.height / 2) - textTopRect.bottom), 10);

    /*
      UP arrow
      Starts at: vertical midpoint of Affirm highlighted row
      Ends at:   top of "Select Affirm" text
    */
    var upH = Math.max(Math.round(textBotRect.top - (afRect.top + afRect.height / 2)), 10);

    /* Restore and apply heights */
    arrowDown.style.display = 'block';
    arrowDown.setAttribute('height', downH);
    arrowDown.style.height  = downH + 'px';

    arrowUp.style.display = 'block';
    arrowUp.setAttribute('height', upH);
    arrowUp.style.height  = upH + 'px';

    /* Vertical alignment within flex rows */
    textTop.style.alignSelf   = 'flex-end';
    arrowDown.style.alignSelf = 'flex-start';

    textBot.style.alignSelf = 'flex-start';
    arrowUp.style.alignSelf = 'flex-end';
  }

  function runAll() {
    alignDesktop();
    scaleMobileArrows();
  }

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(runAll);
  } else {
    window.addEventListener('load', runAll);
  }

  window.addEventListener('resize', runAll);
})();
</script>

{% schema %}
{
  "name": "Pay Over Time",
  "tag": "section",
  "class": "section-pay-over-time",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "WHERE DO I CLICK TO PAY OVER TIME?"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "At checkout, look for these two payment options:"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Bottom Note"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Note Text",
      "default": "Shop Pay Installments is selected inside Shop Pay. Affirm is selected separately."
    },
    {
      "type": "color",
      "id": "bottom_bg_color",
      "label": "Bottom Note Background Color",
      "default": "#fef3ef"
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Bottom Note Border Color",
      "default": "#F1592A"
    }
  ],
  "blocks": [
    {
      "type": "label_shoppay",
      "name": "Shop Pay Label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_text",
          "label": "Label Text",
          "default": "Select Shop Pay"
        }
      ]
    },
    {
      "type": "label_affirm",
      "name": "Affirm Label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_text",
          "label": "Label Text",
          "default": "Select Affirm"
        }
      ]
    },
    {
      "type": "card_title",
      "name": "Payment Card Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "Payment"
        }
      ]
    },
    {
      "type": "payment_option",
      "name": "Payment Option",
      "settings": [
        {
          "type": "text",
          "id": "option_text",
          "label": "Option Text",
          "default": "Payment Option"
        },
        {
          "type": "checkbox",
          "id": "highlighted",
          "label": "Highlight this option",
          "default": false,
          "info": "Adds orange border and filled radio button. First highlighted = Shop Pay, second = Affirm."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pay Over Time",
      "blocks": [
        { "type": "label_shoppay", "settings": { "label_text": "Select Shop Pay" } },
        { "type": "label_affirm",  "settings": { "label_text": "Select Affirm"   } },
        { "type": "card_title",    "settings": { "card_title": "Payment"          } },
        { "type": "payment_option", "settings": { "option_text": "Credit / Debit Card",                          "highlighted": false } },
        { "type": "payment_option", "settings": { "option_text": "Shop Pay - Pay in full or in installments",    "highlighted": true  } },
        { "type": "payment_option", "settings": { "option_text": "PayPal",                                       "highlighted": false } },
        { "type": "payment_option", "settings": { "option_text": "Affirm - Pay over time",                       "highlighted": true  } },
        { "type": "payment_option", "settings": { "option_text": "Amazon Pay",                                   "highlighted": false } }
      ]
    }
  ]
}
{% endschema %}