{% stylesheet %}
.browse-by-category {
  padding: 40px 0;
}
.category-tabs {
  display: flex;
  gap: 24px;
  margin-bottom: 0px;
  flex-wrap: wrap;
}

  .category-tabs button.active{
    font-weight: 700;
  }


.category-tabs button {
  position: relative;
  padding-bottom: 8px; 
  background: transparent;
  font-weight: 400;
  text-align: center;
  vertical-align: middle;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-family: Lato;
  border: none;
  cursor: pointer;
}

.category-tabs button.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 4px;
  width: 100%;
  background-color: #F1592A;
  border-radius: 4px;
}

  
.category-tab-content {
  display: none;
}
.category-tab-content.active {
  display: block;
}
.category-card {
  text-align: center;
  background: #f6f7fb;
  padding: 24px 34px;
  padding-bottom: 24px !important;
  border-radius: 20px;
  margin: 8px;
}
.category-card img {
  width: 120px;
  height: 120px;
  object-fit: contain;
  background: transparent;
  display: block;
  margin: 0 auto 10px;
}

.category-card p {
  font-family: Lato;
font-weight: 700;
font-size: 20px;
line-height: 26px;
  margin: 0px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

}

.tab-header{
  display: flex;
    align-items: center;
    justify-content: space-between;
}

  .slick-prev {
    left: 25px!important;
    z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .slick-next {
    right: 25px!important;
     z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .tab-header h2{
    margin-left: 8px;
  }

  @media (max-width: 1050px) {

    .tab-header{
      display: block;
    }

    .tab-header h2 {
    margin-left: auto;
    margin-bottom: 20px;
}
  }
{% endstylesheet %}

<div class="browse-by-category">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign tab_data = "" %}
  {% assign separator = "" %}
  {% for block in section.blocks %}
    {% if block.settings.tab_handle != blank %}
      {% assign handle = block.settings.tab_handle | handleize %}
      {% unless tab_data contains handle %}
        {% capture tab_data %}{{ tab_data }}{{ separator }}{{ handle }}::{{ block.settings.tab_title }}{% endcapture %}
        {% assign separator = "|" %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% assign tab_list = tab_data | split: "|" | compact %}

  <div class="category-tabs">
    {% for tab in tab_list %}
      {% assign parts = tab | split: "::" %}
      {% assign handle = parts[0] %}
      {% assign title = parts[1] %}
      <button type="button" class="{% if forloop.first %}active{% endif %}" data-tab="tab-{{ handle }}">
        {{ title }}
      </button>
    {% endfor %}
  </div>
</div>
  
  {% for tab in tab_list %}
    {% assign parts = tab | split: "::" %}
    {% assign handle = parts[0] %}
    <div class="category-tab-content {% if forloop.first %}active{% endif %}" id="tab-{{ handle }}">
      <div class="slider-tab-{{ handle }}">
        {% for block in section.blocks %}
          {% assign card_handle = block.settings.tab_handle | handleize %}
          {% if card_handle == handle %}
            <div class="category-card">
              <a href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title }}">
                {% endif %}
                {% if block.settings.title != blank %}
                  <p>{{ block.settings.title }}</p>
                {% endif %}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>

{% javascript %}
 document.addEventListener("DOMContentLoaded", function () {
  const firstTab = document.querySelector('.category-tab-content.active');
  const firstSlider = firstTab.querySelector('[class*="slider-tab-"]');

  $(firstSlider).on('setPosition', function () {
    setEqualCardHeights(firstTab);
  });

  $(firstSlider).slick({
    slidesToShow: 5,
    slidesToScroll: 1,
    arrows: true,
    infinite: false,
    responsive: [
      { breakpoint: 1300, settings: { slidesToShow: 4 }},
      { breakpoint: 1024, settings: { slidesToShow: 3 }},
      { breakpoint: 989,  settings: { slidesToShow: 2 }}
    ]
  });

  function setEqualCardHeights(container) {
    const cards = container.querySelectorAll('.category-card');
    let maxHeight = 0;
    cards.forEach(card => card.style.minHeight = 'auto');
    cards.forEach(card => {
      const height = card.offsetHeight;
      if (height > maxHeight) maxHeight = height;
    });
    cards.forEach(card => card.style.minHeight = `${maxHeight}px`);
  }

  document.querySelectorAll(".category-tabs button").forEach(button => {
    button.addEventListener("click", function () {
      const tabId = this.getAttribute("data-tab");

      document.querySelectorAll(".category-tabs button").forEach(btn => btn.classList.remove("active"));
      this.classList.add("active");

      document.querySelectorAll(".category-tab-content").forEach(tab => tab.classList.remove("active"));
      const targetTab = document.getElementById(tabId);
      targetTab.classList.add("active");

      const targetSlider = targetTab.querySelector('[class*="slider-tab-"]');
      if ($(targetSlider).hasClass('slick-initialized')) {
        $(targetSlider).slick('unslick');
      }

      $(targetSlider).on('setPosition', function () {
        setEqualCardHeights(targetTab);
      });

      $(targetSlider).slick({
        slidesToShow: 5,
        slidesToScroll: 1,
        arrows: true,
        infinite: false,
        responsive: [
          { breakpoint: 1300, settings: { slidesToShow: 4 }},
          { breakpoint: 1024, settings: { slidesToShow: 3 }},
          { breakpoint: 989,  settings: { slidesToShow: 2 }}
        ]
      });
    });
  });
});

{% endjavascript %}


{% schema %}
{
  "name": "Browse by Brand",
  "class": "browse-by-brand",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Browse by Category"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "tab_handle",
          "label": "Tab Handle (e.g. cardio)",
          "default": "cardio"
        },
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Cardio Equipment"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse by Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}
