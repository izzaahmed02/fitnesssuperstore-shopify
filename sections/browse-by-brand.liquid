{{ 'browse-by-brand.css' | asset_url | stylesheet_tag }}

<div class="browse-by-brand">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="category-tabs">
             <a href="{{ section.settings.url }}"
               class="homepage-brands__button button button--secondary">
                {{ section.settings.label }}
                {% render 'chevron-button' %}
            </a>
  </div>
</div>
  
 
    <div class="category-tab-content">     
        {% for block in section.blocks %}  
      <div class="main-card">
            <div class="category-card">
              <a href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img class="brand-image" src="{{ block.settings.image | image_url }}" alt="">
                {% endif %}
              </a>
            </div>

             <a href="{{ block.settings.link }}">
                {% if block.settings.logo != blank %}
                 <img class="brand-logo" src="{{ block.settings.logo | image_url }}" alt="">
                {% endif %}
              </a>  
          </div>
        {% endfor %}
      </div>
</div>

<script src="{{ 'browse-by-brand.js' | asset_url }}" defer="defer"></script>


{% schema %}
{
  "name": "Browse by Brand",
  "class": "browse-brand",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Browse by Brand"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
     {
      "type": "url",
      "id": "url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
       
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse by Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}
