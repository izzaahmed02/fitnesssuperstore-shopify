{% stylesheet %}

.browse-brand {
  background: #FAF9F9;
}
  
.browse-brand .browse-by-brand {
   padding: 60px 16px;
}
.browse-brand .category-tabs {
  display: flex;
  gap: 24px;
  margin-bottom: 0px;
  flex-wrap: wrap;
}

  .browse-brand .category-tabs button.active{
    font-weight: 700;
  }


.browse-brand .category-tabs button {
  position: relative;
  padding-bottom: 8px; 
  background: transparent;
  font-weight: 400;
  text-align: center;
  vertical-align: middle;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-family: Lato;
  border: none;
  cursor: pointer;
}

.browse-brand .category-tabs button.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 4px;
  width: 100%;
  background-color: #F1592A;
  border-radius: 4px;
}

 .browse-brand .main-card {
  text-align: center;
  background: #FFFFFF;

  border-radius: 20px;
  margin: 8px;
} 

.browse-brand .category-card {
  
 
  padding: 24px 34px 0px 34px;
 

}
.browse-brand .category-card .brand-image {
  width: 141px;
  height: 183px;
  object-fit: contain;
  background: transparent;
  display: block;
  margin: 0;
}

  .browse-brand .main-card .brand-logo {
  width: 100%;
    margin-bottom: 24px;
}

.browse-brand .category-card p {
  font-family: Lato;
font-weight: 700;
font-size: 20px;
line-height: 26px;
  margin: 0px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

}

.browse-brand .tab-header{
  display: flex;
    align-items: center;
    justify-content: space-between;
  margin-bottom: 52px;
  padding-right: 8px;
}

  .browse-brand .slick-prev {
    left: 25px!important;
    z-index: 1;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .browse-brand .slick-next {
    right: 25px!important;
     z-index: 1;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .browse-brand .tab-header h2{
    margin-left: 8px;
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (max-width: 1050px) {

    .browse-brand .tab-header{
      display: block;
    }

    .browse-brand .tab-header h2 {
    margin-left: auto;
    margin-bottom: 20px;
}
  }
{% endstylesheet %}

<div class="browse-by-brand">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}


  <div class="category-tabs">
   
             <a href="{{ section.settings.url }}"
               class="homepage-brands__button button button--secondary">
                {{ section.settings.label }}
                {% render 'chevron-button' %}
            </a>

  </div>
</div>
  
 
    <div class="category-tab-content">     
        {% for block in section.blocks %}  
      <div class="main-card">
            <div class="category-card">
              <a href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img class="brand-image" src="{{ block.settings.image | image_url }}" alt="">
                {% endif %}
              </a>
            </div>

             <a href="{{ block.settings.link }}">
                {% if block.settings.logo != blank %}
                 <img class="brand-logo" src="{{ block.settings.logo | image_url }}" alt="">
                {% endif %}
              </a>  
          </div>
        {% endfor %}
      </div>
</div>

{% javascript %}
$('.browse-brand .category-tab-content').slick({
  dots: false,
  infinite: false,
  slidesToShow: 5,
  slidesToScroll: 1,
   responsive: [
      { breakpoint: 1300, settings: { slidesToShow: 4 }},
      { breakpoint: 1024, settings: { slidesToShow: 3 }},
      { breakpoint: 989,  settings: { slidesToShow: 2 }}
    ]
});
	
{% endjavascript %}


{% schema %}
{
  "name": "Browse by Brand",
  "class": "browse-brand",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Browse by Brand"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
     {
      "type": "url",
      "id": "url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
       
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse by Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}
