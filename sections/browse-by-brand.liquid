{% stylesheet %}
.browse-by-category {
  padding: 40px 0;
}
.category-tabs {
  display: flex;
  gap: 24px;
  margin-bottom: 0px;
  flex-wrap: wrap;
}

  .category-tabs button.active{
    font-weight: 700;
  }


.category-tabs button {
  position: relative;
  padding-bottom: 8px; 
  background: transparent;
  font-weight: 400;
  text-align: center;
  vertical-align: middle;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-family: Lato;
  border: none;
  cursor: pointer;
}

.category-tabs button.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 4px;
  width: 100%;
  background-color: #F1592A;
  border-radius: 4px;
}

  
.category-tab-content {
  display: none;
}
.category-tab-content.active {
  display: block;
}
.category-card {
  text-align: center;
  background: #f6f7fb;
  padding: 24px 34px;
  padding-bottom: 24px !important;
  border-radius: 20px;
  margin: 8px;
}
.category-card img {
  width: 120px;
  height: 120px;
  object-fit: contain;
  background: transparent;
  display: block;
  margin: 0 auto 10px;
}

.category-card p {
  font-family: Lato;
font-weight: 700;
font-size: 20px;
line-height: 26px;
  margin: 0px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

}

.tab-header{
  display: flex;
    align-items: center;
    justify-content: space-between;
}

  .slick-prev {
    left: 25px!important;
    z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .slick-next {
    right: 25px!important;
     z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .tab-header h2{
    margin-left: 8px;
  }

  @media (max-width: 1050px) {

    .tab-header{
      display: block;
    }

    .tab-header h2 {
    margin-left: auto;
    margin-bottom: 20px;
}
  }
{% endstylesheet %}

<div class="browse-by-category">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}


  <div class="category-tabs">
   
      <button type="button" class="">
        All Brands
      </button>

  </div>
</div>
  
 
    <div class="category-tab-content">     
        {% for block in section.blocks %}         
            <div class="category-card">
              <a href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title }}">
                {% endif %}
                {% if block.settings.logo != blank %}
                 <img src="{{ block.settings.logo | image_url: 'original' }}" alt="{{ block.settings.title }}">
                {% endif %}
              </a>
            </div>
        
        {% endfor %}
      </div>
</div>

{% javascript %}
$('.category-tab-content').slick({
  dots: false,
  infinite: false,
  slidesToShow: 5,
  slidesToScroll: 1,
  responsive: [
    {
      breakpoint: 1024,
      settings: {
        slidesToShow: 4,
        infinite: true,
        dots: true
      }
    },
    {
      breakpoint: 600,
      settings: {
        slidesToShow: 2,
        slidesToScroll: 2
      }
    },
    {
      breakpoint: 480,
      settings: {
        slidesToShow: 1,
        slidesToScroll: 1
      }
    }
  ]
});
	
{% endjavascript %}


{% schema %}
{
  "name": "Browse by Brand",
  "class": "browse-by-brand",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Browse by Category"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "tab_handle",
          "label": "Tab Handle (e.g. cardio)",
          "default": "cardio"
        },
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Cardio Equipment"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse by Brand",
      "category": "Custom"
    }
  ]
}
{% endschema %}
