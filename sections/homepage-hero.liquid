                                stroke-linecap="round"
                        />
                    </svg>
                </div>
                <span class="homepage-hero__rating-label">{{ section.settings.rating_label }}</span>
            </div>
            <h1>
              <span class="homepage-hero__title desktop">{{ section.settings.title }}</span>
              <span class="homepage-hero__title mobile">{{ section.settings.mobiletitle }}</span>
            </h1>
            <a href="{{ section.settings.url }}"
               class="homepage-hero__button button button--secondary">{{ section.settings.label }} {% render 'chevron-button' %}</a>
        </div>
    </div>
</div>

<script src="{{ 'custom-rating.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section homepage-hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "img_desk",
      "label": "Background Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "img_mob",
      "label": "Background Image Mobile"
    },
    {
      "type": "text",
      "id": "rating",
      "default": "1.7",
      "label": "Rating Value"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating Label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "mobiletitle",
      "label": "Section Mobile Title"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
    {
      "type": "text",
      "id": "url",
      "label": "Section Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
