{{ 'homepage-hero.css' | asset_url | stylesheet_tag }}

<div class="homepage-hero__wrapper">
    <div class="homepage-hero__img-wrapper">
      {{ section.settings.img_mob | image_url: width: 749, height: 600, crop: "center" | image_tag: class: 'homepage-hero__img homepage-hero__img--mob',
        alt: section.settings.img_mob.alt,
        sizes:'(max-height: 415px) 415px, (max-height: 575px) 575px',
        width: '575',
        widths: '352, 575',
        loading: 'eager', 
        preload: true, 
        fetchpriority: "high" 
      }}
      {{ section.settings.img_desk | image_url: width: 1920, height: 600 | image_tag: class: 'homepage-hero__img homepage-hero__img--desk',
        alt: section.settings.img_desk.alt,
        sizes:'100vw',
        width: section.settings.img_desk.width,
        widths: '832, 1200, 1920',
        loading: 'eager', 
        preload: true, 
        fetchpriority: "high" 
      }}
    </div>

    <div class="homepage-hero__content">
        <div class="page-width">
