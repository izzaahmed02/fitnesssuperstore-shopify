{{ 'homepage-hero.css' | asset_url | stylesheet_tag }}

<div class="homepage-hero__banner">
    <div class="homepage-hero__banner__item">USA & Worldwide shipping</div>
    <div class="homepage-hero__banner__item">Shop for new & remanufactured Fitness equipment</div>
</div>

<div class="homepage-hero__wrapper">
    <a href="{{ section.settings.url }}" class="homepage-hero__img-wrapper">
        {{ section.settings.img_desk | image_url: width: 1920, height: 600 | image_tag: class: 'homepage-hero__img homepage-hero__img--desk', loading: 'eager' }}
        {{ section.settings.img_mob | image_url: width: 749, height: 600 | image_tag: class: 'homepage-hero__img homepage-hero__img--mob', loading: 'eager' }}
    </a>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section homepage-hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "img_desk",
      "label": "Background Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "img_mob",
      "label": "Background Image Mobile"
    },
    {
      "type": "text",
      "id": "rating",
      "default": "1.7",
      "label": "Rating Value"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating Label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "mobiletitle",
      "label": "Section Mobile Title"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
    {
      "type": "text",
      "id": "url",
      "label": "Section Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
