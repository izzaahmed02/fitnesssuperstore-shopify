{% comment %}
Related posts — pick up to 3 individual articles.
Now includes author name and published date.
{% endcomment %}

<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-blog-sec"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2 class="section-header__title center">{{ section.settings.heading }}</h2>
         {% unless section.settings.subheading == blank %}
        <h3 class="section-header__subheading center">{{ section.settings.subheading }}</h3>
         {% endunless %}
          {% unless section.settings.intro == blank %}
        <p class="section-header__intro center">{{ section.settings.intro }}</p>
          {% endunless %}
      </div>
    {% endif %}

    <div class="grid grid--1-col grid--2-col-tablet grid--3-col-desktop">
      {%- for i in (1..3) -%}
        {% assign article_setting = 'article_' | append: i %}
        {% assign art_handle = section.settings[article_setting] %}
        {% if art_handle != blank %}
          {% assign article = articles[art_handle] %}
          {% if article %}
            <article class="grid__item">
              <div class="card-wrapper">
                <a href="{{ article.url }}" class="card">
                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      />
                    </div>
                  {% endif %}
                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                    {% if article.author or article.published_at %}
                      <p class="card__meta publish-info" style="font-size: 0.9em; color: var(--color-foreground-secondary); margin-bottom: 0.5em;">
                        <span>
                        {% if article.published_at %}
                          {% if article.author %}  {% endif %}
                          {{ article.published_at | date: "%b %d, %Y" }}
                        {% endif %}
                      </span>
                      <span>
                        {% if article.author %} {{ article.author }}{% endif %}
                      </span>
                      </p>
                    {% endif %}

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </div>
            </article>
          {% endif %}
        {% endif %}
      {%- endfor -%}
    </div>

    {% unless section.settings.article_1 or section.settings.article_2 or section.settings.article_3 %}
      <p class="note" style="margin-top:12px;">No articles selected. Use the section settings to choose up to 3 articles.</p>
    {% endunless %}
  </div>

  {% if section.settings.label %}
  <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}"
           class="rich-text-custom__btn">{{ section.settings.label }} {% render 'chevron-right' %}</a>
</div>
{% endif %}

  <style>
    /* optional: ensure consistent image aspect */
    #RelatedBlogs-{{ section.id }} .card__media { aspect-ratio: 16/9; overflow: hidden; }
    #RelatedBlogs-{{ section.id }} .card__image { width: 100%; height: 100%; object-fit: cover; display:block; }
    .related-articles .card__media { position:relative; }
    .publish-info { display:flex; justify-content:space-between;}

  #RelatedBlogs-{{ section.id }} .publish-info span { margin-bottom: 12px; font-family: Lato; font-size: 12px; line-height: 18px; color: gray; text-transform: none; letter-spacing: .13rem;}
  #RelatedBlogs-{{ section.id }} .link {color: #D83D0E;}

  #RelatedBlogs-{{ section.id }} h1 {
  text-transform: uppercase;
}
#RelatedBlogs-{{ section.id }} h3 {
font-size:18px;
line-heigth:24px;
}

  .rich-text-custom__wrapper {
    margin-top:24px;
  display: flex;
  justify-content:center;
  align-items:center;
}
  .rich-text-custom__btn {
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    background-color:#D83D0E;
    padding: 12px 24px;
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    border: none;
    box-shadow: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media screen and (max-width: 767px){
  .related-blog-sec {
  padding-top: 0px !important;
  padding-bottom: 0px !important;
  }
  }

  .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .related-articles .section-header {
      position: unset;
    }

    .card__heading {
      font-size: 18px;
      line-height: 24px;
      margin-bottom: 8px;
    }

    .publish-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 12px;
      color: #777;
      letter-spacing: 0.08em;
    }

    .card__excerpt {
      font-size: 14px;
      line-height: 22px;
      margin-bottom: 12px;
    }

    .link {
      color: #D83D0E;
      font-weight: 600;
    }

    /* Bottom bar */
    .related-slider__bottom {
      margin-top: 16px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
    }

    .related-slider__scrollbar {
      position: relative;
      width: 100%;
      height: 6px;
      background: #eee;
      border-radius: 6px;
      cursor: pointer;
    }

    .scroll-thumb {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 40px;
      background: #D83D0E;
      border-radius: 6px;
      transition: none; /* no delay during drag */
    }

    .related-slider__arrows {
      display: flex;
      gap: 8px;
    }

    .related-slider__arrows .arrow {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      background: #fff;
      cursor: pointer;
    }

    .rich-text-custom__wrapper {
      margin-top: 32px;
      display: flex;
      justify-content: center;
    }

    .rich-text-custom__btn {
      padding: 12px 24px;
      background: #D83D0E;
      color: #fff;
      border-radius: 8px;
      font-weight: 700;
      text-decoration: none;
    }

    .related-slider__arrows .arrow.disabled {
      opacity: 0.4;
      pointer-events: none;
      cursor: default;
    }

  </style>
</section>

{% schema %}
{
  "name": "Related Blog posts",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "article_1",
      "type": "article",
      "label": "Article 1"
    },
    {
      "id": "article_2",
      "type": "article",
      "label": "Article 2"
    },
    {
      "id": "article_3",
      "type": "article",
      "label": "Article 3"
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Related Blog posts",
      "category": "Blog"
    }
  ]
}
{% endschema %}
