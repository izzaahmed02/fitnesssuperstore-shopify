{{ 'slider-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.3 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.3 | round }}px;
    }
  }
{%- endstyle -%}

<div class="page-width">
  <h2 class="slider-section-heading">{{ section.settings.title }}</h2>

  <div class="slider-section-container">
    <div class="slider-arrow-prev arrow-prev-{{ section.id }}">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="20" fill="#616166"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M17.8056 14.4697C18.0985 14.1768 18.5734 14.1768 18.8663 14.4697L23.8663 19.4697C24.1592 19.7626 24.1592 20.2374 23.8663 20.5303L18.8663 25.5303C18.5734 25.8232 18.0985 25.8232 17.8056 25.5303C17.5127 25.2374 17.5127 24.7626 17.8056 24.4697L22.2753 20L17.8056 15.5303C17.5127 15.2374 17.5127 14.7626 17.8056 14.4697Z" fill="white"/>
      </svg>
    </div>

    <div class="slider-section-{{ section.id }}">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="slider__slide">
          <img
            src="{{ block.settings.image | image_url }}"
            alt="{{ block.settings.image.alt | escape }}"
            width=""
            height=""
          >
          <p class="slider__slide--text">{{ block.settings.text }}</p>
        </a>
      {% endfor %}
    </div>

    <div class="slider-arrow-next arrow-next-{{ section.id }}">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="20" fill="#616166"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M17.8056 14.4697C18.0985 14.1768 18.5734 14.1768 18.8663 14.4697L23.8663 19.4697C24.1592 19.7626 24.1592 20.2374 23.8663 20.5303L18.8663 25.5303C18.5734 25.8232 18.0985 25.8232 17.8056 25.5303C17.5127 25.2374 17.5127 24.7626 17.8056 24.4697L22.2753 20L17.8056 15.5303C17.5127 15.2374 17.5127 14.7626 17.8056 14.4697Z" fill="white"/>
      </svg>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', (event) => {
    $('.slider-section-{{ section.id }}').slick({
      prevArrow: '.arrow-prev-{{ section.id }}',
      nextArrow: '.arrow-next-{{ section.id }}',
      infinite: false,
      slidesToScroll: 1,
      slidesToShow: 5,
      swipeToSlide: true,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 4,
            dots: false,
          },
        },
        {
          breakpoint: 750,
          settings: {
            slidesToShow: 2.2,
            dots: true,
          },
        },
      ],
    });
  });
</script>

{% schema %}
{
  "name": "Slider section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "header",
      "content": "Section paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Block link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider section"
    }
  ]
}
{% endschema %}
