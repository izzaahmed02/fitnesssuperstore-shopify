{%- style -%}
  #shopify-section-{{ section.id }} .quick-links-trusthub {
    {% if section.settings.bg != blank %}background-color: {{ section.settings.bg }};{% endif %}
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .quick-links-trusthub__row {
    display: flex;
    gap: 10px;
    align-items: stretch;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px 16px;
    margin: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .quick-links-trusthub__row::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .quick-links-trusthub__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    flex: 0 0 auto;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.chip_border }};
    background-color: {{ section.settings.chip_bg }};
    color: {{ section.settings.chip_text }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  #shopify-section-{{ section.id }} .quick-links-trusthub__chip:hover {
    background-color: {{ section.settings.chip_bg_hover }};
    color: {{ section.settings.chip_text_hover }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .quick-links-trusthub {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .quick-links-trusthub__row {
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
    }
  }
{%- endstyle -%}

<div class="quick-links-trusthub">
  {%- if section.blocks.size > 0 -%}
    <ul class="quick-links-trusthub__row" role="list" aria-label="{{ section.settings.aria_label | escape }}">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="quick-links-trusthub__chip"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          >
            {{- block.settings.label | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Quick Links Trust Hub",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Quick links"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Chip colors"
    },
    {
      "type": "color",
      "id": "chip_bg",
      "label": "Chip background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "chip_text",
      "label": "Chip text",
      "default": "#d83d0e"
    },
    {
      "type": "color",
      "id": "chip_border",
      "label": "Chip border",
      "default": "#d83d0e"
    },
    {
      "type": "color",
      "id": "chip_bg_hover",
      "label": "Chip background (hover)",
      "default": "#d83d0e"
    },
    {
      "type": "color",
      "id": "chip_text_hover",
      "label": "Chip text (hover)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Quick Links Trust Hub",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
