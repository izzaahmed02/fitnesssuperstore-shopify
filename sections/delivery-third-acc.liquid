<style>
    .delivery-third-acc .delivery-first-acc__copy li:before {
        content: '';
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: url("{{ "Check.svg" | asset_url }}") center center no-repeat;
        display: block;
        width: 24px;
        height: 24px;
    }

    .delivery-third-acc .accordion-content-inner ul li:first-child:before {
        content: '';
        position: absolute;
        width: 24px;
        height: 24px;
        background: url("{{ "Pin.svg" | asset_url }}") center center no-repeat;
        top: 0;
        left: -38px;
    }

    .delivery-third-acc .accordion-content-inner ul li:nth-child(2):before {
        content: '';
        position: absolute;
        width: 24px;
        height: 24px;
        background: url("{{ "time.svg" | asset_url }}") center center no-repeat;
        top: 0;
        left: -38px;
    }

    .delivery-third-acc .accordion-content-inner ul li:last-child:before {
        content: '';
        position: absolute;
        width: 24px;
        height: 24px;
        background: url("{{ "phone.svg" | asset_url }}") center center no-repeat;
        top: 0;
        left: -38px;
    }

    /* Re-apply all .accordion-header base styles to sub-accordion-header */
    .sub-accordion-header {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 100%;
        cursor: pointer;
        border: none;
        outline: none;
        text-align: left;
        font-size: 16px;
        transition: background-color 0.3s ease;
        padding: 12px;
        background-color: transparent;
        column-gap: 2px;
    }

    .sub-accordion-header .accordion-title {
        color: #D83D0E;
        font-size: 9px;
        line-height: 11px;
    }

    .sub-accordion-header .accordion-chevron {
        transform: rotate(180deg);
        transition: transform 0.3s ease;
        flex-shrink: 0;
    }

    .sub-accordion-header[aria-expanded="true"] .accordion-chevron {
        transform: rotate(0deg);
    }

    /* Sub-accordion open/close transition */
   
[id^="delivery-subpanel-"] {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.3s ease;
}

        
[id^="delivery-subpanel-"][aria-hidden="false"] {
  max-height: 600px;
}


  

    /* Border override for sub item */
    .delivery-accordion-item:has(> .sub-accordion-header[aria-expanded="true"]) {
        border: 1px solid #E5E5E5;
    }

    /* Image style inside sub-accordion */
    .delivery-accordion-item .sub-accordion-header ~ .accordion-content .accordion-content-image {
        border-radius: 0;
    }

    @media (max-width: 749px) {
        .sub-accordion-header {
            column-gap: 8px;
        }

        .delivery-accordion-item .sub-accordion-header ~ .accordion-content .accordion-content-image {
            min-height: 180px;
            object-fit: contain;
        }
    }
</style>
<div class="section-{{ section.id }} page-width scroll-trigger animate--slide-in">
    <div class="container">
        <div class="delivery-first-acc__wrapper">
            <div class="delivery-first-acc__content">
                <h2 class="delivery-first-acc__title">{{ section.settings.title }}</h2>
                <div class="delivery-first-acc__copy">
                    {{ section.settings.copy }}
                </div>
            </div>
            <div class="delivery-first-acc__accordions">
                {% for block in section.blocks %}
                    <div class="delivery-accordion-item">
                        <button
                                class="accordion-header"
                                type="button"
                                aria-expanded="false"
                                aria-controls="delivery-panel-{{ section.id }}-{{ block.id }}">
                            <span class="accordion-title">
                                {{ block.settings.title }}
                            </span>
                            {% render 'chevron' %}
                        </button>

                        <div
                                id="delivery-panel-{{ section.id }}-{{ block.id }}"
                                class="accordion-content"
                                aria-hidden="true"
                        >
                            <div class="accordion-content-inner">
                                {{ block.settings.subcopy }}
                                {% if block.settings.subtitle != blank and block.settings.subimage != blank %}
                                    <div class="delivery-accordion-item">
                                        <button
                                                class="sub-accordion-header"
                                                type="button"
                                                aria-expanded="false"
                                                aria-controls="delivery-subpanel-{{ section.id }}-{{ block.id }}">
                                            {% render 'subchevron' %}
                                            <span class="accordion-title">
                                                {{ block.settings.subtitle }}
                                            </span>
                                        </button>

                                        <div
                                                id="delivery-subpanel-{{ section.id }}-{{ block.id }}"
                                                class="accordion-content"
                                                aria-hidden="true"
                                        >
                                            <div class="accordion-content-inner">
                                                {% if block.settings.subimage != blank %}
                                                    
<img
  src="{{ block.settings.subimage | image_url: width: 600, height: 300 }}"
  alt="{{ block.settings.subimage.alt | escape }}"
  width="600"
  height="300"
  class="accordion-content-image"
>

                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                                {{ block.settings.copy }}
                                {% if block.settings.image != blank %}
                                    
<img
  src="{{ block.settings.image | image_url: width: 600, height: 250 }}"
  alt="{{ block.settings.image.alt | escape }}"
  width="600"
  height="250"
  class="accordion-content-image"
>

                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {%- if section.settings.contact_heading != blank or section.settings.contact_copy != blank -%}
            <div class="delivery-contact-strip">
                {%- if section.settings.contact_heading != blank -%}
                    <h2 class="delivery-first-acc__title">{{ section.settings.contact_heading }}</h2>
                {%- endif -%}
                {%- if section.settings.contact_copy != blank -%}
                    <div class="delivery-contact-strip__copy">{{ section.settings.contact_copy }}</div>
                {%- endif -%}
                {% render 'delivery-contact-links',
                  phone_label: section.settings.contact_phone_label,
                  phone_link: section.settings.contact_phone_link,
                  email_label: section.settings.contact_email_label,
                  email_link: section.settings.contact_email_link,
                  email_address: section.settings.contact_email_address
                %}
            </div>
        {%- endif -%}
    </div>
</div>

<script>
  (function () {
    document.querySelectorAll('.section-{{ section.id }} .sub-accordion-header').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();

        var controlsId = btn.getAttribute('aria-controls');
        var content = document.getElementById(controlsId);
        if (!content) return;

        var isExpanded = btn.getAttribute('aria-expanded') === 'true';

        btn.setAttribute('aria-expanded', String(!isExpanded));
        content.setAttribute('aria-hidden', String(isExpanded));

        // After the sub-accordion CSS transition completes,
        // recalculate the parent accordion's max-height to fit the new content
        var parent = btn.closest('.accordion-content');
        if (parent) {
          setTimeout(function () {
            parent.style.maxHeight = parent.scrollHeight + 'px';
          }, 110); // slightly after the 0.3s transition finishes
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Third Accordion Section",
  "tag": "section",
  "class": "section delivery-third-acc",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Section Copy"
    },
    {
      "type": "header",
      "content": "Final contact strip"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading"
    },
    {
      "type": "richtext",
      "id": "contact_copy",
      "label": "Contact copy"
    },
    {
      "type": "text",
      "id": "contact_phone_label",
      "label": "Phone button label"
    },
    {
      "type": "text",
      "id": "contact_phone_link",
      "label": "Phone button link",
      "info": "Example: tel:+19252152927"
    },
    {
      "type": "text",
      "id": "contact_email_label",
      "label": "Email button label"
    },
    {
      "type": "text",
      "id": "contact_email_link",
      "label": "Email button link",
      "info": "Example: mailto:sales@fitnesssuperstore.com?subject=..."
    },
    {
      "type": "text",
      "id": "contact_email_address",
      "label": "Visible email address"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Block Copy"
        },
        {
          "type": "richtext",
          "id": "subcopy",
          "label": "Block Subcopy"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Block Subaccordion Title"
        },
        {
          "type": "image_picker",
          "id": "subimage",
          "label": "Block Subaccordion Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delivery Banner"
    }
  ]
}
{% endschema %}