{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'section-our-story-trusthub.css' | asset_url | stylesheet_tag }}

<div class="our-story-trusthub section-{{ section.id }}-padding">
  <div class="our-story-trusthub__inner page-width">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="our-story-trusthub__header">
        {%- if section.settings.title != blank -%}
          <h2 class="our-story-trusthub__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="our-story-trusthub__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="our-story-trusthub__timeline">
        <span class="our-story-trusthub__line" aria-hidden="true"></span>
        <ul class="our-story-trusthub__columns" role="list">
          {%- for block in section.blocks -%}
            <li class="our-story-trusthub__column" {{ block.shopify_attributes }}>
              <div class="our-story-trusthub__card">
                <p class="our-story-trusthub__card-text">
                  {%- if block.settings.label != blank -%}
                    <strong>{{ block.settings.label }}</strong>
                  {%- endif -%}
                  {%- if block.settings.label != blank and block.settings.text != blank %} {% endif -%}
                  {%- if block.settings.text != blank -%}
                    {{ block.settings.text | strip }}
                  {%- endif -%}
                </p>
              </div>
              <span class="our-story-trusthub__dot" aria-hidden="true"></span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Our Story Trust Hub",
  "class": "section our-story-trusthub-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Our Story in Brief"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share the milestones that shaped your company. Add a short paragraph describing your journey, what you offer today, and the customers you serve.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Year / label",
          "info": "Bold prefix shown before the description (e.g. 2010:)",
          "default": "2010:"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": " Company founded"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Trust Hub",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "label": "2010:",
            "text": " Fitness Superstore founded"
          }
        },
        {
          "type": "milestone",
          "settings": {
            "label": "2019:",
            "text": " French Fitness launched"
          }
        },
        {
          "type": "milestone",
          "settings": {
            "label": "Today:",
            "text": " New and remanufactured equipment, Benicia operations, nationwide delivery, international shipping available"
          }
        }
      ]
    }
  ]
}
{% endschema %}
