{% style %}
.payment-faqs .payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1320px;
  margin: 0 auto;
  padding: 16px;
  gap: 24px;
}

.payment-faqs .sidebar {
  position: sticky;
  top: 16px;
  height: fit-content;
  margin-right: 24px;
  flex: 1;
  flex-shrink: 0;
  max-width: 515px;
}

.payment-faqs .sidebar h3 {
  font-family: DM Sans;
  font-weight: 700;
  font-size: clamp(24px, 5vw, 32px);
  line-height: 1.3;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.payment-faqs .sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.payment-faqs .sidebar li {
  margin-bottom: 8px;
  border: 1px solid #E5E5E5;
  border-radius: 4px;
  overflow: hidden;
}

.payment-faqs .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: DM Sans;
  font-weight: 700;
  font-size: clamp(14px, 2.5vw, 16px);
  line-height: 1.5;
  padding: 12px;
  transition: all 0.3s ease;
}

.payment-faqs .sidebar a:hover,
.payment-faqs .sidebar li.active a,
.payment-faqs .sidebar a.active {
  background-color: #DF633A;
  color: #fff;
}

/* Accordion Section */
.payment-faqs .accordion-container {
  flex: 1.5;
  padding: 0;
}

.payment-faqs .accordion {
  border-bottom: 1px solid #E5E5E5;
  margin: 16px 0;
}

.payment-faqs .accordion-header {
  font-family: DM Sans;
  font-weight: 700;
  font-size: clamp(16px, 2.5vw, 18px);
  line-height: 1.5;
  cursor: pointer;
  padding: 12px 0;
  gap: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.payment-faqs .accordion-header p {
  margin: 0;
}

.payment-faqs .accordion-header::after {
  content: '>';
  font-size: 20px;
  transition: transform 0.3s ease;
  transform: rotate(90deg);
}

.payment-faqs .accordion-header.active::after {
  content: '<';
}

.payment-faqs .accordion-content-text {
  font-family: DM Sans;
  font-weight: 400;
  font-size: clamp(14px, 2.5vw, 16px);
  line-height: 1.5;
  padding: 12px 0;
  display: none;
}

.payment-faqs .accordion-content-text.active {
  display: block;
}

/* List styles */
.payment-faqs .accordion-container ul {
  margin-left: 20px;
  padding: 0;
}

.payment-faqs .accordion-container ol li {
  font-family: DM Sans;
  font-weight: 400;
  font-size: clamp(12px, 2vw, 14px);
  line-height: 1.5;
  margin-bottom: 8px;
  color: #333333;
  position: relative;
  padding-left: 16px;
}

.payment-faqs .accordion-container ul li:before {
  content: "";
  border: 4px solid #FE8425;
  border-radius: 50%;
  position: absolute;
  left: -12px;
  top: 6px;
}

.payment-faqs .accordion-container ol li:before {
  content: "*";
  position: absolute;
  left: 0;
  top: 2px;
  color: #FE8425;
}

.payment-faqs .accordion-content-text p a,
.payment-faqs .accordion-content-text li a {
  color: #DF633A;
  font-weight: 700;
  text-decoration: none;
}

.payment-faqs .accordion-content-text p {
  margin: 8px 0;
  font-size: clamp(14px, 2.5vw, 16px);
  line-height: 1.5;
}

/* Logo Container */
.payment-faqs .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.payment-faqs .logo-image {
  width: clamp(50px, 15vw, 60px);
  height: auto;
  object-fit: contain;
}

/* Media Queries */
@media (max-width: 1024px) {
  .payment-faqs .sidebar {
    width: 250px;
    margin-right: 16px;
  }
}

@media (max-width: 768px) {
  .payment-faqs .payment-methods-container {
    flex-direction: column;
    padding: 12px;
    gap: 16px;
  }

  .payment-faqs .sidebar {
    position: relative;
    top: 0;
    width: 100%;
    margin-right: 0;
  }

  .payment-faqs .sidebar h3 {
    font-size: clamp(20px, 4vw, 24px);
  }

  .payment-faqs .sidebar a {
    font-size: clamp(13px, 2.5vw, 14px);
  }

  .payment-faqs .accordion {
    margin: 0;
    padding: 0;
  }

  .payment-faqs .accordion-header {
        font-size: 16px;
        line-height: 24px;
        font-family: DM Sans;
        padding: 12px;
        font-weight: 700;

  }

.payment-faqs .accordion-content-text p{
  font-family: DM Sans;
font-weight: 400;
font-size: 16px;
line-height: 24px;
letter-spacing: 0px;
vertical-align: middle;
}

  .payment-faqs .accordion-content-text.active {
    padding: 12px;
}

  .payment-faqs .accordion-container {
    padding-bottom: 30px;
}
}


{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
  <div class="sidebar">
    <h3>{{ section.settings.sidebar_title }}</h3>
    <p>{{ section.settings.sidebar_text }}</p>
  </div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header"><p>{{ block.settings.accordion_title }}</p></div>
          <div class="accordion-content-container">         
            <!-- Accordion Content Text -->
            <div class="accordion-content-text">
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
    {% endfor %}
  </div>
</div>

<script>
// JavaScript for Accordion and Sidebar Functionality
function initializeAccordionsAndSidebar() {
  const headers = document.querySelectorAll('.payment-faqs .accordion-header');
  const sidebarLinks = document.querySelectorAll('.payment-faqs .sidebar-link');

  // Remove existing event listeners
  headers.forEach(header => {
    header.removeEventListener('click', toggleAccordion);
  });
  sidebarLinks.forEach(link => {
    link.removeEventListener('click', handleSidebarClick);
  });

  // Accordion functionality
  headers.forEach(header => {
    header.addEventListener('click', toggleAccordion);
  });

  function toggleAccordion() {
    const content = this.nextElementSibling.querySelector('.accordion-content-text');
    const isActive = content.classList.contains('active');
    const accordionId = this.parentElement.id;

    // Close all other accordions
    document.querySelectorAll('.payment-faqs .accordion-content-text').forEach(item => {
      item.classList.remove('active');
    });
    document.querySelectorAll('.payment-faqs .accordion-header').forEach(item => {
      item.classList.remove('active');
    });

    // Toggle the clicked accordion
    if (!isActive) {
      content.classList.add('active');
      this.classList.add('active');
      
      // Update sidebar active state
      updateSidebarActiveState(accordionId);
    }
  }

  // Sidebar link functionality
  sidebarLinks.forEach(link => {
    link.addEventListener('click', handleSidebarClick);
  });

  function handleSidebarClick(e) {
    e.preventDefault();
    const targetId = this.getAttribute('href').substring(1);
    const targetElement = document.getElementById(targetId);

    // Update sidebar active state
    updateSidebarActiveState(targetId);

    // Scroll to target
    if (targetElement) {
      targetElement.scrollIntoView({ behavior: 'smooth' });
      
      // Open the accordion
      const header = targetElement.querySelector('.accordion-header');
      const content = targetElement.querySelector('.accordion-content-text');
      if (header && content && !content.classList.contains('active')) {
        headers.forEach(h => h.classList.remove('active'));
        document.querySelectorAll('.payment-faqs .accordion-content-text').forEach(c => c.classList.remove('active'));
        header.classList.add('active');
        content.classList.add('active');
      }
    }
  }

  function updateSidebarActiveState(targetId) {
    sidebarLinks.forEach(link => {
      const li = link.parentElement;
      li.classList.remove('active');
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${targetId}`) {
        li.classList.add('active');
        link.classList.add('active');
      }
    });
  }

  // Handle initial page load with hash
  const hash = window.location.hash.substring(1);
  if (hash) {
    const targetElement = document.getElementById(hash);
    if (targetElement) {
      targetElement.scrollIntoView({ behavior: 'smooth' });
      const header = targetElement.querySelector('.accordion-header');
      const content = targetElement.querySelector('.accordion-content-text');
      if (header && content) {
        header.classList.add('active');
        content.classList.add('active');
      }
      updateSidebarActiveState(hash);
    }
  }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', initializeAccordionsAndSidebar);

// Re-initialize on window resize
let resizeTimer;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(initializeAccordionsAndSidebar, 250);
});
</script>

{% schema %}
{
  "name": "Payment FAQs",
  "class": "payment-faqs",
  "settings": [
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Sidebar Title",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "sidebar_text",
      "label": "Sidebar Text",
      "default": "Select a payment method"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Section",
      "settings": [
       
        {
          "type": "richtext",
          "id": "accordion_title",
          "label": "Accordion Title",
          "default": "<p>Accordion Title</p>"
        },
        {
          "type": "richtext",
          "id": "accordion_content",
          "label": "Accordion Content",
          "default": "<p>Add your content here.</p>"
        }
       
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment FAQs",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Payment Method 1</p>",
            "accordion_content": "<p>Details about payment method 1.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Payment Method 2</p>",
            "accordion_content": "<p>Details about payment method 2.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}