{% style %}

 .payment-faqs .accordion-container ul{
   margin-left: 20px;
 }

 .payment-faqs .accordion-container ol li{
    font-family: DM Sans;
font-weight: 400;
font-size: 14px;
line-height: 20px;
letter-spacing: 0%;
margin-bottom: 12px;
color: #333333;
  }

.payment-faqs .accordion-container ol{
  margin-top: 5px;
}
  .payment-faqs .accordion-content-text p a, .payment-faqs .accordion-content-text li a{
    color: #DF633A;
    font-weight: 700;
  }

  .payment-faqs .accordion-container ul li:before {
    content: "";
    border: 4px #FE8425 solid !important;
    border-radius: 50px;
    margin-top: 8px;
    margin-left: -20px;
    position: absolute;
}

   .payment-faqs .accordion-container ol li:before {
    content: "*";
    margin-top: 3px;
    margin-left: -18px;
    position: absolute;
    color: #FE8425;
    width: 7px;
    height: 7px;
}


.payment-faqs .sidebar li {
  padding: 0;
  border: 1px solid #E5E5E5;
  margin-bottom: 12px;
  border-radius: 4px;
  list-style: none;
}

  .payment-faqs .sidebar li.active {
  background-color: #DF633A;
}

  .payment-faqs .sidebar li.active a{
    color: #fff;
  }

.payment-faqs .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: DM Sans;
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  padding: 12px;
  border-radius: 4px;
  transition: background-color 0.3s ease, color 0.3s ease;
}


.payment-faqs .sidebar a:hover {
  color: #fff;
  background-color: #DF633A;
}

.payment-faqs .sidebar a.active {
  background-color: #DF633A;
  color: #fff; 
}


.payment-faqs .payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}


.payment-faqs .sidebar {

  position: sticky;
  top: 20px;
  height: fit-content;
padding: 0;
    margin-right: 54px;

}

.payment-faqs .sidebar h3 {
  padding: 0px;
  margin: 0px;
  font-family: DM Sans;
    font-weight: 700;
    font-size: 40px;
    line-height: 52px;
    letter-spacing: 1px;
    text-transform: uppercase;
  margin-bottom: 24px;
}

.payment-faqs .sidebar ul {
  list-style: none;
  padding: 0;
}


/* Logo Container */
.payment-faqs .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
}

.payment-faqs .logo-image {
width: 70px;
    object-fit: cover;
}

/* Accordion Section */
.payment-faqs .accordion-container {
  flex: 1;
  padding: 0;

}

.payment-faqs .accordion {
  border-bottom: 1px solid #E5E5E5;
      margin: 20px 12px;
}

.payment-faqs .accordion-header {
font-family: DM Sans;
font-weight: 700;
font-size: 18px;
line-height: 24px;
letter-spacing: 0px;
vertical-align: middle;
gap: 16px;

}

  .accordion-content-text p{
    font-family: DM Sans;
font-weight: 400;
font-size: 16px;
    margin: 12px 0px;
line-height: 24px;
letter-spacing: 0px;
vertical-align: middle;
font-variant-numeric-figure: lining-nums;
font-variant-numeric-spacing: proportional-nums;

  }

.payment-faqs .accordion-header::after {
  content: '+';
  font-size: 20px;
  transition: transform 0.3s ease;
}

.payment-faqs .accordion-header.active::after {
  content: '−';
  transform: rotate(180deg);
}

.payment-faqs .accordion-content-text {

font-family: DM Sans;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
  padding-top: 16px;
    letter-spacing: 0px;
}


  .payment-faqs .accordion-container {
    padding: 0;
  }

  .payment-faqs .accordion-header {
    cursor: pointer; /* Clickable on mobile */
  }

  .payment-faqs .accordion-content-text {
    display: none; /* Hidden by default on mobile */
  }

  .payment-faqs .accordion-content-text.active {
    display: block; /* Show when active */
  }

  .payment-faqs .accordion-header p{
    margin: 0;
  }

@media (max-width: 768px) {

    .payment-faqs .payment-methods-container {
    flex-direction: column;
  }

  .payment-faqs .sidebar {

  position: relative;
padding: 0;
    margin-right: 0px;

}
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
 <div class="sidebar">
  <h3>{{ section.settings.sidebar_title }}</h3>
  <p>{{ section.settings.sidebar_text }}</p>
</div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header">{{ block.settings.accordion_title }}</div>
          <div class="accordion-content-container">
            <!-- Logo Container -->
            {% if block.settings.num_logos > 0 %}
              <div class="logo-container">
                {% for i in (1..block.settings.num_logos) %}
                  {% assign logo_key = 'logo_' | append: i %}
                  {% if block.settings[logo_key] %}
                    <img src="{{ block.settings[logo_key] | img_url: '100x' }}" alt="{{ block.settings.accordion_title }} Logo {{ i }}" class="logo-image">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            <!-- Accordion Content Text -->
            <div class="accordion-content-text">
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
// JavaScript for Accordion and Sidebar Functionality
function initializeAccordionsAndSidebar() {
  const isMobile = window.innerWidth <= 2000;

  // Remove existing event listeners from accordion headers
  document.querySelectorAll('.accordion-header').forEach(header => {
    header.removeEventListener('click', toggleAccordion);
  });

  // Accordion functionality for mobile
  if (isMobile) {
    document.querySelectorAll('.accordion-header').forEach(header => {
      header.addEventListener('click', toggleAccordion);
    });

    function toggleAccordion() {
      const content = this.nextElementSibling.querySelector('.accordion-content-text');
      const isActive = content.classList.contains('active');

      // Close all other accordions
      document.querySelectorAll('.accordion-content-text').forEach(item => {
        item.classList.remove('active');
      });
      document.querySelectorAll('.accordion-header').forEach(item => {
        item.classList.remove('active');
      });

      // Toggle the clicked accordion
      if (!isActive) {
        content.classList.add('active');
        this.classList.add('active');
      }
    }
  } else {
    document.querySelectorAll('.accordion-header').forEach(header => {
      header.addEventListener('click', toggleAccordion);
    });

    function toggleAccordion() {
      const content = this.nextElementSibling.querySelector('.accordion-content-text');
      const isActive = content.classList.contains('active');

      // Close all other accordions
      document.querySelectorAll('.accordion-content-text').forEach(item => {
        item.classList.remove('active');
      });
      document.querySelectorAll('.accordion-header').forEach(item => {
        item.classList.remove('active');
      });

      // Toggle the clicked accordion
      if (!isActive) {
        content.classList.add('active');
        this.classList.add('active');
      }
    }
  }

  // Sidebar link click handling
  document.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault(); // Prevent default anchor behavior
      const targetId = this.getAttribute('href').substring(1); // Get target ID without #
      const targetElement = document.getElementById(targetId);

      // Remove active class from all sidebar li and a elements
      document.querySelectorAll('.sidebar li').forEach(li => {
        li.classList.remove('active');
      });
      document.querySelectorAll('.sidebar a').forEach(a => {
        a.classList.remove('active');
      });

      // Add active class to the clicked link's parent li and the link itself
      this.parentElement.classList.add('active');
      this.classList.add('active');

      // Scroll to the target accordion section
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // Highlight sidebar item based on URL hash on page load
  const hash = window.location.hash.substring(1); // Get hash without #
  if (hash) {
    const targetLink = document.querySelector(`.sidebar a[href="#${hash}"]`);
    if (targetLink) {
      // Remove active classes from all
      document.querySelectorAll('.sidebar li').forEach(li => {
        li.classList.remove('active');
      });
      document.querySelectorAll('.sidebar a').forEach(a => {
        a.classList.remove('active');
      });

      // Add active class to the matching link and its parent li
      targetLink.classList.add('active');
      targetLink.parentElement.classList.add('active');

      // Scroll to the target section
      const targetElement = document.getElementById(hash);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    }
  }
}

// Initialize on page load
initializeAccordionsAndSidebar();

// Re-initialize on window resize
window.addEventListener('resize', initializeAccordionsAndSidebar);
</script>

