{% style %}

  .payment-faqs .accordion-container ul li{
    position: relative;
  }
.payment-faqs .payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1320px;
  margin: 0 auto;
  padding: 16px;
  gap: 24px;
}

.payment-faqs .sidebar {
  position: sticky;
  top: 16px;
  height: fit-content;
  margin-right: 24px;
  flex: 1;
  flex-shrink: 0;
  max-width: 515px;
}

.payment-faqs .sidebar h3 {
  font-family: var(--font-heading-family);
  font-weight: 700;
  font-size: clamp(24px, 5vw, 32px);
  line-height: 1.3;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.payment-faqs .sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.payment-faqs .sidebar li {
  margin-bottom: 8px;
  border: 1px solid #E5E5E5;
  border-radius: 4px;
  overflow: hidden;
}

.payment-faqs .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: var(--font-body-family);
  font-weight: 700;
  font-size: clamp(14px, 2.5vw, 16px);
  line-height: 1.5;
  padding: 12px;
  transition: all 0.3s ease;
}

.payment-faqs .sidebar a:hover,
.payment-faqs .sidebar li.active a,
.payment-faqs .sidebar a.active {
  background-color: #D83D0E;
  color: #fff;
}

/* Accordion Section */
.payment-faqs .accordion-container {
  flex: 1.5;
  padding: 0;
}

.payment-faqs .accordion {
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  padding: 12px;
  margin: 0 0 12px;
}

.payment-faqs .accordion:last-child {
  margin-bottom: 0;
}

.payment-faqs .accordion-header {
  font-family: var(--font-body-family);
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  color: #000000;
  cursor: pointer;
  padding: 0;
  gap: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.payment-faqs .accordion-header p {
  margin: 0;
}

.payment-faqs .accordion-header:focus-visible {
  outline: 2px solid #D83D0E;
  outline-offset: 2px;
}

.payment-faqs .accordion-header .accordion-chevron {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  transition: transform 0.3s ease;
}

.payment-faqs .accordion-header.active .accordion-chevron {
  transform: rotate(180deg);
}

.payment-faqs .accordion-content-text {
  font-family: var(--font-body-family);
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  padding: 12px 0 0;
  display: none;
}

.payment-faqs .accordion-content-text.active {
  display: block;
}

/* List styles */
.payment-faqs .accordion-container ul {
  margin-left: 20px;
  padding: 0;
}

.payment-faqs .accordion-container ol li {
  font-family: var(--font-body-family);
  font-weight: 400;
  font-size: clamp(12px, 2vw, 14px);
  line-height: 1.5;
  margin-bottom: 8px;
  color: #333333;
  position: relative;
  padding-left: 16px;
}

.payment-faqs .accordion-container ul li:before {
  content: "";
  border: 4px solid #FE8425;
  border-radius: 50%;
  position: absolute;
  left: -15px;
  top: 7px;
}

.payment-faqs .accordion-container ol li:before {
  content: "*";
  position: absolute;
  left: 0;
  top: 2px;
  color: #FE8425;
}

.payment-faqs .accordion-content-text p a,
.payment-faqs .accordion-content-text li a {
  color: #D83D0E;
  font-weight: 700;
  text-decoration: none;
}

.payment-faqs .accordion-content-text p {
  margin: 8px 0;
  font-size: clamp(14px, 2.5vw, 16px);
  line-height: 1.5;
}

/* Logo Container */
.payment-faqs .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.payment-faqs .logo-image {
  width: clamp(50px, 15vw, 60px);
  height: auto;
  object-fit: contain;
}

/* Media Queries */
@media (max-width: 1024px) {
  .payment-faqs .sidebar {
    width: 250px;
    margin-right: 16px;
  }
}

@media (max-width: 768px) {
  .payment-faqs .payment-methods-container {
    flex-direction: column;
    padding: 12px;
    gap: 16px;
  }

  .payment-faqs .sidebar {
    position: relative;
    top: 0;
    width: 100%;
    margin-right: 0;
  }

  .payment-faqs .sidebar h3 {
    font-size: 20px;
    line-height: 26px;
    color: #23232B;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .payment-faqs .sidebar p {
    font-family: var(--font-body-family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: #393940;
    margin: 0;
  }

  .payment-faqs .sidebar a {
    font-size: clamp(13px, 2.5vw, 14px);
  }

  .payment-faqs .accordion {
    margin: 0 0 12px;
    padding: 12px;
  }

  .payment-faqs .accordion-header {
    font-size: 16px;
    line-height: 24px;
    font-family: var(--font-body-family);
    padding: 0;
    gap: 8px;
    font-weight: 700;
  }

  .payment-faqs .accordion-container ul li:before{
    content: "";
    border: 4px solid #FE8425;
    border-radius: 50%;
    position: absolute;
    top: 7px;
    left: -15px;
  }

.payment-faqs .accordion-content-text p, .payment-faqs .accordion-container ol li, .payment-faqs .accordion-container ul li{
  font-family: var(--font-body-family);
  position: relative;
font-weight: 400;
font-size: 16px;
line-height: 24px;
letter-spacing: 0px;
  margin: 0px;
vertical-align: middle;
}

  .payment-faqs .accordion-content-text.active {
    padding: 12px 0 0;
  }

  .payment-faqs .accordion-container {
    padding-bottom: 30px;
}
}


{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
  <div class="sidebar">
    <h3>{{ section.settings.sidebar_title }}</h3>
    <p>{{ section.settings.sidebar_text }}</p>
  </div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div
            class="accordion-header"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls="{{ section.id }}-{{ block.id }}-content"
          >
            <p>{{ block.settings.accordion_title }}</p>
            {% render 'chevron' %}
          </div>
          <div class="accordion-content-container" id="{{ section.id }}-{{ block.id }}-content">         
            <!-- Accordion Content Text -->
            <div class="accordion-content-text">
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
    {% endfor %}
  </div>
</div>

<script>
(function () {
  var SECTION_ID = '{{ section.id }}';

  function init() {
    var root = document.getElementById('shopify-section-' + SECTION_ID);
    // Re-entry guard: the section can be initialised from more than one path.
    // This is a property rather than a data attribute on purpose - an
    // attribute serialises into the markup, so a section rebuilt from its own
    // outerHTML would arrive already flagged and never bind its handlers.
    if (!root || root.__paymentFaqsBound) return;
    root.__paymentFaqsBound = true;

    var headers = Array.prototype.slice.call(root.querySelectorAll('.accordion-header'));
    var sidebarLinks = Array.prototype.slice.call(root.querySelectorAll('.sidebar-link'));

    function contentOf(header) {
      return header.parentElement.querySelector('.accordion-content-text');
    }

    function closeAll() {
      headers.forEach(function (header) {
        header.classList.remove('active');
        header.setAttribute('aria-expanded', 'false');
        var content = contentOf(header);
        if (content) content.classList.remove('active');
      });
    }

    function openHeader(header) {
      header.classList.add('active');
      header.setAttribute('aria-expanded', 'true');
      var content = contentOf(header);
      if (content) content.classList.add('active');
    }

    function toggle(header) {
      var wasOpen = header.classList.contains('active');
      var id = header.parentElement.id;
      closeAll();
      if (!wasOpen) {
        openHeader(header);
        setActiveLink(id);
      }
    }

    function setActiveLink(targetId) {
      sidebarLinks.forEach(function (link) {
        var isTarget = link.getAttribute('href') === '#' + targetId;
        link.classList.toggle('active', isTarget);
        link.parentElement.classList.toggle('active', isTarget);
      });
    }

    headers.forEach(function (header) {
      header.addEventListener('click', function () {
        toggle(header);
      });

      header.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
          event.preventDefault();
          toggle(header);
        }
      });
    });

    sidebarLinks.forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        var targetId = this.getAttribute('href').substring(1);
        // Resolve inside this section so a second instance never steals the target.
        var target = root.querySelector('[id="' + targetId + '"]');
        setActiveLink(targetId);
        if (!target) return;
        target.scrollIntoView({ behavior: 'smooth' });
        var header = target.querySelector('.accordion-header');
        if (header && !header.classList.contains('active')) {
          closeAll();
          openHeader(header);
        }
      });
    });
  }

  // The theme editor re-renders a section after the document has loaded, so
  // the rebuilt markup has to be initialised again rather than left inert.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', function (event) {
    if (event.detail && String(event.detail.sectionId) === SECTION_ID) init();
  });
})();
</script>

{% schema %}
{
  "name": "Payment FAQs",
  "class": "payment-faqs",
  "settings": [
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Sidebar Title",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "sidebar_text",
      "label": "Sidebar Text",
      "default": "Select a payment method"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Section",
      "settings": [
       
        {
          "type": "richtext",
          "id": "accordion_title",
          "label": "Accordion Title",
          "default": "<p>Accordion Title</p>"
        },
        {
          "type": "richtext",
          "id": "accordion_content",
          "label": "Accordion Content",
          "default": "<p>Add your content here.</p>"
        }
       
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment FAQs",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Payment Method 1</p>",
            "accordion_content": "<p>Details about payment method 1.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "accordion_title": "<p>Payment Method 2</p>",
            "accordion_content": "<p>Details about payment method 2.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}