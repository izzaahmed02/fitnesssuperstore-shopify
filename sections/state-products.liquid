{{ 'home-products.css' | asset_url | stylesheet_tag }}

<div class="custom-container" 
     style="background-color: {{ section.settings.bg }}; 
            padding-top: {{ section.settings.padding_top }}px; 
            padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <div class="featured_products_header" style="display: flex; flex-direction: column; align-items: flex-start;">
    {% if section.settings.heading != blank %}
      <h2 style="margin-bottom: 10px;">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="featured_products_subheading" style="display: block;">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.link != blank %}
      <a href="{{ section.settings.url }}" class="featured_products_link" style="margin-top: 15px; display: inline-flex; align-items: center;">
        {{ section.settings.link }}

        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.8017 4.46967C8.09459 4.17678 8.56947 4.17678 8.86236 4.46967L13.8624 9.46967C14.1553 9.76256 14.1553 10.2374 13.8624 10.5303L8.86236 15.5303C8.56947 15.8232 8.09459 15.8232 7.8017 15.5303C7.50881 15.2374 7.50881 14.7626 7.8017 14.4697L12.2714 10L7.8017 5.53033C7.50881 5.23744 7.50881 4.76256 7.8017 4.46967Z" fill="#fff"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="featured_products_container">
    {% for product in section.settings.products %}
      {% render 'product-items-home', product: product %}
    {% endfor %}
  </div>
</div>

<script src="{{ 'home-products.js' | asset_url }}" defer="defer"></script>
