{% comment %}
Related Blog Posts — JS driven slider with synced scrollbar
{% endcomment %}

<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h1 class="section-header__title center">{{ section.settings.heading }}</h1>
      </div>
    {% endif %}

    {% assign blog = blogs[section.settings.blog] %}

    {% if blog and blog.articles_count > 0 %}
      <div class="related-slider" data-slider>

        <div class="related-slider__track" data-track>
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">
                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.title }}"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3>{{ article.title }}</h3>
                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>

        <!-- Scrollbar + arrows -->
        <div class="related-slider__bottom">
          <div class="related-slider__scrollbar" data-scrollbar>
            <span class="scroll-thumb" data-thumb></span>
          </div>

          <div class="related-slider__arrows">
            <button class="arrow prev" data-prev>‹</button>
            <button class="arrow next" data-next>›</button>
          </div>
        </div>

      </div>
    {% endif %}

  </div>

  <style>
    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar {
      display: none;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 100%;
    }

    @media (min-width: 990px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        flex: 0 0 calc(33.333% - 11px);
      }
    }

    .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Bottom bar */
    .related-slider__bottom {
      margin-top: 16px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
    }

    /* Scrollbar */
    .related-slider__scrollbar {
      position: relative;
      width: 100%;
      height: 6px;
      background: #eee;
      border-radius: 6px;
      cursor: pointer;
    }

    .scroll-thumb {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 40px;
      background: #D83D0E;
      border-radius: 6px;
    }

    /* Arrows */
    .related-slider__arrows {
      display: flex;
      gap: 8px;
    }

    .related-slider__arrows .arrow {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #ccc;
      background: #fff;
      cursor: pointer;
    }
  </style>

  <script>
    (function () {
      const slider = document.querySelector('#RelatedBlogs-{{ section.id }} [data-slider]');
      if (!slider) return;

      const track = slider.querySelector('[data-track]');
      const scrollbar = slider.querySelector('[data-scrollbar]');
      const thumb = slider.querySelector('[data-thumb]');
      const prev = slider.querySelector('[data-prev]');
      const next = slider.querySelector('[data-next]');

      function syncThumb() {
        const scrollRatio = track.scrollLeft / (track.scrollWidth - track.clientWidth);
        const maxLeft = scrollbar.clientWidth - thumb.clientWidth;
        thumb.style.left = `${scrollRatio * maxLeft}px`;
      }

      track.addEventListener('scroll', syncThumb);

      /* Arrow scrolling */
      function scrollByCard(direction) {
        const card = track.querySelector('.related-slider__slide');
        if (!card) return;
        const amount = card.offsetWidth + 16;
        track.scrollBy({ left: direction * amount, behavior: 'smooth' });
      }

      prev.addEventListener('click', () => scrollByCard(-1));
      next.addEventListener('click', () => scrollByCard(1));

      /* Drag scrollbar */
      let isDragging = false;

      thumb.addEventListener('mousedown', () => isDragging = true);
      document.addEventListener('mouseup', () => isDragging = false);

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const rect = scrollbar.getBoundingClientRect();
        let x = e.clientX - rect.left;
        x = Math.max(0, Math.min(x, scrollbar.clientWidth - thumb.clientWidth));
        const ratio = x / (scrollbar.clientWidth - thumb.clientWidth);
        track.scrollLeft = ratio * (track.scrollWidth - track.clientWidth);
      });

      syncThumb();
    })();
  </script>
</section>





{% schema %}
{
  "name": "Related Blog posts Slider",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Related Blog posts Slider",
      "category": "Blog"
    }
  ]
}
{% endschema %}
