{% comment %}
Related Blog Posts — Select a blog and show all articles in a swipeable slider
Mobile: 1 slide
Desktop: 3 slides
Optional horizontal scrollbar (toggleable)
{% endcomment %}

<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h1 class="section-header__title center">{{ section.settings.heading }}</h1>

        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading center">{{ section.settings.subheading }}</h3>
        {% endif %}

        {% if section.settings.intro != blank %}
          <p class="section-header__intro center">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign blog = blogs[section.settings.blog] %}

    {% if blog and blog.articles_count > 0 %}
      <div class="related-slider" id="RelatedSlider-{{ section.id }}">
        <div class="related-slider__track {% unless section.settings.show_scrollbar %}hide-scrollbar{% endunless %}">
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">

                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      />
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                    {% if article.published_at or article.author %}
                      <p class="card__meta publish-info">
                        <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                        {% if article.author %}
                          <span>{{ article.author }}</span>
                        {% endif %}
                      </p>
                    {% endif %}

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <p class="note center">Please select a blog with articles.</p>
    {% endif %}

    {% if section.settings.label %}
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }} {% render 'chevron-right' %}
        </a>
      </div>
    {% endif %}

  </div>

  <style>
    /* === Slider === */
    #RelatedBlogs-{{ section.id }} .related-slider {
      overflow: hidden;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px; /* space for scrollbar */
    }

    /* Scrollbar hidden (toggle OFF) */
    #RelatedBlogs-{{ section.id }} .related-slider__track.hide-scrollbar {
      scrollbar-width: none;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track.hide-scrollbar::-webkit-scrollbar {
      display: none;
    }

    /* Scrollbar visible (toggle ON) */
    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar {
      height: 6px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar-track {
      background: #eee;
      border-radius: 4px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar-thumb {
      background: #D83D0E;
      border-radius: 4px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    /* Desktop: 3 slides */
    @media (min-width: 990px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        flex: 0 0 calc(33.333% - 11px);
      }
    }

    /* Image consistency */
    #RelatedBlogs-{{ section.id }} .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    #RelatedBlogs-{{ section.id }} .card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Meta */
    #RelatedBlogs-{{ section.id }} .publish-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-family: Lato;
      font-size: 12px;
      line-height: 18px;
      color: gray;
      letter-spacing: .13rem;
    }

    #RelatedBlogs-{{ section.id }} .link {
      color: #D83D0E;
    }

    #RelatedBlogs-{{ section.id }} h1 {
      text-transform: uppercase;
    }

    #RelatedBlogs-{{ section.id }} h3 {
      font-size: 18px;
      line-height: 24px;
    }

    .rich-text-custom__wrapper {
      margin-top: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .rich-text-custom__btn {
      font-size: 16px;
      font-weight: 700;
      line-height: 24px;
      background-color: #D83D0E;
      padding: 12px 24px;
      color: #fff;
      border-radius: 8px;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</section>

{% schema %}
{
  "name": "Related Blog posts Slider",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Related Blog posts Slider",
      "category": "Blog"
    }
  ]
}
{% endschema %}
