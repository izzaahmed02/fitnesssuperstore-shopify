{% comment %}
Related Blog Posts — Swipeable Slider
Mobile: 1 slide
Desktop: 3 slides
Scrollbar + arrows inline (no overlap)
{% endcomment %}

<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h1 class="section-header__title center">{{ section.settings.heading }}</h1>

        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading center">{{ section.settings.subheading }}</h3>
        {% endif %}

        {% if section.settings.intro != blank %}
          <p class="section-header__intro center">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign blog = blogs[section.settings.blog] %}

    {% if blog and blog.articles_count > 0 %}
      <div class="related-slider" id="RelatedSlider-{{ section.id }}">

        <!-- Track -->
        <div class="related-slider__track {% unless section.settings.show_scrollbar %}hide-scrollbar{% endunless %}">
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">

                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                    <p class="card__meta publish-info">
                      <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                      {% if article.author %}
                        <span>{{ article.author }}</span>
                      {% endif %}
                    </p>

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_arrows %}
          <div class="related-slider__controls">
            <button class="related-slider__arrow related-slider__arrow--prev" aria-label="Previous">
              ‹
            </button>
            <button class="related-slider__arrow related-slider__arrow--next" aria-label="Next">
              ›
            </button>
          </div>
        {% endif %}

      </div>
    {% else %}
      <p class="note center">Please select a blog with articles.</p>
    {% endif %}

    {% if section.settings.label %}
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }} {% render 'chevron-right' %}
        </a>
      </div>
    {% endif %}

  </div>

  <style>
    /* === Slider Base === */
    #RelatedBlogs-{{ section.id }} .related-slider {
      position: relative;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 14px;
      padding-right: 96px; /* SPACE FOR ARROWS */
    }

    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    @media (min-width: 990px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        flex: 0 0 calc(33.333% - 11px);
      }
    }

    /* Scrollbar */
    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar {
      height: 6px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar-track {
      background: #eee;
      border-radius: 4px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar-thumb {
      background: #D83D0E;
      border-radius: 4px;
    }

    #RelatedBlogs-{{ section.id }} .hide-scrollbar {
      scrollbar-width: none;
    }

    #RelatedBlogs-{{ section.id }} .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }

    /* Controls inline with scrollbar */
    #RelatedBlogs-{{ section.id }} .related-slider__controls {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 8px;
      margin-top: -10px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow {
      width: 36px;
      height: 36px;
      border: 1px solid #ddd;
      border-radius: 6px;
      background: #fff;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow:hover {
      background: #f5f5f5;
    }

    @media (max-width: 749px) {
      #RelatedBlogs-{{ section.id }} .related-slider__controls {
        display: none;
      }
    }

    /* Card Media */
    #RelatedBlogs-{{ section.id }} .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    #RelatedBlogs-{{ section.id }} .card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #RelatedBlogs-{{ section.id }} .publish-info {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: gray;
      letter-spacing: .13rem;
    }

    #RelatedBlogs-{{ section.id }} .link {
      color: #D83D0E;
    }

    .rich-text-custom__wrapper {
      margin-top: 24px;
      display: flex;
      justify-content: center;
    }

    .rich-text-custom__btn {
      background: #D83D0E;
      color: #fff;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 700;
      display: inline-flex;
      gap: 8px;
      text-decoration: none;
    }
  </style>

  <script>
    (function () {
      const section = document.getElementById('RelatedBlogs-{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('.related-slider__track');
      const prev = section.querySelector('.related-slider__arrow--prev');
      const next = section.querySelector('.related-slider__arrow--next');

      if (!track || !prev || !next) return;

      const scrollAmount = () => {
        const slide = track.querySelector('.related-slider__slide');
        return slide ? slide.offsetWidth + 16 : 300;
      };

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      next.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Related Blog posts Slider",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Related posts" },
    { "id": "subheading", "type": "text", "label": "Subheading" },
    { "id": "intro", "type": "text", "label": "Intro" },
    { "id": "blog", "type": "blog", "label": "Select blog" },
    { "id": "show_scrollbar", "type": "checkbox", "label": "Show scrollbar", "default": true },
    { "id": "show_arrows", "type": "checkbox", "label": "Show arrows", "default": true },
    { "id": "show_excerpt", "type": "checkbox", "label": "Show excerpt", "default": true },
    { "id": "excerpt_length", "type": "number", "label": "Excerpt length", "default": 120 },
    { "id": "read_more_text", "type": "text", "label": "Read more text", "default": "Read article" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 },
    { "type": "url", "id": "url", "label": "Button link" },
    { "type": "text", "id": "label", "label": "Button label", "default": "Shop remanufactured equipment" }
  ],
  "presets": [
    { "name": "Related Blog posts Slider", "category": "Blog" }
  ]
}
{% endschema %}
