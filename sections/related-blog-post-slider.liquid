<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h1 class="section-header__title center">{{ section.settings.heading }}</h1>
        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading center">{{ section.settings.subheading }}</h3>
        {% endif %}
        {% if section.settings.intro != blank %}
          <p class="section-header__intro center">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign blog = blogs[section.settings.blog] %}
    {% assign articles_count = blog.articles_count | plus: 0 %}

    {% if blog and articles_count > 0 %}
      <div class="related-slider" id="RelatedSlider-{{ section.id }}">

        <!-- Full-width slides -->
        <div class="related-slider__track">
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">
                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                    <p class="card__meta publish-info">
                      <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                      {% if article.author %}
                        <span>{{ article.author }}</span>
                      {% endif %}
                    </p>

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_arrows %}
          <!-- Custom scrollbar + arrows wrapper -->
          <div class="related-slider__scrollbar-wrapper">
            <div class="custom-scrollbar-track">
              <div class="custom-scrollbar-thumb"></div>
            </div>
            <div class="related-slider__controls">
              <button class="related-slider__arrow related-slider__arrow--prev">‹</button>
              <button class="related-slider__arrow related-slider__arrow--next">›</button>
            </div>
          </div>
        {% endif %}

      </div>
    {% else %}
      <p class="note center">Please select a blog with articles.</p>
    {% endif %}

    {% if section.settings.label %}
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }} {% render 'chevron-right' %}
        </a>
      </div>
    {% endif %}

  </div>

  <style>
    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: hidden; /* hide native scrollbar */
      scroll-snap-type: x mandatory;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    @media (min-width: 990px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        flex: 0 0 calc(33.333% - 11px);
      }
    }

    #RelatedBlogs-{{ section.id }} .card__media { aspect-ratio: 16/9; overflow:hidden; }
    #RelatedBlogs-{{ section.id }} .card__image { width:100%; height:100%; object-fit:cover; }

    /* Custom scrollbar + arrows wrapper */
    #RelatedBlogs-{{ section.id }} .related-slider__scrollbar-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      max-width: 400px; /* scrollbar width */
      margin: 12px auto 0;
      gap: 8px;
    }

    .custom-scrollbar-track {
      position: relative;
      flex: 1;
      height: 6px;
      background: #eee;
      border-radius: 4px;
      overflow: hidden;
    }

    .custom-scrollbar-thumb {
      position: absolute;
      top:0; left:0;
      height: 100%;
      width: 50px; /* initial width, will adjust with JS */
      background: #D83D0E;
      border-radius: 4px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow {
      width:36px; height:36px;
      border:1px solid #ddd; border-radius:6px;
      background:#fff;
      display:flex; align-items:center; justify-content:center;
      font-size:20px; cursor:pointer;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow:hover { background:#f5f5f5; }

    .rich-text-custom__wrapper { margin-top:24px; display:flex; justify-content:center; }
    .rich-text-custom__btn {
      background:#D83D0E; color:#fff; padding:12px 24px; border-radius:8px;
      font-weight:700; display:inline-flex; gap:8px; text-decoration:none;
    }
  </style>

  <script>
    (function() {
      const section = document.getElementById('RelatedBlogs-{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('.related-slider__track');
      const prev = section.querySelector('.related-slider__arrow--prev');
      const next = section.querySelector('.related-slider__arrow--next');
      const scrollbarTrack = section.querySelector('.custom-scrollbar-track');
      const scrollbarThumb = section.querySelector('.custom-scrollbar-thumb');

      if (!track || !prev || !next || !scrollbarThumb || !scrollbarTrack) return;

      // Update thumb width dynamically
      const updateThumb = () => {
        const trackWidth = track.scrollWidth;
        const visibleWidth = track.offsetWidth;
        const thumbWidth = Math.max((visibleWidth / trackWidth) * scrollbarTrack.offsetWidth, 20);
        scrollbarThumb.style.width = thumbWidth + 'px';
      };

      const updateThumbPosition = () => {
        const scrollRatio = track.scrollLeft / (track.scrollWidth - track.offsetWidth);
        const maxThumbLeft = scrollbarTrack.offsetWidth - scrollbarThumb.offsetWidth;
        scrollbarThumb.style.left = scrollRatio * maxThumbLeft + 'px';
      };

      // On scroll
      track.addEventListener('scroll', updateThumbPosition);
      window.addEventListener('resize', () => { updateThumb(); updateThumbPosition(); });

      updateThumb();
      updateThumbPosition();

      // Arrow click
      const scrollAmount = () => {
        const slide = track.querySelector('.related-slider__slide');
        return slide ? slide.offsetWidth + 16 : 300;
      };

      prev.addEventListener('click', () => { track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }); });
      next.addEventListener('click', () => { track.scrollBy({ left: scrollAmount(), behavior: 'smooth' }); });

      // Drag scrollbar thumb
      let isDragging = false;
      let startX, startScroll;

      scrollbarThumb.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        startScroll = track.scrollLeft;
        document.body.style.userSelect = 'none';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const deltaX = e.clientX - startX;
        const trackWidth = track.scrollWidth - track.offsetWidth;
        const scrollbarWidth = scrollbarTrack.offsetWidth - scrollbarThumb.offsetWidth;
        track.scrollLeft = startScroll + (deltaX * trackWidth / scrollbarWidth);
      });

      window.addEventListener('mouseup', () => { isDragging = false; document.body.style.userSelect = ''; });
    })();
  </script>
</section>
