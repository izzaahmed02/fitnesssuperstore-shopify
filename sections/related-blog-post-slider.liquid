<style>
/* -----------------------------------
   1. HARD STOP PAGE HORIZONTAL SCROLL
----------------------------------- */
html,
body {
  max-width: 100%;
  overflow-x: hidden;
}

/* -----------------------------------
   2. SLIDER BREAKOUT (Titan method)
----------------------------------- */
.related-slider {
  position: relative;

  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);

  overflow-x: visible;
}

/* -----------------------------------
   3. SCROLLABLE TRACK
----------------------------------- */
.related-slider__track {
  display: flex;
  gap: 20px;

  overflow-x: auto;
  overflow-y: hidden;

  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;

  padding: 0 24px 20px;
}

/* Hide native scrollbar */
.related-slider__track::-webkit-scrollbar {
  display: none;
}

/* -----------------------------------
   4. SLIDES (viewport controlled)
----------------------------------- */
.related-slider__slide {
  flex: 0 0 auto;
  width: 320px;
}

@media (max-width: 1024px) {
  .related-slider__slide {
    width: 70vw;
  }
}

@media (max-width: 768px) {
  .related-slider__slide {
    width: 85vw;
  }
}

/* -----------------------------------
   5. CARD & IMAGE FIXES
----------------------------------- */
.card {
  display: block;
  height: 100%;
  background: #fff;
  text-decoration: none;
}

.card__media img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* -----------------------------------
   6. ARROWS (OPTIONAL)
----------------------------------- */
.related-slider__arrows {
  position: absolute;
  top: 50%;
  width: 100%;
  transform: translateY(-50%);
  display: flex;
  justify-content: space-between;
  pointer-events: none;
}

.related-slider__arrows button {
  pointer-events: all;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border: none;
  padding: 10px 14px;
  font-size: 18px;
  cursor: pointer;
}
</style>

<div class="related-slider" data-slider>
  <div class="related-slider__track" data-track>

    <!-- SLIDE -->
    <div class="related-slider__slide">
      <article class="card-wrapper">
        <a href="#" class="card">
          <div class="card__media">
            <img src="https://via.placeholder.com/600x400" alt="">
          </div>
          <div class="card__content">
            <h3 class="card__heading">Sample Article Title</h3>
            <p class="card__meta">Nov 21, 2025 · Author</p>
            <div class="card__actions">
              <span class="link">Read Article</span>
            </div>
          </div>
        </a>
      </article>
    </div>

    <!-- DUPLICATE SLIDES -->
    <div class="related-slider__slide">
      <article class="card-wrapper">
        <a href="#" class="card">
          <div class="card__media">
            <img src="https://via.placeholder.com/600x400" alt="">
          </div>
          <div class="card__content">
            <h3 class="card__heading">Another Article</h3>
            <p class="card__meta">Oct 28, 2025 · Author</p>
            <div class="card__actions">
              <span class="link">Read Article</span>
            </div>
          </div>
        </a>
      </article>
    </div>

    <div class="related-slider__slide">
      <article class="card-wrapper">
        <a href="#" class="card">
          <div class="card__media">
            <img src="https://via.placeholder.com/600x400" alt="">
          </div>
          <div class="card__content">
            <h3 class="card__heading">Third Article</h3>
            <p class="card__meta">Sep 16, 2025 · Author</p>
            <div class="card__actions">
              <span class="link">Read Article</span>
            </div>
          </div>
        </a>
      </article>
    </div>

  </div>

  <div class="related-slider__arrows">
    <button class="arrow prev">‹</button>
    <button class="arrow next">›</button>
  </div>
</div>


  <script>
    (function () {
      const slider = document.querySelector('#RelatedBlogs-{{ section.id }} [data-slider]');
      if (!slider) return;

      const track = slider.querySelector('[data-track]');
      const scrollbar = slider.querySelector('[data-scrollbar]');
      const thumb = slider.querySelector('[data-thumb]');
      const prev = slider.querySelector('[data-prev]');
      const next = slider.querySelector('[data-next]');

      function syncThumb() {
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (maxScroll <= 0) return;
        const ratio = track.scrollLeft / maxScroll;
        const maxLeft = scrollbar.clientWidth - thumb.clientWidth;
        thumb.style.left = `${ratio * maxLeft}px`;
      }

      track.addEventListener('scroll', syncThumb);

      function scrollByCard(dir) {
        const card = track.querySelector('.related-slider__slide');
        if (!card) return;
        track.scrollBy({
          left: dir * (card.offsetWidth + 16),
          behavior: 'smooth'
        });
      }

      prev.addEventListener('click', () => scrollByCard(-1));
      next.addEventListener('click', () => scrollByCard(1));

      let dragging = false;

      thumb.addEventListener('mousedown', () => dragging = true);
      document.addEventListener('mouseup', () => dragging = false);

      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const rect = scrollbar.getBoundingClientRect();
        let x = e.clientX - rect.left;
        x = Math.max(0, Math.min(x, scrollbar.clientWidth - thumb.clientWidth));
        const ratio = x / (scrollbar.clientWidth - thumb.clientWidth);
        track.scrollLeft = ratio * (track.scrollWidth - track.clientWidth);
      });

      syncThumb();
    })();
  </script>
</section>






