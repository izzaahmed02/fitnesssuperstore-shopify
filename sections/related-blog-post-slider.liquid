<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header center">
        <h1 class="section-header__title">{{ section.settings.heading }}</h1>

        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading">{{ section.settings.subheading }}</h3>
        {% endif %}

        {% if section.settings.intro != blank %}
          <p class="section-header__intro">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

  </div>

  {% assign blog = blogs[section.settings.blog] %}

  {% if blog and blog.articles_count > 0 %}
    <div class="related-slider partial-bleed" data-slider>

      <!-- Overflow wrapper -->
      <div class="related-slider__viewport">
        <div class="related-slider__track" data-track>
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">

                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3 class="card__heading">{{ article.title }}</h3>

                    {% if article.published_at or article.author %}
                      <p class="card__meta publish-info">
                        {% if article.published_at %}
                          <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                        {% endif %}
                        {% if article.author %}
                          <span>{{ article.author }}</span>
                        {% endif %}
                      </p>
                    {% endif %}

                    {% if section.settings.show_excerpt %}
                      <div class="card__excerpt">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>

                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="related-slider__bottom page-width">
        <div class="related-slider__scrollbar" data-scrollbar>
          <span class="scroll-thumb" data-thumb></span>
        </div>

        <div class="related-slider__arrows">
          <button class="arrow prev" data-prev>‹</button>
          <button class="arrow next" data-next>›</button>
        </div>
      </div>

    </div>
  {% else %}
    <div class="page-width">
      <p class="note center">Please select a blog with articles.</p>
    </div>
  {% endif %}

  {% if section.settings.label != blank %}
    <div class="page-width">
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }}
        </a>
      </div>
    </div>
  {% endif %}

  <style>
    /* PARTIAL FULL-BLEED SLIDER */
    .related-slider.partial-bleed {
      overflow: visible;
      position: relative;
    }

    /* viewport wrapper prevents page scroll */
    .related-slider__viewport {
      overflow-x: auto;
      overflow-y: hidden;
      padding-left: 0; /* first card aligns with container */
      padding-right: 24px;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      margin-left: calc(-50% + 24px); /* allow cards to move outside container visually */
      margin-right: calc(-50% + 24px);
    }

    .related-slider__track {
      display: flex;
      gap: 16px;
      position: relative;
    }

    .related-slider__slide {
      flex: 0 0 calc((100% - 48px)/4);
      min-width: calc((100% - 48px)/4);
    }

    /* 5th partial card */
    .related-slider__slide:nth-child(5) {
      flex: 0 0 calc((100% - 48px)/8);
      min-width: calc((100% - 48px)/8);
    }

    /* CARD STYLING */
    .card {
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .card__media { aspect-ratio: 16/9; overflow: hidden; }
    .card__media img { width: 100%; height: 100%; object-fit: cover; }

    .card__heading { font-size: 18px; line-height: 24px; margin: 12px; }
    .publish-info { display: flex; justify-content: space-between; font-size: 12px; color: #777; margin: 0 12px 12px; }
    .card__excerpt { font-size: 14px; line-height: 22px; margin: 0 12px 12px; }
    .link { color: #D83D0E; font-weight: 600; margin: 0 12px 12px; }

    /* BOTTOM BAR */
    .related-slider__bottom {
      margin-top: 16px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 16px;
    }

    .related-slider__scrollbar { position: relative; width: 220px; height: 6px; background: #eee; border-radius: 6px; cursor: pointer; }
    .scroll-thumb { position: absolute; left: 0; top: 0; height: 100%; width: 40px; background: #D83D0E; border-radius: 6px; }

    .related-slider__arrows { display: flex; gap: 8px; }
    .related-slider__arrows .arrow { width: 36px; height: 36px; border-radius: 50%; border: 1px solid #ccc; background: #fff; cursor: pointer; }

    .rich-text-custom__wrapper { margin-top: 32px; display: flex; justify-content: center; }
    .rich-text-custom__btn { padding: 12px 24px; background: #D83D0E; color: #fff; border-radius: 8px; font-weight: 700; text-decoration: none; }

    @media (max-width: 1200px) { .related-slider__slide { flex: 0 0 25%; } }
    @media (max-width: 990px) { .related-slider__slide { flex: 0 0 50%; } }
    @media (max-width: 600px) { .related-slider__slide { flex: 0 0 100%; } }
  </style>

  <script>
    (function () {
      const slider = document.querySelector('#RelatedBlogs-{{ section.id }} [data-slider]');
      if (!slider) return;

      const track = slider.querySelector('[data-track]');
      const viewport = slider.querySelector('.related-slider__viewport');
      const scrollbar = slider.querySelector('[data-scrollbar]');
      const thumb = slider.querySelector('[data-thumb]');
      const prev = slider.querySelector('[data-prev]');
      const next = slider.querySelector('[data-next]');

      function syncThumb() {
        const maxScroll = viewport.scrollWidth - viewport.clientWidth;
        if (maxScroll <= 0) return;
        const ratio = viewport.scrollLeft / maxScroll;
        const maxLeft = scrollbar.clientWidth - thumb.clientWidth;
        thumb.style.left = `${ratio * maxLeft}px`;
      }

      viewport.addEventListener('scroll', syncThumb);

      function scrollByCard(dir) {
        const card = viewport.querySelector('.related-slider__slide');
        if (!card) return;
        viewport.scrollBy({ left: dir * (card.offsetWidth + 16), behavior: 'smooth' });
      }

      prev.addEventListener('click', () => scrollByCard(-1));
      next.addEventListener('click', () => scrollByCard(1));

      let dragging = false;
      thumb.addEventListener('mousedown', () => dragging = true);
      document.addEventListener('mouseup', () => dragging = false);
      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const rect = scrollbar.getBoundingClientRect();
        let x = e.clientX - rect.left;
        x = Math.max(0, Math.min(x, scrollbar.clientWidth - thumb.clientWidth));
        const ratio = x / (scrollbar.clientWidth - thumb.clientWidth);
        viewport.scrollLeft = ratio * (viewport.scrollWidth - viewport.clientWidth);
      });

      syncThumb();
    })();
  </script>
</section>






{% schema %}
{
  "name": "Related Blog posts Slider",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Related Blog posts Slider",
      "category": "Blog"
    }
  ]
}
{% endschema %}
