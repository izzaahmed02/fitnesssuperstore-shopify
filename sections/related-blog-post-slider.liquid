<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h1 class="section-header__title center">{{ section.settings.heading }}</h1>
        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading center">{{ section.settings.subheading }}</h3>
        {% endif %}
        {% if section.settings.intro != blank %}
          <p class="section-header__intro center">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign blog = blogs[section.settings.blog] %}

    {% if blog and blog.articles_count > 0 %}
      <div class="related-slider" id="RelatedSlider-{{ section.id }}">

        <!-- Full-width slides -->
        <div class="related-slider__track {% unless section.settings.show_scrollbar %}hide-scrollbar{% endunless %}">
          {% for article in blog.articles %}
            <div class="related-slider__slide">
              <article class="card-wrapper">
                <a href="{{ article.url }}" class="card">

                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}

                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                    <p class="card__meta publish-info">
                      <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                      {% if article.author %}
                        <span>{{ article.author }}</span>
                      {% endif %}
                    </p>

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_arrows %}
          <!-- Scrollbar + arrows container (narrow) -->
          <div class="related-slider__scrollbar-wrapper">
            <div class="related-slider__scrollbar-track"></div>
            <div class="related-slider__controls">
              <button class="related-slider__arrow related-slider__arrow--prev">‹</button>
              <button class="related-slider__arrow related-slider__arrow--next">›</button>
            </div>
          </div>
        {% endif %}

      </div>
    {% else %}
      <p class="note center">Please select a blog with articles.</p>
    {% endif %}

    {% if section.settings.label %}
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }} {% render 'chevron-right' %}
        </a>
      </div>
    {% endif %}

  </div>

  <style>
    /* === Slider === */
    #RelatedBlogs-{{ section.id }} .related-slider {
      position: relative;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 14px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    @media (min-width: 990px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        flex: 0 0 calc(33.333% - 11px);
      }
    }

    /* Cards */
    #RelatedBlogs-{{ section.id }} .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    #RelatedBlogs-{{ section.id }} .card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Meta */
    #RelatedBlogs-{{ section.id }} .publish-info {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: gray;
      letter-spacing: .13rem;
    }

    #RelatedBlogs-{{ section.id }} .link {
      color: #D83D0E;
    }

    /* Scrollbar + arrows wrapper (narrow) */
    #RelatedBlogs-{{ section.id }} .related-slider__scrollbar-wrapper {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      max-width: 400px; /* scrollbar width container */
      margin: 0 auto;
      gap: 8px;
    }

    /* Native scrollbar inside wrapper */
    #RelatedBlogs-{{ section.id }} .related-slider__scrollbar-track {
      flex: 1;
      height: 6px;
      background: #eee;
      border-radius: 4px;
      position: relative;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar {
      height: 6px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar-thumb {
      background: #D83D0E;
      border-radius: 4px;
    }

    /* Arrows */
    #RelatedBlogs-{{ section.id }} .related-slider__controls {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow {
      width: 36px;
      height: 36px;
      border: 1px solid #ddd;
      border-radius: 6px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      cursor: pointer;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__arrow:hover {
      background: #f5f5f5;
    }

    @media (max-width: 749px) {
      #RelatedBlogs-{{ section.id }} .related-slider__scrollbar-wrapper {
        display: none;
      }
    }

    /* Rich text button */
    .rich-text-custom__wrapper {
      margin-top: 24px;
      display: flex;
      justify-content: center;
    }

    .rich-text-custom__btn {
      background: #D83D0E;
      color: #fff;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 700;
      display: inline-flex;
      gap: 8px;
      text-decoration: none;
    }
  </style>

  <script>
    (function () {
      const section = document.getElementById('RelatedBlogs-{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('.related-slider__track');
      const prev = section.querySelector('.related-slider__arrow--prev');
      const next = section.querySelector('.related-slider__arrow--next');

      if (!track || !prev || !next) return;

      const scrollAmount = () => {
        const slide = track.querySelector('.related-slider__slide');
        return slide ? slide.offsetWidth + 16 : 300;
      };

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      next.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    })();
  </script>
</section>
