<section
  id="RelatedBlogs-{{ section.id }}"
  class="section related-articles"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>

  <!-- HEADER + BUTTONS STAY CONSTRAINED -->
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="section-header center">
        <h1 class="section-header__title">{{ section.settings.heading }}</h1>

        {% if section.settings.subheading != blank %}
          <h3 class="section-header__subheading">{{ section.settings.subheading }}</h3>
        {% endif %}

        {% if section.settings.intro != blank %}
          <p class="section-header__intro">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

  </div>

  {% assign blog = blogs[section.settings.blog] %}

  {% if blog and blog.articles_count > 0 %}

    <!-- SLIDER BREAKS OUT TO VIEWPORT -->
    <div class="related-slider" data-slider>

      <div class="related-slider__track" data-track>
        {% for article in blog.articles %}
          <div class="related-slider__slide">
            <article class="card-wrapper">
              <a href="{{ article.url }}" class="card">

                {% if article.image %}
                  <div class="card__media">
                    <img
                      src="{{ article.image | img_url: '720x' }}"
                      alt="{{ article.image.alt | default: article.title }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div class="card__content">
                  <h3 class="card__heading">{{ article.title }}</h3>

                  {% if article.published_at or article.author %}
                    <p class="card__meta publish-info">
                      {% if article.published_at %}
                        <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
                      {% endif %}
                      {% if article.author %}
                        <span>{{ article.author }}</span>
                      {% endif %}
                    </p>
                  {% endif %}

                  {% if section.settings.show_excerpt %}
                    <div class="card__excerpt">
                      {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                    </div>
                  {% endif %}

                  <div class="card__actions">
                    <span class="link">{{ section.settings.read_more_text }}</span>
                  </div>
                </div>

              </a>
            </article>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_scrollbar %}
        <div class="related-slider__bottom page-width">

          <div class="related-slider__scrollbar" data-scrollbar>
            <span class="scroll-thumb" data-thumb></span>
          </div>

          <div class="related-slider__arrows">
            <button class="arrow prev" data-prev aria-label="Previous">‹</button>
            <button class="arrow next" data-next aria-label="Next">›</button>
          </div>

        </div>
      {% endif %}

    </div>

  {% else %}
    <div class="page-width">
      <p class="note center">Please select a blog with articles.</p>
    </div>
  {% endif %}

  {% if section.settings.label != blank %}
    <div class="page-width">
      <div class="rich-text-custom__wrapper">
        <a href="{{ section.settings.url }}" class="rich-text-custom__btn">
          {{ section.settings.label }}
        </a>
      </div>
    </div>
  {% endif %}

  <!-- ===================== CSS ===================== -->
  <style>
    /* HARD STOP PAGE SCROLL */
    html, body {
      overflow-x: hidden;
    }

    /* SLIDER BREAKOUT (Titan method) */
    #RelatedBlogs-{{ section.id }} .related-slider {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      overflow-x: visible;
      position: relative;
    }

    /* TRACK SCROLLS — PAGE DOES NOT */
    #RelatedBlogs-{{ section.id }} .related-slider__track {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding: 0 24px 16px;
    }

    #RelatedBlogs-{{ section.id }} .related-slider__track::-webkit-scrollbar {
      display: none;
    }

    /* SLIDES — VIEWPORT CONTROLLED */
    #RelatedBlogs-{{ section.id }} .related-slider__slide {
      flex: 0 0 auto;
      width: 320px;
    }

    @media (max-width: 1024px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        width: 70vw;
      }
    }

    @media (max-width: 768px) {
      #RelatedBlogs-{{ section.id }} .related-slider__slide {
        width: 85vw;
      }
    }

    /* MEDIA */
    .card__media {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* TYPOGRAPHY */
    .card__heading {
      font-size: 18px;
      line-height: 24px;
      margin-bottom: 8px;
    }

    .publish-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 12px;
      color: #777;
      letter-spacing: 0.08em;
    }

    .card__excerpt {
      font-size: 14px;
      line-height: 22px;
      margin-bottom: 12px;
    }

    .link {
      color: #D83D0E;
      font-weight: 600;
    }

    /* BOTTOM BAR */
    .related-slider__bottom {
      margin-top: 16px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .related-slider__scrollbar {
      flex: 1;
      height: 6px;
      background: #eee;
      border-radius: 6px;
      position: relative;
    }

    .scroll-thumb {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 40px;
      background: #D83D0E;
      border-radius: 6px;
    }

    .related-slider__arrows {
      display: flex;
      gap: 8px;
    }

    .related-slider__arrows .arrow {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #ccc;
      background: #fff;
      cursor: pointer;
    }
  </style>

</section>







{% schema %}
{
  "name": "Related Blog posts Slider",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Section Short Copy",
      "default": "Short Copy"
    },
    {
      "id": "intro",
      "type": "text",
      "label": "Section Intro",
      "default": "Introduction to posts"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Select blog"
    },
    {
      "id": "show_scrollbar",
      "type": "checkbox",
      "label": "Show horizontal scrollbar",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Related Blog posts Slider",
      "category": "Blog"
    }
  ]
}
{% endschema %}
