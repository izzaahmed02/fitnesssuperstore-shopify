{{ 'section-reviews.css' | asset_url | stylesheet_tag }}

<script>
  document.addEventListener("DOMContentLoaded", async (event) => {
    const reviewsWrapper = document.querySelector('.reviews-slider');
    let aggrReviews = [];
  
    try {
      // Fetch aggregated reviews
      const aggrReviewsResponse = await fetch('https://fitnesssuperstore-api.azurewebsites.net/api/reviews/aggregatedreviews');
      if (aggrReviewsResponse.ok) {
        aggrReviews = await aggrReviewsResponse.json();
      } else {
        console.error("Failed to fetch aggregated reviews.");
      }
    } catch (error) {
      console.error("Error fetching reviews:", error);
    }
  
    // Generate reviews HTML


    const reviewsHTML = aggrReviews.reduce((accumulator, item) => {
      return accumulator + `<div class="review-item">
            <div class="review-item__wrapper">
            <div class="stars">
              <div class="Stars" style="--rating: ${item.rating};" aria-label="Rating of this product is ${item.rating} out of 5."></div>
            </div>
            <span class="review-text">
              ${item.comment}
            </span>
            <span class="read-more">Read more</span>
            <span class="name">${item.reviewer}</span>
            <span class="buyer">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.00013 0.484375C7.68003 0.484375 7.41346 0.604673 7.16798 0.7668C6.94008 0.91732 6.68695 1.13431 6.39575 1.38395L6.37316 1.40331L5.90314 1.80618C5.59787 2.06784 5.53488 2.11237 5.47035 2.13624C5.40582 2.16011 5.32902 2.1673 4.92695 2.1673L4.64399 2.1673L4.61107 2.1673C4.16783 2.16727 3.78592 2.16725 3.48009 2.20837C3.15234 2.25243 2.83816 2.35181 2.58333 2.60664C2.3285 2.86147 2.22913 3.17564 2.18506 3.5034C2.14394 3.80923 2.14397 4.19114 2.14399 4.63438L2.14399 4.6673V4.93388C2.14399 5.33249 2.13692 5.40866 2.11342 5.47273C2.08993 5.53681 2.04608 5.59949 1.78839 5.9036L1.38095 6.38443L1.36187 6.40695C1.11655 6.69641 0.903191 6.94818 0.755181 7.17471C0.595709 7.41879 0.477539 7.68342 0.477539 8.00063C0.477539 8.31784 0.595709 8.58247 0.755181 8.82655C0.903194 9.05309 1.11656 9.30486 1.36188 9.59433L1.38095 9.61683L1.78839 10.0977C2.04608 10.4018 2.08993 10.4645 2.11342 10.5285C2.13692 10.5926 2.14399 10.6688 2.14399 11.0674L2.14399 11.334L2.14399 11.3669C2.14397 11.8101 2.14394 12.192 2.18506 12.4979C2.22913 12.8256 2.3285 13.1398 2.58333 13.3946C2.83816 13.6495 3.15234 13.7488 3.4801 13.7929C3.78593 13.834 4.16784 13.834 4.61109 13.834L4.64399 13.834H4.92695C5.32902 13.834 5.40582 13.8412 5.47035 13.865C5.53488 13.8889 5.59787 13.9334 5.90314 14.1951L6.37316 14.5979L6.39575 14.6173C6.68696 14.8669 6.94008 15.0839 7.16798 15.2345C7.41346 15.3966 7.68003 15.5169 8.00014 15.5169C8.32024 15.5169 8.58681 15.3966 8.83229 15.2345C9.06019 15.0839 9.31332 14.8669 9.60452 14.6173L9.62711 14.5979L10.0971 14.1951C10.4024 13.9334 10.4654 13.8889 10.5299 13.865C10.5944 13.8411 10.6713 13.834 11.0733 13.834H11.3335L11.3664 13.834C11.8096 13.834 12.1915 13.834 12.4974 13.7929C12.8251 13.7488 13.1393 13.6495 13.3941 13.3946C13.649 13.1398 13.7483 12.8256 13.7924 12.4979C13.8335 12.192 13.8335 11.8101 13.8335 11.3669L13.8335 11.334V11.0738C13.8335 10.6717 13.8407 10.5949 13.8645 10.5304C13.8884 10.4659 13.9329 10.4029 14.1946 10.0976L14.5975 9.62761L14.6168 9.60501L14.6168 9.605C14.8665 9.3138 15.0834 9.06068 15.234 8.83278C15.3961 8.58731 15.5164 8.32073 15.5164 8.00063C15.5164 7.68053 15.3961 7.41395 15.234 7.16848C15.0834 6.94057 14.8665 6.68745 14.6168 6.39624L14.5975 6.37365L14.1946 5.90363C13.9329 5.59836 13.8884 5.53537 13.8645 5.47085C13.8407 5.40632 13.8335 5.32951 13.8335 4.92745V4.6673L13.8335 4.63439C13.8335 4.19114 13.8335 3.80923 13.7924 3.5034C13.7483 3.17564 13.649 2.86147 13.3941 2.60664C13.1393 2.3518 12.8251 2.25243 12.4974 2.20837C12.1915 2.16725 11.8096 2.16727 11.3664 2.1673L11.3335 2.1673H11.0733C10.6713 2.1673 10.5944 2.16011 10.5299 2.13624C10.4654 2.11237 10.4024 2.06784 10.0971 1.80618L9.62711 1.40331L9.60452 1.38395C9.31332 1.13431 9.06019 0.91732 8.83229 0.7668C8.58681 0.604673 8.32024 0.484375 8.00013 0.484375ZM11.1973 5.4703C11.4901 5.76319 11.4901 6.23806 11.1973 6.53096L7.86392 9.86429C7.72327 10.0049 7.5325 10.084 7.33359 10.084C7.13468 10.084 6.94391 10.0049 6.80326 9.86429L5.46993 8.53096C5.17703 8.23806 5.17703 7.76319 5.46993 7.4703C5.76282 7.1774 6.23769 7.1774 6.53059 7.4703L7.33359 8.2733L10.1366 5.4703C10.4295 5.1774 10.9044 5.1774 11.1973 5.4703Z" fill="#00A344"/>
              </svg>
  
              Verified buyer
            </span>
            </div>
          </div>`;
    }, '');
    
    reviewsWrapper.innerHTML = reviewsHTML;
  
    // Initialize Slick Slider
    $('.reviews-slider').slick({
      dots: false,
      infinite: false,
      slidesToShow: 3,
      slidesToScroll: 1,
      appendArrows: $('.slick-slider-nav'),
      appendDots: $('.slick-slider-dots'),
      prevArrow: `<button class='slick-prev btn btn-white rounded-circle'><svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="24" fill="#616166"/>
      <path fill-rule="evenodd" clip-rule="evenodd" d="M26.5303 17.4697C26.8232 17.7626 26.8232 18.2374 26.5303 18.5303L21.0607 24L26.5303 29.4697C26.8232 29.7626 26.8232 30.2374 26.5303 30.5303C26.2374 30.8232 25.7626 30.8232 25.4697 30.5303L19.4697 24.5303C19.1768 24.2374 19.1768 23.7626 19.4697 23.4697L25.4697 17.4697C25.7626 17.1768 26.2374 17.1768 26.5303 17.4697Z" fill="#B3B3B3"/>
      </svg></svg></button>`,
      nextArrow: `<button class='slick-next btn btn-white rounded-circle'><svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="48" height="48" rx="24" fill="#616166"/>
      <path fill-rule="evenodd" clip-rule="evenodd" d="M21.4697 17.4697C21.7626 17.1768 22.2374 17.1768 22.5303 17.4697L28.5303 23.4697C28.8232 23.7626 28.8232 24.2374 28.5303 24.5303L22.5303 30.5303C22.2374 30.8232 21.7626 30.8232 21.4697 30.5303C21.1768 30.2374 21.1768 29.7626 21.4697 29.4697L26.9393 24L21.4697 18.5303C21.1768 18.2374 21.1768 17.7626 21.4697 17.4697Z" fill="white"/>
      </svg>
      </button>`,

  {% if section.settings.mobile_layout == 'slider' %}
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 1,
            dots: true,
          }
        }
      ]
    {% else %}
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
          }
        },
        {
          breakpoint: 600,
          settings: "unslick"
        }
      ]
    {% endif %}
    });
  
    // Implement "Read More" functionality
    const reviewTexts = document.querySelectorAll(".review-text");
    reviewTexts.forEach(function (reviewText) {
      const maxLines = 3;
      const lineHeight = parseInt(window.getComputedStyle(reviewText).lineHeight);
      const maxHeight = lineHeight * maxLines;
      const readMoreBtn = reviewText.nextElementSibling;
  
      if (reviewText.scrollHeight > maxHeight) {
        reviewText.style.maxHeight = `${maxHeight}px`;
        reviewText.style.overflow = "hidden";
        readMoreBtn.style.display = "inline";
  
        let isExpanded = false;
        readMoreBtn.addEventListener("click", function () {
          if (isExpanded) {
            reviewText.style.maxHeight = `${maxHeight}px`;
            readMoreBtn.textContent = "Read more";
          } else {
            reviewText.style.maxHeight = `${reviewText.scrollHeight}px`;
            readMoreBtn.textContent = "Show less";
          }
          isExpanded = !isExpanded;
        });
      } else {
        readMoreBtn.style.display = "none";
      }
    });
  });
  
  {% if request.design_mode %}
    document.addEventListener('shopify:section:load', async () => {
      const reviewsWrapper = document.querySelector('.reviews-slider');
      
      const aggrReviewsResponse = await fetch('https://fitnesssuperstore-api.azurewebsites.net/api/reviews/aggregatedreviews');
      if (aggrReviewsResponse.ok) {
        const aggrReviews = await aggrReviewsResponse.json();
    
        const reviewsHTML = aggrReviews.reduce((accumulator, item) => {
          return accumulator + `<div class="review-item">
                  <div class="review-item__wrapper">
                  <div class="stars">
                    <div class="Stars" style="--rating: ${item.rating};" aria-label="Rating of this product is ${item.rating} out of 5."></div>
                  </div>
                  <span class="name">${item.reviewer}</span>
                  <span class="review-date">${item.dateReviewed}</span>
                  <span class="review-text">
                    ${item.comment}
                  </span>
                  </div>
                </div>`;
        }, '');
        
        reviewsWrapper.innerHTML = reviewsHTML;  
      }
    });
  {% endif %}
</script>

<div class="container">
  <h2 class="title">{{ section.settings.title }}</h2>
  <p class="text">{{ section.settings.text }}</p>
  <div class="reviews-slider__wrapper">
    <div class="reviews-slider"></div>

    <div class="slick-slider-dots">
      <div class="slick-slider-nav"></div>
    </div>

    {% if section.settings.mobile_layout == 'blocks' %}
      <a href="/pages/reviews">
        See more
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="#F1592A"/>
        </svg>
      </a>
    {% endif %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }}{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg }};
    padding-left: 15px;
    padding-right: 15px;
  }

  #shopify-section-{{ section.id }} .container{
    padding: 0px 60px;
  }

  #shopify-section-{{ section.id }} .title{
    font-size: 48px;
    font-weight: 600;
    color: #23232B;
    line-height: 68px;
    margin-bottom: 52px;
    text-align: center;
  }

  @media(max-width: 600px){
    #shopify-section-{{ section.id }}{
      padding-block: 24px;
      padding-bottom: 30px;
    }
    #shopify-section-{{ section.id }} .slick-slider-nav svg{
      width: 36px;
      height: 36px;
    }
    #shopify-section-{{ section.id }} .slick-slider-nav button{
      width: 36px;
      height: 36px;
    }
    #shopify-section-{{ section.id }} .slick-prev{
      transform: none;
    }
    #shopify-section-{{ section.id }} .slick-next{
      transform: none;
    }
    .slick-slider-dots{
      position: static;
    }
    .slick-slider-dots{
      transform: none;
    }
  }
  @media(max-width: 767px){
    #shopify-section-{{ section.id }} .slick-list{
      padding-right: 0;
    }
    #shopify-section-{{ section.id }} .review-item{
      margin-right: 0;
      height: auto;
    }
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} .container{
      padding: 0px;
    }

    #shopify-section-{{ section.id }}.reviews-slider-section .title {
      font-size: 20px !important;
      line-height: 26px !important;
      text-align: start; 
      margin-bottom: 20px;
    }

    {% if section.settings.mobile_layout == 'blocks' %}
      .reviews-slider div:nth-child(n+4) {
        display: none;
      }

      .reviews-slider {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
    {% endif %}
  }
</style>

{% schema %}
{
  "name": "Reviews slider section",
  "class": "reviews-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "blocks",
          "label": "Blocks"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Reviews slider section"
    }
  ]
}
{% endschema %}
