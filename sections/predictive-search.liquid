<div id="glFilter-search-popup" class="ui-menu glFilter-search-popup gl-filter-search-fullscreen gl-filter-animate" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
  <div class="gl-backdrop gl-close-layer"></div>
  <div class="gl-fullscreen-layer gl-animate-transition" tabindex="-1">

    <!-- Search Header -->
    <div class="gl-fullscreen-header">
      <form class="gl-d-searchbox" method="GET" action="{{ routes.search_url }}" role="search">
        <label class="gl-icon gl-d-searchbox-icon" for="globo-search-input">
          {{ 'icon-search.svg' | inline_asset_content }}
        </label>
        <input
          type="text"
          class="gl-d-searchbox-input"
          id="globo-search-input"
          placeholder="{{ 'general.search.search' | t }}"
          name="q"
          value="{{ search.terms | escape }}"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        >
      </form>

      <button type="button" class="gl-d-close-btn" aria-label="{{ 'accessibility.close' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    <!-- Predictive Suggestions -->
    <div class="gl-fullscreen-suggestions predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
      {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}

      {%- if predictive_search.performed -%}
        <div id="predictive-search-results" role="listbox">
          <div class="gl-row">
            <!-- Maybe you're looking for (Queries & Collections) -->
            <div class="gl-col-left">
              {%- if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 -%}
              <div class="gl-list gl-fullscreen-top-searches">
                <div class="gl-list__group">
                  <div class="gl-list__title">{{ 'templates.search.suggestions' | t }}</div>
                  <div class="gl-list__content">
                    <ul>
                      {%- for query in predictive_search.resources.queries -%}
                        <li><a href="{{ query.url }}">{{ query.text }}</a></li>
                      {%- endfor -%}
                      {%- for collection in predictive_search.resources.collections -%}
                        <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              </div>
              {%- endif -%}
            </div>

            <!-- Trending Products (Product Results) -->
            <div class="gl-col-right">
              {%- if predictive_search.resources.products.size > 0 -%}
              <div class="gl-list gl-fullscreen-top-clicked">
                <div class="gl-fullscreen-results__meta">
                  <div class="gl-list__title">{{ 'templates.search.products' | t }}</div>
                </div>
                <div class="gl-list__content">
                  <div class="gl-fullscreen-results__content">
                    {%- for product in predictive_search.resources.products -%}
                      {% render 'search-product-card', product: product %}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Static Initial Content (Optional static suggestions) -->
    <div class="gl-fullscreen-initial-content">
      <div class="gl-row">
        <div class="gl-col-left">
          <div class="gl-list gl-fullscreen-top-searches">
            <div class="gl-list__group">
              <div class="gl-list__title">Maybe you’re looking for</div>
              <div class="gl-list__content">
                <ul>
                  <li><a href="/search?q=fsr90">fsr90</a></li>
                  <li><a href="/search?q=leg+press">leg press</a></li>
                  <li><a href="/search?q=smith+machine">smith machine</a></li>
                  <li><a href="/search?q=lat+pulldown">lat pulldown</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="gl-col-right">
          <div class="gl-list gl-fullscreen-top-clicked">
            <div class="gl-fullscreen-results__meta">
              <div class="gl-list__title">Trending products</div>
            </div>
            <div class="gl-list__content">
              <div class="gl-fullscreen-results__content">
                {% render 'search-product-card', product: all_products['french-fitness-tahoe-seated-leg-curl-leg-extension-new'] %}
                {% render 'search-product-card', product: all_products['french-fitness-fsr90-functional-trainer-smith-squat-rack-machine-new'] %}
                {% render 'search-product-card', product: all_products['bowflex-treadclimber-tc5000-remanufactured'] %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>

  </div>
</div>
