{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 2, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Self-contained per spec R3: own scoped CSS, no shared stylesheet import.
  Deliberately does NOT reference assets/homepage-section-hero.css or
  assets/fss-hp-device-targeting.css (spec R2), and does NOT load
  assets/fss-hp-analytics.js — the helper stays on the mobile branch until S2
  and desktop inherits it at S4 (spec §8). The data-fss-hp-* attributes below
  are therefore inert during S1; that is expected.

  This section owns the single <h1> for the Variant B desktop set (spec R5).
  All customer-facing copy is a schema value — content approval from Larianne
  and Carlos is still open, so nothing is hardcoded in markup.
{% endcomment %}

<div class="fssd-hero">
  {%- if section.settings.background_image != blank -%}
    {%- comment -%}
      Decorative background. alt intentionally falls back to empty rather than
      repeating the H1 for screen-reader users.
    {%- endcomment -%}
    <img
      class="fssd-hero__image"
      src="{{ section.settings.background_image | image_url: width: 1600 }}"
      srcset="
        {{ section.settings.background_image | image_url: width: 800 }} 800w,
        {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
        {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
        {{ section.settings.background_image | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      alt="{{ section.settings.background_image.alt | escape }}"
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  {%- endif -%}

  <div class="fssd-hero__scrim"></div>

  <div class="fssd-hero__content">
    {%- if section.settings.rating_text != blank -%}
      {%- if section.settings.rating_link != blank -%}
        <a
          class="fssd-hero__rating"
          href="{{ section.settings.rating_link }}"
          aria-label="{{ section.settings.rating_text | escape }}"
        >
          <span class="fssd-hero__stars" aria-hidden="true">{% render 'rating' %}</span>
          <span class="fssd-hero__rating-text">{{ section.settings.rating_text }}</span>
        </a>
      {%- else -%}
        <span class="fssd-hero__rating">
          <span class="fssd-hero__stars" aria-hidden="true">{% render 'rating' %}</span>
          <span class="fssd-hero__rating-text">{{ section.settings.rating_text }}</span>
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.title_text != blank -%}
      {%- comment -%}
        Bind the final two words with a non-breaking space so the last word is
        never orphaned on a line of its own. replace_last only touches the last
        space, so this is generic: a one-word heading is unchanged, and any
        other heading simply keeps its final two words together. The heading
        string itself is never hardcoded.
      {%- endcomment -%}
      <h1 class="fssd-hero__title">{{ section.settings.title_text | replace_last: ' ', '&nbsp;' }}</h1>
    {%- endif -%}

    {%- if section.settings.copy_text != blank -%}
      <p class="fssd-hero__copy">{{ section.settings.copy_text }}</p>
    {%- endif -%}

    <div class="fssd-hero__actions">
      {%- if section.settings.cta_primary_text != blank -%}
        <a
          class="fssd-hero__cta fssd-hero__cta--primary"
          href="{{ section.settings.cta_primary_link }}"
          data-fss-hp-event="fss_hp_primary_cta"
          data-fss-hp-props='{"condition": {{ section.settings.cta_primary_condition | json | escape }}}'
        >
          {{ section.settings.cta_primary_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.cta_secondary_text != blank -%}
        <a
          class="fssd-hero__cta fssd-hero__cta--secondary"
          href="{{ section.settings.cta_secondary_link }}"
          data-fss-hp-event="fss_hp_primary_cta"
          data-fss-hp-props='{"condition": {{ section.settings.cta_secondary_condition | json | escape }}}'
        >
          {{ section.settings.cta_secondary_text }}
        </a>
      {%- endif -%}

      {%- comment -%}
        Browse French Fitness: tertiary ghost CTA inside the action group, not a
        text link. Shares .fssd-hero__cta so height, padding, radius, hover and
        focus match the two CTAs above; --tertiary only swaps the fill for a
        transparent, white-bordered treatment. No data-fss-hp-* attribute: spec
        §8 defines no event for the supporting link.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'supporting_link' and block.settings.text != blank -%}
          <a
            class="fssd-hero__cta fssd-hero__cta--tertiary"
            href="{{ block.settings.link }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .fssd-hero {
    --fssd-hero-ink: #ffffff;
    --fssd-hero-accent: #d83d0e;
    position: relative;
    display: flex;
    align-items: center;
    min-height: 420px;
    overflow: hidden;
    isolation: isolate;
  }
  /* 16px horizontal inset so the background no longer runs flush against the
     sidebar's right edge — matches the 16px gutter the other four fssd
     sections carry. Applied directly to the absolutely-positioned background
     layers, NOT via padding on .fssd-hero: inset: 0 resolves against the
     containing block's PADDING BOX, which includes the padding area, so
     horizontal padding on the parent cannot inset an absolute child — it
     would only push __content (the text) inward and break its alignment with
     the other sections. Both layers get the same inset so the scrim stays
     registered to the image. __content keeps its own centered max-width and
     16px padding, so the text still starts at the section's normal 476px. */
  .fssd-hero__image {
    position: absolute;
    inset: 0 16px;
    /* An <img> is a replaced element: left+right insets do NOT stretch it the
       way they stretch the non-replaced __scrim, so its width must be set
       explicitly to the inset box — the padding-box width minus the two 16px
       insets — or it collapses to its intrinsic size and ignores the inset. */
    width: calc(100% - 32px);
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }
  .fssd-hero__scrim {
    position: absolute;
    inset: 0 16px;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.45) 100%),
      linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.62) 68.4%);
  }
  .fssd-hero__content {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    /* Horizontal padding = 16px (clears the photo's own 16px inset above) +
       20px to sit the text INSIDE the photo, matching Control's hero, where
       the text block is padded 20px within the image box
       (homepage-section-hero.css / section inline style:
       .image-wrapper .content { padding: 20px 20px }). Our __content is a
       full-width overlay rather than nested in the inset image box, so the
       photo's 16px inset must be added back here; 16 + 20 = 36. At 16px the
       headline landed flush on the photo edge (h1 left == image left). */
    padding: 56px 36px;
    color: var(--fssd-hero-ink);
  }
  .fssd-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: inherit;
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
  }
  .fssd-hero__rating-text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .fssd-hero__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .fssd-hero__stars svg {
    display: block;
    width: 16px;
    height: 16px;
  }
  /* Constrains only the h1 -- __copy (56ch) and the CTA row keep their own
     measure. 18ch was too narrow for "Shop New & Remanufactured" and forced a
     third line. 26ch fits that phrase while staying well short of the full
     heading, so the break falls after "Remanufactured". A different heading
     simply reflows; nothing breaks. */
  .fssd-hero__title {
    max-width: 26ch;
    margin: 0 0 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 68px;
    color: inherit;
  }
  .fssd-hero__copy {
    max-width: 56ch;
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 24px;
  }
  .fssd-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .fssd-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 28px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .fssd-hero__cta--primary {
    background-color: var(--fssd-hero-accent);
    border-color: var(--fssd-hero-accent);
    color: #ffffff;
  }
  .fssd-hero__cta--secondary {
    background-color: #ffffff;
    border-color: #ffffff;
    color: var(--fssd-hero-accent);
  }
  .fssd-hero__cta:hover {
    opacity: 0.92;
  }
  .fssd-hero__cta--tertiary {
    background-color: transparent;
    border-color: #ffffff;
    color: #ffffff;
  }
  .fssd-hero a:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  /* Mobile: match Control's hero, which goes full-bleed at <=768px
     (homepage-section-hero.css: @media (max-width: 768px) .hero-section
     { padding: 0 }) with the text still 20px inside the photo
     (.image-wrapper .content { padding: 20px 20px }, NOT overridden at
     mobile — Control's 768px block only changes its gap — so Control's
     content vertical stays 20px and there is no mobile vertical change to
     match; our own 40px vertical rhythm is kept). Breakpoint is 768px, not
     the 749px the other fssd sections use, to line up with Control's
     full-bleed rule. Full-bleed here means undoing the desktop 16px inset
     AND the width that inset required, so the photo spans edge to edge:
     otherwise the 16px image inset and 16px content padding cancel and the
     headline sits flush on the photo edge (the desktop defect, at mobile). */
  @media screen and (max-width: 768px) {
    .fssd-hero__image,
    .fssd-hero__scrim {
      inset: 0;
    }
    .fssd-hero__image {
      width: 100%;
    }
    .fssd-hero__content {
      padding: 40px 20px;
    }
    .fssd-hero__title {
      font-size: 36px;
      line-height: 48px;
    }
    .fssd-hero__cta {
      flex: 1 1 200px;
    }
  }
</style>

{% schema %}
{
  "name": "Desktop Hero",
  "class": "fssd-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "info": "Intentionally blank per Tim's Aug 5 review — leave empty until the approved review source and exact wording are supplied. The whole rating block renders nothing while this is blank."
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Rating Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Heading (renders as the page H1)",
      "default": "Shop New & Remanufactured Gym Equipment"
    },
    {
      "type": "textarea",
      "id": "copy_text",
      "label": "Body Copy",
      "default": "Compare new and remanufactured commercial gym equipment across cardio, strength, and free weights."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA Text",
      "default": "Shop Remanufactured"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "select",
      "id": "cta_primary_condition",
      "label": "Primary CTA condition (fss_hp_primary_cta property)",
      "options": [
        { "value": "remanufactured", "label": "Remanufactured" },
        { "value": "new", "label": "New" }
      ],
      "default": "remanufactured"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA Text",
      "default": "Shop New Equipment"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "select",
      "id": "cta_secondary_condition",
      "label": "Secondary CTA condition (fss_hp_primary_cta property)",
      "options": [
        { "value": "remanufactured", "label": "Remanufactured" },
        { "value": "new", "label": "New" }
      ],
      "default": "new"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "supporting_link",
      "name": "Supporting Text Link",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "Browse French Fitness"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop Hero",
      "category": "Custom",
      "settings": {
        "rating_link": "/pages/reviews",
        "cta_primary_link": "/collections/products-remanufactured",
        "cta_secondary_link": "/collections/new-equipment"
      },
      "blocks": [
        {
          "type": "supporting_link",
          "settings": {
            "link": "/collections/french-fitness"
          }
        }
      ]
    }
  ]
}
{% endschema %}
