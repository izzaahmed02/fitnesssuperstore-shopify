<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>
{{ 'homepage-faqs.css' | asset_url | stylesheet_tag }}
{{ 'accordion.css' | asset_url | stylesheet_tag }}
<div class="page-width">
<div class="process-steps-section">
  {% if section.settings.section_heading %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}
  <div class="process-steps-wrapper">

    <!-- LEFT SIDE NAV -->
    <div class="process-steps-nav">
      {% for block in section.blocks %}
        <div 
          class="process-nav-item {% if forloop.first %}active{% endif %}" 
          data-target="step-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="process-nav-number">
            {{ block.settings.heading }}
          </div>
          
        </div>
      {% endfor %}
    </div>

    <!-- RIGHT SIDE CONTENT -->
    <div class="process-steps-content">
      {% for block in section.blocks %}
        <div id="step-{{ forloop.index0 }}" class="process-step-block">
          <h2 class="process-step-heading">
            <span>
                {{ block.settings.heading | split: '(' | first | strip }}
            </span>
            {% if block.settings.heading_blue != blank %}
            <span class="headling-blue">
                {{ block.settings.heading_blue }}
                </span>
            {% endif %}
          </h2>

          {% assign has_message2 = block.settings.text | strip_html | strip %}
            {% assign has_text2 = block.settings.text_text | strip %}
            {% if has_message2 != blank or has_text2 != blank %}
          <div class="process-step-text">
            {{ block.settings.text }}
          </div>
        {% endif %}

          {% if block.settings.block_ul_title != blank %}
            <div class="process-step-ul rte">
                {% if block.settings.block_ul_title != blank %}
                    <h3 class="process-step-ul-title">
                        {{ block.settings.block_ul_title }}
                    </h3>
                {% endif %}
                {% if block.settings.block_ul_text != blank %}
                    {{ block.settings.block_ul_text }}
                {% endif %}
            </div>
            {% endif %}

            {% assign has_message1 = block.settings.block_important | strip_html | strip %}
            {% assign has_text1 = block.settings.block_important_text | strip %}
            {% if has_message1 != blank or has_text1 != blank %}

                <div class="process-step-important">
                    <h3 class="process-step-important-title" style="color: {{ block.settings.text_color }};">
                      {% if block.settings.show_icon %}
                      <span class="icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M9.75 0C15.1348 0 19.5 4.36522 19.5 9.75C19.5 15.1348 15.1348 19.5 9.75 19.5C4.36522 19.5 0 15.1348 0 9.75C0 4.36522 4.36522 0 9.75 0ZM9.75 1.5C5.19365 1.5 1.5 5.19365 1.5 9.75C1.5 14.3063 5.19365 18 9.75 18C14.3063 18 18 14.3063 18 9.75C18 5.19365 14.3063 1.5 9.75 1.5ZM9.75 12.75C10.3023 12.75 10.75 13.1977 10.75 13.75C10.75 14.3023 10.3023 14.75 9.75 14.75C9.19771 14.75 8.75 14.3023 8.75 13.75C8.75 13.1977 9.19771 12.75 9.75 12.75ZM9.75 5C11.2688 5 12.5 6.23122 12.5 7.75V7.87109C12.5 8.63251 12.1975 9.36291 11.6592 9.90137L10.2803 11.2803C9.98738 11.5732 9.51262 11.5732 9.21973 11.2803C8.92683 10.9874 8.92683 10.5126 9.21973 10.2197L10.5986 8.84082C10.8557 8.58367 11 8.23468 11 7.87109V7.75C11 7.05964 10.4404 6.5 9.75 6.5C9.05964 6.5 8.5 7.05964 8.5 7.75V8.25C8.5 8.66421 8.16421 9 7.75 9C7.33579 9 7 8.66421 7 8.25V7.75C7 6.23122 8.23122 5 9.75 5Z" fill="#D83D0E"/>
                        </svg>
                      </span>
                    {% endif %}
                        {{ block.settings.block_important }}
                    </h3>
                  
                        {{ block.settings.block_important_text }}
                    
                </div>
            {%  endif %}

            {% if block.settings.block_message_text_bottom != blank %}
              <div class="process-step-bottom-text">
            
            <p>{{ block.settings.block_message_text_bottom }}</p>
             </div>
            {% endif %}

            
             
            {% assign has_message = block.settings.block_message | strip_html | strip %}
            {% assign has_text = block.settings.block_message_text | strip %}
            {% if has_message != blank or has_text != blank %}

                <div class="process-step-message">
                    <h3 class="process-step-message-title">
                      {% if block.settings.show_icons %}
                      <span class="icon">
                        <svg width="21" height="19" viewBox="0 0 21 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10.2048 0C11.1278 0.00010274 11.8015 0.555453 12.3777 1.2793C12.9495 1.9978 13.5584 3.05425 14.3152 4.36133L18.3777 11.3779C19.1371 12.6897 19.752 13.7474 20.0915 14.6035C20.4334 15.4659 20.5798 16.3302 20.1179 17.1318C19.6557 17.9331 18.8351 18.2388 17.9177 18.375C17.0067 18.5102 15.7832 18.5078 14.2673 18.5078H6.14231C4.62642 18.5078 3.40296 18.5102 2.49192 18.375C1.57439 18.2388 0.754016 17.9332 0.291726 17.1318C-0.170352 16.3302 -0.0237862 15.4659 0.318093 14.6035C0.657611 13.7474 1.27258 12.6896 2.03196 11.3779L6.09446 4.36133C6.85113 3.05435 7.46019 1.99776 8.03196 1.2793C8.60808 0.555508 9.2818 0 10.2048 0ZM10.2048 1.5C9.975 1.5 9.68719 1.60908 9.20579 2.21387C8.71993 2.82441 8.17434 3.76251 7.39231 5.11328L3.32981 12.1299C2.54509 13.4853 2.00124 14.4294 1.71262 15.1572C1.42695 15.878 1.47591 16.1826 1.59055 16.3818C1.70546 16.5811 1.94461 16.7766 2.71262 16.8906C3.48718 17.0055 4.57599 17.0078 6.14231 17.0078H14.2673C15.8336 17.0078 16.9225 17.0056 17.697 16.8906C18.4648 16.7766 18.7042 16.5811 18.8191 16.3818C18.9336 16.1826 18.9826 15.8778 18.697 15.1572C18.4084 14.4293 17.8646 13.4854 17.0798 12.1299L13.0173 5.11328C12.2352 3.76239 11.6897 2.82444 11.2038 2.21387C10.7225 1.60908 10.4346 1.50008 10.2048 1.5ZM10.2048 12.7578C10.7568 12.758 11.2046 13.2058 11.2048 13.7578C11.2048 14.31 10.757 14.7577 10.2048 14.7578C9.65253 14.7578 9.20481 14.3101 9.20481 13.7578C9.20506 13.2057 9.65268 12.7578 10.2048 12.7578ZM10.2048 6.00781C10.6188 6.00795 10.9546 6.3439 10.9548 6.75781V10.7578C10.9548 11.1719 10.6189 11.5077 10.2048 11.5078C9.7906 11.5078 9.45481 11.172 9.45481 10.7578V6.75781C9.45506 6.34381 9.79075 6.00781 10.2048 6.00781Z" fill="#D83D0E"/>
                        </svg>
                      </span>
                    {% endif %}
                        {{ block.settings.block_message }}
                    </h3>
                    
                        {{ block.settings.block_message_text }}
                  
                </div>
            {%  endif %}

             {% if block.settings.message_title != blank %}
            <div class="process-step-affirm rte">
                    <h3 class="process-step-ul-title">
                        {{ block.settings.message_title }}
                    </h3>
                {% if block.settings.message_text != blank %}
                    {{ block.settings.message_text }}
                {% endif %}
            </div>
            {% endif %}

             {% if block.settings.message1_title != blank %}
            <div class="process-step-paypal rte">
                    <h3 class="process-step-ul-title">
                        {{ block.settings.message1_title }}
                    </h3>
                {% if block.settings.message1_text != blank %}
                    {{ block.settings.message1_text }}
                {% endif %}
            </div>
            {% endif %}
             {% if block.settings.message2_title != blank %}
            <div class="process-step-affirm rte">
                    <h3 class="process-step-ul-title">
                        {{ block.settings.message2_title }}
                    </h3>
                {% if block.settings.message2_text != blank %}
                    {{ block.settings.message2_text }}
                {% endif %}
            </div>
            {% endif %}

             {% if block.settings.message3_title != blank %}
            <div class="process-step-paypal rte">
                    <h3 class="process-step-ul-title">
                        {{ block.settings.message3_title }}
                    </h3>
                {% if block.settings.message3_text != blank %}
                    {{ block.settings.message3_text }}
                {% endif %}
            </div>
            {% endif %}


            {% if block.settings.gird_icons %}
              <div class="blocks-grid__wrapper grid grid--1-col-tablet-down grid--2-col-desktop">
              
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon1 != blank %}
                            <img src="{{ block.settings.icon1 | img_url: 'master' }}"
                                    {% if block.settings.icon1.alt %}
                                        alt="{{ block.settings.icon1.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon1.width }}"
                                    height="{{ block.settings.icon1.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title1 != blank %}
                                <h2 class="h4">{{ block.settings.title1 }}</h2>
                            {% endif %}
                            {% if block.settings.text1 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text1 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon2 != blank %}
                            <img src="{{ block.settings.icon2 | img_url: 'master' }}"
                                    {% if block.settings.icon2.alt %}
                                        alt="{{ block.settings.icon2.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon2.width }}"
                                    height="{{ block.settings.icon2.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title2 != blank %}
                                <h2 class="h4">{{ block.settings.title2 }}</h2>
                            {% endif %}
                            {% if block.settings.text2 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text2 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon3 != blank %}
                            <img src="{{ block.settings.icon3 | img_url: 'master' }}"
                                    {% if block.settings.icon3.alt %}
                                        alt="{{ block.settings.icon3.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title3 != blank %}
                                <h2 class="h4">{{ block.settings.title3 }}</h2>
                            {% endif %}
                            {% if block.settings.text3 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text3 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon4 != blank %}
                            <img src="{{ block.settings.icon4 | img_url: 'master' }}"
                                    {% if block.settings.icon4.alt %}
                                        alt="{{ block.settings.icon4.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title4 != blank %}
                                <h2 class="h4">{{ block.settings.title4 }}</h2>
                            {% endif %}
                            {% if block.settings.text4 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text4 }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if block.settings.tab_content %}
              <div class="tabs section-{{ section.id }}-padding scroll-trigger animate--slide-in" data-tabs-section>
              <div class="tabs__container">
             <div class="tabs__header">
              <div class="tabs__buttons {% if section.settings.mobile_layout == 'dropdowns' %}mobile--hidden{% endif %}">
          
             <button class="tab-btn active" data-index="1">
              {{ block.settings.tab_title1 }}
             </button>
             <button class="tab-btn {% if forloop.first %}active{% endif %}" data-index="2">
              {{ block.settings.tab_title2 }}
             </button>
             <button class="tab-btn {% if forloop.first %}active{% endif %}" data-index="3">
              {{ block.settings.tab_title3 }}
             </button>
         
              </div>
              </div>

                <div class="tabs__content {% if section.settings.mobile_layout == 'dropdowns' %}dropdown-layout{% endif %}">
                <div class="tabs__item {% if block.settings.image_second %}image-second{% endif %} active visible" data-index="1">
                    <div class="tabs__item-wrapper">
            
                <div class="tabs__item-content {% if section.settings.mobile_layout == 'dropdowns' %}dropdown-content{% endif %}">
                {% if block.settings.title != blank %}
                  <div class="{% if section.settings.mobile_layout == 'dropdowns' %}dropdown-btn{% endif %}">
                    <h3 class="h3">
                      {{ block.settings.tab_title_inner }}
                    </h3>
                    <svg
                      class="dropdown-arrow"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M5.46967 8.46967C5.76256 8.17678 6.23744 8.17678 6.53033 8.46967L12 13.9393L17.4697 8.46967C17.7626 8.17678 18.2374 8.17678 18.5303 8.46967C18.8232 8.76256 18.8232 9.23744 18.5303 9.53033L12.5303 15.5303C12.2374 15.8232 11.7626 15.8232 11.4697 15.5303L5.46967 9.53033C5.17678 9.23744 5.17678 8.76256 5.46967 8.46967Z" fill="black"/>
                    </svg>
                  </div>
                {% else %}
                  <div class="{% if section.settings.mobile_layout == 'dropdowns' %}dropdown-btn {% endif %} desktop--hidden">
                    <h3 class="h3">
                      {{ block.settings.tab_title }}
                    </h3>
                    <svg
                      class="dropdown-arrow"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M5.46967 8.46967C5.76256 8.17678 6.23744 8.17678 6.53033 8.46967L12 13.9393L17.4697 8.46967C17.7626 8.17678 18.2374 8.17678 18.5303 8.46967C18.8232 8.76256 18.8232 9.23744 18.5303 9.53033L12.5303 15.5303C12.2374 15.8232 11.7626 15.8232 11.4697 15.5303L5.46967 9.53033C5.17678 9.23744 5.17678 8.76256 5.46967 8.46967Z" fill="black"/>
                    </svg>
                  </div>
                {% endif %}
                {% if block.settings.title2 != blank %}
                  <h2 class="tabs__title h2">
                    {{ block.settings.tab_title_inner1 }}
                  </h2>
                {% endif %}

                <div class="dropdown-content-wrapper">
                  {% if block.settings.content_img != blank %}
                    <div class="tabs__item-image-container">
                      <img
                        src="{{ block.settings.content_img | img_url: "master"  }}"
                        alt="{{ block.settings.content_img.alt }}"
                        loading="lazy"
                        width="{{ block.settings.content_img.width }}"
                        height="{{ block.settings.content_img.height }}"
                      >
                    </div>
                  {% endif %}

