/* ── MOBILE OVERFLOW FIX ── */
@media (max-width: 990px) {

  /* Ensure the outer section never exceeds viewport */
  .process-steps-section,
  .process-steps-wrapper,
  .process-steps-content,
  .process-step-block {
    max-width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Tabs container: remove side padding that causes overflow */
  .tabs__content {
    padding: 0;
  }

  .tabs__item-wrapper,
  .tabs__item-content,
  .dropdown-content-wrapper {
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Grid items: force full width, no overflow */
  .process-step-block .blocks-grid__wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .process-step-block .blocks-grid__item {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }

  /* Callout box: prevent internal content from stretching */
  .callout-box {
    box-sizing: border-box;
    width: 100%;
  }

  .callout-box .choose-path-section__button {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* FAQ accordions */
  .homepage-faqs__accordions {
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Images inside blocks */
  .process-step-block img {
    max-width: 100%;
    height: auto;
  }

  /* Rich text content */
  .process-step-text,
  .process-step-text *,
  .process-step-ul.rte,
  .process-step-ul.rte * {
    max-width: 100%;
    word-break: break-word;
  }

  /* Process step important/message boxes */
  .process-step-important,
  .process-step-message {
    box-sizing: border-box;
    width: 100%;
  }

  .process-step-message {
    margin-top: 20px;
  }

