<style>

.process-container .page-width {
    padding: 0 16px;
}
.process-steps-section {
  padding: 36px 0;
}

.process-steps-content {
padding: 0 16px;
}

.process-steps-wrapper {
  display: grid;
  grid-template-columns: 279px 1fr;
  gap: 16px;
}

.process-steps-section .section-heading {
  font-size: 38px;
  line-height: 38px;
  letter-spacing: 0.38px;
  font-weight: 800;
  margin: 0px;
  margin-bottom: 44px;
  text-transform: capitalize;
}

/* LEFT SIDE */
.process-steps-nav {
  position: sticky;
  top: 150px;
  height: fit-content;
}

.process-nav-item {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  cursor: pointer;
}

/* Make each nav item relative for positioning */
.process-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px; /* space for connector + spacing */
  cursor: pointer;
}

/* Remove extra space on last item */
.process-nav-item:last-child {
  margin-bottom: 0;
}

.process-nav-number {
  font-family: var(--font-body-family);
  font-weight: 700;
  min-width: 48px;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #000000;
  border-radius: 8px;
  margin: 0px;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  width: 100%;
  text-align: left;
  padding: 12px;
  border: 1px solid #E5E5E5;
}

.process-nav-title {
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-weight: 800;
  color: #010101;
}

.process-step-important {
  border-left: 4px solid #D83D0E;
  padding-left: 20px;
  margin-bottom: 32px;
}

.process-step-important-title {
  font-family: var(--font-body-family);
  font-size: 18px;
  line-height: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0px;
  margin-bottom: 8px;
}

.process-step-important p {
  margin: 0px;
}

.process-step-important-title .icon {
  display: flex;
  align-items: center;
}

.process-step-message {
  background: #FCF6F4;
  border-radius: 12px;
  padding: 20px 24px;
}

.process-step-ul ol {
  list-style: none;         /* remove default numbers and dot */
  counter-reset: my-counter; /* start custom counter */
  padding-left: 0px;       /* space for numbers */
}

.installment-options-payment .process-step-ul ol li {
  margin-bottom: 8px;
}

/* Insert number before each item */
.process-step-ul ol li::before {
  content: counter(my-counter); /* show number only */
  position: absolute;
  left: 0;
  font-weight: bold;
  font-size: 11px;           /* optional */
}


.installment-options-payment .process-step-ul ol li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    background-color: #3e77aa;
    border-radius: 50%;
}

.process-step-message-title {
  margin: 0px;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  color: #D83D0E;
  font-family: var(--font-body-family);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
}

.icon svg {
  display: block;
}


.process-step-block .blocks-grid__wrapper {
  margin-top: 0px;
  gap: 12px;
  justify-content: space-between;
}

.callout-box {
  padding: 24px;
  border: 1px solid rgba(229, 229, 229, 1);
  border-radius: 20px;
  text-align:center;
  margin-top: 32px;
  }

.callout-title {
  font-family: var(--font-body-family);
  margin-top: 0;
  margin-bottom: 8px;
  color: #000;
  font-size: 20px;
  line-height: 26px;
  text-align: center;
}

.callout-box .choose-path-section__button {
  width:360px;
  max-width: 100%;
  margin: 0 auto;
}


@media screen and (min-width: 990px) {
