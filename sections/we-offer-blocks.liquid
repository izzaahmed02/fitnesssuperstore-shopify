<style>
  .gym-designer-hero {
    padding: 40px 16px;
    background-color: {{ section.settings.bg_color }};
    text-align: center;
  }
  
  .gym-designer-hero-title {
    font-size: 48px;
    font-weight: 600;
    line-height: 68px;
    margin: 0;
    color: {{ section.settings.title_color }};
    font-family: Oswald, sans-serif;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
  }

  .gym-designer-hero-description-container {
    padding: 16px 85px 32px 85px;
  }
  
  .gym-designer-hero-description {
    font-size: 16px;
    line-height: 24px;
    color: #393940;
    margin: 0;
    font-family: Lato, sans-serif;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0px;
    text-align: center;
    max-width: 842px;
  }
  
  .gym-designer-hero-button {
    display: inline-block;
    padding: 12px 24px;
    background-color: #F1592A;
    color: #FFFFFF;
    border-radius: 8px;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    transition: all 0.3s ease;
    font-family: Lato, sans-serif;
    margin-bottom: 60px;
    text-transform: none;
    letter-spacing: 0px;
    border: none;
    cursor: pointer;
  }
  
  .gym-designer-hero-button:hover {
    background-color: #e55a2e;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }
  
  .gym-designer-hero-video {
    width: 100%;
    max-width: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    position: relative;
    background: #f5f5f5;
  }
  
  .gym-designer-hero-video video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    filter: blur(12.5px);
  }
  
  .gym-designer-hero-video .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(35, 35, 43, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .gym-designer-hero-play-button {
    width: 100px;
    height: 100px;
    background-color: rgba(35, 35, 43, 0.3);
    border-radius: 68.75px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    padding: 25px;
  }
  
  .gym-designer-hero-play-button:hover {
    background-color: rgba(35, 35, 43, 0.5);
    transform: scale(1.05);
  }
  
  .gym-designer-hero-play-button::before {
    content: '';
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 15px 0 15px 25px;
    border-color: transparent transparent transparent #ffffff;
    margin-left: 5px;
  }

  @media (max-width: 1024px) {
    .gym-designer-hero-title {
      font-size: 40px;
      line-height: 56px;
    }
    
    .gym-designer-hero-description {
      font-size: 15px;
      line-height: 22px;
    }
    
    .gym-designer-hero {
      padding: 60px 0;
    }
  }

  @media (max-width: 768px) {
    .gym-designer-hero-title {
      font-size: 32px;
      line-height: 44px;
      margin-bottom: 20px;
    }
    
    .gym-designer-hero-description {
      font-size: 14px;
      line-height: 20px;
      margin-bottom: 30px;
    }
    
    .gym-designer-hero-button {
      padding: 10px 20px;
      font-size: 14px;
      line-height: 22px;
      height: 44px;
      margin-bottom: 40px;
    }
    
    .gym-designer-hero {
      padding: 40px 0;
    }
    
    .gym-designer-hero-container {
      padding: 0 15px;
    }
  }

  @media (max-width: 480px) {
    .gym-designer-hero-title {
      font-size: 28px;
      line-height: 38px;
    }
    
    .gym-designer-hero-button {
      padding: 8px 16px;
      font-size: 12px;
      line-height: 20px;
      height: 40px;
    }
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function playVideo(button) {
    const videoContainer = button.closest('.gym-designer-hero-video');
    const video = videoContainer.querySelector('video');
    const overlay = videoContainer.querySelector('.video-overlay');
    
    if (video.paused) {
      video.play();
      video.style.filter = 'blur(0px)';
      overlay.style.display = 'none';
    } else {
      video.pause();
      video.style.filter = 'blur(12.5px)';
      overlay.style.display = 'flex';
    }
  }
</script>

<section class="gym-designer-hero">
  <div class="gym-designer-hero-container">
    {% if section.settings.title != blank %}
      <h1 class="gym-designer-hero-title">{{ section.settings.title }}</h1>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <div class="gym-designer-hero-description-container">
        <p class="gym-designer-hero-description">{{ section.settings.description }}</p>
      </div>
    {% endif %}
    
    {% if section.settings.button_text != blank and section.settings.button_url != blank %}
      <a href="{{ section.settings.button_url }}" class="gym-designer-hero-button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
    
    {% if section.settings.hero_video != blank %}
      <div class="gym-designer-hero-video">
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.hero_video }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
        <div class="video-overlay">
          <button class="gym-designer-hero-play-button" onclick="playVideo(this)">
            <span class="sr-only">Play Video</span>
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Gym Designer Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "DESIGN YOUR DREAM GYM <br> WITH THE FITNESS SUPERSTORE GYM BUILDER"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Visualize, customize, and create your ideal gym setup with our interactive Gym Builder. Whether you're planning a home gym or a full-scale commercial facility, this intuitive tool lets you map out your space, drag and drop premium equipment, and generate 3D layouts in minutes."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start Designing"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "url",
      "id": "hero_video",
      "label": "Hero Video URL (MP4)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#e55a2e"
    }
  ],
  "presets": [
    {
      "name": "Gym Designer Hero"
    }
  ]
}
{% endschema %} 