<style>
  .gym-designer-hero { padding: 40px 16px; text-align: center; }
  .gym-designer-hero-title { font-weight: 600; margin: 0; color: #23232B; font-family: Oswald, sans-serif; font-style: normal; text-transform: uppercase; letter-spacing: 0; text-align: center; }
  .gym-designer-hero-description-container { padding: 16px 85px 24px; }
  .gym-designer-hero-description-container > p { font-size: 16px; line-height: 24px; color: #393940; margin: 0 auto; font-family: Lato, sans-serif; font-weight: 400; max-width: 842px; }
  .gym-designer-hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 0 0 16px; }
  .gym-designer-hero-actions .button { min-width: 220px; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; text-align: center; padding: 12px 24px; }
  .gym-designer-hero-disclaimer { max-width: 860px; margin: 0 auto 32px; font-size: 13px; line-height: 19px; color: #56565e; }
  .gym-designer-hero-video, .gym-designer-hero-image { width: 100%; max-width: 100%; border-radius: 24px; overflow: hidden; position: relative; height: 474px; }
  .gym-designer-hero-video video, .gym-designer-hero-image img { width: 100%; height: 100%; display: block; object-fit: cover; border-radius: 24px; }
  .gym-designer-hero-video .video-overlay { position: absolute; inset: 0; background: transparent; display: flex; align-items: center; justify-content: center; }
  .gym-designer-hero-play-button { width: 100px; height: 100px; background: rgba(35,35,43,.8); backdrop-filter: blur(12.5px); border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; color: #fff; border-radius: 68.75px; box-shadow: 0 4px 20px rgba(0,0,0,.3); }
  .gym-designer-hero-play-button:hover { transform: scale(1.05); }
  .gym-designer-hero-play-button svg { width: 100%; height: 100%; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 768px) {
    .gym-designer-hero { padding: 0 0 24px; }
    .gym-designer-hero-title { margin-bottom: 20px; }
    .gym-designer-hero-description-container { padding: 0 16px 20px !important; }
    .gym-designer-hero-description-container > p { font-size: 15px; line-height: 22px; }
    .gym-designer-hero-container { padding: 0 15px; }
    .gym-designer-hero-actions { flex-direction: column; align-items: stretch; }
    .gym-designer-hero-actions .button { width: 100%; min-width: 0; }
    .gym-designer-hero-disclaimer { margin-bottom: 24px; text-align: left; }
  }
</style>

<script>
  function playVideo(button) {
    const videoContainer = button.closest('.gym-designer-hero-video');
    const video = videoContainer.querySelector('video');
    const overlay = videoContainer.querySelector('.video-overlay');
    video.play().then(() => { overlay.style.display = 'none'; }).catch(() => {});
  }
  function pauseVideo(videoContainer) {
    const video = videoContainer.querySelector('video');
    const overlay = videoContainer.querySelector('.video-overlay');
    video.pause();
    overlay.style.display = 'flex';
  }
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.gym-designer-hero-video').forEach(function(container) {
      const video = container.querySelector('video');
      const overlay = container.querySelector('.video-overlay');
      video.addEventListener('click', function() { if (!video.paused) pauseVideo(container); });
      video.addEventListener('ended', function() { overlay.style.display = 'flex'; });
    });
  });
</script>

<section class="gym-designer-hero">
  <div class="gym-designer-hero-container">
    {% if section.settings.title != blank %}<h1 class="gym-designer-hero-title">{{ section.settings.title }}</h1>{% endif %}
    {% if section.settings.description != blank %}<div class="gym-designer-hero-description-container"><p class="gym-designer-hero-description">{{ section.settings.description }}</p></div>{% endif %}
    <div class="gym-designer-hero-actions">
      {% if section.settings.primary_button_text != blank and section.settings.primary_button_url != blank %}
        <a href="{{ section.settings.primary_button_url }}" class="button" data-gym-designer-action="quote">{{ section.settings.primary_button_text }}</a>
      {% endif %}
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="button button--secondary" data-gym-designer-action="planner">{{ section.settings.button_text }}</a>
      {% endif %}
    </div>
    {% if section.settings.disclaimer != blank %}<p class="gym-designer-hero-disclaimer">{{ section.settings.disclaimer }}</p>{% endif %}
    {% if section.settings.hero_video != blank %}
      <div class="gym-designer-hero-video"><video muted loop playsinline><source src="{{ section.settings.hero_video }}" type="video/mp4">Your browser does not support the video tag.</video><div class="video-overlay"><button class="gym-designer-hero-play-button" onclick="playVideo(this)" type="button"><svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="100" height="100" rx="50" fill="#23232B" fill-opacity="0.3"/><path d="M35.4167 55.798V44.2021C35.4167 37.554 35.4167 34.2299 37.5635 33.0401C39.7103 31.8502 42.5291 33.6119 48.1666 37.1354L57.4433 42.9334C62.5178 46.1049 65.055 47.6907 65.055 50C65.055 52.3094 62.5178 53.8952 57.4433 57.0667L48.1666 62.8646C42.5291 66.3881 39.7103 68.1499 37.5635 66.96C35.4167 65.7702 35.4167 62.4461 35.4167 55.798Z" fill="white"/></svg><span class="sr-only">Play Video</span></button></div></div>
    {% elsif section.settings.hero_image != blank %}
      <div class="gym-designer-hero-image">{{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.title }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Gym Designer Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"title","label":"Hero Title","default":"DESIGN YOUR DREAM GYM WITH THE FITNESS SUPERSTORE GYM BUILDER"},
    {"type":"textarea","id":"description","label":"Hero Description","default":"Create a conceptual gym layout, then work with our team to validate equipment, fit, pricing and service scope."},
    {"type":"text","id":"primary_button_text","label":"Primary Button Text"},
    {"type":"url","id":"primary_button_url","label":"Primary Button URL"},
    {"type":"text","id":"button_text","label":"Planner Button Text","default":"Start Designing"},
    {"type":"url","id":"button_url","label":"Planner Button URL"},
    {"type":"textarea","id":"disclaimer","label":"Planner Disclosure"},
    {"type":"url","id":"hero_video","label":"Hero Video URL (MP4)"},
    {"type":"image_picker","id":"hero_image","label":"Hero Image"},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#ffffff"},
    {"type":"color","id":"title_color","label":"Title Color","default":"#333333"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#666666"},
    {"type":"color","id":"button_bg_color","label":"Button Background Color","default":"#ff6b35"},
    {"type":"color","id":"button_text_color","label":"Button Text Color","default":"#ffffff"},
    {"type":"color","id":"button_hover_color","label":"Button Hover Color","default":"#e55a2e"}
  ],
  "presets": [{"name":"Gym Designer Hero"}]
}
{% endschema %}
