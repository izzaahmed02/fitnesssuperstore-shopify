<style>
  .gym-designer-hero {
    padding: 40px 16px;
    text-align: center;
  }
  
  .gym-designer-hero-title {
   
    font-weight: 600;

    margin: 0;
    color: #23232B;
    font-family: Oswald, sans-serif;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
  }

  .gym-designer-hero-description-container {
    padding: 16px 85px 32px 85px;
  }
  
  .gym-designer-hero-description-container > p {
    font-size: 16px;
    line-height: 24px;
    color: #393940;
    margin: 0;
    font-family: Lato, sans-serif;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0px;
    text-align: center;
    max-width: 842px;
  }
  
  .gym-designer-hero-button {
    display: inline-block;
    transition: all 0.3s ease;
    margin-bottom: 40px;
    text-transform: none;
    letter-spacing: 0px;
    border: none;
    cursor: pointer;
  }
  
  .gym-designer-hero-video {
    width: 100%;
    max-width: 100%;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
  }
  
  .gym-designer-hero-video video {
    width: 100%;
    display: block;
    object-fit: cover;
    border-radius: 24px;
    height: 474px;
  }
  
  .gym-designer-hero-image {
    width: 100%;
    max-width: 100%;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    height: 474px;
  }
  
  .gym-designer-hero-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 24px;
  }
  
  .gym-designer-hero-video .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .gym-designer-hero-play-button {
    width: 100px;
    height: 100px;
    background: rgba(35, 35, 43, 0.8);
    backdrop-filter: blur(12.5px);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #fff;
    border-radius: 68.75px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  
  .gym-designer-hero-play-button:hover {
    transform: scale(1.05);
  }
  
  .gym-designer-hero-play-button svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .gym-designer-hero {
      padding: 0;
      padding-bottom: 24px;
    }

    .gym-designer-hero-title {
    
      margin-bottom: 20px;
    }

    .gym-designer-hero-description-container {
      padding: 0 16px !important;
    }
    
    .gym-designer-hero-description-container > p {
      font-size: 15px;
      line-height: 22px;
      margin-bottom: 20px;
    }
    
    .gym-designer-hero-button {
      margin-bottom: 20px
    }
    
    .gym-designer-hero-container {
      padding: 0 15px;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function playVideo(button) {
    const videoContainer = button.closest('.gym-designer-hero-video');
    const video = videoContainer.querySelector('video');
    const overlay = videoContainer.querySelector('.video-overlay');
    
    video.play().then(() => {
      overlay.style.display = 'none';
    }).catch((error) => {
      console.log('Video play failed:', error);
    });
  }
  
  function pauseVideo(videoContainer) {
    const video = videoContainer.querySelector('video');
    const overlay = videoContainer.querySelector('.video-overlay');
    
    video.pause();
    overlay.style.display = 'flex';
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    const videoContainers = document.querySelectorAll('.gym-designer-hero-video');
    videoContainers.forEach(container => {
      const video = container.querySelector('video');
      const overlay = container.querySelector('.video-overlay');
      
      // Click on video to pause
      video.addEventListener('click', function() {
        if (!video.paused) {
          pauseVideo(container);
        }
      });
      
      // Video ended - show play button again
      video.addEventListener('ended', function() {
        overlay.style.display = 'flex';
      });
    });
  });
</script>

<section class="gym-designer-hero">
  <div class="gym-designer-hero-container">
    {% if section.settings.title != blank %}
      <h1 class="gym-designer-hero-title">{{ section.settings.title }}</h1>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <div class="gym-designer-hero-description-container">
        <p class="gym-designer-hero-description">{{ section.settings.description }}</p>
      </div>
    {% endif %}
    
    {% if section.settings.button_text != blank and section.settings.button_url != blank %}
      <a href="{{ section.settings.button_url }}" class="gym-designer-hero-button button button--secondary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
    
    {% if section.settings.hero_video != blank %}
      <div class="gym-designer-hero-video">
        <video muted loop playsinline>
          <source src="{{ section.settings.hero_video }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
        <div class="video-overlay">
          <button class="gym-designer-hero-play-button" onclick="playVideo(this)">
            <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <foreignObject x="-12.5" y="-12.5" width="125" height="125">
                <div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(6.25px);clip-path:url(#bgblur_0_5405_69729_clip_path);height:100%;width:100%"></div>
              </foreignObject>
              <g data-figma-bg-blur-radius="12.5">
                <rect width="100" height="100" rx="50" fill="#23232B" fill-opacity="0.3"/>
                <path d="M35.4167 55.798V44.2021C35.4167 37.554 35.4167 34.2299 37.5635 33.0401C39.7103 31.8502 42.5291 33.6119 48.1666 37.1354L57.4433 42.9334C62.5178 46.1049 65.055 47.6907 65.055 50C65.055 52.3094 62.5178 53.8952 57.4433 57.0667L48.1666 62.8646C42.5291 66.3881 39.7103 68.1499 37.5635 66.96C35.4167 65.7702 35.4167 62.4461 35.4167 55.798Z" fill="white"/>
              </g>
              <defs>
                <clipPath id="bgblur_0_5405_69729_clip_path" transform="translate(12.5 12.5)">
                  <rect width="100" height="100" rx="50"/>
                </clipPath>
              </defs>
            </svg>
            <span class="sr-only">Play Video</span>
          </button>
        </div>
      </div>
    {% elsif section.settings.hero_image != blank %}
      <div class="gym-designer-hero-image">
        <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="{{ section.settings.hero_image.alt | escape }}" loading="lazy">
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Gym Designer Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "DESIGN YOUR DREAM GYM <br> WITH THE FITNESS SUPERSTORE GYM BUILDER"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Visualize, customize, and create your ideal gym setup with our interactive Gym Builder. Whether you're planning a home gym or a full-scale commercial facility, this intuitive tool lets you map out your space, drag and drop premium equipment, and generate 3D layouts in minutes."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start Designing"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "https://fitnesssuperstore.roomplanner.com/"
    },
    {
      "type": "url",
      "id": "hero_video",
      "label": "Hero Video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#e55a2e"
    }
  ],
  "presets": [
    {
      "name": "Gym Designer Hero"
    }
  ]
}
{% endschema %} 