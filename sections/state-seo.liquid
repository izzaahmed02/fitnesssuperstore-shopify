{% comment %}
  Canonical & Indexation + FAQ/LocalBusiness Schema Section
  - Toggle schema on/off
  - Add FAQ items
  - Add LocalBusiness info (areaServed)
  - areaServed supports multiple states via comma-separated textarea
{% endcomment %}

{% if section.settings.enable_schema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {% if section.blocks.size > 0 %}
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for block in section.blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% if section.settings.include_localbusiness %},{% endif %}
      {% endif %}

      {% if section.settings.include_localbusiness %}
      {
        "@type": "LocalBusiness",
        "name": {{ section.settings.business_name | json }},
        "url": {{ section.settings.business_url | json }},
        "telephone": {{ section.settings.telephone | json }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ section.settings.street_address | json }},
          "addressLocality": {{ section.settings.city | json }},
          "addressRegion": {{ section.settings.state | json }},
          "postalCode": {{ section.settings.postal_code | json }},
          "addressCountry": {{ section.settings.country | json }}
        },
        "areaServed": [
          {% assign states = section.settings.area_served_states | split: "," | map: "strip" %}
          {% for state in states %}
            {{ state | json }}{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
      {% endif %}
    ]
  }
  </script>
{% endif %}

{% schema %}
{
  "name": "Canonical & Indexation",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Enable JSON-LD Schema",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "include_localbusiness",
      "label": "Include LocalBusiness Schema",
      "default": false
    },
    {
      "type": "text",
      "id": "business_name",
      "label": "Business Name",
      "default": "Fitness Superstore"
    },
    {
      "type": "text",
      "id": "business_url",
      "label": "Business URL",
      "default": "https://example.com"
    },
    {
      "type": "text",
      "id": "telephone",
      "label": "Phone Number",
      "default": "+1-123-456-7890"
    },
    {
      "type": "text",
      "id": "street_address",
      "label": "Street Address",
      "default": "123 Fitness St"
    },
    {
      "type": "text",
      "id": "city",
      "label": "City",
      "default": "Cityville"
    },
    {
      "type": "text",
      "id": "state",
      "label": "State",
      "default": "AL"
    },
    {
      "type": "text",
      "id": "postal_code",
      "label": "Postal Code",
      "default": "12345"
    },
    {
      "type": "text",
      "id": "country",
      "label": "Country",
      "default": "USA"
    },
    {
      "type": "textarea",
      "id": "area_served_states",
      "label": "States Served (comma-separated)",
      "default": "Alabama, California, Texas"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "You can return items within 30 days."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Canonical & Indexation Section"
    }
  ]
}
{% endschema %}
