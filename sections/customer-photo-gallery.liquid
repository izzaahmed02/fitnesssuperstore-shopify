{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section
  id="customer-photo-gallery-{{ section.id }}"
  class="customer-photo-gallery"
  data-count="{{ gallery_metafield.value.size }}"
>
  <div class="customer-photo-gallery__header">
    <h4>{{ section.settings.heading | default: 'Customer Photo Gallery' }}</h4>
  </div>

  <!-- Arrows -->
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--left" aria-label="Previous image" type="button">‹</button>
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--right" aria-label="Next image" type="button">›</button>

  <div class="customer-photo-gallery__slider" id="photos">
    {% for image in gallery_metafield.value %}
      {%- assign w = image.width | default: 1200 -%}
      {%- assign h = image.height | default: 1200 -%}
      {%- assign full = image | image_url: width: 2048 -%}
      {%- assign caption = image.alt | default: '' -%}
      <div class="customer-photo-gallery__slide">
        <img
          src="{{ image | image_url: width: 600 }}"
          srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 800 }} 800w"
          sizes="(min-width: 990px) 25vw, 80vw"
          width="{{ w }}"
          height="{{ h }}"
          data-full="{{ full }}"
          data-caption="{{ caption | escape }}"
          alt="Customer photo {{ forloop.index }}"
          loading="lazy"
          decoding="async"
        >
      </div>
    {% endfor %}
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Customer photo gallery" hidden>
    <button type="button" class="customer-photo-gallery__lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="customer-photo-gallery__lightbox-arrow customer-photo-gallery__lightbox-arrow--left" aria-label="Previous image">‹</button>
    <button type="button" class="customer-photo-gallery__lightbox-arrow customer-photo-gallery__lightbox-arrow--right" aria-label="Next image">›</button>

    <div class="customer-photo-gallery__lightbox-inner">
      <div class="customer-photo-gallery__lightbox-spinner" aria-hidden="true"></div>
      <img alt="" decoding="async" draggable="false">
      <div class="customer-photo-gallery__lightbox-caption" aria-live="polite"></div>
    </div>

    <div class="customer-photo-gallery__lightbox-counter" aria-live="polite"></div>

    <div class="customer-photo-gallery__lightbox-zoom" role="group" aria-label="Zoom controls">
      <button type="button" class="customer-photo-gallery__lightbox-zoom-btn" data-zoom="out" aria-label="Zoom out">&minus;</button>
      <button type="button" class="customer-photo-gallery__lightbox-zoom-btn" data-zoom="reset" aria-label="Reset zoom">Fit</button>
      <button type="button" class="customer-photo-gallery__lightbox-zoom-btn" data-zoom="in" aria-label="Zoom in">+</button>
    </div>
  </div>
</section>
{% endif %}

<style>
/* -----------------------------
   BASE
------------------------------- */
.customer-photo-gallery {
  margin: 20px 0;
  padding: 0 12px;
  position: relative;
}

.customer-photo-gallery__header {
  margin-bottom: 16px;
}

.customer-photo-gallery__header h4 {
  font-family: Lato;
  font-weight: 700;
  margin: 0;
}

/* -----------------------------
   SLIDER (ALL DEVICES)
------------------------------- */
.customer-photo-gallery__slider {
  display: flex;
  gap: 0px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}

/* Center slides if 4 or fewer images (uses data-count instead of expensive :has) */
.customer-photo-gallery[data-count="1"] .customer-photo-gallery__slider,
.customer-photo-gallery[data-count="2"] .customer-photo-gallery__slider,
.customer-photo-gallery[data-count="3"] .customer-photo-gallery__slider,
.customer-photo-gallery[data-count="4"] .customer-photo-gallery__slider {
  justify-content: flex-start;
}

.customer-photo-gallery__slider::-webkit-scrollbar {
  display: none;
}

.customer-photo-gallery__slide {
  flex: 0 0 80%;
  scroll-snap-align: start;
  padding: 4px;
}

.customer-photo-gallery__slide img {
  width: 100%;
  height: 100%;
  max-height: 325px;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
  background: #f2f2f2;
}

@media (hover: hover) {
  .customer-photo-gallery__slide img {
    transition: transform .2s ease;
  }
  .customer-photo-gallery__slide img:hover {
    transform: scale(1.03);
  }
}

/* -----------------------------
   DESKTOP SIZING
------------------------------- */
@media screen and (min-width: 990px) {
  .customer-photo-gallery__slide {
    flex: 0 0 25%;
    padding-right: 12px;
  }

  .customer-photo-gallery__slide img {
    height: 100%;
    max-height: 325px;
  }
}

/* -----------------------------
   ARROWS (thumb slider)
------------------------------- */
.customer-photo-gallery__arrow {
  position: absolute;
  top: 60%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  border: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  font-size: 22px;
  cursor: pointer;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__arrow--left { left: 10px; }
.customer-photo-gallery__arrow--right { right: 10px; }

/* Hide thumb arrows on desktop when there are 4 or fewer images (CSS-driven, no JS layout read) */
@media screen and (min-width: 990px) {
  .customer-photo-gallery[data-count="1"] .customer-photo-gallery__arrow,
  .customer-photo-gallery[data-count="2"] .customer-photo-gallery__arrow,
  .customer-photo-gallery[data-count="3"] .customer-photo-gallery__arrow,
  .customer-photo-gallery[data-count="4"] .customer-photo-gallery__arrow {
    display: none;
  }
}

/* -----------------------------
   LIGHTBOX
------------------------------- */
.customer-photo-gallery__lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.9);
  opacity: 0;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity .2s ease;
  z-index: 9999;
  contain: layout paint;
}

.customer-photo-gallery__lightbox[hidden] {
  display: none;
}

.customer-photo-gallery__lightbox--active {
  opacity: 1;
  pointer-events: auto;
}

.customer-photo-gallery__lightbox-inner {
  position: relative;
  width: 90vw;
  height: 88vh;
  max-width: 90vw;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__lightbox-inner img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  display: block;
  object-fit: contain;
  border-radius: 4px;
  opacity: 0;
  transition: opacity .15s ease;
  transform-origin: center center;
  touch-action: none;
  -webkit-user-select: none;
  user-select: none;
  -webkit-user-drag: none;
}

.customer-photo-gallery__lightbox-inner img.is-transforming {
  will-change: transform;
}

.customer-photo-gallery__lightbox-inner img.is-zoomable {
  cursor: zoom-in;
}

.customer-photo-gallery__lightbox-inner img.is-zoomed {
  cursor: grab;
}

.customer-photo-gallery__lightbox-inner img.is-panning {
  cursor: grabbing;
}

.customer-photo-gallery__lightbox-inner img.is-loaded {
  opacity: 1;
}

.customer-photo-gallery__lightbox-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40px;
  height: 40px;
  margin: -20px 0 0 -20px;
  border: 3px solid rgba(255,255,255,0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: cpg-spin 0.8s linear infinite;
  pointer-events: none;
  opacity: 0;
  transition: opacity .15s ease;
}

.customer-photo-gallery__lightbox-spinner.is-visible {
  opacity: 1;
}

@keyframes cpg-spin {
  to { transform: rotate(360deg); }
}

.customer-photo-gallery__lightbox-caption {
  margin-top: 12px;
  color: #fff;
  font-family: Lato, sans-serif;
  font-size: 14px;
  text-align: center;
  max-width: 90vw;
  min-height: 1em;
  line-height: 1.4;
}

.customer-photo-gallery__lightbox-caption:empty {
  display: none;
}

.customer-photo-gallery__lightbox-counter {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  color: #fff;
  font-family: Lato, sans-serif;
  font-size: 14px;
  background: rgba(0,0,0,0.5);
  padding: 4px 10px;
  border-radius: 12px;
  pointer-events: none;
}

.customer-photo-gallery__lightbox-close {
  position: absolute;
  top: 12px;
  right: 16px;
  width: 44px;
  height: 44px;
  font-size: 36px;
  line-height: 1;
  background: rgba(0,0,0,0.5);
  border: none;
  border-radius: 50%;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.customer-photo-gallery__lightbox-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 48px;
  height: 48px;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border: none;
  border-radius: 50%;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

@media (hover: hover) {
  .customer-photo-gallery__lightbox-arrow:hover,
  .customer-photo-gallery__lightbox-close:hover {
    background: rgba(0,0,0,0.75);
  }
}

.customer-photo-gallery__lightbox-arrow--left { left: 16px; }
.customer-photo-gallery__lightbox-arrow--right { right: 16px; }

.customer-photo-gallery__lightbox-arrow[hidden] {
  display: none;
}

/* Zoom controls */
.customer-photo-gallery__lightbox-zoom {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
  background: rgba(0,0,0,0.5);
  padding: 4px;
  border-radius: 999px;
  z-index: 2;
}

.customer-photo-gallery__lightbox-zoom-btn {
  min-width: 40px;
  height: 36px;
  padding: 0 12px;
  font-family: Lato, sans-serif;
  font-size: 18px;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__lightbox-zoom-btn[data-zoom="reset"] {
  font-size: 13px;
  letter-spacing: 0.5px;
}

@media (hover: hover) {
  .customer-photo-gallery__lightbox-zoom-btn:hover {
    background: rgba(255,255,255,0.15);
  }
}

.customer-photo-gallery__lightbox-zoom-btn:disabled {
  opacity: 0.4;
  cursor: default;
}

/* Lock body scroll when lightbox open */
body.cpg-lightbox-open {
  overflow: hidden;
}

/* Respect reduced-motion preference */
@media (prefers-reduced-motion: reduce) {
  .customer-photo-gallery__lightbox,
  .customer-photo-gallery__lightbox-inner img,
  .customer-photo-gallery__lightbox-spinner,
  .customer-photo-gallery__slide img {
    transition: none !important;
    animation: none !important;
  }
}

@media (max-width: 749px) {
  .customer-photo-gallery__header h4 {
    font-size: 20px;
    margin-bottom: 16px;
  }

  .customer-photo-gallery__lightbox-inner {
    width: 100vw;
    height: 92vh;
    max-width: 100vw;
    max-height: 92vh;
    padding: 0 8px;
  }

  .customer-photo-gallery__lightbox-arrow {
    width: 40px;
    height: 40px;
    font-size: 24px;
  }

  .customer-photo-gallery__lightbox-arrow--left { left: 6px; }
  .customer-photo-gallery__lightbox-arrow--right { right: 6px; }

  .customer-photo-gallery__lightbox-close {
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    font-size: 30px;
  }

  .customer-photo-gallery__lightbox-counter {
    top: 10px;
    font-size: 13px;
  }

  .customer-photo-gallery__lightbox-zoom {
    bottom: 10px;
    gap: 2px;
    padding: 3px;
  }

  .customer-photo-gallery__lightbox-zoom-btn {
    min-width: 36px;
    height: 32px;
    padding: 0 10px;
    font-size: 16px;
  }
}
</style>

<script>
(function () {
  var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!section) return;

  var slider = section.querySelector('.customer-photo-gallery__slider');
  var slides = section.querySelectorAll('.customer-photo-gallery__slide img');
  var total = slides.length;
  if (!total) return;

  var prevArrow = section.querySelector('.customer-photo-gallery__arrow--left');
  var nextArrow = section.querySelector('.customer-photo-gallery__arrow--right');

  // ----- THUMB SLIDER ARROWS -----
  var cachedSlideWidth = 0;
  function getSlideWidth() {
    if (!cachedSlideWidth) {
      var firstSlide = slider.querySelector('.customer-photo-gallery__slide');
      cachedSlideWidth = firstSlide ? firstSlide.offsetWidth + 16 : 0;
    }
    return cachedSlideWidth;
  }
  // Invalidate cached width on resize (debounced via rAF)
  var resizeTick = 0;
  window.addEventListener('resize', function () {
    if (resizeTick) return;
    resizeTick = requestAnimationFrame(function () {
      cachedSlideWidth = 0;
      resizeTick = 0;
      // If the lightbox is open, recompute zoom limits and re-clamp pan
      if (lightboxImg && lightbox.classList.contains('customer-photo-gallery__lightbox--active')) {
        computeMaxScale();
        applyTransform();
      }
    });
  }, { passive: true });

  function scrollSlider(dir) {
    var w = getSlideWidth();
    if (!w) return;
    slider.scrollBy({
      left: dir === 'next' ? w : -w,
      behavior: 'smooth'
    });
  }
  prevArrow.addEventListener('click', function () { scrollSlider('prev'); });
  nextArrow.addEventListener('click', function () { scrollSlider('next'); });

  // ----- LIGHTBOX (lazy-init on first thumb click) -----
  var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg, caption, counter, spinner, closeBtn, lbPrev, lbNext;
  var zoomInBtn, zoomOutBtn, zoomResetBtn;
  var currentIndex = 0;
  var lastTrigger = null;
  var initialized = false;
  var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1); };

  // ----- ZOOM / PAN STATE -----
  var scale = 1, panX = 0, panY = 0;
  var minScale = 1, maxScale = 1;
  var ZOOM_STEP = 1.4;       // button zoom factor
  var WHEEL_STEP = 1.15;     // per-tick wheel zoom factor
  var ABS_MAX_SCALE = 8;     // hard cap so a tiny natural image can't blow up infinitely

  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

  // will-change: transform is set only while a transform is in flight, then
  // cleared after a short idle so the compositor layer isn't kept alive at rest.
  var transformingTimer = 0;
  function markTransforming() {
    if (!lightboxImg) return;
    lightboxImg.classList.add('is-transforming');
    if (transformingTimer) clearTimeout(transformingTimer);
    transformingTimer = setTimeout(function () {
      lightboxImg.classList.remove('is-transforming');
      transformingTimer = 0;
    }, 300);
  }

  function applyTransform() {
    if (!lightboxImg) return;
    markTransforming();
    // Clamp pan so image edges can't drift past viewport center
    var maxPanX = 0, maxPanY = 0;
    if (scale > 1) {
      maxPanX = (lightboxImg.clientWidth * (scale - 1)) / 2;
      maxPanY = (lightboxImg.clientHeight * (scale - 1)) / 2;
    }
    panX = clamp(panX, -maxPanX, maxPanX);
    panY = clamp(panY, -maxPanY, maxPanY);
    lightboxImg.style.transform = 'translate3d(' + panX + 'px,' + panY + 'px,0) scale(' + scale + ')';

    if (scale > 1.001) {
      lightboxImg.classList.add('is-zoomed');
      lightboxImg.classList.remove('is-zoomable');
    } else {
      lightboxImg.classList.remove('is-zoomed');
      if (maxScale > 1.01) lightboxImg.classList.add('is-zoomable');
      else lightboxImg.classList.remove('is-zoomable');
    }

    if (zoomOutBtn) zoomOutBtn.disabled = scale <= minScale + 0.001;
    if (zoomInBtn) zoomInBtn.disabled = scale >= maxScale - 0.001;
    if (zoomResetBtn) zoomResetBtn.disabled = scale <= 1.001 && panX === 0 && panY === 0;
  }

  function resetZoom() {
    scale = 1;
    panX = 0;
    panY = 0;
    applyTransform();
  }

  function computeMaxScale() {
    if (!lightboxImg || !lightboxImg.naturalWidth || !lightboxImg.clientWidth) {
      maxScale = 1;
      return;
    }
    // Cap zoom so we never upscale beyond the natural source pixels
    var ratio = lightboxImg.naturalWidth / lightboxImg.clientWidth;
    maxScale = clamp(ratio, 1, ABS_MAX_SCALE);
  }

  function zoomAt(clientX, clientY, factor) {
    var newScale = clamp(scale * factor, minScale, maxScale);
    if (newScale === scale) return;
    var rect = lightboxImg.getBoundingClientRect();
    var dx = clientX - (rect.left + rect.width / 2);
    var dy = clientY - (rect.top + rect.height / 2);
    var ratio = (newScale / scale) - 1;
    panX -= dx * ratio;
    panY -= dy * ratio;
    scale = newScale;
    applyTransform();
  }

  function zoomToCenter(factor) {
    if (!lightboxImg) return;
    var rect = lightboxImg.getBoundingClientRect();
    zoomAt(rect.left + rect.width / 2, rect.top + rect.height / 2, factor);
  }

  function initLightbox() {
    if (initialized) return;
    initialized = true;

    lightbox.hidden = false;
    // Move lightbox to <body> so position:fixed always resolves to viewport,
    // regardless of any ancestor that creates a containing block
    // (transform/filter/perspective/will-change/contain).
    if (lightbox.parentNode !== document.body) {
      document.body.appendChild(lightbox);
    }
    lightboxImg = lightbox.querySelector('.customer-photo-gallery__lightbox-inner img');
    caption = lightbox.querySelector('.customer-photo-gallery__lightbox-caption');
    counter = lightbox.querySelector('.customer-photo-gallery__lightbox-counter');
    spinner = lightbox.querySelector('.customer-photo-gallery__lightbox-spinner');
    closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');
    lbPrev = lightbox.querySelector('.customer-photo-gallery__lightbox-arrow--left');
    lbNext = lightbox.querySelector('.customer-photo-gallery__lightbox-arrow--right');
    zoomInBtn = lightbox.querySelector('[data-zoom="in"]');
    zoomOutBtn = lightbox.querySelector('[data-zoom="out"]');
    zoomResetBtn = lightbox.querySelector('[data-zoom="reset"]');

    closeBtn.addEventListener('click', closeLightbox);
    lbNext.addEventListener('click', function () { nextImage(); });
    lbPrev.addEventListener('click', function () { prevImage(); });

    zoomInBtn.addEventListener('click', function () { zoomToCenter(ZOOM_STEP); });
    zoomOutBtn.addEventListener('click', function () { zoomToCenter(1 / ZOOM_STEP); });
    zoomResetBtn.addEventListener('click', resetZoom);

    // Wheel zoom — only fires inside the modal, only zooms when cursor is over the image
    lightbox.addEventListener('wheel', function (e) {
      if (!lightbox.classList.contains('customer-photo-gallery__lightbox--active')) return;
      if (!lightboxImg.contains(e.target) && e.target !== lightboxImg) return;
      if (maxScale <= 1.01) return;
      e.preventDefault();
      var factor = e.deltaY < 0 ? WHEEL_STEP : 1 / WHEEL_STEP;
      zoomAt(e.clientX, e.clientY, factor);
    }, { passive: false });

    // Mouse drag to pan when zoomed. mousemove/mouseup attach only while dragging.
    var mouseDrag = { active: false, moved: false, x: 0, y: 0, panX: 0, panY: 0 };
    function onMouseMove(e) {
      if (!mouseDrag.active) return;
      mouseDrag.moved = true;
      panX = mouseDrag.panX + (e.clientX - mouseDrag.x);
      panY = mouseDrag.panY + (e.clientY - mouseDrag.y);
      applyTransform();
    }
    function onMouseUp() {
      if (!mouseDrag.active) return;
      mouseDrag.active = false;
      lightboxImg.classList.remove('is-panning');
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    }
    lightboxImg.addEventListener('mousedown', function (e) {
      if (e.button !== 0 || scale <= 1) return;
      mouseDrag.active = true;
      mouseDrag.moved = false;
      mouseDrag.x = e.clientX;
      mouseDrag.y = e.clientY;
      mouseDrag.panX = panX;
      mouseDrag.panY = panY;
      lightboxImg.classList.add('is-panning');
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
      e.preventDefault();
    });

    // Click backdrop to close — suppressed if user just finished a pan drag
    lightbox.addEventListener('click', function (e) {
      if (e.target !== lightbox) return;
      if (mouseDrag.moved) { mouseDrag.moved = false; return; }
      closeLightbox();
    });

    document.addEventListener('keydown', onKeydown);

    // Touch: 1-finger = swipe-nav (only when at fit) OR pan (when zoomed),
    // 2-finger = pinch zoom. Swipe needs no preventDefault; pan/pinch do.
    var touchMode = null;
    var t1StartX = 0, t1StartY = 0;
    var touchPanStartX = 0, touchPanStartY = 0;
    var pinchStartDist = 0, pinchStartScale = 1;

    lightbox.addEventListener('touchstart', function (e) {
      if (e.touches.length === 2) {
        touchMode = 'pinch';
        var a = e.touches[0], b = e.touches[1];
        pinchStartDist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
        pinchStartScale = scale;
        return;
      }
      if (e.touches.length !== 1) { touchMode = null; return; }
      t1StartX = e.touches[0].clientX;
      t1StartY = e.touches[0].clientY;
      if (scale > 1) {
        touchMode = 'pan';
        touchPanStartX = panX;
        touchPanStartY = panY;
        lightboxImg.classList.add('is-panning');
      } else {
        touchMode = 'swipe';
      }
    }, { passive: true });

    lightbox.addEventListener('touchmove', function (e) {
      if (touchMode === 'pinch' && e.touches.length === 2 && pinchStartDist > 0 && maxScale > 1.01) {
        e.preventDefault();
        var a = e.touches[0], b = e.touches[1];
        var d = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
        var newScale = clamp(pinchStartScale * (d / pinchStartDist), minScale, maxScale);
        var midX = (a.clientX + b.clientX) / 2;
        var midY = (a.clientY + b.clientY) / 2;
        var rect = lightboxImg.getBoundingClientRect();
        var ddx = midX - (rect.left + rect.width / 2);
        var ddy = midY - (rect.top + rect.height / 2);
        var ratio = (newScale / scale) - 1;
        panX -= ddx * ratio;
        panY -= ddy * ratio;
        scale = newScale;
        applyTransform();
      } else if (touchMode === 'pan' && e.touches.length === 1) {
        e.preventDefault();
        var t = e.touches[0];
        panX = touchPanStartX + (t.clientX - t1StartX);
        panY = touchPanStartY + (t.clientY - t1StartY);
        applyTransform();
      }
      // 'swipe' falls through without preventDefault (page scroll already locked)
    }, { passive: false });

    lightbox.addEventListener('touchend', function (e) {
      if (touchMode === 'swipe' && e.touches.length === 0) {
        var t = e.changedTouches[0];
        var dx = t.clientX - t1StartX;
        var dy = t.clientY - t1StartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) nextImage();
          else prevImage();
        }
      }
      if (e.touches.length === 0) {
        touchMode = null;
        lightboxImg.classList.remove('is-panning');
      }
    }, { passive: true });
  }

  function showSpinner(show) {
    spinner.classList.toggle('is-visible', show);
  }

  function reveal() {
    lightboxImg.classList.add('is-loaded');
    showSpinner(false);
    // Compute max zoom once layout has the image at its fit size
    requestAnimationFrame(function () {
      computeMaxScale();
      applyTransform();
    });
  }

  function loadImage(index) {
    if (index < 0 || index >= total) return;
    currentIndex = index;

    // Reset zoom/pan on every image change
    resetZoom();

    var slideImg = slides[index];
    var fullSrc = slideImg.dataset.full || slideImg.currentSrc || slideImg.src;
    var captionText = slideImg.dataset.caption || '';

    lightboxImg.classList.remove('is-loaded');
    showSpinner(true);

    lightboxImg.alt = captionText || ('Customer photo ' + (index + 1));

    // fetchpriority for the active image
    if ('fetchPriority' in lightboxImg) lightboxImg.fetchPriority = 'high';

    lightboxImg.src = fullSrc;

    // Prefer decode() for smoother fade; fallback to onload + cached-check
    if (typeof lightboxImg.decode === 'function') {
      lightboxImg.decode().then(reveal).catch(reveal);
    } else {
      lightboxImg.onload = reveal;
      lightboxImg.onerror = reveal;
      if (lightboxImg.complete && lightboxImg.naturalWidth > 0) reveal();
    }

    caption.textContent = captionText;
    counter.textContent = (index + 1) + ' of ' + total;

    // Hide arrows at boundaries (no wrap)
    lbPrev.hidden = index === 0;
    lbNext.hidden = index === total - 1;

    // Preload neighbors during idle time so they don't fight active decode
    idle(function () {
      if (index + 1 < total) {
        var n = new Image();
        n.src = slides[index + 1].dataset.full;
      }
      if (index - 1 >= 0) {
        var p = new Image();
        p.src = slides[index - 1].dataset.full;
      }
    });
  }

  function openLightbox(index, trigger) {
    initLightbox();
    lastTrigger = trigger || null;
    loadImage(index);
    lightbox.classList.add('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('cpg-lightbox-open');
    // Focus close button so keyboard users land on a control
    requestAnimationFrame(function () {
      if (closeBtn) closeBtn.focus({ preventScroll: true });
    });
  }

  function closeLightbox() {
    if (!initialized) return;
    resetZoom();
    lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('cpg-lightbox-open');
    // Free memory after fade-out
    setTimeout(function () {
      if (!lightbox.classList.contains('customer-photo-gallery__lightbox--active')) {
        lightboxImg.removeAttribute('src');
        lightboxImg.classList.remove('is-loaded');
      }
    }, 250);
    // Restore focus to the opener
    if (lastTrigger && typeof lastTrigger.focus === 'function') {
      lastTrigger.focus({ preventScroll: true });
    }
  }

  function nextImage() { if (currentIndex < total - 1) loadImage(currentIndex + 1); }
  function prevImage() { if (currentIndex > 0) loadImage(currentIndex - 1); }

  function onKeydown(e) {
    if (!lightbox.classList.contains('customer-photo-gallery__lightbox--active')) return;
    if (e.key === 'Escape') { closeLightbox(); return; }
    if (e.key === 'ArrowRight') { nextImage(); return; }
    if (e.key === 'ArrowLeft') { prevImage(); return; }
    if (e.key === '+' || e.key === '=') { zoomToCenter(ZOOM_STEP); e.preventDefault(); return; }
    if (e.key === '-' || e.key === '_') { zoomToCenter(1 / ZOOM_STEP); e.preventDefault(); return; }
    if (e.key === '0') { resetZoom(); e.preventDefault(); return; }
    if (e.key === 'Tab') {
      // Focus trap across the visible controls
      var focusable = [closeBtn, lbPrev, lbNext, zoomOutBtn, zoomResetBtn, zoomInBtn]
        .filter(function (el) { return el && !el.hidden && !el.disabled; });
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      var active = document.activeElement;
      if (e.shiftKey && active === first) { last.focus(); e.preventDefault(); }
      else if (!e.shiftKey && active === last) { first.focus(); e.preventDefault(); }
    }
  }

  // ----- THUMB CLICK (event delegation - single listener) -----
  slider.addEventListener('click', function (e) {
    var img = e.target.closest('.customer-photo-gallery__slide img');
    if (!img) return;
    var index = -1;
    for (var i = 0; i < slides.length; i++) {
      if (slides[i] === img) { index = i; break; }
    }
    if (index !== -1) openLightbox(index, img);
  });

  // Make thumbs keyboard-focusable + Enter/Space activatable
  for (var i = 0; i < slides.length; i++) {
    slides[i].setAttribute('tabindex', '0');
    slides[i].setAttribute('role', 'button');
  }
  slider.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var img = e.target.closest('.customer-photo-gallery__slide img');
    if (!img) return;
    e.preventDefault();
    var index = -1;
    for (var i = 0; i < slides.length; i++) {
      if (slides[i] === img) { index = i; break; }
    }
    if (index !== -1) openLightbox(index, img);
  });
})();
</script>

