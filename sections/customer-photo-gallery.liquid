{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery">
  <div class="page-width-custom">
    <div class="customer-photo-gallery__header">
      <h4>Customer's Photo Gallery</h4>
    </div>

    <!-- Mobile Arrows -->
    <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--left" aria-label="Previous image">
      &#10094;
    </button>
    <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--right" aria-label="Next image">
      &#10095;
    </button>

    <div class="customer-photo-gallery__grid">
      {% for image in gallery_metafield.value %}
        {% assign thumb = image | image_url: width: 800 %}
        {% assign full  = image | image_url: width: 2400 %}
        <div class="customer-photo-gallery__item">
          <img
            src="{{ thumb }}"
            data-full="{{ full }}"
            alt="Customer photo {{ forloop.index }}"
            loading="lazy"
          >
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true">
    <div class="customer-photo-gallery__lightbox-inner">
      <button
        type="button"
        class="customer-photo-gallery__lightbox-close"
        aria-label="Close"
      >
        &times;
      </button>
      <img src="" alt="Expanded customer photo">
    </div>
  </div>
</section>
{% endif %}

<style>
  .customer-photo-gallery {
    margin: 40px 0;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .page-width-custom { padding: 0 5rem; }
  }

  .page-width-custom {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .customer-photo-gallery__header {
    margin-bottom: 20px;
  }

  .customer-photo-gallery__header h4 {
    font-family: Lato;
    font-weight: 700;
  }

  /* DESKTOP GRID */
  .customer-photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .customer-photo-gallery__item {
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
  }

  .customer-photo-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .2s ease;
  }

  .customer-photo-gallery__item:hover img {
    transform: scale(1.03);
  }

  /* MOBILE SLIDER */
  @media screen and (max-width: 749px) {
    .customer-photo-gallery__grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
    }

    .customer-photo-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .customer-photo-gallery__item {
      min-width: 100% !important;
      scroll-snap-align: start;
    }

    .customer-photo-gallery__item img {
      height: calc(60vw);
      max-height: 70vh;
      object-fit: cover;
    }

    /* MOBILE ARROWS */
    .customer-photo-gallery__arrow {
      display: block;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0,0,0,0.4);
      color: #fff;
      border: none;
      font-size: 32px;
      padding: 6px 12px;
      border-radius: 50%;
      z-index: 50;
      cursor: pointer;
      backdrop-filter: blur(3px);
    }

    .customer-photo-gallery__arrow--left {
      left: 10px;
    }

    .customer-photo-gallery__arrow--right {
      right: 10px;
    }
  }

  /* Desktop hide arrows */
  @media screen and (min-width: 750px) {
    .customer-photo-gallery__arrow { display: none !important; }
  }

  /* LIGHTBOX */
  .customer-photo-gallery__lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    opacity: 0;
    pointer-events: none;
    justify-content: center;
    align-items: center;
    transition: .2s ease;
    z-index: 999;
  }
  .customer-photo-gallery__lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }
  .customer-photo-gallery__lightbox-inner {
    max-width: 45vw;
    max-height: 90vh;
  }
  .customer-photo-gallery__lightbox-inner img {
    max-width: 100%;
    max-height: 100%;
  }
  .customer-photo-gallery__lightbox-close {
    position: absolute;
    top: -32px;
    right: -8px;
    background: transparent;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    border: none;
  }
</style>

<script>
(function() {
  var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!section) return;

  var grid = section.querySelector('.customer-photo-gallery__grid');
  var items = [...section.querySelectorAll('.customer-photo-gallery__item img')];

  /* Mobile arrows */
  var arrowLeft = section.querySelector('.customer-photo-gallery__arrow--left');
  var arrowRight = section.querySelector('.customer-photo-gallery__arrow--right');

  /* Lightbox */
  var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg = lightbox.querySelector('img');
  var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');

  /* Preload images */
  var fullImageCache = [];
  items.forEach(function(img, i) {
    var preload = new Image();
    preload.src = img.dataset.full || img.src;
    fullImageCache[i] = preload;
  });

  /* Open lightbox */
  items.forEach(function(img, i) {
    img.addEventListener('click', function() {
      var src = img.dataset.full;
      lightboxImg.src = fullImageCache[i].complete ? fullImageCache[i].src : src;
      lightbox.classList.add('customer-photo-gallery__lightbox--active');
    });
  });

  closeBtn.addEventListener('click', () => lightbox.classList.remove('customer-photo-gallery__lightbox--active'));
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.classList.remove('customer-photo-gallery__lightbox--active'); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') lightbox.classList.remove('customer-photo-gallery__lightbox--active'); });

  /* Update mobile slide width */
  function updateWidths() {
    if (!grid) return;
    var isMobile = window.matchMedia('(max-width: 749px)').matches;
    var width = grid.getBoundingClientRect().width;

    items.forEach(img => {
      var item = img.closest('.customer-photo-gallery__item');
      if (isMobile) {
        item.style.minWidth = width + 'px';
        item.style.maxWidth = width + 'px';
      } else {
        item.style.minWidth = '';
        item.style.maxWidth = '';
      }
    });
  }
  updateWidths();
  window.addEventListener('resize', updateWidths);

  /* MOBILE ARROWS → SCROLL SLIDER */
  if (arrowLeft && arrowRight) {
    arrowLeft.addEventListener('click', function() {
      grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' });
    });

    arrowRight.addEventListener('click', function() {
      grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Customer photo gallery",
  "templates": ["product"],
  "settings": [],
  "presets": [{ "name": "Customer photo gallery" }]
}
{% endschema %}
