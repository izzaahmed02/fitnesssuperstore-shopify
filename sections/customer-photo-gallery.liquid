{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery">
  <div class="page-width-custom">
    <div class="customer-photo-gallery__header">
      <h4>Customer's Photo Gallery</h4>
    </div>

    <div class="customer-photo-gallery__grid">
      {% for image in gallery_metafield.value %}
        {% assign thumb = image | image_url: width: 800 %}
        {% assign full  = image | image_url: width: 2400 %}
        <div class="customer-photo-gallery__item">
          <img
            src="{{ thumb }}"
            data-full="{{ full }}"
            alt="Customer photo {{ forloop.index }}"
            loading="lazy"
          >
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true">
    <div class="customer-photo-gallery__lightbox-inner">
      <button
        type="button"
        class="customer-photo-gallery__lightbox-close"
        aria-label="Close"
      >
        &times;
      </button>
      <img src="" alt="Expanded customer photo">
    </div>
  </div>
</section>
{% endif %}

<style>
  .customer-photo-gallery {
    margin: 40px 0;
  }

  @media screen and (min-width: 750px) {
    .page-width-custom {
        padding: 0 5rem;
    }
}

.page-width-custom {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
}

  .customer-photo-gallery__header {
    margin-bottom: 20px;
  }

  .customer-photo-gallery__header h4 {
    font-family: Lato;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: none;
  }

  /* ================================
     DESKTOP GRID
     ================================ */
  .customer-photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .customer-photo-gallery__item {
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
  }

  .customer-photo-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .customer-photo-gallery__item:hover img {
    transform: scale(1.03);
  }

  /* ================================
     MOBILE SLIDER (≤749px)
     ================================ */
  @media screen and (max-width: 749px) {
    #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      grid-template-columns: none !important;
      overflow-x: auto;
      gap: 16px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
    }

    #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__item {
      min-width: 100% !important;
      scroll-snap-align: start;
      box-sizing: border-box;
      display: block;
    }

    #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__item img {
      width: 100%;
      height: calc(60vw);
      max-height: 70vh;
      object-fit: cover;
      display: block;
    }
    .customer-photo-gallery .customer-photo-gallery__lightbox-inner {
    max-width: 90vw;
    }
  }

  /* Lightbox styles */
  .customer-photo-gallery__lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 999;
  }

  .customer-photo-gallery__lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }

  .customer-photo-gallery__lightbox-inner {
    position: relative;
    max-width: 45vw;
    max-height: 90vh;
  }

  .customer-photo-gallery__lightbox-inner img {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .customer-photo-gallery__lightbox-close {
    position: absolute;
    top: -32px;
    right: -8px;
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 32px;
  }
</style>

<script>
(function() {
  var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!section) return;

  var grid = section.querySelector('.customer-photo-gallery__grid');
  var items = Array.from(section.querySelectorAll('.customer-photo-gallery__item img'));

  var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg = lightbox.querySelector('img');
  var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');

  /* =======================================
     PRELOAD FULL IMAGES
     ======================================= */
  var fullImageCache = [];

  items.forEach(function(img, index) {
    var fullSrc = img.getAttribute('data-full') || img.src;
    var preloadImg = new Image();
    preloadImg.src = fullSrc;
    fullImageCache[index] = preloadImg;
  });

  /* =======================================
     LIGHTBOX FUNCTIONS
     ======================================= */
  function openLightbox(src, index) {
    if (fullImageCache[index] && fullImageCache[index].complete) {
      lightboxImg.src = fullImageCache[index].src;
    } else {
      lightboxImg.src = src;
    }
    lightbox.classList.add('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'false');
  }

  function closeLightbox() {
    lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  items.forEach(function(img, index) {
    img.addEventListener('click', function() {
      var fullSrc = img.getAttribute('data-full') || img.src;
      openLightbox(fullSrc, index);
    });
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });

  /* =======================================
     FIX SLIDE WIDTH (REAL DEVICE WIDTH)
     ======================================= */
  function updateItemWidths() {
    var isMobile = window.matchMedia('(max-width: 749px)').matches;
    var gridWidth = grid ? grid.getBoundingClientRect().width : 0;

    items.forEach(function(img) {
      var item = img.closest('.customer-photo-gallery__item');
      if (!item) return;

      if (isMobile && gridWidth > 0) {
        item.style.minWidth = gridWidth + 'px';
        item.style.maxWidth = gridWidth + 'px';
      } else {
        item.style.minWidth = '';
        item.style.maxWidth = '';
      }
    });
  }

  window.addEventListener('resize', updateItemWidths);
  updateItemWidths();

})();
</script>

{% schema %}
{
  "name": "Customer photo gallery",
  "templates": ["product"],
  "settings": [],
  "presets": [
    {
      "name": "Customer photo gallery"
    }
  ]
}
{% endschema %}
