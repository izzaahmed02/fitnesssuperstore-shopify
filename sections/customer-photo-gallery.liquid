{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery page-width">
  <div class="page-width">
    <div class="customer-photo-gallery__header">
      <h4>Customer's Photo Gallery</h4>
    </div>

    <div class="customer-photo-gallery__grid">
      {% for image in gallery_metafield.value %}
        {% assign thumb = image | image_url: width: 800 %}
        {% assign full  = image | image_url: width: 2400 %}
        <div class="customer-photo-gallery__item">
          <img
            src="{{ thumb }}"
            data-full="{{ full }}"
            alt="Customer photo {{ forloop.index }}"
            loading="lazy"
          >
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true">
    <div class="customer-photo-gallery__lightbox-inner">
      <button
        type="button"
        class="customer-photo-gallery__lightbox-close"
        aria-label="Close"
      >
        &times;
      </button>
      <img src="" alt="Expanded customer photo">
    </div>
  </div>
</section>
{% endif %}

<style>
  .customer-photo-gallery {
    margin: 40px 0;
  }

  .customer-photo-gallery__header {
    margin-bottom: 20px;
  }

  .customer-photo-gallery__header h4 {
    font-family: Lato;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: none;
  }

  .customer-photo-gallery__header h2 {
    margin: 0;
  }

  /* Desktop grid: 4 columns */
  .customer-photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .customer-photo-gallery__item {
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
  }

  .customer-photo-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .customer-photo-gallery__item:hover img {
    transform: scale(1.03);
  }

  /* Mobile slider: 1 image per "slide" with scroll snap */
  @media screen and (max-width: 749px) {
    .customer-photo-gallery__grid {
      /* make horizontal scrolling slider */
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 8px; /* space for touch scrolling */
      /* visually collapse vertical spacing so each slide fills viewport width */
      align-items: start;
    }

    .customer-photo-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .customer-photo-gallery__item {
      min-width: 100%;
      scroll-snap-align: start;
      /* ensure item takes full height of its "slide" */
      display: block;
    }

    .customer-photo-gallery__item img {
      height: calc(60vw); /* approximate height for mobile slides — adjust as desired */
      max-height: 70vh;
      width: 100%;
      object-fit: cover;
    }
  }

  /* Lightbox styles */
  .customer-photo-gallery__lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 999;
  }

  .customer-photo-gallery__lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }

  .customer-photo-gallery__lightbox-inner {
    position: relative;
    max-width: 45vw;
    max-height: 90vh;
  }

  .customer-photo-gallery__lightbox-inner img {
    display: block;
    max-width: 100%;
    margin: 0 auto;
    max-height: 100%;
  }

  .customer-photo-gallery__lightbox-close {
    position: absolute;
    top: -32px;
    right: -8px;
    background: transparent;
    border: none;
    line-height: 1;
    color: #ffffff;
    cursor: pointer;
    font-size:32px;
  }
</style>

<script>
  (function() {
    var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
    if (!section) return;

    var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
    var lightboxImg = lightbox.querySelector('img');
    var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');
    var grid = section.querySelector('.customer-photo-gallery__grid');
    var items = Array.prototype.slice.call(section.querySelectorAll('.customer-photo-gallery__item img'));

    // ---------- PRELOAD FULL IMAGES ----------
    var fullImageCache = [];

    items.forEach(function(img, index) {
      var fullSrc = img.getAttribute('data-full') || img.src;

      var preloadImg = new Image();
      preloadImg.src = fullSrc;

      fullImageCache[index] = preloadImg;
    });
    // -----------------------------------------

    function openLightbox(src, index) {
      // Use preloaded version if available
      if (fullImageCache[index] && fullImageCache[index].complete) {
        lightboxImg.src = fullImageCache[index].src;
      } else {
        lightboxImg.src = src;
      }

      lightbox.classList.add('customer-photo-gallery__lightbox--active');
      lightbox.setAttribute('aria-hidden', 'false');
    }

    function closeLightbox() {
      lightbox.classList.remove('customer-photo-gallery__lightbox--active');
      lightbox.setAttribute('aria-hidden', 'true');
    }

    items.forEach(function(img, index) {
      img.addEventListener('click', function() {
        var fullSrc = this.getAttribute('data-full') || this.src;
        openLightbox(fullSrc, index);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeLightbox();
    });

    // ---- small helper: ensure items keep correct min-width if layout changes ----
    function updateItemWidths() {
      if (window.matchMedia('(max-width: 749px)').matches) {
        // ensure each item matches computed grid-auto-columns (100%)
        items.forEach(function(img) {
          var item = img.closest('.customer-photo-gallery__item');
          if (item) item.style.minWidth = '100%';
        });
      } else {
        items.forEach(function(img) {
          var item = img.closest('.customer-photo-gallery__item');
          if (item) item.style.minWidth = '';
        });
      }
    }

    window.addEventListener('resize', updateItemWidths);
    // run once on init
    updateItemWidths();

  })();
</script>

{% schema %}
{
  "name": "Customer photo gallery",
  "templates": ["product"],
  "settings": [],
  "presets": [
    {
      "name": "Customer photo gallery"
    }
  ]
}
{% endschema %}
