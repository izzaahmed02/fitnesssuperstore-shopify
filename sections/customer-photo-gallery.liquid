{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery">
  <div class="customer-photo-gallery__header">
    <h4>{{ section.settings.heading | default: 'Customer Photo Gallery' }}</h4>
  </div>

  <!-- Arrows -->
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--left" aria-label="Previous image">‹</button>
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--right" aria-label="Next image">›</button>

  <div class="customer-photo-gallery__slider" id="photos">
    {% for image in gallery_metafield.value %}
      {% assign thumb = image | image_url: width: 900 %}
      {% assign full  = image | image_url: width: 2400 %}
      {% assign caption = image.alt | default: '' %}
      <div class="customer-photo-gallery__slide">
        <img
          src="{{ thumb }}"
          data-full="{{ full }}"
          data-caption="{{ caption | escape }}"
          data-index="{{ forloop.index0 }}"
          alt="Customer photo {{ forloop.index }}"
          loading="lazy"
          decoding="async"
        >
      </div>
    {% endfor %}
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Customer photo gallery">
    <button type="button" class="customer-photo-gallery__lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="customer-photo-gallery__lightbox-arrow customer-photo-gallery__lightbox-arrow--left" aria-label="Previous image">‹</button>
    <button type="button" class="customer-photo-gallery__lightbox-arrow customer-photo-gallery__lightbox-arrow--right" aria-label="Next image">›</button>

    <div class="customer-photo-gallery__lightbox-inner">
      <div class="customer-photo-gallery__lightbox-spinner" aria-hidden="true"></div>
      <img src="" alt="">
      <div class="customer-photo-gallery__lightbox-caption" aria-live="polite"></div>
    </div>

    <div class="customer-photo-gallery__lightbox-counter" aria-live="polite"></div>
  </div>
</section>
{% endif %}

<style>
/* -----------------------------
   BASE
------------------------------- */
.customer-photo-gallery {
  margin: 20px 0;
  padding: 0 12px;
  position: relative;
}

.customer-photo-gallery__header {
  margin-bottom: 16px;
}

.customer-photo-gallery__header h4 {
  font-family: Lato;
  font-weight: 700;
  margin: 0;
}

/* -----------------------------
   SLIDER (ALL DEVICES)
------------------------------- */
.customer-photo-gallery__slider {
  display: flex;
  gap: 0px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}

/* Center slides if 4 or fewer images */
.customer-photo-gallery__slider:has(.customer-photo-gallery__slide:nth-child(1)):not(:has(.customer-photo-gallery__slide:nth-child(5))) {
  justify-content: left;
}

.customer-photo-gallery__slider::-webkit-scrollbar {
  display: none;
}

.customer-photo-gallery__slide {
  flex: 0 0 80%;
  scroll-snap-align: start;
  padding: 4px;
}

.customer-photo-gallery__slide img {
  width: 100%;
  height: 100%;
  max-height: 325px;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
  transition: transform .2s ease;
}

.customer-photo-gallery__slide img:hover {
  transform: scale(1.03);
}

/* -----------------------------
   DESKTOP SIZING
------------------------------- */
@media screen and (min-width: 990px) {
  .customer-photo-gallery__slide {
    flex: 0 0 25%;
    padding-right: 12px;
  }

  .customer-photo-gallery__slide img {
    height: 100%;
    max-height: 325px;
  }
}

/* -----------------------------
   ARROWS (thumb slider)
------------------------------- */
.customer-photo-gallery__arrow {
  position: absolute;
  top: 60%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  border: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  font-size: 22px;
  cursor: pointer;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__arrow--left { left: 10px; }
.customer-photo-gallery__arrow--right { right: 10px; }

/* -----------------------------
   LIGHTBOX
------------------------------- */
.customer-photo-gallery__lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.9);
  opacity: 0;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity .2s ease;
  z-index: 9999;
}

.customer-photo-gallery__lightbox--active {
  opacity: 1;
  pointer-events: auto;
}

.customer-photo-gallery__lightbox-inner {
  position: relative;
  width: 90vw;
  height: 88vh;
  max-width: 90vw;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__lightbox-inner img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  display: block;
  object-fit: contain;
  border-radius: 4px;
  opacity: 0;
  transition: opacity .15s ease;
}

.customer-photo-gallery__lightbox-inner img.is-loaded {
  opacity: 1;
}

.customer-photo-gallery__lightbox-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40px;
  height: 40px;
  margin: -20px 0 0 -20px;
  border: 3px solid rgba(255,255,255,0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: cpg-spin 0.8s linear infinite;
  pointer-events: none;
  opacity: 0;
  transition: opacity .15s ease;
}

.customer-photo-gallery__lightbox-spinner.is-visible {
  opacity: 1;
}

@keyframes cpg-spin {
  to { transform: rotate(360deg); }
}

.customer-photo-gallery__lightbox-caption {
  margin-top: 12px;
  color: #fff;
  font-family: Lato, sans-serif;
  font-size: 14px;
  text-align: center;
  max-width: 90vw;
  min-height: 1em;
  line-height: 1.4;
}

.customer-photo-gallery__lightbox-caption:empty {
  display: none;
}

.customer-photo-gallery__lightbox-counter {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  color: #fff;
  font-family: Lato, sans-serif;
  font-size: 14px;
  background: rgba(0,0,0,0.5);
  padding: 4px 10px;
  border-radius: 12px;
  pointer-events: none;
}

.customer-photo-gallery__lightbox-close {
  position: absolute;
  top: 12px;
  right: 16px;
  width: 44px;
  height: 44px;
  font-size: 36px;
  line-height: 1;
  background: rgba(0,0,0,0.5);
  border: none;
  border-radius: 50%;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.customer-photo-gallery__lightbox-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 48px;
  height: 48px;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border: none;
  border-radius: 50%;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.customer-photo-gallery__lightbox-arrow:hover {
  background: rgba(0,0,0,0.75);
}

.customer-photo-gallery__lightbox-arrow--left { left: 16px; }
.customer-photo-gallery__lightbox-arrow--right { right: 16px; }

.customer-photo-gallery__lightbox-arrow[disabled],
.customer-photo-gallery__lightbox-arrow[hidden] {
  display: none;
}

/* Lock body scroll when lightbox open */
body.cpg-lightbox-open {
  overflow: hidden;
}

@media (max-width: 749px) {
  .customer-photo-gallery__header h4 {
    font-size: 20px;
    margin-bottom: 16px;
  }

  .customer-photo-gallery__lightbox-inner {
    width: 100vw;
    height: 92vh;
    max-width: 100vw;
    max-height: 92vh;
    padding: 0 8px;
  }

  .customer-photo-gallery__lightbox-arrow {
    width: 40px;
    height: 40px;
    font-size: 24px;
  }

  .customer-photo-gallery__lightbox-arrow--left { left: 6px; }
  .customer-photo-gallery__lightbox-arrow--right { right: 6px; }

  .customer-photo-gallery__lightbox-close {
    top: 8px;
    right: 8px;
    width: 40px;
    height: 40px;
    font-size: 30px;
  }

  .customer-photo-gallery__lightbox-counter {
    top: 10px;
    font-size: 13px;
  }
}
</style>

<script>
(function () {
  var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!section) return;

  var slider = section.querySelector('.customer-photo-gallery__slider');
  var slides = Array.prototype.slice.call(section.querySelectorAll('.customer-photo-gallery__slide img'));
  var prev = section.querySelector('.customer-photo-gallery__arrow--left');
  var next = section.querySelector('.customer-photo-gallery__arrow--right');

  // ----- HIDE THUMB ARROWS ON DESKTOP IF 4 OR FEWER IMAGES -----
  if (window.matchMedia('(min-width: 990px)').matches && slides.length <= 4) {
    prev.style.display = 'none';
    next.style.display = 'none';
  }

  // ----- LIGHTBOX -----
  var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg = lightbox.querySelector('.customer-photo-gallery__lightbox-inner img');
  var caption = lightbox.querySelector('.customer-photo-gallery__lightbox-caption');
  var counter = lightbox.querySelector('.customer-photo-gallery__lightbox-counter');
  var spinner = lightbox.querySelector('.customer-photo-gallery__lightbox-spinner');
  var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');
  var lbPrev = lightbox.querySelector('.customer-photo-gallery__lightbox-arrow--left');
  var lbNext = lightbox.querySelector('.customer-photo-gallery__lightbox-arrow--right');

  var currentIndex = 0;
  var total = slides.length;

  function showSpinner(show) {
    if (show) {
      spinner.classList.add('is-visible');
    } else {
      spinner.classList.remove('is-visible');
    }
  }

  function loadImage(index) {
    if (index < 0 || index >= total) return;
    currentIndex = index;

    var slideImg = slides[index];
    var fullSrc = slideImg.dataset.full || slideImg.src;
    var captionText = slideImg.dataset.caption || '';

    lightboxImg.classList.remove('is-loaded');
    showSpinner(true);

    // Lazy-load: assign src directly and listen on the displayed img
    function reveal() {
      lightboxImg.classList.add('is-loaded');
      showSpinner(false);
    }
    lightboxImg.onload = reveal;
    lightboxImg.onerror = reveal;
    lightboxImg.alt = captionText || ('Customer photo ' + (index + 1));
    lightboxImg.src = fullSrc;

    // Fallback for cached images where onload may not fire after src reassignment
    if (lightboxImg.complete && lightboxImg.naturalWidth > 0) {
      reveal();
    }

    caption.textContent = captionText;
    counter.textContent = (index + 1) + ' of ' + total;

    // Preload neighbors for snappier navigation
    if (index + 1 < total) {
      var nImg = new Image();
      nImg.src = slides[index + 1].dataset.full || slides[index + 1].src;
    }
    if (index - 1 >= 0) {
      var pImg = new Image();
      pImg.src = slides[index - 1].dataset.full || slides[index - 1].src;
    }

    // Hide arrows at boundaries (no wrap)
    lbPrev.hidden = index === 0;
    lbNext.hidden = index === total - 1;
  }

  function openLightbox(index) {
    loadImage(index);
    lightbox.classList.add('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('cpg-lightbox-open');
  }

  function closeLightbox() {
    lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('cpg-lightbox-open');
    // Clear src to free memory
    setTimeout(function () {
      if (!lightbox.classList.contains('customer-photo-gallery__lightbox--active')) {
        lightboxImg.removeAttribute('src');
        lightboxImg.classList.remove('is-loaded');
      }
    }, 250);
  }

  function nextImage() {
    if (currentIndex < total - 1) loadImage(currentIndex + 1);
  }

  function prevImage() {
    if (currentIndex > 0) loadImage(currentIndex - 1);
  }

  slides.forEach(function (img, i) {
    img.addEventListener('click', function () {
      openLightbox(i);
    });
  });

  closeBtn.addEventListener('click', closeLightbox);
  lbNext.addEventListener('click', nextImage);
  lbPrev.addEventListener('click', prevImage);

  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', function (e) {
    if (!lightbox.classList.contains('customer-photo-gallery__lightbox--active')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowRight') nextImage();
    else if (e.key === 'ArrowLeft') prevImage();
  });

  // ----- MOBILE SWIPE INSIDE LIGHTBOX -----
  var touchStartX = 0;
  var touchStartY = 0;
  var touchActive = false;

  lightbox.addEventListener('touchstart', function (e) {
    if (e.touches.length !== 1) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchActive = true;
  }, { passive: true });

  lightbox.addEventListener('touchend', function (e) {
    if (!touchActive) return;
    touchActive = false;
    var t = e.changedTouches[0];
    var dx = t.clientX - touchStartX;
    var dy = t.clientY - touchStartY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
      if (dx < 0) nextImage();
      else prevImage();
    }
  }, { passive: true });

  // ----- THUMB SLIDER ARROWS -----
  function scrollSlider(dir) {
    var slideWidth = slider.querySelector('.customer-photo-gallery__slide').offsetWidth + 16;
    slider.scrollBy({
      left: dir === 'next' ? slideWidth : -slideWidth,
      behavior: 'smooth'
    });
  }

  prev.addEventListener('click', function () { scrollSlider('prev'); });
  next.addEventListener('click', function () { scrollSlider('next'); });

})();
</script>

{% schema %}
{
  "name": "Customer Photo Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Customer Photo Gallery"
    }
  ],
  "presets": [
    {
      "name": "Customer Photo Gallery",
      "category": "Custom"
    }
  ]
}
{% endschema %}
