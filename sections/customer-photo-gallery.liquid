{%- assign gallery_metafield = product.metafields.custom.customer_photo_gallery -%}

{% if gallery_metafield and gallery_metafield.value != blank %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery">
  <div class="customer-photo-gallery__header">
    <h3>Customer's Photo Gallery</h3>
  </div>

  <!-- Arrows -->
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--left" aria-label="Previous image">‹</button>
  <button class="customer-photo-gallery__arrow customer-photo-gallery__arrow--right" aria-label="Next image">›</button>

  <div class="customer-photo-gallery__slider" id="photos">
    {% for image in gallery_metafield.value %}
      {% assign thumb = image | image_url: width: 900 %}
      {% assign full  = image | image_url: width: 2400 %}
      <div class="customer-photo-gallery__slide">
        <img
          src="{{ thumb }}"
          data-full="{{ full }}"
          alt="Customer photo {{ forloop.index }}"
          loading="lazy"
        >
      </div>
    {% endfor %}
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true" inert>
    <div class="customer-photo-gallery__lightbox-inner">
      <button type="button" class="customer-photo-gallery__lightbox-close" aria-label="Close">&times;</button>
      <img src="" alt="Expanded customer photo">
    </div>
  </div>
</section>
{% endif %}

<style>
/* -----------------------------
   BASE
------------------------------- */
.customer-photo-gallery {
  margin: 20px 0;
  padding: 0 12px;
  position: relative;
}

.customer-photo-gallery__header {
  margin-bottom: 16px;
}

.customer-photo-gallery__header h3 {
  font-family: var(--font-body-family);
  font-weight: 700;
  margin: 0;
}

/* -----------------------------
   SLIDER (ALL DEVICES)
------------------------------- */
.customer-photo-gallery__slider {
  display: flex;
  gap: 0px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}

/* Center slides if 4 or fewer images */
.customer-photo-gallery__slider:has(.customer-photo-gallery__slide:nth-child(1)):not(:has(.customer-photo-gallery__slide:nth-child(5))) {
  justify-content: left;
}

.customer-photo-gallery__slider::-webkit-scrollbar {
  display: none;
}

.customer-photo-gallery__slide {
  flex: 0 0 80%;
  scroll-snap-align: start;
  padding: 4px;
}

.customer-photo-gallery__slide img {
  width: 100%;
  height: 100%;
  max-height: 325px;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
  transition: transform .2s ease;
}

.customer-photo-gallery__slide img:hover {
  transform: scale(1.03);
}

/* -----------------------------
   DESKTOP SIZING
------------------------------- */
@media screen and (min-width: 990px) {
  .customer-photo-gallery__slide {
    flex: 0 0 25%;
    padding-right: 12px;
  }

  .customer-photo-gallery__slide img {
    height: 100%;
    max-height: 325px;
  }
}

/* -----------------------------
   ARROWS
------------------------------- */
.customer-photo-gallery__arrow {
  position: absolute;
  top: 60%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  border: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  font-size: 22px;
  cursor: pointer;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.customer-photo-gallery__arrow--left { left: 10px; }
.customer-photo-gallery__arrow--right { right: 10px; }

/* -----------------------------
   LIGHTBOX
------------------------------- */
.customer-photo-gallery__lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  opacity: 0;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: .2s ease;
  z-index: 999;
}

.customer-photo-gallery__lightbox--active {
  opacity: 1;
  pointer-events: auto;
}

.customer-photo-gallery__lightbox-inner {
  max-width: 700px;
  max-height: auto;
  position: relative;
}

.customer-photo-gallery__lightbox-inner img {
  max-width: 100%;
    max-height: 650px;
    display: block;
    object-fit: cover;
    padding: 20px;
}

.customer-photo-gallery__lightbox-close {
  position: absolute;
  top: -36px;
  right: -6px;
  font-size: 32px;
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
}




@media (max-width: 749px) {
.customer-photo-gallery__header h3 {
        font-size: 20px;
        margin-bottom: 16px;
}
}
</style>

<script>
(function () {
  var section = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!section) return;

  var slider = section.querySelector('.customer-photo-gallery__slider');
  var slides = section.querySelectorAll('.customer-photo-gallery__slide img');
  var prev = section.querySelector('.customer-photo-gallery__arrow--left');
  var next = section.querySelector('.customer-photo-gallery__arrow--right');

  // ----- HIDE ARROWS ON DESKTOP IF 4 OR FEWER IMAGES -----
  if (window.matchMedia('(min-width: 990px)').matches && slides.length <= 4) {
    prev.style.display = 'none';
    next.style.display = 'none';
  }

  // ----- LIGHTBOX -----
  var lightbox = section.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg = lightbox.querySelector('img');
  var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');

  var activeLightboxRequest = null;

  function openLightbox(img) {
    var previewSrc = img.currentSrc || img.src;
    var fullSrc = img.dataset.full || previewSrc;

    activeLightboxRequest = fullSrc;
    lightboxImg.src = previewSrc;
    lightboxImg.alt = img.alt || 'Expanded customer photo';
    lightbox.classList.add('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.removeAttribute('inert');

    if (fullSrc !== previewSrc) {
      var fullImage = new Image();
      fullImage.decoding = 'async';
      fullImage.onload = function () {
        if (activeLightboxRequest === fullSrc) {
          lightboxImg.src = fullSrc;
        }
      };
      fullImage.src = fullSrc;
    }
  }

  function closeLightbox() {
    activeLightboxRequest = null;
    lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.setAttribute('inert', '');
    lightboxImg.removeAttribute('src');
  }

  slides.forEach(function (img) {
    img.addEventListener('click', function () {
      openLightbox(img);
    });
  });

  closeBtn.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && lightbox.classList.contains('customer-photo-gallery__lightbox--active')) {
      closeLightbox();
    }
  });

  // ----- SLIDER ARROWS -----
  function scrollSlider(dir) {
    var slideWidth = slider.querySelector('.customer-photo-gallery__slide').offsetWidth + 16;
    slider.scrollBy({
      left: dir === 'next' ? slideWidth : -slideWidth,
      behavior: 'smooth'
    });
  }

  prev.addEventListener('click', function () { scrollSlider('prev'); });
  next.addEventListener('click', function () { scrollSlider('next'); });

})();
</script>

{% schema %}
{
  "name": "Customer Photo Gallery",
  
  "presets": [
    {
      "name": "Customer Photo Gallery",
      "category": "Custom"
    }
  ]
}
{% endschema %}