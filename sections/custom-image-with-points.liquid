{{ 'section-custom-image-with-points.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  .section-{{ section.id }} .section_bg{
    background:{{ section.settings.section_bg }};
    padding: 30px 0;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .image-with-points {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      display:flex !important;
      gap:40px !important;
      {% if section.settings.img_alignment == 'first' %}
        flex-direction:row-reverse;
      {% elsif section.settings.img_alignment == 'last' %}
        flex-direction:row;
      {% endif %}
      align-items:center;
    }
  }
{%- endstyle -%}

{% if section.settings.image or section.settings.heading != blank %}
  <div class="section-{{ section.id }}">
    <div class="section_bg ciwp--custom-img-with-points">
      <div class="image-with-points page-width custom-container">
        <div class="image-with-points__left">
          <h2 class="image-with-points__heading">{{ section.settings.heading }}</h2>

          <div class="image-with-points__points">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'text' %}
                  <span class="image-with-points__text">{{ block.settings.text }}</span>
                {% when 'point' %}
                  <span class="image-with-points__point">{{ block.settings.text | replace: '-', '&#8209;' }}</span>
              {% endcase %}
            {% endfor %}
          </div>
        </div>

        <div class="image-with-points__right">
          {% if section.settings.image != blank %}
            <div class="image-with-points__image desktop-image">
              <img
                src="{{ section.settings.image | img_url: '733x' }}"
                width="733"
                height="594"
                alt="{{ section.settings.image.alt }}"
              >
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Custom Image With Points",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "radio",
      "id": "img_alignment",
      "label": "Image Alignment",
      "options": [
        {
          "label": "First",
          "value": "first"
        },
        {
          "label": "Last",
          "value": "last"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-image-with-points"
    }
  ]
}
{% endschema %}
