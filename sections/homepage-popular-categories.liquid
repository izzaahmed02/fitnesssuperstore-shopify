<div class="popular-categories-compact">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="popular-categories-compact__grid">
    {% for block in section.blocks %}
      {% if block.type == 'category_card' %}
        <a
          href="{{ block.settings.link }}"
          class="popular-categories-compact__card"
          aria-label="Shop {{ block.settings.title }}"
          data-fss-hp-event="fss_hp_category_click"
          data-fss-hp-props='{"category_handle": "{{ block.settings.category_handle }}", "slot": {{ forloop.index }}}'
        >
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 300 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title }}"
              loading="lazy"
              decoding="async"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% endif %}
          <span class="popular-categories-compact__title">{{ block.settings.title }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.view_all_link != blank %}
    <a href="{{ section.settings.view_all_link }}" class="popular-categories-compact__view-all">
      {{ section.settings.view_all_text }}
    </a>
  {% endif %}
</div>

<style>
.popular-categories-compact {
  padding: 24px 16px;
}
.popular-categories-compact h2 {
  font-size: 20px;
  line-height: 26px;
  margin: 0 0 16px;
}
.popular-categories-compact__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.popular-categories-compact__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  color: inherit;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  padding: 16px 8px;
}
.popular-categories-compact__card img {
  width: 100%;
  max-width: 120px;
  height: auto;
  margin-bottom: 8px;
}
.popular-categories-compact__title {
  font-weight: 700;
  font-size: 14px;
}
.popular-categories-compact__view-all {
  display: block;
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
  text-decoration: underline;
  color: #4f4e4e;
}
</style>

{% schema %}
{
  "name": "Popular Categories",
  "class": "popular-categories-compact-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Popular Categories"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View all categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link URL"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "category_handle",
          "label": "Category handle (fss_hp_category_click property)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Popular Categories",
      "category": "Custom",
      "blocks": [
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" }
      ]
    }
  ]
}
{% endschema %}
