{{ 'section-scrollable-faq.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }}{
    background-color: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .address-wrapper{
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .address-wrapper .title{
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .address-wrapper p{
    margin-top: 8px;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .address-wrapper .address{
    display: flex;
    align-items: center;
    font-size: 14px;
    color: #000000;
  }
  #shopify-section-{{ section.id }} .address-wrapper .address svg{
    margin-right: 10px;
  }
  #shopify-section-{{ section.id }} ul li{
    position: relative;
  }
  #shopify-section-{{ section.id }} ul li:before{
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: absolute;
    top: 8px;
    left: -14px;
    background: #3E77AA;
  }
  #shopify-section-{{ section.id }} a strong{
    margin-bottom: 0;
    line-height: 22px;
  }
  #shopify-section-template--23645057646908__scrollable_faq_D47NJc .scrollable-faq__item-text a {
    display: flex;

  }
  #shopify-section-template--23645057646908__scrollable_faq_D47NJc .scrollable-faq__item:nth-child(3) a:after {
    content: url("https://cdn.shopify.com/s/files/1/0884/2012/2940/files/Chevron_-_Right.svg?v=1730219308");
  }

  @media screen and (max-width: 750px) {
    .scrollable-faq.section-padding {
      padding-block: 24px;
    }
  }
</style>

<scrollable-faq class="scrollable-faq section-padding scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="scrollable-faq__wrapper {% if section.settings.mobile_layout == 'dropdown' %}mobile_dropdown{% endif %}">
      <div class="scrollable-faq__left-side">
        <div class="scrollable-faq__nav-wrapper">
          {% if section.settings.title != blank %}
            <h2 class="h2">{{ section.settings.title }}</h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <div class="scrollable-faq__text">{{ section.settings.text }}</div>
          {% endif %}

          {% if section.settings.link != blank %}
            <a href="{{ section.settings.link }}" class="scrollable-faq__link">{{ section.settings.link_text }}</a>
          {% endif %}

          <div class="scrollable-faq__nav">
            {% for block in section.blocks %}
              <button
                data-scroll-to="block-{{ block.settings.title | handle }}"
                data-scroll-to-mobile="mobile-block-{{ block.settings.title | handle }}"
              >
                {{ block.settings.title }}

                <svg
                  class="scrollable-faq__arrow"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M5.46967 8.46967C5.76256 8.17678 6.23744 8.17678 6.53033 8.46967L12 13.9393L17.4697 8.46967C17.7626 8.17678 18.2374 8.17678 18.5303 8.46967C18.8232 8.76256 18.8232 9.23744 18.5303 9.53033L12.5303 15.5303C12.2374 15.8232 11.7626 15.8232 11.4697 15.5303L5.46967 9.53033C5.17678 9.23744 5.17678 8.76256 5.46967 8.46967Z" fill="black"/>
                </svg>
              </button>

              <div
                class="scrollable-faq__item--mob faq_item--mobile"
                id="mobile-block-{{ block.settings.title | handle }}"
              >
                {% if block.settings.image != blank %}
                  <div class="scrollable-faq__item-image">
                    <img
                      src="{{ block.settings.image | img_url: 'master'}}"
                      alt="{{ block.settings.image.alt }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h3 class="scrollable-faq__item-title h3">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}

                {% if block.settings.image_under_title1 != blank %}
                  <div class="scrollable-faq__item-icons-container">
                    {% for i in (1..6) %}
                      {% assign icon_key = 'image_under_title' | append: i %}
                      {% assign icon = block.settings[icon_key] %}
                      {% if icon != blank %}
                        <div class="scrollable-faq__item-image origin-proportions scrollable-faq__item-icons">
                          <img
                            src="{{ icon | img_url: 'master'}}"
                            alt="{{ icon.alt }}"
                            loading="lazy"
                            width="70"
                            height="48"
                          >
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                {% if block.settings.text != blank %}
                  {% assign text = block.settings.text | replace: '[[point]]', "<span class='icon-point'></span>" %}

                  <div class="scrollable-faq__item-text">
                    {{ text }}
                  </div>
                {% endif %}

                <div class="scrollable-faq__item-images">
                  {% for i in (1..5) %}
                    {% assign image_below_key = 'image_below' | append: i %}
                    {% assign image_below = block.settings[image_below_key] %}

                    {% if image_below != blank %}
                      <div class="scrollable-faq__item-icon {% if block.settings.image_below_origin_proportions %}origin-proportions{% endif %}">
                        <img
                          src="{{ image_below | img_url: 'master'}}"
                          alt="{{ image_below.alt }}"
                          loading="lazy"
                        >
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.addr1 != blank %}
                  <div class="address-wrapper">
                    <span class="title">{{ block.settings.addrtitle1 }}</span>
                    <p>{{ block.settings.addrtext1 }}</p>
                    <span class="address">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M4.75 10.1482C4.75 7.63087 5.66985 5.80032 7.00337 4.59302C8.34965 3.37416 10.1636 2.75 12 2.75C13.8364 2.75 15.6504 3.37418 16.9966 4.59304C18.3301 5.80035 19.25 7.63089 19.25 10.1482C19.25 13.4221 17.2847 16.2839 15.2683 18.3449C14.5408 19.0884 14.0747 19.5589 13.5981 19.8644C13.1668 20.1408 12.7127 20.288 12.0002 20.288C11.2877 20.288 10.8336 20.1409 10.4023 19.8644C9.9257 19.559 9.45955 19.0885 8.73207 18.345C6.71544 16.284 4.75 13.4221 4.75 10.1482ZM20.75 10.1482C20.75 7.23337 19.6699 4.98983 18.0034 3.48107C16.3496 1.98387 14.1636 1.25001 12 1.25C9.83643 1.24999 7.65035 1.98385 5.99663 3.48105C4.33015 4.98981 3.25 7.23335 3.25 10.1482C3.25 14.0136 5.5502 17.2379 7.65992 19.3941L7.70691 19.4421L7.70693 19.4421C8.37418 20.1242 8.95657 20.7195 9.59294 21.1274C10.2895 21.5738 11.0303 21.788 12.0002 21.788C12.9702 21.788 13.711 21.5737 14.4075 21.1273C15.0439 20.7194 15.6262 20.1241 16.2935 19.442L16.2935 19.4419L16.3405 19.3939C18.45 17.2377 20.75 14.0135 20.75 10.1482ZM9.75 10C9.75 8.75739 10.7574 7.75003 12 7.75003C13.2426 7.75003 14.25 8.75739 14.25 10C14.25 11.2427 13.2426 12.25 12 12.25C10.7574 12.25 9.75 11.2427 9.75 10ZM12 6.25003C9.92893 6.25003 8.25 7.92896 8.25 10C8.25 12.0711 9.92893 13.75 12 13.75C14.0711 13.75 15.75 12.0711 15.75 10C15.75 7.92896 14.0711 6.25003 12 6.25003Z" fill="#F1592A"/>
                      </svg>
                      {{ block.settings.addr1 -}}
                    </span>
                  </div>
                {% endif %}

                {% if block.settings.addr2 != blank %}
                  <div class="address-wrapper">
                    <span class="title">{{ block.settings.addrtitle2 }}</span>
                    <p>{{ block.settings.addrtext2 }}</p>
                    <span class="address">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M4.75 10.1482C4.75 7.63087 5.66985 5.80032 7.00337 4.59302C8.34965 3.37416 10.1636 2.75 12 2.75C13.8364 2.75 15.6504 3.37418 16.9966 4.59304C18.3301 5.80035 19.25 7.63089 19.25 10.1482C19.25 13.4221 17.2847 16.2839 15.2683 18.3449C14.5408 19.0884 14.0747 19.5589 13.5981 19.8644C13.1668 20.1408 12.7127 20.288 12.0002 20.288C11.2877 20.288 10.8336 20.1409 10.4023 19.8644C9.9257 19.559 9.45955 19.0885 8.73207 18.345C6.71544 16.284 4.75 13.4221 4.75 10.1482ZM20.75 10.1482C20.75 7.23337 19.6699 4.98983 18.0034 3.48107C16.3496 1.98387 14.1636 1.25001 12 1.25C9.83643 1.24999 7.65035 1.98385 5.99663 3.48105C4.33015 4.98981 3.25 7.23335 3.25 10.1482C3.25 14.0136 5.5502 17.2379 7.65992 19.3941L7.70691 19.4421L7.70693 19.4421C8.37418 20.1242 8.95657 20.7195 9.59294 21.1274C10.2895 21.5738 11.0303 21.788 12.0002 21.788C12.9702 21.788 13.711 21.5737 14.4075 21.1273C15.0439 20.7194 15.6262 20.1241 16.2935 19.442L16.2935 19.4419L16.3405 19.3939C18.45 17.2377 20.75 14.0135 20.75 10.1482ZM9.75 10C9.75 8.75739 10.7574 7.75003 12 7.75003C13.2426 7.75003 14.25 8.75739 14.25 10C14.25 11.2427 13.2426 12.25 12 12.25C10.7574 12.25 9.75 11.2427 9.75 10ZM12 6.25003C9.92893 6.25003 8.25 7.92896 8.25 10C8.25 12.0711 9.92893 13.75 12 13.75C14.0711 13.75 15.75 12.0711 15.75 10C15.75 7.92896 14.0711 6.25003 12 6.25003Z" fill="#F1592A"/>
                      </svg>
                      {{ block.settings.addr2 -}}
                    </span>
                  </div>
                {% endif %}

                {% if block.settings.link_label != empty %}
                  <a href="{{ block.settings.link_url }}" class="scrollable-faq__item-link">
                    {{- block.settings.link_label -}}
                  </a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="scrollable-faq__right-side {% if section.settings.mobile_layout == 'dropdown' %}mobile_dropdown--hidden{% endif %}">
        {% for block in section.blocks %}
          <div class="scrollable-faq__item" id="block-{{ block.settings.title | handle }}">
            {% if block.settings.image != blank %}
              <div class="scrollable-faq__item-image">
                <img
                  src="{{ block.settings.image | img_url: 'master'}}"
                  alt="{{ block.settings.image.alt }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="scrollable-faq__item-title h3">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.image_under_title1 != blank %}
              <div class="scrollable-faq__item-icons-container">
                {% for i in (1..6) %}
                  {% assign icon_key = 'image_under_title' | append: i %}
                  {% assign icon = block.settings[icon_key] %}
                  {% if icon != blank %}
                    <div class="scrollable-faq__item-image origin-proportions scrollable-faq__item-icons">
                      <img
                        src="{{ icon | img_url: 'master'}}"
                        alt="{{ icon.alt }}"
                        loading="lazy"
                        width="70"
                        height="48"
                      >
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              {% assign text = block.settings.text | replace: '[[point]]', "<span class='icon-point'></span>" %}

              <div class="scrollable-faq__item-text">
                {{ text }}
              </div>
            {% endif %}

            <div class="scrollable-faq__item-images">
              {% for i in (1..5) %}
                {% assign image_below_key = 'image_below' | append: i %}
                {% assign image_below = block.settings[image_below_key] %}

                {% if image_below != blank %}
                  <div class="scrollable-faq__item-icon {% if block.settings.image_below_origin_proportions %}origin-proportions{% endif %}">
                    <img
                      src="{{ image_below | img_url: 'master'}}"
                      alt="{{ image_below.alt }}"
                      loading="lazy"
                    >
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            {% if block.settings.addr1 != blank %}
              <div class="address-wrapper">
                <span class="title">{{ block.settings.addrtitle1 }}</span>
                <p>{{ block.settings.addrtext1 }}</p>
                <span class="address">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M4.75 10.1482C4.75 7.63087 5.66985 5.80032 7.00337 4.59302C8.34965 3.37416 10.1636 2.75 12 2.75C13.8364 2.75 15.6504 3.37418 16.9966 4.59304C18.3301 5.80035 19.25 7.63089 19.25 10.1482C19.25 13.4221 17.2847 16.2839 15.2683 18.3449C14.5408 19.0884 14.0747 19.5589 13.5981 19.8644C13.1668 20.1408 12.7127 20.288 12.0002 20.288C11.2877 20.288 10.8336 20.1409 10.4023 19.8644C9.9257 19.559 9.45955 19.0885 8.73207 18.345C6.71544 16.284 4.75 13.4221 4.75 10.1482ZM20.75 10.1482C20.75 7.23337 19.6699 4.98983 18.0034 3.48107C16.3496 1.98387 14.1636 1.25001 12 1.25C9.83643 1.24999 7.65035 1.98385 5.99663 3.48105C4.33015 4.98981 3.25 7.23335 3.25 10.1482C3.25 14.0136 5.5502 17.2379 7.65992 19.3941L7.70691 19.4421L7.70693 19.4421C8.37418 20.1242 8.95657 20.7195 9.59294 21.1274C10.2895 21.5738 11.0303 21.788 12.0002 21.788C12.9702 21.788 13.711 21.5737 14.4075 21.1273C15.0439 20.7194 15.6262 20.1241 16.2935 19.442L16.2935 19.4419L16.3405 19.3939C18.45 17.2377 20.75 14.0135 20.75 10.1482ZM9.75 10C9.75 8.75739 10.7574 7.75003 12 7.75003C13.2426 7.75003 14.25 8.75739 14.25 10C14.25 11.2427 13.2426 12.25 12 12.25C10.7574 12.25 9.75 11.2427 9.75 10ZM12 6.25003C9.92893 6.25003 8.25 7.92896 8.25 10C8.25 12.0711 9.92893 13.75 12 13.75C14.0711 13.75 15.75 12.0711 15.75 10C15.75 7.92896 14.0711 6.25003 12 6.25003Z" fill="#F1592A"/>
                  </svg>
                  {{ block.settings.addr1 -}}
                </span>
              </div>
            {% endif %}

            {% if block.settings.addr2 != blank %}
              <div class="address-wrapper">
                <span class="title">{{ block.settings.addrtitle2 }}</span>
                <p>{{ block.settings.addrtext2 }}</p>
                <span class="address">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M4.75 10.1482C4.75 7.63087 5.66985 5.80032 7.00337 4.59302C8.34965 3.37416 10.1636 2.75 12 2.75C13.8364 2.75 15.6504 3.37418 16.9966 4.59304C18.3301 5.80035 19.25 7.63089 19.25 10.1482C19.25 13.4221 17.2847 16.2839 15.2683 18.3449C14.5408 19.0884 14.0747 19.5589 13.5981 19.8644C13.1668 20.1408 12.7127 20.288 12.0002 20.288C11.2877 20.288 10.8336 20.1409 10.4023 19.8644C9.9257 19.559 9.45955 19.0885 8.73207 18.345C6.71544 16.284 4.75 13.4221 4.75 10.1482ZM20.75 10.1482C20.75 7.23337 19.6699 4.98983 18.0034 3.48107C16.3496 1.98387 14.1636 1.25001 12 1.25C9.83643 1.24999 7.65035 1.98385 5.99663 3.48105C4.33015 4.98981 3.25 7.23335 3.25 10.1482C3.25 14.0136 5.5502 17.2379 7.65992 19.3941L7.70691 19.4421L7.70693 19.4421C8.37418 20.1242 8.95657 20.7195 9.59294 21.1274C10.2895 21.5738 11.0303 21.788 12.0002 21.788C12.9702 21.788 13.711 21.5737 14.4075 21.1273C15.0439 20.7194 15.6262 20.1241 16.2935 19.442L16.2935 19.4419L16.3405 19.3939C18.45 17.2377 20.75 14.0135 20.75 10.1482ZM9.75 10C9.75 8.75739 10.7574 7.75003 12 7.75003C13.2426 7.75003 14.25 8.75739 14.25 10C14.25 11.2427 13.2426 12.25 12 12.25C10.7574 12.25 9.75 11.2427 9.75 10ZM12 6.25003C9.92893 6.25003 8.25 7.92896 8.25 10C8.25 12.0711 9.92893 13.75 12 13.75C14.0711 13.75 15.75 12.0711 15.75 10C15.75 7.92896 14.0711 6.25003 12 6.25003Z" fill="#F1592A"/>
