/* ===============================
  SAVE CHANGES
================================ */
document.addEventListener('click', async e => {
  if (!e.target.matches('#addon-save')) return;

  const popup = document.getElementById('addon-edit-popup');
  const groupId = popup.dataset.groupId;

  const cart = await fetch('/cart.js').then(r=>r.json());
  const mainItem = cart.items.find(
    i => i.properties?.group_id == groupId && !i.properties?.Add_on
  );

  const selected = [...popup.querySelectorAll('.addon-radio:checked')];
  const titles = selected.map(i=>i.dataset.title).join(', ');
  const variantIds = selected.map(i=>String(i.dataset.variantId));

  // remove unselected addons
  for (const item of cart.items.filter(i=>i.properties?.Add_on && i.properties.group_id==groupId)) {
    if (!variantIds.includes(String(item.variant_id))) {
      await fetch('/cart/change.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({id:item.key,quantity:0})
      });
    }
