  const popup = document.getElementById('addon-edit-popup');
  popup.dataset.groupId = groupId;

  const cart = await fetch('/cart.js').then(r=>r.json());
  const mainItem = cart.items.find(
    i => i.properties?.group_id == groupId && !i.properties?.Add_on
  );
  if (!mainItem) return;

  const html = await fetch(mainItem.url).then(r=>r.text());
  const doc = new DOMParser().parseFromString(html,'text/html');
  const options = doc.querySelector('.customproduct_option');
  if (!options) return;

  popup.querySelector('.addon-popup-content').innerHTML = options.innerHTML;

  // preselect existing addons
  cart.items
    .filter(i => i.properties?.group_id == groupId && i.properties?.Add_on)
    .forEach(addon=>{
      const input = popup.querySelector(
        `.addon-radio[data-variant-id="${addon.variant_id}"]`
      );
      if (input) input.checked = true;
    });

  popup.style.display = 'block';
});

/* ===============================
  POPUP CLOSE
================================ */
document.addEventListener('click', e => {
  if (
    e.target.matches('.addon-popup-overlay') ||
    e.target.matches('.addon-popup-close') ||
    e.target.matches('#addon-cancel')
  ) {
    document.getElementById('addon-edit-popup').style.display = 'none';
  }
