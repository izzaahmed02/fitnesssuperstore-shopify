<script>
    /* ======================================================
   GLOBAL HELPERS
====================================================== */

/* Safe money formatter */
function formatMoney(cents) {
  const format = window.themeMoneyFormat || '${{amount}}';
  const value = (cents / 100).toFixed(2);
  return format.replace(/\{\{\s*amount\s*\}\}/, value);
}

/* ======================================================
   PRICE MERGE (MAIN + ADDONS)
====================================================== */

async function mergeAddonPrices() {
  try {
    const cart = await fetch('/cart.js').then(res => res.json());

    // 1️⃣ collect addon totals per group_id
    const addonTotalsByGroup = {};
    cart.items.forEach(item => {
      const groupId = item.properties?.group_id;
      const isAddon = !!item.properties?.Add_on;

      if (groupId && isAddon) {
        addonTotalsByGroup[groupId] =
          (addonTotalsByGroup[groupId] || 0) + item.line_price;
      }
    });

    // 2️⃣ update prices in DOM
    document.querySelectorAll('.cart-item').forEach(cartItemEl => {

      // skip addon rows
      if (cartItemEl.classList.contains('avis-option')) return;

      const groupEl = cartItemEl.querySelector('[data-name="group_id"]');
      if (!groupEl) return;

      const groupId = groupEl.dataset.value;
      const addonPrice = addonTotalsByGroup[groupId];
      if (!addonPrice) return;

      const mainItem = cart.items.find(i =>
        i.properties?.group_id == groupId &&
        !i.properties?.Add_on
      );
      if (!mainItem) return;

      const finalPrice = mainItem.line_price + addonPrice;

      // update ALL price nodes (desktop + mobile)
      const priceEls = cartItemEl.querySelectorAll('.price.price--end');
      priceEls.forEach(el => {
        el.innerHTML = formatMoney(finalPrice);
      });
    });

  } catch (err) {
    console.error('Price merge failed', err);
  }
}

/* ======================================================
   QTY SYNC (MAIN → ADDONS)
====================================================== */

document.addEventListener('change', function (e) {
  if (!e.target.matches('.quantity__input')) return;

  const qty = parseInt(e.target.value, 10);
  if (isNaN(qty) || qty < 1) return;

  const cartItemEl = e.target.closest('.cart-item');
  if (!cartItemEl) return;

  // skip addon rows
  if (cartItemEl.classList.contains('avis-option')) return;

  const groupEl = cartItemEl.querySelector('[data-name="group_id"]');
  if (!groupEl) return;

  syncAddonQuantities(groupEl.dataset.value, qty);
});

async function syncAddonQuantities(groupId, qty) {
  try {
    const cart = await fetch('/cart.js').then(res => res.json());

    const addons = cart.items.filter(item =>
      item.properties?.group_id == groupId &&
      item.properties?.Add_on
    );

    for (const addon of addons) {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: addon.key,
          quantity: qty
        })
      });
    }
  } catch (err) {
    console.error('Addon qty sync failed', err);
  }
}

/* ======================================================
   REMOVE SYNC (POPUP BASED)
====================================================== */

let pendingRemoveGroupId = null;

// STEP 1: ❌ click par group_id store
document.addEventListener('click', function (e) {
  const removeIcon = e.target.closest('.cart-item__remove a');
  if (!removeIcon) return;

  const cartItemEl = removeIcon.closest('.cart-item');
  if (!cartItemEl) return;

  if (cartItemEl.classList.contains('avis-option')) return;

  const groupEl = cartItemEl.querySelector('[data-name="group_id"]');
  if (!groupEl) return;

  pendingRemoveGroupId = groupEl.dataset.value;
});

// STEP 2: popup confirm remove
document.addEventListener('click', function (e) {
  const confirmBtn = e.target.closest('.cart-items__popup-btn--remove');
  if (!confirmBtn) return;

  if (!pendingRemoveGroupId) return;

  removeAddonItems(pendingRemoveGroupId);
  pendingRemoveGroupId = null;
});

async function removeAddonItems(groupId) {
  try {
    const cart = await fetch('/cart.js').then(res => res.json());

    const addons = cart.items.filter(item =>
      item.properties?.group_id == groupId &&
      item.properties?.Add_on
    );

    for (const addon of addons) {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: addon.key,
          quantity: 0
        })
      });
    }

    setTimeout(() => window.location.reload(), 300);

  } catch (err) {
    console.error('Addon remove failed', err);
  }
}

/* ======================================================
   DEBOUNCED CART OBSERVER (CRITICAL FIX)
====================================================== */

let mergeTimeout = null;

document.addEventListener('DOMContentLoaded', function () {
  const cartContainer = document.querySelector('cart-items');
  if (!cartContainer) return;

  // initial run
  mergeAddonPrices();

  const observer = new MutationObserver(() => {
    if (mergeTimeout) clearTimeout(mergeTimeout);

    // wait till cart settles
    mergeTimeout = setTimeout(() => {
      mergeAddonPrices();
    }, 300);
  });

  observer.observe(cartContainer, {
    childList: true,
    subtree: true
  });
});


/* ======================================================
   ENSURE PRICE MERGE AFTER CART UPDATE IS COMPLETE
====================================================== */

let afterQtyChangeTimer = null;

document.addEventListener('click', function (e) {

  // + / − button OR manual qty change
  if (
    e.target.closest('. cart-quantity .quantity__button') ||
    e.target.closest('. cart-quantity .quantity__input')
  ) {
    if (afterQtyChangeTimer) clearTimeout(afterQtyChangeTimer);

    // wait till Shopify finishes AJAX + DOM replace
    afterQtyChangeTimer = setTimeout(() => {
      mergeAddonPrices();
    }, 600); // 👈 important
  }
});




</script>








