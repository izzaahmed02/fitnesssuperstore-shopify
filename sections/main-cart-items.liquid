  // add new addons
  for (const id of variantIds) {
    if (!cart.items.find(i=>String(i.variant_id)==id && i.properties?.Add_on)) {
      await fetch('/cart/add.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          items:[{
            id,
            quantity:1,
            properties:{group_id:groupId,Add_on:'Yes'}
          }]
        })
