{% style %}
/* Container for the entire section */
.payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

/* Sticky Sidebar */
.sidebar {
  width: 250px;
  position: sticky;
  top: 20px;
  height: fit-content;
  background-color: #f8f8f8;
  padding: 20px;
  border-right: 1px solid #ddd;
}

.sidebar h3 {
  background-color: #e67e22;
  color: white;
  padding: 10px;
  margin: -20px -20px 20px -20px;
  font-size: 18px;
}

.sidebar ul {
  list-style: none;
  padding: 0;
}

.sidebar li {
  margin: 10px 0;
}

.sidebar a {
  text-decoration: none;
  color: #333;
  font-size: 16px;
}

.sidebar a:hover {
  color: #e67e22;
}

/* Accordion Section */
.accordion-container {
  flex: 1;
  padding: 0 20px;
}

.accordion {
  border-bottom: 1px solid #ddd;
  margin-bottom: 10px;
}

.accordion-header {
  background-color: #f5f5f5;
  padding: 15px;
  cursor: pointer;
  font-size: 18px;
  font-weight: bold;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.accordion-header::after {
  content: '+';
  font-size: 20px;
  transition: transform 0.3s ease;
}

.accordion-header.active::after {
  content: '−';
  transform: rotate(180deg);
}

.accordion-content {
  display: none;
  padding: 15px;
  font-size: 14px;
  line-height: 1.6;
}

.accordion-content.active {
  display: block;
}

/* Responsive Design */
@media (max-width: 768px) {
  .payment-methods-container {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    position: static;
    border-right: none;
    border-bottom: 1px solid #ddd;
  }

  .accordion-container {
    padding: 20px 0;
  }
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
  <div class="sidebar">
    <h3>{{ section.settings.sidebar_title }}</h3>
    <ul>
      {% for block in section.blocks %}
        {% if block.type == 'sidebar_link' %}
          <li><a href="#{{ block.settings.link_id }}">{{ block.settings.link_text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Accordion Content -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header">{{ block.settings.accordion_title }}</div>
          <div class="accordion-content">
            {{ block.settings.accordion_content }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
// JavaScript for Accordion Functionality
document.querySelectorAll('.accordion-header').forEach(header => {
  header.addEventListener('click', () => {
    const content = header.nextElementSibling;
    const isActive = content.classList.contains('active');

    // Close all other accordions
    document.querySelectorAll('.accordion-content').forEach(item => {
      item.classList.remove('active');
    });
    document.querySelectorAll('.accordion-header').forEach(item => {
      item.classList.remove('active');
    });

    // Toggle the clicked accordion
    if (!isActive) {
      content.classList.add('active');
      header.classList.add('active');
    }
  });
});
</script>

