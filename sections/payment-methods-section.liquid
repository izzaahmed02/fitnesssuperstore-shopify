{% style %}
.payment-methods .accordion-container ul {
  margin-left: 1.25rem;
}

.payment-methods .accordion-container ol li {
  font-family: DM Sans, sans-serif;
  font-weight: 400;
  font-size: clamp(0.75rem, 2vw, 0.875rem);
  line-height: 1.25rem;
  letter-spacing: 0;
  font-variant-numeric: lining-nums proportional-nums;
  color: #333333;
}

.payment-methods .accordion-container ol {
  margin-top: 0.3125rem;
}

.payment-methods .accordion-content-text p a,
.payment-methods .accordion-content-text li a {
  color: #DF633A;
  font-weight: 700;
}

.payment-methods .accordion-container ul li:before {
  content: "";
  border: 4px solid #FE8425;
  border-radius: 50px;
  margin-top: 0.5rem;
  margin-left: -1.25rem;
  position: absolute;
}

.payment-methods .accordion-container ol li:before {
  content: "*";
  margin-top: 0.1875rem;
  margin-left: -1.125rem;
  position: absolute;
  color: #FE8425;
  width: 0.4375rem;
  height: 0.4375rem;
}

.payment-methods .sidebar li {
  padding: 0;
  border: 1px solid #E5E5E5;
  margin-bottom: 0.75rem;
  border-radius: 4px;
  list-style: none;
}

.payment-methods .sidebar li.active {
  background-color: #DF633A;
}

.payment-methods .sidebar li.active a {
  color: #fff;
}

.payment-methods .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: DM Sans, sans-serif;
  font-weight: 700;
  font-size: clamp(0.875rem, 2.5vw, 1.125rem);
  line-height: 1.5rem;
  letter-spacing: 0;
  padding: 0.75rem;
  border-radius: 4px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.payment-methods .sidebar a:hover {
  color: #fff;
  background-color: #DF633A;
}

.payment-methods .sidebar a.active {
  background-color: #DF633A;
  color: #fff;
}

.payment-methods .payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: min(1320px, 100vw - 2rem);
  margin: 0 auto;
  padding: 1.25rem;
  gap: 1.5rem;
}

.payment-methods .sidebar {
  flex: 0 0 min(35%, 35rem);
  position: sticky;
  top: 1.25rem;
  align-self: start;
  padding: 0;
}

.payment-methods .sidebar h3 {
  padding: 0;
  margin: 0;
  font-family: DM Sans, sans-serif;
  font-weight: 700;
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  line-height: 1.3;
  letter-spacing: 0.0625rem;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
}

.payment-methods .sidebar ul {
  list-style: none;
  padding: 0;
}

.payment-methods .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  margin-bottom: 0.9375rem;
}

.payment-methods .logo-image {
  width: clamp(60px, 10vw, 70px);
  object-fit: cover;
}

.payment-methods .accordion-container {
  flex: 1;
  padding: 0;
  min-width: 0;
}

.payment-methods .accordion {
  border-bottom: none;
  margin-bottom: 2.375rem;
}

.payment-methods .accordion-header {
  font-family: DM Sans, sans-serif;
  font-weight: 700;
  font-size: clamp(1.25rem, 3vw, 1.5rem);
  line-height: 2rem;
  letter-spacing: 0;
  margin-bottom: 1rem;
}

.payment-methods .accordion-header::after {
  content: '+';
  font-size: 1.25rem;
  transition: transform 0.3s ease;
}

.payment-methods .accordion-header.active::after {
  content: '−';
  transform: rotate(180deg);
}

.payment-methods .accordion-content-text {
  font-family: DM Sans, sans-serif;
  font-weight: 400;
  font-size: clamp(0.875rem, 2vw, 1rem);
  line-height: 1.5rem;
  letter-spacing: 0;
}

/* Desktop Styles (> 1024px) */
@media (min-width: 1025px) {
  .payment-methods .accordion-header.active::after {
    display: none;
  }

  .payment-methods .accordion-header {
    cursor: default;
  }

  .payment-methods .accordion-header::after {
    content: none;
  }

  .payment-methods .accordion-content-text {
    display: block;
  }
}

/* Tablet Styles (769px–1024px) */
@media (min-width: 769px) and (max-width: 1024px) {
  .payment-methods .payment-methods-container {
    flex-direction: column;
    align-items: center;
  }

  .payment-methods .sidebar {
    flex: 0 0 100%;
    max-width: 90%;
    position: static;
    margin-bottom: 1.5rem;
  }

  .payment-methods .sidebar a {
    padding: 1rem;
  }

  .payment-methods .accordion-container {
    width: 100%;
    min-width: 0;
  }

  .payment-methods .accordion-header {
    cursor: default;
  }

  .payment-methods .accordion-header::after {
    content: none;
  }

  .payment-methods .accordion-content-text {
    display: block;
  }
}

/* Mobile Styles (≤ 768px) */
@media (max-width: 768px) {
  .payment-methods .payment-methods-container {
    flex-direction: column;
    padding: 1rem;
  }

  .payment-methods .sidebar {
    flex: 0 0 100%;
    position: static;
    border-bottom: 1px solid #ddd;
    display: none;
  }

  .payment-methods .sidebar a {
    padding: 1rem;
  }

  .payment-methods .accordion-container {
    padding: 1.25rem 0;
  }

  .payment-methods .accordion-header {
    cursor: pointer;
  }

  .payment-methods .accordion-content-text {
    display: none;
  }

  .payment-methods .accordion-content-text.active {
    display: block;
  }
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
  <div class="sidebar" role="navigation" aria-label="Payment Methods Menu">
    <h3>{{ section.settings.sidebar_title }}</h3>
    <ul>
      {% for block in section.blocks %}
        {% if block.type == 'sidebar_link' %}
          <li {% if forloop.index == 1 %}class="active"{% endif %}><a href="#{{ block.settings.link_id }}" class="sidebar-link" aria-current="{% if forloop.index == 1 %}page{% endif %}">{{ block.settings.link_text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header" role="button" aria-expanded="false" aria-controls="accordion-content-{{ block.settings.accordion_id }}">{{ block.settings.accordion_title }}</div>
          <div class="accordion-content-container" id="accordion-content-{{ block.settings.accordion_id }}">
            <!-- Logo Container -->
            {% if block.settings.num_logos > 0 %}
              <div class="logo-container">
                {% for i in (1..block.settings.num_logos) %}
                  {% assign logo_key = 'logo_' | append: i %}
                  {% if block.settings[logo_key] %}
                    <img src="{{ block.settings[logo_key] | img_url: '100x' }}" alt="{{ block.settings.accordion_title }} Logo {{ i }}" class="logo-image">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            <!-- Accordion Content Text -->
            <div class="accordion-content-text">
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
// Debounce function to limit resize event calls
function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

function initializeAccordionsAndSidebar() {
  const isMobile = window.innerWidth <= 768;
  const isTablet = window.innerWidth > 768 && window.innerWidth <= 1024;

  // Remove existing event listeners from accordion headers
  document.querySelectorAll('.payment-methods .accordion-header').forEach(header => {
    header.removeEventListener('click', toggleAccordion);
  });

  // Accordion functionality
  if (isMobile) {
    document.querySelectorAll('.payment-methods .accordion-header').forEach(header => {
      header.addEventListener('click', toggleAccordion);
      header.setAttribute('aria-expanded', header.classList.contains('active') ? 'true' : 'false');
    });

    function toggleAccordion() {
      const content = this.nextElementSibling.querySelector('.accordion-content-text');
      const isActive = content.classList.contains('active');

      // Close all other accordions
      document.querySelectorAll('.payment-methods .accordion-content-text').forEach(item => {
        item.classList.remove('active');
        item.parentElement.previousElementSibling.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('.payment-methods .accordion-header').forEach(item => {
        item.classList.remove('active');
      });

      // Toggle the clicked accordion
      if (!isActive) {
        content.classList.add('active');
        this.classList.add('active');
        this.setAttribute('aria-expanded', 'true');
      }
    }
  } else {
    // On desktop and tablet, ensure all accordion content is visible
    document.querySelectorAll('.payment-methods .accordion-content-text').forEach(content => {
      content.classList.add('active');
    });
    document.querySelectorAll('.payment-methods .accordion-header').forEach(header => {
      header.classList.add('active');
      header.setAttribute('aria-expanded', 'true');
    });
  }

  // Sidebar visibility
  const sidebar = document.querySelector('.payment-methods .sidebar');
  if (isMobile) {
    sidebar.style.display = 'none';
  } else {
    sidebar.style.display = 'block';
  }

  // Sidebar link click handling
  document.querySelectorAll('.payment-methods .sidebar-link').forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);

      // Update active states
      document.querySelectorAll('.payment-methods .sidebar li').forEach(li => {
        li.classList.remove('active');
      });
      document.querySelectorAll('.payment-methods .sidebar a').forEach(a => {
        a.classList.remove('active');
        a.setAttribute('aria-current', 'false');
      });

      this.parentElement.classList.add('active');
      this.classList.add('active');
      this.setAttribute('aria-current', 'page');

      // Scroll to target
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // Handle URL hash on load
  const hash = window.location.hash.substring(1);
  if (hash) {
    const targetLink = document.querySelector(`.payment-methods .sidebar a[href="#${hash}"]`);
    if (targetLink) {
      document.querySelectorAll('.payment-methods .sidebar li').forEach(li => {
        li.classList.remove('active');
      });
      document.querySelectorAll('.payment-methods .sidebar a').forEach(a => {
        a.classList.remove('active');
        a.setAttribute('aria-current', 'false');
      });

      targetLink.classList.add('active');
      targetLink.parentElement.classList.add('active');
      targetLink.setAttribute('aria-current', 'page');

      const targetElement = document.getElementById(hash);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    }
  }
}

// Initialize on page load
initializeAccordionsAndSidebar();

// Debounced resize handler
window.addEventListener('resize', debounce(initializeAccordionsAndSidebar, 200));
</script>

