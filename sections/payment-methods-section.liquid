{% style %}

 .payment-methods .accordion-container ul{
   margin-left: 20px;
 }

 .payment-methods .accordion-container ol li{
    font-family: var(--font-body-family);
font-weight: 400;
font-size: 14px;
line-height: 20px;
letter-spacing: 0%;
font-variant-numeric-figure: lining-nums;
font-variant-numeric-spacing: proportional-nums;
color: #333333;
  }

.payment-methods .accordion-container ol{
  margin-top: 5px;
}
  .payment-methods .accordion-content-text p a, .payment-methods .accordion-content-text li a{
    color: #D83D0E;
    font-weight: 700;
  }

  .payment-methods .accordion-container ul li:before {
    content: "";
    width: 8px;
    height: 8px;
    background: #3E77AA;
    border-radius: 50%;
    margin-top: 8px;
    margin-left: -20px;
    position: absolute;
}

   .payment-methods .accordion-container ol li:before {
    content: "*";
    margin-top: 3px;
    margin-left: -18px;
    position: absolute;
    color: #FE8425;
    width: 7px;
    height: 7px;
}


.payment-methods .sidebar li {
  padding: 0;
  border: 1px solid #E5E5E5;
  margin-bottom: 12px;
  border-radius: 4px;
  list-style: none;
}

  .payment-methods .sidebar li.active {
  background-color: #D83D0E;
}

  .payment-methods .sidebar li.active a{
    color: #fff;
  }

.payment-methods .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: var(--font-body-family);
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  padding: 12px;
  border-radius: 4px;
  transition: background-color 0.3s ease, color 0.3s ease;
}


.payment-methods .sidebar a:hover {
  color: #fff;
  background-color: #D83D0E;
}

.payment-methods .sidebar a.active {
  background-color: #D83D0E;
  color: #fff; 
}


.payment-methods .payment-methods-container {
  display: flex;
  font-family: var(--font-body-family);
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}


.payment-methods .sidebar {

  position: sticky;
  top: 20px;
  height: fit-content;
padding: 0;
  flex: 1;
  max-width: 570px;
    margin-right: 54px;

}

.payment-methods .sidebar h3 {
  padding: 0px;
  margin: 0px;
  font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 40px;
    line-height: 52px;
    letter-spacing: 1px;
    text-transform: uppercase;
  margin-bottom: 24px;
}

.payment-methods .sidebar ul {
  list-style: none;
  padding: 0;
}


/* Logo Container */
.payment-methods .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
}

.payment-methods .logo-image {
  width: 70px;
  height: 48px;
  object-fit: contain;
}

/* Accordion Section */
.payment-methods .accordion-container {
  flex: 1;
  padding: 0;
 
}

.payment-methods .accordion {
  border-bottom: none;
  margin-bottom: 38px;
}

.payment-methods .accordion-header {
font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0px;
    margin-bottom: 16px;
}

.payment-methods .accordion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.payment-methods .accordion-chevron {
  display: flex;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.payment-methods .accordion-header.active .accordion-chevron {
  transform: rotate(180deg);
}

.payment-methods .accordion-content-text {

font-family: var(--font-body-family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0px;
}

/* Desktop Styles (> 768px) */
@media (min-width: 769px) {
  .payment-methods .accordion-header {
    cursor: default; /* Non-clickable on desktop */
  }

  .payment-methods .accordion-chevron {
    display: none; /* Remove indicator arrow */
  }

  .payment-methods .accordion-content-text {
    display: block; /* Always show content */
  }
}

/* Mobile Styles (≤ 768px) */
@media (max-width: 768px) {
  .payment-methods .payment-methods-container {
    flex-direction: column;
  }

  .payment-methods .sidebar {
    width: 100%;
    position: static;
    border-right: none;
    border-bottom: 1px solid #ddd;
    display: none;
  }

  .payment-methods .accordion-container {
    padding: 20px 0;
  }

  .payment-methods .accordion-header {
    cursor: pointer;
    font-family: var(--font-body-family);
font-weight: 700;
font-size: 18px;
line-height: 24px;
letter-spacing: 0px;
    margin-bottom: 0;

  }

  .payment-methods .accordion-content-container{
    padding-top: 20px;
  }

  .payment-methods .payment-methods-container{
    padding: 16px;
  }

  .payment-methods .accordion {
    border-bottom: none;
    margin-bottom: 0;
}

  .payment-methods .accordion-content-text {
    display: none; /* Hidden by default on mobile */
  }

  .payment-methods .accordion-content-text.active {
    display: block; /* Show when active */
  }
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
 <div class="sidebar">
  <h3>{{ section.settings.sidebar_title }}</h3>
  <ul>
    {% for block in section.blocks %}
      {% if block.type == 'sidebar_link' %}
        <li {% if forloop.index == 1 %}class="active"{% endif %}><a href="#{{ block.settings.link_id }}" class="sidebar-link">{{ block.settings.link_text }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header" role="button" tabindex="0" aria-expanded="false">
            <span class="accordion-header-title">{{ block.settings.accordion_title }}</span>
            <span class="accordion-chevron" aria-hidden="true">
              <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0.21967 0.21967C0.512563 -0.0732233 0.987437 -0.0732233 1.28033 0.21967L6.75 5.68934L12.2197 0.21967C12.5126 -0.0732233 12.9874 -0.0732233 13.2803 0.21967C13.5732 0.512563 13.5732 0.987437 13.2803 1.28033L7.28033 7.28033C6.98744 7.57322 6.51256 7.57322 6.21967 7.28033L0.21967 1.28033C-0.0732233 0.987437 -0.0732233 0.512563 0.21967 0.21967Z" fill="currentColor"/>
              </svg>
            </span>
          </div>
          <div class="accordion-content-container">
            <div class="accordion-content-text">
               {% if block.settings.num_logos > 0 %}
              <div class="logo-container">
                {% for i in (1..block.settings.num_logos) %}
                  {% assign logo_key = 'logo_' | append: i %}
                  {% if block.settings[logo_key] %}
                    <img src="{{ block.settings[logo_key] | img_url: '100x' }}" alt="{{ block.settings.accordion_title }} Logo {{ i }}" class="logo-image">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
// JavaScript for Accordion and Sidebar Functionality
//
// Listeners are bound ONCE per section instance via event delegation on each
// instance's own .accordion-container / .sidebar root, so a mobile resize
// (address bar show/hide, orientation change, keyboard open/close) never
// re-registers duplicate handlers. isMobile is re-checked at click time
// instead of re-binding on every resize. Desktop's "always open" display is
// handled entirely by CSS (.accordion-content-text is display:block above
// 768px regardless of .active), so no JS pass is needed for that state.
// The site header is position:sticky and overlays the top of the viewport, so
// scrolling a target to y=0 (the browser's default scrollIntoView behaviour)
// lands it partly underneath the header instead of fully in view. Measure the
// header at click time rather than assuming a fixed height, since its height
// differs between mobile and desktop.
const HEADER_HEIGHT_FALLBACK = 120;
const HEADING_GAP = 16;
function stickyHeaderOffset() {
  const header = document.querySelector('.section-header');
  const height = header ? Math.round(header.getBoundingClientRect().height) : 0;
  return (height > 0 ? height : HEADER_HEIGHT_FALLBACK) + HEADING_GAP;
}
function scrollToTarget(targetElement) {
  const top = targetElement.getBoundingClientRect().top + window.scrollY - stickyHeaderOffset();
  window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
}

document.querySelectorAll('.payment-methods').forEach(function (root) {
  if (root.dataset.paymentMethodsInit) return;
  root.dataset.paymentMethodsInit = '1';

  const accordionContainer = root.querySelector('.accordion-container');
  const sidebar = root.querySelector('.sidebar');

  function toggleAccordion(header) {
    if (window.innerWidth > 768) return; // desktop: always open, non-interactive
    const content = header.nextElementSibling.querySelector('.accordion-content-text');
    if (!content) return;
    const isActive = content.classList.contains('active');

    accordionContainer.querySelectorAll('.accordion-content-text').forEach(item => item.classList.remove('active'));
    accordionContainer.querySelectorAll('.accordion-header').forEach(item => {
      item.classList.remove('active');
      item.setAttribute('aria-expanded', 'false');
    });

    if (!isActive) {
      content.classList.add('active');
      header.classList.add('active');
      header.setAttribute('aria-expanded', 'true');
    }
  }

  if (accordionContainer) {
    accordionContainer.addEventListener('click', function (e) {
      const header = e.target.closest('.accordion-header');
      if (header) toggleAccordion(header);
    });
    accordionContainer.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const header = e.target.closest('.accordion-header');
      if (!header) return;
      e.preventDefault();
      toggleAccordion(header);
    });
  }

  function setActiveSidebarLink(link) {
    sidebar.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    sidebar.querySelectorAll('a').forEach(a => a.classList.remove('active'));
    link.parentElement.classList.add('active');
    link.classList.add('active');
  }

  if (sidebar) {
    sidebar.addEventListener('click', function (e) {
      const link = e.target.closest('.sidebar-link');
      if (!link) return;
      e.preventDefault();
      const targetId = link.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId);
      setActiveSidebarLink(link);
      if (targetElement) scrollToTarget(targetElement);
    });

    // Highlight sidebar item based on URL hash on page load
    const hash = window.location.hash.substring(1);
    if (hash) {
      const targetLink = sidebar.querySelector(`a[href="#${hash}"]`);
      const targetElement = document.getElementById(hash);
      if (targetLink && targetElement) {
        setActiveSidebarLink(targetLink);
        scrollToTarget(targetElement);
      }
    }
  }
});
</script>

