{% style %}
/* Container for the entire section */
.payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}

/* Sticky Sidebar */
.sidebar {
  min-width: 570px;
  position: sticky;
  top: 20px;
  height: fit-content;
padding: 0;
    margin-right: 54px;

}

.sidebar h3 {
  padding: 0px;
  margin: 0px;
  font-family: DM Sans;
    font-weight: 700;
    font-size: 40px;
    line-height: 52px;
    letter-spacing: 1px;
    text-transform: uppercase;
  margin-bottom: 24px;
}

.sidebar ul {
  list-style: none;
  padding: 0;
}

.sidebar li {
  padding: 10px 0;
  border: 1px solid #E5E5E5;
  margin-bottom: 12px;
  border-radius: 4px;
}

.sidebar a {
  text-decoration: none;
  color: #000;
  font-family: DM Sans;
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0px;
  padding: 12px;
}

.sidebar a:hover {
  color: #e67e22;
}

/* Logo Container */
.logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
}

.logo-image {
  height: 30px;
  width: auto;
  object-fit: contain;
}

/* Accordion Section */
.accordion-container {
  flex: 1;
  padding: 0;
  min-width: 656px;
}

.accordion {
  border-bottom: 1px solid #ddd;
  margin-bottom: 10px;
}

.accordion-header {
font-family: DM Sans;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0px;
    margin-bottom: 16px;
}

.accordion-header::after {
  content: '+';
  font-size: 20px;
  transition: transform 0.3s ease;
}

.accordion-header.active::after {
  content: '−';
  transform: rotate(180deg);
}

.accordion-content-text {
  padding: 15px;
  font-size: 14px;
  line-height: 1.6;
}

/* Desktop Styles (> 768px) */
@media (min-width: 769px) {
  .accordion-header {
    cursor: default; /* Non-clickable on desktop */
  }

  .accordion-header::after {
    content: none; /* Remove +/− indicators */
  }

  .accordion-content-text {
    display: block; /* Always show content */
  }
}

/* Mobile Styles (≤ 768px) */
@media (max-width: 768px) {
  .payment-methods-container {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    position: static;
    border-right: none;
    border-bottom: 1px solid #ddd;
    display: none;
  }

  .accordion-container {
    padding: 20px 0;
  }

  .accordion-header {
    cursor: pointer; /* Clickable on mobile */
  }

  .accordion-content-text {
    display: none; /* Hidden by default on mobile */
  }

  .accordion-content-text.active {
    display: block; /* Show when active */
  }
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
  <div class="sidebar">
    <h3>{{ section.settings.sidebar_title }}</h3>
    <ul>
      {% for block in section.blocks %}
        {% if block.type == 'sidebar_link' %}
          <li><a href="#{{ block.settings.link_id }}">{{ block.settings.link_text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header">{{ block.settings.accordion_title }}</div>
          <div class="accordion-content-container">
            <!-- Logo Container -->
            {% if block.settings.num_logos > 0 %}
              <div class="logo-container">
                {% for i in (1..block.settings.num_logos) %}
                  {% assign logo_key = 'logo_' | append: i %}
                  {% if block.settings[logo_key] %}
                    <img src="{{ block.settings[logo_key] | img_url: '100x' }}" alt="{{ block.settings.accordion_title }} Logo {{ i }}" class="logo-image">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            <!-- Accordion Content Text -->
            <div class="accordion-content-text">
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
// JavaScript for Accordion Functionality on Mobile
function initializeAccordions() {
  const isMobile = window.innerWidth <= 768;

  // Remove existing event listeners by re-querying headers
  document.querySelectorAll('.accordion-header').forEach(header => {
    // Remove any existing click listeners (to avoid duplicates)
    header.removeEventListener('click', toggleAccordion);
  });

  if (isMobile) {
    // Apply accordion functionality only on mobile
    document.querySelectorAll('.accordion-header').forEach(header => {
      header.addEventListener('click', toggleAccordion);
    });

    // Ensure only one accordion is open at a time
    function toggleAccordion() {
      const content = this.nextElementSibling.querySelector('.accordion-content-text');
      const isActive = content.classList.contains('active');

      // Close all other accordions
      document.querySelectorAll('.accordion-content-text').forEach(item => {
        item.classList.remove('active');
      });
      document.querySelectorAll('.accordion-header').forEach(item => {
        item.classList.remove('active');
      });

      // Toggle the clicked accordion
      if (!isActive) {
        content.classList.add('active');
        this.classList.add('active');
      }
    }
  } else {
    // On desktop, ensure all content is visible
    document.querySelectorAll('.accordion-content-text').forEach(content => {
      content.classList.add('active');
    });
    document.querySelectorAll('.accordion-header').forEach(header => {
      header.classList.add('active');
    });
  }
}

// Initialize on page load
initializeAccordions();

// Re-initialize on window resize to handle dynamic changes
window.addEventListener('resize', initializeAccordions);
</script>

