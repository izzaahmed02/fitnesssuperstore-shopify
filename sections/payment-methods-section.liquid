{% style %}

 .payment-methods .accordion-container ul{
   margin-left: 20px;
 }

 .payment-methods .accordion-container ol li{
    font-family: var(--font-body-family);
font-weight: 400;
font-size: 14px;
line-height: 20px;
letter-spacing: 0%;
font-variant-numeric-figure: lining-nums;
font-variant-numeric-spacing: proportional-nums;
color: #333333;
  }

.payment-methods .accordion-container ol{
  margin-top: 5px;
}
  .payment-methods .accordion-content-text p a, .payment-methods .accordion-content-text li a{
    color: #D83D0E;
    font-weight: 700;
  }

  .payment-methods .accordion-container ul li:before {
    content: "";
    border: 4px #FE8425 solid !important;
    border-radius: 50px;
    margin-top: 8px;
    margin-left: -20px;
    position: absolute;
}

   .payment-methods .accordion-container ol li:before {
    content: "*";
    margin-top: 3px;
    margin-left: -18px;
    position: absolute;
    color: #FE8425;
    width: 7px;
    height: 7px;
}


.payment-methods .sidebar li {
  padding: 0;
  border: 1px solid #E5E5E5;
  margin-bottom: 12px;
  border-radius: 4px;
  list-style: none;
}

  .payment-methods .sidebar li.active {
  background-color: #D83D0E;
}

  .payment-methods .sidebar li.active a{
    color: #fff;
  }

.payment-methods .sidebar a {
  display: block;
  text-decoration: none;
  color: #000;
  font-family: var(--font-body-family);
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  padding: 12px;
  border-radius: 4px;
  transition: background-color 0.3s ease, color 0.3s ease;
}


.payment-methods .sidebar a:hover {
  color: #fff;
  background-color: #D83D0E;
}

.payment-methods .sidebar a.active {
  background-color: #D83D0E;
  color: #fff; 
}


.payment-methods .payment-methods-container {
  display: flex;
  font-family: Arial, sans-serif;
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}


.payment-methods .sidebar {

  /* --pm-sticky-top is measured from the theme's sticky header at runtime, so
     the box parks just below it instead of behind it. The fallback covers the
     moment before the script runs. */
  position: sticky;
  top: var(--pm-sticky-top, 20px);
  max-height: calc(100vh - var(--pm-sticky-top, 20px) - 20px);
  overflow-y: auto;
  height: fit-content;
padding: 0;
  flex: 1;
  max-width: 570px;
    margin-right: 54px;

}

.payment-methods .sidebar h3 {
  padding: 0px;
  margin: 0px;
  font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 40px;
    line-height: 52px;
    letter-spacing: 1px;
    text-transform: uppercase;
  margin-bottom: 24px;
}

.payment-methods .sidebar ul {
  list-style: none;
  padding: 0;
}


/* Logo Container */
.payment-methods .logo-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
}

.payment-methods .logo-image {
width: 70px;
    height: auto;
    object-fit: contain;
}

/* Accordion Section */
.payment-methods .accordion-container {
  flex: 1;
  padding: 0;
 
}

.payment-methods .accordion {
  border-bottom: none;
  margin-bottom: 38px;
}

.payment-methods .accordion-header {
font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0px;
    margin-bottom: 16px;
}

.payment-methods .accordion-header .accordion-chevron {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  transition: transform 0.3s ease;
}

.payment-methods .accordion-header.active .accordion-chevron {
  transform: rotate(180deg);
}

.payment-methods .accordion-header:focus-visible {
  outline: 2px solid #D83D0E;
  outline-offset: 2px;
}

.payment-methods .accordion-content-text {

font-family: var(--font-body-family);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0px;
}

/* Desktop Styles (> 768px) */
@media (min-width: 769px) {
  .payment-methods .accordion-header {
    cursor: default; /* Non-clickable on desktop */
  }

  .payment-methods .accordion-header .accordion-chevron {
    display: none; /* Content is always expanded on desktop */
  }

  .payment-methods .accordion-content-text {
    display: block; /* Always show content */
  }
}

/* Mobile Styles (≤ 768px) — matches "Payment Methods - Mobile" in Figma */
@media (max-width: 768px) {
  .payment-methods .payment-methods-container {
    flex-direction: column;
    padding: 24px 16px;
    gap: 0;
  }

  .payment-methods .sidebar {
    width: 100%;
    position: static;
    border-right: none;
    border-bottom: none;
    display: none; /* The accordion headers are the mobile method list */
  }

  .payment-methods .accordion-container {
    padding: 0;
  }

  /* 16px between rows, so each 40px row sits on a 56px pitch */
  .payment-methods .accordion {
    border-bottom: none;
    margin-bottom: 16px;
  }

  .payment-methods .accordion:last-child {
    margin-bottom: 0;
  }

  .payment-methods .accordion-header {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    margin-bottom: 0;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0px;
    color: #000000;
  }

  .payment-methods .accordion-content-container {
    padding-top: 0;
  }

  .payment-methods .accordion-content-text {
    display: none; /* Hidden by default on mobile */
    padding-top: 16px;
  }

  .payment-methods .accordion-content-text.active {
    display: block; /* Show when active */
  }
}
{% endstyle %}

<div class="payment-methods-container">
  <!-- Sticky Sidebar -->
 <div class="sidebar">
  <h3>{{ section.settings.sidebar_title }}</h3>
  <ul>
    {% for block in section.blocks %}
      {% if block.type == 'sidebar_link' %}
        <li {% if forloop.index == 1 %}class="active"{% endif %}><a href="#{{ block.settings.link_id }}" class="sidebar-link">{{ block.settings.link_text }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

  <!-- Accordion/Content Section -->
  <div class="accordion-container">
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        <div class="accordion" id="{{ block.settings.accordion_id }}">
          <div class="accordion-header" aria-controls="{{ section.id }}-{{ block.id }}-content">
            <span class="accordion-header__text">{{ block.settings.accordion_title }}</span>
            {% render 'chevron' %}
          </div>
          <div class="accordion-content-container" id="{{ section.id }}-{{ block.id }}-content">
            <div class="accordion-content-text">
               {% if block.settings.num_logos > 0 %}
              <div class="logo-container">
                {% for i in (1..block.settings.num_logos) %}
                  {% assign logo_key = 'logo_' | append: i %}
                  {% if block.settings[logo_key] %}
                    {{-
                      block.settings[logo_key]
                      | image_url: width: 210
                      | image_tag:
                        class: 'logo-image',
                        widths: '70, 140, 210',
                        sizes: '70px',
                        loading: 'lazy',
                        alt: block.settings.accordion_title
                    -}}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
              {{ block.settings.accordion_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;

  var MOBILE = '(max-width: 768px)';
  var headers = Array.prototype.slice.call(root.querySelectorAll('.accordion-header'));
  var links = Array.prototype.slice.call(root.querySelectorAll('.sidebar-link'));

  function isMobile() {
    return window.matchMedia(MOBILE).matches;
  }

  function closeAll() {
    headers.forEach(function (header) {
      header.classList.remove('active');
      header.setAttribute('aria-expanded', 'false');
      var content = header.parentElement.querySelector('.accordion-content-text');
      if (content) content.classList.remove('active');
    });
  }

  function openHeader(header) {
    header.classList.add('active');
    header.setAttribute('aria-expanded', 'true');
    var content = header.parentElement.querySelector('.accordion-content-text');
    if (content) content.classList.add('active');
  }

  function toggle(header) {
    var wasOpen = header.classList.contains('active');
    closeAll();
    if (!wasOpen) openHeader(header);
  }

  headers.forEach(function (header) {
    header.addEventListener('click', function () {
      if (isMobile()) toggle(header);
    });

    header.addEventListener('keydown', function (event) {
      if (!isMobile()) return;
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        toggle(header);
      }
    });
  });

  // Desktop shows every panel and exposes no controls; mobile is a collapsed accordion.
  function applyBreakpoint() {
    if (isMobile()) {
      headers.forEach(function (header) {
        header.setAttribute('role', 'button');
        header.setAttribute('tabindex', '0');
        if (!header.hasAttribute('aria-expanded')) {
          header.setAttribute('aria-expanded', 'false');
        }
      });
    } else {
      headers.forEach(function (header) {
        header.removeAttribute('role');
        header.removeAttribute('tabindex');
        header.removeAttribute('aria-expanded');
        header.classList.add('active');
        var content = header.parentElement.querySelector('.accordion-content-text');
        if (content) content.classList.add('active');
      });
    }
    updateStickyRoom();
  }

  function setActiveLink(targetId) {
    links.forEach(function (link) {
      var isTarget = link.getAttribute('href') === '#' + targetId;
      link.classList.toggle('active', isTarget);
      link.parentElement.classList.toggle('active', isTarget);
    });
  }

  // The theme header is `position: sticky; top: 0`, so scrolling a block flush
  // to the top of the viewport parks its heading underneath the header.
  var SCROLL_GAP = 16;

  function stickyBottom() {
    var header = document.querySelector('.section-header');
    if (!header) return 0;
    var position = window.getComputedStyle(header).position;
    if (position !== 'sticky' && position !== 'fixed') return 0;
    return Math.max(0, header.getBoundingClientRect().bottom);
  }

  function scrollToPanel(target) {
    lockSpy();
    var top = window.scrollY + target.getBoundingClientRect().top - stickyBottom() - SCROLL_GAP;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });

    // The header collapses as the page scrolls, so its height when the click
    // lands is not its height when the scroll stops. Re-measure once it has
    // settled and close any gap that is still covering the heading.
    window.setTimeout(function () {
      var covered = stickyBottom() + SCROLL_GAP - target.getBoundingClientRect().top;
      if (covered > 1) {
        window.scrollBy({ top: -covered, behavior: 'smooth' });
        lockSpy();
      }
    }, 600);
  }

  links.forEach(function (link) {
    link.addEventListener('click', function (event) {
      event.preventDefault();
      var targetId = this.getAttribute('href').substring(1);
      // Resolve inside this section so a second instance never steals the target.
      var target = root.querySelector('[id="' + targetId + '"]');
      setActiveLink(targetId);
      if (target) scrollToPanel(target);
    });
  });

  // Follow the reader: highlight the method whose block the page is showing.
  var panels = Array.prototype.slice.call(root.querySelectorAll('.accordion'));
  var spyLockedUntil = 0;
  var spyQueued = false;

  function lockSpy() {
    spyLockedUntil = Date.now() + 900;
  }

  function sidebarVisible() {
    var sidebar = root.querySelector('.sidebar');
    return sidebar && sidebar.offsetParent !== null;
  }

  function syncActiveToScroll() {
    spyQueued = false;
    if (Date.now() < spyLockedUntil || !sidebarVisible() || !panels.length) return;

    // Just under the sticky header: the block whose heading has most recently
    // passed beneath it is the one being read.
    var header = stickyBottom();
    var line = header ? header + 24 : window.innerHeight * 0.25;
    var current = panels[0];
    panels.forEach(function (panel) {
      if (panel.getBoundingClientRect().top <= line) current = panel;
    });

    // Past the last block, the last item stays selected rather than resetting.
    if (current.id) setActiveLink(current.id);
  }

  // The header shrinks once the page scrolls, so the offset the sidebar parks
  // at is re-measured rather than assumed.
  var appliedStickyTop = null;

  function updateStickyTop() {
    var offset = Math.round(stickyBottom() + 16);
    if (offset === appliedStickyTop) return;
    appliedStickyTop = offset;
    root.style.setProperty('--pm-sticky-top', offset + 'px');
  }

  // A sticky box is released by its container one box-height before the
  // container ends, and the last method is far shorter than the box - so
  // without this the list has already slid away by the time you reach it.
  // Topping up the column keeps the list on screen for every method.
  function updateStickyRoom() {
    var list = root.querySelector('.accordion-container');
    var sidebar = root.querySelector('.sidebar');
    if (!list || !sidebar || !panels.length) return;
    if (!sidebarVisible()) {
      list.style.paddingBottom = '';
      return;
    }
    var shortfall = sidebar.offsetHeight - panels[panels.length - 1].offsetHeight;
    list.style.paddingBottom = shortfall > 0 ? shortfall + 'px' : '';
  }

  function onScroll() {
    updateStickyTop();
    syncActiveToScroll();
  }

  window.addEventListener('scroll', function () {
    if (spyQueued) return;
    spyQueued = true;
    window.requestAnimationFrame(onScroll);
  }, { passive: true });

  window.addEventListener('resize', function () {
    updateStickyTop();
    updateStickyRoom();
  });
  updateStickyTop();
  updateStickyRoom();
  // Panel heights settle once the method logos have loaded.
  window.addEventListener('load', updateStickyRoom);

  var hash = window.location.hash.substring(1);
  var deepLinked = hash && root.querySelector('[id="' + hash + '"]');
  if (deepLinked) {
    setActiveLink(hash);
    scrollToPanel(deepLinked);
  } else {
    syncActiveToScroll();
  }

  applyBreakpoint();
  window.addEventListener('resize', applyBreakpoint);
})();
</script>

{% schema %}
{
  "name": "Payment Methods",
  "class": "payment-methods",
  "settings": [
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Sidebar Title",
      "default": "METHODS"
    }
  ],
  "blocks": [
    {
      "type": "sidebar_link",
      "name": "Sidebar Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Link"
        },
        {
          "type": "text",
          "id": "link_id",
          "label": "Link ID (for anchor)",
          "default": "link-id"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion Section",
      "settings": [
        {
          "type": "text",
          "id": "accordion_title",
          "label": "Accordion Title",
          "default": "Accordion Title"
        },
        {
          "type": "text",
          "id": "accordion_id",
          "label": "Accordion ID (for anchor)",
          "default": "accordion-id"
        },
        {
          "type": "range",
          "id": "num_logos",
          "label": "Number of Logos",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        },
        {
          "type": "image_picker",
          "id": "logo_1",
          "label": "Logo 1"
        },
        {
          "type": "image_picker",
          "id": "logo_2",
          "label": "Logo 2"
        },
        {
          "type": "image_picker",
          "id": "logo_3",
          "label": "Logo 3"
        },
        {
          "type": "image_picker",
          "id": "logo_4",
          "label": "Logo 4"
        },
        {
          "type": "image_picker",
          "id": "logo_5",
          "label": "Logo 5"
        },
        {
          "type": "richtext",
          "id": "accordion_content",
          "label": "Accordion Content",
          "default": "<p>Add your content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment Methods",
      "blocks": [
        {
          "type": "sidebar_link",
          "settings": {
            "link_text": "Credit & Debit Cards",
            "link_id": "credit-debit-cards"
          }
        },
        {
          "type": "sidebar_link",
          "settings": {
            "link_text": "Leasing & Financing",
            "link_id": "leasing-financing"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "accordion_title": "Credit & Debit Cards",
            "accordion_id": "credit-debit-cards",
            "num_logos": 4,
