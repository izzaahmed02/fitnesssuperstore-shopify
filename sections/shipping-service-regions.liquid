{%- liquid
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .service-regions__inner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    padding: 28px 16px;
  }

  #shopify-section-{{ section.id }} .service-regions__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .service-regions__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .service-regions__content {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .service-regions__title {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.15;
    text-transform: uppercase;
    text-align: center;
    color: #ffffff;
    margin: 0 0 40px;
  }

  #shopify-section-{{ section.id }} .service-regions__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .service-regions__col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .service-regions__card {
    background: #ffffff;
    border-radius: 16px;
    padding: 28px 32px;
  }

  #shopify-section-{{ section.id }} .service-regions__card > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .service-regions__card > summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .service-regions__card-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }

  #shopify-section-{{ section.id }} .service-regions__card-title {
    font-family: Lato, sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 28px;
    color: #23232b;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .service-regions__card-chevron {
    margin-left: auto;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .service-regions__card[open] .service-regions__card-chevron {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .service-regions__card-text,
  #shopify-section-{{ section.id }} .service-regions__card-text p {
    color: #393940;
    font-size: 16px;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .service-regions__card-text {
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .service-regions__card-text > *:last-child {
    margin-bottom: 0;
  }

  /* Desktop: cards stay open, not collapsible, chevron hidden */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .service-regions__card > summary {
      pointer-events: none;
      cursor: default;
    }

    #shopify-section-{{ section.id }} .service-regions__card-chevron {
      display: none;
    }
  }

  /* Mobile: photo becomes a top banner, dark block becomes light, cards are accordions */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .service-regions__inner {
      background-color: transparent;
      padding: 0;
      border-radius: 0;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .service-regions__bg {
      position: static;
      width: 100%;
      height: 210px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .service-regions__overlay {
      display: none;
    }

    #shopify-section-{{ section.id }} .service-regions__title {
      color: #23232b;
      text-align: left;
      font-size: 34px;
      line-height: 1.1;
      margin: 20px 0 16px;
    }

    #shopify-section-{{ section.id }} .service-regions__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .service-regions__col {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .service-regions__card {
      border: 1px solid #ececec;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .service-regions__card > summary {
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .service-regions__card-title {
      font-size: 20px;
      line-height: 26px;
    }
  }
{%- endstyle -%}

<div class="service-regions section-{{ section.id }}-padding scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="service-regions__inner">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2200
          | image_tag: class: 'service-regions__bg', loading: 'lazy', alt: section.settings.title
        }}
        <div class="service-regions__overlay"></div>
      {%- endif -%}

      <div class="service-regions__content">
        {%- if section.settings.title != blank -%}
          <h2 class="service-regions__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="service-regions__grid">
            <div class="service-regions__col">
              {%- for block in section.blocks -%}
                {%- if forloop.index0 < half -%}
                  {%- render 'shipping-region-card', block: block -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="service-regions__col">
              {%- for block in section.blocks -%}
                {%- if forloop.index0 >= half -%}
                  {%- render 'shipping-region-card', block: block -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var cards = section.querySelectorAll('details.service-regions__card');
    if (!cards.length) return;
    var mq = window.matchMedia('(min-width: 750px)');

    function apply(e) {
      if (e.matches) {
        // Desktop: keep every card open.
        cards.forEach(function (card) { card.open = true; });
      } else {
        // Mobile: collapse to an accordion, first card open.
        cards.forEach(function (card, i) { card.open = i === 0; });
      }
    }

    apply(mq);
    if (mq.addEventListener) {
      mq.addEventListener('change', apply);
    } else if (mq.addListener) {
      mq.addListener(apply);
    }
  })();
</script>

{% schema %}
{
  "name": "Shipping service regions",
  "class": "shipping-service-regions",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shipping & Service Regions"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Shown as a full background on desktop and as a top banner on mobile."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2e2e2e"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Background image overlay opacity",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. Leave blank to use the default location pin icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping service regions",
      "blocks": [
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" }
      ]
    }
  ]
}
{% endschema %}
