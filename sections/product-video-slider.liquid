{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Product Videos"
    },
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row (desktop)",
      "default": "2",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Video Slider"
    }
  ]
}
{% endschema %}

{%- assign extra = product.metafields.custom.extra_info.value -%}

{%- comment -%}
  Build array of video URLs from:
  - extra.instructional_video_url.value  (single URL)
  - extra.other_videos.value (list of links: link.url)
{%- endcomment -%}

{% assign videos = '' | split: ',' %}

{% if extra %}
  {%- comment -%} Main instructional video {%- endcomment -%}
  {% if extra.instructional_video_url != blank %}
    {% assign videos = videos | push: extra.instructional_video_url.value %}
  {% endif %}

  {%- comment -%} Other videos list {%- endcomment -%}
  {% if extra.other_videos != blank %}
    {% for link in extra.other_videos.value %}
      {% if link.url != blank %}
        {% assign videos = videos | push: link.url %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% if videos.size > 0 %}
  <div class="video-carousel-section product-video-slider">
    <h2 class="carouselHdg">{{ section.settings.heading }}</h2>

    <div
      class="product-video-slider-track"
      data-videos-per-row="{{ section.settings.videos_per_row }}"
    >
      {% assign thumb = product.featured_image | image_url: width: 1200 %}

      {% for video_url in videos %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-thumbnail" data-video-url="{{ video_url }}">
              {% if thumb %}
                <img src="{{ thumb }}" alt="{{ product.title | escape }}">
              {% endif %}
              <div class="play-button">&#9658;</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Popup modal {%- endcomment -%}
    <div class="video-modal" id="productVideoModal">
      <div class="modal-content">
        <span class="close-modal" id="productVideoModalClose">&times;</span>
        <div id="productModalVideoContainer"></div>
      </div>
    </div>
  </div>
{% endif %}

<style>
  .product-video-slider .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: left;
    margin-bottom: 24px;
  }

  .product-video-slider {
    max-width: 1320px;
    padding: 20px;
    margin: 0 auto;
  }

  .product-video-slider-track .video-slide {
    padding: 0 12px;
    box-sizing: border-box;
  }

  .product-video-slider-track .video-slide-inner {
    background: #f7f7f7;
    border-radius: 16px;
    padding: 16px;
  }

  .product-video-slider .video-thumbnail {
    position: relative;
    cursor: pointer;
  }

  .product-video-slider .video-thumbnail img {
    width: 100%;
    display: block;
    border-radius: 12px;
  }

  .product-video-slider .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 22px;
    color: #fff;
    background: #23232b4d;
    backdrop-filter: blur(6px);
    padding: 12px 16px;
    border-radius: 50%;
  }

  /* Modal styles */
  .product-video-slider .video-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(0,0,0,0.8);
    padding: 20px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
  }

  .product-video-slider .modal-content {
    position: relative;
    max-width: 1280px;
    width: 100%;
    max-height: calc(100vh - 40px);
    background: transparent;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .product-video-slider .modal-content iframe {
    width: 100%;
    height: calc(100vh - 40px - 60px);
    border-radius: 16px;
    border: none;
  }

  .product-video-slider .close-modal {
    position: absolute;
    top: -52px;
    right: 0;
    font-size: 28px;
    background: #616166;
    cursor: pointer;
    height: 40px;
    width: 40px;
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Slick arrows & dots */
  .product-video-slider .slick-prev,
  .product-video-slider .slick-next {
    height: 40px;
    width: 40px;
    border-radius: 100px;
    font-size: 0;
    line-height: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 99;
    cursor: pointer;
    color: transparent;
    border: none;
    outline: none;
    background: #616166;
  }

  .product-video-slider .slick-prev {
    left: -8px;
  }

  .product-video-slider .slick-next {
    right: -8px;
  }

  .product-video-slider .slick-next:before,
  .product-video-slider .slick-prev:before {
    content: '' !important;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-size: contain;
    background-repeat: no-repeat;
  }

  .product-video-slider .slick-next:before {
    background-image: url('{{ "arrow-right.svg" | asset_url }}') !important;
  }

  .product-video-slider .slick-prev:before {
    background-image: url('{{ "arrow-left.svg" | asset_url }}') !important;
  }

  .product-video-slider .slick-dots {
    margin-top: 16px;
  }

  .product-video-slider .slick-dots li button:before {
    font-size: 10px;
  }

  @media (max-width: 749px) {
    .product-video-slider {
      padding: 16px;
    }

    .product-video-slider .carouselHdg {
      font-size: 20px;
      margin-bottom: 16px;
    }

    .product-video-slider .slick-prev,
    .product-video-slider .slick-next {
      width: 32px;
      height: 32px;
      top: 100%;
      transform: translateY(-50%);
    }

    .product-video-slider .slick-prev {
      left: 0;
    }

    .product-video-slider .slick-next {
      right: 0;
    }

    .product-video-slider .modal-content iframe {
      height: calc(100vh - 20px - 60px);
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('.product-video-slider-track');
  if (!$slider.length) return;

  var perRow = parseInt($slider.data('videos-per-row'), 10) || 2;
  var desktopSlides = Math.min(perRow, 3);

  $slider.slick({
    slidesToShow: desktopSlides,
    slidesToScroll: 1,
    arrows: true,
    dots: true,
    responsive: [
      {
        breakpoint: 750,
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });

  var $modal = $('#productVideoModal');
  var $modalContainer = $('#productModalVideoContainer');

  function openVideoModal(src) {
    if (!src) return;

    var html = '<iframe src="' + src + '" ' +
               'frameborder="0" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" ' +
               'allowfullscreen></iframe>';

    $modalContainer.html(html);
    $modal.css('display', 'flex');
  }

  function closeVideoModal() {
    $modal.css('display', 'none');
    $modalContainer.html('');
  }

  // Open on thumbnail click
  $('.product-video-slider-track').on('click', '.video-thumbnail', function () {
    var src = $(this).data('video-url');
    openVideoModal(src);
  });

  // Close button
  $('#productVideoModalClose').on('click', function () {
    closeVideoModal();
  });

  // Click outside content to close
  $modal.on('click', function (e) {
    if ($(e.target).is('#productVideoModal')) {
      closeVideoModal();
    }
  });

  // Expose close function globally if needed
  window.closeProductVideoModal = closeVideoModal;
});
</script>
