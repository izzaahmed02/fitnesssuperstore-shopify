{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Product videos"
    },
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row (desktop)",
      "default": "2",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "blocks": [],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Product Video Slider"
    }
  ]
}
{% endschema %}

{%- assign extra = product.metafields.custom.extra_info.value -%}

{%- comment -%}
  We will render:
  - 1 slide for extra.instructional_video_url.value (if present)
  - 1 slide for each link in extra.other_videos.value (if present)
{%- endcomment -%}

{% assign has_any_video = false %}

{% if extra %}
  {% if extra.instructional_video_url != blank and extra.instructional_video_url.value != blank %}
    {% assign has_any_video = true %}
  {% endif %}

  {% if extra.assembly_video != blank and extra.assembly_video.value != blank %}
    {% assign has_any_video = true %}
  {% endif %}

  {% if extra.other_videos != blank and extra.other_videos.value != blank %}
    {% assign has_any_video = true %}
  {% endif %}
{% endif %}

{% if has_any_video %}
  <div class="video-carousel-section extra-info-videos">
    <h2 class="carouselHdg">{{ section.settings.heading }}</h2>

    <div
      class="extra-info-video-slider"
      data-videos-per-row="{{ section.settings.videos_per_row }}"
    >
      {%- comment -%} Slide from instructional_video_url {%- endcomment -%}
      {% if extra.instructional_video_url != blank and extra.instructional_video_url.value != blank %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-embed-wrapper">
              <iframe
                src="{{ extra.instructional_video_url.value }}"
                loading="lazy"
                frameborder="0"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      {% endif %}

      {%- comment -%} Slides from other_videos list {%- endcomment -%}
      {% if extra.assembly_video != blank and extra.assembly_video.value != blank %}
       
            <div class="video-slide other-videos">
              <div class="video-slide-inner">
                <div class="video-embed-wrapper">
                  <iframe
                src="{{ extra.assembly_video.value }}"
                loading="lazy"
                frameborder="0"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
                </div>
              </div>
            </div>
         
      {% endif %}
    </div>
  </div>
{% endif %}

<style>
  .extra-info-videos .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: left;
    margin-bottom: 24px;
  }

  .extra-info-videos {
    max-width: 1320px;
    padding: 20px;
    margin: 0 auto;
  }

  .extra-info-video-slider .video-slide {
    padding: 0 12px;
    box-sizing: border-box;
  }

  .extra-info-video-slider .video-slide-inner {
    border-radius: 16px;
    background: #f7f7f7;
    padding: 16px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .extra-info-video-slider .video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }

  .extra-info-video-slider .video-embed-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Slick arrows & dots */
  .extra-info-videos .slick-prev,
  .extra-info-videos .slick-next {
    height: 40px;
    width: 40px;
    border-radius: 100px;
    font-size: 0;
    line-height: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 99;
    cursor: pointer;
    color: transparent;
    border: none;
    outline: none;
    background: #616166;
  }

  .extra-info-videos .slick-prev {
    left: -8px;
  }

  .extra-info-videos .slick-next {
    right: -8px;
  }

  .extra-info-videos .slick-next:before,
  .extra-info-videos .slick-prev:before {
    content: '' !important;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-size: contain;
    background-repeat: no-repeat;
  }

  .extra-info-videos .slick-next:before {
    background-image: url('{{ "arrow-right.svg" | asset_url }}') !important;
  }

  .extra-info-videos .slick-prev:before {
    background-image: url('{{ "arrow-left.svg" | asset_url }}') !important;
  }

  .extra-info-videos .slick-dots {
    margin-top: 16px;
  }

  .extra-info-videos .slick-dots li button:before {
    font-size: 10px;
  }

  @media (max-width: 749px) {
    .extra-info-videos {
      padding: 16px;
    }

    .extra-info-videos .carouselHdg {
      font-size: 20px;
      margin-bottom: 16px;
    }

    .extra-info-videos .slick-prev,
    .extra-info-videos .slick-next {
      width: 32px;
      height: 32px;
      top: 100%;
      transform: translateY(-50%);
    }

    .extra-info-videos .slick-prev {
      left: 0;
    }

    .extra-info-videos .slick-next {
      right: 0;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('.extra-info-video-slider');
  if (!$slider.length) return;

  var videosPerRow = parseInt($slider.data('videos-per-row'), 10) || 2;
  var desktopSlides = Math.min(videosPerRow, 3); // hard cap at 3

  $slider.slick({
    slidesToShow: desktopSlides,
    slidesToScroll: 1,
    arrows: true,
    dots: true,
    responsive: [
      {
        breakpoint: 750,
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });
});
</script>
