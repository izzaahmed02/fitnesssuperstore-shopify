{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Product videos"
    },
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row (desktop)",
      "default": "2",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Video Slider"
    }
  ]
}
{% endschema %}

{% assign extra = product.metafields.custom.extra_info.value %}
{% assign videos = '' | split: ',' %}

{% if extra %}

  {%- comment -%} Instructional video {%- endcomment -%}
  {% if extra.instructional_video_url and extra.instructional_video_url.value %}
    {% assign videos = videos | push: extra.instructional_video_url.value %}
  {% endif %}

  {%- comment -%} Assembly video {%- endcomment -%}
  {% if extra.assembly_video and extra.assembly_video.value %}
    {% assign videos = videos | push: extra.assembly_video.value %}
  {% endif %}

  {%- comment -%} Other videos {%- endcomment -%}
  {% if extra.other_videos and extra.other_videos.value %}
    {% for link in extra.other_videos.value %}
      {% if link.url != blank %}
        {% assign videos = videos | push: link.url %}
      {% endif %}
    {% endfor %}
  {% endif %}

{% endif %}

{% if videos.size > 0 %}
  <div class="video-carousel-section extra-info-videos">
    <h2 class="carouselHdg">{{ section.settings.heading }}</h2>

    <div class="extra-info-video-slider" data-videos-per-row="{{ section.settings.videos_per_row }}">

      {% assign thumb = product.featured_image | image_url: width: 1200 %}

      {% for video in videos %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-thumbnail" data-video-url="{{ video }}">
              <img src="{{ thumb }}" alt="{{ product.title }}">
              <div class="play-button">&#9658;</div>
            </div>
          </div>
        </div>
      {% endfor %}

    </div>

    {# Popup Modal #}
    <div class="video-modal" id="videoPopupModal">
      <div class="modal-content">
        <span class="close-modal" id="closeVideoPopup">&times;</span>
        <div id="videoPopupContainer"></div>
      </div>
    </div>

  </div>
{% endif %}

<style>
  .extra-info-videos .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 32px;
    margin-bottom: 24px;
  }

  .extra-info-video-slider .video-slide {
    padding: 0 12px;
  }

  .video-slide-inner {
    background: #f7f7f7;
    border-radius: 16px;
    padding: 16px;
  }

  .video-thumbnail {
    position: relative;
    cursor: pointer;
  }

  .video-thumbnail img {
    width: 100%;
    border-radius: 12px;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 24px;
    background: rgba(0,0,0,0.6);
    padding: 12px 16px;
    color: white;
    border-radius: 50%;
  }

  /* Modal */
  .video-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .modal-content {
    max-width: 1000px;
    width: 100%;
    position: relative;
  }

  .modal-content video,
  .modal-content iframe {
    width: 100%;
    height: 550px;
    background: black;
    border-radius: 10px;
  }

  .close-modal {
    position: absolute;
    top: -50px;
    right: 0;
    height: 45px;
    width: 45px;
    background: #616166;
    color: white;
    border-radius: 50%;
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var $slider = $(".extra-info-video-slider");

  $slider.slick({
    slidesToShow: parseInt($slider.data("videos-per-row")) || 2,
    slidesToScroll: 1,
    arrows: true,
    dots: false,
    responsive: [
      {
        breakpoint: 750,
        settings: { slidesToShow: 1 }
      }
    ]
  });

  var $modal = $("#videoPopupModal");
  var $container = $("#videoPopupContainer");

  // CLICK → open popup
  $(".video-thumbnail").click(function () {
    var videoUrl = $(this).data("video-url");

    var html = "";

    if (videoUrl.includes(".mp4")) {
      html =
        '<video controls autoplay><source src="' +
        videoUrl +
        '" type="video/mp4"></video>';
    } else {
      html =
        '<iframe src="' +
        videoUrl +
        '" frameborder="0" allowfullscreen></iframe>';
    }

    $container.html(html);
    $modal.css("display", "flex");
  });

  // Close modal
  $("#closeVideoPopup").click(function () {
    $modal.hide();
    $container.html("");
  });

  $modal.click(function (e) {
    if (e.target.id === "videoPopupModal") {
      $modal.hide();
      $container.html("");
    }
  });
});
</script>
