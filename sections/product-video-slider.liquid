{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "hdg",
      "default": "t:sections.rich-text.blocks.heading.settings.heading.default",
      "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row",
      "default": "3",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (YouTube or uploaded file URL)",
          "info": "Paste a YouTube link or a video file URL uploaded via Content > Files"
        },
        {
          "type": "video",
          "id": "shopify_video",
          "label": "Video File"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Product Video slider"
    }
  ]
}
{% endschema %}

<div class="video-carousel-section">
  <h2 class="carouselHdg">{{ section.settings.hdg }}</h2>

  <div
    class="video-carousel slick-carousel"
    data-videos-per-row="{{ section.settings.videos_per_row }}"
  >
    {% for block in section.blocks %}
      {% assign video_url = block.settings.video_url %}
      {% assign shopify_video = block.settings.shopify_video %}
{% assign extra = product.metafields.custom.extra_info.value %}
            {% assign addMoreSections = product.metafields.custom.add_more_sections.value %}
            {% assign attachments_metafield = product.metafields.custom.attachments_and_add_ons.value %}
            {% assign otherRigRackSystems = product.metafields.custom.recommended_products.value %}

      {%- comment -%}
        Choose thumbnail:
        1) Manual thumbnail if set
        2) Otherwise Shopify video preview image
      {%- endcomment -%}
      {% assign thumb_image = nil %}
      {% if block.settings.thumbnail != blank %}
        {% assign thumb_image = block.settings.thumbnail %}
      {% elsif shopify_video != blank %}
        {% assign thumb_image = shopify_video.preview_image %}
      {% endif %}

      {% if thumb_image %}
        {% assign fallback_thumb = thumb_image | image_url: width: 1200 %}
      {% endif %}

      {%- comment -%}
        Choose video source for player (external URL or Shopify mp4)
      {%- endcomment -%}
      {% assign player_src = '' %}
      {% assign video_type = '' %}

      {% if video_url != blank %}
        {% assign player_src = video_url %}
        {% assign video_type = 'external' %}
      {% elsif shopify_video != blank and shopify_video.sources != blank %}
        {% assign mp4_source = shopify_video.sources | where: "format", "mp4" | first %}
        {% if mp4_source != blank %}
          {% assign player_src = mp4_source.url %}
        {% else %}
          {% assign player_src = shopify_video.sources[0].url %}
        {% endif %}
        {% assign video_type = 'shopify' %}
      {% endif %}

      <div class="carousel-item">
        {% if extra.instructional_video_url != blank %}
        <div
          class="video-thumbnail"
          data-video-url="{{ extra.instructional_video_url.value }}"
          data-video-type="{{ video_type }}"
        >
          {% if fallback_thumb %}
            <img src="{{ fallback_thumb }}" alt="{{ block.settings.thumbnail.alt | escape }}" />
          {% endif %}
          <div class="play-button">&#9658;</div>
        </div>
    {% endif %}
        {%- comment -%}
          JSON-LD – reuse thumbnail & video src for SEO
        {%- endcomment -%}
        {% if shopify_video != blank and shopify_video.sources != blank %}
          {% assign video_src = shopify_video.sources[0].url %}
          {% assign video_embed = shopify_video.sources | where: "format", "mp4" | first %}
          {% assign video_thumb = thumb_image | image_url: width: 1200 %}

          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "VideoObject",
            "name": "{{ block.settings.thumbnail.alt | escape }}",
            "description": "Video about {{ section.settings.hdg | strip_html | escape }} — {{ block.settings.thumbnail.alt | escape }}",
            "thumbnailUrl": "{{ video_thumb | prepend: 'https:' }}",
            "uploadDate": "{{ 'now' | date: "%Y-%m-%d" }}",
            "duration": "PT1M57S",
            "contentUrl": "{{ video_src }}",
            "embedUrl": "{{ video_embed.url | default: video_src }}",
            "publisher": {
              "@type": "Organization",
              "name": "Fitness Superstore",
              "logo": {
                "@type": "ImageObject",
                "url": "{{ request.host | prepend: 'https://' }}/cdn/shop/files/Logo_Main_Dark_Background.svg?v=1745567646&width=500"
              }
            }
          }
          </script>
        {% elsif video_url != blank %}
          {% assign video_thumb = thumb_image | image_url: width: 1200 %}
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "VideoObject",
            "name": "{{ block.settings.thumbnail.alt | escape }}",
            "description": "Video about {{ section.settings.hdg | strip_html | escape }} — {{ block.settings.thumbnail.alt | escape }}",
            "thumbnailUrl": "{{ video_thumb | prepend: 'https:' }}",
            "uploadDate": "{{ 'now' | date: "%Y-%m-%d" }}",
            "duration": "PT1M57S",
            "contentUrl": "{{ video_url }}",
            "embedUrl": "{{ video_url }}",
            "publisher": {
              "@type": "Organization",
              "name": "Fitness Superstore",
              "logo": {
                "@type": "ImageObject",
                "url": "{{ request.host  | prepend: 'https://' }}/cdn/shop/files/Logo_Main_Dark_Background.svg?v=1745567646&width=500"
              }
            }
          }
          </script>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="video-modal" id="videoModal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeModal()">&times;</span>
      <div id="modalVideoContainer"></div>
    </div>
  </div>
</div>

<style>
  .video-carousel .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 48px;
    line-height: 68px;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    margin-bottom: 52px;
  }

  .video-carousel .slick-prev,
  .video-carousel .slick-next {
    height: 44px;
    width: 44px;
    border-radius: 100px;
    font-size: 0;
    line-height: 0;
    position: absolute;
    top: 50%;
    display: block;
    z-index: 999;
    padding: 0;
    -webkit-transform: translate(0, -50%);
    -ms-transform: translate(0,-50%);
    transform: translateY(-50%);
    cursor: pointer;
    color: transparent;
    border: none;
    outline: none;
    background: #616166;
  }

  .video-carousel button.slick-next.slick-arrow {
    position: absolute;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    width: 48px;
    height: 48px;
    display: flex;
    top: 50%;
    justify-content: center;
    align-items: center;
    right: -20px;
    z-index: 999;
  }

  .video-carousel button.slick-prev.slick-arrow {
    position: absolute;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    width: 48px;
    height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    right: 55px;
    z-index: 999;
  }

  /* Arrow icons */
  .video-carousel .slick-next:before {
    content: '' !important;
    background-image: url('{{ 'arrow-left.svg' | asset_url }}') !important;
    background-size: contain;
    background-repeat: no-repeat;
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .video-carousel .slick-prev:before {
    content: '' !important;
    background-image: url('{{ 'arrow-right.svg' | asset_url }}') !important;
    background-size: contain;
    background-repeat: no-repeat;
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .video-carousel .slick-dotted.slick-slider {
    margin-bottom: 70px;
  }

  .video-carousel .slick-dots {
    display: block !important;
    bottom: -50px !important;
  }

  .video-carousel .slick-dots li {
    width: auto;
    height: auto;
    margin: 0 3px;
  }

  .video-carousel .slick-dots li button {
    width: 12px !important;
    height: 12px !important;
    padding: 0 !important;
  }

  .video-carousel .slick-dots li button:before {
    font-size: 34px !important;
    line-height: 12px !important;
    width: 12px !important;
    height: 12px !important;
    content: '' !important;
    display: block !important;
    background-color: #ccc !important;
    border-radius: 50% !important;
  }

  .video-carousel .slick-dots li.slick-active button:before {
    background-color: #23232B !important;
  }

  .video-carousel .slick-next:focus,
  .video-carousel .slick-next:hover,
  .video-carousel .slick-prev:focus,
  .video-carousel .slick-prev:hover {
    background: #616166;
    outline: none !important;
  }

  .video-carousel .slick-slide {
    margin: 0 16px;
  }

  .video-carousel .slick-list {
    margin: 0 -18px;
  }

  .video-carousel .video-carousel-section {
    max-width: 1320px;
    padding: 20px;
    margin: 0 auto;
  }

  .video-carousel .video-thumbnail {
    position: relative;
    cursor: pointer;
  }

  .video-carousel .video-thumbnail img {
    border-radius: 12px;
    width: 100%;
  }

  .video-carousel .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 22px;
    color: white;
    backdrop-filter: blur(6px);
    background: #23232B4D;
    padding: 12px 16px;
    border-radius: 50%;
  }

  .video-carousel .video-modal {
    display: none;
    align-items: center;
    justify-content: center;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.8);
    padding: 20px;
    box-sizing: border-box;
  }

  .video-carousel .modal-content {
    position: relative;
    max-width: 1280px;
    max-height: calc(100vh - 40px);
    background: transparent;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .video-carousel .modal-content iframe,
  .video-carousel .modal-content video {
    width: 100%;
    max-height: calc(100vh - 40px - 86px);
    border-radius: 24px;
    height: auto;
    object-fit: contain;
  }

  .video-carousel .close-modal {
    position: absolute;
    top: -66px;
    right: 0px;
    font-size: 28px;
    background: #616166;
    cursor: pointer;
    height: 48px;
    width: 48px;
    border-radius: 34px;
    display: flex;
    font-weight: 100 !important;
    color: white;
    align-items: center;
    justify-content: center;
  }

  body.acsb-keynav :focus {
    outline: none !important;
  }

  @media screen and (max-width: 749px) {
    .video-carousel .carouselHdg {
      font-family: Oswald;
      font-weight: 600;
      font-size: 20px;
      line-height: 26px;
      letter-spacing: 0px;
      vertical-align: middle;
      text-transform: uppercase;
      text-align: left;
      margin-bottom: 20px;
    }

    .video-carousel .video-thumbnail img {
      border-radius: 24px;
      width: 100%;
    }

    .video-carousel button.slick-next.slick-arrow {
      width: 36px;
      height: 36px;
      right: 0;
      top: 100%;
    }

    .video-carousel button.slick-prev.slick-arrow {
      width: 36px;
      height: 36px;
      left: 0;
      top: 100%;
    }

    .video-carousel .slick-dotted.slick-slider {
      padding-bottom: 40px !important;
    }

    .video-carousel .slick-dots {
      display: block !important;
      bottom: -10px !important;
    }

    .video-carousel .video-carousel-section {
      max-width: 1320px;
      padding: 16px;
      margin: 0 auto;
    }

    .video-carousel .video-modal {
      padding: 10px;
    }

    .video-carousel .modal-content {
      max-height: calc(100vh - 20px);
    }

    .video-carousel .modal-content iframe,
    .video-carousel .modal-content video {
      max-height: calc(100vh - 20px - 66px);
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var $carousel = $('.video-carousel .slick-carousel');
  var videosPerRow = parseInt($carousel.data('videos-per-row'), 10) || 3;

  // Cap at max 3 on desktop
  var desktopSlides = Math.min(videosPerRow, 3);

  $carousel.slick({
    slidesToShow: desktopSlides,
    slidesToScroll: 1,
    arrows: true,
    cssEase: 'linear',
    dots: true,
    responsive: [
      {
        breakpoint: 1024,
        settings: {
          slidesToShow: desktopSlides
        }
      },
      {
        breakpoint: 750, // mobile: always 1
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });

  var $modal = $('#videoModal');
  var $modalContainer = $('#modalVideoContainer');

  function openVideoModal(src, type) {
    if (!src) return;

    var html = '';

    // YouTube handling for external URLs
    if (type === 'external' && (src.indexOf('youtube.com') > -1 || src.indexOf('youtu.be') > -1)) {
      var embedUrl = src;

      if (src.indexOf('watch?v=') > -1) {
        embedUrl = src.replace('watch?v=', 'embed/');
      }

      html = '<iframe src="' + embedUrl + '" frameborder="0" allowfullscreen></iframe>';
    } else {
      // Shopify hosted / direct video file
      html = '<video controls autoplay><source src="' + src + '" type="video/mp4"></video>';
    }

    $modalContainer.html(html);
    $modal.css('display', 'flex');
  }

  window.closeModal = function () {
    $modal.css('display', 'none');
    $modalContainer.html('');
  };

  // Close when clicking backdrop
  $modal.on('click', function (e) {
    if ($(e.target).is('#videoModal')) {
      window.closeModal();
    }
  });

  // Open modal when thumbnail clicked
  $('.video-carousel').on('click', '.video-thumbnail', function () {
    var src = $(this).data('video-url');
    var type = $(this).data('video-type');
    openVideoModal(src, type);
  });
});
</script>
