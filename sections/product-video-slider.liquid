{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Product Videos"
    },
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row (desktop)",
      "default": "2",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Video Slider"
    }
  ]
}
{% endschema %}

{%- assign extra = product.metafields.custom.extra_info.value -%}

{%- comment -%}
  Collect all videos:
  • extra.instructional_video_url.value → single video
  • extra.other_videos.value → list of videos (each link.url)
{%- endcomment -%}

{% assign videos = '' | split: ',' %}

{%- if extra != blank -%}

  {%- if extra.instructional_video_url != blank and extra.instructional_video_url.value != blank -%}
    {% assign videos = videos | push: extra.instructional_video_url.value %}
  {%- endif -%}

  {%- if extra.other_videos != blank and extra.other_videos.value != blank -%}
    {% for link in extra.other_videos.value %}
      {% if link.url != blank %}
        {% assign videos = videos | push: link.url %}
      {% endif %}
    {% endfor %}
  {%- endif -%}

{%- endif -%}

{% if videos.size > 0 %}
  <div class="video-carousel-section product-video-slider">
    <h2 class="carouselHdg">{{ section.settings.heading }}</h2>

    <div
      class="product-video-slider-track"
      data-videos-per-row="{{ section.settings.videos_per_row }}"
    >
      {% for video_url in videos %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-embed-wrapper">
              <iframe
                src="{{ video_url }}"
                loading="lazy"
                frameborder="0"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

<style>
  .product-video-slider .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 32px;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .product-video-slider {
    max-width: 1320px;
    padding: 20px;
    margin: 0 auto;
  }

  .product-video-slider-track .video-slide {
    padding: 0 12px;
  }

  .product-video-slider-track .video-slide-inner {
    background: #f7f7f7;
    border-radius: 16px;
    padding: 16px;
  }

  .video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: black;
    border-radius: 12px;
    overflow: hidden;
  }

  .video-embed-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .product-video-slider .slick-prev,
  .product-video-slider .slick-next {
    height: 40px;
    width: 40px;
    background: #616166;
    border-radius: 100px;
    z-index: 99;
  }

  .product-video-slider .slick-next:before {
    content: '' !important;
    background-image: url('{{ "arrow-right.svg" | asset_url }}');
    background-size: contain;
    width: 20px;
    height: 20px;
    display: inline-block;
  }

  .product-video-slider .slick-prev:before {
    content: '' !important;
    background-image: url('{{ "arrow-left.svg" | asset_url }}');
    background-size: contain;
    width: 20px;
    height: 20px;
    display: inline-block;
  }

  @media (max-width: 749px) {
    .product-video-slider .carouselHdg {
      font-size: 20px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('.product-video-slider-track');
  if (!$slider.length) return;

  var perRow = parseInt($slider.data('videos-per-row'), 10) || 2;
  var desktopSlides = Math.min(perRow, 3);

  $slider.slick({
    slidesToShow: desktopSlides,
    slidesToScroll: 1,
    arrows: true,
    dots: true,
    responsive: [
      {
        breakpoint: 750,
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });
});
</script>
