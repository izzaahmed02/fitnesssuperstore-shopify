{% schema %}
{
  "name": "Product Video Slider",
  "class": "video-carousel",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Instruction & Assembly Videos"
    }
  ],
  "blocks": [],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Product Video Slider"
    }
  ]
}
{% endschema %}

{% assign extra = product.metafields.custom.extra_info.value %}

{% assign has_instruction_video = false %}
{% assign has_assembly_video = false %}

{% if extra %}
  {% if extra.instructional_video_url != blank %}
    {% assign has_instruction_video = true %}
  {% endif %}
  {% if extra.assembly_video_url != blank %}
    {% assign has_assembly_video = true %}
  {% endif %}
{% endif %}

{% if has_instruction_video or has_assembly_video %}
  <div class="video-carousel-section instruction-assembly-section">
    <h2 class="carouselHdg">{{ section.settings.heading }}</h2>

    <div class="instruction-assembly-slider">
      {%- comment -%} Instructional video slide {%- endcomment -%}
      {% if has_instruction_video %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-label">Instructional video</div>
            <div class="video-embed-wrapper">
              <iframe
                src="{{ extra.instructional_video_url }}"
                title="Instructional video"
                loading="lazy"
                frameborder="0"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      {% endif %}

      {%- comment -%} Assembly video slide {%- endcomment -%}
      {% if has_assembly_video %}
        <div class="video-slide">
          <div class="video-slide-inner">
            <div class="video-label">Assembly video</div>
            <div class="video-embed-wrapper">
              <iframe
                src="{{ extra.assembly_video_url }}"
                title="Assembly video"
                loading="lazy"
                frameborder="0"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

<style>
  .instruction-assembly-section .carouselHdg {
    font-family: Oswald;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: left;
    margin-bottom: 24px;
  }

  .instruction-assembly-section {
    max-width: 1320px;
    padding: 20px;
    margin: 0 auto;
  }

  .instruction-assembly-slider .video-slide {
    padding: 0 12px;
    box-sizing: border-box;
  }

  .instruction-assembly-slider .video-slide-inner {
    border-radius: 16px;
    background: #f7f7f7;
    padding: 16px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .instruction-assembly-slider .video-label {
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .instruction-assembly-slider .video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }

  .instruction-assembly-slider .video-embed-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Slick arrows & dots for this slider */
  .instruction-assembly-section .slick-prev,
  .instruction-assembly-section .slick-next {
    height: 40px;
    width: 40px;
    border-radius: 100px;
    font-size: 0;
    line-height: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 99;
    cursor: pointer;
    color: transparent;
    border: none;
    outline: none;
    background: #616166;
  }

  .instruction-assembly-section .slick-prev {
    left: -8px;
  }

  .instruction-assembly-section .slick-next {
    right: -8px;
  }

  .instruction-assembly-section .slick-next:before,
  .instruction-assembly-section .slick-prev:before {
    content: '' !important;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-size: contain;
    background-repeat: no-repeat;
  }

  .instruction-assembly-section .slick-next:before {
    background-image: url('{{ "arrow-right.svg" | asset_url }}') !important;
  }

  .instruction-assembly-section .slick-prev:before {
    background-image: url('{{ "arrow-left.svg" | asset_url }}') !important;
  }

  .instruction-assembly-section .slick-dots {
    margin-top: 16px;
  }

  .instruction-assembly-section .slick-dots li button:before {
    font-size: 10px;
  }

  @media (max-width: 749px) {
    .instruction-assembly-section {
      padding: 16px;
    }

    .instruction-assembly-section .carouselHdg {
      font-size: 20px;
      margin-bottom: 16px;
    }

    .instruction-assembly-section .slick-prev,
    .instruction-assembly-section .slick-next {
      width: 32px;
      height: 32px;
      top: 100%;
      transform: translateY(-50%);
    }

    .instruction-assembly-section .slick-prev {
      left: 0;
    }

    .instruction-assembly-section .slick-next {
      right: 0;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('.instruction-assembly-slider');
  if (!$slider.length) return;

  $slider.slick({
    slidesToShow: 2,
    slidesToScroll: 1,
    arrows: true,
    dots: true,
    responsive: [
      {
        breakpoint: 750,
        settings: {
          slidesToShow: 1
        }
      }
    ]
  });
});
</script>
