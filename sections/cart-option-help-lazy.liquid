<div data-cart-option-help-content>
  {% for item in cart.items %}
    <div data-option-help-cart-item="{{ item.key | escape }}">
      {% assign options = item.product.metafields.options.product_options.value %}
      {% for category in options %}
        {% if category.help_text.value != blank %}
          {% liquid
            assign content = category.help_text.value
            assign title = content.title
            assign text = content.help_text
            assign related_products = content.related_products.value
          %}
          {% render 'related-products-popup-for-options',
            popup_id: category.title,
            title: title,
            related_products: related_products,
            text: text
          %}
        {% endif %}

        {% for product_option in category.product_options.value %}
          {% if product_option.help_text.value != blank %}
            {% liquid
              assign content = product_option.help_text.value
              assign title = content.title
              assign text = content.help_text
              assign related_products = content.related_products.value
            %}
            {% render 'related-products-popup-for-options',
              popup_id: product_option.product_option_title,
              title: title,
              related_products: related_products,
              text: text
            %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
