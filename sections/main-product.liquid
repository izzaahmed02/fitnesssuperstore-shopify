{% style %}
  #shopify-section-{{ section.id }} .product-main-container{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
  }
  #shopify-section-{{ section.id }} .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .product-main-right{
    padding-top: 20px;
    padding-left: 80px;
    background: #FAF9F9;
  }

  #shopify-section-{{ section.id }} .product-main-right .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .mpe {
    margin-top: -20px;
    margin-bottom: 40px;
  }
{% endstyle %}

{% if product.available == true %}
  <meta itemprop="availability" content="InStock">
{% else %}
  <meta itemprop="availability" content="OutOfStock">
{% endif %}

{% comment %} {% render 'custom-breadcrumbs', with product: product %} {% endcomment %}
{% render 'metaobjects-breadcrumbs', with product: product %}

{% comment %}
  {% assign product_breadcrumbs = product.metafields.custom.breadcrumbs.value %}
  {% assign first_breadcrumb = product_breadcrumbs | split: 'Home' %}
  {% assign jp = first_breadcrumb[1] | split: '>' %}
  {% assign length = jp.size | minus: 1 %}

  <div class="custom-breadcrumbs">
    <div class="page-width">
      <div class="custom-breadcrumbs__wrapper">
        <div class="custom-breadcrumbs__navigation">
          {% for i in (0..length) %}
            {% assign col = jp[i] | handleize %}

            {% if forloop.first %}
              <a href="/">Home</a>
            {% else %}
              <a href="{{ collections[col].url }}">{{- jp[i] }}</a>
            {% endif %}
            {% unless forloop.last %}
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M6.31051 3.64645C6.50577 3.45118 6.82235 3.45118 7.01762 3.64645L11.0176 7.64645C11.2129 7.84171 11.2129 8.15829 11.0176 8.35355L7.01762 12.3536C6.82235 12.5488 6.50577 12.5488 6.31051 12.3536C6.11525 12.1583 6.11525 11.8417 6.31051 11.6464L9.95696 8L6.31051 4.35355C6.11525 4.15829 6.11525 3.84171 6.31051 3.64645Z"
                  fill="#DCDFE5" />
              </svg>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endcomment %}

{% comment %}
  <div class="sticky-add-to-cart" style="display: none;">
    <div class="sticky-container">
        <img src="{{ product.featured_image | img_url: 'small' }}" alt="{{ product.title }}" class="sticky-product-image" height="" width="">
        <div class="sticky-product-info">
            <p class="sticky-product-title">{{ product.title }}</p>
        </div>
        <p class="sticky-product-price">{{ product.price | money }}</p>
        <div class="sticky-product-actions">
          <div class="sticky-quantity-container">
              <select name="quantity" class="sticky-quantity">
                  {% for i in (1..10) %}
                  <option value="{{ i }}">{{ i }}</option>
                  {% endfor %}
              </select>
              <div class="sticky-arrow">
                  <svg width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7 5.93934L12.4697 0.46967C12.7626 0.176777 13.2374 0.176777 13.5303 0.46967C13.8232 0.762563 13.8232 1.23744 13.5303 1.53033L7.53033 7.53033C7.23744 7.82322 6.76256 7.82322 6.46967 7.53033L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="black"/>
                  </svg>
              </div>
            </div>
            <button onclick="addToCart()" type="submit" name="add" class="button button--full-width button--primary sticky-add-to-cart-btn" aria-haspopup="dialog">
              <svg class="icon icon-cart" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M1.50007 3.75001H1.49998L1.00009 3.75007C0.585878 3.75012 0.250051 3.41437 0.25 3.00016C0.249949 2.58595 0.585695 2.25012 0.999908 2.25007L1.49991 2.25001L1.5 3.00001L1.50002 2.25001L1.54594 2.25L1.54594 2.25C1.88371 2.24996 2.1157 2.24993 2.33265 2.27521C3.58768 2.42143 4.68471 3.18983 5.25099 4.31935C5.34888 4.5146 5.42813 4.73264 5.54352 5.05009L5.5592 5.09324L5.61623 5.25007H17.0336L17.0773 5.25007C17.9753 5.25005 18.7102 5.25004 19.2878 5.31247C19.8799 5.37648 20.4293 5.51592 20.876 5.88873C21.2574 6.20703 21.5455 6.62269 21.7096 7.09156C21.9018 7.64074 21.8395 8.20414 21.6915 8.78104C21.5471 9.34375 21.2891 10.0319 20.9738 10.8726L20.9738 10.8726L20.9584 10.9136L20.9478 10.942C20.7035 11.5934 20.5046 12.1239 20.3055 12.5475C20.0986 12.9878 19.8706 13.3601 19.5454 13.6787C19.2426 13.9754 18.8917 14.2186 18.5075 14.3979C18.095 14.5905 17.6665 14.6733 17.1815 14.7124C16.7151 14.7501 16.1485 14.7501 15.4529 14.7501H15.4529H15.4529H15.4224H12.2026H12.1594C12.0647 14.7501 11.9717 14.7501 11.8804 14.75H6C5.30964 14.75 4.75 15.3097 4.75 16C4.75 16.6904 5.30964 17.25 6 17.25H9H17H21C21.4142 17.25 21.75 17.5858 21.75 18C21.75 18.4142 21.4142 18.75 21 18.75H19.4501C19.6419 19.125 19.75 19.5499 19.75 20C19.75 21.5188 18.5188 22.75 17 22.75C15.4812 22.75 14.25 21.5188 14.25 20C14.25 19.5499 14.3581 19.125 14.5499 18.75H11.4501C11.6419 19.125 11.75 19.5499 11.75 20C11.75 21.5188 10.5188 22.75 9 22.75C7.48122 22.75 6.25 21.5188 6.25 20C6.25 19.5499 6.35814 19.125 6.54985 18.75H6C4.48122 18.75 3.25 17.5188 3.25 16C3.25 14.4812 4.48122 13.25 6 13.25H7.14691C7.00916 13.0505 6.8859 12.8335 6.76987 12.5996C6.48068 12.0166 6.20831 11.2676 5.87372 10.3474L5.85896 10.3068L4.14951 5.60586C4.01249 5.22905 3.96389 5.09896 3.91007 4.99161C3.5703 4.3139 2.91209 3.85286 2.15907 3.76513C2.03981 3.75124 1.90095 3.75002 1.50009 3.75001H1.50007ZM14.0097 13.2501C14.0064 13.25 14.0032 13.25 14 13.25H11.9452C11.0494 13.2494 10.4099 13.2437 9.90375 13.1869C9.36922 13.1269 9.05809 13.0164 8.81046 12.843C8.56284 12.6695 8.35265 12.4149 8.11362 11.933C7.86618 11.4342 7.62158 10.7648 7.26865 9.79422L6.16168 6.75007H17.0336C17.986 6.75007 18.6393 6.75111 19.1266 6.80378C19.6087 6.8559 19.8051 6.9487 19.9149 7.04037C20.0883 7.18505 20.2192 7.37399 20.2938 7.58711C20.3411 7.72215 20.359 7.93864 20.2385 8.40835C20.1167 8.88312 19.8883 9.49514 19.5539 10.3869C19.2964 11.0736 19.1182 11.5472 18.948 11.9095C18.7826 12.2612 18.6461 12.4598 18.4957 12.6072C18.314 12.7852 18.1034 12.9312 17.8729 13.0388C17.6821 13.1279 17.4482 13.186 17.0608 13.2173C16.6618 13.2495 16.1558 13.2501 15.4224 13.2501H14.0097ZM9 18.75C8.30964 18.75 7.75 19.3097 7.75 20C7.75 20.6904 8.30964 21.25 9 21.25C9.69036 21.25 10.25 20.6904 10.25 20C10.25 19.3097 9.69036 18.75 9 18.75ZM17 18.75C16.3096 18.75 15.75 19.3097 15.75 20C15.75 20.6904 16.3096 21.25 17 21.25C17.6904 21.25 18.25 20.6904 18.25 20C18.25 19.3097 17.6904 18.75 17 18.75Z" fill="#EDEFF3"></path>
              </svg>
              <span>Add to Cart</span>
              <div class="loading__spinner hidden">
                  <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
              </div>
            </button>
        </div>
    </div>
  </div>
{% endcomment %}
<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {{ 'avis-custom.css' | asset_url | stylesheet_tag }}
  {{ 'custom-main-product-page.css' | asset_url | stylesheet_tag }}
  {{ 'custom-product-gallery.css' | asset_url | stylesheet_tag }}
  {{ 'custom-option-picker-snippet.css' | asset_url | stylesheet_tag }}
  {{ 'paylater-modal.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 990px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- assign enable_product_form_js = true -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'tile_calculator' -%}
        {% if block.settings.disable_product_form_js %}
          {%- assign enable_product_form_js = false -%}
        {% endif %}
    {%- endcase -%}
  {%- endfor -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  {% if enable_product_form_js %}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  <script src="{{ 'product-sticky.js' | asset_url }}" defer="defer"></script>

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="page-width">
    {% comment %} pdp-page-width main-container {% endcomment %}
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="product__info-wrapper--mobile">
        <div class="product__info-container--mobile">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'review_widget' -%}
                <div class="available-wrap">
                  <div class="sa-reviews">
                    {% render 'icon-rstar' %}
                    <div class="review_header"></div>
                    <div id="product_just_stars" class="reg"></div>
                  </div>

                  <div class="badge stock-badge {% if product.available == true %}in{% else %}out{% endif %}">
                    {% if product.available == true %}
                      <span>Available to Order</span>
                    {% else %}
                      <span>Out of stock</span>
                    {% endif %}
                  </div>
                </div>
              {% when 'price' %}
                  <div class="campaign-sale-container mobile">
                    {% if product.title contains "French Fitness" %}
                      <p>July 4th Sale: 10% OFF. Use coupon 'JULY4'</p>
                    {% elsif product.title contains "Remanufactured" %}
                      <p>July 4th Sale: 5% OFF. Use coupon 'JULY4'</p>
                    {% endif %}
                  </div>
                <div>
                  {% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price %}
                    <span class="pr_custom_compare_price"
                      >As high as:
                      <s>{{ product.metafields.custom.retail_price | money_with_currency -}}</s>
                    </span>
                  {% endif %}
                  {% if product.metafields.custom.saleprice_name != blank %}
                    {% render 'super-sale',
                      sale_name: product.metafields.custom.saleprice_name,
                      current_price: product.selected_or_first_available_variant.compare_at_price,
                      sale_price: product.metafields.custom.sale_price
                    %}
                  {% else %}
                    <div class="price-container">
                      {%- render 'price',
                        product: product,
                        use_variant: true,
                        show_badges: true,
                        price_class: 'price--large'
                      -%}

                      {% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price
                      %}
                        <span class="you-save"
                          >You save
                          {{
                            product.metafields.custom.retail_price
                            | minus: product.selected_or_first_available_variant.price
                            | money
                          -}}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="product-main-left-container">
        
        {% comment %}
          <div class="product-main-left">

            <div class="thumbnail-slider">
              {% for item in product.images %}
                <div class="item">
                  {{ item | image_url: width: 100 | image_tag }}
                </div>
              {% endfor %}
            </div>

            <div class="main-slider-wrapper">
              <div class="main-slider-arrow--left" type="button">
                <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 0.46967C7.48924 0.762563 7.48924 1.23744 7.19635 1.53033L2.72668 6L7.19635 10.4697C7.48924 10.7626 7.48924 11.2374 7.19635 11.5303C6.90345 11.8232 6.42858 11.8232 6.13569 11.5303L1.13569 6.53033C0.995033 6.38968 0.916016 6.19891 0.916016 6C0.916016 5.80109 0.995033 5.61032 1.13569 5.46967L6.13569 0.46967C6.42858 0.176777 6.90345 0.176777 7.19635 0.46967Z" fill="white"/>
                </svg>
              </div>
              <div class="main-slider">
                {% for item in product.images %}
                  <div class="item">
                    <img
                      src="{{ item | img_url: 'master' }}"
                      alt="{{ product.title }}" />
                  </div>
                {% endfor %}
              </div>
              <div class="main-slider-arrow--right" type="button">
                <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M0.803654 0.46967C1.09655 0.176777 1.57142 0.176777 1.86431 0.46967L6.86431 5.46967C7.15721 5.76256 7.15721 6.23744 6.86431 6.53033L1.86431 11.5303C1.57142 11.8232 1.09655 11.8232 0.803654 11.5303C0.510761 11.2374 0.510761 10.7626 0.803654 10.4697L5.27332 6L0.803654 1.53033C0.510761 1.23744 0.510761 0.762563 0.803654 0.46967Z" fill="white"/>
                </svg>
              </div>
            </div>
          </div>
        {% endcomment %}

        <product-gallery data-product-title="{{ product.title | escape }}">
          <div class="custom-product-gallery">
            <div class="custom-gallery-wrapper">
              <!-- Thumbnails -->
              {%- assign image_media = product.media | where: 'media_type', 'image' -%}

              <div class="custom-gallery-thumbnails only-desktop">
                {%- assign image_limit = 4 -%}
                {%- for media in image_media limit: image_limit -%}
                  {% assign preview = media.preview_image %}
                  {% assign is_last = forloop.last %}
                  {% assign remaining = image_media.size | minus: image_limit %}

                  <button
                    class="thumbnail-btn{% if forloop.first %} is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    type="button"
                  >
                    <div class="image-skeleton-wrapper">
                      <img
                        src="{{ preview | image_url: width: 100 }}"
                        alt="{{ media.alt | escape }}"
                        width="{{ preview.width }}"
                        height="{{ preview.height }}"
                        loading="lazy"
                        onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                      >
                    </div>

                    {%- if is_last and image_media.size > image_limit -%}
                      <div class="thumbnail-overlay">+{{ remaining }}</div>
                    {%- endif -%}
                  </button>
                {%- endfor -%}

                {% assign video_count = 0 %}
                {% for media in product.media %}
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                    {% assign video_count = video_count | plus: 1 %}

                    {% if video_count == 1 %}
                      <button
                        class="thumbnail-btn is-video"
                        data-media-id="{{ media.id }}"
                        data-popup-open="video"
                        type="button"
                      >
                        <div class="thumbnail-btn__warp">
                          <img
                            src="{{ media.preview_image | image_url: width: 100 }}"
                            alt="{{ media.alt | escape }}"
                            width="{{ media.preview_image.width }}"
                            height="{{ media.preview_image.height }}"
                            loading="lazy"
                          >
                        </div>

                        {%- assign shopify_video_count = product.media | where: 'media_type', 'video' | size -%}
                        {%- assign external_video_count = product.media
                          | where: 'media_type', 'external_video'
                          | size
                        -%}
                        {%- assign video_count = shopify_video_count | plus: external_video_count -%}

                        {% if video_count > 1 %}
                          <span class="thumbnail-video-count">{{ video_count }} videos</span>
                        {% endif %}
                      </button>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>

              <!-- Main image -->
              <div class="custom-gallery-main" data-main-media-wrapper>
                {% assign first_media = product.media.first %}
                {% assign preview = first_media.preview_image %}

                <div
                  class="main-image-container"
                  data-media-id="{{ first_media.id }}"
                  data-zoom-container
                >
                  {% if first_media.media_type == 'image' %}
                    <div class="image-skeleton-wrapper">
                      <img
                        src="{{ preview | image_url: width: 800 }}"
                        alt="{{ first_media.alt | escape }}"
                        class="main-product-image"
                        width="{{ preview.width }}"
                        height="{{ preview.height }}"
                        loading="eager"
                        onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                      >
                    </div>
                  {% elsif first_media.media_type == 'video' %}
                    {{ first_media | media_tag }}
                  {% else %}
                    <div class="media-placeholder">Preview available in popup only.</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <script type="application/json" data-product-media>
            [
              {% for media in product.media %}
                {
                  "id": {{ media.id | json }},
                  "media_type": {{ media.media_type | json }},
                  "alt": {{ media.alt | json }},
                  "preview_image": {
                    "src": {{ media.preview_image | image_url: width: 800 | json }},
                    "srcset": "{{ media.preview_image | image_url: width: 800 }} 800w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1600 }} 1600w, {{ media.preview_image | image_url: width: 2048 }} 2048w",
                    "sizes": "(min-width: 990px) 800px, 100vw",
                    "width": {{ media.preview_image.width | json }},
                    "height": {{ media.preview_image.height | json }}
                  }
                  {% if media.media_type == 'video' %}
                    , "sources": [
                      {% for source in media.sources %}
                        {
                          "url": {{ source.url | json }},
                          "mime_type": {{ source.mime_type | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  {% elsif media.media_type == 'external_video' %}
                    , "host": {{ media.host | json }},
                      "external_id": {{ media.external_id | json }}
                  {% endif %}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>
        </product-gallery>

        <mobile-gallery>
          <div class="mobile-gallery-wrapper only-mobile">
            <div class="main-slider-arrow--left" type="button">
              <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 0.46967C7.48924 0.762563 7.48924 1.23744 7.19635 1.53033L2.72668 6L7.19635 10.4697C7.48924 10.7626 7.48924 11.2374 7.19635 11.5303C6.90345 11.8232 6.42858 11.8232 6.13569 11.5303L1.13569 6.53033C0.995033 6.38968 0.916016 6.19891 0.916016 6C0.916016 5.80109 0.995033 5.61032 1.13569 5.46967L6.13569 0.46967C6.42858 0.176777 6.90345 0.176777 7.19635 0.46967Z" fill="white"/>
              </svg>
            </div>

            <div class="mobile-gallery-slider image-skeleton-wrapper">
              {% for media in product.media %}
                {% case media.media_type %}
                  {% when 'image' %}
                    <div class="mobile-gallery-slide-wrap">
                      <div class="image-skeleton-wrapper">
                        <div class="mobile-gallery-slide" data-media-id="{{ media.id }}">
                          {% assign isFirst = forloop.first %}

                          <img
                            src="{{ media.preview_image | image_url: width: 480 }}"
                            srcset="
                              {{ media.preview_image | image_url: width: 320 }} 320w,
                              {{ media.preview_image | image_url: width: 480 }} 480w,
                              {{ media.preview_image | image_url: width: 800 }} 800w
                            "
                            sizes="(max-width: 768px) 100vw, 800px"
                            alt="{{ media.alt | escape }}"
                            {% unless isFirst %}
                              loading="lazy"
                            {% endunless %}
                            width="{{ media.preview_image.width }}"
                            height="{{ media.preview_image.height }}"
                            onload="this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                          >
                        </div>
                      </div>
                    </div>

                  {% when 'video' %}
                    <div class="mobile-gallery-slide-wrap">
                      <div class="mobile-gallery-slide" data-media-id="{{ media.id }}">
                        <video
                          src="{{ media.sources[1].url }}"
                          controls
                          muted
                          playsinline
                          preload="metadata"
                          poster="{{ media.preview_image | image_url: width: 800 }}"
                        ></video>
                      </div>
                    </div>

                  {% when 'external_video' %}
                    <div class="mobile-gallery-slide-wrap">
                      <div class="mobile-gallery-slide external-video" data-media-id="{{ media.id }}">
                        <div class="video-wrapper">
                          <div class="video-iframe-overlay" aria-hidden="true"></div>
                          {{ media | external_video_tag: autoplay: false, muted: true, loop: false }}
                        </div>
                      </div>
                    </div>
                {% endcase %}
              {% endfor %}
            </div>

            <div class="main-slider-arrow--right" type="button">
              <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0.803654 0.46967C1.09655 0.176777 1.57142 0.176777 1.86431 0.46967L6.86431 5.46967C7.15721 5.76256 7.15721 6.23744 6.86431 6.53033L1.86431 11.5303C1.57142 11.8232 1.09655 11.8232 0.803654 11.5303C0.510761 11.2374 0.510761 10.7626 0.803654 10.4697L5.27332 6L0.803654 1.53033C0.510761 1.23744 0.510761 0.762563 0.803654 0.46967Z" fill="white"/>
              </svg>
            </div>

            <div class="mobile-gallery-dots"></div>
          </div>
        </mobile-gallery>

        {% if section.settings.accent_text != blank %}
          <div class="product__accesnt-text hidden lg:flex">
            <div>
              <p class="product__accesnt-text-text">{{ section.settings.accent_text }}</p>
              <p>{{ section.settings.text }}</p>
            </div>

            <a href="{{ section.settings.button_link  | default: '#' }}">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.45958 2.25002L5.52495 2.25005L5.58515 2.25003C5.91729 2.24988 6.17563 2.24977 6.41432 2.29189C7.31374 2.45061 8.07568 3.04551 8.4478 3.87958C8.54655 4.10093 8.6091 4.35157 8.68951 4.67382L8.68951 4.67383L8.68951 4.67384L8.7041 4.73225L9.11772 6.38672L9.12677 6.42291L9.12677 6.42293C9.26686 6.98319 9.38575 7.4587 9.44293 7.86157C9.5038 8.29046 9.50557 8.70021 9.36866 9.12073C9.23175 9.54125 8.9891 9.87142 8.68738 10.1823C8.40398 10.4743 8.02792 10.7886 7.58483 11.1591L7.55622 11.183L5.94399 12.5308C7.2473 14.8902 9.10778 16.7507 11.4672 18.054L12.815 16.4418L12.839 16.4132C13.2094 15.9701 13.5238 15.594 13.8157 15.3106C14.1266 15.0089 14.4568 14.7663 14.8773 14.6294C15.2978 14.4924 15.7075 14.4942 16.1364 14.5551C16.5393 14.6123 17.0148 14.7311 17.575 14.8712L17.5751 14.8712L17.5751 14.8713L17.6113 14.8803L19.2658 15.2939L19.3242 15.3085L19.3242 15.3085C19.6464 15.3889 19.8971 15.4515 20.1184 15.5502C20.9525 15.9223 21.5474 16.6843 21.7061 17.5837C21.7482 17.8224 21.7481 18.0807 21.748 18.4129L21.748 18.4731L21.748 18.5384C21.7482 18.9214 21.7484 19.2237 21.6818 19.5215C21.4397 20.6055 20.4364 21.5157 19.334 21.6514C19.0316 21.6886 18.7718 21.6632 18.4486 21.6315L18.4485 21.6315L18.4485 21.6315L18.4017 21.6269C15.7621 21.3694 13.3864 20.7099 11.3171 19.6702C8.24296 18.1256 5.87243 15.755 4.32781 12.6809C3.28809 10.6116 2.62865 8.23596 2.37111 5.5963L2.36653 5.54952C2.33484 5.22628 2.30937 4.96642 2.3466 4.66401C2.48232 3.56164 3.39252 2.55831 4.4765 2.31618C4.77435 2.24965 5.07657 2.24982 5.45958 2.25002ZM12.8556 18.7319C14.5361 19.452 16.4378 19.9282 18.5474 20.134C18.9338 20.1717 19.0296 20.1776 19.1507 20.1627C19.6235 20.1044 20.1141 19.6594 20.2179 19.1945C20.2438 19.0784 20.248 18.9515 20.248 18.4731C20.248 18.0524 20.2452 17.9363 20.2289 17.8444C20.1568 17.4355 19.8864 17.0892 19.5073 16.9201C19.422 16.882 19.31 16.8511 18.902 16.7491L17.2475 16.3355C16.6413 16.184 16.2419 16.0851 15.9257 16.04