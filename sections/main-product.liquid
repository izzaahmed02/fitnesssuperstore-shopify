{% comment %}
  <script defer>
    document.addEventListener("DOMContentLoaded", function () {
      let scrollTimeout;

      window.addEventListener('scroll', function () {
          if (scrollTimeout) {
              clearTimeout(scrollTimeout);
          }

          scrollTimeout = setTimeout(() => {
              const stickyAddToCart = document.querySelector('.sticky-add-to-cart');
              const headerWrapper = document.querySelector('.header-wrapper');
              const headerBottom = headerWrapper.getBoundingClientRect().bottom;

              if (headerBottom <= 0) {
                  stickyAddToCart.style.display = 'block';
              } else {
                  stickyAddToCart.style.display = 'none';
              }
          }, 50);
      });

      const stickyQuantity = document.querySelector('.sticky-quantity');
      const formQuantityInput = document.querySelector('.quantity__input');

      if (stickyQuantity) {
        stickyQuantity.addEventListener('change', () => {
          if (formQuantityInput) {
              formQuantityInput.value = stickyQuantity.value;
          }
        });
      }

      formQuantityInput.addEventListener('change', () => {
        var formQuantityValue = formQuantityInput.value;

        if (formQuantityInput) {
          stickyQuantity.value = formQuantityInput.value;
        }
      });

      if (!window.product.available) {
        const stickyProductActions = document.querySelector('.sticky-product-actions');

        if (stickyProductActions) {
          stickyProductActions.innerHTML = `<div class="restock-rocket-button-container"><button onclick="_RestockRocket.openModal()" class="sticky-restock-button restock-rocket-button restock-rocket-button-product restock-rocket-button-hover" style="font-family: inherit; font-size: inherit; background-color: rgb(241, 89, 42); color: rgb(255, 255, 255); border-radius: 0px;">Notify me when available</button></div>`
        }
      }
    });

    function addToCart() {
      const addToCartMainButton = document.querySelector('.product-form__submit');

      if (addToCartMainButton) {
        addToCartMainButton.click();
      }
    }
  </script>
{% endcomment %}
