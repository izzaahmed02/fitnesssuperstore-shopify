<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("#shopify-section-{{ section.id }} .faq-raw-content").forEach(function (container) {
      const nodes = Array.from(container.childNodes);
      const accordionItems = [];
      let currentQuestion = null;
      let currentAnswerNodes = [];

      function flushItem() {
        if (!currentQuestion) return;
        const questionText = currentQuestion.textContent.trim();
        if (!questionText) return;

        const itemId = 'faq-item-' + Math.random().toString(36).slice(2, 8);

        const item = document.createElement('div');
        item.className = 'faq-accordion-item';

        const button = document.createElement('button');
        button.type = 'button';
        button.style.cssText = 'display:flex; justify-content:space-between; align-items:center; width:100%; background:none; border:none; padding:12px; cursor:pointer; text-align:left; font-family:Lato,sans-serif; font-size:18px; line-height:24px; font-weight:700; color:#23232B;';
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('aria-controls', itemId);
        button.textContent = questionText;

        button.insertAdjacentHTML('beforeend', `
          <svg style="flex-shrink:0; margin-left:12px; transition:transform 0.3s ease;" width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7 5.93934L12.4697 0.46967C12.7626 0.176777 13.2374 0.176777 13.5303 0.46967C13.8232 0.762563 13.8232 1.23744 13.5303 1.53033L7.53033 7.53033C7.23744 7.82322 6.76256 7.82322 6.46967 7.53033L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="#23232B"/>
          </svg>
        `);

        const contentDiv = document.createElement('div');
        contentDiv.id = itemId;
        contentDiv.style.cssText = 'overflow:hidden; max-height:0; transition:max-height 0.3s ease;';
        contentDiv.setAttribute('aria-hidden', 'true');

        const innerDiv = document.createElement('div');
        innerDiv.style.cssText = 'padding:12px; font-family:Lato,sans-serif; font-size:15px; line-height:1.6; color:#23232B;';

        currentAnswerNodes.forEach(function (node) {
          if (node.nodeName === 'BR') return;
          if (node.nodeType === 3 && !node.textContent.trim()) return;
          innerDiv.appendChild(node.cloneNode(true));
        });

        contentDiv.appendChild(innerDiv);
        item.appendChild(button);
        item.appendChild(contentDiv);

        button.addEventListener('click', function () {
          const isOpen = button.getAttribute('aria-expanded') === 'true';
          const svg = button.querySelector('svg');

          if (isOpen) {
            button.setAttribute('aria-expanded', 'false');
            contentDiv.setAttribute('aria-hidden', 'true');
            contentDiv.style.maxHeight = '0';
            if (svg) svg.style.transform = 'rotate(0deg)';
          } else {
            button.setAttribute('aria-expanded', 'true');
            contentDiv.setAttribute('aria-hidden', 'false');
            contentDiv.style.maxHeight = contentDiv.scrollHeight + 'px';
            if (svg) svg.style.transform = 'rotate(180deg)';
          }
        });

        accordionItems.push(item);
        currentQuestion = null;
        currentAnswerNodes = [];
      }

      nodes.forEach(function (node) {
        if (node.nodeName === 'B' || node.nodeName === 'STRONG') {
          flushItem();
          currentQuestion = node;
        } else if (currentQuestion !== null) {
          currentAnswerNodes.push(node);
        }
      });

      flushItem();

      container.innerHTML = '';
      accordionItems.forEach(function (item) {
        container.appendChild(item);
      });
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("#shopify-section-{{ section.id }} .metainfo-tab-custom-content").forEach(function (container) {
      const nodes = Array.from(container.childNodes);
      const accordionItems = [];
      let currentTitle = null;
      let currentContentNodes = [];

      function flushItem() {
        if (!currentTitle) return;
        const titleText = currentTitle.textContent.trim();
        if (!titleText) return;

        const itemId = 'meta-item-' + Math.random().toString(36).slice(2, 8);

        const item = document.createElement('div');
        item.className = 'meta-accordion-item';
        item.style.borderBottom = '1px solid #EDEFF3';

        const button = document.createElement('button');
        button.type = 'button';
        button.style.cssText = 'display:flex; justify-content:space-between; align-items:center; width:100%; background:none; border:none; padding:12px 0; cursor:pointer; text-align:left; font-family:Lato,sans-serif; font-size:16px; color:#000000;';
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('aria-controls', itemId);
        button.textContent = titleText;

        button.insertAdjacentHTML('beforeend', `
          <svg style="flex-shrink:0; margin-left:12px; transition:transform 0.3s ease;" width="14" height="8" viewBox="0 0 14 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7 5.93934L12.4697 0.46967C12.7626 0.176777 13.2374 0.176777 13.5303 0.46967C13.8232 0.762563 13.8232 1.23744 13.5303 1.53033L7.53033 7.53033C7.23744 7.82322 6.76256 7.82322 6.46967 7.53033L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="#23232B"/>
          </svg>
        `);

        const contentDiv = document.createElement('div');
        contentDiv.id = itemId;
        contentDiv.style.cssText = 'overflow:hidden; max-height:0; transition:max-height 0.3s ease;';
        contentDiv.setAttribute('aria-hidden', 'true');

        const innerDiv = document.createElement('div');
        innerDiv.style.cssText = 'padding:12px 0; font-family:Lato,sans-serif; font-size:15px; line-height:1.6; color:#23232B;';

        currentContentNodes.forEach(function (node) {
          if (node.nodeName === 'BR') return;
          if (node.nodeType === 3 && !node.textContent.trim()) return;
          // skip spacer divs
          if (node.nodeName === 'DIV' && node.style && node.style.minHeight) return;
          innerDiv.appendChild(node.cloneNode(true));
        });

        contentDiv.appendChild(innerDiv);
        item.appendChild(button);
        item.appendChild(contentDiv);
        accordionItems.push(item);

        currentTitle = null;
        currentContentNodes = [];
      }

      nodes.forEach(function (node) {
        if (node.nodeName === 'H5') {
          flushItem();
          currentTitle = node;
        } else if (currentTitle !== null) {
          currentContentNodes.push(node);
        }
      });

      flushItem();

      container.innerHTML = '';
      accordionItems.forEach(function (item) {
        container.appendChild(item);
      });

      function openItem(button, contentDiv) {
        button.setAttribute('aria-expanded', 'true');
        contentDiv.setAttribute('aria-hidden', 'false');
        contentDiv.style.maxHeight = contentDiv.scrollHeight + 'px';
        const svg = button.querySelector('svg');
        if (svg) svg.style.transform = 'rotate(180deg)';
      }

      function closeItem(button, contentDiv) {
        button.setAttribute('aria-expanded', 'false');
        contentDiv.setAttribute('aria-hidden', 'true');
        contentDiv.style.maxHeight = '0';
        const svg = button.querySelector('svg');
        if (svg) svg.style.transform = 'rotate(0deg)';
      }

      const allItems = container.querySelectorAll('.meta-accordion-item');

      allItems.forEach(function (item, index) {
        const button = item.querySelector('button');
        const contentDiv = item.querySelector('div[id^="meta-item-"]');

        if (index === 0) {
  button.setAttribute('aria-expanded', 'true');
  contentDiv.setAttribute('aria-hidden', 'false');
  contentDiv.style.maxHeight = 'none';
  const svg = button.querySelector('svg');
  if (svg) svg.style.transform = 'rotate(180deg)';
}

        button.addEventListener('click', function () {
          const isOpen = button.getAttribute('aria-expanded') === 'true';

          allItems.forEach(function (otherItem) {
            const otherButton = otherItem.querySelector('button');
            const otherContent = otherItem.querySelector('div[id^="meta-item-"]');
            closeItem(otherButton, otherContent);
          });

          if (!isOpen) {
            openItem(button, contentDiv);
          }
        });
      });
    });
  });
</script>