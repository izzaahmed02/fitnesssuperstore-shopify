<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll("#shopify-section-{{ section.id }} .product__extra_info-tabs").forEach(section => {
      const buttons = section.querySelectorAll("[data-extra-tab-button]");
      const panels = section.querySelectorAll("[data-extra-tab-panel]");

      if (!buttons.length || !panels.length) return;

      function activateTab(tabId) {
        buttons.forEach(button => {
          const isActive = button.getAttribute("data-extra-tab-button") === tabId;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        panels.forEach(panel => {
          const isActive = panel.getAttribute("data-extra-tab-panel") === tabId;
          panel.classList.toggle("is-active", isActive);
        });
      }

      buttons.forEach(button => {
        button.addEventListener("click", function() {
          activateTab(this.getAttribute("data-extra-tab-button"));
        });
      });

      activateTab(buttons[0].getAttribute("data-extra-tab-button"));
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const triggers = document.querySelectorAll(".product-video-trigger");
    const modals = document.querySelectorAll(".product-video-modal");

    triggers.forEach(trigger => {
      trigger.addEventListener("click", function(e) {
        e.preventDefault();

        const videoId = this.getAttribute("data-video-id");
        const modal = document.getElementById(videoId);

        if (modal) {
          resetModalVideo(modal);
          modal.style.display = "flex";
          document.body.classList.add("no-scroll");
        }
      });
    });

    modals.forEach(modal => {
      const closeBtn = modal.querySelector(".product-video-close");
      const posterBtn = modal.querySelector(".product-video-modal-poster");

      if (posterBtn) {
        posterBtn.addEventListener("click", function() {
          const video = modal.querySelector("video");

          posterBtn.style.display = "none";

          if (video) {
            video.style.display = "block";
            video.play();
          }
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener("click", function() {
          modal.style.display = "none";
          document.body.classList.remove("no-scroll");
          stopVideo(modal);
        });
      }
    });

    window.addEventListener("click", function(e) {
      modals.forEach(modal => {
        if (e.target === modal) {
          modal.style.display = "none";
          document.body.classList.remove("no-scroll");
          stopVideo(modal);
        }
      });
    });

    function resetModalVideo(modal) {
      const posterBtn = modal.querySelector(".product-video-modal-poster");
      const video = modal.querySelector("video");

      if (posterBtn) {
        posterBtn.style.display = "block";
      }

      if (video) {
        video.pause();
        video.currentTime = 0;
        video.style.display = "none";
      }
    }

    function stopVideo(modal) {
      const iframe = modal.querySelector("iframe");

      resetModalVideo(modal);

      if (iframe) {
        iframe.src = iframe.src;
      }
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".custom-video-wrapper").forEach(wrapper => {
      const poster = wrapper.querySelector(".custom-video-poster");
      const video = wrapper.querySelector(".custom-video");

      if (poster && video) {
        poster.addEventListener("click", () => {
          poster.style.display = "none";
          video.style.display = "block";
          video.play();
        });
      }
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const video = document.querySelector(".custom-product-video");
    const wrapper = document.querySelector(".custom-product-video-wrapper");

    if (!video || !wrapper) return;

    video.addEventListener("click", function (e) {
      e.preventDefault();

      if (video.paused) {
        video.play();
        wrapper.classList.add("playing");
      } else {
        video.pause();
        wrapper.classList.remove("playing");
      }
    });

    video.addEventListener("ended", function () {
      wrapper.classList.remove("playing");
    });
  });
</script>