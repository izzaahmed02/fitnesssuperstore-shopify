                      | replace: '&quot;', '"'
                      | replace: '&#39;', "'"
                      | replace: '&amp;nbsp;', '&nbsp;'
                    }}
                  </div>
                {% elsif block.settings.what_you_can_train != blank %}
                  {% capture train_output %}{{ block.settings.what_you_can_train }}{% endcapture %}
                  <div class="product__extra_train extra-info-width">
                    {{ train_output
                      | replace: '&amp;lt;', '<'
                      | replace: '&amp;gt;', '>'
