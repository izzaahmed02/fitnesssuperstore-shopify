                      | replace: '&gt;', '>'
                      | replace: '&quot;', '"'
                      | replace: '&#39;', "'"
                      | replace: '&amp;nbsp;', '&nbsp;'
                    }}
                  </div>
                {% elsif request.design_mode %}
                  <div class="extra-info-empty-message">
                    Add content to this What You Can Train block, connect a dynamic source, or use the Custom liquid field.
                  </div>
                {% endif %}

              {% when 'buyingguide' %}
                {% if block.settings.buyingguide_liquid != blank %}
                  {% capture buyingguide_output %}{{ block.settings.buyingguide_liquid }}{% endcapture %}
                  <div class="product__extra_tech extra-info-width">
                    {{ buyingguide_output
                      | replace: '&amp;lt;', '<'
                      | replace: '&amp;gt;', '>'
                      | replace: '&lt;', '<'
                      | replace: '&gt;', '>'
                      | replace: '&quot;', '"'
                      | replace: '&#39;', "'"
                      | replace: '&amp;nbsp;', '&nbsp;'
                    }}
                  </div>
                {% elsif block.settings.buyingguide != blank %}
                  {% capture buyingguide_output %}{{ block.settings.buyingguide }}{% endcapture %}
                  <div class="product__extra_tech extra-info-width">
                    {{ buyingguide_output
                      | replace: '&amp;lt;', '<'
                      | replace: '&amp;gt;', '>'
                      | replace: '&lt;', '<'
                      | replace: '&gt;', '>'
                      | replace: '&quot;', '"'
                      | replace: '&#39;', "'"
                      | replace: '&amp;nbsp;', '&nbsp;'
                    }}
                  </div>
                {% elsif request.design_mode %}
                  <div class="extra-info-empty-message">
                    Add content to this Buying Guide block, connect a dynamic source, or use the Custom liquid field.
                  </div>
                {% endif %}

{% when 'faq' %}
  {% if block.settings.faq_liquid != blank %}
    {% capture faq_output %}{{ block.settings.faq_liquid }}{% endcapture %}
    <div class="product__extra_tech extra-info-width" id="faq-raw-{{ block.id }}">
