<script>
  document.addEventListener("DOMContentLoaded", function() {
    const triggers = document.querySelectorAll(".product-video-trigger");
    const modals = document.querySelectorAll(".product-video-modal");

    triggers.forEach(trigger => {
      trigger.addEventListener("click", function(e) {
        e.preventDefault();

        const videoId = this.getAttribute("data-video-id");
        const modal = document.getElementById(videoId);

        if (modal) {
          resetModalVideo(modal);
          modal.style.display = "flex";
          document.body.classList.add("no-scroll");
        }
      });
    });

    modals.forEach(modal => {
      const closeBtn = modal.querySelector(".product-video-close");
      const posterBtn = modal.querySelector(".product-video-modal-poster");

      if (posterBtn) {
        posterBtn.addEventListener("click", function() {
          const video = modal.querySelector("video");

          posterBtn.style.display = "none";

          if (video) {
            video.style.display = "block";
            video.play();
          }
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener("click", function() {
          modal.style.display = "none";
          document.body.classList.remove("no-scroll");
          stopVideo(modal);
        });
      }
    });

    window.addEventListener("click", function(e) {
      modals.forEach(modal => {
        if (e.target === modal) {
          modal.style.display = "none";
          document.body.classList.remove("no-scroll");
          stopVideo(modal);
        }
      });
    });

    function resetModalVideo(modal) {
      const posterBtn = modal.querySelector(".product-video-modal-poster");
      const video = modal.querySelector("video");

      if (posterBtn) {
        posterBtn.style.display = "block";
      }

      if (video) {
        video.pause();
        video.currentTime = 0;
        video.style.display = "none";
      }
    }

    function stopVideo(modal) {
      const iframe = modal.querySelector("iframe");

      resetModalVideo(modal);

      if (iframe) {
        iframe.src = iframe.src;
      }
    }
  });
</script>

