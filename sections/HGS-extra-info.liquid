                  </div>
                {% elsif block.settings.warranty != blank %}
                  {% capture warranty_output %}{{ block.settings.warranty }}{% endcapture %}
                  <div class="product__extra_warranty extra-info-width">
                    <h4>{{ block.settings.title }}</h4>
                    {{ warranty_output
                      | replace: '&amp;lt;', '<'
                      | replace: '&amp;gt;', '>'
                      | replace: '&lt;', '<'
                      | replace: '&gt;', '>'
                      | replace: '&quot;', '"'
                      | replace: '&#39;', "'"
                      | replace: '&amp;nbsp;', '&nbsp;'
                    }}
                  </div>
                {% elsif request.design_mode %}
                  <div class="extra-info-empty-message">
                    Add content to this Warranty block, connect a dynamic source, or use the Custom liquid field.
                  </div>
                {% endif %}

                 {% unless is_gift_cards_template %}
                  {% render 'prop65' %}

                  {% if customer and customer.tags contains 'admin' %}
                    <a id="download-pds" style="cursor:pointer;">Download Product Data Sheet</a>
                  {% endif %}

                  {% render 'product-downloads' %}
                {% endunless %}

            {% endcase %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% unless has_visible_tabs %}
      {% if request.design_mode %}
        <div class="extra-info-empty-message">
          Add blocks to create tabs. Each tab uses the block Tab title as the label.
        </div>
      {% endif %}
    {% endunless %}

  </div>
</div>

