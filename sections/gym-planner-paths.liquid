<section class="gym-planner-paths gym-planner-paths--{{ section.id }}">
  <div class="page-width">
    <div class="gym-planner-paths__card">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="rte">{{ section.settings.intro }}</div>
      {% endif %}
      <div class="gym-planner-paths__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_url != blank %}
          <a class="button" href="{{ section.settings.primary_url }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_url != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
      </div>
      {% if section.settings.disclaimer != blank %}
        <div class="gym-planner-paths__disclaimer rte">{{ section.settings.disclaimer }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .gym-planner-paths--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .gym-planner-paths--{{ section.id }} .gym-planner-paths__card {
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 8px;
    padding: clamp(24px, 4vw, 48px);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .gym-planner-paths--{{ section.id }} h2 {
    margin-top: 0;
  }

  .gym-planner-paths--{{ section.id }} .gym-planner-paths__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }

  .gym-planner-paths--{{ section.id }} .gym-planner-paths__disclaimer {
    font-size: 0.9em;
  }
{% endstyle %}

{% schema %}
{
  "name": "Gym planner paths",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plan your gym"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Choose the path that matches your goal.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Request a gym package quote"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Build a conceptual layout (Beta)"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Planner disclaimer",
      "default": "<p>The planner is a conceptual visualization tool and is not a quote or verified final layout.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Gym planner paths"
    }
  ]
}
{% endschema %}

