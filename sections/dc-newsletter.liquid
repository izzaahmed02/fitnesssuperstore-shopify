<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #FAF9F9;
  }
  .dc-newsletter-wrap{
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }
  .dc-newsletter-title{
    margin: 0;
    font-family: 'Oswald';
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 142%;
    text-transform: uppercase;
    color: #23232B;
  }
  .dc-newsletter-button{
    padding: 12px 24px;
    background: #F1592A;
    border-radius: 0px 8px 8px 0px;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    border:none;
    appearance: none;
    cursor:pointer;
    white-space: nowrap;
  }
  .dc-newsletter-wrap-right{
    display: flex;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: flex-end;
  }
  .newsletter-form-wrapper{
    max-width: 522px;
    width: 100%;
  }
  .dc-form-note{
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    color: #393940;
  }
  .dc-form-field{
    display:flex;
  }
  .dc-form__input{
    border:none;
    appearance: none;
    outline:none;
    padding: 12px;
    background: #FFFFFF;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px 0px 0px 8px;
    width: 100%;
  }

  @media(max-width: 999px){
    #shopify-section-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * 0.5);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.5);
    }
    .dc-newsletter-title{
      font-size: 24px;
      text-align:center;
    }
    .dc-newsletter-wrap{
      gap: 15px;
      grid-template-columns: 1fr;
    }
    .dc-form-note{
      justify-content: center;
    }
  }
</style>

<div class="page-width-dc">
  <div class="dc-newsletter-wrap">
    <div class="dc-newsletter-wrap-left">
      <h2 class="dc-newsletter-title">
        {{ section.settings.title }}
      </h2>
    </div>

    <div class="dc-newsletter-wrap-right">
      <div class="newsletter-form-wrapper">
        {% form 'customer', class: 'newsletter-custom-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__wrapper">
            <div class="dc-form-field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="dc-form__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="Enter your email"
                required
              >
              <button
                type="submit"
                class="newsletter-form__button dc-newsletter-button"
                name="commit"
                id="Subscribe"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                Sign up
              </button>
            </div>
            {%- if form.errors -%}
              <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
          </div>
          {%- if form.posted_successfully? -%}
            <h3
              class="newsletter-form__message newsletter-form__message--success form__message"
              id="Newsletter-success--{{ section.id }}"
              tabindex="-1"
              autofocus
            >
              {% render 'icon-success' -%}
              {{- 'newsletter.success' | t }}
            </h3>
          {%- endif -%}
        {% endform %}
        <div class="dc-form-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="0.5" y="0.5" width="17" height="17" rx="8.5" fill="#F1592A"/>
            <rect x="0.5" y="0.5" width="17" height="17" rx="8.5" stroke="#F1592A"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M13.9629 5.1775C14.1411 5.34077 14.1531 5.61752 13.9898 5.79563L7.57316 12.7956C7.49252 12.8836 7.37946 12.9348 7.26016 12.9374C7.14085 12.94 7.02567 12.8937 6.94129 12.8094L4.02463 9.8927C3.85377 9.72184 3.85377 9.44483 4.02463 9.27398C4.19548 9.10312 4.47249 9.10312 4.64334 9.27398L7.23691 11.8675L13.3448 5.20437C13.5081 5.02626 13.7848 5.01423 13.9629 5.1775Z" fill="white"/>
          </svg>
  
          {{ section.settings.note }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "dc Newsletter",
  "class": "dc-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "dc Newsletter"
    }
  ]
}
{% endschema %}
