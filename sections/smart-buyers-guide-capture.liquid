{% comment %}
  Smart Buyer's Guide capture section.

  Submits via Shopify's native `customer` form so the profile syncs to Klaviyo
  through the existing Shopify integration. The `source` schema setting is
  written into `contact[tags]` (comma-separated) so Josh can key the
  guide-delivery flow off a Klaviyo profile property / list. A client-side
  Klaviyo `Signed Up For Smart Buyers Guide` event is also pushed with the
  source when the form submits successfully, giving Josh two ways to trigger.

  Approved source values:
    - smart_buyers_guide_footer
    - smart_buyers_guide_comparison_charts
    - smart_buyers_guide_blog
{% endcomment %}

{%- liquid
  assign source = section.settings.source | default: 'smart_buyers_guide_footer'
  assign heading = section.settings.heading | default: 'GET THE SMART BUYER’S GUIDE — FREE'
  assign body = section.settings.body | default: 'Join our email list to receive the free 34-page guide, product news, and exclusive offers.'
  assign button_label = section.settings.button_label | default: 'Get the Guide'
  assign note = section.settings.note | default: 'Instant access. No cost. Unsubscribe anytime.'
  assign background = section.settings.background | default: '#FAF9F9'
-%}

<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ background }};
  }
  #shopify-section-{{ section.id }} .sbg-capture-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .sbg-capture-title {
    margin: 0;
    font-family: 'Oswald';
    font-style: normal;
    font-weight: 600;
    font-size: 40px;
    line-height: 120%;
    text-transform: uppercase;
    color: #23232B;
  }
  #shopify-section-{{ section.id }} .sbg-capture-body {
    margin: 12px 0 0;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    color: #393940;
  }
  #shopify-section-{{ section.id }} .sbg-capture-right {
    display: flex;
    width: 100%;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .sbg-capture-form-wrapper {
    max-width: 522px;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .sbg-capture-field {
    display: flex;
  }
  #shopify-section-{{ section.id }} .sbg-capture-input {
    border: none;
    appearance: none;
    outline: none;
    padding: 12px;
    background: #FFFFFF;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px 0 0 8px;
    width: 100%;
    font-family: 'Lato';
    font-size: 16px;
  }
  #shopify-section-{{ section.id }} .sbg-capture-button {
    padding: 12px 24px;
    background: #D83D0E;
    border-radius: 0 8px 8px 0;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
    border: none;
    appearance: none;
    cursor: pointer;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .sbg-capture-note {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-size: 15px;
    line-height: 150%;
    color: #393940;
  }
  #shopify-section-{{ section.id }} .sbg-capture-message {
    margin-top: 12px;
    font-family: 'Lato';
    font-size: 15px;
    line-height: 150%;
  }
  #shopify-section-{{ section.id }} .sbg-capture-message--success {
    color: #0B7A3B;
  }
  #shopify-section-{{ section.id }} .sbg-capture-message--error {
    color: #B00020;
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * 0.5);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.5);
    }
    #shopify-section-{{ section.id }} .sbg-capture-wrap {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .sbg-capture-title {
      font-size: 26px;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .sbg-capture-body {
      text-align: center;
    }
    #shopify-section-{{ section.id }} .sbg-capture-note {
      justify-content: center;
      text-align: center;
    }
  }
</style>

<div class="page-width-dc">
  <div class="sbg-capture-wrap" data-sbg-source="{{ source }}">
    <div class="sbg-capture-left">
      <h2 class="sbg-capture-title">{{ heading }}</h2>
      {%- if body != blank -%}
        <p class="sbg-capture-body">{{ body }}</p>
      {%- endif -%}
    </div>

    <div class="sbg-capture-right">
      <div class="sbg-capture-form-wrapper">
        {%- form 'customer', class: 'sbg-capture-form', id: 'SbgCaptureForm--' | append: section.id -%}
          <input type="hidden" name="contact[tags]" value="newsletter,smart_buyers_guide,{{ source }}">
          <input type="hidden" name="contact[note]" value="Smart Buyer's Guide capture — source: {{ source }}">
          <input type="hidden" name="sbg_source" value="{{ source }}">
          <div class="sbg-capture-field">
            <label class="visually-hidden" for="SbgCaptureEmail--{{ section.id }}">Email</label>
            <input
              id="SbgCaptureEmail--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="sbg-capture-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Enter your email"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="SbgCaptureError--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="SbgCaptureSuccess--{{ section.id }}"
              {% endif %}
            >
            <button
              type="submit"
              class="sbg-capture-button"
              name="commit"
              aria-label="{{ button_label }}"
            >
              {{ button_label }}
            </button>
          </div>
          {%- if form.errors -%}
            <div class="sbg-capture-message sbg-capture-message--error" id="SbgCaptureError--{{ section.id }}">
              {%- render 'icon-error' -%}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <div
              class="sbg-capture-message sbg-capture-message--success"
              id="SbgCaptureSuccess--{{ section.id }}"
              tabindex="-1"
              data-sbg-success
              data-sbg-source="{{ source }}"
              data-sbg-email="{{ form.email }}"
            >
              {%- render 'icon-success' -%}
              Thanks — check your inbox for the Smart Buyer’s Guide.
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if note != blank -%}
          <div class="sbg-capture-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="0.5" y="0.5" width="17" height="17" rx="8.5" fill="#D83D0E"/>
              <rect x="0.5" y="0.5" width="17" height="17" rx="8.5" stroke="#D83D0E"/>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M13.9629 5.1775C14.1411 5.34077 14.1531 5.61752 13.9898 5.79563L7.57316 12.7956C7.49252 12.8836 7.37946 12.9348 7.26016 12.9374C7.14085 12.94 7.02567 12.8937 6.94129 12.8094L4.02463 9.8927C3.85377 9.72184 3.85377 9.44483 4.02463 9.27398C4.19548 9.10312 4.47249 9.10312 4.64334 9.27398L7.23691 11.8675L13.3448 5.20437C13.5081 5.02626 13.7848 5.01423 13.9629 5.1775Z" fill="white"/>
            </svg>
            <span>{{ note }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var source = '{{ source }}';

    var form = section.querySelector('form.sbg-capture-form');
    if (form) {
      form.addEventListener('submit', function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'smart_buyers_guide_form_submit',
          sbg_source: source
        });
      });
    }

    var success = section.querySelector('[data-sbg-success]');
    if (success) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'smart_buyers_guide_signup',
        sbg_source: source
      });

      if (window._learnq) {
        var email = success.getAttribute('data-sbg-email');
        if (email) {
          window._learnq.push(['identify', { $email: email, smart_buyers_guide_source: source }]);
        }
        window._learnq.push(['track', 'Signed Up For Smart Buyers Guide', { source: source }]);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Smart Buyer's Guide Capture",
  "class": "smart-buyers-guide-capture",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "info": "Tags the submission so Klaviyo can route it to the correct flow.",
      "default": "smart_buyers_guide_footer",
      "options": [
        { "value": "smart_buyers_guide_footer", "label": "Footer / Global newsletter" },
        { "value": "smart_buyers_guide_comparison_charts", "label": "Comparison Charts page" },
        { "value": "smart_buyers_guide_blog", "label": "Blog page" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET THE SMART BUYER’S GUIDE — FREE"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "Join our email list to receive the free 34-page guide, product news, and exclusive offers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get the Guide"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "Instant access. No cost. Unsubscribe anytime."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#FAF9F9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Smart Buyer's Guide Capture"
    }
  ]
}
{% endschema %}
