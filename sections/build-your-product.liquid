{{ 'build-your-product.css' | asset_url | stylesheet_tag }}
{{ 'product-options.css' | asset_url | stylesheet_tag }}
{{ 'byp-options-skin.css' | asset_url | stylesheet_tag }}
<script src="{{ 'build-your-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-custom-options.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  ============================================================================
  DATA SOURCE — the only place that decides WHERE the section's data comes
  from. Reads from theme-editor block settings today; to move to metafields
  later, replace only the assigns here with metafield/metaobject reads that
  produce the same shapes. The rendered markup below (classes + data-*
  attributes + per-accordion JSON) is the contract the CSS/JS depend on.

  COLOR: rendered by the live options engine (product-options.liquid) as a card
  inside the first accordion ("Best Selling Add-Ons"). The engine element wires
  the swatches and exposes prepareOptions()/prepareFunctionalProperties(); the
  floating cart will call those at "Add to cart" so colour attaches to the FSR90
  line via _functionOperation. byp-options-skin.css styles the swatches and hides
  the non-colour engine categories inside the colour card.
  ============================================================================
{%- endcomment -%}
{%- liquid
  assign main_product = product
  assign main_variant = main_product.selected_or_first_available_variant
  assign install_product = section.settings.installation_product
-%}

<build-your-product
  class="byp page-width"
  data-section-id="{{ section.id }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-main-variant-id="{{ main_variant.id }}"
>
  <h2 class="byp__heading">{{ section.settings.heading | escape }}</h2>

  <div class="byp__layout">
    {%- comment -%} ================= LEFT: ACCORDIONS ================= {%- endcomment -%}
    <div class="byp__accordions">
      {%- for block in section.blocks -%}
        {%- liquid
          assign accordion_main = block.settings.main_product
          if accordion_main == blank
            assign accordion_main = block.settings.products.first
          endif
        -%}
        <details class="byp-accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="byp-accordion__summary">
            <span class="byp-accordion__title">
              {{ block.settings.title | escape }}
              <button
                type="button"
                class="byp-tooltip byp-accordion__master-learn-more"
                {% if accordion_main != blank %}data-master-product-id="{{ accordion_main.id }}"{% endif %}
                {% if block.settings.tooltip != blank %}title="{{ block.settings.tooltip | escape }}" aria-label="{{ block.settings.tooltip | escape }}"{% else %}aria-label="Learn more about {{ block.settings.title | escape }}"{% endif %}
              >?</button>
            </span>
            <span class="byp-accordion__chevron" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>

          <div class="byp-accordion__content">
            {%- comment -%} Per-accordion product data ("same family") for the popup slider {%- endcomment -%}
            <script type="application/json" class="byp-accordion__family-json">
              [
                {%- for fam in block.settings.products -%}
                  {%- assign fam_variant = fam.selected_or_first_available_variant -%}
                  {
                    "id": {{ fam.id }},
                    "title": {{ fam.title | json }},
                    "url": {{ fam.url | json }},
                    "sku": {{ fam_variant.sku | json }},
                    "image": {{ fam.featured_media | image_url: width: 200 | json }},
                    "price": {{ fam_variant.price }},
                    "compare_at_price": {{ fam_variant.compare_at_price | default: 0 }},
                    "rating": {{ fam.metafields.reviews.rating.value.rating | default: 0 | json }},
                    "rating_count": {{ fam.metafields.reviews.rating_count.value | default: 0 | json }},
                    "description": {{ fam.description | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            </script>

            <div class="byp-slider">
              <button type="button" class="byp-slider__arrow byp-slider__arrow--prev" aria-label="Previous products" hidden>&#10094;</button>
              <ul class="byp-grid byp-slider__track" role="list">
              {%- if forloop.first -%}
                {%- comment -%} COLOUR — engine swatches presented as a product card (first card in "Best Selling Add-Ons"). {%- endcomment -%}
                <li class="byp-card byp-card--color"
                    data-product-id="{{ main_product.id }}"
                    data-product-handle="{{ main_product.handle }}"
                    data-product-title="{{ main_product.title | escape }}">

                  <template class="byp-card__description-full">{{ main_product.description }}</template>

                  <p class="pr_custom_price"
                     data-price-value="{{ main_variant.price | money_without_currency }}"
                     data-currency="{{ cart.currency.symbol }}"
                     style="position:absolute;left:-9999px;">{{ main_variant.price | money }}</p>

                  <div class="byp-card__media">
                    {%- if main_product.featured_media -%}
                      <img
                        srcset="{{ main_product.featured_media | image_url: width: 360 }} 360w, {{ main_product.featured_media | image_url: width: 540 }} 540w"
                        src="{{ main_product.featured_media | image_url: width: 540 }}"
                        sizes="(min-width: 990px) 280px, 45vw"
                        alt="{{ main_product.featured_media.alt | escape }}"
                        loading="lazy"
                        width="{{ main_product.featured_media.width }}"
                        height="{{ main_product.featured_media.height }}">
                    {%- endif -%}
                  </div>

                  {%- if main_variant.sku != blank -%}
                    <p class="byp-card__sku">SKU: {{ main_variant.sku }}</p>
                  {%- endif -%}

                  <h3 class="byp-card__title">{{ main_product.title }}</h3>

                  <div class="byp-options-engine byp-options-engine--color-only">
                    {% render 'product-options', product: main_product %}
                  </div>

                  <div class="byp-card__row byp-card__row--price">
                    <button type="button" class="byp-card__learn-more link">Learn more</button>
                  </div>

                  <div class="byp-card__row byp-card__row--actions">
                    <select class="byp-card__qty" aria-label="{{ 'products.product.quantity.label' | t }}">
                      {%- for i in (1..10) -%}
                        <option value="{{ i }}">{{ i }}</option>
                      {%- endfor -%}
                    </select>
                    <button type="button" class="byp-card__color-cta button">Select Color</button>
                  </div>
                </li>
              {%- endif -%}
              {%- for addon in block.settings.products -%}
                {%- liquid
                  assign addon_variant = addon.selected_or_first_available_variant
                  assign rating = addon.metafields.reviews.rating.value
                  assign rating_count = addon.metafields.reviews.rating_count.value
                -%}
                <li class="byp-card"
                    data-product-id="{{ addon.id }}"
                    data-product-handle="{{ addon.handle }}"
                    data-product-title="{{ addon.title | escape }}">

                  <script type="application/json" class="byp-card__variants-json">
                    [
                      {%- for v in addon.variants -%}
                        {
                          "id": {{ v.id }},
                          "title": {{ v.title | json }},
                          "available": {{ v.available }},
                          "price": {{ v.price }},
                          "compare_at_price": {{ v.compare_at_price | default: 0 }},
                          "option1": {{ v.option1 | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>

                  <template class="byp-card__description-full">{{ addon.description }}</template>

                  <div class="byp-card__media">
                    {%- if addon.featured_media -%}
                      <img
                        srcset="{{ addon.featured_media | image_url: width: 360 }} 360w, {{ addon.featured_media | image_url: width: 540 }} 540w"
                        src="{{ addon.featured_media | image_url: width: 540 }}"
                        sizes="(min-width: 990px) 280px, 45vw"
                        alt="{{ addon.featured_media.alt | escape }}"
                        loading="lazy"
                        width="{{ addon.featured_media.width }}"
                        height="{{ addon.featured_media.height }}">
                    {%- endif -%}
                  </div>

                  {%- if addon_variant.sku != blank -%}
                    <p class="byp-card__sku">SKU: {{ addon_variant.sku }}</p>
                  {%- endif -%}

                  <h3 class="byp-card__title">{{ addon.title }}</h3>

                  {%- if rating -%}
                    <div class="byp-card__rating" data-rating="{{ rating.rating | default: rating }}">
                      <span class="byp-star" aria-hidden="true">&#9733;</span>
                      <span class="byp-card__rating-count">{{ rating_count | default: 0 }} reviews</span>
                    </div>
                  {%- endif -%}

                  <p class="byp-card__excerpt">{{ addon.description | strip_html | truncatewords: 24 }}</p>

                  {%- unless addon.has_only_default_variant -%}
                    {%- if addon.options.size == 1 and addon.options.first == 'Color' -%}
                      <fieldset class="byp-card__swatches">
                        <legend class="byp-card__option-label">Color: <span data-selected-option>{{ addon_variant.option1 }}</span></legend>
                        {%- for v in addon.variants -%}
                          <label class="byp-swatch" style="--swatch-color: {{ v.option1 | downcase | replace: ' ', '' }};">
                            <input type="radio" name="byp-color-{{ section.id }}-{{ addon.id }}"
                                   value="{{ v.id }}" {% if v == addon_variant %}checked{% endif %}>
                            <span class="visually-hidden">{{ v.option1 }}</span>
                          </label>
                        {%- endfor -%}
                      </fieldset>
                    {%- else -%}
                      <select class="byp-card__variant-select" aria-label="{{ 'products.product.product_variants' | t }}">
                        {%- for v in addon.variants -%}
                          <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %} {% if v == addon_variant %}selected{% endif %}>{{ v.title }}</option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                  {%- endunless -%}

                  <div class="byp-card__row byp-card__row--price">
                    <button type="button" class="byp-card__learn-more link">Learn more</button>
                    <div class="byp-card__price">
                      <span class="byp-card__compare{% unless addon_variant.compare_at_price > addon_variant.price %} hidden{% endunless %}">
                        As high as: <s data-compare-price>{{ addon_variant.compare_at_price | money }}</s>
                      </span>
                      <span class="byp-card__price-current" data-price>{{ addon_variant.price | money }} {{ cart.currency.iso_code }}</span>
                    </div>
                  </div>

                  <div class="byp-card__row byp-card__row--actions">
                    <select class="byp-card__qty" aria-label="{{ 'products.product.quantity.label' | t }}">
                      {%- for i in (1..10) -%}
                        <option value="{{ i }}">{{ i }}</option>
                      {%- endfor -%}
                    </select>
                    <button type="button" class="byp-card__atc button"
                            {% unless addon_variant.available %}disabled{% endunless %}
                            data-variant-id="{{ addon_variant.id }}">Add To Order</button>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
              <button type="button" class="byp-slider__arrow byp-slider__arrow--next" aria-label="Next products">&#10095;</button>
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>

    {%- comment -%} ================= RIGHT: FLOATING CART ================= {%- endcomment -%}
    <aside class="byp-floating-cart" aria-live="polite" aria-label="Your build">
      <div class="byp-floating-cart__inner">
        <div class="byp-floating-cart__bar">
          <h2 class="byp-floating-cart__build-title">Build Your Product</h2>
          <button type="button" class="byp-floating-cart__toggle" aria-expanded="true" aria-label="Minimize cart">
            <span class="byp-floating-cart__toggle-icon" aria-hidden="true">&#9650;</span>
          </button>
        </div>

        <div class="byp-floating-cart__body">
          <h3 class="byp-floating-cart__heading">You are buying</h3>

          <div class="byp-floating-cart__main">
            <div class="byp-floating-cart__main-media">
              {%- if main_product.featured_media -%}
                <img src="{{ main_product.featured_media | image_url: width: 140 }}" alt="" width="70" height="70" loading="lazy">
              {%- endif -%}
            </div>
            <p class="byp-floating-cart__main-title">{{ main_product.title }}</p>
            <div class="byp-floating-cart__main-price">
              <span data-main-price>{{ main_variant.price | money }}</span>
              {%- if main_variant.compare_at_price > main_variant.price -%}
                <s data-main-compare>{{ main_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
          </div>

          <h4 class="byp-floating-cart__subheading">Add Ons</h4>
          <ul class="byp-floating-cart__items" role="list"></ul>

          {%- if install_product != blank -%}
            <div class="byp-floating-cart__install">
              <label for="byp-install-{{ section.id }}">{{ section.settings.installation_label | escape }}</label>
              <select id="byp-install-{{ section.id }}" class="byp-floating-cart__install-select">
                <option value="">{{ section.settings.installation_default | escape }}</option>
                {%- for v in install_product.variants -%}
                  <option value="{{ v.id }}" data-price="{{ v.price }}">{{ v.title }} (+{{ v.price | money }})</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          <div class="byp-floating-cart__subtotal">
            <span>Subtotal</span>
            <span class="byp-floating-cart__subtotal-values">
              <s data-subtotal-compare class="hidden"></s>
              <strong data-subtotal></strong>
            </span>
          </div>

          <button type="button" class="byp-floating-cart__atc button button--primary">Add to cart</button>
          <p class="byp-floating-cart__error" role="alert" hidden></p>

          <ul class="byp-floating-cart__warranty list-unstyled">
            <li class="byp-floating-cart__warranty-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M17.666 19.5488V5.54883C17.666 5.0184 17.4729 4.50969 17.129 4.13461C16.7852 3.75954 16.3189 3.54883 15.8327 3.54883H8.49935C8.01312 3.54883 7.5468 3.75954 7.20299 4.13461C6.85917 4.50969 6.66602 5.0184 6.66602 5.54883V19.5488" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2 20H22" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2 10H22" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="20.416" y1="7.29883" x2="20.416" y2="11.7988" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="3.41602" y1="7.29883" x2="3.41602" y2="11.7988" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="byp-floating-cart__warranty-text">Lifetime Frame Warranty</span>
            </li>
            <li class="byp-floating-cart__warranty-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8.30065 10.0008C8.17174 10.0078 8.04339 9.97907 7.9298 9.91771C7.81622 9.85635 7.72181 9.76477 7.65702 9.6531C7.59224 9.54143 7.55959 9.41402 7.5627 9.28496C7.56581 9.15589 7.60456 9.0302 7.67465 8.92178L11.4006 3.00078C11.4592 2.89535 11.544 2.80683 11.6468 2.74381C11.7496 2.68079 11.867 2.6454 11.9875 2.64108C12.108 2.63675 12.2276 2.66363 12.3347 2.71912C12.4418 2.77461 12.5327 2.85682 12.5986 2.95778L16.3006 8.90078C16.3736 9.00557 16.4165 9.12833 16.4247 9.25576C16.433 9.38319 16.4062 9.51044 16.3472 9.62373C16.2883 9.73703 16.1996 9.83205 16.0905 9.89851C15.9815 9.96497 15.8563 10.0003 15.7286 10.0008H8.30065Z" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 14H4C3.44772 14 3 14.4477 3 15V20C3 20.5523 3.44772 21 4 21H9C9.55228 21 10 20.5523 10 20V15C10 14.4477 9.55228 14 9 14Z" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M17.5 21C19.433 21 21 19.433 21 17.5C21 15.567 19.433 14 17.5 14C15.567 14 14 15.567 14 17.5C14 19.433 15.567 21 17.5 21Z" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="byp-floating-cart__warranty-text">10 Year Parts Warranty</span>
            </li>
            <li class="byp-floating-cart__warranty-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 10V22" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15 5.88L14 10H19.83C20.1405 10 20.4467 10.0723 20.7244 10.2111C21.0021 10.35 21.2437 10.5516 21.43 10.8C21.6163 11.0484 21.7422 11.3367 21.7977 11.6422C21.8533 11.9477 21.8369 12.2619 21.75 12.56L19.42 20.56C19.2988 20.9754 19.0462 21.3404 18.7 21.6C18.3538 21.8596 17.9327 22 17.5 22H4C3.46957 22 2.96086 21.7893 2.58579 21.4142C2.21071 21.0391 2 20.5304 2 20V12C2 11.4696 2.21071 10.9609 2.58579 10.5858C2.96086 10.2107 3.46957 10 4 10H6.76C7.13208 9.9998 7.49674 9.89581 7.81296 9.69972C8.12917 9.50363 8.38442 9.22321 8.55 8.89L12 2C12.4716 2.00584 12.9357 2.11817 13.3578 2.3286C13.7799 2.53902 14.1489 2.84211 14.4374 3.2152C14.7259 3.5883 14.9263 4.02176 15.0237 4.4832C15.1212 4.94464 15.113 5.42213 15 5.88Z" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="byp-floating-cart__warranty-text">1 Year On-Site Labor</span>
            </li>
          </ul>
        </div>
      </div>
    </aside>
  </div>

  {%- comment -%} ================= LEARN MORE / MASTER POPUP ================= {%- endcomment -%}
  <div class="byp-modal hidden" role="dialog" aria-modal="true" aria-labelledby="byp-modal-title-{{ section.id }}">
    <div class="byp-modal__overlay" data-modal-close></div>
    <div class="byp-modal__panel">
      <button type="button" class="byp-modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>

      <div class="byp-modal__main">
        <div class="byp-modal__main-media">
          <img class="byp-modal__main-img" src="" alt="" hidden>
        </div>
        <div class="byp-modal__main-info">
          <div class="byp-modal__rating hidden">
            <span class="byp-modal__stars" aria-hidden="true"></span>
            <span class="byp-modal__rating-count"></span>
          </div>
          <h3 class="byp-modal__title" id="byp-modal-title-{{ section.id }}"></h3>
          <div class="byp-modal__description rte"></div>
        </div>
      </div>

      <div class="byp-modal__related">
        <h4>More from this collection</h4>
        <ul class="byp-modal__related-track" role="list"></ul>
      </div>
    </div>
  </div>
</build-your-product>

{% schema %}
{
  "name": "Build Your Product",
  "tag": "section",
  "class": "section-build-your-product",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Product" },
    { "type": "header", "content": "Installation options" },
    {
      "type": "product",
      "id": "installation_product",
      "label": "Installation / assembly product",
      "info": "Each variant of this product becomes an option in the floating cart dropdown."
    },
    { "type": "text", "id": "installation_label", "label": "Dropdown label", "default": "Assembly & Room of Choice Installation Needed?" },
    { "type": "text", "id": "installation_default", "label": "Default option (no charge)", "default": "Curbside Delivery Only" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Best Selling Add-Ons" },
        { "type": "text", "id": "tooltip", "label": "Tooltip text (orange ? icon)" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
        { "type": "product", "id": "main_product", "label": "Main product (category Learn More)", "info": "Featured at the top of the popup when the orange ? icon is clicked. Defaults to the first product above if left empty." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Build Your Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Best Selling Add-Ons", "open_by_default": true } },
        { "type": "accordion", "settings": { "title": "Mat" } },
        { "type": "accordion", "settings": { "title": "Bench" } },
        { "type": "accordion", "settings": { "title": "Olympic Weight Plate Set" } },
        { "type": "accordion", "settings": { "title": "Bars & Pull Attachments" } },
        { "type": "accordion", "settings": { "title": "Handles, Ropes & Lower Body Attachments" } }
      ]
    }
  ]
}
{% endschema %}
