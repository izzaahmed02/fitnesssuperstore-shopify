<div class="gym-designer-section">
    <div class="page-width">
      <div class="gym-designer-container">
        <div class="gym-designer-content">
          <h1 class="gym-designer-title">{{ section.settings.title | escape }}</h1>
          <p class="gym-designer-description">{{ section.settings.description | escape }}</p>
          <a href="https://fitnesssuperstore.roomplanner.com/" class="button gym-designer-button">
            {{ section.settings.button_text | escape }}
          </a>
        </div>
        
        <div class="gym-designer-gallery">
          <div class="gym-designer-slider">
            {% if section.settings.image_1 != blank %}
              <div class="gym-designer-slide active">
                {{ section.settings.image_1 | image_url: width: 1500 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '550, 720, 990, 1100, 1500',
                  class: 'gym-designer-image',
                  alt: section.settings.image_1.alt | escape
                }}
              </div>
            {% endif %}
            
            {% if section.settings.image_2 != blank %}
              <div class="gym-designer-slide">
                {{ section.settings.image_2 | image_url: width: 1500 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '550, 720, 990, 1100, 1500',
                  class: 'gym-designer-image',
                  alt: section.settings.image_2.alt | escape
                }}
              </div>
            {% endif %}
            
            {% if section.settings.image_3 != blank %}
              <div class="gym-designer-slide">
                {{ section.settings.image_3 | image_url: width: 1500 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '550, 720, 990, 1100, 1500',
                  class: 'gym-designer-image',
                  alt: section.settings.image_3.alt | escape
                }}
              </div>
            {% endif %}
            
            {% if section.settings.image_4 != blank %}
              <div class="gym-designer-slide">
                {{ section.settings.image_4 | image_url: width: 1500 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '550, 720, 990, 1100, 1500',
                  class: 'gym-designer-image',
                  alt: section.settings.image_4.alt | escape
                }}
              </div>
            {% endif %}
            
            {% if section.settings.image_5 != blank %}
              <div class="gym-designer-slide">
                {{ section.settings.image_5 | image_url: width: 1500 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '550, 720, 990, 1100, 1500',
                  class: 'gym-designer-image',
                  alt: section.settings.image_5.alt | escape
                }}
              </div>
            {% endif %}
            
            {% if section.settings.image_1 == blank and section.settings.image_2 == blank and section.settings.image_3 == blank and section.settings.image_4 == blank and section.settings.image_5 == blank %}
              <div class="gym-designer-slide active">
                <img src="https://media.istockphoto.com/id/1498849975/photo/modern-gym-interior-with-treadmills-boxing-bag-and-training-equipments.jpg?s=612x612&w=0&k=20&c=ldqgnvNNOOGcYm0kKwomzu4jOUK43FN1nsz1BVTaL6Y=" alt="Gym Interior" class="gym-designer-image">
              </div>
              <div class="gym-designer-slide">
                <img src="https://media.istockphoto.com/id/2175806678/photo/modern-gym-interior-with-sport-and-fitness-equipment-on-black-wall-background-3d-rendering.jpg?s=612x612&w=0&k=20&c=y9WlhcUQHA1w7B_9tf5SZH-D07pnks28agNh35dbD9E=" alt="Weight Training" class="gym-designer-image">
              </div>
              <div class="gym-designer-slide">
                <img src="https://media.istockphoto.com/id/515836700/photo/pilates-room-in-health-club.jpg?s=612x612&w=0&k=20&c=l7EuypqdVlvs8bV4BGRSz9GkJt70Ppjx2zTL624_gqs=" alt="Cardio Equipment" class="gym-designer-image">
              </div>
            {% endif %}
          </div>
          <div class="gym-designer-dots"></div>
        </div>
      </div>
    </div>
  </div>
  
  <script src="{{ 'gym-designer.js' | asset_url }}" defer="defer"></script>
  
  {% schema %}
  {
    "name": "Gym Designer",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "COMMUNITY PROJECTS"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "VIEW PROJECTS AND GAIN INSPIRATION FROM THE GYM DESIGNER COMMUNITY."
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Start Designing"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "header",
        "content": "Slider Images"
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2"
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3"
      },
      {
        "type": "image_picker",
        "id": "image_4",
        "label": "Image 4"
      },
      {
        "type": "image_picker",
        "id": "image_5",
        "label": "Image 5"
      }
    ],
    "presets": [
      {
        "name": "Gym Designer"
      }
    ]
  }
  {% endschema %}
  
  <style>
  .gym-designer-section {
    padding: 40px 0;
  }
  
  .gym-designer-container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: center;
  }
  
  .gym-designer-title {
    font-size: 4rem;
    line-height: 1.1;
    margin-bottom: 20px;
    font-weight: 900;
    text-transform: uppercase;
    color: #333;
    font-family: Lato, sans-serif;
  }
  
  .gym-designer-description {
    font-size: 1.2rem;
    line-height: 1.5;
    margin-bottom: 30px;
    color: #666;
    font-family: Lato, sans-serif;
  }
  
  .gym-designer-button {
    display: inline-block;
    padding: 15px 30px;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    border-radius: 30px;
    font-size: 1.3rem;
    font-weight: 600;
    transition: background-color 0.3s ease;
    font-family: Lato, sans-serif;
    border: none;
    cursor: pointer;
    text-transform: none;
    letter-spacing: 0.5px;
  }
  
  .gym-designer-button:hover {
    background-color: #333;
  }
  
  .gym-designer-gallery {
    position: relative;
    overflow: hidden;
  }
  
  .gym-designer-slider {
    position: relative;
    overflow: hidden;
    min-height: 500px;
  }
  
  .gym-designer-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    display: block;
  }
  
  .gym-designer-slide.active {
    opacity: 1;
    z-index: 1;
  }
  
  .gym-designer-image {
    width: 100%;
    height: 500px;
    object-fit: cover;
    display: block;
  }
  
  .gym-designer-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    gap: 25px;
    z-index: 2;
  }
  
  .dot {
    width: 12px;
    height: 15px;
    border-radius: 50%;
    background-color: white;
    border: 2px solid #fff;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .dot.active {
    background-color: #f1592a;;
    border-color: #f1592a;;
  }
  
  @media screen and (max-width: 989px) {
    .gym-designer-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  
    .gym-designer-content {
      padding-right: 0;
      text-align: center;
    }
  
    .gym-designer-title {
      font-size: 3rem;
    }
  }
  
  @media screen and (max-width: 749px) {
    .gym-designer-section {
      padding: 40px 0;
    }
  
    .gym-designer-title {
      font-size: 2.5rem;
    }
  
    .gym-designer-description {
      font-size: 1rem;
    }
  
    .gym-designer-button {
      padding: 12px 25px;
      font-size: 1rem;
    }
  
    .gym-designer-slider {
      min-height: 300px;
    }
  
    .gym-designer-image {
      height: 300px;
    }
  }
</style>