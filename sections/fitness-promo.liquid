{% comment %}
  Fitness Promo Section - Pure JS Slider
  - Static top banner
  - Left column: Image slider (blocks)
  - Right column: Static editable text fields
  - Fully self-contained with CSS & JS
{% endcomment %}

<section class="fitness-promo">
  <!-- Static Top Banner -->
  <div class="fitness-promo__banner">
    <span>{{ section.settings.top_banner_text }}</span>
  </div>

  <div class="fitness-promo__container">
    <!-- Left Column: Slider -->
    <div class="fitness-promo__slider-wrapper">
      <div class="fitness-promo__slider" id="fitnessPromoSlider-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="fitness-promo__slide">
            {% if block.settings.image %}
              <img 
                src="{{ block.settings.image | image_url: width: 800 }}" 
                alt="{{ block.settings.image.alt | escape }}" 
                loading="lazy"
              >
            {% endif %}
            {% if block.settings.caption != blank %}
              <div class="fitness-promo__caption">{{ block.settings.caption }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="fitness-promo__dots" id="fitnessPromoDots-{{ section.id }}"></div>
    </div>

    <!-- Right Column: Static Content -->
    <div class="fitness-promo__content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.bullets != blank %}
        <ul>
          {% assign bullet_points = section.settings.bullets | split: '\n' %}
          {% for bullet in bullet_points %}
            {% if bullet != blank %}
              <li>{{ bullet }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="fitness-promo__btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <style>
    .fitness-promo {
      padding: 40px 20px;
      background: {{ section.settings.background_color }};
      color: {{ section.settings.text_color }};
    }
    .fitness-promo__banner {
      background: {{ section.settings.banner_bg }};
      color: {{ section.settings.banner_text_color }};
      text-align: center;
      padding: 8px 15px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 20px;
    }
    .fitness-promo__container {
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      align-items: center;
    }
    .fitness-promo__slider-wrapper {
      flex: 1 1 50%;
      position: relative;
      overflow: hidden;
    }
    .fitness-promo__slider {
      display: flex;
      transition: transform 0.5s ease;
    }
    .fitness-promo__slide {
      min-width: 100%;
      box-sizing: border-box;
    }
    .fitness-promo__slide img {
      width: 100%;
      display: block;
    }
    .fitness-promo__caption {
      text-align: center;
      padding: 8px;
      font-size: 14px;
    }
    .fitness-promo__dots {
      text-align: center;
      margin-top: 10px;
    }
    .fitness-promo__dots button {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: none;
      background: #ccc;
      margin: 0 4px;
      cursor: pointer;
      padding: 0;
    }
    .fitness-promo__dots button.active {
      background: {{ section.settings.dot_active_color }};
    }
    .fitness-promo__content {
      flex: 1 1 40%;
    }
    .fitness-promo__content h2 {
      font-size: 28px;
      margin-bottom: 15px;
    }
    .fitness-promo__content ul {
      padding-left: 20px;
      margin: 15px 0;
    }
    .fitness-promo__btn {
      display: inline-block;
      padding: 10px 20px;
      background: {{ section.settings.button_bg }};
      color: {{ section.settings.button_text }};
      text-decoration: none;
      font-weight: 600;
      border-radius: 5px;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const slider = document.querySelector("#fitnessPromoSlider-{{ section.id }}");
      const dotsContainer = document.querySelector("#fitnessPromoDots-{{ section.id }}");
      const slides = slider.children;
      let currentIndex = 0;
      const autoplaySpeed = {{ section.settings.autoplay_speed }};
      let autoplayInterval;

      function showSlide(index) {
        slider.style.transform = `translateX(-${index * 100}%)`;
        dotsContainer.querySelectorAll("button").forEach((dot, i) => {
          dot.classList.toggle("active", i === index);
        });
        currentIndex = index;
      }

      function createDots() {
        for (let i = 0; i < slides.length; i++) {
          const dot = document.createElement("button");
          dot.addEventListener("click", () => {
            showSlide(i);
            restartAutoplay();
          });
          if (i === 0) dot.classList.add("active");
          dotsContainer.appendChild(dot);
        }
      }

      function startAutoplay() {
        if (autoplaySpeed > 0) {
          autoplayInterval = setInterval(() => {
            let nextIndex = (currentIndex + 1) % slides.length;
            showSlide(nextIndex);
          }, autoplaySpeed);
        }
      }

      function restartAutoplay() {
        clearInterval(autoplayInterval);
        startAutoplay();
      }

      createDots();
      startAutoplay();
    });
  </script>

  {% schema %}
  {
    "name": "Fitness Promo",
    "settings": [
      { "type": "text", "id": "top_banner_text", "label": "Top Banner Text", "default": "USA & World Wide" },
      { "type": "color", "id": "banner_bg", "label": "Banner Background", "default": "#000000" },
      { "type": "color", "id": "banner_text_color", "label": "Banner Text Color", "default": "#ffffff" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Your Heading Here" },
      { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Your description here</p>" },
      { "type": "textarea", "id": "bullets", "label": "Bullet Points (one per line)" },
      { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Now" },
      { "type": "url", "id": "button_link", "label": "Button Link" },
      { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#000000" },
      { "type": "color", "id": "button_text", "label": "Button Text Color", "default": "#ffffff" },
      { "type": "color", "id": "background_color", "label": "Section Background", "default": "#ffffff" },
      { "type": "color", "id": "text_color", "label": "Text Color", "default": "#000000" },
      { "type": "color", "id": "dot_active_color", "label": "Active Dot Color", "default": "#000000" },
      { "type": "number", "id": "autoplay_speed", "label": "Autoplay Speed (ms, 0 for off)", "default": 3000 }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Slide Image" },
          { "type": "text", "id": "caption", "label": "Caption" }
        ]
      }
    ],
    "max_blocks": 10,
    "presets": [
      {
        "name": "Fitness Promo",
        "category": "Custom"
      }
    ]
  }
  {% endschema %}
</section>
