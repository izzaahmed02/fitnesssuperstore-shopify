<div class="fsr-extra-info">
  <input type="radio" name="fsr-tabs" id="tab-product-details" checked>
  <input type="radio" name="fsr-tabs" id="tab-tech-specs">
  <input type="radio" name="fsr-tabs" id="tab-accessories">
  <input type="radio" name="fsr-tabs" id="features">

  <!-- TABS -->
  <div class="fsr-tabs">
    <label for="tab-product-details" class="tab-label">Product Details</label>
    <label for="tab-tech-specs" class="tab-label">Tech Specs</label>
    <label for="tab-accessories" class="tab-label">Accessories</label>
    <label for="features" class="tab-label">Features</label>
  </div>

  <!-- TAB CONTENT -->
  <div class="fsr-tab-contents">
    <div class="tab-content" id="content-product-details">
      <div class="product-details-wrapper">
        <div class="content-left">
          <div class="product-description">
            {{ section.settings.product-details-content }}
            {% render 'fsr-prop65' %} 
          </div>
          <div class="manual-buttons">
              <a href="https://fitnesssuperstore.info/pdfs/French%20Fitness%20FSR90%20Functional%20Trainer%20Smith%20&%20Squat%20Rack%20Machine%20Owner's%20Manual_V3.pdf" class="manual-btn" target="_blank">
                <span class="download-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 14.1667V2.5" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M5 9.16602L10 14.166L15 9.16602" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15.8346 17.5H4.16797" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>Owner's Manual (V3)</span>
              </a>
              <a href="https://fitnesssuperstore.info/pdfs/French%20Fitness%20FSR90%20Multi%20Functional%20Trainer%20Smith%20&%20Rack%20System%20Exercises%20Manual%20V2a1.pdf" class="manual-btn" target="_blank">
                <span class="download-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 14.1667V2.5" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M5 9.16602L10 14.166L15 9.16602" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M15.8346 17.5H4.16797" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>Exercise manual</span>
              </a>
          </div>
            <a href="#" class="manual-btn product-data" target="_blank">
              <span class="download-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 14.1667V2.5" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 9.16602L10 14.166L15 9.16602" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15.8346 17.5H4.16797" stroke="#23232B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Download Product Data Sheet</span>
            </a>
        </div>
        <div class="content-right">
          <div class="product-video-wrapper">
            {% assign videos = product.media | where: "media_type", "video" %}
            {% if videos.size > 0 %}
              <div class="product-videos-wrapper">
                {% for video in videos %}
                  <div class="product-video-item">
                    <a href="#" class="product-video-trigger" data-video-id="video-{{ video.id }}">
                      {% if video.preview_image %}
                        <div class="product-video-thumbnail-wrapper">
                          <img 
                            src="{{ video.preview_image | img_url: '800x' }}" 
                            alt="{{ product.title }} video preview {{ forloop.index }}" 
                            class="product-video-thumbnail"
                          >
                          <span class="product-video-play-icon">▶</span>
                        </div>
                      {% else %}
                        <div class="video-placeholder">
                          ▶ Play Video {{ forloop.index }}
                        </div>
                      {% endif %}
                    </a>
                  </div>

                  <!-- Modal -->
                  <div id="video-{{ video.id }}" class="product-video-modal">
                    <div class="product-video-modal-content">
                      <span class="product-video-close">&times;</span>
                      {{ video | media_tag: controls: true, autoplay: true }}
                    </div>
                  </div>
                {% endfor %}
              </div>

              <style>
              .product-videos-wrapper {
              display: flex;
              flex-direction: column; /* stack vertically */
              gap: 16px;
              margin-bottom: 20px;
            }

            .product-video-item {
              width: 100%; /* full width */
            }

            .product-video-thumbnail-wrapper {
              position: relative;
              width: 100%;
            }

            .product-video-thumbnail {
              width: 100%;
              border-radius: 12px;
              cursor: pointer;
              display: block;
            }

            .product-video-play-icon {
              position: absolute;
              top: 50%;
              left: 50%;
              transform: translate(-50%, -50%);
              font-size: 48px;
              color: white;
              text-shadow: 0 0 10px rgba(0,0,0,0.6);
              pointer-events: none;
            }

            @media (max-width: 600px) {
              .product-video-play-icon {
                font-size: 36px; /* smaller on mobile */
              }
            }

            /* Modal */
            .product-video-modal {
              display: none;
              position: fixed;
              z-index: 9999;
              left: 0;
              top: 0;
              width: 100%;
              height: 100%;
              background: rgba(0,0,0,0.9);
              justify-content: center;
              align-items: center;
              padding: 10px;
            }

            .product-video-modal-content {
              position: relative;
              width: 100%;
              max-width: 900px; /* keeps it centered on big screens */
              max-height: 90vh;
            }

            .product-video-modal iframe,
            .product-video-modal video {
              width: 100%;
              height: auto;
              max-height: 90vh;
              border-radius: 12px;
            }

            .product-video-close {
              position: absolute;
              top: -40px;
              right: 0;
              font-size: 32px;
              color: white;
              cursor: pointer;
            }
            html.no-scroll,
            body.no-scroll {
              overflow: hidden;
              height: 100%;
            }

            @media (max-width: 600px) {
              .product-video-close {
                top: 10px;
                right: 10px;
                font-size: 28px;
                background: rgba(0,0,0,0.6);
                border-radius: 50%;
                padding: 4px 10px;
                z-index: 999;
              }
            }



              </style>
            <script>
            document.addEventListener("DOMContentLoaded", function() {
              const triggers = document.querySelectorAll(".product-video-trigger");
              const modals = document.querySelectorAll(".product-video-modal");

              // Open modal
              triggers.forEach(trigger => {
                trigger.addEventListener("click", function(e) {
                  e.preventDefault();
                  const videoId = this.getAttribute("data-video-id");
                  const modal = document.getElementById(videoId);
                  if (modal) {
                    modal.style.display = "flex";
                    document.body.classList.add("no-scroll"); // disable scroll
                  }
                });
              });

              // Close modal
              modals.forEach(modal => {
                const closeBtn = modal.querySelector(".product-video-close");
                closeBtn.addEventListener("click", function() {
                  modal.style.display = "none";
                  document.body.classList.remove("no-scroll"); // re-enable scroll
                  stopVideo(modal);
                });
              });

              // Close when clicking outside
              window.addEventListener("click", function(e) {
                modals.forEach(modal => {
                  if (e.target === modal) {
                    modal.style.display = "none";
                    document.body.classList.remove("no-scroll"); // re-enable scroll
                    stopVideo(modal);
                  }
                });
              });

              // Stop video (works for <video> and <iframe>)
              function stopVideo(modal) {
                const video = modal.querySelector("video");
                const iframe = modal.querySelector("iframe");

                if (video) {
                  video.pause();
                  video.currentTime = 0;
                }

                if (iframe) {
                  iframe.src = iframe.src; // reload iframe to stop playback
                }
              }
            });
            </script>


            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <div class="tab-content" id="content-tech-specs">
      <div class="tech-specs-wrapper">
        <div class="content-left">
          <div class="tech-spec-image">
          <img 
              src="{{ section.settings.tech-specs-image | image_url: width: 486}}" 
              alt="{{ section.settings.tech-specs-image.alt | escape }}"
              style="width:100%; height:auto;"
            >

          </div>
          <div class="tech-specs">
            <h4>{{section.settings.tech-specs-title}}</h4>
            <div class="tech-specs-content">{{section.settings.tech-specs-content}}</div>
          </div>
        </div>
        <div class="content-right">
          <div class="weight-stacks">
            <h4>{{section.settings.weight-stacks-title}}</h4>
            <div class="weight-stacks-content">{{section.settings.weight-stacks-content}}</div>
          </div>
          <div class="smith-bar-specs">
            <h4>{{section.settings.smith-bar-specs-title}}</h4>
            <div class="smith-bar-specs-content">{{section.settings.smith-bar-specs-content}}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="tab-content" id="content-accessories">
    <div class="content-accessories-wrapper">
      <div class="metafield-rich_text_field">
        <ul>
          <li><strong>Band Pegs (Set)</strong> Add accommodating resistance to barbell and cable moves</li>
          <li><strong>Spring Collars (6)</strong> Secure plates on Smith/landmine bars</li>
          <li><strong>Pins (7)</strong> Fast swaps across stations</li>
          <li><strong>Dual Hook Jammer Arm Connector</strong> Converts jammer arms for leg press patterns</li>
          <li><strong>Right J Hook</strong> 4.5" extension; quick height indexing (Extends 4.5" From Cable Columns)</li>
          <li><strong>Left J Hook</strong>  4.5" extension; quick height indexing (Extends 4.5" From Cable Columns)</li>
          <li><strong>Lat Pull Knee Cushion w/Right J Hook</strong> Locks in for stable pulldowns</li>
          <li><strong>Platform</strong> Leverage squats, calf raises, push/press with jammer arms</li>
          <li><strong>Lat Bar</strong> Bilateral push/pull cable staples</li>
          <li><strong>Jammer Arm Grip Handles (Set)</strong> Iso-lateral chest/shoulder/row/squat/shrug power (They can also be used in conjunction with the included straight bar for leg presses, squats, deadlifts, shoulder shrugs, and more. They allow more explosive movements with greater stability and control than free weights. They connect to the cable columns on the front of the FSR machine)</li>
        </ul>
      </div>
      <div class="metafield-rich_text_field">
        <ul>
          <li><strong>Stirrup Handles (Set)</strong> Single-arm cable rows, presses, flies, curls</li>
          <li><strong>Extension Chains (Set)</strong> Increase cable reach/range for tall or floor moves</li>
          <li><strong>Carabiners (4)</strong> Fast swaps across stations</li>
          <li><strong>Adjustable Dual Dip Bars (Set)</strong> Removable; multiple heights for chest/tri focus</li>
          <li><strong>Safety Bar Catches (Set)</strong> 16" extension from columns for confident fails (Included in the Depth measurement of 65")</li>
          <li><strong>Jammer Arms (Set)</strong> Iso-lateral presses, rows, squats, shrugs; with the connector + straight bar they double as a leg press system</li>
          <li><strong>Jaw Lock Collars (Set)</strong> Secure plates on Smith/landmine bars</li>
          <li><strong>Landmine Attachment</strong> T-bar rows, presses, anti-rotation core</li>
          <li><strong>Vertical Leg Press Plate (Weight: 17 lbs)</strong> Smith-based leg press setup</li>
          <li><strong>Dual Hook Revolving Straight Bar</strong> Smooth triceps/biceps cable work</li>
          <li><strong>Straight Bar</strong> Bilateral push/pull cable staples</li>
          <li><strong>Olympic Bar Holder</strong> Clean, vertical storage at the rack</li>
        </ul>
      </div>
    </div>
    </div>
    <div class="tab-content" id="content-features">
      <div class="features-wrapper">
        <div class="content-left">
          <h4>{{section.settings.features-title}}</h4>
          <div class="features-content">{{section.settings.features-content}}</div>
        </div>
        <div class="content-right">
        <h4>{{section.settings.all-in-one-title}}</h4>
        <div class="all-in-one-content">{{section.settings.all-in-one-content}}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .fsr-extra-info {
    padding: 45px 26px;
  }

  .fsr-extra-info input[type="radio"] {
    display: none;
  }

  .fsr-tabs {
    display: flex;
    justify-content: space-between;
    gap: 15px;   
    width: 100%;
    margin-bottom: 20px;
    border-bottom: 1px solid #EDEFF3;
  }

  .tab-label {
    font-family: Oswald;
    font-size: 16px;
    line-height: 26px;
    font-weight: 600;
    text-transform: uppercase;
    color: #23232B;
    flex: 1;
    text-align: center;
    padding-bottom: 8px;
    cursor: pointer;
    transition: .2s;
  }
  #tab-product-details:checked ~ .fsr-tabs label[for="tab-product-details"],
  #tab-tech-specs:checked ~ .fsr-tabs label[for="tab-tech-specs"],
  #tab-accessories:checked ~ .fsr-tabs label[for="tab-accessories"],
  #features:checked ~ .fsr-tabs label[for="features"] {
    border-bottom: 3px solid #D83D0E;
  }
  .tab-content {
    display: none;
  }
  #tab-product-details:checked ~ .fsr-tab-contents #content-product-details,
  #tab-tech-specs:checked ~ .fsr-tab-contents #content-tech-specs,
  #tab-accessories:checked ~ .fsr-tab-contents #content-accessories,
  #features:checked ~ .fsr-tab-contents #content-features {
    display: block;
  }

  .product-details-wrapper,.tech-specs-wrapper, .features-wrapper {
    display: flex;
    gap: 20px;
  }
  .content-left, .content-right{
    width: 50%
  }
  .product-details-wrapper .product-description ul{
    padding-left: 30px;
    list-style: disc;
  }
  .product-details-wrapper .product-description ul li{
    list-style: disc;
  }
  .product-details-wrapper .product-description a{
    color: #D83D0E;
    text-decoration: underline;
  }
  .tech-specs-wrapper .content-left, .tech-specs-wrapper .content-right{
    display:flex;
    flex-direction: column;
    gap: 12px;
  }
  .tech-specs-wrapper, .features-wrapper{
    font-size: 14px;
    line-height: 20px;
    font-family: Lato;
  }
  .tech-specs-wrapper h4, .features-wrapper h4{
    font-family: 'Lato';
    line-height: 24px;
    font-size: 16px;
    font-weight: 800;
    margin: 0;
    border-bottom: 1px solid #EDEFF3;
    padding-bottom: 8px;
  }
  .tech-specs-wrapper ul, .features-content ul, .all-in-one-content .metafield-single_line_text_field-array{
    margin-left:20px;
    line-height: 1.6;
    padding-top: 12px;
  }
  .metafield-rich_text_field li{
    list-style-type: disc;
  }

  .tech-specs-content ul, .tech-specs-content li,.weight-stacks-content ul, .weight-stacks-content li,.smith-bar-specs-content ul,.smith-bar-specs-content li{
    list-style: disc;
  }
  .content-accessories-wrapper{
    display:flex;
    gap: 20px;
  }
  .content-accessories-wrapper .metafield-rich_text_field{
    flex:1;
  }
  #content-accessories .metafield-rich_text_field li{
    list-style: none;
    border-bottom: 1px solid #E5E5E5;
    padding: 12px;
    font-size: 14px;
  }
  .features-content li, .all-in-one-content .metafield-single_line_text_field-array li{
    list-style-type: disc;
  }
  .metafield-single_line_text_field-array li{
    font-size: 14px;
    font-weight: 100;
  }
  .manual-buttons{
    display: flex;
    gap: 10px;
  }
  .manual-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: #EDEFF3;
    border-radius: 8px;
  }
  .download-icon{
    justify-content: center;
    display: flex;
    align-items: center;
  }
  .manual-btn-text{
    font-size: 14px;
    font-weight: 700;
    line-height: 24px;
  }
  .manual-btn.product-data{
    margin-top: 8px;
  }
  @media screen and (min-width: 990px) {
    .manual-btn.product-data{
      width: max-content;
    }
  }
  @media (max-width: 600px) {
    .fsr-extra-info {
      padding: 20px 16px;
    }
    .tab-label{
      font-size: 14px;
    }
    .product-video-close{
      top: -40px;
      padding: 2px 6px;
    }
    .product-details-wrapper, .tech-specs-wrapper, .features-wrapper{
      flex-direction: column;
    }
    .content-left, .content-right {
      width: 100%;
    }
    .product-details-wrapper .content-right{
      order: 1;
    }
    .product-details-wrapper .content-left{
      order: 2;
    }
    #content-accessories .metafield-rich_text_field li {
      padding: 12px 0px;
    }
    .content-accessories-wrapper {
      display: block;
    }
    .manual-buttons{
      flex-direction: column;
    }
  }
</style>

