<link rel="stylesheet" href="{{ 'remanufactured-photos-brands.css' | asset_url }}">

<section class="remanufactured-brands-section">
    <div class="container">
      <p class="section-description">{{ section.settings.description }}</p>
      <div class="brand-grid">
        {% for block in section.blocks %}
        <div class="brand-item">
          <img height="" width="" src="{{ block.settings.logo | image_url }}" alt="{{ block.settings.brand_name }}" />
          <span>{{ block.settings.brand_name }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% schema %}
{
  "name": "Remanufactured Brands",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "View some of our remanufactured machines below:"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand Logo"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Remanufactured Brands",
    }
  ]
}
{% endschema %}
