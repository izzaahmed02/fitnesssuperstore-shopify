<script>
    document.addEventListener("DOMContentLoaded", async (event) => {
      let aggrReviews = [];
    
      try {
        // Fetch the reviews data from the API
        const response = await fetch('https://fitnesssuperstore-api.azurewebsites.net/api/reviews/all?from=&orderBy=');
        if (!response.ok) {
          throw new Error(`HTTP error! Status: ${response.status}`);
        }
        
        // Parse the JSON data and assign it to aggrReviews
        aggrReviews = await response.json();
    
        // Calculate the total and average ratings
        const total = aggrReviews.reduce((sum, item) => sum + parseFloat(item.rating), 0);
        const average = total / aggrReviews.length;
    
        // Update the average rating and reviews count in the DOM
        document.querySelector('.average').innerHTML = average.toFixed(1);
        document.querySelector('.reviews-count span').innerHTML = aggrReviews.length;
        document.querySelector('.reviews-total .Stars').setAttribute('style', `--rating: ${average.toFixed(1)}`);
    
        // Calculate the percentage for each star rating (1 to 5)
        const progressBars = document.querySelectorAll('.progress-bar');
        const percentage = document.querySelectorAll('.percentage');
    
        for (let i = 1; i <= 5; i++) {
          let stars = aggrReviews.filter(item => item.rating == i);
          let avg = (100 * stars.length) / aggrReviews.length;
          progressBars[5 - i].setAttribute('data-progress', avg);
          percentage[5 - i].innerHTML = avg.toFixed(1) + '%';
        }
    
        // Set the width of each progress bar based on the calculated percentage
        progressBars.forEach(bar => {
          const progress = bar.getAttribute('data-progress');
          const progressElement = bar.querySelector('.progress');
          progressElement.style.width = progress + '%';
        });
    
      } catch (error) {
        console.error("Failed to fetch reviews:", error);
      }
    });

</script>



