<section class="info-banner">
  <div class="info-container">
    <h2 class="info-heading">{{ section.settings.heading }}</h2>
    <p class="info-text">{{ section.settings.text }}</p>

    {% if section.settings.button_label != blank %}
      <a class="info-btn"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% endif %}>
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
.info-banner {
  background: #f5f5f5;
  padding: 50px 24px;
  text-align: center;
  font-family: 'DM Sans';
  padding: 50px 0;
}

.info-banner .info-container {
  max-width: 860px;
  margin: 0 auto;
}

.info-banner .info-heading {
  font-size: 36px;
  font-weight: 700;
  letter-spacing: .5px;
  margin-bottom: 24px;
  text-transform: uppercase;
}

.info-banner .info-text {
  font-size: 16px;
  line-height: 24px;
  color: #000;
  margin-bottom: 40px;
  font-weight: 400;
}

.info-banner .info-btn {
  display: inline-block;
  background: #DF633A;
  color: #fff;
  padding: 12px 36px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: background .25s;
}

.info-banner .info-btn:hover {
  background: #a74d32;
}

@media (max-width: 767px) {
  .info-banner {
    padding: 72px 16px;
  }
  .info-banner .info-heading {
    font-size: 28px;
    margin-bottom: 20px;
    text-align: start;
  }
  .info-banner .info-text {
    font-size: 14px;
    line-height: 22px;
    margin-bottom: 32px;
    text-align: start;
  }
  .info-banner a.info-btn {
    width: 100%;
  }
}

</style>

{% schema %}
{
  "name": "Need more information",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEED MORE INFORMATION?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "As the experts in gym equipment, we're here to provide professional consultation on product selection, competitive pricing, freight and delivery options, and answer any other questions you may have."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Need more information"
    }
  ]
}
{% endschema %}
