{%- comment -%}
  Benicia Showroom Landing Page
  Dedicated landing page for /pages/gym-equipment-showroom-benicia-ca.
  Built from the approved "Benicia Showroom Landing Page" Figma.

  Inherits the global header/footer (rendered by the layout). The desktop
  sidebar is suppressed for this page via the page.template_suffix ==
  'showroom-benicia' exception in layout/theme.liquid.

  Analytics: pushes four GTM dataLayer events for Vladimir's validation:
    - showroom_call_click       (phone CTAs)
    - check_model_submit        (Check a Model form submit)
    - directions_click          (Get Directions link)
    - video_walkthrough_submit  (Request a Video Walkthrough CTA)
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign phone_tel = s.phone_tel | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<div class="sr-page" data-sr-root>
  {%- comment -%} ============================ HERO ============================ {%- endcomment -%}
  <section class="sr-hero" style="--sr-hero-image: url('{{ s.hero_image | image_url: width: 2000 }}');">
    <div class="sr-hero__overlay"></div>
    <div class="sr-container sr-hero__inner">
      <h1 class="sr-hero__title">{{ s.hero_heading }}</h1>
      <p class="sr-hero__text">{{ s.hero_text }}</p>
      <ul class="sr-hero__meta">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{ s.address }}</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ s.showroom_hours }}</li>
      </ul>
      <div class="sr-hero__ctas">
        <a class="sr-btn sr-btn--primary"
           href="tel:{{ phone_tel }}"
           data-sr-event="showroom_call_click"
           data-sr-location="hero">
          {{ s.cta_call_label }}
        </a>
        <a class="sr-btn sr-btn--secondary" href="#sr-check-model">
          {{ s.cta_check_label }}
        </a>
        <a class="sr-btn sr-btn--ghost"
           href="{{ s.directions_url }}"
           target="_blank" rel="noopener"
           data-sr-event="directions_click"
           data-sr-location="hero">
          {{ s.cta_directions_label }}
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ====================== INSIDE THE SHOWROOM (gallery) ====================== {%- endcomment -%}
  <section class="sr-section sr-gallery">
    <div class="sr-container">
      <h2 class="sr-section__title">{{ s.gallery_heading }}</h2>
      <p class="sr-section__lede">{{ s.gallery_text }}</p>

      <div class="sr-gallery__track" role="list">
        {%- for i in (1..4) -%}
          {%- liquid
            assign img_key = 'gallery_image_' | append: i
            assign cap_key = 'gallery_caption_' | append: i
            assign img = s[img_key]
            assign cap = s[cap_key]
          -%}
          {%- if img != blank -%}
            <figure class="sr-gallery__item" role="listitem">
              <img
                src="{{ img | image_url: width: 900 }}"
                srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 750px) 380px, 80vw"
                width="900"
                height="{{ 900 | divided_by: img.aspect_ratio | round }}"
                alt="{{ cap | strip_html | escape }}"
                loading="lazy">
              {%- if cap != blank -%}<figcaption>{{ cap }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="sr-gallery__note">{{ s.gallery_note }}</p>
    </div>
  </section>

  {%- comment -%} ====================== WHAT YOU CAN COMPARE ====================== {%- endcomment -%}
  <section class="sr-section sr-compare">
    <div class="sr-container">
      <h2 class="sr-section__title">{{ s.compare_heading }}</h2>
      {%- if s.compare_disclosure != blank -%}
        <p class="sr-compare__disclosure">{{ s.compare_disclosure }}</p>
      {%- endif -%}
      <div class="sr-compare__grid">
        {%- for i in (1..4) -%}
          {%- liquid
            assign t_key = 'compare_title_' | append: i
            assign d_key = 'compare_text_' | append: i
            assign t = s[t_key]
            assign d = s[d_key]
          -%}
          {%- if t != blank -%}
            <div class="sr-compare__card">
              <h3>{{ t }}</h3>
              <p>{{ d }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ====================== CHECK A MODEL FORM ====================== {%- endcomment -%}
  <section class="sr-section sr-form-section" id="sr-check-model">
    <div class="sr-container sr-form-wrap">
      <div class="sr-form-card" data-sr-form-card>
        {% form 'contact', id: 'ShowroomCheckModel', class: 'sr-form' %}
          {%- if form.posted_successfully? -%}
            <div class="sr-form-success" data-sr-success>
              <div class="sr-form-success__icon" aria-hidden="true">
                <svg viewBox="0 0 52 52" width="56" height="56"><circle cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M15 27l7 7 15-15"/></svg>
              </div>
              <h2>{{ s.success_heading }}</h2>
              <p>{{ s.success_text }}</p>
              <a class="sr-btn sr-btn--secondary" href="{{ request.path }}#sr-check-model">{{ s.success_button_label }}</a>
            </div>
          {%- else -%}
            <div class="sr-form-head">
              <h2 class="sr-section__title">{{ s.form_heading }}</h2>
              <p class="sr-form-head__sub">{{ s.form_subtext }}</p>
              <ul class="sr-form-head__points">
                {%- if s.form_point_1 != blank -%}<li><svg class="sr-ico-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ s.form_point_1 }}</li>{%- endif -%}
                {%- if s.form_point_2 != blank -%}<li><svg class="sr-ico-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ s.form_point_2 }}</li>{%- endif -%}
              </ul>
            </div>

            {%- if form.errors -%}
              <div class="sr-form-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <input type="hidden" name="contact[form_type]" value="Benicia Showroom — Check a Model">
            <input type="hidden" name="contact[source_page]" value="{{ request.origin }}{{ request.path }}">

            <div class="sr-field">
              <label for="sr-name">Full name <span class="sr-req">*</span></label>
              <input type="text" id="sr-name" name="contact[name]" placeholder="John Doe" required>
            </div>

            <div class="sr-field">
              <label for="sr-method">Preferred contact method <span class="sr-req">*</span></label>
              <select id="sr-method" name="contact[preferred_contact_method]" required data-sr-method>
                <option value="" disabled selected>Select option</option>
                <option value="Phone">Phone</option>
                <option value="Email">Email</option>
              </select>
            </div>

            <div class="sr-field">
              <label for="sr-contact">Phone / Email <span class="sr-req">*</span></label>
              <input type="text" id="sr-contact" name="contact[phone_or_email]" placeholder="(925) 555-0100 / your@email.com" required data-sr-contact-value>
            </div>

            <div class="sr-field">
              <label for="sr-model">Product name, model, or product page link <span class="sr-req">*</span></label>
              <input type="text" id="sr-model" name="contact[product_model]" placeholder="e.g. French Fitness FSR90" required>
            </div>

            <div class="sr-field">
              <label for="sr-visit">Preferred visit date or time <span class="sr-req">*</span></label>
              <input type="text" id="sr-visit" name="contact[preferred_visit]" placeholder="Select date" required
                     onfocus="(this.type='datetime-local')" onblur="if(!this.value){this.type='text'}">
            </div>

            <div class="sr-field-row">
              <div class="sr-field">
                <label for="sr-zip">Delivery ZIP <span class="sr-opt">(optional)</span></label>
                <input type="text" id="sr-zip" name="contact[delivery_zip]" placeholder="94510" inputmode="numeric" pattern="[0-9]*">
              </div>
              <div class="sr-field">
                <label for="sr-use">Home or commercial use <span class="sr-opt">(optional)</span></label>
                <select id="sr-use" name="contact[use_type]">
                  <option value="" disabled selected>Select option</option>
                  <option value="Home">Home</option>
                  <option value="Commercial">Commercial</option>
                </select>
              </div>
            </div>

            <div class="sr-field">
              <label for="sr-compare">Anything specific you want to compare <span class="sr-opt">(optional)</span></label>
              <input type="text" id="sr-compare" name="contact[compare_notes]" placeholder="e.g. comparing to the FSR100">
            </div>

            <button type="submit" class="sr-btn sr-btn--primary sr-btn--block" data-sr-event="check_model_submit">
              {{ s.form_button_label }}
            </button>

            <p class="sr-form-fineprint">{{ s.form_fineprint }}</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </section>

  {%- comment -%} ====================== WHAT TO EXPECT ====================== {%- endcomment -%}
  <section class="sr-section sr-expect">
    <div class="sr-container sr-expect__grid">
      <div class="sr-expect__media">
        {%- if s.expect_image != blank -%}
          <img src="{{ s.expect_image | image_url: width: 1000 }}"
               srcset="{{ s.expect_image | image_url: width: 600 }} 600w, {{ s.expect_image | image_url: width: 1000 }} 1000w"
               sizes="(min-width: 750px) 460px, 100vw"
               width="1000" height="{{ 1000 | divided_by: s.expect_image.aspect_ratio | round }}"
               alt="{{ s.expect_image_alt | default: 'Inside the Benicia showroom floor' | escape }}"
               loading="lazy">
        {%- endif -%}
      </div>
      <div class="sr-expect__body">
        <h2 class="sr-section__title">{{ s.expect_heading }}</h2>
        <p class="sr-expect__lede">{{ s.expect_lede }}</p>
        <ul class="sr-expect__list">
          {%- for i in (1..7) -%}
            {%- assign k = 'expect_point_' | append: i -%}
            {%- if s[k] != blank -%}<li><svg class="sr-ico-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ s[k] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ====================== VIDEO WALKTHROUGH ====================== {%- endcomment -%}
  <section class="sr-section sr-walkthrough">
    <div class="sr-container sr-walkthrough__inner">
      <h2 class="sr-section__title">{{ s.walkthrough_heading }}</h2>
      <p>{{ s.walkthrough_text }}</p>
      <a class="sr-btn sr-btn--primary"
         href="{{ s.walkthrough_url }}"
         data-sr-event="video_walkthrough_submit"
         data-sr-location="walkthrough">
        {{ s.walkthrough_button_label }}
      </a>
    </div>
  </section>

  {%- comment -%} ====================== MAP / HOURS / DIRECTIONS ====================== {%- endcomment -%}
  <section class="sr-section sr-map">
    <div class="sr-container sr-map__grid">
      <div class="sr-map__embed">
        {{ s.map_embed }}
      </div>
      <div class="sr-map__details">
        <p class="sr-map__eyebrow">{{ s.map_eyebrow }}</p>
        <h2 class="sr-section__title">{{ s.map_heading }}</h2>
        <ul class="sr-map__list">
          {%- for i in (1..7) -%}
            {%- assign k = 'map_point_' | append: i -%}
            {%- if s[k] != blank -%}<li>{{ s[k] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="sr-map__ctas">
          <a class="sr-btn sr-btn--primary"
             href="tel:{{ phone_tel }}"
             data-sr-event="showroom_call_click"
             data-sr-location="map">
            {{ s.map_call_label }}
          </a>
          <a class="sr-btn sr-btn--ghost"
             href="{{ s.directions_url }}"
             target="_blank" rel="noopener"
             data-sr-event="directions_click"
             data-sr-location="map">
            {{ s.cta_directions_label }}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
/* Full-width page wrapper (sidebar suppressed for this template) */
.showroom-fullwidth { display: block; width: 100%; }
.showroom-fullwidth > .inner-container { width: 100%; max-width: none; }

.sr-page {
  --sr-red: #d83d0e;
  --sr-red-dark: #b8330c;
  --sr-ink: #23232b;
  --sr-muted: #4a4a52;
  --sr-bg: #faf9f9;
  --sr-border: #e6e4e4;
  --sr-radius: 14px;
  color: var(--sr-ink);
  font-family: inherit;
}
.sr-container { max-width: 1200px; margin: 0 auto; padding-inline: 20px; }
.sr-section { padding-block: 56px; }
.sr-section__title { font-size: clamp(26px, 3vw, 38px); line-height: 1.2; margin: 0 0 14px; font-weight: 700; }
.sr-section__lede { max-width: 760px; margin: 0 0 28px; color: var(--sr-muted); font-size: 17px; }

/* Buttons */
.sr-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 14px 24px; border-radius: 10px; font-weight: 600; font-size: 16px;
  text-decoration: none; cursor: pointer; border: 2px solid transparent;
  transition: background-color .15s ease, color .15s ease, border-color .15s ease; line-height: 1;
}
.sr-btn--primary { background: var(--sr-red); color: #fff; }
.sr-btn--primary:hover { background: var(--sr-red-dark); color: #fff; }
.sr-btn--secondary { background: var(--sr-ink); color: #fff; }
.sr-btn--secondary:hover { background: #000; color: #fff; }
.sr-btn--ghost { background: transparent; color: var(--sr-ink); border-color: var(--sr-ink); }
.sr-btn--ghost:hover { background: var(--sr-ink); color: #fff; }
.sr-btn--block { width: 100%; }

/* Hero */
.sr-hero { position: relative; color: #fff; background: #1c1c22 var(--sr-hero-image) center/cover no-repeat; }
.sr-hero__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,20,24,.86) 0%, rgba(20,20,24,.62) 55%, rgba(20,20,24,.35) 100%); }
.sr-hero__inner { position: relative; padding-block: 72px; max-width: 1200px; }
.sr-hero__title { font-size: clamp(30px, 4.4vw, 52px); line-height: 1.1; font-weight: 800; margin: 0 0 18px; max-width: 760px; }
.sr-hero__text { max-width: 640px; font-size: 18px; line-height: 1.55; margin: 0 0 22px; color: #f0eeee; }
.sr-hero__meta { list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-wrap: wrap; gap: 10px 28px; }
.sr-hero__meta li { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.sr-hero__meta svg { width: 18px; height: 18px; flex: none; }
.sr-hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.sr-hero .sr-btn--ghost { color: #fff; border-color: #fff; }
.sr-hero .sr-btn--ghost:hover { background: #fff; color: var(--sr-ink); }

/* Gallery */
.sr-gallery__track { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(300px, 1fr); gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; }
.sr-gallery__item { scroll-snap-align: start; margin: 0; background: #fff; border: 1px solid var(--sr-border); border-radius: var(--sr-radius); overflow: hidden; }
.sr-gallery__item img { display: block; width: 100%; height: 260px; object-fit: cover; }
.sr-gallery__item figcaption { padding: 14px 16px; font-size: 14px; color: var(--sr-muted); }
.sr-gallery__note { margin: 22px 0 0; font-size: 13px; color: var(--sr-muted); font-style: italic; }

/* Compare */
.sr-compare { background: var(--sr-bg); }
.sr-compare__disclosure { margin: -6px 0 26px; font-weight: 600; color: var(--sr-red-dark); }
.sr-compare__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.sr-compare__card { background: #fff; border: 1px solid var(--sr-border); border-radius: var(--sr-radius); padding: 22px 20px; }
.sr-compare__card h3 { margin: 0 0 10px; font-size: 18px; line-height: 1.3; }
.sr-compare__card p { margin: 0; color: var(--sr-muted); font-size: 15px; }

/* Form */
.sr-form-section { background: var(--sr-ink); }
.sr-form-wrap { display: flex; justify-content: center; }
.sr-form-card { width: 100%; max-width: 720px; background: #fff; border-radius: 18px; padding: 34px; }
.sr-form-head { margin-bottom: 22px; }
.sr-form-head__sub { margin: 8px 0 12px; color: var(--sr-muted); }
.sr-form-head__points { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
.sr-form-head__points li { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--sr-muted); }
.sr-form-head__points svg { width: 16px; height: 16px; color: var(--sr-red); flex: none; }
.sr-field { margin-bottom: 16px; }
.sr-field label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
.sr-field input, .sr-field select { width: 100%; padding: 12px 14px; border: 1px solid #cfcdcd; border-radius: 8px; font-size: 15px; font-family: inherit; background: #fff; color: var(--sr-ink); }
.sr-field input:focus, .sr-field select:focus { outline: 2px solid var(--sr-red); outline-offset: 1px; border-color: var(--sr-red); }
.sr-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.sr-req { color: var(--sr-red); }
.sr-opt { color: #9a9a9a; font-weight: 400; }
.sr-form-fineprint { margin: 14px 0 0; font-size: 13px; color: var(--sr-muted); }
.sr-form-errors { background: #fdecea; border: 1px solid #f5c6c0; color: #a12a1a; padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; font-size: 14px; }
.sr-form-success { text-align: center; padding: 20px 10px; }
.sr-form-success__icon { color: var(--sr-red); margin-bottom: 10px; }
.sr-form-success h2 { margin: 0 0 10px; font-size: 26px; }
.sr-form-success p { margin: 0 auto 22px; max-width: 460px; color: var(--sr-muted); }

/* Expect */
.sr-expect__grid { display: grid; grid-template-columns: 460px 1fr; gap: 44px; align-items: center; }
.sr-expect__media img { width: 100%; border-radius: var(--sr-radius); display: block; }
.sr-expect__lede { font-weight: 600; margin: 0 0 16px; }
.sr-expect__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.sr-expect__list li { display: flex; align-items: flex-start; gap: 10px; color: var(--sr-muted); }
.sr-expect__list svg { width: 18px; height: 18px; color: var(--sr-red); flex: none; margin-top: 3px; }

/* Walkthrough */
.sr-walkthrough { background: var(--sr-bg); }
.sr-walkthrough__inner { max-width: 720px; text-align: center; }
.sr-walkthrough__inner p { color: var(--sr-muted); font-size: 17px; margin: 0 0 24px; }

/* Map */
.sr-map__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.sr-map__embed { border-radius: var(--sr-radius); overflow: hidden; min-height: 320px; }
.sr-map__embed iframe { width: 100%; min-height: 380px; border: 0; display: block; }
.sr-map__eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: 13px; font-weight: 700; color: var(--sr-red); margin: 0 0 6px; }
.sr-map__list { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 8px; }
.sr-map__list li { position: relative; padding-left: 20px; color: var(--sr-muted); }
.sr-map__list li::before { content: ""; position: absolute; left: 4px; top: 9px; width: 6px; height: 6px; border-radius: 50%; background: var(--sr-red); }
.sr-map__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

/* Responsive */
@media (max-width: 990px) {
  .sr-compare__grid { grid-template-columns: repeat(2, 1fr); }
  .sr-expect__grid { grid-template-columns: 1fr; gap: 26px; }
  .sr-map__grid { grid-template-columns: 1fr; gap: 24px; }
}
@media (max-width: 749px) {
  .sr-section { padding-block: 40px; }
  .sr-hero__inner { padding-block: 52px; }
  .sr-hero__ctas .sr-btn { flex: 1 1 100%; }
  .sr-gallery__track { grid-auto-columns: 78%; }
  .sr-compare__grid { grid-template-columns: 1fr; }
  .sr-field-row { grid-template-columns: 1fr; }
  .sr-form-card { padding: 24px 18px; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function push(name, extra) {
    window.dataLayer = window.dataLayer || [];
    var payload = { event: name };
    if (extra) { for (var k in extra) { if (extra.hasOwnProperty(k)) payload[k] = extra[k]; } }
    window.dataLayer.push(payload);
  }

  // Click-based events (call, directions, video walkthrough)
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-sr-event]');
    if (!el) return;
    var name = el.getAttribute('data-sr-event');
    if (name === 'check_model_submit') return; // handled on form submit
    push(name, { location: el.getAttribute('data-sr-location') || '' });
  });

  // Form submit event
  var form = document.getElementById('ShowroomCheckModel');
  if (form) {
    form.addEventListener('submit', function () {
      push('check_model_submit', { location: 'check_model_form' });
    });

    // Adjust the contact-value input type to match the chosen method
    var method = form.querySelector('[data-sr-method]');
    var value = form.querySelector('[data-sr-contact-value]');
    if (method && value) {
      method.addEventListener('change', function () {
        if (method.value === 'Email') {
          value.type = 'email';
          value.placeholder = 'your@email.com';
        } else if (method.value === 'Phone') {
          value.type = 'tel';
          value.placeholder = '(925) 555-0100';
        }
      });
    }
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Showroom Benicia",
  "tag": "section",
  "class": "section section-showroom-benicia",
  "settings": [
    { "type": "header", "content": "Hero" },
