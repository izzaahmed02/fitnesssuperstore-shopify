{%- comment -%}
  Benicia Showroom Landing Page
  Dedicated landing page for /pages/gym-equipment-showroom-benicia-ca.
  Built to match the approved "Benicia Showroom Landing Page" Figma.

  Inherits the global header/footer (rendered by the layout). The desktop
  sidebar is suppressed for this page via the page.template_suffix ==
  'showroom-benicia' exception in layout/theme.liquid.

  Analytics: pushes four GTM dataLayer events for Vladimir's validation:
    - showroom_call_click       (phone CTAs)
    - check_model_submit        (Check a Model form submit)
    - directions_click          (Get Directions link)
    - video_walkthrough_submit  (Request a Video Walkthrough CTA)
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign phone_tel = s.phone_tel | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<div class="sr-page" data-sr-root>
  {%- comment -%} ============================ HERO ============================ {%- endcomment -%}
  <section class="sr-hero" style="--sr-hero-image: url('{{ s.hero_image | image_url: width: 2000 }}');">
    <div class="sr-hero__overlay"></div>
    <div class="sr-container sr-hero__inner">
      <h1 class="sr-hero__title">{{ s.hero_heading }}</h1>
      <p class="sr-hero__text">{{ s.hero_text }}</p>
      <ul class="sr-hero__meta">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{ s.address }}</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ s.showroom_hours }}</li>
      </ul>
      <div class="sr-hero__ctas">
        <a class="sr-btn sr-btn--primary" href="tel:{{ phone_tel }}" data-sr-event="showroom_call_click" data-sr-location="hero">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"/></svg>{{ s.cta_call_label }}
        </a>
        <a class="sr-btn sr-btn--secondary" href="#sr-check-model">{{ s.cta_check_label }}</a>
        <a class="sr-btn sr-btn--link" href="{{ s.directions_url }}" target="_blank" rel="noopener" data-sr-event="directions_click" data-sr-location="hero">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{ s.cta_directions_label }}
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ====================== INSIDE THE SHOWROOM (carousel) ====================== {%- endcomment -%}
  <section class="sr-section sr-gallery">
    <div class="sr-container">
      <h2 class="sr-section__title sr-center">{{ s.gallery_heading }}</h2>
      <p class="sr-section__lede sr-center">{{ s.gallery_text }}</p>

      <div class="sr-carousel" data-sr-carousel>
        <button type="button" class="sr-carousel__btn sr-carousel__btn--prev" data-sr-prev aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="sr-carousel__track" data-sr-track role="list">
          {%- for i in (1..4) -%}
            {%- liquid
              assign img_key = 'gallery_image_' | append: i
              assign cap_key = 'gallery_caption_' | append: i
              assign img = s[img_key]
              assign cap = s[cap_key]
            -%}
            {%- if img != blank -%}
              <figure class="sr-slide" role="listitem">
                <img src="{{ img | image_url: width: 1200 }}"
                     srcset="{{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1200 }} 1200w"
                     sizes="(min-width: 750px) 584px, 82vw"
                     width="1200" height="{{ 1200 | divided_by: img.aspect_ratio | round }}"
                     alt="{{ cap | strip_html | escape }}" loading="lazy">
                {%- if cap != blank -%}<figcaption>{{ cap }}</figcaption>{%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="sr-carousel__btn sr-carousel__btn--next" data-sr-next aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <div class="sr-dots" data-sr-dots aria-hidden="true"></div>

      <p class="sr-gallery__note sr-center">{{ s.gallery_note }}</p>
    </div>
  </section>

  {%- comment -%} ====================== WHAT YOU CAN COMPARE ====================== {%- endcomment -%}
  <section class="sr-section sr-compare">
    <div class="sr-container">
      <h2 class="sr-section__title sr-center">{{ s.compare_heading }}</h2>
      {%- if s.compare_disclosure != blank -%}
        <p class="sr-compare__disclosure">{{ s.compare_disclosure }}</p>
      {%- endif -%}
      <div class="sr-compare__grid">
        {%- for i in (1..4) -%}
          {%- liquid
            assign t_key = 'compare_title_' | append: i
            assign d_key = 'compare_text_' | append: i
            assign im_key = 'compare_image_' | append: i
            assign t = s[t_key]
            assign d = s[d_key]
            assign im = s[im_key]
          -%}
          {%- if t != blank -%}
            <div class="sr-compare__card">
              {%- if im != blank -%}
                <div class="sr-compare__media">
                  <img src="{{ im | image_url: width: 500 }}" alt="{{ t | strip_html | escape }}" loading="lazy">
                </div>
              {%- endif -%}
              <h3>{{ t }}</h3>
              <p>{{ d }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ====================== CHECK A MODEL FORM (side-by-side) ====================== {%- endcomment -%}
  <section class="sr-section sr-form-section{% if s.form_bg_image != blank %} has-bg{% endif %}" id="sr-check-model"
           {% if s.form_bg_image != blank %}style="--sr-form-bg: url('{{ s.form_bg_image | image_url: width: 2000 }}');"{% endif %}>
    <div class="sr-form-section__overlay"></div>
    <div class="sr-container sr-form-grid">
      <div class="sr-form-intro">
        <h2 class="sr-section__title">{{ s.form_heading }}</h2>
        <p class="sr-form-intro__sub">{{ s.form_subtext }}</p>
        <ul class="sr-form-intro__points">
          {%- if s.form_point_1 != blank -%}<li><span class="sr-ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>{{ s.form_point_1 }}</li>{%- endif -%}
          {%- if s.form_point_2 != blank -%}<li><span class="sr-ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>{{ s.form_point_2 }}</li>{%- endif -%}
        </ul>
      </div>

      <div class="sr-form-card" data-sr-form-card>
        {% form 'contact', id: 'ShowroomCheckModel', class: 'sr-form' %}
          {%- if form.posted_successfully? -%}
            <div class="sr-form-success" data-sr-success>
              <div class="sr-form-success__icon" aria-hidden="true">
                <svg viewBox="0 0 52 52" width="56" height="56"><circle cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M15 27l7 7 15-15"/></svg>
              </div>
              <h3>{{ s.success_heading }}</h3>
              <p>{{ s.success_text }}</p>
              <a class="sr-btn sr-btn--primary" href="{{ request.path }}#sr-check-model">{{ s.success_button_label }}</a>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="sr-form-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <input type="hidden" name="contact[form_type]" value="Benicia Showroom — Check a Model">
            <input type="hidden" name="contact[source_page]" value="{{ request.origin }}{{ request.path }}">

            <div class="sr-field">
              <label for="sr-name">Full name <span class="sr-req">*</span></label>
              <input type="text" id="sr-name" name="contact[name]" placeholder="John Doe" required>
            </div>

            <div class="sr-field-row">
              <div class="sr-field">
                <label for="sr-method">Preferred contact method <span class="sr-req">*</span></label>
                <select id="sr-method" name="contact[preferred_contact_method]" required data-sr-method>
                  <option value="" disabled selected>Select option</option>
                  <option value="Phone">Phone</option>
                  <option value="Email">Email</option>
                </select>
              </div>
              <div class="sr-field">
                <label for="sr-contact">Phone / Email <span class="sr-req">*</span></label>
                <input type="text" id="sr-contact" name="contact[phone_or_email]" placeholder="(925) 555-0100 / your@email.com" required data-sr-contact-value>
              </div>
            </div>

            <div class="sr-field">
              <label for="sr-model">Product name, model, or product page link <span class="sr-req">*</span></label>
              <input type="text" id="sr-model" name="contact[product_model]" placeholder="e.g. French Fitness FSR90" required>
            </div>

            <div class="sr-field">
              <label for="sr-visit">Preferred visit date or time <span class="sr-req">*</span></label>
              <input type="text" id="sr-visit" name="contact[preferred_visit]" placeholder="Select date" required
                     onfocus="(this.type='datetime-local')" onblur="if(!this.value){this.type='text'}">
            </div>

            <div class="sr-divider"></div>

            <div class="sr-field-row">
              <div class="sr-field">
                <label for="sr-zip">Delivery ZIP <span class="sr-opt">(optional)</span></label>
                <input type="text" id="sr-zip" name="contact[delivery_zip]" placeholder="94510" inputmode="numeric" pattern="[0-9]*">
              </div>
              <div class="sr-field">
                <label for="sr-use">Home or commercial use <span class="sr-opt">(optional)</span></label>
                <select id="sr-use" name="contact[use_type]">
                  <option value="" disabled selected>Select option</option>
                  <option value="Home">Home</option>
                  <option value="Commercial">Commercial</option>
                </select>
              </div>
            </div>

            <div class="sr-field">
              <label for="sr-compare">Anything specific you want to compare <span class="sr-opt">(optional)</span></label>
              <input type="text" id="sr-compare" name="contact[compare_notes]" placeholder="e.g. comparing to the FSR100">
            </div>

            <button type="submit" class="sr-btn sr-btn--primary sr-btn--block" data-sr-event="check_model_submit">
              {{ s.form_button_label }}
            </button>

            <p class="sr-form-fineprint">{{ s.form_fineprint }}</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </section>

  {%- comment -%} ====================== WHAT TO EXPECT ====================== {%- endcomment -%}
  <section class="sr-section sr-expect">
    <div class="sr-container sr-expect__grid">
      <div class="sr-expect__media">
        {%- if s.expect_image != blank -%}
          <img src="{{ s.expect_image | image_url: width: 1000 }}"
               srcset="{{ s.expect_image | image_url: width: 600 }} 600w, {{ s.expect_image | image_url: width: 1000 }} 1000w"
               sizes="(min-width: 750px) 608px, 100vw"
               width="1000" height="{{ 1000 | divided_by: s.expect_image.aspect_ratio | round }}"
               alt="{{ s.expect_image_alt | default: 'Inside the Benicia showroom floor' | escape }}" loading="lazy">
        {%- endif -%}
      </div>
      <div class="sr-expect__body">
        <h2 class="sr-section__title">{{ s.expect_heading }}</h2>
        <p class="sr-expect__lede">{{ s.expect_lede }}</p>
        <ul class="sr-expect__list">
          {%- for i in (1..7) -%}
            {%- assign k = 'expect_point_' | append: i -%}
            {%- if s[k] != blank -%}<li><span class="sr-dot"></span>{{ s[k] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ====================== VIDEO WALKTHROUGH ====================== {%- endcomment -%}
  <section class="sr-section sr-walkthrough">
    <div class="sr-container">
      <h2 class="sr-section__title sr-center">{{ s.walkthrough_heading }}</h2>
      <p class="sr-walkthrough__lede">{{ s.walkthrough_text }}</p>

      {%- if s.walkthrough_video_image != blank -%}
        <a class="sr-video" href="{{ s.walkthrough_video_url | default: s.walkthrough_url }}" target="_blank" rel="noopener" aria-label="Play the Factory Showroom Tour">
          <img src="{{ s.walkthrough_video_image | image_url: width: 1600 }}" alt="Factory Showroom Tour" loading="lazy" width="1280" height="720">
          <span class="sr-video__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </a>
      {%- endif -%}

      <div class="sr-walkthrough__cta">
        <a class="sr-btn sr-btn--primary" href="{{ s.walkthrough_url }}" data-sr-event="video_walkthrough_submit" data-sr-location="walkthrough">
          {{ s.walkthrough_button_label }}
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ====================== MAP / HOURS / DIRECTIONS ====================== {%- endcomment -%}
  <section class="sr-section sr-map">
    <div class="sr-container sr-map__grid">
      <div class="sr-map__embed">
        {{ s.map_embed }}
      </div>
      <div class="sr-map__details">
        <p class="sr-map__eyebrow">{{ s.map_eyebrow }}</p>
        <h2 class="sr-section__title">{{ s.map_heading }}</h2>
        <ul class="sr-map__list">
          {%- for i in (1..7) -%}
            {%- assign k = 'map_point_' | append: i -%}
            {%- if s[k] != blank -%}<li>{{ s[k] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="sr-map__ctas">
          <a class="sr-btn sr-btn--primary" href="tel:{{ phone_tel }}" data-sr-event="showroom_call_click" data-sr-location="map">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"/></svg>{{ s.map_call_label }}
          </a>
          <a class="sr-btn sr-btn--ghost" href="{{ s.directions_url }}" target="_blank" rel="noopener" data-sr-event="directions_click" data-sr-location="map">
            {{ s.cta_directions_label }}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
/* Full-width page wrapper (sidebar suppressed for this template) */
.showroom-fullwidth { display: block; width: 100%; }
.showroom-fullwidth > .inner-container { width: 100%; max-width: none; }

.sr-page {
  --sr-red: #d83d0e;
  --sr-red-dark: #b8330c;
  --sr-accent: #f1592a;
  --sr-ink: #23232b;
  --sr-muted: #393940;
  --sr-bg: #faf9f9;
  --sr-border: #e5e5e5;
  --sr-radius: 12px;
  --sr-head: 'Oswald', var(--font-heading-family, 'Oswald'), sans-serif;
  --sr-body: 'Lato', var(--font-body-family, 'Lato'), sans-serif;
  color: var(--sr-ink);
  font-family: var(--sr-body);
}
.sr-container { max-width: 1280px; margin: 0 auto; padding-inline: 20px; }
.sr-section { padding-block: 64px; }
.sr-center { text-align: center; }
.sr-section__title { font-family: var(--sr-head); font-size: clamp(28px, 3vw, 38px); line-height: 1.25; margin: 0 0 14px; font-weight: 600; text-transform: uppercase; color: var(--sr-ink); }
.sr-section__lede { max-width: 800px; margin: 0 0 28px; color: var(--sr-muted); font-size: 16px; }
.sr-center.sr-section__lede { margin-left: auto; margin-right: auto; }

/* Buttons */
.sr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; border-radius: 8px; font-family: var(--sr-body); font-weight: 700; font-size: 16px; text-decoration: none; cursor: pointer; border: 1.5px solid transparent; transition: background-color .15s ease, color .15s ease, border-color .15s ease; line-height: 1.5; }
.sr-btn svg { width: 20px; height: 20px; flex: none; }
.sr-btn--primary { background: var(--sr-red); color: #fff; }
.sr-btn--primary:hover { background: var(--sr-red-dark); color: #fff; }
.sr-btn--secondary { background: var(--sr-ink); color: #fff; }
.sr-btn--secondary:hover { background: #000; color: #fff; }
.sr-btn--ghost { background: transparent; color: var(--sr-ink); border-color: var(--sr-ink); }
.sr-btn--ghost:hover { background: var(--sr-ink); color: #fff; }
.sr-btn--link { background: transparent; color: var(--sr-accent); border-color: transparent; padding-inline: 8px; }
.sr-btn--link:hover { color: var(--sr-red-dark); }
.sr-btn--block { width: 100%; }

/* Hero */
.sr-hero { position: relative; color: #fff; background: #1c1c22 var(--sr-hero-image) center/cover no-repeat; }
.sr-hero__overlay { position: absolute; inset: 0; background: linear-gradient(270deg, rgba(35,35,43,0) 0%, #1C1C23 72.47%); }
.sr-hero__inner { position: relative; padding: 80px 20px 60px; max-width: 1280px; }
.sr-hero__title { position: relative; font-family: var(--sr-head); font-size: clamp(30px, 4vw, 48px); line-height: 1.18; font-weight: 500; text-transform: uppercase; margin: 0 0 30px; max-width: 700px; color: #fff; }
.sr-hero__title::after { content: ""; position: absolute; left: 0; bottom: -14px; width: 180px; height: 4px; background: var(--sr-accent); }
.sr-hero__text { max-width: 640px; font-size: 16px; line-height: 1.55; margin: 0 0 22px; color: #cccccc; }
.sr-hero__meta { list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-wrap: wrap; gap: 10px 28px; }
.sr-hero__meta li { display: flex; align-items: center; gap: 8px; font-weight: 700; color: #f2f2f2; }
.sr-hero__meta svg { width: 18px; height: 18px; flex: none; }
.sr-hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.sr-hero .sr-btn--secondary { background: #fff; color: var(--sr-ink); border-color: #d3d9e5; }
.sr-hero .sr-btn--secondary:hover { background: #f2f2f2; color: var(--sr-ink); }
.sr-hero .sr-btn--link { color: var(--sr-accent); }
.sr-hero .sr-btn--link:hover { color: #fff; }

/* Carousel */
.sr-carousel { position: relative; }
.sr-carousel__track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 0 8px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.sr-carousel__track::-webkit-scrollbar { display: none; }
.sr-slide { position: relative; flex: 0 0 auto; width: min(584px, 82vw); aspect-ratio: 16 / 11; border-radius: var(--sr-radius); overflow: hidden; scroll-snap-align: center; margin: 0; background: #eee; }
.sr-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sr-slide figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 18px 16px; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.65) 100%); color: #fff; font-size: 14px; font-weight: 700; }
.sr-carousel__btn { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%; background: #fff; border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,.18); z-index: 2; }
.sr-carousel__btn--prev { left: 10px; } .sr-carousel__btn--next { right: 10px; }
.sr-carousel__btn svg { width: 22px; height: 22px; color: var(--sr-accent); }
.sr-dots { display: flex; justify-content: center; gap: 6px; margin-top: 20px; }
.sr-dots button { width: 12px; height: 12px; border-radius: 50%; border: 0; background: var(--sr-ink); opacity: .2; cursor: pointer; padding: 0; }
.sr-dots button[aria-current="true"] { opacity: 1; }
.sr-gallery__note { margin: 22px auto 0; font-size: 14px; color: #808080; font-style: italic; }

/* Compare */
.sr-compare { background: var(--sr-bg); }
.sr-compare__disclosure { margin: -4px auto 28px; font-weight: 600; color: var(--sr-red-dark); text-align: center; max-width: 800px; }
.sr-compare__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.sr-compare__card { background: #fff; border: 1px solid var(--sr-border); border-radius: var(--sr-radius); padding: 32px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; }
.sr-compare__media { width: 100%; aspect-ratio: 247 / 260; margin-bottom: 18px; display: flex; align-items: center; justify-content: center; }
.sr-compare__media img { max-width: 100%; max-height: 100%; object-fit: contain; }
.sr-compare__card h3 { font-family: var(--sr-body); margin: 0 0 10px; font-size: 20px; line-height: 1.3; color: #000; }
.sr-compare__card p { margin: 0; color: var(--sr-muted); font-size: 16px; }

/* Form (side-by-side over background) */
.sr-form-section { position: relative; background: var(--sr-ink); }
.sr-form-section.has-bg { background: var(--sr-ink) var(--sr-form-bg) center/cover no-repeat; }
.sr-form-section__overlay { position: absolute; inset: 0; background: linear-gradient(136.3deg, rgba(0,0,0,.8) 0%, rgba(0,0,0,0) 75.57%); }
.sr-form-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.sr-form-intro { color: #fff; }
.sr-form-intro .sr-section__title { color: #fff; }
.sr-form-intro__sub { color: #cccccc; margin: 12px 0 22px; font-size: 16px; max-width: 520px; }
.sr-form-intro__points { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.sr-form-intro__points li { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 700; font-size: 16px; }
.sr-form-intro__points .sr-ck { width: 20px; height: 20px; border-radius: 50%; background: var(--sr-accent); display: inline-flex; align-items: center; justify-content: center; flex: none; }
.sr-form-intro__points .sr-ck svg { width: 12px; height: 12px; color: #fff; }
.sr-form-card { background: #fff; border-radius: var(--sr-radius); padding: 32px; box-shadow: 0 10px 40px rgba(126,126,126,.12); }
.sr-field { margin-bottom: 16px; }
.sr-field label { display: block; font-size: 12px; color: var(--sr-muted); margin-bottom: 6px; }
.sr-field input, .sr-field select { width: 100%; padding: 12px 14px; border: 1.5px solid var(--sr-border); border-radius: 8px; font-size: 16px; font-family: var(--sr-body); background: #fff; color: var(--sr-ink); }
.sr-field input:focus, .sr-field select:focus { outline: 2px solid var(--sr-accent); outline-offset: 1px; border-color: var(--sr-accent); }
.sr-field input::placeholder { color: #b3b3b3; }
.sr-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.sr-divider { height: 1px; background: var(--sr-border); margin: 4px 0 16px; }
.sr-req { color: var(--sr-red); }
.sr-opt { color: #b3b3b3; }
.sr-form-fineprint { margin: 14px 0 0; font-size: 14px; font-style: italic; color: #808080; }
.sr-form-errors { background: #fdecea; border: 1px solid #f5c6c0; color: #a12a1a; padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; font-size: 14px; }
.sr-form-success { text-align: center; padding: 30px 10px; }
.sr-form-success__icon { color: var(--sr-accent); margin-bottom: 10px; }
.sr-form-success h3 { font-family: var(--sr-head); text-transform: uppercase; margin: 0 0 10px; font-size: 24px; }
.sr-form-success p { margin: 0 auto 22px; max-width: 460px; color: var(--sr-muted); }

/* Expect */
.sr-expect { background: var(--sr-bg); }
.sr-expect__grid { display: grid; grid-template-columns: 608px 1fr; gap: 44px; align-items: center; }
.sr-expect__media img { width: 100%; border-radius: var(--sr-radius); display: block; }
.sr-expect__lede { font-weight: 400; color: #4f4f55; margin: 0 0 16px; }
.sr-expect__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.sr-expect__list li { display: flex; align-items: flex-start; gap: 10px; color: var(--sr-muted); }
.sr-expect__list .sr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sr-accent); flex: none; margin-top: 8px; }

/* Walkthrough */
.sr-walkthrough { background: var(--sr-ink); color: #fff; }
.sr-walkthrough .sr-section__title { color: #fff; }
.sr-walkthrough__lede { color: #b3b3b3; text-align: center; max-width: 880px; margin: 0 auto 28px; font-size: 16px; }
.sr-video { position: relative; display: block; border-radius: var(--sr-radius); overflow: hidden; aspect-ratio: 16 / 9; max-width: 1280px; margin: 0 auto; }
.sr-video img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sr-video__play { position: absolute; inset: 0; margin: auto; width: 100px; height: 100px; border-radius: 50%; background: rgba(35,35,43,.3); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; }
.sr-video__play svg { width: 44px; height: 44px; color: #fff; }
.sr-walkthrough__cta { text-align: center; margin-top: 28px; }

/* Map */
.sr-map__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.sr-map__embed { border-radius: var(--sr-radius); overflow: hidden; min-height: 320px; }
.sr-map__embed iframe { width: 100%; min-height: 400px; border: 0; display: block; }
.sr-map__eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: 13px; font-weight: 700; color: var(--sr-accent); margin: 0 0 6px; }
.sr-map__list { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
.sr-map__list li { position: relative; padding-left: 20px; color: var(--sr-muted); }
.sr-map__list li::before { content: ""; position: absolute; left: 4px; top: 9px; width: 6px; height: 6px; border-radius: 50%; background: var(--sr-accent); }
.sr-map__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

/* Responsive */
@media (max-width: 990px) {
  .sr-compare__grid { grid-template-columns: repeat(2, 1fr); }
  .sr-form-grid { grid-template-columns: 1fr; gap: 28px; }
  .sr-expect__grid { grid-template-columns: 1fr; gap: 26px; }
  .sr-map__grid { grid-template-columns: 1fr; gap: 24px; }
}
@media (max-width: 749px) {
  .sr-section { padding-block: 44px; }
  .sr-hero__inner { padding: 56px 20px 44px; }
  .sr-hero__ctas .sr-btn { flex: 1 1 100%; }
  .sr-compare__grid { grid-template-columns: 1fr; }
  .sr-field-row { grid-template-columns: 1fr; }
  .sr-form-card { padding: 24px 18px; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function push(name, extra) {
    window.dataLayer = window.dataLayer || [];
    var payload = { event: name };
    if (extra) { for (var k in extra) { if (extra.hasOwnProperty(k)) payload[k] = extra[k]; } }
    window.dataLayer.push(payload);
  }

  // Click-based events (call, directions, video walkthrough)
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-sr-event]');
    if (!el) return;
    var name = el.getAttribute('data-sr-event');
    if (name === 'check_model_submit') return; // handled on form submit
    push(name, { location: el.getAttribute('data-sr-location') || '' });
  });

  // Form submit event + contact-method input typing
  var form = document.getElementById('ShowroomCheckModel');
  if (form) {
    form.addEventListener('submit', function () { push('check_model_submit', { location: 'check_model_form' }); });
    var method = form.querySelector('[data-sr-method]');
    var value = form.querySelector('[data-sr-contact-value]');
    if (method && value) {
      method.addEventListener('change', function () {
        if (method.value === 'Email') { value.type = 'email'; value.placeholder = 'your@email.com'; }
        else if (method.value === 'Phone') { value.type = 'tel'; value.placeholder = '(925) 555-0100'; }
      });
    }
  }

  // Gallery carousel: arrows + dots
  document.querySelectorAll('[data-sr-carousel]').forEach(function (root) {
    var track = root.querySelector('[data-sr-track]');
    var slides = track ? Array.prototype.slice.call(track.querySelectorAll('.sr-slide')) : [];
    if (!track || slides.length === 0) return;
    var dotsWrap = root.parentNode.querySelector('[data-sr-dots]');
    var prev = root.querySelector('[data-sr-prev]');
    var next = root.querySelector('[data-sr-next]');

    function step() { return slides[0].offsetWidth + 16; }
    function current() { return Math.round(track.scrollLeft / step()); }
    function go(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: i * step(), behavior: 'smooth' });
    }
    if (prev) prev.addEventListener('click', function () { go(current() - 1); });
    if (next) next.addEventListener('click', function () { go(current() + 1); });

    var dots = [];
    if (dotsWrap) {
      slides.forEach(function (_, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Go to photo ' + (i + 1));
        if (i === 0) b.setAttribute('aria-current', 'true');
        b.addEventListener('click', function () { go(i); });
        dotsWrap.appendChild(b);
        dots.push(b);
      });
      var raf;
      track.addEventListener('scroll', function () {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = null;
          var c = current();
          dots.forEach(function (d, i) {
            if (i === c) { d.setAttribute('aria-current', 'true'); }
            else { d.removeAttribute('aria-current'); }
          });
        });
      });
    }
  });
})();
{% endjavascript %}

