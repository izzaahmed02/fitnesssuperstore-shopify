{%- assign list_items = section.blocks | where: 'type', 'list_item' -%}
{%- assign bottom_note_blocks = section.blocks | where: 'type', 'bottom_note' -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 24 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 24 }}px;
  }

  #shopify-section-{{ section.id }} .itl-trusthub__inner {
    max-width: 1044px;
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .itl-trusthub__block {
    max-width: 1012px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'section-image-text-list-trusthub.css' | asset_url | stylesheet_tag }}

<div class="itl-trusthub section-{{ section.id }}-padding">
  <div class="itl-trusthub__inner">
    {%- if section.settings.heading != blank -%}
      <div class="itl-trusthub__title">
        <h2 class="itl-trusthub__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="itl-trusthub__block">
      <div class="itl-trusthub__row itl-trusthub__row--{{ section.settings.layout }}">
        {%- if section.settings.image != blank -%}
          <div class="itl-trusthub__media">
            {%- capture sizes -%}
              (min-width: 1044px) 465px,
              (min-width: 750px) calc((100vw - 64px) / 2),
              calc(100vw - 32px)
            {%- endcapture -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                sizes: sizes,
                widths: '343, 465, 686, 930, 1500',
                class: 'itl-trusthub__image'
            }}
          </div>
        {%- endif -%}

        <div class="itl-trusthub__text">
          {%- if section.settings.text != blank -%}
            <div class="itl-trusthub__description rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- if list_items.size > 0 -%}
            <ul class="itl-trusthub__list" role="list">
              {%- for block in list_items -%}
                {%- if block.settings.text != blank -%}
                  <li class="itl-trusthub__list-item" {{ block.shopify_attributes }}>
                    <span class="itl-trusthub__check" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="itl-trusthub__list-text">{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if bottom_note_blocks.size > 0 -%}
            {%- for block in bottom_note_blocks -%}
              {%- if block.settings.text != blank -%}
                <div class="itl-trusthub__note" {{ block.shopify_attributes }}>
                  <span class="itl-trusthub__note-icon" aria-hidden="true" style="color: {{ block.settings.icon_color | default: '#D12E06' }};">
                    {%- case block.settings.icon -%}
                      {%- when 'star' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {%- when 'shield' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {%- when 'truck' -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M1 3H15V16H1V3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M15 8H19L23 12V16H15V8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="5.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                      {%- else -%}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/>
                          <path d="M12 7V12L15 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    {%- endcase -%}
                  </span>
                  <div class="itl-trusthub__note-text rte">{{ block.settings.text }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Text List Trust Hub",
  "class": "section image-text-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "adapt",
      "label": "Image height"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "label": "Image placement",
      "info": "Image first is the default mobile layout."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "Make section full width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "From delivery to long-term support",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Your purchase is just the beginning of our relationship. From the moment you place your order through years of use, our goal is to make your experience seamless.</p>",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_style",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subtitle", "label": "Subtitle" }
      ],
      "default": "body",
      "label": "Text style"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to hide button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use outline button style"
    },
    {
      "type": "header",
      "content": "Bottom note settings"
    },
    {
      "type": "range",
      "id": "bottom_note_margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom note top margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "bottom_note_padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom note top padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "bottom_note_border_top",
      "default": false,
      "label": "Show border above bottom note"
    },
    {
      "type": "range",
      "id": "bottom_icon_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom note icon size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Order confirmation and communication",
          "label": "List item text"
        }
      ]
    },
    {
      "type": "bottom_note",
      "name": "Bottom note",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "clock"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#D12E06"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bottom note text",
          "default": "<p><strong>French Fitness:</strong> 10-year parts + 1-year labor. <strong>Remanufactured:</strong> 1-year parts &amp; labor, extendable up to 5 years.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Text List Trust Hub",
      "blocks": [
        { "type": "list_item", "settings": { "text": "Order confirmation and communication" } },
        { "type": "list_item", "settings": { "text": "Delivery options (curbside, garage, room-of-choice, assembly)" } },
        { "type": "list_item", "settings": { "text": "Installation and setup" } },
        { "type": "list_item", "settings": { "text": "Warranty coverage and how claims work" } },
        { "type": "list_item", "settings": { "text": "Ongoing service support and tech dispatch" } },
        {
          "type": "bottom_note",
          "settings": {
            "icon": "clock",
            "icon_color": "#D12E06",
            "text": "<p><strong>French Fitness:</strong> 10-year parts + 1-year labor. <strong>Remanufactured:</strong> 1-year parts &amp; labor, extendable up to 5 years.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
