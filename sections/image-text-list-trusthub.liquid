{% comment %}
  Section: Image with Text + List + Bottom Note
  Based on Dawn theme image-with-text pattern with extended schema support
{% endcomment %}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

   .image-text-list .image-with-text__heading {
    font-size: 28px;
    line-height: 34px;
    margin: 0px;
    margin-bottom: 4px;
    text-align: left;
    padding: 0 16px;
  }
}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
      .image-text-list .image-with-text__heading {
    font-size: 38px;
    line-height: 50px;
    margin: 0px;
    margin-bottom: 28px;
  }
  }

  .image-text-list .grid {
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin: 0px;
    padding: 16px;
  }

  .image-text-list .image-with-text__grid--reverse .image-with-text__media-item {
    padding: 0px;
  }

  .image-with-text-list__check-icon {
    flex-shrink: 0;
    width: 18px;
    height: 14px;
    margin-top: 2px;
  }

  .image-with-text-list__list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }

  .image-with-text-list__list-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .image-with-text-list__list-item:last-child {
    margin-bottom: 0;
  }

  .image-with-text-list__bottom-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: {{ section.settings.bottom_note_margin_top }}px;
    padding-top: {{ section.settings.bottom_note_padding_top }}px;
    {% if section.settings.bottom_note_border_top %}
      border-top: 1px solid rgba(0,0,0,0.1);
    {% endif %}
    font-size: 18px;
    line-height: 24px;
    justify-content: center;
  }



  .image-with-text-list__bottom-note-icon {
    flex-shrink: 0;
    width: {{ section.settings.bottom_icon_size }}px;
    height: {{ section.settings.bottom_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text-list__bottom-note-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Fixed 465x280 aspect ratio for the image container */
  .image-with-text__media--fixed-ratio {
    position: relative;
    width: 100%;
    padding-bottom: calc(280 / 465 * 100%); /* = 60.215% */
    overflow: hidden;
  }

  .image-with-text__media--fixed-ratio img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{%- endstyle -%}

<div class="image-with-text isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding">
     
    {%- if section.settings.heading != blank -%}
          <h2 class="center image-with-text__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

  <div class="image-with-text__grid grid grid--gapless grid--1-col{% if section.settings.layout == 'image_first' %} image-with-text__grid--reverse{% endif %}{% if section.settings.image != blank %} grid--2-col-tablet{% else %} grid--1-col{% endif %}">

    {%- if section.settings.image != blank -%}
      <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.layout }} grid__item">
        <div class="image-with-text__media global-media-settings global-media-settings--no-shadow image-with-text__media--fixed-ratio">
          {%- capture sizes -%}
            (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
            (min-width: 750px) calc(100vw / 2 - 4rem),
            100vw
          {%- endcapture -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              sizes: sizes,
              widths: '165, 360, 465, 535, 750, 930, 1070, 1500'
          }}
        </div>
      </div>
    {%- endif -%}

    <div class="image-with-text__text-item grid__item">
      <div id="ImageWithText--{{ section.id }}" class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--{{ section.settings.height }} content-container">

        {%- if section.settings.caption != blank -%}
          <p class="image-with-text__text image-with-text__text--caption caption-with-letter-spacing">
            {{ section.settings.caption | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte {{ section.settings.text_style }}">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          {%- assign list_items = section.blocks | where: 'type', 'list_item' -%}
          {%- if list_items.size > 0 -%}
            <ul class="image-with-text-list__list" role="list">
              {%- for block in list_items -%}
                {%- if block.settings.text != blank -%}
                  <li class="image-with-text-list__list-item" {{ block.shopify_attributes }}>
                    <svg class="image-with-text-list__check-icon" width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M16.1972 0.243074C16.4771 -0.0621776 16.9515 -0.0826888 17.2568 0.197176C17.562 0.47708 17.5825 0.951436 17.3027 1.25675L6.30268 13.2567C6.16452 13.4074 5.97091 13.4954 5.76654 13.4999C5.56203 13.5044 5.36432 13.4248 5.21967 13.2802L0.219669 8.28018C-0.0732222 7.98729 -0.0732237 7.51253 0.219669 7.21964C0.512561 6.92675 0.987323 6.92675 1.28022 7.21964L5.72553 11.6649L16.1972 0.243074Z" fill="currentColor"/>
                    </svg>
                    <span>{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>
    </div>

  </div>

  {%- assign bottom_note_blocks = section.blocks | where: 'type', 'bottom_note' -%}
  {%- if bottom_note_blocks.size > 0 -%}
    {%- for block in bottom_note_blocks -%}
      {%- if block.settings.text != blank -%}
        <div class="image-with-text-list__bottom-note" {{ block.shopify_attributes }}>
          {%- if block.settings.icon == 'clock' -%}
            <div class="image-with-text-list__bottom-note-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="{{ block.settings.icon_color }}" stroke-width="1.8"/>
                <path d="M12 7V12L15 14.5" stroke="{{ block.settings.icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- elsif block.settings.icon == 'star' -%}
            <div class="image-with-text-list__bottom-note-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="{{ block.settings.icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- elsif block.settings.icon == 'shield' -%}
            <div class="image-with-text-list__bottom-note-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="{{ block.settings.icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- elsif block.settings.icon == 'truck' -%}
            <div class="image-with-text-list__bottom-note-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1 3H15V16H1V3Z" stroke="{{ block.settings.icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M15 8H19L23 12V16H15V8Z" stroke="{{ block.settings.icon_color }}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="5.5" cy="18.5" r="2.5" stroke="{{ block.settings.icon_color }}" stroke-width="1.8"/>
                <circle cx="18.5" cy="18.5" r="2.5" stroke="{{ block.settings.icon_color }}" stroke-width="1.8"/>
              </svg>
            </div>
          {%- endif -%}
          <div class="image-with-text-list__bottom-note-text">
            {{ block.settings.text }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Image Text List Trust Hub",
  "class": "section image-text-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "adapt",
      "label": "Image height"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "label": "Image placement",
      "info": "Image first is the default mobile layout."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "Make section full width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "From delivery to long-term support",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Your purchase is just the beginning of our relationship. From the moment you place your order through years of use, our goal is to make your experience seamless.</p>",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_style",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subtitle", "label": "Subtitle" }
      ],
      "default": "body",
      "label": "Text style"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to hide button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use outline button style"
    },
    {
      "type": "header",
      "content": "Bottom note settings"
    },
    {
      "type": "range",
      "id": "bottom_note_margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom note top margin",
      "default": 32
    },
    {
      "type": "range",
      "id": "bottom_note_padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom note top padding",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "bottom_note_border_top",
      "default": false,
      "label": "Show border above bottom note"
    },
    {
      "type": "range",
      "id": "bottom_icon_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom note icon size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Order confirmation and communication",
          "label": "List item text"
        }
      ]
    },
    {
      "type": "bottom_note",
      "name": "Bottom note",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "clock"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#E07B39"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bottom note text",
          "default": "<p><strong>French Fitness:</strong> 10-year parts + 1-year labor. <strong>Remanufactured:</strong> 1-year parts &amp; labor, extendable up to 5 years.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Text List Trust Hub",
      "blocks": [
        {
          "type": "list_item",
          "settings": { "text": "Order confirmation and communication" }
        },
        {
          "type": "list_item",
          "settings": { "text": "Delivery options (curbside, garage, room-of-choice, assembly)" }
        },
        {
          "type": "list_item",
          "settings": { "text": "Installation and setup" }
        },
        {
          "type": "list_item",
          "settings": { "text": "Warranty coverage and how claims work" }
        },
        {
          "type": "list_item",
          "settings": { "text": "Ongoing service support and tech dispatch" }
        },
        {
          "type": "bottom_note",
          "settings": {
            "icon": "clock",
            "icon_color": "#E07B39",
            "text": "<p><strong>French Fitness:</strong> 10-year parts + 1-year labor. <strong>Remanufactured:</strong> 1-year parts &amp; labor, extendable up to 5 years.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}