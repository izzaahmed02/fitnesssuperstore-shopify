{% schema %}
{
  "name": "Video Carousel",
  "settings": [
    {
      "type": "select",
      "id": "videos_per_row",
      "label": "Videos per row",
      "default": "3",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" },
        { "label": "4", "value": "4" },
        { "label": "5", "value": "5" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (YouTube or uploaded file URL)",
          "info": "Paste a YouTube link or a video file URL uploaded via Shopify Admin > Content > Files"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Video Carousel"
    }
  ]
}
{% endschema %}

<div class="video-carousel-section videos-per-{{ section.settings.videos_per_row }}">
  <div class="carousel-wrapper">
    <div class="carousel" id="videoCarousel">
      {% for block in section.blocks %}
        {% assign video_url = block.settings.video_url %}
        <div class="carousel-item">
          <div class="video-thumbnail" data-video-url="{{ video_url }}">
            <img src="{{ block.settings.thumbnail | image_url: width: 400 }}" alt="Video Thumbnail">
            <div class="play-button">&#9658;</div>
          </div>
        </div>
      {% endfor %}
    </div>
    <button class="carousel-nav prev" onclick="prevSlide()">&#10094;</button>
    <button class="carousel-nav next" onclick="nextSlide()">&#10095;</button>
  </div>

  <div class="video-modal" id="videoModal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeModal()">&times;</span>
      <div id="modalVideoContainer"></div>
    </div>
  </div>
</div>

<style>
.video-carousel-section {
  text-align: center;
  padding: 20px;
}
.carousel-wrapper {
  position: relative;
}
.carousel {
  display: flex;
  overflow: hidden;
  gap: 20px;
  transition: transform 0.5s ease;
}
.carousel-item {
  flex: 0 0 auto;
  width: calc(100% / var(--videos-per-row) - 20px);
}
.video-thumbnail {
  position: relative;
  cursor: pointer;
}
.video-thumbnail img {
  border-radius: 12px;
  width: 100%;
}
.play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48px;
  color: white;
  background: rgba(0, 0, 0, 0.6);
  padding: 10px 20px;
  border-radius: 50%;
}
.video-modal {
  display: none;
  position: fixed;
  z-index: 1000;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.8);
}
.modal-content {
  position: relative;
  width: 80%;
  max-width: 900px;
  margin: 60px auto;
  background: #fff;
  padding: 20px;
}
.modal-content iframe,
.modal-content video {
  width: 100%;
  height: 500px;
}
.close-modal {
  position: absolute;
  top: 10px;
  right: 20px;
  font-size: 28px;
  cursor: pointer;
}

/* Dynamic grid support */
.video-carousel-section.videos-per-1 { --videos-per-row: 1; }
.video-carousel-section.videos-per-2 { --videos-per-row: 2; }
.video-carousel-section.videos-per-3 { --videos-per-row: 3; }
.video-carousel-section.videos-per-4 { --videos-per-row: 4; }
.video-carousel-section.videos-per-5 { --videos-per-row: 5; }
</style>

<script>
let currentSlide = 0;

function updateCarousel() {
  const carousel = document.getElementById('videoCarousel');
  const items = carousel.querySelectorAll('.carousel-item');
  const itemWidth = items[0].offsetWidth + 20; // includes gap
  carousel.style.transform = `translateX(-${currentSlide * itemWidth}px)`;
}

function prevSlide() {
  const items = document.querySelectorAll('.carousel-item');
  currentSlide = Math.max(currentSlide - 1, 0);
  updateCarousel();
}

function nextSlide() {
  const items = document.querySelectorAll('.carousel-item');
  const visibleCount = parseInt(getComputedStyle(document.querySelector('.video-carousel-section')).getPropertyValue('--videos-per-row'));
  const maxSlide = items.length - visibleCount;
  currentSlide = Math.min(currentSlide + 1, maxSlide);
  updateCarousel();
}

function closeModal() {
  const modal = document.getElementById('videoModal');
  const container = document.getElementById('modalVideoContainer');
  container.innerHTML = '';
  modal.style.display = 'none';
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.video-thumbnail').forEach(thumbnail => {
    thumbnail.addEventListener('click', () => {
      const videoUrl = thumbnail.getAttribute('data-video-url');
      const modal = document.getElementById('videoModal');
      const container = document.getElementById('modalVideoContainer');

      let embed;
      if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
        const id = videoUrl.split(/v=|\/([^\/\?]+)$/).filter(Boolean).pop();
        embed = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
      } else {
        embed = `<video controls autoplay src="${videoUrl}"></video>`;
      }

      container.innerHTML = embed;
      modal.style.display = 'block';
    });
  });
});
</script>
