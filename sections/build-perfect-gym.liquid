<style>
.build-perfect-gym {
  padding: 40px 15px;
  text-align: center;
}

.build-perfect-gym-container {
  margin: 0 auto;
  background-color: #EDEFF3;
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44px 113px;
}

.build-perfect-gym-title {
  font-weight: 600;
  color: #000000;
  margin-top: 0;
  margin-bottom: 16px;
  font-family: 'Oswald', sans-serif;
  font-style: normal;
  text-transform: uppercase;
  letter-spacing: 0px;
  text-align: center;
  vertical-align: middle;
}

.build-perfect-gym-description {
  color: #393940;
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  font-style: normal;
  letter-spacing: 0px;
  text-align: center;
  margin: 0;
  width: 100%;
  padding-bottom: 32px;
}

.build-perfect-gym-button {
  display: inline-block;
  padding: 12px 24px;
  background-color: #D83D0E;
  color: #FFFFFF;
  border-radius: 8px;
  font-size: 16px;
  line-height: 24px;
  transition: all 0.3s ease;
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  height: 48px;
  cursor: pointer;
}

@media (max-width: 768px) {
  .build-perfect-gym {
    padding: 24px 16px;
  }
  
  .build-perfect-gym-container {
    padding: 24px 20px;
    border-radius: 20px;
    min-height: 250px;
  }
  
  .build-perfect-gym-title {
  
    margin-bottom: 20px;
  }
  
  .build-perfect-gym-description {
    font-size: 14px;
    line-height: 14px;
    padding-bottom: 20px;
  }
  
  .build-perfect-gym-button {
    font-size: 14px;
  }
}
</style>

<section class="build-perfect-gym">
  <div class="build-perfect-gym-container">
    {% if section.settings.title != blank %}
      <h2 class="build-perfect-gym-title">{{ section.settings.title }}</h2>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <p class="build-perfect-gym-description">{{ section.settings.description }}</p>
    {% endif %}
    
    {% if section.settings.button_text != blank and section.settings.button_url != blank %}
      <a href="{{ section.settings.button_url }}" class="button button--secondary">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Build Perfect Gym CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "READY TO BUILD YOUR PERFECT GYM?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our team of experts is ready to help you bring your vision to life."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Contact Our Design Team"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#23232B"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#393940"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#D83D0E"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#e55a2e"
    }
  ],
  "presets": [
    {
      "name": "Build Perfect Gym CTA"
    }
  ]
}
{% endschema %} 