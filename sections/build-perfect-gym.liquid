<style>
.build-perfect-gym { padding: 40px 15px; text-align: center; }
.build-perfect-gym-container { margin: 0 auto; background-color: #EDEFF3; border-radius: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 44px 80px; }
.build-perfect-gym-title { font-weight: 600; color: #000; margin: 0 0 16px; font-family: Oswald, sans-serif; text-transform: uppercase; text-align: center; }
.build-perfect-gym-description { color: #393940; font-family: Lato, sans-serif; font-weight: 400; text-align: center; margin: 0; width: 100%; padding-bottom: 24px; }
.build-perfect-gym-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
.build-perfect-gym-actions .button { min-width: 220px; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; text-align: center; padding: 12px 24px; }
.build-perfect-gym-disclaimer { max-width: 820px; margin: 16px 0 0; font-size: 13px; line-height: 19px; color: #56565e; }
@media (max-width: 768px) {
  .build-perfect-gym { padding: 24px 16px; }
  .build-perfect-gym-container { padding: 24px 20px; border-radius: 20px; min-height: 250px; }
  .build-perfect-gym-title { margin-bottom: 20px; }
  .build-perfect-gym-description { font-size: 14px; line-height: 20px; padding-bottom: 20px; }
  .build-perfect-gym-actions { width: 100%; flex-direction: column; }
  .build-perfect-gym-actions .button { width: 100%; min-width: 0; }
  .build-perfect-gym-disclaimer { text-align: left; }
}
</style>
<section class="build-perfect-gym">
  <div class="build-perfect-gym-container">
    {% if section.settings.title != blank %}<h2 class="build-perfect-gym-title">{{ section.settings.title }}</h2>{% endif %}
    {% if section.settings.description != blank %}<p class="build-perfect-gym-description">{{ section.settings.description }}</p>{% endif %}
    <div class="build-perfect-gym-actions">
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}<a href="{{ section.settings.button_url }}" class="button" data-gym-designer-action="quote">{{ section.settings.button_text }}</a>{% endif %}
      {% if section.settings.secondary_button_text != blank and section.settings.secondary_button_url != blank %}<a href="{{ section.settings.secondary_button_url }}" class="button button--secondary" data-gym-designer-action="planner">{{ section.settings.secondary_button_text }}</a>{% endif %}
    </div>
    {% if section.settings.disclaimer != blank %}<p class="build-perfect-gym-disclaimer">{{ section.settings.disclaimer }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Build Perfect Gym CTA","tag":"section","class":"section",
  "settings":[
    {"type":"text","id":"title","label":"Section Title","default":"READY TO BUILD YOUR PERFECT GYM?"},
    {"type":"textarea","id":"description","label":"Description","default":"Our team of experts is ready to help you bring your vision to life."},
    {"type":"text","id":"button_text","label":"Primary Button Text","default":"Contact Our Design Team"},
    {"type":"url","id":"button_url","label":"Primary Button URL"},
    {"type":"text","id":"secondary_button_text","label":"Secondary Button Text"},
    {"type":"url","id":"secondary_button_url","label":"Secondary Button URL"},
    {"type":"textarea","id":"disclaimer","label":"Planner Disclosure"},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F8F8F8"},
    {"type":"color","id":"title_color","label":"Title Color","default":"#23232B"},
    {"type":"color","id":"description_color","label":"Description Color","default":"#393940"},
    {"type":"color","id":"button_bg_color","label":"Button Background Color","default":"#D83D0E"},
    {"type":"color","id":"button_text_color","label":"Button Text Color","default":"#FFFFFF"},
    {"type":"color","id":"button_hover_color","label":"Button Hover Color","default":"#e55a2e"}
  ],
  "presets":[{"name":"Build Perfect Gym CTA"}]
}
{% endschema %}
