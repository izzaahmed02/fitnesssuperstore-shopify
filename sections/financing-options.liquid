<section class="financing-options" style="background: {{ section.settings.bg_color }};">
  <div class="page-width financing-options__wrapper">

    {% for block in section.blocks %}

      {% case block.type %}

      {% when 'full_width' %}
      <div class="financing-card financing-card--full">

        {% if block.settings.title != blank %}
        <h2 class="financing-card__title">{{ block.settings.title }}</h2>
        {% endif %}

        <div class="financing-full__inner">

          <div class="financing-full__item">
            {% if block.settings.logo_1 %}
              <img src="{{ block.settings.logo_1 | image_url }}" alt="">
            {% endif %}
            <p>{{ block.settings.text_1 }}</p>
          </div>

          <div class="financing-full__divider"></div>

          <div class="financing-full__item">
            {% if block.settings.logo_2 %}
              <img src="{{ block.settings.logo_2 | image_url }}" alt="">
            {% endif %}
            <p>{{ block.settings.text_2 }}</p>
          </div>

        </div>
      </div>


      {% when 'half_width' %}

      <div class="financing-card financing-card--half">

        {% if block.settings.title != blank %}
        <h3 class="financing-card__title">{{ block.settings.title }}</h3>
        {% endif %}

        <div class="financing-half__content">

          {% if block.settings.logo %}
          <img src="{{ block.settings.logo | image_url }}" alt="">
          {% endif %}

          <p>{{ block.settings.text }}</p>

        </div>

      </div>

      {% endcase %}

    {% endfor %}

  </div>
</section>


<style>

.financing-options{
  padding:60px 0;
}

.financing-options__wrapper{
  display:flex;
  flex-wrap:wrap;
  gap:16px;
}

/* Cards */

.financing-card{
  background:#fff;
  border:1px solid #e5e5e5;
  border-radius:12px;
  padding:20px 24px;
  width:100%;
  box-sizing:border-box;
}

.financing-card__title{
  font-size:22px;
  margin-bottom:16px;
}

/* Full width block */

.financing-card--full{
  width:100%;
}

.financing-full__inner{
  display:flex;
  align-items:center;
  height:112px;
}

.financing-full__item{
  display:flex;
  align-items:center;
  gap:16px;
  flex:1;
}

.financing-full__item img{
  max-height:32px;
}

.financing-full__divider{
  width:1px;
  height:48px;
  background:#e5e5e5;
  margin:0 32px;
}

/* Half width blocks */

.financing-card--half{
  width:calc(50% - 8px);
}

.financing-half__content{
  display:flex;
  align-items:center;
  gap:16px;
  height:112px;
}

.financing-half__content img{
  max-height:34px;
}


/* Mobile */

@media screen and (max-width:749px){

.financing-card--half{
  width:100%;
}

.financing-full__inner{
  flex-direction:column;
  align-items:flex-start;
  height:auto;
  gap:20px;
}

.financing-full__divider{
  width:100%;
  height:1px;
  margin:0;
}

.financing-half__content{
  height:148px;
  align-items:flex-start;
}

}

</style>


{% schema %}
{
  "name": "Financing options",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [

    {
      "type": "full_width",
      "name": "Full width card",
      "limit": 1,
      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },

        {
          "type": "image_picker",
          "id": "logo_1",
          "label": "First logo"
        },

        {
          "type": "textarea",
          "id": "text_1",
          "label": "First text"
        },

        {
          "type": "image_picker",
          "id": "logo_2",
          "label": "Second logo"
        },

        {
          "type": "textarea",
          "id": "text_2",
          "label": "Second text"
        }

      ]
    },

    {
      "type": "half_width",
      "name": "Half width card",
      "limit": 2,
      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },

        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Financing options"
    }
  ]
}
{% endschema %}