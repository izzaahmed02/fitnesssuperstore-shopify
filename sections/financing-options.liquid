<section class="financing-options" style="background: {{ section.settings.bg_color }};">
  <div class="page-width">

    <div class="financing-grid">

      {% for block in section.blocks %}

        {% case block.type %}

        {% when 'credit_card' %}

        <div class="financing-block financing-block--full">

          {% if block.settings.title != blank %}
          <p class="financing-title">{{ block.settings.title }}</p>
          {% endif %}

          <div class="financing-card financing-card--credit">

            <div class="financing-credit__inner">

              <div class="financing-credit__logos">
                {% if block.settings.logo_visa %}
                  <img src="{{ block.settings.logo_visa | image_url }}" alt="Visa">
                {% endif %}
                {% if block.settings.logo_mastercard %}
                  <img src="{{ block.settings.logo_mastercard | image_url }}" alt="Mastercard">
                {% endif %}
                {% if block.settings.logo_discover %}
                  <img src="{{ block.settings.logo_discover | image_url }}" alt="Discover">
                {% endif %}
                {% if block.settings.logo_amex %}
                  <img src="{{ block.settings.logo_amex | image_url }}" alt="American Express">
                {% endif %}
              </div>

              <p class="financing-credit__text">{{ block.settings.text }}</p>

            </div>

          </div>
        </div>


        {% when 'full_width' %}

        <div class="financing-block financing-block--full">

          {% if block.settings.title != blank %}
          <p class="financing-title">{{ block.settings.title }}</p>
          {% endif %}

          <div class="financing-card financing-card--full">

            <div class="financing-full__inner">

              <div class="financing-full__item">
                {% if block.settings.logo_1 %}
                  <img src="{{ block.settings.logo_1 | image_url }}" alt="">
                {% endif %}
                <p>{{ block.settings.text_1 }}</p>
              </div>

              <div class="financing-divider"></div>

              <div class="financing-full__item">
                {% if block.settings.logo_2 %}
                  <img src="{{ block.settings.logo_2 | image_url }}" alt="">
                {% endif %}
                <p>{{ block.settings.text_2 }}</p>
              </div>

            </div>

          </div>
        </div>


        {% when 'half_width' %}

        <div class="financing-block financing-block--half">

          {% if block.settings.title != blank %}
          <p class="financing-title">{{ block.settings.title }}</p>
          {% endif %}

          <div class="financing-card financing-card--half">

            <div class="financing-half__content">

              {% if block.settings.logo %}
                <img src="{{ block.settings.logo | image_url }}" alt="">
              {% endif %}

              <p>{{ block.settings.text }}</p>

            </div>

          </div>

        </div>

        {% endcase %}

      {% endfor %}

    </div>

  </div>
</section>

<style>
.section-financing-options .financing-options{
  padding:36px 0;
}

/* GRID */

.section-financing-options .financing-grid{
  display:flex;
  flex-wrap:wrap;
  gap:20px 16px;
}

.section-financing-options .financing-block{
  width:100%;
}

.section-financing-options .financing-block--half{
  width:calc(50% - 8px);
}

/* TITLES */

.section-financing-options .financing-title{
  font-size:20px;
  line-height: 26px;
  letter-spacing: 0px;
  font-weight: 700;
  margin: 0px;
  margin-bottom:12px;
  text-transform: initial;
  gap: 8px;
}

.section-financing-options .financing-title span {
  font-size: 12px;
  line-height: 18px;
  letter-spacing: 0px;
  color: #F1592A;
  padding: 2px 8px;
  background: #FCE6DE;
  border-radius: 20px;
  text-transform: initial;
  vertical-align: middle;
  white-space: nowrap;
}

/* CARD */

.section-financing-options .financing-card{
  background:#fff;
  border:1px solid #e5e5e5;
  border-radius:12px;
  padding:20px;
  box-sizing:border-box;
}

/* CREDIT/DEBIT CARD */

.section-financing-options .financing-card--credit {
  height: auto;
  min-height: 80px;
  display: flex;
  align-items: center;
}

.section-financing-options .financing-credit__inner {
  display: flex;
  align-items: center;
  gap: 24px;
  width: 100%;
}

.section-financing-options .financing-credit__logos {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.section-financing-options .financing-credit__logos img {
  max-height: 28px;
  width: auto;
  display: block;
}

.section-financing-options .financing-credit__text {
  margin: 0;
  font-size: 14px;
  line-height: 1.5;
  color: inherit;
}

/* FULL WIDTH CARD */

.section-financing-options .financing-card--full{
  height:112px;
  display:flex;
  align-items:center;
}

.section-financing-options .financing-full__inner{
  display:flex;
  align-items:center;
  width:100%;
}

.section-financing-options .financing-full__item{
  display:flex;
  align-items:center;
  gap:16px;
  flex:1;
}

.section-financing-options .financing-full__item img{
  max-height:32px;
}

/* SEPARATOR */

.section-financing-options .financing-divider{
  width:1px;
  height:40px;
  background:#E5E5E5;
  margin:0 32px;
  display: block !important;
}

/* HALF WIDTH CARD */

.section-financing-options .financing-card--half{
  height:112px;
  display:flex;
  align-items:center;
}

.section-financing-options .financing-half__content{
  display:flex;
  align-items:center;
  gap:16px;
}

.section-financing-options .financing-half__content img{
  max-height:32px;
}

@media screen and (min-width: 750px) {
    .section-financing-options .financing-options .page-width {
        padding: 0 16px;
    }
}


/* MOBILE */

@media screen and (max-width:749px){

.section-financing-options .financing-options {
  padding: 24px 0px;
}

.section-financing-options .financing-block--half{
  width:100%;
}

/* CREDIT CARD MOBILE */

.section-financing-options .financing-credit__inner {
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
}

.section-financing-options .financing-credit__logos {
  gap: 8px;
}

/* FULL CARD MOBILE */

.section-financing-options .financing-card--full{
  height:240px;
}

.section-financing-options .financing-full__inner{
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  gap:16px;
}

.section-financing-options .financing-full__item, .financing-half__content {
  align-items: flex-start;
  flex-direction: column;
  gap: 8px;
}

.section-financing-options .financing-full__item p, .financing-half__content p {
  margin: 0px;
}

/* HORIZONTAL SEPARATOR */

.section-financing-options .financing-divider{
  width:100%;
  height:1px;
  margin:0;
  display: block !important;
}

/* HALF CARD MOBILE */

.section-financing-options .financing-card--half{
  height:148px;
}

.section-financing-options .financing-grid .financing-block--half:nth-child(3) .financing-card--half {
  height: 172px;
}

.section-financing-options .financing-half__content{
  align-items:flex-start;
}

}

</style>

{% schema %}
{
  "name": "Financing options",
  "class": "section-financing-options",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [

    {
      "type": "credit_card",
      "name": "Credit & Debit Card",
      "limit": 1,
      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Credit & Debit Cards"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Description text",
          "default": "Pay securely with Visa, Mastercard, Discover, or American Express through our secure Shopify checkout."
        },

        {
          "type": "image_picker",
          "id": "logo_visa",
          "label": "Visa logo"
        },

        {
          "type": "image_picker",
          "id": "logo_mastercard",
          "label": "Mastercard logo"
        },

        {
          "type": "image_picker",
          "id": "logo_discover",
          "label": "Discover logo"
        },

        {
          "type": "image_picker",
          "id": "logo_amex",
          "label": "American Express logo"
        }

      ]
    },

    {
      "type": "full_width",
      "name": "Full width financing",
      "limit": 1,
      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },

        {
          "type": "image_picker",
          "id": "logo_1",
          "label": "First logo"
        },

        {
          "type": "textarea",
          "id": "text_1",
          "label": "First text"
        },

        {
          "type": "image_picker",
          "id": "logo_2",
          "label": "Second logo"
        },

        {
          "type": "textarea",
          "id": "text_2",
          "label": "Second text"
        }

      ]
    },

    {
      "type": "half_width",
      "name": "Half width card",
      "limit": 2,
      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },

        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Financing options"
    }
  ]
}
{% endschema %}