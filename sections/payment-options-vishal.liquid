<section class="payment-options">
  <div class="container">

    <!-- Main Heading -->
    <h2>{{ section.settings.heading }}</h2>

    <!-- TOP ROW (Shop Pay + Affirm) -->
    <div class="top-grid">
      
      <div class="box first-border">
        {% if section.settings.shop_image %}
          <img src="{{ section.settings.shop_image | image_url: width: 100 }}" alt="">
        {% endif %}
        <p>{{ section.settings.shop_text }}</p>
      </div>

      <hr class="divider"/>

      <div class="box">
        {% if section.settings.affirm_image %}
          <img src="{{ section.settings.affirm_image | image_url: width: 100 }}" alt="">
        {% endif %}
        <p>{{ section.settings.affirm_text }}</p>
      </div>

    </div>

    <!-- BOTTOM GRID -->
    <div class="bottom-grid">

      <!-- PayPal -->
      <div>
        <h3>{{ section.settings.paypal_heading }}</h3>
        <div class="card">
          {% if section.settings.paypal_image %}
            <img src="{{ section.settings.paypal_image | image_url: width: 80 }}" alt="">
          {% endif %}
          <p>{{ section.settings.paypal_text }}</p>
        </div>
      </div>

      <!-- Financing -->
      <div>
        <h3>
          {{ section.settings.finance_heading }}
          <span class="badge">{{ section.settings.finance_badge }}</span>
        </h3>

        <div class="card">
          {% if section.settings.finance_image %}
            <img src="{{ section.settings.finance_image | image_url: width: 80 }}" alt="">
          {% endif %}
          <p>{{ section.settings.finance_text }}</p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
.payment-options {
  padding: 36px 16px;
  font-family: system-ui, -apple-system, sans-serif;
  background: #FAF9F9;
}

.container {
  max-width: 1000px;
  margin: auto;
}
{% comment %} 
h2 {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 16px;
  line-height: 1.3;
} {% endcomment %}

/* TOP ROW — vertical stack, not side-by-side */
{% comment %} .top-grid {
  display: flex;
  flex-direction: column;   /* ← was missing; screenshot shows stacked layout */
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  padding: 16px 20px;
  background: #fafafa;
  gap: 0;
} {% endcomment %}
.top-grid {
    display: flex;
    border: 1px solid #e5e5e5;
    height:110px;
    border-radius: 12px;
    padding: 20px;
    background: #ffffff;
    gap: 5px;
    flex-direction: row;
}
.box {
    padding: 14px 0;
        display: flex;
    {% comment %} border-right: 1px solid #e5e5e5; {% endcomment %}
    width: 100%;
   gap:10px;
    align-items: center;
    

}

.box img {
    display: block;
    height: 28px;
    width: auto;
    margin-bottom: 8px;
    object-fit: contain;
    padding: 2px 0;
    height: 28px;
    width: 83.29px;
}
.box p {
    font-size: 16px;
    color: #393940;
    margin: 0;
    line-height: 1.5;
}
.container h2{
  padding-bottom:12px;
}
/* Horizontal divider between Shop Pay and Affirm */


/* BOTTOM GRID */
.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 0px;
  
}

h3 {
  margin: 20px 0 12px;
 font-family: Lato;
font-weight: 700;
font-style: Bold;
font-size: 20px;
leading-trim: NONE;
line-height: 26px;
letter-spacing: 0px;
vertical-align: middle;
font-variant-numeric-figure: lining-nums;
font-variant-numeric-spacing: proportional-nums;

}
.card:not(.ratio) {
  display: flex;
  flex-direction: row;
  align-items: flex-start;   /* aligns logo + text to top */
  gap: 16px;
            /* fixed width */
  height: 112px;
  padding: 20px;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  background: #ffffff;
  box-sizing: border-box;
}

.card:not(.ratio) img {
  flex-shrink: 0;            /* stops logo from squishing */
  height: 36px;
  width: auto;
  object-fit: contain;
}

.card:not(.ratio) p {
  font-size: 14px;
  color: #333;
  margin: 0;
  line-height: 1.5;
}
.card {
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  padding: 16px;
  background: #fafafa;
}

.card img {
  display: block;
  height: 36px;             /* ← constrain logo height */
  width: auto;
  object-fit: contain;
  margin-bottom: 10px;
}

.card p {
  font-size: 14px;
  color: #333;
  margin: 0;
  line-height: 1.5;
}

.badge {
color:#F1592A;
background:#FCE6DE;
height: 22;
padding-top: Spacing/Space-0,5;
padding-right: Spacing/Space-2;
padding-bottom: Spacing/Space-0,5;
padding-left: Spacing/Space-2;
gap: 10px;
angle: 0 deg;
opacity: 1;
border-radius: Spacing/Space-5;
font-family: Lato;
font-weight: 700;
font-style: Bold;
font-size: 12px;
leading-trim: NONE;
line-height: 18px;
letter-spacing: 0%;
vertical-align: middle;
font-variant-numeric-figure: lining-nums;
font-variant-numeric-spacing: proportional-nums;

}
h2{
text-transform: none;
font-family: Lato;
font-weight: 700;
font-style: Bold;
font-size: 20px;
leading-trim: NONE;
line-height: 26px;
letter-spacing: 0px;
vertical-align: middle;

}
  .bottom-grid div{
      display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
.first-border{
border-right: 1px solid #e5e5e5;
width:100%;
}
/* MOBILE */
@media (max-width: 1024px) {
  .bottom-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 1024px) {

  .top-grid {
    flex-direction: column;
    padding: 16px 20px;
    gap: 0;
    height:auto;
    background: #ffffff;
  }
  .divider {
    width: 100%;
    height: 1px;
    background: #e5e5e5;
    margin: 0;
    display: block;           /* was hidden or collapsed on desktop */
  }
 .box {
    display: flex;
    flex-direction: column;
    height: auto;
    padding: 16px 0;
    border-right: none;
    gap: 8px;
    align-items: flex-start;
    justify-content: flex-start;
    align-content: center;
}

 
   .box img {
    width: 83.29px;
    height: 28px;
}
  

  .box p {
   font-family: Lato;
font-weight: 400;
font-style: Regular;
font-size: 16px;

line-height: 24px;
letter-spacing: 0px;


  }

  /* horizontal line between Shop Pay and Affirm */


  .bottom-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }


  .card:not(.ratio) {
    width: 100%;              /* override fixed 498px */
    height: auto;             /* let content breathe */
    flex-direction: column;
    align-items: flex-start;
    padding: 16px;
    font-family: Lato;
font-weight: 400;
font-style: Regular;
font-size: 16px;

line-height: 24px;
letter-spacing: 0px;


  }

  .card:not(.ratio) img {
   width: 32;
height: 28;
angle: 0 deg;
opacity: 1;

  }

}
</style>

{% schema %}
{
  "name": "Payment Options UI",
  "settings": [
    { "type": "text", "id": "heading", "label": "Main heading", "default": "These options are selected during checkout." },

    { "type": "image_picker", "id": "shop_image", "label": "Shop Pay logo" },
    { "type": "textarea", "id": "shop_text", "label": "Shop Pay text" },

    { "type": "image_picker", "id": "affirm_image", "label": "Affirm logo" },
    { "type": "textarea", "id": "affirm_text", "label": "Affirm text" },

    { "type": "text", "id": "paypal_heading", "label": "PayPal heading", "default": "Additional option" },
    { "type": "image_picker", "id": "paypal_image", "label": "PayPal logo" },
    { "type": "textarea", "id": "paypal_text", "label": "PayPal text" },

    { "type": "text", "id": "finance_heading", "label": "Finance heading", "default": "Financing for qualified business customers" },
    { "type": "text", "id": "finance_badge", "label": "Badge text", "default": "Tax ID required" },
    { "type": "image_picker", "id": "finance_image", "label": "Finance logo" },
    { "type": "textarea", "id": "finance_text", "label": "Finance text" }
  ],
  "presets": [
    {
      "name": "Payment Options Layout"
    }
  ]
}
{% endschema %}