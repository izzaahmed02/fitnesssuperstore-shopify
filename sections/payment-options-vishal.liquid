<section class="payment-options">
  <div class="container">

    {% if section.settings.main_title != blank %}
      <h2 class="title">{{ section.settings.main_title }}</h2>
    {% endif %}

    {% for block in section.blocks %}
      
      {% case block.type %}

      {% when 'group' %}
        {% if block.settings.heading != blank %}
          <h3 class="subtitle">
            {{ block.settings.heading }}
            {% if block.settings.badge != blank %}
              <span class="badge">{{ block.settings.badge }}</span>
            {% endif %}
          </h3>
        {% endif %}

        <div class="card">
          {% for inner in section.blocks %}
            {% if inner.type == 'item' and inner.settings.group == block.id %}
              
              <div class="row">
                <div class="logo">{{ inner.settings.title }}</div>
                <p>{{ inner.settings.text }}</p>
              </div>

              {% unless forloop.last %}
                <div class="line"></div>
              {% endunless %}

            {% endif %}
          {% endfor %}
        </div>

      {% endcase %}

    {% endfor %}

  </div>
</section>

<style>
.payment-options {
  padding: 16px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.container {
  max-width: 480px;
  margin: 0 auto;
}

.title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 14px;
}

.subtitle {
  font-size: 16px;
  font-weight: 600;
  margin: 20px 0 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge {
  background: #ffe9e2;
  color: #ff5a2c;
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 999px;
}

.card {
  background: #f7f7f7;
  border: 1px solid #e6e6e6;
  border-radius: 12px;
  padding: 16px;
}

.row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.logo {
  font-weight: 600;
}

.line {
  height: 1px;
  background: #e0e0e0;
  margin: 12px 0;
}
</style>

{% schema %}
{
  "name": "Payment options (dynamic)",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Main heading",
      "default": "These options are selected during checkout."
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Section group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Group heading"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text"
        }
      ]
    },
    {
      "type": "item",
      "name": "Payment item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title (e.g. Shop Pay)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "group",
          "label": "Group ID (paste group block ID)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Payment options UI"
    }
  ]
}
{% endschema %}