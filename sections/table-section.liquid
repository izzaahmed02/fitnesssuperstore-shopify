<style>
  #shopify-section-{{ section.id }}{
    padding-top: 80px;
    padding-bottom: 80px;
  }
  table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
  }

  th, td {
      padding: 8px;
      text-align: left;
  }

  .comparison-table th:not(:last-child),
  .comparison-table td:not(:last-child) {
    border-right: 1px solid #E5E5E5;
  }

  .comparison-table tr:not(:last-child) {
    border-bottom: 1px solid #E5E5E5;
  }

  th {
      font-weight: bold;
  }

  thead tr:first-child th {
      text-align: center;
  }

  .comparison-table th,
  .comparison-table td {
      text-align: center;
  }

  td {
      vertical-align: middle;
  }

  th[colspan] {
      text-align: center;
  }

  .comparison-table .star {
      color: #f39c12;
  }

  .comparison-table td .rating {
      font-size: 1.5rem;
  }

  .comparison-table th:first-child,
  .comparison-table td:first-child {
      text-align: left;
  }

  td{
    color: #000000;
  }
  tr td:first-child{
    font-weight: 700;
  }
  tr td:nth-child(2){
    background: #EDEFF3;
  }

  .star{
    display: inline-block;
    font-size: 24px;
    margin-right: 8px;
  }
  #shopify-section-{{ section.id }} .title{
    text-align: center;
    margin-top: 0;
    margin-bottom: 52px;
  }

  
  .comparison-table td:first-child,
  .comparison-table th:first-child {
    min-width: 140px;
  }

  .comparison-table-container {
    position: relative;
    width: 100%;
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    overflow: auto;
    display: flex;
  }

  .comparison-table {
    flex-shrink: 0;
  }

  .comparison-table td:first-child,
  .comparison-table th:first-child {
    position: sticky;
    left: 0;
    background-color: #fff;
    border-right: 1px solid #E5E5E5;
  }

  .comparison-table-item--no-border {
    border-right: none;
  }

  .comparison-table-container .comparison-table thead tr:first-child th {
    color: #000000;
    font-size: 18px;
    border-bottom: 1px solid #E5E5E5;
  }

  .comparison-table-container .comparison-table thead tr:last-child th  {
    color: #000000;
    font-size: 16px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .comparison-table-container .comparison-table td {
    text-align: left;
    border-bottom: 1px solid #E5E5E5;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }}{
      padding-block: 24px;
    }

    .comparison-table td:first-child,
    .comparison-table th:first-child {
      min-width: unset;
      box-shadow: 6px 0px 12px -4px #0000001A;
    }

    #shopify-section-{{ section.id }} .title{
      text-align: start;
      margin-bottom: 20px;
      font-size: 20px;
      line-height: 26px;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .page-width {
      overflow: auto;
    }

    .comparison-table-item--no-border {
      border-right: 1px solid #E5E5E5;
    }

    .comparison-table-container .comparison-table thead tr th {
      text-align: left;
    }
  }
</style>

