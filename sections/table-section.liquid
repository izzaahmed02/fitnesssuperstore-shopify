<style>
  #shopify-section-{{ section.id }}{
    padding-top: 80px;
    padding-bottom: 80px;
  }
  table {
      width: 100%;
      border-collapse: collapse;
  }
  
  th, td {
      border: 1px solid #E5E5E5;
      padding: 8px;
      text-align: left;
  }
  
  th {
      font-weight: bold;
  }
  
  thead tr:first-child th {
      text-align: center;
  }

  .comparison-table th, 
  .comparison-table td {
      text-align: center;
  }
  
  td {
      vertical-align: middle;
  }
  
  th[colspan] {
      text-align: center;
  }
  
  .comparison-table .star {
      color: #f39c12;
  }
  
  .comparison-table td .rating {
      font-size: 1.5rem;
  }
  
  .comparison-table th:first-child, 
  .comparison-table td:first-child {
      text-align: left;
  }

  .bold-title td{
    font-weight: 700;
  }
  td{
    color: #000000;
  }
  tr td:first-child{
    font-weight: 700;
  }
  tr td:nth-child(2){
    background: #EDEFF3;
  }

  .star{
    display: inline-block;
    font-size: 24px;
    margin-right: 8px;
  }
  #shopify-section-{{ section.id }} .title{
    text-align: center;
    margin-top: 0;
    margin-bottom: 52px;
  }
</style>

<div class="page-width">
  <h2 class="title">{{ section.settings.title }}</h2>
<table class="comparison-table">
        <thead>
            <tr>
                <th style="background: transparent;" colspan="2">-</th>
                <th style="background: #FAF9F9;" colspan="3">Remanufactured</th>
                <th style="background: #FAF9F9;" colspan="3">New</th>
