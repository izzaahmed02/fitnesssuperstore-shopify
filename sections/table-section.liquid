</div>
  
{% schema %}
  {
    "name": "Table section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      }
    ],
    "presets": [
      {
        "name": "Table section"
      }
    ]
  }
{% endschema %}