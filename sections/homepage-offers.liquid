{% stylesheet %}
.homepage-offers {
  background: #FAF9F9;
}

.homepage-offers .we-offer {
  padding: 40px 0;
}

.homepage-offers .tab-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.homepage-offers .tab-header h2 {
  margin-left: 8px;
  font-size: 28px;
  font-weight: 700;
}

.homepage-offers .category-tab-content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

@media (max-width: 1024px) {
  .homepage-offers .category-tab-content {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .homepage-offers .category-tab-content {
    grid-template-columns: 1fr 1fr;
  }
}

.homepage-offers .category-card {
  border-radius: 20px;
  overflow: hidden;
}

.homepage-offers .card-image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.homepage-offers .card-image-wrapper img {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: translate(-50%, -50%);
  border-radius: 20px;
}

.homepage-offers .image-title {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  color: white;
  font-family: Lato;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  padding: 0 16px;
  text-shadow: 0 0 8px rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

@media (max-width: 768px) {
  .homepage-offers .image-title {
    font-size: 18px;
    padding: 0 10px;
  }
}
{% endstylesheet %}


<div class="we-offer">
  <div class="tab-header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="category-tab-content">     
    {% for block in section.blocks %}
      <div class="category-card">
        <a href="{{ block.settings.link }}">
          <div class="card-image-wrapper">
            <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.title }}">
            <div class="image-title">
              <p>{{ block.settings.title }}</p>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>



{% schema %}
{
  "name": "Homepage Offers",
  "class": "homepage-offers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "We Offer"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Offers",
      "category": "Custom"
    }
  ]
}
{% endschema %}

