{{ 'homepage-offers.css' | asset_url | stylesheet_tag }}

<div class="we-offer">
  <div class="tab-header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="category-tab-content">     
    {% for block in section.blocks %}
      {% assign desktop_image = block.settings.image %}
{% assign mobile_image = block.settings.mobile_image %}
<div class="category-card">
  <a href="{{ block.settings.link }}">
    <div 
      class="card-image-wrapper"
      style="background-image: url({{ desktop_image | image_url: width: 800 }});"
    >
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 768px)" srcset="{{ mobile_image | image_url: width: 600 }}">
        {% endif %}
        <img 
          src="{{ desktop_image | image_url: width: 800 }}" 
          alt="{{ block.settings.title }}"
        >
      </picture>
      <div class="image-title">
        <p>{{ block.settings.title }}</p>
      </div>
    </div>
  </a>
</div>

    {% endfor %}
  </div>
</div>




{% schema %}
{
  "name": "Homepage Offers",
  "class": "homepage-offers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "We Offer"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Offers",
      "category": "Custom"
    }
  ]
}
{% endschema %}



