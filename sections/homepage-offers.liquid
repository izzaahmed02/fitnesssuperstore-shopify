{% stylesheet %}

.homepage-offers {
  background: #FAF9F9;
}
  
.homepage-offers .we-offer {
  padding: 40px 0;
}
.homepage-offers .category-tabs {
  display: flex;
  gap: 24px;
  margin-bottom: 0px;
  flex-wrap: wrap;
}

  .homepage-offers .category-tabs button.active{
    font-weight: 700;
  }


.homepage-offers .category-tabs button {
  position: relative;
  padding-bottom: 8px; 
  background: transparent;
  font-weight: 400;
  text-align: center;
  vertical-align: middle;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-family: Lato;
  border: none;
  cursor: pointer;
}

.homepage-offers .category-tabs button.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  height: 4px;
  width: 100%;
  background-color: #F1592A;
  border-radius: 4px;
}

 .homepage-offers .main-card {
  text-align: center;
  background: #FFFFFF;

  border-radius: 20px;
  margin: 8px;
} 

.homepage-offers .category-card {
  
 
  padding: 24px 34px 0px 34px;
 

}
.homepage-offers .category-card .brand-image {
  width: 141px;
  height: 183px;
  object-fit: contain;
  background: transparent;
  display: block;
  margin: 0;
}

  .homepage-offers .main-card .brand-logo {
  width: 100%;
    margin-bottom: 24px;
}

.homepage-offers .category-card p {
  font-family: Lato;
font-weight: 700;
font-size: 20px;
line-height: 26px;
  margin: 0px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;

}

.homepage-offers .tab-header{
  display: flex;
    align-items: center;
    justify-content: space-between;
}

  .homepage-offers .slick-prev {
    left: 25px!important;
    z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .homepage-offers .slick-next {
    right: 25px!important;
     z-index: 999;
    background: #616166!important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 34px;
}

  .homepage-offers .tab-header h2{
    margin-left: 8px;
  }

  @media (max-width: 1050px) {

    .homepage-offers .tab-header{
      display: block;
    }

    .homepage-offers .tab-header h2 {
    margin-left: auto;
    margin-bottom: 20px;
}
  }
{% endstylesheet %}

<div class="we-offer">

<div class="tab-header">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}


</div>
  
 
    <div class="category-tab-content">     
        {% for block in section.blocks %}
         
            <div class="category-card">
              <a href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title }}">
                {% endif %}
                {% if block.settings.title != blank %}
                  <div class="image-title"><p>{{ block.settings.title }}</p></div>
                {% endif %}
              </a>
            </div>

        {% endfor %}
      </div>
</div>


{% schema %}
{
  "name": "Homepage Offers",
  "class": "homepage-offers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "We Offer"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Button Label"
    },
     {
      "type": "url",
      "id": "url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
       
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage Offers",
      "category": "Custom"
    }
  ]
}
{% endschema %}
