{%- style -%}
  .footer-gym {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    background-color: #F1592A;;
    color: #ffffff;
    text-align: center;
    padding: 60px 20px;
    position: relative;
  }

  .section-{{ section.id }}-padding .footer-gym__content {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  .footer-gym__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .footer-gym__headline {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: #ffffff;
  }

  .footer-gym__subtext {
    font-size: 18px;
    margin: 0 0 32px 0;
    color: #ffffff;
    line-height: 1.5;
  }

  .footer-gym__button {
    display: inline-block;
    background-color: #ffffff;
    color: #F1592A;;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s ease;
    border: 2px solid #ffffff;
  }

  .footer-gym__button:hover {
    background-color: transparent;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .footer-gym__contact-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.1);
    padding: 16px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .footer-gym__contact-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 12px;
    font-weight: 500;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    white-space: nowrap;
    min-width: max-content;
  }

  .footer-gym__contact-item:hover {
    opacity: 0.8;
  }

  .footer-gym__contact-icon {
    width: 14px;
    height: 14px;
    fill: #ffffff;
    flex-shrink: 0;
  }

  .footer-gym__contact-text {
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .footer-gym {
      margin-top: {{ section.settings.margin_top }}px;
      padding: 60px 20px 0 20px;
    }

    .section-{{ section.id }}-padding .footer-gym__content {
      padding-top: {{ section.settings.padding_top }}px;
    }

    .footer-gym__content {
      padding-bottom: 90px;
    }

    .footer-gym__headline {
      font-size: 40px;
    }

    .footer-gym__subtext {
      font-size: 20px;
    }

    .footer-gym__contact-bar {
      padding: 20px 30px;
      gap: 50px;
    }

    .footer-gym__contact-item {
      font-size: 13px;
    }

    .footer-gym__contact-icon {
      width: 16px;
      height: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-gym {
      padding: 40px 20px 0 20px;
    }

    .footer-gym__content {
      padding-bottom: 70px;
    }

    .footer-gym__headline {
      font-size: 28px;
    }

    .footer-gym__subtext {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .footer-gym__button {
      padding: 14px 28px;
      font-size: 15px;
    }

    .footer-gym__contact-bar {
      padding: 14px 16px;
      gap: 20px;
      justify-content: flex-start;
    }

    .footer-gym__contact-item {
      font-size: 11px;
    }

    .footer-gym__contact-icon {
      width: 13px;
      height: 13px;
    }
  }

  @media screen and (max-width: 480px) {
    .footer-gym {
      padding: 32px 16px 0 16px;
    }

    .footer-gym__content {
      padding-bottom: 60px;
    }

    .footer-gym__headline {
      font-size: 24px;
    }

    .footer-gym__subtext {
      font-size: 15px;
      margin-bottom: 20px;
    }

    .footer-gym__button {
      padding: 12px 24px;
      font-size: 14px;
    }

    .footer-gym__contact-bar {
      padding: 12px 14px;
      gap: 15px;
      justify-content: flex-start;
    }

    .footer-gym__contact-item {
      font-size: 10px;
    }

    .footer-gym__contact-icon {
      width: 12px;
      height: 12px;
    }
  }
{%- endstyle -%}

<div class="footer-gym section-{{ section.id }}-padding">
  <div class="footer-gym__content">
    <h2 class="footer-gym__headline">{{ section.settings.headline }}</h2>
    <p class="footer-gym__subtext">{{ section.settings.subtext }}</p>
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_url | default: '#' }}" class="footer-gym__button">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
  
  <div class="footer-gym__contact-bar">
    <a href="tel:{{ section.settings.phone_number | default: '+1-925-215-2927' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: ' ', '' }}" class="footer-gym__contact-item">
      <svg class="footer-gym__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span class="footer-gym__contact-text">
        {{ section.settings.phone_number | default: '+1-925-215-2927' }}
      </span>
    </a>
    
    <a href="mailto:{{ section.settings.email_address | default: 'sales@fitnesssuperstore.com' }}" class="footer-gym__contact-item">
      <svg class="footer-gym__contact-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
      </svg>
      <span class="footer-gym__contact-text">
        {{ section.settings.email_address | default: 'sales@fitnesssuperstore.com' }}
      </span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Footer Gym",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Ready to Build Your Perfect Gym?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Our team of experts is ready to help you bring your vision to life."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Contact Our Design Team"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+1-925-215-2927"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "sales@fitnesssuperstore.com"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Footer Gym"
    }
  ]
}
{% endschema %} 