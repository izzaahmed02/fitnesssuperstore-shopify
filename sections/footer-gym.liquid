{%- style -%}
  .footer-gym {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    background-color: #F1592A;;
    color: #ffffff;
    text-align: center;
    padding: 60px 20px;
  }

  .section-{{ section.id }}-padding .footer-gym__content {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .footer-gym__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .footer-gym__headline {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 16px 0;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .footer-gym__subtext {
    font-size: 18px;
    margin: 0 0 32px 0;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
  }

  .footer-gym__button {
    display: inline-block;
    background-color: #ffffff;
    color: #F1592A;;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transition: all 0.3s ease;
    border: 2px solid #ffffff;
  }

  .footer-gym__button:hover {
    background-color: transparent;
    color: #ffffff;
    transform: translateY(-2px);
  }

  @media screen and (min-width: 750px) {
    .footer-gym {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding .footer-gym__content {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .footer-gym__headline {
      font-size: 40px;
    }

    .footer-gym__subtext {
      font-size: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-gym {
      padding: 40px 20px;
    }

    .footer-gym__headline {
      font-size: 28px;
    }

    .footer-gym__subtext {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .footer-gym__button {
      padding: 14px 28px;
      font-size: 15px;
    }
  }

  @media screen and (max-width: 480px) {
    .footer-gym {
      padding: 32px 16px;
    }

    .footer-gym__headline {
      font-size: 24px;
    }

    .footer-gym__subtext {
      font-size: 15px;
      margin-bottom: 20px;
    }

    .footer-gym__button {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{%- endstyle -%}

<div class="footer-gym section-{{ section.id }}-padding">
  <div class="footer-gym__content">
    <h2 class="footer-gym__headline">{{ section.settings.headline }}</h2>
    <p class="footer-gym__subtext">{{ section.settings.subtext }}</p>
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_url | default: '#' }}" class="footer-gym__button">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Footer Gym",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Ready to Build Your Perfect Gym?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Our team of experts is ready to help you bring your vision to life."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Contact Our Design Team"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Footer Gym"
    }
  ]
}
{% endschema %} 