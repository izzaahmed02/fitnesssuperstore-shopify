{{ 'homepage-cards.css' | asset_url | stylesheet_tag }}
<div class="page-width">
    <div class="homepage-cards__wrapper">
        {% for block in section.blocks %}
            <div class="homepage-cards__card">
                <h2 class="homepage-cards__card-title">{{ block.settings.title }}</h2>
                <div class="homepage-cards__card-copy">
                    {{ block.settings.copy }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% schema %}
{
  "name": "Homepage cards",
  "tag": "section",
  "class": "section homepage-cards",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "block copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage cards"
    }
  ]
}
{% endschema %}
