{{ 'homepage-cards.css' | asset_url | stylesheet_tag }}

<div class="homepage-cards__wrapper">
    <div class="homepage-cards__slider swiper">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="homepage-cards__slide swiper-slide">
                    <div class="homepage-cards__card">
                        <h2 class="homepage-cards__card-title">{{ block.settings.title }}</h2>
                        <div class="homepage-cards__card-copy">
                            {{ block.settings.copy }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="swiper-controls homepage-cards__slider-controls">
        {% comment %}
        <a aria-label="Slider Prev Button" href="#" class="swiper-button-prev">
            {% render 'chevron-button-prev' %}
        </a>
        {% endcomment %}
        <div class="swiper-pagination"></div>
        {% comment %}
        <a aria-label="Slider Next Button" href="#" class="swiper-button-next">
            {% render 'chevron-button-next' %}
        </a>
        {% endcomment %}
    </div>
</div>

<script src="{{ 'homepage-cards.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Homepage cards",
  "tag": "section",
  "class": "section homepage-cards",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "block copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage cards"
    }
  ]
}
{% endschema %}
