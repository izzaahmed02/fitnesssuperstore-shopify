<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.account-pages-link');
        console.log(tabs);
        const contents = document.querySelectorAll('.tab-content');
        console.log(contents);
        function activateTab(targetId) {
          contents.forEach(content => content.classList.remove('active'));
          
          
          
          const targetContent = document.getElementById(targetId);
          if (targetContent) {
            targetContent.classList.add('active');
          }
        }
        
        tabs.forEach(tab => {
          tab.addEventListener('click', function (event) {
            
            const targetId = tab.getAttribute('data-target');

            tabs.forEach(tab => tab.classList.remove('active'));
            tab.classList.add('active');
            
            activateTab(targetId);
          });
        });
        
        if (tabs.length > 0) {
          tabs[0].click();
        }

        const datailsBtns = document.querySelectorAll('.details-btn');
        const datailsBlocks = document.querySelectorAll('.detail-info-column .detail-info');
        datailsBtns.forEach((item,index) => {
          item.addEventListener('click', function (event) {
            datailsBlocks[index].classList.toggle('active');
          });
        });
  
        document.getElementById('sortOrders').addEventListener('change', function() {
        const orderList = document.querySelector('.order-history tbody');
        const rows = Array.from(orderList.querySelectorAll('tr[data-date]'));
        const isNewest = this.value === 'newest';
    
        rows.sort((a, b) => {
          const dateA = parseInt(a.getAttribute('data-date'));
          const dateB = parseInt(b.getAttribute('data-date'));
          return isNewest ? dateB - dateA : dateA - dateB;
        });
    
        // Clear the table body and append sorted rows
        orderList.innerHTML = '';
        rows.forEach(row => orderList.appendChild(row));
      });

          const rows = document.querySelectorAll('.order-history tbody tr');
          const loadMoreBtn = document.getElementById('loadMoreBtn');
          let visibleRows = 6;
      
      
          for (let i = 0; i < rows.length; i++) {
            if (i < visibleRows) {
              rows[i].style.display = '';
            } else {
              rows[i].style.display = 'none';
            }
          }
      
          loadMoreBtn.addEventListener('click', function() {
          
            if (loadMoreBtn.textContent === 'Load More') {
              visibleRows = rows.length; 
              loadMoreBtn.textContent = 'Show Less';
            } else {
              visibleRows = 3; 
              loadMoreBtn.textContent = 'Load More';
            }
      
      
            for (let i = 0; i < rows.length; i++) {
              if (i < visibleRows) {
                rows[i].style.display = '';
              } else {
                rows[i].style.display = 'none';
              }
            }
          });

    const addr = document.querySelector('.address-wrapper');
    const currentAddr = addr.getAttribute('data-current');
    const addressArr = document.querySelectorAll('.address-item label');
    const addressArrInput = document.querySelectorAll('.address-item input');
    const customChecks = document.querySelectorAll('.custom-radio');
      console.log(customChecks);

      addressArr.forEach((item, index) => {
          if(item.innerHTML == currentAddr){
            addressArrInput[index].checked = true;
            customChecks[index].classList.add('active');
          }
      });

      

       
      
      addressArrInput.forEach((item, index) => {
          item.addEventListener('change', (e) => {
            console.log(item.checked);
            if(item.checked == false){
              console.log('tt');
              return null;
            } else {
              const formChild = item.parentElement;
              const form = formChild.parentElement;
              form.submit();
            }
            
          })
      });

      customChecks.forEach((item, index) => {
          item.addEventListener('click', (e) => {
            addressArr[index].click();
            
          })
      });

      
      
      const turnover = document.querySelectorAll('.turnover-popup');
      const closeBtn = document.querySelector('.cross-close');
      turnover.forEach((item, index) => {
        item.addEventListener('click', () => {
          document.querySelector('.cancel-popup-container').style.display = "flex";
        });
      });

      closeBtn.addEventListener('click', () => {
          document.querySelector('.cancel-popup-container').style.display = "none";
      });
    });
</script>


{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .container{
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }} .wrapper{
    
  }
  .account-sidebar{
    display: flex;
    flex-direction: column;
    background: #FAF9F9;
    padding: 24px;
    max-width: 296px;
    width: 100%;
    border-radius: 12px;
    height: fit-content;
  }
  .account-sidebar .account-pages-link{
    display: flex;
    margin-bottom: 24px;
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    color: #333;
    cursor: pointer;
  }
  .account-sidebar .account-pages-link.active{
    color: #F1592A;
  }
  .divider{
    display: block!important;
    width: 100%;
    height: 1px;
    background: #E5E5E5;
    margin-bottom: 24px;
  }
  .account-sidebar a.logout-btn{
    display: flex;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
    color: #3E77AA;
    text-decoration: none;
  }
  .account-sidebar a.logout-btn svg{
    margin-right: 4px;
  }
  .tab-content {
    display: none;
  }
  
  .tab-content.active {
    display: block;
  }
  .account-title{
    font-size: 72px;
    font-weight: 600;
    line-height: 82px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 24px;
  }
  .order-section .wrapper{
    display: flex;
    justify-content: space-between;
    gap: 32px;
  }
  .account-content{
    width: 100%;
  }
  #orders table{
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    width: 100%;
  }
  #orders table th{
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 14px;
    line-height: 20px;
    color: #393940;
    padding-left: 16px;
    padding-right: 16px;
    text-align: left;
  }
  #orders table td{
    padding-top: 17px;
    padding-bottom: 17px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 16px;
    color: #23232B;
  }
  #orders table td time{
    font-size: 16px;
    color: #23232B;
    text-decoration: none;
  }
  #orders table thead{
    position: relative;
  }
  #orders table thead:after{
    content: " ";
    height: .1rem;
    width: 100%;
    display: block;
    position: absolute;
    left: 0;
    background: rgba(var(--color-foreground), .08);
  }
  #orders table tr{
    position: relative;
  }
  #orders table tr:first-child:after{
    display: none;
  }
  #orders table tr:after{
    content: " ";
    height: .1rem;
    width: 100%;
    display: block;
    position: absolute;
    left: 0;
    background: rgba(var(--color-foreground), .08);
  }
  #orders table #ColumnTotal, .column-total{
    text-align: right;
  }
  .details-btn{
    font-weight: 700;
    color: #F1592A;
    cursor: pointer;
  }
  .details-btn svg{
    margin-left: 10px;
  }
  .order-status.green{
    background: #CCEDDA;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    color: #00A344;
    width: fit-content;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 100px;
  }
  .order-status.yellow{
    background: #FFF3CD;
    color: #EEB200;
  }
  .detail-info{
    display: none;
    width: 100%;
    padding-top: 16px;
    padding-bottom: 16px;
    background: #FAF9F9;
    border-radius: 8px;
    margin-bottom: 16px;
    padding: 16px;
  }
  #orders table .detail-info-column:after{
    display: none;
  }
  .detail-info.active{
    display: block;
  }
  .table-options{
    margin-bottom: 32px;
  }
  .table-options{
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  #sortOrders{
    width: 294px;
    height: 48px;
    border: 1.5px solid #E5E5E5;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    color: #393940;
  }
  #loadMoreBtn{
    width: 106px;
    height: 40px;
    background: #F1592A;
    border-radius: 8px;
    margin-top: 32px;
    margin-left: auto;
    margin-right: auto;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 0;
    cursor: pointer;
  }
  .product-info-wrapper{
    margin-bottom: 24px;
    padding-bottom: 8px;
    border-bottom: 1px solid #E5E5E5;
  }
  .product-info{
    display: grid;
    grid-template-columns: auto 1fr 2fr 1fr 1fr;
    align-items: center;
    margin-bottom: 16px;
  }
  .product-info img{
    width: 76px;
    height: 76px;
    object-fit: cover;
    margin-right: 12px;
    border-radius: 8px;
    border: 1px solid #E5E5E5;
  }
  .product-title{
    font-size: 16px;
    line-height: 24px;
    color: #23232B;
  }
  .product-count{
    font-size: 16px;
    line-height: 24px;
    color: #23232B;
  }
  .product-price{
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #23232B;
  }
  .customer-info{
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .customer-title{
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    color: #23232B;
    display: block;
    margin-bottom: 16px;
  }
  .customer-line{
    display: grid;
    grid-template-columns: 1fr 2fr;
    font-size: 16px;
    line-height: 24px;
    color: #23232B;
    margin-bottom: 16px;
  }
  .customer-line span{
    color: #4F4F55;
  }
  .customer-block{
    margin-bottom: 32px;
  }
  .customer-block .customer-title{
    display: flex;
    align-items: center;
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #000;
  }
  .customer-block .customer-title svg{
    margin-left: 16px;
  }
  .customer-block .customer-line{
    grid-template-columns: 1fr 8fr;
  }
  #account .account-title{
    margin-bottom: 32px;
  }
  #RecoverEmail{
    width: 100%;
    max-width: 408px;
    height: 48px;
    border-radius: 8px;
    border: 1.5px solid #E5E5E5;
    margin-top: 16px;
    margin-bottom: 16px;
    padding-left: 12px;
  }
  .address-item{
    display: flex;
    align-items: center;
  }
  .address-wrapper{
    margin-bottom: -15px;
  }
  .address-wrapper form{
    margin-bottom: 15px;
  }
  .turnover-popup{
    font-weight: 700;
    color: #F1592A;
    line-height: 24px;
    cursor: pointer;
  }
  .cancel-popup-container{
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    background: rgba(0,0,0, 0.30);
    z-index: 100;
    display: none;
    justify-content: center;
    align-items: center;
  }
  .cancel-popup{
    background: #fff;
    border-radius: 12px;
    max-width: 842px;
    width: 100%;
    padding-left: 32px;
    padding-right: 32px;
    position: relative;
  }
  .cancel-popup h2{
    margin-top: 32px;
    margin-bottom: 24px;
    text-align: center;
  }
  .cancel-popup p{
    margin-top: 0;
    margin-bottom: 32px;
    text-align: center;
  }
  .cancel-popup a{
    font-weight: 700;
    color: #F1592A;
    text-decoration: none;
  }
  .cross-close{
    position: absolute;
    top: 32px;
    right: 24px;
    cursor: pointer;
  }
  .address-item input{
    display: none;
  }
  .custom-radio{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid #F1592A;
    border-radius: 50px;
    margin-right: 8px;
  }
  
  .inner-radio{
    display: none;
    width: 10px;
    height: 10px;
    background: #F1592A;
    border-radius: 50px;
    
  }
  .custom-radio.active .inner-radio{
    display: flex;
  }
  .add-address{
    font-weight: 700;
    color: #F1592A;
    line-height: 24px;
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .add-address span{
    font-size: 28px;
    color: #F1592A;
    margin-right: 10px;
  }
  .customer button{
    text-align: center;
    justify-content: center;
  }
{%- endstyle -%}
