          </span>
          <div data-current="{{ customer.default_address.street }} {{ customer.default_address.city }} {{ customer.default_address.province }}" class="address-wrapper">
            <div class="customer-line"><span>Address</span><div>
          {% for item in customer.addresses %}
            {%- form 'customer_address', item -%}
              <div class="address-item">
                <div class="custom-radio">
                  <div class="inner-radio"><span></span></div>
                </div>
                {{ form.set_as_default_checkbox}}
                
                <label for="address_default_address_{{ form.id }}">{{ item.street }} {{ item.city }} {{ item.province }}</label>
              </div>
              
            {% endform %}
          {% endfor %}
              <a href="/account/addresses" class="add-address"><span>+</span> Add address</a>
          </div>
            </div>
          </div>
      </div>
</div>
      <div class="tab-content" id="orders">
      <h2 class="account-title">MY ORDERS</h2>
        <div class="table-options">
          <div class="items-count">{{ customer.orders_count }} orders</div>
          <div class="sort-wrapper">
            <select id="sortOrders" aria-label="Sort orders">
              <option value="newest">Sort by: Newest</option>
              <option value="oldest">Sort by: Oldest</option>
            </select>
          </div>
        </div>
        {%- if customer.orders.size > 0 -%}
          <table role="table" class="order-history">
            <caption class="visually-hidden">
              {{ 'customer.orders.title' | t }}
            </caption>
            <thead role="rowgroup">
              <tr role="row">
                <th id="ColumnOrder" scope="col" role="columnheader">{{ 'customer.orders.order_number' | t }} #</th>
                <th id="ColumnDate" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</th>
                <th id="ColumnCount" scope="col" role="columnheader">Quantity</th>
                <th id="ColumnShipping" scope="col" role="columnheader">Shipping method</th>
                <th id="ColumnTotal" scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</th>
                <th id="ColumnFulfillment" scope="col" role="columnheader">
                  Status
                </th>
                <th></th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for order in customer.orders -%}
                  <tr role="row" data-date="{{ order.created_at | date: "%s" }}">
                    <td
                      id="RowOrder"
                      role="cell"
                      headers="ColumnOrder"
                      data-label="{{ 'customer.orders.order_number' | t }}"
                    >
                      {% assign orderId = order.name | remove: "#" %}
                      
                        
                        {{ orderId }}
                   
                    </td>
                    <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.orders.date' | t }}">
                      {{ order.created_at | date: "%b %d, %Y" }}
                    </td>
                    <td>
                      {{ order.item_count }}
                    </td>
                    <td>
                      {{ order.shipping_methods.first.title }}
                    </td>
                   <td class="column-total" headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                      {{ order.total_net_amount | money_with_currency }}
                    </td>
                    <td
                      
                      headers="RowOrder ColumnFulfillment"
                      role="cell"
                      data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                    >
                      <div class="order-status {% if order.fulfillment_status_label == "Fulfilled" %}green{% else %}yellow{% endif %} {% if true %}green{% endif %}">{% if order.fulfillment_status_label == "Fulfilled" %}Delivered{% else %}In progress{% endif %}</div>
                      
                      
                    </td>
                    <td>
                      <div class="details-btn">
                        Details
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="8" viewBox="0 0 14 8" fill="none">
<path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7 5.93934L12.4697 0.46967C12.7626 0.176777 13.2374 0.176777 13.5303 0.46967C13.8232 0.762563 13.8232 1.23744 13.5303 1.53033L7.53033 7.53033C7.23744 7.82322 6.76256 7.82322 6.46967 7.53033L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="#F1592A"/>
</svg>
                      </div>
                    </td>
                 
                  </tr>
                <tr class="detail-info-column">
                  <td style="padding-top: 0;padding-bottom: 0;" colspan="7">
                    <div class="detail-info">
                      <div class="product-info-wrapper">
                      {% for item in order.line_items %}
                        <div class="product-info">
                          {% if item.image != blank %}
                          {{ item.image | image_url: width: auto | image_tag }}
                          {% else %}
                            <img src="{{ 'https://cdn.shopify.com/s/files/1/0884/2012/2940/files/placeholder-images-image_large_4c16b6bf-b25f-4094-b8c5-5736f7f030d1.webp?v=1727861193' }}">
                          {% endif %}
                          <span class="product-title">{{ item.title }}</span>
                          <span class="product-count">{{ item.quantity }} pcs</span>
                          <span class="product-price">{{ item.price | money }}</span>
                          <div>test</div>
                        </div>
                      {% endfor %}
                      </div>
                      <div class="customer-info">
                        <div class="left-col">
                          <span class="customer-title">Detailed info</span>
                          <div class="customer-line"><span>Name</span>{{ customer.name }}</div>
                          <div class="customer-line"><span>Phone</span>{% if customer.phone != blank %}{{ customer.phone }}{% else %}-{% endif %}</div>
                          <div class="customer-line"><span>Email</span>{{ customer.email }}</div>
                        </div>
                        <div class="right-col">
                          <span class="customer-title">Shipping info</span>
                          <div class="customer-line"><span>Address</span>{% if order.shipping_address.address1 != blank %}{{ order.shipping_address.address1 }}{% else %}-{% endif %}</div>
                          <div class="customer-line"><span>Shipping method</span>{% if order.shipping_methods.first.title != blank %}{{ order.shipping_methods.first.title }}{% else %}-{% endif %}</div>
                        </div>
                        
                        
                      </div>
                      <span class="turnover-popup">Turnover</span>
                    </div>
                  </td>
                </tr>
                {%- endfor -%}
              </tbody>
            </table>
          <button id="loadMoreBtn" class="load-more-btn">Load More</button>
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
          {%- endif -%}
      </div>
      <div class="tab-content" id="payment">Payment Settings content</div>
      <div class="tab-content" id="features">Other Features content</div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Orders",
    "class": "order-section",
    "settings": [
      {
        "type": "text",
        "id": "popuptitle",
        "label": "Turnover popup title"
      },
      {
        "type": "richtext",
        "id": "popuptext",
        "label": "Turnover popup text"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Orders",
      }
    ]
  }
{% endschema %}