{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .customer-stories__heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }};
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .customer-stories__story-card {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 2.5rem;
    margin-bottom: 2rem;
    border: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .story-card__title {
    font-size: 28px;
    font-weight: 800;
    color: {{ section.settings.card_title_color }};
    margin-bottom: 0.5rem;
    line-height: 36px;
  }

  #shopify-section-{{ section.id }} .story-card__quote {
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.quote_color }};
    margin-bottom: 0.25rem;
    font-style: normal;
    line-height: 26px;
  }

  #shopify-section-{{ section.id }} .story-card__author {
    font-size: 16px;
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .story-card__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .story-card__body {
      grid-template-columns: 1fr;
    }
  }

  #shopify-section-{{ section.id }} .story-card__description {
    font-size: 16px;
    color: #444;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .story-card__highlights-title {
    font-weight: 700;
    font-size: 16px;
    color: #222;
    margin-bottom: 0.75rem;
    line-height: 24px;
  }

  #shopify-section-{{ section.id }} .story-card__highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .story-card__highlights-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: #333;
    margin-bottom: 0.6rem;
  }

  #shopify-section-{{ section.id }} .story-card__highlights-list li::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ section.settings.bullet_color }};
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .story-card__avatar-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  #shopify-section-{{ section.id }} .story-card__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  #shopify-section-{{ section.id }} .story-card__cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .story-card__cta-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .story-card__cta-btn:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .story-card__cta-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  /* Media gallery */
  #shopify-section-{{ section.id }} .story-card__media-gallery {
    display: grid;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .story-card__media-gallery--1 {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .story-card__media-gallery--2 {
    grid-template-columns: 1fr 1fr;
  }

  #shopify-section-{{ section.id }} .story-card__media-gallery--3 {
    grid-template-columns: 2fr 1fr;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .story-card__media-gallery--2,
    #shopify-section-{{ section.id }} .story-card__media-gallery--3 {
      grid-template-columns: 1fr;
    }
  }

  #shopify-section-{{ section.id }} .story-card__media-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  #shopify-section-{{ section.id }} .story-card__media-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .story-card__video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.15);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .story-card__play-btn {
    width: 56px;
    height: 56px;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .story-card__play-btn svg {
    width: 20px;
    height: 20px;
    margin-left: 4px;
    fill: #333;
  }

  #shopify-section-{{ section.id }} .story-card__media-name-tag {
    position: absolute;
    bottom: 0;
    left: 0;
    background: {{ section.settings.btn_bg_color }};
  }

  #shopify-section-{{ section.id }} .story-card__media-name-tag .name-line {
    padding: 0.3rem 1rem;
    font-weight: 800;
    font-size: 0.85rem;
    color: {{ section.settings.btn_text_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }

  #shopify-section-{{ section.id }} .story-card__media-name-tag .role-line {
    padding: 0.3rem 1rem;
    font-weight: 700;
    font-size: 0.75rem;
    color: {{ section.settings.btn_text_color }};
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(0,0,0,0.15);
  }

  /* Slider nav */
  #shopify-section-{{ section.id }} .story-card__media-nav {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.85);
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .story-card__media-nav svg {
    width: 16px;
    height: 16px;
  }

  /* Highlights right column - avatar bottom right */
  #shopify-section-{{ section.id }} .story-card__highlights-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
{%- endstyle -%}

<div class="customer-stories section-{{ section.id }}-padding">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="customer-stories__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'story' -%}
        <div class="customer-stories__story-card" {{ block.shopify_attributes }}>

          {%- if block.settings.story_title != blank -%}
            <h3 class="story-card__title">{{ block.settings.story_title }}</h3>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <p class="story-card__quote">"{{ block.settings.quote }}"</p>
          {%- endif -%}

          {%- if block.settings.author_name != blank -%}
            <p class="story-card__author">{{ block.settings.author_name }}</p>
          {%- endif -%}

          <div class="story-card__body">
            <!-- Left: Description -->
            <div class="story-card__description-col">
              {%- if block.settings.description != blank -%}
                <div class="story-card__description">{{ block.settings.description }}</div>
              {%- endif -%}

              <div class="story-card__cta-row" style="margin-top: 1.5rem;">
                {%- if block.settings.cta_label != blank -%}
                  <a
                    class="story-card__cta-btn"
                    {% if block.settings.cta_link != blank %}href="{{ block.settings.cta_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  >
                    {{ block.settings.cta_label | escape }}
                  </a>
                {%- endif -%}
                {%- if block.settings.cta_icon != blank -%}
                  <img
                    src="{{ block.settings.cta_icon | image_url: width: 120 }}"
                    alt="{{ block.settings.cta_icon.alt | default: 'CTA icon' }}"
                    class="story-card__cta-icon"
                    width="52"
                    height="52"
                  >
                {%- endif -%}
              </div>
            </div>

            <!-- Right: Highlights + Avatar -->
            <div class="story-card__highlights-col">
              {%- if block.settings.highlights_title != blank -%}
                <p class="story-card__highlights-title">{{ block.settings.highlights_title }}</p>
              {%- endif -%}

              {%- assign highlights = block.settings.highlights | newline_to_br | split: '<br />' -%}
              {%- if highlights.size > 0 and block.settings.highlights != blank -%}
                <ul class="story-card__highlights-list">
                  {%- for item in highlights -%}
                    {%- assign trimmed = item | strip -%}
                    {%- if trimmed != blank -%}
                      <li>{{ trimmed }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.avatar != blank -%}
                <div class="story-card__avatar-wrap">
                  <img
                    src="{{ block.settings.avatar | image_url: width: 160 }}"
                    alt="{{ block.settings.avatar.alt | default: block.settings.author_name }}"
                    class="story-card__avatar"
                    width="64"
                    height="64"
                  >
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Media Gallery -->
          {%- assign media_count = 0 -%}
          {%- if block.settings.media_1 != blank -%}{%- assign media_count = media_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.media_2 != blank -%}{%- assign media_count = media_count | plus: 1 -%}{%- endif -%}
          {%- if block.settings.media_3 != blank -%}{%- assign media_count = media_count | plus: 1 -%}{%- endif -%}

          {%- if media_count > 0 -%}
            <div class="story-card__media-gallery story-card__media-gallery--{{ media_count }}">

              {%- if block.settings.media_1 != blank -%}
                <div class="story-card__media-item">
                  <img
                    src="{{ block.settings.media_1 | image_url: width: 1200 }}"
                    alt="{{ block.settings.media_1.alt | default: 'Story media' }}"
                    loading="lazy"
                    width="800"
                    height="450"
                  >
                  {%- if block.settings.media_1_is_video -%}
                    <div class="story-card__video-overlay"
                      {%- if block.settings.video_url != blank -%}
                        onclick="window.open('{{ block.settings.video_url }}', '_blank')"
                      {%- endif -%}
                    >
                      <div class="story-card__play-btn">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8 5v14l11-7z"/></svg>
                      </div>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.person_name != blank or block.settings.person_role != blank -%}
                    <div class="story-card__media-name-tag">
                      {%- if block.settings.person_name != blank -%}
                        <div class="name-line">{{ block.settings.person_name }}</div>
                      {%- endif -%}
                      {%- if block.settings.person_role != blank -%}
                        <div class="role-line">{{ block.settings.person_role }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.media_2 != blank -%}
                <div class="story-card__media-item" style="position: relative;">
                  <img
                    src="{{ block.settings.media_2 | image_url: width: 1200 }}"
                    alt="{{ block.settings.media_2.alt | default: 'Story media' }}"
                    loading="lazy"
                    width="800"
                    height="450"
                  >
                  {%- if media_count > 2 and block.settings.media_3 != blank -%}
                    <button class="story-card__media-nav" aria-label="Next image" onclick="this.closest('.story-card__media-gallery').querySelector('.story-card__media-item:last-child').scrollIntoView({behavior:'smooth',inline:'start'})">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.media_3 != blank -%}
                <div class="story-card__media-item">
                  <img
                    src="{{ block.settings.media_3 | image_url: width: 1200 }}"
                    alt="{{ block.settings.media_3.alt | default: 'Story media' }}"
                    loading="lazy"
                    width="800"
                    height="450"
                  >
                </div>
              {%- endif -%}

            </div>
          {%- endif -%}

        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "Customer Stories",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Featured Customer Stories"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "1.75rem", "label": "Small" },
        { "value": "2.25rem", "label": "Medium" },
        { "value": "3rem", "label": "Large" },
        { "value": "3.75rem", "label": "X-Large" }
      ],
      "default": "3rem"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Highlights bullet color",
      "default": "#3B82F6"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background color",
      "default": "#E85D26"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Customer Story",
      "settings": [
        {
          "type": "header",
          "content": "Story details"
        },
        {
          "type": "text",
          "id": "story_title",
          "label": "Story title",
          "default": "Revitalize Fitness, Elizabeth City, NC: Fully Equipped from the Ground Up"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Pull quote",
          "default": "They helped us equip an entire commercial facility with everything we needed, all from one source."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name & title",
          "default": "Rick Anderson, Co-Owner of Revitalize Fitness"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author avatar image"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Story description",
          "default": "Revitalize Fitness in Elizabeth City, NC needed a complete equipment package for their commercial training facility. Our team worked with co-owner Rick Anderson to outfit the space across every category."
        },
        {
          "type": "header",
          "content": "Equipment highlights"
        },
        {
          "type": "text",
          "id": "highlights_title",
          "label": "Highlights heading",
          "default": "Equipment Highlights:"
        },
        {
          "type": "textarea",
          "id": "highlights",
          "label": "Highlight items (one per line)",
          "default": "French Fitness Cardio Equipment\nSelectorized Cable & Multi-Station Machines\nPlate Loaded Strength Machines\nFunctional Training & Accessories",
          "info": "Enter each highlight on a new line."
        },
        {
          "type": "header",
          "content": "Call to action"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "View Full Case Study"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "cta_icon",
          "label": "CTA icon image (circle badge next to button)"
        },
        {
          "type": "header",
          "content": "Media gallery"
        },
        {
          "type": "image_picker",
          "id": "media_1",
          "label": "Media 1 (main / left)"
        },
        {
          "type": "checkbox",
          "id": "media_1_is_video",
          "label": "Show play button on Media 1",
          "default": false
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (opens on play button click)"
        },
        {
          "type": "text",
          "id": "person_name",
          "label": "Name tag — person name",
          "info": "Shown as overlay on Media 1",
          "default": "Rick Anderson"
        },
        {
          "type": "text",
          "id": "person_role",
          "label": "Name tag — person role",
          "default": "Co-Owner of Revitalize Fitness"
        },
        {
          "type": "image_picker",
          "id": "media_2",
          "label": "Media 2 (right top)"
        },
        {
          "type": "image_picker",
          "id": "media_3",
          "label": "Media 3 (right bottom)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Stories",
      "blocks": [
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
