{% schema %}
{
  "name": "Tab Information",
  "class": "tab-information",
  "settings": [],
  "blocks": [
    {
      "type": "richtext",
      "name": "Tab",
      "settings": [
        {
          "type": "richtext",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "<p>New Tab</p>"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab Content",
          "default": "<p>Enter tab content here.</p>"
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Tab Image",
          "info": "<p>Upload an image to display on the right side for this tab.</p"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tab Information",
      "category": "Custom",
      "blocks": [
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>US Territories, California, Canada</p>",
            "tab_content": "<p>For California buyers, sales tax will be calculated based on the combined state, county, and district rates, which ranges from 7.25% to 10.25%. 5% sales tax will be charged for Wisconsin buyers and 6.625% will be charged to New Jersey buyers upon checkout. Customers from other states in the US will not be charged a sales tax.\n\nUS Territories Buyers: No additional fees will be charged upon delivery. Our online checkout price includes door-to-door shipping to your address, which amount to 10.5% for Puerto Rico and 4% for Guam. No taxes for USVI.\n\nCanada Buyers: Ontario: 13%, Atlantic provinces (Newfoundland, Nova Scotia, New Brunswick, PEI): 15%, All other provinces (Alberta, British Columbia, Manitoba, Northwest Territories, Nunavut, Quebec, Saskatchewan, Yukon): 5%</p>"
          }
        },
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>Other Countries</p>",
            "tab_content": "<p>Content for other countries goes here.</p>"
          }
        },
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>Special Conditions</p>",
            "tab_content": "<p>Special conditions content goes here.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="tax-info-tabs">
  <div class="tab-nav tabs__buttons">
    {% for block in section.blocks %}
      <button class="tab-btn {% if forloop.first %}active{% endif %}" data-tab="tab-{{ block.id }}">{{ block.settings.tab_title }}</button>
    {% endfor %}
  </div>
  <div class="tab-content">
    {% for block in section.blocks %}
      <div class="tab-pane {% if forloop.first %}active{% endif %}" id="tab-{{ block.id }}">
        <div class="accordion-header">{{ block.settings.tab_title }}</div>
        <div class="accordion-content">
          <div class="paraDiv">{{ block.settings.tab_content | newline_to_br }}</div>
          {% if block.settings.tab_image %}
            <div class="tab-image">
              <img src="{{ block.settings.tab_image | img_url: 'medium' }}" alt="{{ block.settings.tab_title }} Image" />
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.tax-info-tabs {
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}

.tab-nav {
  display: flex;
  list-style: none;
  padding: 0;
  border-bottom: 1px solid #ddd;
}

.tab-nav button {
  width: 50%;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: transparent;
  border: none;
  padding: 10px 20px;
  position: relative;
  font-family: DM Sans;
  cursor: pointer;
}

.tab-nav button::after {
  content: '';
  display: block;
  width: 100%;
  height: 4px;
  position: absolute;
  background: #e5e5e5;
  border-radius: 6px;
  bottom: -4px;
  transition: all 0.3s ease;
}

.tab-nav button.active::after {
  background: #f1592a;
}

.tab-content {
  padding-bottom: 60px;
  padding-top: 40px;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: flex;
  align-items: center;
}

.paraDiv, .tab-image {
  flex: 1;
}

.tab-image img {
  width: 100%;
}

.paraDiv strong {
  font-family: DM Sans;
  font-weight: 700;
  font-size: 24px;
  line-height: 32px;
  letter-spacing: 0px;
}

.paraDiv {
  margin-right: 40px;
}

.paraDiv p {
  font-family: DM Sans;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
}

.paraDiv li:before {
  content: "";
  border: 4px #FE8425 solid;
  border-radius: 50px;
  margin-top: 8px;
  margin-left: -20px;
  position: absolute;
}

.paraDiv ul {
  margin-left: 20px;
}

.paraDiv li {
  margin-bottom: 12px;
}

.tab-information {
  background: #F5F5F5;
}

.accordion-header {
  display: none;
  font-family: DM Sans;
  font-weight: 500;
  font-size: 16px;
  padding: 15px;
  background: #f5f5f5;
  border-bottom: 1px solid #ddd;
  cursor: pointer;
  position: relative;
}

.accordion-header::after {
  content: '+';
  position: absolute;
  right: 15px;
  font-size: 20px;
}

.accordion-header.active::after {
  content: '−';
}

.accordion-content {
  display: block;
}

/* Mobile styles */
@media (max-width: 767px) {
  .tab-nav {
    display: none;
  }

  .tab-content {
    padding: 0;
  }

  .tab-pane {
    display: block;
    border-bottom: 1px solid #ddd;
  }

  .tab-pane.active .accordion-content {
    display: block;
  }

  .accordion-header {
    display: block;
  }

  .accordion-content {
    display: none;
    padding: 15px;
  }

  .tab-pane.active {
    display: block;
    flex-direction: column;
  }

  .paraDiv {
    margin-right: 0;
    margin-bottom: 20px;
  }

  .tab-image {
    width: 100%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.tab-nav button');
  const panes = document.querySelectorAll('.tab-pane');
  const accordionHeaders = document.querySelectorAll('.accordion-header');

  // Tab functionality for desktop
  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      tabs.forEach(t => t.classList.remove('active'));
      panes.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      document.getElementById(this.getAttribute('data-tab')).classList.add('active');
    });
  });

  // Accordion functionality for mobile
  accordionHeaders.forEach(header => {
    header.addEventListener('click', function() {
      const content = this.nextElementSibling;
      const parentPane = this.parentElement;
      const isActive = parentPane.classList.contains('active');

      // Close all other accordions
      panes.forEach(pane => {
        pane.classList.remove('active');
        pane.querySelector('.accordion-content').style.display = 'none';
        pane.querySelector('.accordion-header').classList.remove('active');
      });

      // Toggle current accordion
      if (!isActive) {
        parentPane.classList.add('active');
        content.style.display = 'block';
        this.classList.add('active');
      }
    });
  });

  // Open first accordion by default on mobile
  if (window.innerWidth <= 767) {
    const firstPane = document.querySelector('.tab-pane.active');
    if (firstPane) {
      firstPane.querySelector('.accordion-content').style.display = 'block';
      firstPane.querySelector('.accordion-header').classList.add('active');
    }
  }
});
</script>