{% schema %}
{
  "name": "Tab Information",
  "class": "tab-information",
  "settings": [],
  "blocks": [
    {
      "type": "richtext",
      "name": "Tab",
      "settings": [
        {
          "type": "richtext",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "<p>New Tab</p>"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab Content",
          "default": "<p>Enter tab content here.</p>"
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Tab Image",
          "info": "<p>Upload an image to display on the right side for this tab.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tab Information",
      "category": "Custom",
      "blocks": [
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>US States, US Territories, Canada</p>",
            "tab_content": "<p>For California buyers, sales tax will be calculated based on the combined state, county, and district rates, which ranges from 7.25% to 10.25%. For Washington buyers, sales tax will be calculated based on the applicable destination rate, which ranges from 7.0% to 10.6%. 5% sales tax will be charged for Wisconsin buyers and 6.625% will be charged to New Jersey buyers upon checkout.\n\nUS Territories Buyers: No additional fees will be charged upon delivery. Our online checkout price includes door-to-door shipping to your address, which amount to 10.5% for Puerto Rico and 4% for Guam. No taxes for USVI.\n\nCanada Buyers: Ontario: 13%, Atlantic provinces (Newfoundland, Nova Scotia, New Brunswick, PEI): 15%, All other provinces (Alberta, British Columbia, Manitoba, Northwest Territories, Nunavut, Quebec, Saskatchewan, Yukon): 5%</p>"
          }
        },
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>Other Countries</p>",
            "tab_content": "<p>Content for other countries goes here.</p>"
          }
        },
        {
          "type": "richtext",
          "settings": {
            "tab_title": "<p>Special Conditions</p>",
            "tab_content": "<p>Special conditions content goes here.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="tax-info-tabs">
  <div class="tab-nav tabs__buttons">
    {% for block in section.blocks %}
      <button class="tab-btn {% if forloop.first %}active{% endif %}" 
              data-tab="tab-{{ block.id }}"
              aria-controls="tab-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
        {{ block.settings.tab_title }}
      </button>
    {% endfor %}
  </div>
  <div class="accordion-container">
    {% for block in section.blocks %}
      <div class="accordion-item">
        <button class="accordion-header-info"
                type="button"
                data-tab="tab-{{ block.id }}"
                aria-expanded="false"
                aria-controls="tab-{{ block.id }}">
          <span class="accordion-header-info__text">{{ block.settings.tab_title }}</span>
          {% render 'chevron' %}
        </button>
        <div class="accordion-content-info tab-pane {% if forloop.first %}active{% endif %}" 
             id="tab-{{ block.id }}"
             role="region"
             aria-labelledby="tab-{{ block.id }}-header">
          <div class="paraDiv">{{ block.settings.tab_content | newline_to_br }}</div>
          {% if block.settings.tab_image %}
            {%- assign tab_alt = block.settings.tab_title | strip_html | strip -%}
            <div class="tab-image">
              {{-
                block.settings.tab_image
                | image_url: width: 1600
                | image_tag:
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: '(min-width: 990px) 45vw, calc(100vw - 32px)',
                  loading: 'lazy',
                  alt: tab_alt
              -}}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.tab-information .tax-info-tabs {
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px;
}

.tab-information .tax-info-tabs .tab-nav {
  display: flex;
  list-style: none;
  padding: 0;
  border-bottom: 1px solid #ddd;
}

.tab-information .tax-info-tabs .tab-nav button {
  width: 50%;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: transparent;
  border: none;
  padding: 10px 20px;
  position: relative;
  font-family: var(--font-body-family);
  cursor: pointer;
}

.tab-information .tax-info-tabs .tab-nav button::after {
  content: '';
  display: block;
  width: 100%;
  height: 4px;
  position: absolute;
  background: #e5e5e5;
  border-radius: 6px;
  bottom: -4px;
  transition: all 0.3s ease;
}

.tab-information .tax-info-tabs .tab-nav button.active::after {
  background: #D83D0E;
}

.tab-information .tax-info-tabs .accordion-container {
 /* display: none;*/
}

.tab-information .tax-info-tabs .tab-pane {
  display: none;
  padding: 40px 0 60px;
}

.tab-information .tax-info-tabs .tab-pane.active {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 40px;
}

.tab-information .paraDiv {
  flex: 1;
  margin-right: 40px;
}

.tab-information .tab-image {
  flex: 1;
  text-align: right;
}

.tab-information .tab-image img {
  max-width: 100%;
  height: auto;
}

.tab-information .paraDiv strong {
  font-family: var(--font-body-family);
  font-weight: 700;
  font-size: 24px;
  line-height: 32px;
}

.tab-information .paraDiv p {
  font-family: var(--font-body-family);
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
}

/* The li must be the containing block, otherwise the absolutely positioned
   bullet escapes a collapsed (max-height: 0) accordion panel on mobile. */
.tab-information .paraDiv li {
  position: relative;
}

.tab-information .paraDiv li:before {
  content: "";
  border: 4px #FE8425 solid;
  border-radius: 50px;
  margin-top: 8px;
  margin-left: -20px;
  position: absolute;
}

.tab-information .paraDiv ul {
  margin-left: 20px;
}

.tab-information .paraDiv li {
  margin-bottom: 12px;
}

.tab-information {
  background: #FAF9F9;
}

  

@media screen and (min-width: 769px) {
  .tab-information .accordion-header-info{
    display: none;
  }
  .tab-information .tab-image img{
    width: 100%;
  }
}

  
@media screen and (max-width: 768px) {
  .tab-information .tax-info-tabs {
    padding: 16px;
  }

  .tab-information .accordion-header-info p {
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0px;
    color: #000000;
    margin: 0;
  }

  .tab-information .tax-info-tabs .tab-nav {
    display: none;
  }

  .tab-information .tax-info-tabs .accordion-container {
    display: block;
  }

  /* 16px between rows, so each 40px row sits on a 56px pitch */
  .tab-information .tax-info-tabs .accordion-item {
    margin-bottom: 16px;
    height: auto !important;
  }

  .tab-information .tax-info-tabs .accordion-item:last-child {
    margin-bottom: 0;
  }

  .tab-information .tax-info-tabs .accordion-header-info {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-body-family);
    font-size: 18px;
    line-height: 24px;
    font-weight: 700;
    color: #000000;
    background: transparent;
    border: none;
    padding: 8px 0;
    text-align: left;
    cursor: pointer;
  }

  .tab-information .tax-info-tabs .accordion-header-info .accordion-chevron {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }

  .tab-information .tax-info-tabs .accordion-header-info[aria-expanded='true'] .accordion-chevron {
    transform: rotate(180deg);
  }

  /* Every panel participates on mobile; `is-open` (not the desktop tab's
     `active`) decides which one is expanded, so the page opens fully collapsed. */
  .tab-information .tax-info-tabs .tab-pane {
    display: flex;
  }

  /* Neutralise the desktop tab row layout on the preselected first pane. */
  .tab-information .tax-info-tabs .tab-pane.active {
    align-items: stretch;
    gap: 0;
  }

  .tab-information .tax-info-tabs .accordion-content-info {
    max-height: 0;
    overflow: hidden;
    flex-direction: column;
    transition: max-height 0.3s ease-out;
    padding: 0;
    background: transparent;
    border: none;
  }

  .tab-information .tax-info-tabs .accordion-content-info.is-open {
    max-height: 3000px;
    padding: 12px 0 4px;
    flex-direction: column;
    gap: 0;
  }

  .tab-information .tax-info-tabs .accordion-content-info .paraDiv {
    margin-right: 0;
    margin-bottom: 20px;
  }

  .tab-information .tax-info-tabs .accordion-content-info .tab-image {
    text-align: center;
    width: 100%;
  }

  .tab-information .tax-info-tabs .accordion-content-info .tab-image img {
    max-width: 100%;
  
    width: 100%;
        object-fit: cover;
  }

  .tab-information .paraDiv strong{
    font-family: var(--font-body-family);
font-weight: 700;
font-size: 16px;
line-height: 24px;
letter-spacing: 0;
  }

  .tab-information .paraDiv li{
    font-family: var(--font-body-family);
font-weight: 400;
font-size: 16px;
line-height: 24px;
letter-spacing: 0px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;

  // Desktop: tab strip.
  var tabs = Array.prototype.slice.call(root.querySelectorAll('.tab-nav button'));
  var panes = Array.prototype.slice.call(root.querySelectorAll('.tab-pane'));

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      panes.forEach(function (p) {
        p.classList.remove('active');
      });
      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');
      var pane = root.querySelector('[id="' + this.getAttribute('data-tab') + '"]');
      if (pane) pane.classList.add('active');
    });
  });

  // Mobile: accordion. `is-open` is separate from the desktop tab's `active`
  // so the mobile view starts with every row collapsed, as the design shows.
  var headers = Array.prototype.slice.call(root.querySelectorAll('.accordion-header-info'));

  function closeAll() {
    headers.forEach(function (h) {
      h.classList.remove('active');
      h.setAttribute('aria-expanded', 'false');
    });
    panes.forEach(function (p) {
      p.classList.remove('is-open');
      p.style.maxHeight = '';
    });
  }

  headers.forEach(function (header) {
    header.addEventListener('click', function () {
      var content = this.nextElementSibling;
      var wasOpen = this.classList.contains('active');
      closeAll();
      if (!wasOpen && content) {
        this.classList.add('active');
        this.setAttribute('aria-expanded', 'true');
        content.classList.add('is-open');
        content.style.maxHeight = content.scrollHeight + 'px';
      }
    });
  });

  function refreshOpenHeights() {
    root.querySelectorAll('.accordion-content-info.is-open').forEach(function (content) {
      content.style.maxHeight = content.scrollHeight + 'px';
    });
  }

  window.addEventListener('resize', refreshOpenHeights);

  root.querySelectorAll('.tab-image img').forEach(function (img) {
    img.addEventListener('load', refreshOpenHeights);
  });
});
</script>