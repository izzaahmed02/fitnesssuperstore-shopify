{% schema %}
{
  "name": "Product Downloads",
  "class": "product-downloads-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Downloads"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "default": "2",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Downloads"
    }
  ]
}
{% endschema %}

{%- assign extra = product.metafields.custom.extra_info.value -%}

{% assign has_downloads = false %}

{% if extra and extra.downloads != blank and extra.downloads.value != blank %}
  {% for link in extra.downloads.value %}
    {% if link.url != blank %}
      {% assign has_downloads = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if has_downloads %}
  <div class="product-downloads-wrap">
    <h2 class="product-downloads-heading">{{ section.settings.heading }}</h2>

    <div class="product-downloads-grid columns-{{ section.settings.columns_desktop }}">
      {% for link in extra.downloads.value %}
        {% if link.url != blank %}
          {%- assign raw_url = link.url -%}
          {%- assign clean_url = raw_url | split:'?' | first -%}
          {%- assign file_name = clean_url | split:'/' | last -%}
          {%- assign ext = file_name | split:'.' | last | downcase -%}

          {%- comment -%}
            Display label:
            - Prefer link.text (what you type in the metaobject link label)
            - Otherwise fall back to filename
          {%- endcomment -%}
          {%- assign label = link.text | default: file_name -%}

          <a class="download-card" href="{{ raw_url }}" target="_blank" rel="noopener">
            <span class="download-icon" aria-hidden="true">
              <!-- simple download icon -->
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3v10m0 0l4-4m-4 4l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="download-content">
              <span class="download-title">{{ label }}</span>

              <span class="download-meta">
                {% if ext != blank %}
                  <span class="download-pill">{{ ext | upcase }}</span>
                {% else %}
                  <span class="download-pill">FILE</span>
                {% endif %}
              </span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .product-downloads-wrap{
      max-width: 1320px;
      padding: 20px 12px;
      margin: 0 auto;
    }

    .product-downloads-heading{
      font-family: Lato;
      font-weight: 700;
      letter-spacing: normal;
      font-size: 28px;
      line-height: 1.3;
      text-transform: none;
      text-align: left;
      margin-bottom: 16px;
    }

    .product-downloads-grid{
      display: grid;
      gap: 16px;
    }

    .product-downloads-grid.columns-1{ grid-template-columns: 1fr; }
    .product-downloads-grid.columns-2{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-downloads-grid.columns-3{ grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .download-card{
      display: flex;
      gap: 14px;
      align-items: center;
      border: 1px solid #E6E6EA;
      border-radius: 16px;
      padding: 14px 16px;
      text-decoration: none;
      transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
      background: #fff;
    }

    .download-card:hover{
      transform: translateY(-1px);
      box-shadow: 0 8px 22px rgba(0,0,0,0.08);
      border-color: #D8D8DF;
    }

    .download-icon{
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #F1592A;
      background: rgba(241, 89, 42, 0.08);
      flex: 0 0 auto;
    }

    .download-content{
      display: flex;
      flex-direction: column;
      min-width: 0;
      gap: 8px;
      flex: 1 1 auto;
    }

    .download-title{
      color: #F1592A;
      font-family: Lato;
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      word-break: break-word;
    }

    .download-meta{
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .download-pill{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: Lato;
      font-size: 12px;
      line-height: 1;
      padding: 6px 10px;
      border-radius: 999px;
      background: #F2F2F6;
      color: #23232B;
    }

    @media (max-width: 749px){
      .product-downloads-wrap{ padding: 16px; }
      .product-downloads-heading{ font-size: 20px; margin-bottom: 12px; }
      .product-downloads-grid{ grid-template-columns: 1fr !important; }
    }
  </style>
{% endif %}