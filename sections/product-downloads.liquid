{% schema %}
{
  "name": "Product Downloads",
  "class": "product-downloads-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Downloads"
    }
  ],
  "presets": [
    {
      "name": "Product Downloads"
    }
  ]
}
{% endschema %}

{%- assign extra = product.metafields.custom.extra_info.value -%}
{% assign has_downloads = false %}

{% if extra and extra.downloads != blank and extra.downloads.value != blank %}
  {% for link in extra.downloads.value %}
    {% if link.url != blank %}
      {% assign has_downloads = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if has_downloads %}
  <div class="fs-downloads">
    <h2 class="fs-downloads__title">{{ section.settings.heading }}</h2>

    <div class="fs-downloads__files">
      {% for link in extra.downloads.value %}
        {% if link.url != blank %}
          {%- assign raw_url = link.url -%}
          {%- assign clean_url = raw_url | split: '?' | first -%}
          {%- assign file_name = clean_url | split: '/' | last -%}
          {%- assign ext = file_name | split: '.' | last | downcase -%}
          {%- assign label = link.text | default: file_name -%}

          <a
            class="fs-downloads__file"
            href="{{ raw_url }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ label }}"
          >
            <span class="fs-downloads__file-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 4V13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M8.5 9.5L12 13L15.5 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 15.5V18C5 19.1046 5.89543 20 7 20H17C18.1046 20 19 19.1046 19 18V15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>

            <span class="fs-downloads__file-text">
              <span class="fs-downloads__file-name">{{ label }}</span>
              <span class="fs-downloads__file-pill">
                {{ ext | default: 'pdf' | upcase }}
              </span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .fs-downloads {
      max-width: 490px;
      padding: 20px 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      background: #FFFFFF;
    }

    .fs-downloads__title {
      margin: 0;
      font-family: 'Lato', sans-serif;
      font-style: normal;
      font-weight: 700;
      font-size: 28px;
      line-height: 36px;
      display: flex;
      align-items: center;
      color: #000000;
    }

    .fs-downloads__files {
      width: 100%;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      align-content: flex-start;
      gap: 8px 16px;
      padding: 0;
    }

    .fs-downloads__file {
      box-sizing: border-box;
      width: calc(50% - 8px);
      min-width: 0;
      min-height: 66px;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 8px;
      padding: 12px;
      background: #FFFFFF;
      border: 1px solid #E5E5E5;
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .fs-downloads__file:hover {
      border-color: #d6d6d6;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .fs-downloads__file-icon {
      width: 24px;
      height: 24px;
      min-width: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #F1592A;
      flex: 0 0 auto;
      margin-top: 1px;
    }

    .fs-downloads__file-text {
      min-width: 0;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 2px;
      height: 42px;
    }

    .fs-downloads__file-name {
      width: 100%;
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;

      font-family: 'Lato', sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      color: #F1592A;
    }

    .fs-downloads__file-pill {
      display: inline-flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      padding: 2px 4px;
      height: 16px;
      min-width: 24px;
      background: #F2F2F2;
      border-radius: 8px;

      font-family: 'Lato', sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: 8px;
      line-height: 12px;
      color: #393940;
      box-sizing: border-box;
    }

    @media (max-width: 749px) {
      .fs-downloads {
        max-width: 100%;
        padding: 20px 16px;
      }

      .fs-downloads__title {
        font-size: 28px;
        line-height: 36px;
      }

      .fs-downloads__files {
        gap: 8px;
      }

      .fs-downloads__file {
        width: 100%;
      }
    }
  </style>
{% endif %}