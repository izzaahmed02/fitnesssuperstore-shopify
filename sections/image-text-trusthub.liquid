{{- 'why-customers-trust-us.css' | asset_url | stylesheet_tag -}}

{%- style -%}
@media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }
}

#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
{%- endstyle -%}

<div class="why-trust color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">

    {%- if section.settings.title != blank -%}
      <div class="why-trust__header">
        <h2 class="why-trust__title {{ section.settings.heading_size }}">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.show_title_bar -%}
          <div class="why-trust__title-bar"></div>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="why-trust__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="why-trust__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'trust_block' -%}
            {%- assign layout = block.settings.layout -%}
            {%- assign has_image = false -%}
            {%- if block.settings.image != blank -%}
              {%- assign has_image = true -%}
            {%- endif -%}

            <div
              class="why-trust__block why-trust__block--{{ layout }} {% if forloop.last %}why-trust__block--last{% endif %}"
              {{ block.shopify_attributes }}
            >

              {%- if layout == 'image_first' -%}

                {%- if has_image -%}
                  <div class="why-trust__block-image">
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(min-width: 990px) 45vw, (min-width: 750px) 50vw, 100vw',
                        class: 'why-trust__img'
                    }}
                  </div>
                {%- endif -%}

                <div class="why-trust__block-text">
                  {%- if block.settings.icon != blank -%}
                    <div class="why-trust__icon">{{ block.settings.icon }}</div>
                  {%- endif -%}
                  {%- if block.settings.block_title != blank -%}
                    <h3 class="why-trust__block-title">{{ block.settings.block_title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.block_text != blank -%}
                    <div class="why-trust__block-desc rte">{{ block.settings.block_text }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                    <a class="why-trust__btn button" href="{{ block.settings.button_url }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>

              {%- else -%}

                <div class="why-trust__block-text">
                  {%- if block.settings.icon != blank -%}
                    <div class="why-trust__icon">{{ block.settings.icon }}</div>
                  {%- endif -%}
                  {%- if block.settings.block_title != blank -%}
                    <h3 class="why-trust__block-title">{{ block.settings.block_title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.block_text != blank -%}
                    <div class="why-trust__block-desc rte">{{ block.settings.block_text }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                    <a class="why-trust__btn button" href="{{ block.settings.button_url }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>

                {%- if has_image -%}
                  <div class="why-trust__block-image">
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(min-width: 990px) 45vw, (min-width: 750px) 50vw, 100vw',
                        class: 'why-trust__img'
                    }}
                  </div>
                {%- endif -%}

              {%- endif -%}

            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.blocks.size == 0 -%}
      <div class="why-trust__empty-state">
        {{ 'sections.image_banner.add_content' | t }}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Why Customers Trust Us",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "WHY CUSTOMERS TRUST US",
      "label": "Section title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_title_bar",
      "label": "Show title accent bar",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color override",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "trust_block",
      "name": "Trust block",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "image_first", "label": "Image first" },
            { "value": "text_first", "label": "Text first" }
          ],
          "default": "image_first",
          "info": "Alternate between Image first and Text first for a zigzag layout"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji (optional)",
          "placeholder": "e.g. 🏭 or leave blank"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Heading",
          "default": "Come see it for yourself"
        },
        {
          "type": "richtext",
          "id": "block_text",
          "label": "Description",
          "default": "<p>We operate from Benicia, California, where you can visit our public showroom, inspect equipment, and speak with specialists who know the machines.</p>"
        },
        {
          "type": "header",
          "content": "Button (optional)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Customers Trust Us",
      "blocks": [
        {
          "type": "trust_block",
          "settings": {
            "layout": "image_first",
            "block_title": "Come see it for yourself",
            "block_text": "<p>We operate from Benicia, California, where you can visit our public showroom, inspect equipment, and speak with specialists who know the machines. Our public showroom is at 457 Industrial Way.</p>"
          }
        },
        {
          "type": "trust_block",
          "settings": {
            "layout": "text_first",
            "block_title": "We don't disappear after the sale",
            "block_text": "<p>Remanufactured machines include 1-year parts and labor with extended options up to 5 years. French Fitness core categories carry 10-year frame, 10-year parts, and 1-year labor coverage in the USA and Canada.</p>"
          }
        },
        {
          "type": "trust_block",
          "settings": {
            "layout": "image_first",
            "block_title": "Delivery that fits your situation",
            "block_text": "<p>We offer curbside, garage delivery, room-of-choice delivery, and delivery with assembly. Direct delivery is available within range of our Benicia warehouse for Northern California customers.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}