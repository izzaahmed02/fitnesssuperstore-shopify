{{ 'homepage-section-hero.css' | asset_url | stylesheet_tag: preload: true }}

<div class="hero-section">
  <div class="image-wrapper">
    <picture>
      <source srcset="{{ section.settings.background_image | image_url: width: 1000, format: 'webp' }}" type="image/webp">
      <img 
        src="{{ section.settings.background_image | image_url: width: 1000 }}" 
        alt="{{ section.settings.title_text | escape }}" 
        class="hero-bg"
        loading="eager" 
        fetchpriority="high"
        width="1030"
        height="auto"
      >
    </picture>

    <div class="overlay"></div> 

    <div class="content">
      <div class="description">
        {% if section.settings.rating_link != blank %}
        <a class="rating-button-link" href="{{ section.settings.rating_link }}">
        {% endif %}
          <div class="ratingBlock">
            <div class="rating">
              {% render 'rating' %}
            </div>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% if section.settings.rating_link != blank %}
        </a>
        {% endif %}
        <a href="{{ section.settings.button_link }}" class="bannerBtn mobile button button--secondary">
            {{ section.settings.button_text }}
            {% render 'chevron-button' %}
        </a>
      </div>

      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
        <p class="copyText">{{ section.settings.copy_text }}</p>
      </div>

      <a href="{{ section.settings.button_link }}" class="bannerBtn desktop button button--secondary">
        {{ section.settings.button_text }}
        {% render 'chevron-button' %}
      </a>
    </div>
  </div>

  <div class="questions">
    <div class="questions-wrapper">
      <div class="benefit-card">
        <div class="text">
          <h2>Why Choose Us</h2>
          <p>{{ section.settings.why_choose_us }}</p>
        </div>
      </div>
      <div class="benefit-card">
        <div class="text">
          <h2>Warranty</h2>
          <p>{{ section.settings.warranty_text }}</p>
        </div>
      </div>
      <div class="benefit-card">
        <div class="text">
          <h2>Mission</h2>
          <p>{{ section.settings.mission_text }}</p>
        </div>
      </div>
    </div>
    <div class="carousel-dots">
      <span class="dot active" data-index="0"></span>
      <span class="dot" data-index="1"></span>
      <span class="dot" data-index="2"></span>
    </div>
  </div>
</div>

<style>
  .image-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    width: 100%;
  }
  .image-wrapper picture {
    width:100%;
    position: absolute;
    top: 0;
    height: 100%;
}

  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .image-wrapper .content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 20px;
    width: 100%;
    background: linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.4) 50%), linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.3) 68.4%);
  }

  /* Carousel styles for mobile */
  .questions {
    position: relative;
  }

  .carousel-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    padding-bottom: 16px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #D1D1D1;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background-color: #53565A;
    transform: scale(1.25);
  }

  @media (max-width: 768px) {
    .questions-wrapper {
      display: flex;
      overflow-x: scroll;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 16px;
      padding: 24px 16px;
    }

    .questions-wrapper::-webkit-scrollbar {
      display: none;
    }

    .questions-wrapper .benefit-card {
      flex: 0 0 calc(100% - 32px);
      min-width: calc(100% - 32px);
      scroll-snap-align: center;
      scroll-snap-stop: always;
      margin: 0;
    }

    .carousel-dots {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .questions-wrapper .benefit-card {
      flex: 0 0 calc(100% - 32px);
      min-width: calc(100% - 32px);
    }
  }
</style>

<script>
  (function() {
    if (window.innerWidth > 768) return; // Only run on mobile
    
    const questionsWrapper = document.querySelector('.questions-wrapper');
    const dots = document.querySelectorAll('.carousel-dots .dot');
    const cards = document.querySelectorAll('.benefit-card');

    if (!questionsWrapper || !dots.length) return;

    let isScrolling;

    // Update active dot based on scroll position
    function updateActiveDot() {
      const scrollLeft = questionsWrapper.scrollLeft;
      const cardWidth = cards[0].offsetWidth + 16; // Include gap
      const activeIndex = Math.round(scrollLeft / cardWidth);

      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === activeIndex);
      });
    }

    // Scroll to card when dot is clicked
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth + 16; // Include gap
        questionsWrapper.scrollTo({
          left: cardWidth * index,
          behavior: 'smooth'
        });
      });
    });

    // Update dots on scroll with debounce
    questionsWrapper.addEventListener('scroll', () => {
      window.clearTimeout(isScrolling);
      isScrolling = setTimeout(() => {
        updateActiveDot();
      }, 50);
    });

    // Ensure proper snap on touch end
    questionsWrapper.addEventListener('touchend', () => {
      setTimeout(updateActiveDot, 100);
    });

    // Initialize first dot as active
    updateActiveDot();
  })();
</script>

{% schema %}
{
  "name": "Homepage Hero Section",
  "class": "heroSection",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Rating Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Elevate Your Fitness. Buy Top Quality Gym Equipment."
    },
     {
      "type": "text",
      "id": "copy_text",
      "label": "Text",
      "default": "Transform your space with new, used, or remanufactured top gym equipment from brands like Precor, Life Fitness & more. Fitness Superstore offers 5-star service, nationwide delivery, and industry-leading warranties, giving unmatched value for home or commercial setups."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "richtext",
      "id": "why_choose_us",
      "label": "Why Choose Us Text",
      "default": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>"
    },
    {
      "type": "richtext",
      "id": "warranty_text",
      "label": "Warranty Text",
      "default": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Hero Section",
      "settings": {
        "rating_text": "4.9/5 by Thousands of happy customers",
        "title_text": "Elevate Your Fitness. Buy Top Quality Gym Equipment.",
        "button_text": "Shop Now",
        "button_link": "/collections/all",
        "why_choose_us": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>",
        "warranty_text": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>",
        "mission_text": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
      }
    }
  ]
}
{% endschema %}
