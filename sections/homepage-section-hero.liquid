{{ 'homepage-section-hero.css' | asset_url | stylesheet_tag: preload: true }}

<div class="hero-section">
  <div class="image-wrapper">
    <picture>
      {%- comment -%} Serve WebP first with PNG/JPEG fallback {%- endcomment -%}
      <source srcset="{{ section.settings.background_image | image_url: width: 1000, format: 'webp' }}" type="image/webp">
      <img 
        src="{{ section.settings.background_image | image_url: width: 1000 }}" 
        alt="{{ section.settings.title_text | escape }}" 
        class="hero-bg"
        loading="eager" 
        fetchpriority="high"
        width="1030"
        height="auto"
      >
    </picture>

    <div class="overlay"></div> 

    <div class="content">
      <div class="description">
        {% if section.settings.rating_link != blank %}
        <a class="rating-button-link" href="{{ section.settings.rating_link }}">
        {% endif %}
          <div class="ratingBlock">
            <div class="rating">
              {% render 'rating' %}
            </div>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% if section.settings.rating_link != blank %}
        </a>
        {% endif %}
        <a href="{{ section.settings.button_link }}" class="bannerBtn mobile button button--secondary">
            {{ section.settings.button_text }}
            {% render 'chevron-button' %}
        </a>
        <a href="{{ section.settings.button_link_1 }}" class="bannerBtn mobile button button--primary">
            {{ section.settings.button_text_1 }}
            {% render 'chevron-button' %}
        </a>
      </div>

      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
        <p class="copyText">{{ section.settings.copy_text }}</p>
      </div>

      <div class="btn-container">

      <a href="{{ section.settings.button_link }}" class="bannerBtn desktop button button--secondary">
        {{ section.settings.button_text }}
        {% render 'chevron-button' %}
      </a>
     
      
      </div>
      
    </div>
  </div>

  <div class="questions">
    <div class="benefit-card">
      <div class="text">
       
        <h2>Why Choose Us</h2>
        <p>{{ section.settings.why_choose_us }}</p>
      </div>
     
    </div>
    <div class="benefit-card">
      <div class="text">
        
        <h2>Warranty</h2>
        <p>{{ section.settings.warranty_text }}</p>
      </div>
    
    </div>
    <div class="benefit-card">
      <div class="text">
      
        <h2>Mission</h2>
        <p>{{ section.settings.mission_text }}</p>
      </div>
     
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initHeroCarousel() {
      const $questions = $('.homepageHeroSection .questions');
      
      if (window.innerWidth <= 768) {
        // Initialize Slick only on mobile
        if (!$questions.hasClass('slick-initialized')) {
          $questions.slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            centerMode: true,
            centerPadding: '40px',
            arrows: false,
            dots: true,
            infinite: true,
            autoplay: false,
            responsive: [
              {
                breakpoint: 480,
                settings: {
                  centerPadding: '30px'
                }
              }
            ]
          });
        }
      } else {
        // Destroy Slick on desktop
        if ($questions.hasClass('slick-initialized')) {
          $questions.slick('unslick');
        }
      }
    }

    // Initialize on load
    initHeroCarousel();

    // Re-initialize on window resize
    let resizeTimer;
    $(window).on('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        initHeroCarousel();
      }, 250);
    });
  });
</script>

<style>
 .homepageHeroSection .btn-container {
  display: flex;
  order: 3;
  gap: 8px;
}
.homepageHeroSection .benefit-card .learn-more {
order: 2;
display: block;
width: 100%;

}
body .homepageHeroSection .learn-more .button {
text-align: center;
display: block;
background-color: #D83D0E33 !Important;
color: #D83D0E;
border-top: 1px solid #D83D0E33;
border-top-left-radius: 0px !Important;
border-top-right-radius: 0px !Important;
}
.homepageHeroSection .benefit-card {
padding: 0px;
justify-content: space-between;
}
.homepageHeroSection .benefit-card .text {
padding: 24px;
}
.homepageHeroSection .text h2 {
text-transform: initial;
}
.homepageHeroSection .benefits-img {
  display: block;
  width: 100%;
  text-align: center;
}
.homepageHeroSection .benefits-img img {
width: 60px;
margin: 0 auto;
}
.homepageHeroSection .cta-description {
order: 4;
font-size: 14px;
color: #B0B0B0;
}
.homepageHeroSection .cta-description span {
color: #D83D0E;
margin-left: 3px;
margin-right: 3px;
}
.homepageHeroSection .benefit-card .text span {
  color: #D83D0E;
  margin-left: 3px;
  margin-right: 3px;
}
.homepageHeroSection .cta-description p {
margin-top: 0px;
margin-bottom: 0px;
}
.homepageHeroSection .btn-container .bannerBtn.button--primary {
  background-color: #fff !important;
    color: #D83D0E;
}
.homepageHeroSection .content .description .bannerBtn.button--secondary {
  background-color: #fff !important;
    color: #D83D0E;
}
.homepageHeroSection .content .description .bannerBtn.button--primary svg path {
  fill: #fff;
}
.homepageHeroSection .content .description .bannerBtn.button--secondary svg path {
  fill: #D83D0E;
}

.homepageHeroSection .button--primary svg path {
  fill: #D83D0E;
}
  .homepageHeroSection .image-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    width: 100%;
  }
  .homepageHeroSection .image-wrapper picture {
    width:100%;
    position: absolute;
    top: 0;
    height: 100%;
}

  .homepageHeroSection .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .homepageHeroSection .image-wrapper .content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 43px 20px;
    width: 100%;
    background: linear-gradient(180deg, rgba(35, 35, 43, 0) 0%, rgba(35, 35, 43, 0.4) 50%), linear-gradient(269.75deg, rgba(35, 35, 43, 0) 1.15%, rgba(35, 35, 43, 0.3) 68.4%);
  }

  @media screen and (max-width: 767px) {
  .homepageHeroSection .cta-description p {
    text-align: center;
    }
  }
</style>



