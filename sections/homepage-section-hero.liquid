{{ 'homepage-section-hero.css' | asset_url | stylesheet_tag: preload: true }}

<div class="hero-section">
  <div class="image-wrapper">
    {% assign hero_image = section.settings.background_image %}
    {% assign hero_alt = section.settings.title_text | escape %}

    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 1800
        | image_tag:
          class: 'hero-bg',
          widths: '480, 768, 1000, 1400, 1800',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_alt
      }}
    {% endif %}

    <div class="overlay"></div> 

    <div class="content">
      <div class="description">
        {% if section.settings.rating_link != blank %}
        <a class="rating-button-link" href="{{ section.settings.rating_link }}">
        {% endif %}
          <div class="ratingBlock">
            <div class="rating">
              {% render 'rating' %}
            </div>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {% if section.settings.rating_link != blank %}
        </a>
        {% endif %}
     {% comment %}   <a href="{{ section.settings.button_link }}" class="bannerBtn mobile button button--secondary">
            {{ section.settings.button_text }}
            {% render 'chevron-button' %}
        </a> {% endcomment %}
        <a href="{{ section.settings.button_link_1 }}" class="bannerBtn mobile button button--primary">
            {{ section.settings.button_text_1 }}
            {% render 'chevron-button' %}
        </a>
      </div>

      <div class="title">
        <h1>{{ section.settings.title_text }}</h1>
        <p class="copyText">{{ section.settings.copy_text }}</p>
      </div>

      <div class="btn-container">

      <a href="{{ section.settings.button_link }}" class="bannerBtn desktop button button--secondary">
        {{ section.settings.button_text }}
        {% render 'chevron-button' %}
      </a>
     
      
      </div>
      
    </div>
  </div>

  <div class="questions">
    <div class="benefit-card">
      <div class="text">
       
        <h2>Why Choose Us</h2>
        <p>{{ section.settings.why_choose_us }}</p>
      </div>
     
    </div>
    <div class="benefit-card">
      <div class="text">
        
        <h2>Warranty</h2>
        <p>{{ section.settings.warranty_text }}</p>
      </div>
    
    </div>
    <div class="benefit-card">
      <div class="text">
      
        <h2>Mission</h2>
        <p>{{ section.settings.mission_text }}</p>
      </div>
     
    </div>
  </div>
</div>

{{ 'homepage-section-hero.js' | asset_url | script_tag: defer: true }}





{% schema %}
{
  "name": "Homepage Hero Section",
  "class": "homepageHeroSection",
  "settings": [
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9/5 by Thousands of happy customers"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Rating Link"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Elevate Your Fitness. Buy Top Quality Gym Equipment."
    },
     {
      "type": "text",
      "id": "copy_text",
      "label": "Text",
      "default": "Transform your space with new, used, or remanufactured top gym equipment from brands like Precor, Life Fitness & more. Fitness Superstore offers 5-star service, nationwide delivery, and industry-leading warranties, giving unmatched value for home or commercial setups."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "Second Button Text",
      "default": "Shop French Fitness"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Second Button Link",
      "default": "/collections/all"
    },
    
    {
      "type": "richtext",
      "id": "why_choose_us",
      "label": "Why Choose Us Text",
      "default": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>"
    },
    {
      "type": "richtext",
      "id": "warranty_text",
      "label": "Warranty Text",
      "default": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Hero Section",
      "settings": {
        "rating_text": "4.9/5 by Thousands of happy customers",
        "title_text": "Elevate Your Fitness. Buy Top Quality Gym Equipment.",
        "button_text": "Shop Now",
        "button_link": "/collections/all",
        "why_choose_us": "<p>Get biggest savings - up to 50% off MSRP. Shop new and remanufactured equipment, global shipping and full delivery service options available</p>",
        "warranty_text": "<p>Enjoy best warranty in the industry. French Fitness equipment: 10 year warranty for +1 year labor, Remanufactured equipment: 1 year parts and labor + extend to 5 years</p>",
        "mission_text": "<p>Our mission is to ensure every customer is satisfied and sees the customer value in their purchase</p>"
      }
    }
  ]
}
{% endschema %}