{% render 'rapid-search-results-template' %}
{% render 'rapid-search-results-template-v2' %}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'collection-section.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{% if section.settings.image_shape == 'blob' %}
    {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% comment %}<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>{% endcomment %}

<style>
    .template-search__header {
        margin-bottom: 3rem;
    }

    .template-search__search {
        margin: 0 auto 3.5rem;
        max-width: 74.1rem;
    }

    .template-search__search .search {
        margin-top: 3rem;
    }

    .template-search--empty {
        padding-bottom: 18rem;
    }

    @media screen and (min-width: 750px) {
        .template-search__header {
            margin-bottom: 5rem;
        }
    }

    .search__button .icon {
        height: 1.8rem;
    }
</style>

<div class="page-width">
    <h1>Search Results for "{{ search.terms }}"</h1>
    <div id="ProductGridContainer" class="collection-wrapper">
        <div class="collection-filter-wrapper">
            {{ 'component-facets.css' | asset_url | stylesheet_tag }}
            <aside
                    aria-labelledby="verticalTitle"
                    class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
                    id="main-collection-filters"
                    data-id="{{ section.id }}">
                {% render 'facets',
                        results: search,
                        enable_filtering: true,
                        enable_sorting: true,
                        filter_type: 'vertical',
                        paginate: paginate
                %}
            </aside>
        </div>
        <div id="ProductGridContainer" class="collection-product-wrapper">
            {%- liquid
                assign sort_by = search.sort_by | default: search.default_sort_by
                assign terms = search.terms | escape
                assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
            -%}
            <div class="collection-grid-top">
                <input type="text" id="search-input" placeholder="Search within page">
                <div class="right-side">
                    <facet-filters-form class="facets facets-vertical-sort small-hide">
                        <form class="facets-vertical-form" id="FacetSortForm">
                            <div class="facet-filters sorting caption">
                                <div class="facet-filters__field">
                                    <div class="select">
                                        {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                                        <select
                                                name="sort_by"
                                                class="facet-filters__sort select__select caption-large"
                                                id="SortBy"
                                                aria-describedby="a11y-refresh-page-message">
                                            {%- for option in search.sort_options -%}
                                                <option
                                                        value="{{ option.value | escape }}"
                                                        {% if option.value == sort_by %}
                                                            selected="selected"
                                                        {% endif %}
                                                >
                                                    {{ 'products.facets.sort_by_label' | t }}
                                                    {{ option.name | escape }}
                                                </option>
                                            {%- endfor -%}
                                        </select>
                                        {% render 'icon-caret' %}
                                    </div>
                                </div>
                            </div>
                        </form>
                    </facet-filters-form>
                    {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
                    {%- assign pageUrl = contentForQuerystring | split: '"pageurl":"' | last | split: '"' | first | split: '.myshopify.com' | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&' -%}
                    {%- assign products_per_page = 30 -%}
                    {%- for i in (1..1) -%}
                        {%- unless pageUrl contains "?" -%}{% break %}{%- endunless -%}
                        {%- if pageUrl contains "view=30" -%}{%- assign products_per_page = 30 -%}{%- endif -%}
                        {%- if pageUrl contains "view=60" -%}{%- assign products_per_page = 60 -%}{%- endif -%}
                        {%- if pageUrl contains "view=90" -%}{%- assign products_per_page = 90 -%}{%- endif -%}
                        {%- if pageUrl contains "view=120" -%}{%- assign products_per_page = 120 -%}{%- endif -%}
                        {%- if pageUrl contains "view=99999" -%}{%- assign products_per_page = 99999 -%}{%- endif -%}
                    {%- endfor -%}
                    <div class="sort-per-page">
                        <span class="label">Show </span>
                        <div class="select">
                            <select id="sel1" class="num">
                                <option value="/search?view=30"
                                        {% if products_per_page == 30 %}selected="selected"{% endif %}>30
                                </option>
                                <option value="/search?view=60"
                                        {% if products_per_page == 60 %}selected="selected"{% endif %}>60
                                </option>
                                <option value="/search?view=90"
                                        {% if products_per_page == 90 %}selected="selected"{% endif %}>90
                                </option>
                                <option value="/search?view=120"
                                        {% if products_per_page == 120 %}selected="selected"{% endif %}>120
                                </option>
                            </select>
                            {% render 'icon-caret' %}
                        </div>
                        <span class="label"> per page</span>
                    </div>
                </div>
            </div>
            <div class="tags-wrapper">
                {% paginate search.results by products_per_page %}
                    {% assign current_page = paginate.current_page %}
                    {% assign current_offset = paginate.current_offset %}
                    {% assign items_count = paginate.items %}
                {% endpaginate %}
                {% assign current_offset = current_offset | plus: 1 %}
                {% assign page_count = current_page | times: products_per_page %}
                <div class="collecion-count">
               <span>
                   {% if current_offset != items_count %} {{ current_offset }}-{% if page_count <= items_count %}{{ page_count }}{% else %}{{ items_count }}{% endif %}{% else %}{{ current_offset }}{% endif %}
               </span> of {{ items_count }}</div>
                <div class="active-facets active-facets-desktop">
                    {%- for filter in search.filters -%}
                        {%- for value in filter.active_values -%}
                            <facet-remove>
                                <a href="{{ value.url_to_remove }}"
                                   class="active-facets__button active-facets__button--light">
                        <span class="active-facets__button-inner button button--tertiary">
                          <span>{{ filter.label | escape }}: </span> {{ value.label | escape }}
                            {% render 'icon-close-small' %}
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                        </span>
                                </a>
                            </facet-remove>
                        {%- endfor -%}
                        {% if filter.type == 'price_range' %}
                            {% assign min = filter.min_value.value %}
                            {% assign max = filter.max_value.value %}
                            {%- if min != null or max != null -%}
                                <facet-remove>
                                    <a href="{{ filter.url_to_remove }}"
                                       class="active-facets__button active-facets__button--light">
                          <span class="active-facets__button-inner button button--tertiary">
                            {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                              {% render 'icon-close-small' %}
                            <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                          </span>
                                    </a>
                                </facet-remove>
                            {%- endif -%}
                        {% endif %}
                    {%- endfor -%}
                    <div class="active-facets-vertical-filter">
                        {% assign tagsCount = 0 %}
                        {%- for filter in search.filters -%}
                            {%- for value in filter.active_values -%}
                                {% assign tagsCount = tagsCount | plus: 1 %}
                            {% endfor %}
                        {% endfor %}
                        {% if tagsCount > 0 %}
                            <facet-remove class="active-facets__button-wrapper">
                                <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                      <span>
                        Clear all
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                  d="M5.46967 5.46967C5.76256 5.17678 6.23744 5.17678 6.53033 5.46967L12 10.9393L17.4697 5.46967C17.7626 5.17678 18.2374 5.17678 18.5303 5.46967C18.8232 5.76256 18.8232 6.23744 18.5303 6.53033L13.0607 12L18.5303 17.4697C18.8232 17.7626 18.8232 18.2374 18.5303 18.5303C18.2374 18.8232 17.7626 18.8232 17.4697 18.5303L12 13.0607L6.53033 18.5303C6.23744 18.8232 5.76256 18.8232 5.46967 18.5303C5.17678 18.2374 5.17678 17.7626 5.46967 17.4697L10.9393 12L5.46967 6.53033C5.17678 6.23744 5.17678 5.76256 5.46967 5.46967Z"
                                  fill="#E9380D"/>
                            </svg>
                      </span>
                                </a>
                            </facet-remove>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% paginate search.results by products_per_page %}
                <ul class="collection" id="product-grid" data-id="{{ section.id }}">
                    <div class="loading-overlay gradient"></div>
                    {%- for item in search.results -%}
                        {% assign lazy_load = false %}
                        {%- if forloop.index > 2 -%}
                            {%- assign lazy_load = true -%}
                        {%- endif -%}
                                            <li class="grid__item scroll-trigger animate--slide-in"
                                            {% if settings.animations_reveal_on_scroll %}
                                                data-cascade
                                                    {% endif %}>
                                                {%- case item.object_type -%}
                                                    {%- when 'product' -%}
                                                        {% render 'product-item', product: item %}
                                                        {%- assign skip_card_product_styles = true -%}
                                                {%- endcase -%}
                                            </li>
                    {%- endfor -%}
                </ul>
                {% assign size = paginate.parts | size %}
                {% unless size == 0 %}
                    <div class="pagination">
                        <a href="{{ paginate.previous.url }}">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                      d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z"
                                      fill="{% if paginate.previous %}#F1592A{% else %}#CCCCCC{% endif %}"/>
                            </svg>
                        </a>
                        {% for part in paginate.parts %}
                            {% if part.is_link %}
                                <a href="{{ part.url }}">{{ part.title }}</a>
                            {% else %}
                                <span class="current">{{ part.title }}</span>
                            {% endif %}
                        {% endfor %}
                        <a href="{{ paginate.next.url }}">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" clip-rule="evenodd"
                                      d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z"
                                      fill="{% if paginate.next %}#F1592A{% else %}#CCCCCC{% endif %}"/>
                            </svg>
                        </a>
                    </div>
                {% endunless %}
            {% endpaginate %}
        </div>
    </div>
</div>
<script>
	document.addEventListener('DOMContentLoaded', () => {
		const elements = document.querySelectorAll('.product-item .title');
		console.log(elements);
		elements.forEach((elem) => {
			if (elem.tagName === 'A') {
				const url = new URL(elem.href, window.location.origin);
				url.search = '';
				elem.href = url.toString();
			}
			else {
				const link = elem.querySelector('a');
				if (link) {
					const url = new URL(link.href, window.location.origin);
					url.search = '';
					link.href = url.toString();
				}
			}
		});
	});
</script>


<script src="{{ 'collection-section.js' | asset_url }}"></script>
<script src="{{ 'facets.js' | asset_url }}"></script>
{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section search searchNew",
  "settings": [
  ],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}
