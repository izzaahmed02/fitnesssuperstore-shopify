{{ 'section-brands.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: 48px;
    --background-image: url({{ section.settings.image | img_url:'' }})
  }

  .section-{{ section.id }} .show-more-btn {
    display: none;
  }
  
  @media screen and (max-width: 750px) {
    .section-{{ section.id }} .brands__list li {
      max-height: 24px;
    }
    .section-{{ section.id }} .brands__list li img{
      max-height: 24px;
      max-width: 170px;
    }
    .section-{{ section.id }} .brands__list{
      column-gap: 8px;
      row-gap: 8px;
      max-height: 144px;
      overflow-y: hidden;
      transition: max-height .3s ease;
    }
    .section-{{ section.id }} .show-more-btn {
      display: none;
      align-items: center;
      margin-top: 20px;
      font-family: 'Lato';
      font-size: 16px;
      font-weight: 700;
      line-height: 24px;
      color: var(--primary-orange);
      background-color: transparent;
      border: none;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="brands section-{{ section.id }} page-width">
  <ul class="brands__list">
    {% for block in section.blocks %}
      <li>
        {{ block.settings.image | img_url:'' | img_tag }}
      </li>
    {% endfor %}
  </ul>
  <button class="show-more-btn">
    <span>Show more</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="#F1592A"/>
    </svg>
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (window.innerWidth <= 749) {
      const brandList = document.querySelector(".section-{{ section.id }} .brands__list");
      const showMoreBtn = document.querySelector(".section-{{ section.id }} .show-more-btn");
    
      if (brandList.scrollHeight > 144) {
        showMoreBtn.style.display = "flex";
      }
    
      showMoreBtn.addEventListener("click", function () {
        if (brandList.style.maxHeight === "144px" || brandList.style.maxHeight === "") {
          brandList.style.maxHeight = brandList.scrollHeight + "px";
          showMoreBtn.querySelector('span').textContent = "Show less";
        } else {
          brandList.style.maxHeight = "144px";
          showMoreBtn.querySelector('span').textContent = "Show more";
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Brands",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands"
    }
  ]
}
{% endschema %}