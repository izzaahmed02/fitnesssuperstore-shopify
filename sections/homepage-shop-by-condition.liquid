<div class="shop-by-condition">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="condition-cards">
    {% for block in section.blocks %}
      {% if block.type == 'condition_card' %}
        <a
          href="{{ block.settings.link }}"
          class="condition-card"
          aria-label="Shop {{ block.settings.title }}"
          data-fss-hp-event="fss_hp_condition_select"
          data-fss-hp-props='{"condition": "{{ block.settings.condition }}"}'
        >
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 400 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title }}"
              loading="lazy"
              decoding="async"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% endif %}
          <span class="condition-card__title">{{ block.settings.title }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'supporting_link' %}
      <a href="{{ block.settings.link }}" class="shop-by-condition__supporting-link">{{ block.settings.text }}</a>
    {% endif %}
  {% endfor %}
</div>

<style>
.shop-by-condition {
  padding: 24px 16px;
}
.shop-by-condition h2 {
  font-size: 20px;
  line-height: 26px;
  margin: 0 0 16px;
}
.shop-by-condition .condition-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.shop-by-condition .condition-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  color: inherit;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  padding: 16px 8px;
}
.shop-by-condition .condition-card img {
  width: 100%;
  max-width: 140px;
  height: auto;
  margin-bottom: 8px;
}
.shop-by-condition .condition-card__title {
  font-weight: 700;
  font-size: 15px;
}
.shop-by-condition__supporting-link {
  display: block;
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
  text-decoration: underline;
  color: #4f4e4e;
}
</style>

{% schema %}
{
  "name": "Shop by Condition",
  "class": "shop-by-condition-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Condition"
    }
  ],
  "blocks": [
    {
      "type": "condition_card",
      "name": "Condition Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "condition",
          "label": "Condition value (new or remanufactured)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "supporting_link",
      "name": "Supporting Text Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "Browse French Fitness"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Condition",
      "category": "Custom",
      "blocks": [
        { "type": "condition_card" },
        { "type": "condition_card" },
        { "type": "supporting_link" }
      ]
    }
  ]
}
{% endschema %}
