{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{%- style -%}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
    }

    /* Full-width page requirement — override the theme's default contained .page-width
       for this section only (does not affect .page-width elsewhere on the site) */
    #shopify-section-{{ section.id }} .page-width {
    max-width: 100%;
    margin: 0;
    padding-left: 40px;
    padding-right: 40px;
    }

    /* Figma node 4685:81253 "Title" — heading (4685:81254) and subheading (4685:81255)
       stack vertically, both centered. The shared `.title-wrapper-with-link` class this
       markup also carries is a flex row (space-between) meant for a heading+link layout,
       which was putting the heading and subheading side by side instead — override it
       for this section only. */
    #shopify-section-{{ section.id }} .multicolumn__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    }

    #shopify-section-{{ section.id }} .equipment-zones__subheading {
    text-align: center;
    max-width: 800px;
    margin: 1.2rem auto 0;
    }

    /* Figma node 4612:88421/4612:88422 (mobile) — Oswald SemiBold 20px/26px; Lato Regular 14px/20px #4f4f55 */
    #shopify-section-{{ section.id }} .title.h1 {
    font-size: 20px;
    line-height: 26px;
    }

    #shopify-section-{{ section.id }} .equipment-zones__subheading {
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    line-height: 20px;
    color: #4f4f55;
    }

    /* Figma node 4685:81254/4685:81255 (desktop) — Oswald SemiBold 38px/50px; Lato Regular 16px/24px */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .title.h1 {
    font-size: 38px;
    line-height: 50px;
    }
    #shopify-section-{{ section.id }} .equipment-zones__subheading {
    font-size: 16px;
    line-height: 24px;
    }
    }

    /* Figma node 4598:83959 "What to Expect Container" — image and card column are each
       626px of a 1280px container with a 28px gap between them (1280 - 626 - 626 = 28). */
    #shopify-section-{{ section.id }} .equipment-zones__group {
    display: flex;
    align-items: stretch;
    gap: 28px;
    margin-top: 3rem;
    }

    #shopify-section-{{ section.id }} .equipment-zones__group--reverse {
    flex-direction: row-reverse;
    }

    /* Figma node 4612:88424 (mobile) — 6.77px radius, ~343/253 aspect. Mobile stacks the
       image and card column (see the max-width: 749px override below) in a COLUMN flex
       container, so no flex-basis is set here: `flex: 1 1 0` (used on desktop, where the
       row needs an even 50/50 split) forces an explicit 0 main size, and in a column
       direction the main axis is height — that zeroed the image out completely on mobile
       regardless of aspect-ratio, since an explicit flex-basis bypasses aspect-ratio-based
       auto sizing entirely. Without a flex-basis here, height falls back to being computed
       from aspect-ratio against the (stretched-to-full-width) cross size instead, which is
       what actually renders the image on small screens. */
    #shopify-section-{{ section.id }} .equipment-zones__image-wrapper {
    position: relative;
    border-radius: 7px;
    overflow: hidden;
    aspect-ratio: 343 / 253;
    }

    /* Figma node 4685:81257 (desktop) — 12px radius, even 50/50 split with the card column
       via flex-basis: 0 (only meaningful here, where the row is horizontal — the main axis
       is width). aspect-ratio is explicitly reset to auto: the mobile rule above sets
       aspect-ratio: 343 / 253, and a media query doesn't clear a property it doesn't
       redeclare, so without this the mobile ratio was still winning at desktop widths and
       forcing the image taller than the card column (most visible on the 2-card row)
       instead of letting align-items: stretch on .equipment-zones__group size it to match
       the cards exactly. */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .equipment-zones__image-wrapper {
    flex: 1 1 0;
    border-radius: 12px;
    aspect-ratio: auto;
    }
    }

    /* Absolutely positioned so the <img> itself never factors into
       .equipment-zones__image-wrapper's own auto height — otherwise the wrapper's
       percentage height: 100% would fall back to the image's intrinsic aspect ratio
       during layout and fight the stretch above. */
    #shopify-section-{{ section.id }} .equipment-zones__image-wrapper img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    }

    #shopify-section-{{ section.id }} .equipment-zones__image-wrapper--empty {
    background-color: rgba(var(--color-foreground), 0.05);
    }

    /* Figma "Benefit cards" — 12px gap between stacked cards. No flex-basis here for the
       same reason as .equipment-zones__image-wrapper above — flex: 1 1 0 only makes sense
       for the desktop row's 50/50 split (see the min-width: 750px rule below); on mobile,
       where .equipment-zones__group is a column, it would zero this out too. */
    #shopify-section-{{ section.id }} .equipment-zones__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    }

    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .equipment-zones__list {
    flex: 1 1 0;
    }
    }

    /* Figma "Benefit cards" (desktop) — icon left, text right, 32px padding, 20px gap.
       Mobile overrides both to a stacked icon-above-text layout with 16px padding — see
       the max-width: 749px rule below. */
    #shopify-section-{{ section.id }} .equipment-zones__card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 2rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 1.2rem;
    background: rgb(var(--color-background));
    }

    #shopify-section-{{ section.id }} .equipment-zones__icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: #fce6de;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    }

    #shopify-section-{{ section.id }} .equipment-zones__icon svg {
    width: 28px;
    height: 28px;
    }

    /* Figma "Benefit cards" text — Lato Bold 20/26 #000000 title, Lato Regular 16/24 #393940 body */
    #shopify-section-{{ section.id }} .equipment-zones__card-title {
    margin: 0 0 0.6rem;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
    }

    #shopify-section-{{ section.id }} .equipment-zones__card-text {
    margin: 0;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #393940;
    }

    @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    }

    @media screen and (max-width: 749px) {
    /* Figma node 4612:86426 "What to Expect Container" (mobile) — 20px gap between the
       image and the stacked card column, not the previous 2rem (32px). */
    #shopify-section-{{ section.id }} .equipment-zones__group,
    #shopify-section-{{ section.id }} .equipment-zones__group--reverse {
    flex-direction: column;
    gap: 20px;
    }

    /* Figma node 4612:86431 "Benefit cards" (mobile) — icon above text (not
       side by side), 16px padding on all sides instead of the desktop 32px.
       align-items: stretch (overriding the shared flex-start) so the text block
       fills the card's full width instead of shrinking to its own content width —
       in a column direction, flex-start sizes cross-axis (width) items to their
       intrinsic content size, which for a long paragraph is far wider than the
       card and would overflow instead of wrapping. */
    #shopify-section-{{ section.id }} .equipment-zones__card {
    flex-direction: column;
    align-items: stretch;
    padding: 16px;
    }
    }
{%- endstyle -%}

{%- liquid
    assign zones = section.blocks
    assign group_1_zones = zones | slice: 0, 3
    assign group_2_zones = zones | slice: 3, 2
-%}

<div class="multicolumn{% if section.settings.title == blank %} no-heading{% endif %}">
    <div class="page-width multicolumn-padding section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
        data-cascade
            {% endif %}>
        {%- unless section.settings.title == blank -%}
            <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
                <h2 class="title inline-richtext {{ section.settings.heading_size }}">
                    {{ section.settings.title }}
                </h2>
                {%- unless section.settings.subheading == blank -%}
                    <div class="equipment-zones__subheading rte">{{ section.settings.subheading }}</div>
                {%- endunless -%}
            </div>
        {%- endunless -%}

        {%- for zone_group in (1..2) -%}
            {%- if zone_group == 1 -%}
                {%- assign group_zones = group_1_zones -%}
                {%- assign group_image = section.settings.image_group_1 -%}
            {%- else -%}
                {%- assign group_zones = group_2_zones -%}
                {%- assign group_image = section.settings.image_group_2 -%}
            {%- endif -%}
            {%- if group_zones.size > 0 -%}
                <div class="equipment-zones__group{% if zone_group == 2 %} equipment-zones__group--reverse{% endif %}">
                    <div class="equipment-zones__image-wrapper{% if group_image == blank %} equipment-zones__image-wrapper--empty{% endif %}">
                        {%- if group_image != blank -%}
                            {{ group_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200' }}
                        {%- endif -%}
                    </div>
                    <div class="equipment-zones__list">
                        {%- for block in group_zones -%}
