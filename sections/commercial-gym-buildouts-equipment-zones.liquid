                                    {%- endcase -%}
                                </span>
                                <div>
                                    {%- if block.settings.title != blank -%}
                                        <p class="equipment-zones__card-title">{{ block.settings.title }}</p>
                                    {%- endif -%}
                                    {%- if block.settings.text != blank -%}
                                        <p class="equipment-zones__card-text">{{ block.settings.text }}</p>
                                    {%- endif -%}
