{% schema %}
{
  "name": "CGB Equipment Zones",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Equipment Zones",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
