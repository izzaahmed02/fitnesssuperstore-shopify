{%- style -%}
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
    }

    /* The section background bleeds full-width via #shopify-section-{{ section.id }}
       above (outside .page-width), so .page-width doesn't need max-width:100% — that
       was overriding the theme's default centering and pinning the fixed-width step
       row to the left edge instead of centering it (same bug already fixed in
       commercial-gym-buildouts-space-traffic.liquid and
       commercial-gym-buildouts-condition-options.liquid). Figma node 4606:84143
       "benefits" is exactly 1280px wide, not the site's generic 1380px --page-width. */
    #shopify-section-{{ section.id }} .page-width {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
    }

    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .page-width {
    padding-left: 40px;
    padding-right: 40px;
    }
    }

    #shopify-section-{{ section.id }} .process-steps__subheading {
    text-align: center;
    max-width: 800px;
    margin: 1.2rem auto 0;
    }

    /* Figma node 4612:88549 (mobile) — Oswald SemiBold 20px/26px */
    #shopify-section-{{ section.id }} .title.h1 {
    font-size: 20px;
    line-height: 26px;
    }

    /* Figma node "What to Expect Title" (desktop) — Oswald SemiBold 38px/50px */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .title.h1 {
    font-size: 38px;
    line-height: 50px;
    }
    }

    /* Figma node 4606:84143 "benefits" — 12px gap between the 4 step cards
       (4 x 311px card + 3 x 12px gap = 1280px, exact), not the previous 3rem (48px).
       28px gap from the heading above (matches the same heading→cards gap already
       established in space-traffic/condition-options), not 4rem (64px). */
    #shopify-section-{{ section.id }} .process-steps__row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 28px;
    }

    /* Line passes through each circle's center. With 4 equal flex-basis columns and a
       12px gap, each column is calc(25% - 9px) wide; the circle center sits 57px from
       its own column's left edge (32px card inset + 25px, half the 50px circle) — a
       fixed px offset that holds regardless of viewport width. */
    #shopify-section-{{ section.id }} .process-steps__row::before {
    content: '';
    position: absolute;
    top: 25px;
    left: 57px;
    right: calc(25% - 66px);
    height: 4px;
    background-color: #fce6de;
    z-index: 0;
    }

    /* Figma node 4612:88594 (mobile) — each step is icon-left/text-right row, not stacked */
    #shopify-section-{{ section.id }} .process-steps__step {
    position: relative;
    z-index: 1;
    flex: 1 1 0;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.6rem;
    }

    /* Figma "Benefit cards" (desktop) — icon above title/text, inset 32px from the
       card's (invisible — this card has no fill/border, unlike the other CGB card
       sections) left/right edges, matching the same 32px unit used elsewhere. */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .process-steps__step {
    flex-direction: column;
    gap: 0;
    padding: 0 32px;
    }
    }

    /* Figma node 4606:84183 — number circle text is Lato Bold 20px */
    #shopify-section-{{ section.id }} .process-steps__number {
    flex: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #fce6de;
    color: #f1592a;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    }

    /* Figma node 4606:84144 "Benefit cards" — 20px gap between the icon and the text
       below it (icon bottom at local y=82, text top at y=102), not 1.6rem (25.6px). */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .process-steps__number {
    margin-bottom: 20px;
    }
    }

    /* Figma "Benefit cards" text — Lato Bold 20/26 #000000 title, Lato Regular 16/24
       #393940 body; 8px gap between title and paragraph (matches the same title→text
       gap already established in the space-traffic and condition-options sections),
       not 0.6rem (9.6px). */
    #shopify-section-{{ section.id }} .process-steps__title {
    margin: 0 0 8px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 26px;
    color: #000000;
    }

    #shopify-section-{{ section.id }} .process-steps__text {
    margin: 0;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #393940;
    }

    @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    }

    @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .process-steps__row {
    flex-direction: column;
    gap: 2.4rem;
    }

    #shopify-section-{{ section.id }} .process-steps__row::before {
    display: none;
    }
    }
{%- endstyle -%}

<div class="multicolumn{% if section.settings.title == blank %} no-heading{% endif %}">
    <div class="page-width multicolumn-padding section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
        data-cascade
            {% endif %}>
        {%- unless section.settings.title == blank -%}
            <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
                <h2 class="title inline-richtext {{ section.settings.heading_size }}">
                    {{ section.settings.title }}
                </h2>
                {%- unless section.settings.subheading == blank -%}
                    <div class="process-steps__subheading rte">{{ section.settings.subheading }}</div>
                {%- endunless -%}
            </div>
        {%- endunless -%}

        <div class="process-steps__row">
            {%- for block in section.blocks -%}
                <div class="process-steps__step" {{ block.shopify_attributes }}>
                    <span class="process-steps__number">{{ forloop.index }}</span>
                    {%- if block.settings.title != blank -%}
                        <p class="process-steps__title">{{ block.settings.title }}</p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                        <p class="process-steps__text">{{ block.settings.text }}</p>
                    {%- endif -%}
                </div>
            {%- endfor -%}
        </div>

        {%- unless section.settings.disclaimer == blank -%}
            <p class="process-steps__subheading rte" style="margin-top: 28px; font-style: italic; font-size: 1.3rem;">{{ section.settings.disclaimer }}</p>
        {%- endunless -%}
    </div>
</div>

{% schema %}
{
  "name": "CGB Process",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "How the Process Works",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CGB Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Share your room and project requirements",
            "text": "Room size, ceiling height, facility type, budget and timing. A floor plan or photo helps but is not required."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Review equipment mix and conceptual placement",
            "text": "We put together an equipment list and a conceptual layout showing how the zones fit your room."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Receive a tailored quote",
            "text": "A quote built around your list, with condition options where new and remanufactured both make sense."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Coordinate delivery, assembly or installation",
            "text": "Where these services are available and approved for your project, we scope them alongside the equipment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
