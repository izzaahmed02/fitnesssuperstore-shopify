{{ 'recent-gym-builds.css' | asset_url | stylesheet_tag }}

<div class="page-width">
    {% if section.settings.heading != blank %}
        <h2 class="recent-gym-builds__title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="recent-gym-builds__wrapper">
        {% for block in section.blocks %}
            <a href="{{ block.settings.url }}" class="recent-gym-builds__card" {{ block.shopify_attributes }}>
                <div class="recent-gym-builds__card-media">
                    {% if block.settings.img != blank %}
                        {%- liquid
                            assign img_alt = block.settings.img_alt | default: block.settings.img.alt
                        -%}
                        {{
                            block.settings.img
                            | image_url: width: 1200
                            | image_tag:
                                widths: '300, 450, 600, 900, 1200',
                                sizes: '(min-width: 993px) 33vw, 100vw',
                                alt: img_alt,
                                loading: 'lazy',
                                class: 'recent-gym-builds__card-img'
                        }}
                    {% endif %}
                </div>
                <div class="recent-gym-builds__card-body">
                    {% if block.settings.title != blank %}
                        <h3 class="recent-gym-builds__card-title">{{ block.settings.title }}</h3>
                    {% endif %}
                    {% if block.settings.caption != blank %}
                        <p class="recent-gym-builds__card-caption">{{ block.settings.caption }}</p>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
    {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
        <div class="recent-gym-builds__cta-wrapper">
            <a href="{{ section.settings.cta_url }}" class="recent-gym-builds__cta">{{ section.settings.cta_label }}</a>
        </div>
    {% endif %}
</div>

{% schema %}
{
  "name": "Recent Gym Builds",
  "tag": "section",
  "class": "section recent-gym-builds",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Recent Gym Builds"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "See Gym Builds"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Build",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "img_alt",
          "label": "Card Image Alt Text",
          "info": "Describe what is visible in the image. Do not reuse the caption."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Card Caption"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recent Gym Builds",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
