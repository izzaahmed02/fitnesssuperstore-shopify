{{ 'recent-gym-builds.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Recent Gym Builds
  Native replacement for the former Instafeed homepage section.
  Image-only trust module: three editable case-study cards, whole-card links,
  a single CTA below the grid. No social feed, no autoplay video, and
  deliberately NO VideoObject/structured-data output for these thumbnail cards.
{%- endcomment -%}

<div class="recent-gym-builds">
  <div class="recent-gym-builds__inner">
    {% if section.settings.heading != blank %}
      <div class="recent-gym-builds__header">
        <h2 class="recent-gym-builds__title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="recent-gym-builds__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <ul class="recent-gym-builds__grid" role="list">
      {% for block in section.blocks %}
        {%- assign card_image = block.settings.image -%}
        {%- assign card_title = block.settings.title -%}
        {%- comment -%} Alt text is factual and image-specific; falls back to the title, never the marketing caption. {%- endcomment -%}
        {%- assign card_alt = block.settings.image_alt | default: card_title -%}

        <li class="recent-gym-builds__card" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a
              class="recent-gym-builds__link"
              href="{{ block.settings.link }}"
              aria-label="Read the {{ card_title }} case study"
            >
          {% endif %}

          <div class="recent-gym-builds__media">
            {% if card_image != blank %}
              <img
                class="recent-gym-builds__image"
                src="{{ card_image | image_url: width: 800 }}"
                srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w, {{ card_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 749px) 100vw, 33vw"
                alt="{{ card_alt | escape }}"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                loading="lazy"
                decoding="async"
              >
            {% else %}
              <div class="recent-gym-builds__placeholder" aria-hidden="true">
                {{ 'image' | placeholder_svg_tag: 'recent-gym-builds__placeholder-svg' }}
              </div>
            {% endif %}
          </div>

          <div class="recent-gym-builds__content">
            {% if card_title != blank %}
              <h3 class="recent-gym-builds__card-title">{{ card_title }}</h3>
            {% endif %}
            {% if block.settings.caption != blank %}
              <p class="recent-gym-builds__caption">{{ block.settings.caption }}</p>
            {% endif %}
          </div>

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <div class="recent-gym-builds__cta-wrap">
        <a class="recent-gym-builds__cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Recent Gym Builds",
  "class": "recent-gym-builds-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Recent Gym Builds"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See Gym Builds"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/blogs/case-studies"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Gym build",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Factual, image-specific description of what the photo shows. Do not reuse the caption. Confirm against the final crop."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "e.g. Facility name — City, ST"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Case study link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Recent Gym Builds",
      "category": "Custom",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
