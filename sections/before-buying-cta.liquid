{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .before-buying__inner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    padding: 80px 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .before-buying__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .before-buying__content {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .before-buying__title {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 38px;
    line-height: 1.15;
    text-transform: uppercase;
    color: #23232b;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .before-buying__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 36px;
  }

  #shopify-section-{{ section.id }} .before-buying__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-family: Lato, sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 24px;
    text-decoration: none;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .before-buying__btn--primary {
    background-color: var(--primary-orange, #d83d0e);
    color: #ffffff;
    border: 1px solid var(--primary-orange, #d83d0e);
  }

  #shopify-section-{{ section.id }} .before-buying__btn--primary:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .before-buying__btn--secondary {
    background-color: #ffffff;
    color: #23232b;
    border: 1px solid #e2e2e2;
  }

  #shopify-section-{{ section.id }} .before-buying__btn--secondary:hover {
    border-color: #c9c9c9;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .before-buying__inner {
      padding: 32px 16px;
      border-radius: 16px;
    }

    #shopify-section-{{ section.id }} .before-buying__title {
      font-size: 28px;
      line-height: 34px;
    }

    #shopify-section-{{ section.id }} .before-buying__buttons {
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .before-buying__btn {
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="before-buying section-{{ section.id }}-padding scroll-trigger animate--slide-in">
  <div class="page-width">
    <div class="before-buying__inner">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2200
          | image_tag: class: 'before-buying__bg', loading: 'lazy', alt: section.settings.title
        }}
      {%- endif -%}

      <div class="before-buying__content">
        {%- if section.settings.title != blank -%}
          <h2 class="before-buying__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="before-buying__buttons">
            {%- for block in section.blocks -%}
              <a
                class="before-buying__btn before-buying__btn--{{ block.settings.style }}"
                href="{{ block.settings.link | default: '#' }}"
                {{ block.shopify_attributes }}>
                {{ block.settings.label | escape }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before buying CTA",
  "class": "before-buying-cta",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Everything you need to know before buying"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Leave blank to use the background color."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f0f0f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary (filled)" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before buying CTA",
      "blocks": [
        { "type": "button", "settings": { "label": "Warranty Details", "style": "primary" } },
        { "type": "button", "settings": { "label": "French Fitness Warranty", "style": "primary" } },
        { "type": "button", "settings": { "label": "Contact Us", "style": "secondary" } }
      ]
    }
  ]
}
{% endschema %}
