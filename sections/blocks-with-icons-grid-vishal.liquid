{% comment %}
  Section: Blocks with icons grid Vishal
  Matches the commercial-grade equipment layout with icon cards
{% endcomment %}

<section class="bwig-section" id="bwig-{{ section.id }}">
  <div class="bwig-container">
    <div class="bwig-container-side">
    </div>
    <div class="bwig-container-main">
    {% if section.settings.heading != blank %}
      <h2 class="bwig-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="bwig-grid">
      {% for block in section.blocks %}
        <div class="bwig-card" {{ block.shopify_attributes }}>
          <div class="bwig-icon-wrap">
            {% if block.settings.icon_svg != blank %}
              <span class="bwig-icon-svg">{{ block.settings.icon_svg }}</span>
            {% elsif block.settings.icon_image != blank %}
              <img
                src="{{ block.settings.icon_image | image_url: width: 48 }}"
                alt="{{ block.settings.title }}"
                width="48"
                height="48"
                loading="lazy"
                class="bwig-icon-img"
              >
            {% else %}
              <span class="bwig-icon-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 8v4l3 3"/>
                </svg>
              </span>
            {% endif %}
          </div>
            <div class="bwig-card-text">
  {% if block.settings.title != blank %}
    <h3 class="bwig-card-title">{{ block.settings.title }}</h3>
  {% endif %}
  {% if block.settings.description != blank %}
    <p class="bwig-card-desc">{{ block.settings.description }}</p>
  {% endif %}
</div>
         
        </div>
      {% endfor %}
    </div>
    </div>
  </div>
</section>

<style>
  #bwig-{{ section.id }} {
    --bwig-bg: {{ section.settings.background_color }};
    --bwig-card-bg: {{ section.settings.card_background_color }};
    --bwig-accent: {{ section.settings.accent_color }};
    --bwig-heading-color: {{ section.settings.heading_color }};
    --bwig-title-color: {{ section.settings.title_color }};
    --bwig-desc-color: {{ section.settings.desc_color }};
    --bwig-icon-bg: {{ section.settings.icon_bg_color }};
    --bwig-columns: {{ section.settings.columns_desktop }};
  }

  .bwig-section {
    background-color: var(--bwig-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .bwig-container {
    margin: 0 0;
    padding: 0 0px;
    display:flex;
  }
.bwig-container-side{
width:56%;
}
  .bwig-heading {
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--bwig-heading-color);
    margin: 0 0 40px 0;
    max-width: 720px;
  }

  .bwig-grid {
    display: grid;
    grid-template-columns: repeat(var(--bwig-columns), 1fr);
    gap: 16px;
  }

  .bwig-card {
    background-color: var(--bwig-card-bg);
    border-radius: 4px;
    padding: 32px 24px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bwig-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: var(--bwig-icon-bg);
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .bwig-icon-wrap svg,
  .bwig-icon-placeholder svg {
    width: 28px;
    height: 28px;
    color: var(--bwig-accent);
    stroke: var(--bwig-accent);
  }

  .bwig-icon-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bwig-accent);
  }

  .bwig-icon-svg svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--bwig-accent);
    stroke-width: 1.5;
  }

  .bwig-icon-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .bwig-card-title {
    font-family: Arial, sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--bwig-title-color);
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .bwig-card-desc {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: var(--bwig-desc-color);
    line-height: 1.55;
    margin: 0;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .bwig-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }


  /* Mobile */
@media (max-width: 560px) {
  .bwig-grid {
    grid-template-columns: 1fr;  /* Single column */
    gap: 16px;
  }

  .bwig-card {
    flex-direction: row;          /* Horizontal layout */
    align-items: flex-start;
    text-align: left;
    padding: 20px 16px;
    gap: 16px;
    border-radius: 10px;
    border: 1px solid #e8e8e8;
    background-color: #fff;
  }

  .bwig-icon-wrap {
    flex-shrink: 0;
    margin-bottom: 0;             /* Remove bottom margin from vertical layout */
    width: 60px;
    height: 60px;
  }

  .bwig-card-text {
    display: flex;
    flex-direction: column;
  }

  .bwig-card-title {
    font-size: 15px;
    margin-bottom: 6px;
  }

  .bwig-card-desc {
    font-size: 13px;
  }

  .bwig-heading {
    font-size: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Blocks with icons Vishal",
  "tag": "section",
  "class": "bwig-wrapper",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Commercial-Grade Equipment, Protected Delivery, and Nationwide Service Options"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Max content width (px)",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / icon color",
      "default": "#e07050"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon circle background",
      "default": "#fde8e0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Card description color",
      "default": "#555555"
    }
  ],
  "blocks": [
    {
      "type": "icon_card",
      "name": "Icon Card",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste raw SVG code (e.g. from heroicons.com). Leave blank to use image below.",
          "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" /></svg>"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (used if no SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Industry-leading protection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Up to a 10-year warranty on new equipment (and up to 5-year on remanufactured, where applicable)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blocks with icons grid Vishal",
      "blocks": [
        {
          "type": "icon_card",
          "settings": {
            "title": "Industry-leading protection",
            "description": "Up to a 10-year warranty on new equipment (and up to 5-year on remanufactured, where applicable)",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" /></svg>"
          }
        },
        {
          "type": "icon_card",
          "settings": {
            "title": "Nationwide delivery & installation",
            "description": "Delivery options and professional assembly available",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12\" /></svg>"
          }
        },
        {
          "type": "icon_card",
          "settings": {
            "title": "Protective packaging",
            "description": "Equipment is crated/wrapped to help protect it in transit",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z\" /></svg>"
          }
        },
        {
          "type": "icon_card",
          "settings": {
            "title": "Value",
            "description": "Top fitness brands at significant savings versus typical retail pricing",
            "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z\" /></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
