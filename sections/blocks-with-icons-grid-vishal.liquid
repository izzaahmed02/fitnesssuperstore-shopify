{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.3 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  .block-icons-grid {
    padding: 8px 12px;
  }

  /* ── Outer wrapper: left side (title/text/video) + right side (cards grid) ── */
  #shopify-section-{{ section.id }} .blocks-grid {
    display: flex;
    align-items: flex-start;
    gap: 0;
    width: 100%;
  }

  /* ── Left column: title, text, video ── */
  #shopify-section-{{ section.id }} .blocks-grid__left {
    width: 45%;
    padding-right: 32px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .blocks-grid__title {
    font-family: Oswald, sans-serif;
    font-weight: 600;
    font-size: 38px;
    line-height: 50px;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    text-align: left;
  }

  /* ── Right column: 2x2 cards grid ── */
  #shopify-section-{{ section.id }} .blocks-grid__right {
    width: 55%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .blocks-grid__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 0;
    border: 1px solid #E5E5E5;
  }

  #shopify-section-{{ section.id }} .blocks-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px;
    border-right: 1px solid #E5E5E5;
    border-bottom: 1px solid #E5E5E5;
    box-sizing: border-box;
  }

  /* Remove right border on last column */
  #shopify-section-{{ section.id }} .blocks-grid__item:nth-child(2n) {
    border-right: none;
  }

  /* Remove bottom border on last row */
  #shopify-section-{{ section.id }} .blocks-grid__item:nth-last-child(-n+2) {
    border-bottom: none;
  }

  /* Icon circle */
  #shopify-section-{{ section.id }} .blocks-grid__item-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #FCF0EB;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .blocks-grid__item-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .blocks-grid__item h2.h4 {
    font-family: Lato, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 22px;
    color: #000;
    margin: 0 0 8px 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .blocks-grid__item-text {
    font-family: Lato, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #555;
    text-align: center;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .blocks-grid__item-text p {
    margin: 0;
  }

  /* Link style */
  #shopify-section-{{ section.id }} .link-style {
    display: inline-flex;
    align-items: center;
    margin-top: 12px;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #D83D0E;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .link-style svg {
    margin-left: 4px;
  }

  /* Bottom note */
  #shopify-section-{{ section.id }} .blocks-grid__item-text-bottom {
    margin-top: 16px;
    font-family: Lato, sans-serif;
    font-size: 14px;
    line-height: 20px;
    color: #555;
    display: flex;
    gap: 4px;
  }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .blocks-grid {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .blocks-grid__left,
    #shopify-section-{{ section.id }} .blocks-grid__right {
      width: 100%;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .blocks-grid__title {
      font-size: 20px;
      line-height: 26px;
    }

    #shopify-section-{{ section.id }} .blocks-grid__wrapper {
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .blocks-grid__item {
      padding: 20px 12px;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .blocks-grid__wrapper {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .blocks-grid__item {
      border-right: none;
    }

    #shopify-section-{{ section.id }} .blocks-grid__item:nth-last-child(-n+2) {
      border-bottom: 1px solid #E5E5E5;
    }

    #shopify-section-{{ section.id }} .blocks-grid__item:last-child {
      border-bottom: none;
    }
  }
</style>

<div class="blocks-grid section-{{ section.id }}-padding scroll-trigger animate--slide-in"
  {% if section.settings.id != blank %} id="{{ section.settings.id }}"{% endif %}>

  <div class="blocks-grid__container">

    <div class="blocks-grid">

      <!-- ══════════════════════════════════
           LEFT SIDE — title / text / video
           ══════════════════════════════════ -->
      <div class="blocks-grid__left">

        {% if section.settings.title != blank %}
          {% if section.settings.h1 %}
            <h1 class="h0 blocks-grid__title">{{ section.settings.title }}</h1>
          {% else %}
            <h2 class="h2 blocks-grid__title">{{ section.settings.title }}</h2>
          {% endif %}
        {% endif %}

        {%- liquid
          assign video_id = section.settings.video.id | default: section.settings.video_url.id
          assign video_alt = section.settings.video.alt | default: section.settings.description
          assign alt = 'sections.video.load_video' | t: description: video_alt | escape
          assign poster = section.settings.video.preview_image | default: section.settings.cover_image

          if section.settings.video != null
            assign ratio_diff = section.settings.video.aspect_ratio | minus: poster.aspect_ratio | abs
            if ratio_diff < 0.01 and ratio_diff > 0
              assign fix_ratio = true
            endif
          endif
        -%}

        {%- capture sizes -%}
          {% if section.settings.full_width -%}
            100vw
          {%- else -%}
            (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
            calc(100vw - 10rem), 100vw
          {%- endif %}
        {%- endcapture -%}

        {%- if section.settings.video != blank or section.settings.video_url != null -%}
          <deferred-media
            class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            data-media-id="{{ video_id }}"
            {% if poster != null %}
              {% assign aspect_ratio = 1 | divided_by: poster.aspect_ratio | times: 100 | times: 0.8 %}
              {% assign aspect_ratio_mobile = 1 | divided_by: poster.aspect_ratio | times: 100 %}
              {% if aspect_ratio > 47 %}{% assign aspect_ratio = 47 %}{% endif %}
              style="--ratio-percent: {{ aspect_ratio }}%;--ratio-percent-mobile: {{ aspect_ratio_mobile }}%;"
            {% endif %}
          >
            <button
              id="Deferred-Poster-Modal-{{ video_id }}"
              class="video-section__poster media deferred-media__poster media--landscape"
              type="button"
              aria-label="{{ alt }}"
            >
              {%- if poster != null -%}
                {{ poster | image_url: width: 3840 | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt }}
              {%- else -%}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              {%- endif -%}
              <span class="deferred-media__poster-button motion-reduce">
                {%- render 'icon-play' -%}
              </span>
            </button>
            <template>
              {%- if section.settings.video == null and section.settings.video_url != null -%}
                {%- liquid
                  assign loop = ''
                  if section.settings.enable_video_looping
                    assign loop = '&loop=1&playlist=' | append: video_id
                  endif
                -%}
                {%- if section.settings.video_url.type == 'youtube' -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
                    class="js-youtube"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.description | escape }}"
                  ></iframe>
                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
                    class="js-vimeo"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.description | escape }}"
                  ></iframe>
                {%- endif -%}
              {%- else -%}
                {{ section.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: section.settings.enable_video_looping, controls: true, muted: false }}
              {%- endif -%}
            </template>
          </deferred-media>
        {%- endif -%}

        {%- assign video_file = section.settings.video -%}
        {%- assign video_sources = video_file.sources -%}
        {%- assign video_m3u8 = video_sources | where: "format", "m3u8" | first -%}
        {%- assign video_mp4 = video_sources | where: "format", "mp4" | first -%}
        {%- assign video_title = section.settings.video.alt | default: section.settings.description | escape -%}
        {%- assign video_description = section.settings.title | append: ' — ' | append: section.settings.text | strip_html | escape -%}
        {%- assign video_thumbnail = section.settings.cover_image | default: video_file.preview_image | image_url: width: 1200 -%}
        {%- assign upload_date = 'now' | date: "%Y-%m-%d" -%}

        {% if video_file %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          "name": "{{ video_title }}",
          "description": "{{ video_description }}",
          "thumbnailUrl": ["{{ video_thumbnail | prepend: 'https:' }}"],
          "uploadDate": "{{ upload_date }}",
          "duration": "PT1M57S",
          "contentUrl": "{{ video_m3u8.url | default: video_file.sources[0].url | prepend: 'https:' }}",
          "embedUrl": "{{ video_mp4.url | default: video_file.sources[0].url | prepend: 'https:' }}",
          "publisher": {
            "@type": "Organization",
            "name": "Fitness Superstore",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ request.host | prepend: 'https://' }}/cdn/shop/files/Logo_Main_Dark_Background.svg?v=1745567646&width=500"
            }
          }
        }
        </script>
        {% endif %}

        {% if section.settings.text_bottom != blank %}
          <div class="blocks-grid__item-text-bottom">
            <span>*</span>
            {{ section.settings.text_bottom }}
          </div>
        {% endif %}

      </div>
      <!-- /blocks-grid__left -->

      <!-- ══════════════════════════════════
           RIGHT SIDE — 2×2 icon cards
           ══════════════════════════════════ -->
      {% if section.blocks.size > 0 %}
        <div class="blocks-grid__right">
          <div class="blocks-grid__wrapper">
            {% for block in section.blocks %}
              <div class="blocks-grid__item grid__item" {{ block.shopify_attributes }}>

                <!-- Icon in soft orange circle -->
                {% if block.settings.icon != blank %}
                  <div class="blocks-grid__item-icon">
                    <img
                      src="{{ block.settings.icon | img_url: 'master' }}"
                      alt="{{ block.settings.icon.alt | default: 'Icon' }}"
                      loading="lazy"
                      width="28"
                      height="28"
                    >
                  </div>
                {% endif %}

                <div>
                  {% if block.settings.title != blank %}
                    <h2 class="h4">{{ block.settings.title }}</h2>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="blocks-grid__item-text">{{ block.settings.text }}</div>
                  {% endif %}
                  {% if block.settings.link != blank %}
                    <a style="margin-top: 24px;" href="{{ block.settings.href }}" class="link-style">
                      {{ block.settings.link | escape }}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z"
                          fill="#D83D0E"/>
                      </svg>
                    </a>
                  {% endif %}
                </div>

              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      <!-- /blocks-grid__right -->

    </div>
    <!-- /blocks-grid (flex row) -->

  </div>
  <!-- /blocks-grid__container -->

</div>

{% schema %}
{
  "name": "Blocks with icons grid",
  "class": "block-icons-grid",
  "settings": [
    {
      "type": "text",
      "id": "id",
      "label": "Section id"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "h1",
      "label": "Use h1",
      "default": false
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "text_bottom",
      "label": "Text bottom"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__1.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link label"
        },
        {
          "type": "textarea",
          "id": "href",
          "label": "Href"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blocks with icons grid Vishal"
    }
  ]
}
{% endschema %}
