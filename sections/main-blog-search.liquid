{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
/* Section padding */
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* Hide article cards by default */
.blog-articles__article {
  display: none;
}

#no-results {
  display: none;
  text-align: center;
  margin: 20px 0;
}
{%- endstyle -%}

<div class="main-blog page-width section-{{ section.id }}-padding">
  <h1 class="title--primary">
    {{ section.settings.header_text | default: "Search Blog Articles" }}
  </h1>

  {% if section.settings.description %}
    <div class="main-blog-description">{{ section.settings.description }}</div>
  {% endif %}

  <!-- Search bar -->
  <div class="blog-search-wrapper" style="margin-bottom: 20px;">
    <input
      type="text"
      id="blog-live-search"
      placeholder="Search blog posts..."
      style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;"
    >
    <div id="no-results">
      <p>No articles found.</p>
    </div>
  </div>

  <!-- Container for search results -->
  <div class="blog-articles {% if section.settings.layout == 'collage' %}blog-articles--collage{% endif %}">
  </div>

  <!-- Hidden container with all articles data -->
  <div style="display:none;" id="all-articles-container">
    {% assign handles = section.settings.blog_handles | split: "," %}
    {% for handle in handles %}
      {% assign clean_handle = handle | strip %}
      {% assign blog = blogs[clean_handle] %}
      {% if blog %}
        {% for article in blog.articles %}
          <div class="article-data"
               data-title="{{ article.title | escape }}"
               data-excerpt="{{ article.excerpt | strip_html | escape }}"
               data-content="{{ article.content | strip_html | escape }}"
               data-handle="{{ article.handle }}"
               data-blog-handle="{{ clean_handle }}">
          </div>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('blog-live-search');
  const container = document.querySelector('.blog-articles');
  const noResults = document.getElementById('no-results');

  // Read all articles from hidden container
  const allArticles = Array.from(document.querySelectorAll('#all-articles-container .article-data')).map(el => ({
    title: el.dataset.title,
    excerpt: el.dataset.excerpt,
    content: el.dataset.content,
    handle: el.dataset.handle,
    blogHandle: el.dataset.blogHandle
  }));

  function createArticleCard(article) {
    const card = document.createElement('div');
    card.className = 'blog-articles__article article';
    card.innerHTML = `
      <div class="card">
        <h2 class="card__heading">${article.title}</h2>
        <p class="article-card__excerpt">${article.excerpt}</p>
        <a href="/blogs/${article.blogHandle}/${article.handle}">Read More</a>
      </div>
    `;
    return card;
  }

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    container.innerHTML = '';
    let matches = 0;

    if (!query) {
      noResults.style.display = 'none';
      return;
    }

    allArticles.forEach(article => {
      const text = `${article.title} ${article.excerpt} ${article.content}`.toLowerCase();
      if (text.includes(query)) {
        container.appendChild(createArticleCard(article));
        matches++;
      }
    });

    noResults.style.display = matches === 0 ? 'block' : 'none';
  });
});
</script>

{% schema %}
{
  "name": "Blog Search",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "header_text",
      "label": "Header Text",
      "default": "Search Blog Articles"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "collage", "label": "Collage" }
      ],
      "default": "grid",
      "label": "Article Layout"
    },
    {
      "type": "text",
      "id": "blog_handles",
      "label": "Blog Handles (comma separated)",
      "info": "Enter the handles of the blogs you want to include in search, separated by commas."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Blog Search"
    }
  ]
}
{% endschema %}
