    /* Hide desktop layout */
    .pot-desktop-layout { display: none; }
.pot-arrow-img       
  { width: 12px;
    height: 98px;
    display: block; }
    /* Show mobile layout */
.pot-mobile-wrap {
  display: block;
  position: relative;
  /* top/bottom padding makes room for the absolutely positioned labels */
  padding-top: 52px;
  padding-bottom: 52px;
}

/* Mobile card — sits in normal flow, labels float over it */
.pot-mob-card {
  background: var(--pot-card-bg);
  border-radius: 12px;
  border: 1.5px solid #c8ddf0;
  padding: 20px 16px;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.pot-mob-card.pot-card--readonly { background: var(--pot-readonly-tint); }

/* Shared label base — absolutely positioned */
.pot-mob-label {
  position: absolute;
  right: 10px;
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  z-index: 2;
}

/* TOP label: sits above card, arrow tip touches card top border */
.pot-mob-label--top {
  top: 0;
  flex-direction: column;
  align-items: flex-end;
}
.pot-mob-label--top .pot-label-text {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1a1a1a;
  text-align: right;
  line-height: 1.2;
  margin-bottom: 2px;
}

/* BOTTOM label: sits below card, arrow tip touches card bottom border */
.pot-mob-label--bottom {
  bottom: 0;
  flex-direction: column;
  align-items: flex-end;
}
.pot-mob-label--bottom .pot-label-text {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1a1a1a;
  text-align: right;
  line-height: 1.2;
  margin-top: 2px;
}

/* Arrow SVGs — sized so the tip overlaps the card border by ~4px */
