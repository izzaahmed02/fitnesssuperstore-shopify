  .pot-option--readonly     { cursor: pointer; }
  .pot-option--readonly:hover { border-color: var(--pot-border); }
  .pot-option--readonly.pot-option--highlighted,
  .pot-option--readonly.pot-option--highlighted:hover { border-color: var(--pot-accent); }

  /* Native radio hidden */
  .pot-radio { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }

  /* Custom radio dot */
  .pot-radio-custom {
    width: 20px; height: 20px;
