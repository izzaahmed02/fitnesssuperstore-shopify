{% comment %}
  Section: Pay Over Time - Payment Options Guide
  DESKTOP: 3-col grid — left labels+arrows | card | right labels+arrows
  MOBILE:  Single column. Card is wrapped in a relative container.
           Arrow labels sit OUTSIDE the card:
             - "Select Shop Pay"  → top-right,  arrow points DOWN into card
             - "Select Affirm"    → bottom-right, arrow points UP into card
           This matches the reference image exactly.
  READ-ONLY MODE: Theme Editor toggle locks all radios.
           Two pre-selected options chosen by position sliders.
{% endcomment %}
{%- comment -%} Replace YOUR_CDN_URL with your Shopify Files link {%- endcomment -%}
{%- assign pot_arrow_svg = 'https://cdn.shopify.com/s/files/1/0884/2012/2940/files/Union_0b927ba7-91b2-4e44-97ec-8fc92961bc4e.svg?v=1774440303' -%}
{%- assign is_readonly = section.settings.readonly_mode -%}
{%- assign sel1 = section.settings.readonly_selected_1 | plus: 0 -%}
{%- assign sel2 = section.settings.readonly_selected_2 | plus: 0 -%}

<section class="pot-section" id="pay-over-time-{{ section.id }}">
  <div class="pot-container">

    <h2 class="pot-heading">{{ section.settings.heading }}</h2>
    <p class="pot-subheading">{{ section.settings.subheading }}</p>

    {%- comment -%}
      DESKTOP LAYOUT — 3 columns
    {%- endcomment -%}
    <div class="pot-desktop-layout">

      {%- comment -%} Left label column {%- endcomment -%}
      <div class="pot-labels pot-labels--left">
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_option' and block.settings.show_arrow_label and block.settings.arrow_side == 'left' -%}
            <div class="pot-label-item pot-label-item--left" {{ block.shopify_attributes }}>
              <span class="pot-label-text">{{ block.settings.arrow_label }}</span>
              <span class="pot-arrow">
                {% comment %} <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 14" fill="none" aria-hidden="true">
                  <line x1="0" y1="7" x2="52" y2="7" stroke="currentColor" stroke-width="2"/>
                  <polyline points="46,1 58,7 46,13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
                </svg> {% endcomment %}
                 <img src="{{ pot_arrow_svg }}" alt="" aria-hidden="true" class="pot-arrow-img pot-arrow-img--right">

              </span>
            </div>
          {%- endif -%}
          {%- if block.type == 'payment_option' and block.settings.show_or_divider -%}
            <div class="pot-or-divider">or</div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Center card {%- endcomment -%}
      <div class="pot-card{% if is_readonly %} pot-card--readonly{% endif %}">
        <div class="pot-card__header">{{ section.settings.card_title }}</div>
        <div class="pot-options">
          {%- assign option_counter = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'payment_option' -%}
              {%- assign option_counter = option_counter | plus: 1 -%}
              {%- if is_readonly -%}
                {%- assign is_checked = false -%}
                {%- if option_counter == sel1 or option_counter == sel2 -%}{%- assign is_checked = true -%}{%- endif -%}
              {%- else -%}
                {%- assign is_checked = block.settings.highlighted -%}
              {%- endif -%}
              <label class="pot-option{% if is_checked %} pot-option--highlighted{% endif %}{% if is_readonly %} pot-option--readonly{% endif %}" {{ block.shopify_attributes }}>
                <input type="radio" name="pot-payment-{{ section.id }}" value="option-{{ option_counter }}" class="pot-radio"
                  {% if is_checked %}checked{% endif %}
                  {% if is_readonly %}disabled aria-disabled="true"{% endif %}>
                <span class="pot-radio-custom"></span>
                <span class="pot-option-label">{{ block.settings.option_label }}</span>
                {%- if is_readonly -%}
                  <span class="pot-readonly-badge" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="13" height="13">
                      <path d="M11 6V5a3 3 0 0 0-6 0v1H3.5A1.5 1.5 0 0 0 2 7.5v6A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 12.5 6H11ZM6 5a2 2 0 1 1 4 0v1H6V5Z"/>
                    </svg>
                  </span>
                {%- endif -%}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Right label column {%- endcomment -%}
      <div class="pot-labels pot-labels--right">
        {%- for block in section.blocks -%}
          {%- if block.type == 'payment_option' and block.settings.show_arrow_label and block.settings.arrow_side == 'right' -%}
            <div class="pot-label-item pot-label-item--right" {{ block.shopify_attributes }}>
              <span class="pot-arrow">
                {% comment %} <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 14" fill="none" aria-hidden="true">
                  <line x1="60" y1="7" x2="8" y2="7" stroke="currentColor" stroke-width="2"/>
                  <polyline points="14,1 2,7 14,13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
                </svg> {% endcomment %}
                <img src="{{ pot_arrow_svg }}" alt="" aria-hidden="true" class="pot-arrow-img pot-arrow-img--right">

              </span>
              <span class="pot-label-text">{{ block.settings.arrow_label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>{%- comment -%} /.pot-desktop-layout {%- endcomment -%}

    {%- comment -%}
      MOBILE LAYOUT
      Outer wrapper is relative. Card sits inside.
      Labels are absolutely positioned outside the card border.
    {%- endcomment -%}
    <div class="pot-mobile-wrap">

      {%- comment -%} Collect labels that have mobile_arrow_direction = down (top label) {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'payment_option' and block.settings.show_arrow_label and block.settings.mobile_arrow_direction == 'down' -%}
          <div class="pot-mob-label pot-mob-label--top" {{ block.shopify_attributes }}>
            <span class="pot-label-text">{{ block.settings.arrow_label }}</span>
            <span class="pot-mob-arrow pot-mob-arrow--down" aria-hidden="true">
              <img src="{{ pot_arrow_svg }}" alt="" aria-hidden="true" class="pot-arrow-img pot-arrow-img--down">
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} The card (same markup, rendered via CSS show/hide) {%- endcomment -%}
      <div class="pot-mob-card{% if is_readonly %} pot-card--readonly{% endif %}">
        <div class="pot-card__header">{{ section.settings.card_title }}</div>
        <div class="pot-options">
          {%- assign option_counter = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'payment_option' -%}
              {%- assign option_counter = option_counter | plus: 1 -%}
              {%- if is_readonly -%}
                {%- assign is_checked = false -%}
                {%- if option_counter == sel1 or option_counter == sel2 -%}{%- assign is_checked = true -%}{%- endif -%}
              {%- else -%}
                {%- assign is_checked = block.settings.highlighted -%}
              {%- endif -%}
              <label class="pot-option{% if is_checked %} pot-option--highlighted{% endif %}{% if is_readonly %} pot-option--readonly{% endif %}" {{ block.shopify_attributes }}>
                <input type="radio" name="pot-payment-mob-{{ section.id }}" value="option-{{ option_counter }}" class="pot-radio"
                  {% if is_checked %}checked{% endif %}
                  {% if is_readonly %}disabled aria-disabled="true"{% endif %}>
                <span class="pot-radio-custom"></span>
                <span class="pot-option-label">{{ block.settings.option_label }}</span>
                {%- if is_readonly -%}
                  <span class="pot-readonly-badge" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="13" height="13">
                      <path d="M11 6V5a3 3 0 0 0-6 0v1H3.5A1.5 1.5 0 0 0 2 7.5v6A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 12.5 6H11ZM6 5a2 2 0 1 1 4 0v1H6V5Z"/>
                    </svg>
                  </span>
                {%- endif -%}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Bottom labels (mobile_arrow_direction = up) {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'payment_option' and block.settings.show_arrow_label and block.settings.mobile_arrow_direction == 'up' -%}
          <div class="pot-mob-label pot-mob-label--bottom" {{ block.shopify_attributes }}>
            <span class="pot-mob-arrow pot-mob-arrow--up" aria-hidden="true">
             <img src="{{ pot_arrow_svg }}" alt="" aria-hidden="true" class="pot-arrow-img pot-arrow-img--up">
            </span>
            <span class="pot-label-text">{{ block.settings.arrow_label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>{%- comment -%} /.pot-mobile-wrap {%- endcomment -%}

    {%- if section.settings.footnote != blank -%}
      <div class="pot-footnote">{{ section.settings.footnote }}</div>
    {%- endif -%}

    {%- if is_readonly and section.settings.readonly_badge_text != blank -%}
      <p class="pot-readonly-notice">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path d="M11 6V5a3 3 0 0 0-6 0v1H3.5A1.5 1.5 0 0 0 2 7.5v6A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 12.5 6H11ZM6 5a2 2 0 1 1 4 0v1H6V5Z"/>
        </svg>
        {{ section.settings.readonly_badge_text }}
      </p>
    {%- endif -%}

  </div>
</section>

