<script>
(function () {
  var section  = document.getElementById('pay-over-time-{{ section.id }}');
  var readonly = {{ is_readonly | json }};
  if (!section) return;

  /* Interactive radios — desktop card only when not read-only */
  if (!readonly) {
    section.querySelectorAll('.pot-radio').forEach(function (radio) {
      radio.addEventListener('change', function () {
        /* Find sibling options in same group (desktop or mobile) */
        var name = this.name;
        section.querySelectorAll('input[name="' + name + '"]').forEach(function (r) {
          r.closest('.pot-option').classList.remove('pot-option--highlighted');
        });
        if (this.checked) this.closest('.pot-option').classList.add('pot-option--highlighted');
      });
    });
  }

  /* Block interaction on read-only options */
  if (readonly) {
    section.querySelectorAll('.pot-option--readonly').forEach(function (opt) {
      opt.addEventListener('click',       function (e) { e.preventDefault(); });
      opt.addEventListener('pointerdown', function (e) { e.preventDefault(); });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Pay Over Time",
  "tag": "section",
  "class": "pay-over-time-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHERE DO I CLICK TO PAY OVER TIME?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "At checkout, look for these two payment options:"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "Payment"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote text",
      "default": "Shop Pay Installments is selected inside Shop Pay. Affirm is selected separately."
    },
    {
      "type": "header",
      "content": "🔒 Read-Only Mode"
    },
    {
      "type": "paragraph",
      "content": "When enabled, all radio buttons are locked — visitors cannot change selections. Use the sliders to choose which two options appear pre-selected."
    },
    {
      "type": "checkbox",
      "id": "readonly_mode",
      "label": "Enable read-only mode",
      "default": false
    },
    {
      "type": "range",
      "id": "readonly_selected_1",
      "label": "Pre-selected option #1",
      "info": "Position of the first highlighted option (1 = top of list).",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "readonly_selected_2",
      "label": "Pre-selected option #2",
      "info": "Position of the second highlighted option.",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "readonly_badge_text",
      "label": "Read-only notice text",
      "info": "Small italic note shown below card when read-only is on. Leave blank to hide.",
      "default": "These options are for display purposes only."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
