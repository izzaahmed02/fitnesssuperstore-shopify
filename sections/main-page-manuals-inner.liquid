{{ 'custom-manuals.css' | asset_url | stylesheet_tag }}

<custom-manuals class="manuals">
  <div class="manuals-header">
    <div class="page-width">
      <h2 class="manuals-title">{{ section.settings.title | default: page.title }}</h2>
      <form class="manuals-search" role="search" onsubmit="return false;">
        <div class="manuals-search__wrapper">
          <div class="manuals-search__container">
            <div class="manuals-search-icon">{% render 'icon-search-manuals' %}</div>

            <input
              type="search"
              name="manual-search"
              class="manuals-search__input"
              placeholder="Search by item name"
              aria-label="Search by item name"
              autocomplete="off"
            >

            <button
              type="reset"
              class="manuals-search__reset-btn"
              aria-label="Reset search"
            >
              {% render 'icon-close-manual' %}
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <div class="manuals-main page-width">
    <div class="manuals-content__wrapper">
      {% comment %} RESET BUTTON {% endcomment %}
      {% if section.settings.button_back_url != blank %}
        <a href="{{ section.settings.button_back_url }}" class="manuals-reset-button" style="display: flex;">
          {% render 'icon-arrow-left' %}
          <span>{{ section.settings.button_back_label }}</span>
        </a>
      {% endif %}

      {% comment %} MANUALS LIST {% endcomment %}
      <div class="manuals-content">
        {% assign brand_data = page.metafields.custom.brand_manuals.value %}
        {%- assign manual_assembly = false -%}
        {%- assign manual_owners = false -%}

        {% if brand_data %}
          {% for manual in brand_data.manuals.value %}
            {% if manual.manual_type == 'Assembly Manual' %}
              {% if manual != blank %}
                {%- assign manual_assembly = true -%}
              {% endif %}
            {% endif %}
            {% if manual.manual_type == 'Owner’s Manual' %}
              {% if manual != blank %}
                {%- assign manual_owners = true -%}
              {% endif %}
            {% endif %}
          {% endfor %}

          <div class="manuals-content__result">
            {% if manual_assembly %}
              <div class="manuals-content__col">
                <h2>Assembly Manuals</h2>
                <ul class="manuals-list-inner">
                  {% for manual in brand_data.manuals.value %}
                    {% if manual.manual_type == 'Assembly Manual' %}
                      <li data-title="{{ manual.title | strip | downcase }}">
                        <a href="{{ manual.manual_url }}" class="manuals-list-item" target="_blank">
                          {{- manual.title -}}
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if manual_owners %}
              <div class="manuals-content__col">
                <h2>Owner’s Manuals</h2>
                <ul class="manuals-list-inner">
                  {% for manual in brand_data.manuals.value %}
                    {% if manual.manual_type == 'Owner’s Manual' %}
                      <li data-title="{{ manual.title | strip | downcase }}">
                        <a href="{{ manual.manual_url }}" class="manuals-list-item" target="_blank">
                          {{- manual.title -}}
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <div class="manuals-no-search-results" hidden>
          <p class="manuals-no-search-message"></p>
          <div class="manuals-search-tips">
            <h4 class="manuals-search-tips__title">Search tips</h4>
            <ul class="manuals-search-tips__list">
              <li class="search-tips__item">Be patient and try different search approaches</li>
              <li class="search-tips__item">Use our quick brand filters above if search isn't working</li>
              <li class="search-tips__item">Check for typos or alternative product descriptions</li>
              <li class="search-tips__item">Use full product names or common abbreviations</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</custom-manuals>

<script src="{{ 'page-custom-manuals.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Manuals Section Inner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Title"
    },
    {
      "type": "url",
      "id": "button_back_url",
      "label": "Button back url"
    },
    {
      "type": "text",
      "id": "button_back_label",
      "label": "Button back label",
      "default": "Back to all manuals"
    }
  ],
  "presets": [
    {
      "name": "Manuals Section Inner"
    }
  ]
}
{% endschema %}
