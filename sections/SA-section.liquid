{% style %}
  #shopify-section-{{ section.id }}{
    display: flex;
    justify-content: center;
  }
  #shopper_review_page {
    max-width: 1920px;
    padding: 0 50px;
    width: 100%;
    margin: 0 auto;
  }
  #shopper_review_page .review-title{
    font-family: "Lato";
    font-size: 28px;
    font-weight: 700;
    line-height: 36px;
    color: #000000;
    margin-top: 0;
    margin-bottom: 16px;
    margin-left: auto;
    margin-right: auto;
    text-transform: none;
  }
  #shopper_review_page #review_header {
    max-width: 100%;
  }
  #shopper_review_page .review-title {
    max-width: 100%;
  }
  #shopper_review_page .sa-reviews-dropdown-container {
    max-width: 100%;
  }
  #shopper_review_page #sa_review_section .product_review {
    max-width: 100%;
  }
  #sa_review_section{
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    border: 1px solid #E5E5E5;
    border-radius: 12px;
  }
  #sa_review_section .product-review {
    max-width: 100%;
  }
  #sa_review_paging{
    order: 1;
    max-width: 1920px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
  }
  #sa_review_paging .arrow:not(.custom) {
    display: none;
  }
  #product_page .paging .arrow {
    text-align: center;
  }
  #product_page #sa_sort {
    display: none;
  }
  #sa_review_paging .custom {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    border: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #393940;
    background: none;
  }
  .product_review{
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box!important;
    padding-left: 24px;
    border-top: 1px solid #E5E5E5;
    border-bottom: 0;
  }
  .product_review:first-child{
    border-top: 0;
  }
  #sa_sort{
    width: 244px!important;
    height: 48px;
    border-radius: 8px;
    border: 1.5px solid #E5E5E5;
    padding-left: 12px;
  }
  #review_image{
    display: none;
  }
  #sa_review_section{
    min-height: auto!important;
  }
  #product_page .paging{
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 0;
    height: auto!important;
  }
  #sa_review_paging label{
    display: none;
  }
  #review_header .percentage .numbers{
    font-family: "Oswald";
    font-size: 48px;
    font-weight: 600;
    line-height: 68px;
    color: #F1592A;
    margin-bottom: 12px;
  }

  #product_just_stars .on{
    display: none;
  }
  .sa_jump_to_reviews{
    font-size: 16px;
    color: #3E77AA;
  }
  .sa-reviews{
    display: flex;
    font-size: 16px;
    color: #3E77AA;
  }
  .outof{
    display: none;
  }
  #review_header .overall{
    margin-top: 0;
    width: auto;
    height: auto;
  }
  .review_header{
    padding: 0;
    line-height: 24px;
    border: 0;
    margin-right: 4px;
  }
  .review_header{
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #000000;
    padding: 0;
    background: transparent;
  } 
  #review_header .overall{
    display: none;
  }
  #review_header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #FAF9F9;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    padding-left: 100px;
    padding-right: 100px;
    box-sizing: border-box;
  }
  #review_header .block{
    height: auto;
  }

  #review_header .stars .on{
    background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M11.2736 2.57493C11.5595 1.95503 12.4405 1.95503 12.7264 2.57493L14.9159 7.32176C15.0325 7.5744 15.2719 7.74836 15.5482 7.78112L20.7393 8.3966C21.4172 8.47698 21.6895 9.31489 21.1883 9.77838L17.3503 13.3276C17.1461 13.5165 17.0546 13.7979 17.1089 14.0708L18.1276 19.198C18.2607 19.8676 17.5479 20.3855 16.9522 20.052L12.3908 17.4987C12.148 17.3628 11.852 17.3628 11.6092 17.4987L7.04779 20.052C6.4521 20.3855 5.73933 19.8676 5.87238 19.198L6.89115 14.0708C6.94537 13.7979 6.85392 13.5165 6.64965 13.3276L2.81174 9.77839C2.31054 9.31489 2.5828 8.47698 3.26071 8.3966L8.4518 7.78112C8.72809 7.74836 8.96752 7.5744 9.08406 7.32176L11.2736 2.57493Z" fill="%23FFC107"/></svg>');
  }
  .product_review .stars .on{
    background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M11.2736 2.57493C11.5595 1.95503 12.4405 1.95503 12.7264 2.57493L14.9159 7.32176C15.0325 7.5744 15.2719 7.74836 15.5482 7.78112L20.7393 8.3966C21.4172 8.47698 21.6895 9.31489 21.1883 9.77838L17.3503 13.3276C17.1461 13.5165 17.0546 13.7979 17.1089 14.0708L18.1276 19.198C18.2607 19.8676 17.5479 20.3855 16.9522 20.052L12.3908 17.4987C12.148 17.3628 11.852 17.3628 11.6092 17.4987L7.04779 20.052C6.4521 20.3855 5.73933 19.8676 5.87238 19.198L6.89115 14.0708C6.94537 13.7979 6.85392 13.5165 6.64965 13.3276L2.81174 9.77839C2.31054 9.31489 2.5828 8.47698 3.26071 8.3966L8.4518 7.78112C8.72809 7.74836 8.96752 7.5744 9.08406 7.32176L11.2736 2.57493Z" fill="%23FFC107"/></svg>');
    background-size: contain;  
  }
  #review_header .stars{
    order: -1;
  }
  #review_header .percentage{
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #000000;
    width: auto!important;
    padding-left: 0!important;
    padding-right: 0!important;
  }
  .product_review .rheading{
    font-family: "Lato";
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    color: #000000;
  }
  .product_review .info{
    font-size: 16px;
    line-height: 24px;
    color: #4F4F55;
  }
  .product_review .comments{
    font-size: 16px;
    line-height: 24px;
    color: #4F4F55;
  }

  #sa_review_paging label{
    display: none;
  }
  #review_header .percentage .numbers{
    font-family: "Oswald";
    font-size: 48px;
    font-weight: 600;
    line-height: 68px;
    color: #F1592A;
    margin-bottom: 12px;
  }

  #sa_review_section{
    min-height: auto!important;
  }
.sa-reviews-dropdown-container {
    display: flex;
    align-items: center;
    padding: 10px 0;
    margin: 20px 0;
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
}

.sa-reviews-dropdown-container .show-dropdown-container {
  margin-left: 10px;
}

.sa-reviews-dropdown-container .show-label {
  margin-right: 5px;
}

.sa-reviews-dropdown-container select {
  padding: 12px 10px;
    font-size: 16px;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    margin-right: 10px;
    font-family: 'Lato';
}

.write-review-btn {
    border-radius: 8px;
    cursor: pointer;
    background: white;
    border: 1px solid #E5E5E5;
    color: black;
    padding: 12px 10px;
    font-size: 16px;
    font-family: 'Lato';
    margin-left: auto;
}

@media (max-width: 991.98px) {
  .sa-reviews-dropdown-container {
    flex-direction: column;
    gap: 0.5rem;
  }

  .write-review-btn {
    width: 100%;
  }
}

@media (max-width: 1359px) {
  #shopper_review_page {
    padding: 0 49px !important;
  }
}

@media (min-width: 1360px) and (max-width: 1429px) {
  #shopper_review_page {
    padding: 0 54px !important;
  }
}

@media (min-width: 1430px) and (max-width: 1499px) {
  #shopper_review_page  {
    padding: 0 102px !important;
  }
}

@media (min-width: 1500px) and (max-width: 1569px) {
  #shopper_review_page {
    padding: 0 140px !important;
  }
}


@media (min-width: 1570px) and (max-width: 1639px) {
  #shopper_review_page {
    padding: 0 176px !important;
  }
}


@media (min-width: 1640px) and (max-width: 1709px) {
  #shopper_review_page  {
    padding: 0 205px !important;
  }
}


@media (min-width: 1710px) and (max-width: 1779px) {
  #shopper_review_page {
    padding: 0 239px !important;
  }
}


@media (min-width: 1780px) and (max-width: 1849px) {
  #shopper_review_page {
    padding: 0 281px !important;
  }
}


@media (min-width: 1850px) and (max-width: 1917px) {
  #shopper_review_page {
    padding: 0 303px !important;
  }
}

@media (min-width: 1918px) {
  #shopper_review_page {
    padding: 0 200px !important
  }
}
{% endstyle %}

<script>
  document.addEventListener("DOMContentLoaded", function () {
    setTimeout(() => {
    const reviewValue = document.querySelector("#review_header .overall .numbers").innerHTML;
    const reviewContainer = document.querySelector(".review_header");
    reviewContainer.innerHTML = reviewValue;
    }, 2000);
  });
</script>

<div id="shopper_review_page">
  <h2 class="review-title">Reviews</h2>
  <div id="review_header"></div>
  <div id="product_page"></div>
  <div id="review_image">
    <a href="https://www.shopperapproved.com/reviews/fitnesssuperstore.com" 
       onclick="var nonwin=navigator.appName!='Microsoft Internet Explorer'?'yes':'no'; var certheight=screen.availHeight-90; window.open(this.href,'shopperapproved','location='+nonwin+',scrollbars=yes,width=620,height='+certheight+',menubar=no,toolbar=no'); return false;" 
       target="_blank" 
       rel="nofollow">
       See Reviews
    </a>
  </div>
</div>


