{{ 'homepage-home-products.css' | asset_url | stylesheet_tag }}

<div class="custom-container">
  <div class="featured_products_header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="collection-tabs-wrapper">
      {% if section.settings.collection_1 != blank %}
        <button class="collection-tab active" data-collection="1">
          {{ section.settings.collection_1.title }}
        </button>
      {% endif %}
      
      {% if section.settings.collection_2 != blank %}
        <button class="collection-tab" data-collection="2">
          {{ section.settings.collection_2.title }}
        </button>
      {% endif %}
      
      {% if section.settings.collection_3 != blank %}
        <button class="collection-tab" data-collection="3">
          {{ section.settings.collection_3.title }}
        </button>
      {% endif %}
    </div>
  </div>

  {% if section.settings.collection_1 != blank %}
    <div class="featured_products_container collection-content active" data-collection="1">
      {% for product in section.settings.collection_1.products limit: 12 %}
        {% render 'product-items-home', product: product %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.collection_2 != blank %}
    <div class="featured_products_container collection-content" data-collection="2" style="display: none;">
      {% for product in section.settings.collection_2.products limit: 12 %}
        {% render 'product-items-home', product: product %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.collection_3 != blank %}
    <div class="featured_products_container collection-content" data-collection="3" style="display: none;">
      {% for product in section.settings.collection_3.products limit: 12 %}
        {% render 'product-items-home', product: product %}
      {% endfor %}
    </div>
  {% endif %}
</div>

<script src="{{ 'home-products.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Homepage Home products",
  "tag": "section",
  "class": "homepage-home-products",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    }
  ],
  "presets": [
    {
      "name": "Homepage Home products"
    }
  ]
}
{% endschema %}