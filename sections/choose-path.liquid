{% schema %}
{
  "name": "Choose Your Path Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "path_block",
      "name": "Path Block",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Expert Text"
        },
        {
          "type": "richtext",
          "id": "block_list",
          "label": "Ordered List (HTML supported)"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Choose Your Path Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}