{% stylesheet %}
.choose-path-section {
  padding: 36px 0;
  text-align: center;
}

.choose-path-section__title {
  font-size: 38px;
  line-height: 50px;
  letter-spacing: 0px;
  margin: 0px;
  margin-bottom: 20px;
}

.choose-path-section__description {
  font-size: 20px;
  line-height: 26px;
  color: #7283A4;
  font-weight: 700;
  margin-top:0px;
  margin-bottom: 36px;
}

.choose-path-section__grid {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.choose-path-section__block {
  background-color: #ffffff;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex: 1 1 0;
  text-align: left;
}

.choose-path-section__block-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}

.choose-path-section__block-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.choose-path-section__block-title {
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  font-weight: 600;
  margin: 0px;
  text-transform: uppercase;
}

.choose-path-section__block-text {
  margin:0px;
  margin-top: 2px;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  color: #7283A4;
  font-weight: 700;
}

.choose-path-section .choose-path-section__block-list {
  list-style: none;
  padding-left: 0px;
  margin: 16px 0;
}

.choose-path-section__block-list li {
  position: relative;
  margin-bottom: 4px;
  font-size:16px;
  line-height: 24px;
  padding-left: 20px;
}

.choose-path-section__block-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8px;
  height: 8px;
  background-color: #3E77AA;
  border-radius: 50%;
}

.choose-path-section__button {
  margin-top: auto;
  padding: 12px 16px;
  background-color: #D83D0E;
  color: #ffffff;
  text-decoration: none;
  border-radius: 8px;
  text-align: center;
  display: block;
  font-weight: 500;
}

@media screen and (min-width: 992px) {
  .choose-path-section__block:nth-child(1),
  .choose-path-section__block:nth-child(2) {
    max-width: 288px;
  }
  .choose-path-section__block:nth-child(3) {
    max-width: 404px;
  }
}

@media screen and (max-width: 991px) {

  .choose-path-section {
    padding: 24px 16px;
  }
  .choose-path-section__grid {
    flex-direction: column;
    gap: 12px;
  }
  .choose-path-section__block {
    max-width: 100%;
  }

  .choose-path-section__title {
    font-size: 20px;
    line-height: 26px;
    text-align: left;
  }
}
{% endstylesheet %}

