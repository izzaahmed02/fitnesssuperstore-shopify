<div class="choose-path-section" style="background: {{ section.settings.bg_color }};">
  {% if section.settings.section_title != blank %}
    <h2 class="choose-path-section__title">{{ section.settings.section_title }}</h2>
  {% endif %}

  {% if section.settings.section_description != blank %}
    <p class="choose-path-section__description">{{ section.settings.section_description }}</p>
  {% endif %}

  <div class="choose-path-section__grid">
    {% for block in section.blocks %}
      <div class="choose-path-section__block">

        {% if block.settings.block_title != blank %}
          <div class="choose-path-section__block-header">
            {% if block.settings.block_icon == 'checkout' %}
              <span class="choose-path-section__block-icon">{{ checkout_icon }}</span>
            {% elsif block.settings.block_icon == 'cart' %}
              <span class="choose-path-section__block-icon">{{ cart_icon }}</span>
            {% endif %}
            <p class="choose-path-section__block-title">{{ block.settings.block_title }}</p>
          </div>
        {% endif %}

        {% if block.settings.block_text != blank %}
          <p class="choose-path-section__block-text">{{ block.settings.block_text }}</p>
        {% endif %}
        {% if block.settings.block_list != blank %}
          <ol class="choose-path-section__block-list">{{ block.settings.block_list }}</ol>
        {% endif %}
        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="choose-path-section__button">{{ block.settings.button_text }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>


{% schema %}
{
  "name": "Choose Your Path Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "section_description",
      "label": "Section Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "path_block",
      "name": "Path Block",
      "settings": [
        {
          "type": "select",
          "id": "block_icon",
          "label": "Block Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "cart", "label": "Cart" },
            { "value": "checkout", "label": "Checkout" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Expert Text"
        },
        {
          "type": "richtext",
          "id": "block_list",
          "label": "Ordered List (HTML supported)"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Choose Your Path Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}