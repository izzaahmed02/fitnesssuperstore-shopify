                                <path d="M34.375 37.125H8.25V38.5H34.375C35.1313 38.5 35.75 37.8812 35.75 37.125V35.75C35.75 36.5063 35.1313 37.125 34.375 37.125Z" fill="#CAD1D8"/>
                                </g>
                                <defs>
                                <clipPath id="clip0_1147_3414">
                                <rect width="44" height="44" fill="white"/>
                                </clipPath>
                                </defs>
                                </svg>

                              
                              {{ link.text }}

                              </span>


                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="40" height="40" rx="8" fill="#FFF9F7"/>
                                <rect x="0.5" y="0.5" width="39" height="39" rx="7.5" stroke="#F1592A" stroke-opacity="0.3"/>
                                <g clip-path="url(#clip0_1147_3423)">
                                <path d="M29.0909 22.3557C28.9015 22.3557 28.72 22.4309 28.5861 22.5648C28.4522 22.6987 28.377 22.8802 28.377 23.0696V25.5074C28.377 26.0819 28.1488 26.633 27.7425 27.0393C27.3362 27.4456 26.7851 27.6739 26.2105 27.6739H13.7895C13.2149 27.6739 12.6639 27.4456 12.2576 27.0393C11.8513 26.633 11.623 26.0819 11.623 25.5074V23.0696C11.623 22.8802 11.5478 22.6987 11.4139 22.5648C11.2801 22.4309 11.0985 22.3557 10.9092 22.3557C10.7198 22.3557 10.5383 22.4309 10.4044 22.5648C10.2705 22.6987 10.1953 22.8802 10.1953 23.0696V25.5074C10.1963 26.4603 10.5752 27.374 11.2491 28.0478C11.9229 28.7216 12.8366 29.1006 13.7895 29.1016H26.2105C27.1635 29.1006 28.0771 28.7216 28.751 28.0478C29.4248 27.374 29.8038 26.4603 29.8047 25.5074V23.0696C29.8047 22.8802 29.7295 22.6987 29.5956 22.5648C29.4618 22.4309 29.2802 22.3557 29.0909 22.3557Z" fill="#F1592A"/>
                                <path d="M19.4936 24.4401C19.56 24.507 19.6389 24.5601 19.7259 24.5964C19.8129 24.6326 19.9062 24.6513 20.0004 24.6513C20.0947 24.6513 20.188 24.6326 20.275 24.5964C20.362 24.5601 20.4409 24.507 20.5073 24.4401L24.5691 20.3783C24.6824 20.242 24.7409 20.0683 24.7332 19.8911C24.7256 19.714 24.6522 19.5461 24.5275 19.42C24.4028 19.294 24.2356 19.2188 24.0586 19.2093C23.8815 19.1997 23.7073 19.2564 23.5697 19.3682L20.7143 22.2236V11.6123C20.7143 11.423 20.6391 11.2414 20.5052 11.1075C20.3713 10.9736 20.1898 10.8984 20.0004 10.8984C19.8111 10.8984 19.6296 10.9736 19.4957 11.1075C19.3618 11.2414 19.2866 11.423 19.2866 11.6123V22.2129L16.4312 19.3575C16.2973 19.2236 16.1156 19.1483 15.9262 19.1483C15.7367 19.1483 15.5551 19.2236 15.4211 19.3575C15.2872 19.4915 15.2119 19.6731 15.2119 19.8626C15.2119 20.052 15.2872 20.2337 15.4211 20.3676L19.4936 24.4401Z" fill="#F1592A"/>
                                </g>
                                <defs>
                                <clipPath id="clip0_1147_3423">
                                <rect width="20" height="20" fill="white" transform="translate(10 10)"/>
                                </clipPath>
                                </defs>
                                </svg>

                            </a>
    
                            
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </div>
                {% endif %}
             {% endif %}

          {% when 'features' %}

            {% if block.settings.content != blank %}
              <div class="product__extra_features extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

          {% when 'benefits' %}

             {% if block.settings.content != blank %}
              <div class="product__extra_overview extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div class="product__extra_overview-list">{{ block.settings.content }}</div>
              </div>
            {% endif %}
            



          {% when 'tech' %}
            
            {% if block.settings.content != blank %}
              <div class="product__extra_tech extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

            {% assign otherTechSpecs = product.metafields.custom.features_specs.value.other_tech_specs.value %}

            {% if otherTechSpecs != blank %}
              <div class="product__extra_tech extra-info-width">
                <div>{{ otherTechSpecs }}</div>
              </div>
            {% endif %}

          {% when 'weightstacks' %}

            {% if block.settings.content != blank %}
              <div class="product__extra_smith extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

          {% when 'buyingguide' %}
            {% assign buyingGuide = product.metafields.custom.features_specs.value.buying_guide.value %}
            {% if buyingGuide != blank %}
              <div class="product_extra_buyingguide product__extra_tech extra-info-width">
                <div>{{ buyingGuide }}</div>
              </div>
            {% endif %}


          {% when 'faq' %}
             {% assign faq = product.metafields.custom.features_specs.value.frequently_asked_questions.value %}
            {% if faq != blank %}
              <div class="product__extra_tech extra-info-width product__extra_info">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div class="FAQ-tab">{{ faq }}</div>
              </div>
            {% endif %}

          {% when 'warranty' %}
          
            {% if block.settings.content != blank %}
              <div class="product__extra_warranty extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

            {% if attachments_metafield != blank %}
                {% assign attachments_object = attachments_metafield %}
                {% if attachments_object.rig_frame_pieces_customize_your_rig_for_sale != blank %}

                {%- assign rig_frame_pieces_count = 0 -%}
                {%- for media in attachments_object.rig_frame_pieces_customize_your_rig_for_sale.value -%}
                  {%- assign rig_frame_pieces_count = rig_frame_pieces_count | plus: 1 -%}
                {%- endfor -%}         
                <section class="rig-attachments-section">
                    <h4 class="product__extra_info-title">Rig Frame Pieces (Customize Your Rig) for Sale ({{ rig_frame_pieces_count }})</h4>
                    <div class="rig-product-grid">
                      {% for product_ref in attachments_object.rig_frame_pieces_customize_your_rig_for_sale.value %}
                        <div class="rig-product-card">
                          <div class="rig-product-image-wrap">
                            {% if product_ref.featured_image %}
                              <img 
                                src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                                alt="{{ product_ref.featured_image.alt | escape }}" 
                                class="rig-product-image"
                              >
                            {% endif %}
                          </div>
                          <div class="rig-product-details">
                            <p class="rig-product-price">
                              {{ product_ref.price | money }}
                            </p>
                            <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                            <a target="_blank"
                              class="rig-quickview-btn" 
                              href="{{ product_ref.url }}"
                            >
                              Quick view 
                              <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                            </a>
                          </div>
                        </div>
                      {% endfor %}
                    </div>            
                </section>
                {% endif %}
                {% if attachments_object.rig_attachments_accessories_for_sale != blank %}
                  {%- assign rig_attachments_count = 0 -%}
                  {%- for media in attachments_object.rig_attachments_accessories_for_sale.value -%}
                    {%- assign rig_attachments_count = rig_attachments_count | plus: 1 -%}
                  {%- endfor -%} 
                  <section class="rig-attachments-section">
                    <h4 class="product__extra_info-title">Rig Attachments & Accessories for Sale ({{ rig_attachments_count }})</h4>
                    <div class="rig-product-grid">
                      {% for product_ref in attachments_object.rig_attachments_accessories_for_sale.value %}
                        <div class="rig-product-card">
                          <div class="rig-product-image-wrap">
                            {% if product_ref.featured_image %}
                              <img 
                                src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                                alt="{{ product_ref.featured_image.alt | escape }}" 
                                class="rig-product-image"
                              >
                            {% endif %}
                          </div>
                          <div class="rig-product-details">
                            <p class="rig-product-price">
                              {{ product_ref.price | money }}
                            </p>
                            <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                            <a target="_blank"
                              class="rig-quickview-btn" 
                              href="{{ product_ref.url }}"
                            >
                              Quick view 
                              <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                            </a>
                          </div>
                        </div>
                      {% endfor %}
                    </div>            
                </section>
                {% endif %}
            {% endif %}

            {% if otherRigRackSystems != blank %}
              <section class="other-rig-rack-systems-section">
                <h4 class="product__extra_info-title">Other French Fitness Rig & Rack Systems</h4>
                <div class="other-rig-rack-systems-cards">
                  {% for product_ref in otherRigRackSystems.other_french_fitness_rig_rack_systems.value %}
                    <div class="rig-product-card">
                      <div class="rig-product-image-wrap">
                        {% if product_ref.featured_image %}
                          <img 
                            src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                            alt="{{ product_ref.featured_image.alt | escape }}" 
                            class="rig-product-image"
                          >
                        {% endif %}
                      </div>
                      <div class="rig-product-details">
                        <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                        <div class="rig-lower-details">
                          <div class="rig-product-price">
                            {% if product_ref.metafields.custom.retail_price != blank %}
                              <s>MSRP: {{ product_ref.metafields.custom.retail_price | money -}}</s>
                            {% endif %}
                            <p>{{ product_ref.price | money }}</p>
                          </div>
                          <a target="_blank"
                            class="rig-quickview-btn" 
                            href="{{ product_ref.url }}"
                          >
                            View details 
                            <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                          </a>
                        </div>
                      </div>
                    </div>
                  {% endfor %}            
                </div>
              </section>
            {% endif %}
            {% render 'new-prop65' %}

        {% endcase %}
      </div>
    {% endfor %}

  </div>

</div>
</section>

<style>
  .metafield-rich_text_field li {
    position: relative;
    margin-bottom: 8px;
    padding-left: 16px;
}
.metafield-rich_text_field li:before {
    content: "";
    display: block;
    width: 9px;
    height: 8px;
    border-radius: 50%;
    position: absolute;
    top: 8px;
    left: 0;
    background: #3e77aa;
}
.product__extra_overview-list li:before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-image: url("https://cdn.shopify.com/s/files/1/0884/2012/2940/files/download.svg?v=1766660420");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.product-extra-tabs{
  display:flex;
  gap:30px;
}

.extra-tab-menu{
  width:260px;
  border-right:1px solid #ddd;
  list-style:none;
  padding:0;
  margin:0;
}

.extra-tab-menu li{
  padding:18px 20px;
  border-bottom:1px solid #eee;
  cursor:pointer;
  font-size:18px;
  font-weight:600;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.extra-tab-menu li.active{
  background:#FFF3EE;
  color:#F1592A;
}

.extra-tab-content{
  flex:1;
  padding:10px 10px;
}

.tab-pane{display:none;}
.tab-pane.active{display:block;}

@media(max-width:768px){
  .product-extra-tabs{
    flex-direction:column;
  }

  .extra-tab-menu{
    width:100%;
    border-right:0;
  }

}


/* MOBILE ONLY */

  .mobile-tab-content {
    display: none;
    padding: 16px;
    background: #fafafa;
  }


@media (max-width: 768px) {

  .product-extra-tabs {
    display: block;
  }

  /* Hide right panel on mobile */
  .extra-tab-content {
    display: none;
  }

  .extra-tab-menu li {
    border-bottom: 1px solid #eee;
    padding: 16px;
    cursor: pointer;
    position: relative;
  }

  {% comment %} .extra-tab-menu li::after {
    content: "›";
    position: absolute;
    right: 16px;
    transition: transform 0.3s ease;
  }

  .extra-tab-menu li.active::after {
    transform: rotate(90deg);
  } {% endcomment %}

  .mobile-tab-content.active {
    display: block;
  }
}


</style>


<script>
document.addEventListener("DOMContentLoaded", ()=>{
  const tabs = document.querySelectorAll(".extra-tab-menu li");
  const panes = document.querySelectorAll(".tab-pane");

  tabs.forEach(tab=>{
    tab.addEventListener("click", ()=>{

      tabs.forEach(t=>t.classList.remove("active"));
      tab.classList.add("active");

      const id = tab.getAttribute("data-tab");

      panes.forEach(p=>{
        p.classList.remove("active");
        if(p.id === id) p.classList.add("active");
      });

    });
  });

});
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    if (window.innerWidth > 768) return;

    const tabs = document.querySelectorAll(".extra-tab-menu li");

    tabs.forEach(tab => {
      const tabId = tab.getAttribute("data-tab");
      const content = document.getElementById(tabId);

      if (!content) return;

      // Clone right-side content for mobile
      const mobileContent = document.createElement("div");
      mobileContent.className = "mobile-tab-content";
      mobileContent.innerHTML = content.innerHTML;

      tab.after(mobileContent);

      tab.addEventListener("click", () => {

        document.querySelectorAll(".mobile-tab-content").forEach(c => {
          if (c !== mobileContent) c.classList.remove("active");
        });

        document.querySelectorAll(".extra-tab-menu li").forEach(t => {
          if (t !== tab) t.classList.remove("active");
        });

        tab.classList.toggle("active");
        mobileContent.classList.toggle("active");
      });
    });

  });
</script>


