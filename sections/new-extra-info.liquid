<section id="product-extra-tabs">

<div class="product-extra-tabs">

  <!-- LEFT TABS -->
  <ul class="extra-tab-menu">
    {% for block in section.blocks %}
      <li 
        data-tab="tab-{{ block.id }}" 
        class="{% if forloop.first %}active{% endif %}">
        {{ block.settings.title }}
        <span>→</span>
      </li>
    {% endfor %}
  </ul>


  <!-- RIGHT CONTENT -->
  <div class="extra-tab-content">

    {% for block in section.blocks %}
      <div 
        id="tab-{{ block.id }}" 
        class="tab-pane {% if forloop.first %}active{% endif %}">

        {% case block.type %}

          {% when 'description' %}
            {% if product.content != blank %}
              <div class="extra-info-width">
                <h4 class="product__extra_info-title">Description</h4>
                  {% assign videos = product.media | where: "media_type", "video" %}
                  {% if videos.size > 0 %}
                    <div class="product-videos-wrapper">
                      {% for video in videos %}
                        <div class="product-video-item">
                          <a href="#" class="product-video-trigger" data-video-id="video-{{ video.id }}">
                            {% if video.preview_image %}
                              <div class="product-video-thumbnail-wrapper">
                                <img 
                                  src="{{ video.preview_image | img_url: '800x' }}" 
                                  alt="{{ product.title }} video preview {{ forloop.index }}" 
                                  class="product-video-thumbnail"
                                >
                                <span class="product-video-play-icon">▶</span>
                              </div>
                            {% else %}
                              <div class="video-placeholder">
                                ▶ Play Video {{ forloop.index }}
                              </div>
                            {% endif %}
                          </a>
                        </div>

                        <!-- Modal -->
                        <div id="video-{{ video.id }}" class="product-video-modal">
                          <div class="product-video-modal-content">
                            <span class="product-video-close">&times;</span>
                            {{ video | media_tag: controls: true, autoplay: true }}
                          </div>
                        </div>
                      {% endfor %}
                    </div>

                    <style>
                            .product-videos-wrapper {
                            display: flex;
                            flex-direction: column; /* stack vertically */
                            gap: 16px;
                            margin-bottom: 20px;
                          }

                          .product-video-item {
                            width: 100%; /* full width */
                          }

                          .product-video-thumbnail-wrapper {
                            position: relative;
                            width: 100%;
                          }

                          .product-video-thumbnail {
                            width: 100%;
                            border-radius: 12px;
                            cursor: pointer;
                            display: block;
                          }

                          .product-video-play-icon {
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -50%);
                            font-size: 48px;
                            color: white;
                            text-shadow: 0 0 10px rgba(0,0,0,0.6);
                            pointer-events: none;
                          }

                          @media (max-width: 600px) {
                            .product-video-play-icon {
                              font-size: 36px; /* smaller on mobile */
                            }
                          }

                          /* Modal */
                          .product-video-modal {
                            display: none;
                            position: fixed;
                            z-index: 9999;
                            left: 0;
                            top: 0;
                            width: 100%;
                            height: 100%;
                            background: rgba(0,0,0,0.9);
                            justify-content: center;
                            align-items: center;
                            padding: 10px;
                          }

                          .product-video-modal-content {
                            position: relative;
                            width: 100%;
                            max-width: 900px; /* keeps it centered on big screens */
                            max-height: 90vh;
                          }

                          .product-video-modal iframe,
                          .product-video-modal video {
                            width: 100%;
                            height: auto;
                            max-height: 90vh;
                            border-radius: 12px;
                          }

                          .product-video-close {
                            position: absolute;
                            top: -40px;
                            right: 0;
                            font-size: 32px;
                            color: white;
                            cursor: pointer;
                          }
                          html.no-scroll,
                          body.no-scroll {
                            overflow: hidden;
                            height: 100%;
                          }

                          @media (max-width: 600px) {
                            .product-video-close {
                              top: 10px;
                              right: 10px;
                              font-size: 28px;
                              background: rgba(0,0,0,0.6);
                              border-radius: 50%;
                              padding: 4px 10px;
                              z-index: 999;
                            }
                          }



                    </style>
                      <script>
                      document.addEventListener("DOMContentLoaded", function() {
                        const triggers = document.querySelectorAll(".product-video-trigger");
                        const modals = document.querySelectorAll(".product-video-modal");

                        // Open modal
                        triggers.forEach(trigger => {
                          trigger.addEventListener("click", function(e) {
                            e.preventDefault();
                            const videoId = this.getAttribute("data-video-id");
                            const modal = document.getElementById(videoId);
                            if (modal) {
                              modal.style.display = "flex";
                              document.body.classList.add("no-scroll"); // disable scroll
                            }
                          });
                        });

                        // Close modal
                        modals.forEach(modal => {
                          const closeBtn = modal.querySelector(".product-video-close");
                          closeBtn.addEventListener("click", function() {
                            modal.style.display = "none";
                            document.body.classList.remove("no-scroll"); // re-enable scroll
                            stopVideo(modal);
                          });
                        });

                        // Close when clicking outside
                        window.addEventListener("click", function(e) {
                          modals.forEach(modal => {
                            if (e.target === modal) {
                              modal.style.display = "none";
                              document.body.classList.remove("no-scroll"); // re-enable scroll
                              stopVideo(modal);
                            }
                          });
                        });

                        // Stop video (works for <video> and <iframe>)
                        function stopVideo(modal) {
                          const video = modal.querySelector("video");
                          const iframe = modal.querySelector("iframe");

                          if (video) {
                            video.pause();
                            video.currentTime = 0;
                          }

                          if (iframe) {
                            iframe.src = iframe.src; // reload iframe to stop playback
                          }
                        }
                      });
                      </script>


                  {% endif %}

                {{ product.description }}
              </div>
            {% endif %}

          {% when 'manuals' %}
            {% if product.metafields.custom.manuals != blank %}
              {{ product.metafields.custom.manuals }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}

          {% when 'features' %}
            {% if product.metafields.custom.features != blank %}
              {{ product.metafields.custom.features }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}

          {% when 'benefits' %}
            <div class="benefits">
            {% if product.metafields.custom.benefits != blank %}
              {{ product.metafields.custom.benefits }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}
            </div>

          {% when 'tech' %}
            {% if product.metafields.custom.tech_specs != blank %}
              {{ product.metafields.custom.tech_specs }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}

          {% when 'weightstacks' %}
            {% if product.metafields.custom.weight_stacks != blank %}
              {{ product.metafields.custom.weight_stacks }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}

          {% when 'buyingguide' %}
          {% assign buyingGuide = product.metafields.custom.features_specs.value.buying_guide.value %}
            {% if buyingGuide != blank %}
              <div class="product__extra_tech extra-info-width">
                <div>{{ buyingGuide }}</div>
              </div>
            {% endif %}


          {% when 'faq' %}
             {% assign faq = product.metafields.custom.features_specs.value.frequently_asked_questions.value %}
            {% if faq != blank %}
              <div class="product__extra_tech extra-info-width product__extra_info">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ faq }}</div>
              </div>
            {% endif %}

          {% when 'warranty' %}
            {% if product.metafields.custom.warranty != blank %}
              {{ product.metafields.custom.warranty }}
            {% else %}
              {{ block.settings.content }}
            {% endif %}

        {% endcase %}
      </div>
    {% endfor %}

  </div>

</div>
</section>

<style>
  .metafield-rich_text_field li {
    position: relative;
    margin-bottom: 8px;
    padding-left: 16px;
}
.metafield-rich_text_field li:before {
    content: "";
    display: block;
    width: 9px;
    height: 8px;
    border-radius: 50%;
    position: absolute;
    top: 8px;
    left: 0;
    background: #3e77aa;
}
.product__extra_overview-list li:before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-image: url("https://cdn.shopify.com/s/files/1/0884/2012/2940/files/download.svg?v=1766660420");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.product-extra-tabs{
  display:flex;
  gap:30px;
}

.extra-tab-menu{
  width:260px;
  border-right:1px solid #ddd;
  list-style:none;
  padding:0;
  margin:0;
}

.extra-tab-menu li{
  padding:18px 20px;
  border-bottom:1px solid #eee;
  cursor:pointer;
  font-size:18px;
  font-weight:600;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.extra-tab-menu li.active{
  background:#FFF3EE;
  color:#F1592A;
}

.extra-tab-content{
  flex:1;
  padding:10px 10px;
}

.tab-pane{display:none;}
.tab-pane.active{display:block;}

@media(max-width:768px){
  .product-extra-tabs{
    flex-direction:column;
  }

  .extra-tab-menu{
    width:100%;
    border-right:0;
  }

}
</style>


<script>
document.addEventListener("DOMContentLoaded", ()=>{
  const tabs = document.querySelectorAll(".extra-tab-menu li");
  const panes = document.querySelectorAll(".tab-pane");

  tabs.forEach(tab=>{
    tab.addEventListener("click", ()=>{

      tabs.forEach(t=>t.classList.remove("active"));
      tab.classList.add("active");

      const id = tab.getAttribute("data-tab");

      panes.forEach(p=>{
        p.classList.remove("active");
        if(p.id === id) p.classList.add("active");
      });

    });
  });

});
</script>


