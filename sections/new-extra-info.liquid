<section id="product-extra-tabs">

<div class="product-extra-tabs">

  <!-- LEFT TABS -->
  <ul class="extra-tab-menu">
    {% for block in section.blocks %}
      <li 
        data-tab="tab-{{ block.id }}" 
        class="{% if forloop.first %}active{% endif %}">
        {{ block.settings.title }}
        <span>→</span>
      </li>
    {% endfor %}
  </ul>


  <!-- RIGHT CONTENT -->
  <div class="extra-tab-content">

    {% for block in section.blocks %}
      <div 
        id="tab-{{ block.id }}" 
        class="tab-pane {% if forloop.first %}active{% endif %}">

        {% case block.type %}

          {% when 'description' %}
            {% if product.content != blank %}
              <div class="extra-info-width">
                <h4 class="product__extra_info-title">Description</h4>
                  {% assign videos = product.media | where: "media_type", "video" %}
                  {% if videos.size > 0 %}
                    <div class="product-videos-wrapper">
                      {% for video in videos %}
                        <div class="product-video-item">
                          <a href="#" class="product-video-trigger" data-video-id="video-{{ video.id }}">
                            {% if video.preview_image %}
                              <div class="product-video-thumbnail-wrapper">
                                <img 
                                  src="{{ video.preview_image | img_url: '800x' }}" 
                                  alt="{{ product.title }} video preview {{ forloop.index }}" 
                                  class="product-video-thumbnail"
                                >
                                <span class="product-video-play-icon">▶</span>
                              </div>
                            {% else %}
                              <div class="video-placeholder">
                                ▶ Play Video {{ forloop.index }}
                              </div>
                            {% endif %}
                          </a>
                        </div>

                        <!-- Modal -->
                        <div id="video-{{ video.id }}" class="product-video-modal">
                          <div class="product-video-modal-content">
                            <span class="product-video-close">&times;</span>
                            {{ video | media_tag: controls: true, autoplay: true }}
                          </div>
                        </div>
                      {% endfor %}
                    </div>

                    <style>
                            .product-videos-wrapper {
                            display: flex;
                            flex-direction: column; /* stack vertically */
                            gap: 16px;
                            margin-bottom: 20px;
                          }

                          .product-video-item {
                            width: 100%; /* full width */
                          }

                          .product-video-thumbnail-wrapper {
                            position: relative;
                            width: 100%;
                          }

                          .product-video-thumbnail {
                            width: 100%;
                            border-radius: 12px;
                            cursor: pointer;
                            display: block;
                          }

                          .product-video-play-icon {
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -50%);
                            font-size: 48px;
                            color: white;
                            text-shadow: 0 0 10px rgba(0,0,0,0.6);
                            pointer-events: none;
                          }

                          @media (max-width: 600px) {
                            .product-video-play-icon {
                              font-size: 36px; /* smaller on mobile */
                            }
                          }

                          /* Modal */
                          .product-video-modal {
                            display: none;
                            position: fixed;
                            z-index: 9999;
                            left: 0;
                            top: 0;
                            width: 100%;
                            height: 100%;
                            background: rgba(0,0,0,0.9);
                            justify-content: center;
                            align-items: center;
                            padding: 10px;
                          }

                          .product-video-modal-content {
                            position: relative;
                            width: 100%;
                            max-width: 900px; /* keeps it centered on big screens */
                            max-height: 90vh;
                          }

                          .product-video-modal iframe,
                          .product-video-modal video {
                            width: 100%;
                            height: auto;
                            max-height: 90vh;
                            border-radius: 12px;
                          }

                          .product-video-close {
                            position: absolute;
                            top: -40px;
                            right: 0;
                            font-size: 32px;
                            color: white;
                            cursor: pointer;
                          }
                          html.no-scroll,
                          body.no-scroll {
                            overflow: hidden;
                            height: 100%;
                          }

                          @media (max-width: 600px) {
                            .product-video-close {
                              top: 10px;
                              right: 10px;
                              font-size: 28px;
                              background: rgba(0,0,0,0.6);
                              border-radius: 50%;
                              padding: 4px 10px;
                              z-index: 999;
                            }
                          }



                    </style>
                      <script>
                      document.addEventListener("DOMContentLoaded", function() {
                        const triggers = document.querySelectorAll(".product-video-trigger");
                        const modals = document.querySelectorAll(".product-video-modal");

                        // Open modal
                        triggers.forEach(trigger => {
                          trigger.addEventListener("click", function(e) {
                            e.preventDefault();
                            const videoId = this.getAttribute("data-video-id");
                            const modal = document.getElementById(videoId);
                            if (modal) {
                              modal.style.display = "flex";
                              document.body.classList.add("no-scroll"); // disable scroll
                            }
                          });
                        });

                        // Close modal
                        modals.forEach(modal => {
                          const closeBtn = modal.querySelector(".product-video-close");
                          closeBtn.addEventListener("click", function() {
                            modal.style.display = "none";
                            document.body.classList.remove("no-scroll"); // re-enable scroll
                            stopVideo(modal);
                          });
                        });

                        // Close when clicking outside
                        window.addEventListener("click", function(e) {
                          modals.forEach(modal => {
                            if (e.target === modal) {
                              modal.style.display = "none";
                              document.body.classList.remove("no-scroll"); // re-enable scroll
                              stopVideo(modal);
                            }
                          });
                        });

                        // Stop video (works for <video> and <iframe>)
                        function stopVideo(modal) {
                          const video = modal.querySelector("video");
                          const iframe = modal.querySelector("iframe");

                          if (video) {
                            video.pause();
                            video.currentTime = 0;
                          }

                          if (iframe) {
                            iframe.src = iframe.src; // reload iframe to stop playback
                          }
                        }
                      });
                      </script>


                  {% endif %}

                {{ product.description }}
              </div>
            {% endif %}

          {% when 'manuals' %}

            {% if block.settings.content != blank %}
              <div class="product__extra_features extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

            {% assign extra = product.metafields.custom.extra_info.value %}
            {% assign addMoreSections = product.metafields.custom.add_more_sections.value %}
            {% assign attachments_metafield = product.metafields.custom.attachments_and_add_ons.value %}
            {% assign otherRigRackSystems = product.metafields.custom.recommended_products.value %}

             {% if extra != blank %}
              {% if extra.manuals != blank %}
                  <div class="extra-info-accordion">
                    <span class="accordion-item">
                      <h4 class="product__extra_info-title">Manuals</h4>
    
                      <svg
                        class="arrow"
                        width="14"
                        height="8"
                        viewBox="0 0 14 8"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7 5.93934L12.4697 0.46967C12.7626 0.176777 13.2374 0.176777 13.5303 0.46967C13.8232 0.762563 13.8232 1.23744 13.5303 1.53033L7.53033 7.53033C7.23744 7.82322 6.76256 7.82322 6.46967 7.53033L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="black"/>
                      </svg>
                    </span>
    
                    <div class="extra-info-accordion-content">
                      <ul class="menu--second-level">
                        {% for link in extra.manuals.value %}
                          <li class="">
                            <a href="{{ link.url }}" target="bank">{{ link.text }}</a>
    
                            <svg
                              class="arrow"
                              width="8"
                              height="14"
                              viewBox="0 0 8 14"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M0.46967 0.46967C0.762563 0.176777 1.23744 0.176777 1.53033 0.46967L7.53033 6.46967C7.82322 6.76256 7.82322 7.23744 7.53033 7.53033L1.53033 13.5303C1.23744 13.8232 0.762563 13.8232 0.46967 13.5303C0.176777 13.2374 0.176777 12.7626 0.46967 12.4697L5.93934 7L0.46967 1.53033C0.176777 1.23744 0.176777 0.762563 0.46967 0.46967Z" fill="black"/>
                            </svg>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </div>
                {% endif %}
             {% endif %}

          {% when 'features' %}

            {% if block.settings.content != blank %}
              <div class="product__extra_features extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

          {% when 'benefits' %}

             {% if block.settings.content != blank %}
              <div class="product__extra_overview extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div class="product__extra_overview-list">{{ block.settings.content }}</div>
              </div>
            {% endif %}
            



          {% when 'tech' %}
            
            {% if block.settings.content != blank %}
              <div class="product__extra_tech extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

            {% assign otherTechSpecs = product.metafields.custom.features_specs.value.other_tech_specs.value %}

          {% if otherTechSpecs != blank %}
              <div class="product__extra_tech extra-info-width">
                <div>{{ otherTechSpecs }}</div>
              </div>
          {% endif %}

          {% when 'weightstacks' %}

            {% if block.settings.content != blank %}
              <div class="product__extra_smith extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

          {% when 'buyingguide' %}
          {% assign buyingGuide = product.metafields.custom.features_specs.value.buying_guide.value %}
            {% if buyingGuide != blank %}
              <div class="product_extra_buyingguide product__extra_tech extra-info-width">
                <div>{{ buyingGuide }}</div>
              </div>
            {% endif %}


          {% when 'faq' %}
             {% assign faq = product.metafields.custom.features_specs.value.frequently_asked_questions.value %}
            {% if faq != blank %}
              <div class="product__extra_tech extra-info-width product__extra_info">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ faq }}</div>
              </div>
            {% endif %}

          {% when 'warranty' %}
          
            {% if block.settings.content != blank %}
              <div class="product__extra_warranty extra-info-width">
                <h4 class="product__extra_info-title">{{ block.settings.title }}</h4>
                <div>{{ block.settings.content }}</div>
              </div>
            {% endif %}

          {% if attachments_metafield != blank %}
              {% assign attachments_object = attachments_metafield %}
              {% if attachments_object.rig_frame_pieces_customize_your_rig_for_sale != blank %}

              {%- assign rig_frame_pieces_count = 0 -%}
              {%- for media in attachments_object.rig_frame_pieces_customize_your_rig_for_sale.value -%}
                {%- assign rig_frame_pieces_count = rig_frame_pieces_count | plus: 1 -%}
              {%- endfor -%}         
              <section class="rig-attachments-section">
                  <h4 class="product__extra_info-title">Rig Frame Pieces (Customize Your Rig) for Sale ({{ rig_frame_pieces_count }})</h4>
                  <div class="rig-product-grid">
                    {% for product_ref in attachments_object.rig_frame_pieces_customize_your_rig_for_sale.value %}
                      <div class="rig-product-card">
                        <div class="rig-product-image-wrap">
                          {% if product_ref.featured_image %}
                            <img 
                              src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                              alt="{{ product_ref.featured_image.alt | escape }}" 
                              class="rig-product-image"
                            >
                          {% endif %}
                        </div>
                        <div class="rig-product-details">
                          <p class="rig-product-price">
                            {{ product_ref.price | money }}
                          </p>
                          <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                          <a target="_blank"
                            class="rig-quickview-btn" 
                            href="{{ product_ref.url }}"
                          >
                            Quick view 
                            <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                          </a>
                        </div>
                      </div>
                    {% endfor %}
                  </div>            
              </section>
              {% endif %}
              {% if attachments_object.rig_attachments_accessories_for_sale != blank %}
                {%- assign rig_attachments_count = 0 -%}
                {%- for media in attachments_object.rig_attachments_accessories_for_sale.value -%}
                  {%- assign rig_attachments_count = rig_attachments_count | plus: 1 -%}
                {%- endfor -%} 
                <section class="rig-attachments-section">
                  <h4 class="product__extra_info-title">Rig Attachments & Accessories for Sale ({{ rig_attachments_count }})</h4>
                  <div class="rig-product-grid">
                    {% for product_ref in attachments_object.rig_attachments_accessories_for_sale.value %}
                      <div class="rig-product-card">
                        <div class="rig-product-image-wrap">
                          {% if product_ref.featured_image %}
                            <img 
                              src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                              alt="{{ product_ref.featured_image.alt | escape }}" 
                              class="rig-product-image"
                            >
                          {% endif %}
                        </div>
                        <div class="rig-product-details">
                          <p class="rig-product-price">
                            {{ product_ref.price | money }}
                          </p>
                          <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                          <a target="_blank"
                            class="rig-quickview-btn" 
                            href="{{ product_ref.url }}"
                          >
                            Quick view 
                            <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                          </a>
                        </div>
                      </div>
                    {% endfor %}
                  </div>            
              </section>
              {% endif %}
          {% endif %}

          {% if otherRigRackSystems != blank %}
            <section class="other-rig-rack-systems-section">
              <h4 class="product__extra_info-title">Other French Fitness Rig & Rack Systems</h4>
              <div class="other-rig-rack-systems-cards">
                {% for product_ref in otherRigRackSystems.other_french_fitness_rig_rack_systems.value %}
                  <div class="rig-product-card">
                    <div class="rig-product-image-wrap">
                      {% if product_ref.featured_image %}
                        <img 
                          src="{{ product_ref.featured_image.src | img_url: '253x303' }}" 
                          alt="{{ product_ref.featured_image.alt | escape }}" 
                          class="rig-product-image"
                        >
                      {% endif %}
                    </div>
                    <div class="rig-product-details">
                      <h3 class="rig-product-name">{{ product_ref.title }}</h3>
                      <div class="rig-lower-details">
                        <div class="rig-product-price">
                          {% if product_ref.metafields.custom.retail_price != blank %}
                            <s>MSRP: {{ product_ref.metafields.custom.retail_price | money -}}</s>
                          {% endif %}
                          <p>{{ product_ref.price | money }}</p>
                        </div>
                        <a target="_blank"
                          class="rig-quickview-btn" 
                          href="{{ product_ref.url }}"
                        >
                          View details 
                          <img src="https://cdn.shopify.com/s/files/1/0884/2012/2940/files/arrow-right-vector.png?v=1744034732" height="11" width="13" />
                        </a>
                      </div>
                    </div>
                  </div>
                {% endfor %}            
              </div>
            </section>
          {% endif %}
          {% render 'prop65' %}
      <a id="download-pds" style="cursor:pointer;">Download Product Data Sheet</a>

        {% endcase %}
      </div>
    {% endfor %}

  </div>

</div>
</section>

<style>
  .metafield-rich_text_field li {
    position: relative;
    margin-bottom: 8px;
    padding-left: 16px;
}
.metafield-rich_text_field li:before {
    content: "";
    display: block;
    width: 9px;
    height: 8px;
    border-radius: 50%;
    position: absolute;
    top: 8px;
    left: 0;
    background: #3e77aa;
}
.product__extra_overview-list li:before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    display: inline-block;
    width: 20px;
    height: 20px;
    background-image: url("https://cdn.shopify.com/s/files/1/0884/2012/2940/files/download.svg?v=1766660420");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.product-extra-tabs{
  display:flex;
  gap:30px;
}

.extra-tab-menu{
  width:260px;
  border-right:1px solid #ddd;
  list-style:none;
  padding:0;
  margin:0;
}

.extra-tab-menu li{
  padding:18px 20px;
  border-bottom:1px solid #eee;
  cursor:pointer;
  font-size:18px;
  font-weight:600;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.extra-tab-menu li.active{
  background:#FFF3EE;
  color:#F1592A;
}

.extra-tab-content{
  flex:1;
  padding:10px 10px;
}

.tab-pane{display:none;}
.tab-pane.active{display:block;}

@media(max-width:768px){
  .product-extra-tabs{
    flex-direction:column;
  }

  .extra-tab-menu{
    width:100%;
    border-right:0;
  }

}
</style>


<script>
document.addEventListener("DOMContentLoaded", ()=>{
  const tabs = document.querySelectorAll(".extra-tab-menu li");
  const panes = document.querySelectorAll(".tab-pane");

  tabs.forEach(tab=>{
    tab.addEventListener("click", ()=>{

      tabs.forEach(t=>t.classList.remove("active"));
      tab.classList.add("active");

      const id = tab.getAttribute("data-tab");

      panes.forEach(p=>{
        p.classList.remove("active");
        if(p.id === id) p.classList.add("active");
      });

    });
  });

});
</script>


