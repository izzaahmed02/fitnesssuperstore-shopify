{% comment %}
  Section: Two Facilities in Benicia
  A two-column layout with image on the left and facility info cards on the right.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color_desktop }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .two-facilities-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .two-facilities-{{ section.id }} .tf-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }

  .two-facilities-{{ section.id }} .tf-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .two-facilities-{{ section.id }} .tf-heading {
    font-size: 32px;
    font-weight: 800;
    line-height: 34px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px;
  }

  .tf-card-{{ section.id }} {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tf-card-title-{{ section.id }} {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .tf-info-row-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .tf-icon-{{ section.id }} {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 1px;
    color: {{ section.settings.icon_color }};
  }

  .tf-info-text-{{ section.id }} {
    font-size: 15px;
    color: #1a1a1a;
    line-height: 1.5;
    margin: 0;
  }

  .tf-info-subtext-{{ section.id }} {
    font-size: 13px;
    color: #9ca3af;
    margin: 2px 0 0;
  }

  .tf-cta-btn-{{ section.id }} {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: 15px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s ease;
    border: none;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
  }

  .tf-cta-btn-{{ section.id }}:hover {
    opacity: 0.88;
    color: {{ section.settings.button_text_color }};
  }

  .tf-facility-plain-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.bg_color_mobile }};
    }

    .two-facilities-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .two-facilities-{{ section.id }} .tf-heading {
      font-size: clamp(24px, 7vw, 32px);
    }
  }
</style>

<div class="two-facilities-{{ section.id }}">

  <div class="tf-image-wrap">
    {%- if section.settings.section_image != blank -%}
      {{
        section.settings.section_image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          alt: section.settings.section_image.alt | escape
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="tf-content">

    {%- if section.settings.heading != blank -%}
      <h2 class="tf-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.facility1_title != blank -%}
      <div class="tf-card-{{ section.id }}">
        <p class="tf-card-title-{{ section.id }}">{{ section.settings.facility1_title }}</p>

        {%- if section.settings.facility1_address != blank -%}
          <div class="tf-info-row-{{ section.id }}">
            <svg class="tf-icon-{{ section.id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
            </svg>
            <p class="tf-info-text-{{ section.id }}">{{ section.settings.facility1_address }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.facility1_hours != blank -%}
          <div class="tf-info-row-{{ section.id }}">
            <svg class="tf-icon-{{ section.id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/>
            </svg>
            <p class="tf-info-text-{{ section.id }}">{{ section.settings.facility1_hours }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.facility1_btn_label != blank and section.settings.facility1_btn_url != blank -%}
          <a class="tf-cta-btn-{{ section.id }}" href="{{ section.settings.facility1_btn_url }}">
            {{ section.settings.facility1_btn_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.facility2_title != blank -%}
      <div class="tf-facility-plain-{{ section.id }}">
        <p class="tf-card-title-{{ section.id }}">{{ section.settings.facility2_title }}</p>

        {%- if section.settings.facility2_address != blank -%}
          <div class="tf-info-row-{{ section.id }}">
            <svg class="tf-icon-{{ section.id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
            </svg>
            <div>
              <p class="tf-info-text-{{ section.id }}">{{ section.settings.facility2_address }}</p>
              {%- if section.settings.facility2_note != blank -%}
                <p class="tf-info-subtext-{{ section.id }}">{{ section.settings.facility2_note }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Two Facilities Warehouse",
  "tag": "section",
  "class": "section-two-facilities",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color_desktop",
      "label": "Background color (desktop)",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "bg_color_mobile",
      "label": "Background color (mobile)",
      "default": "#f3f4f6"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Section image"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Two Facilities in Benicia"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "Icons and Button"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#e8481c"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#e8481c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Facility 1 – Public Showroom"
    },
    {
      "type": "text",
      "id": "facility1_title",
      "label": "Facility 1 title",
      "default": "Public Showroom and Walk-Ins"
    },
    {
      "type": "text",
      "id": "facility1_address",
      "label": "Facility 1 address",
      "default": "457 Industrial Way, Benicia, CA 94510"
    },
    {
      "type": "text",
      "id": "facility1_hours",
      "label": "Facility 1 hours",
      "default": "Monday–Friday 8 AM – 3:30 PM"
    },
    {
      "type": "text",
      "id": "facility1_btn_label",
      "label": "Button label",
      "default": "Request a Showroom Walkthrough"
    },
    {
      "type": "url",
      "id": "facility1_btn_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Facility 2 – Operations"
    },
    {
      "type": "text",
      "id": "facility2_title",
      "label": "Facility 2 title",
      "default": "Operations, Remanufacturing, and Outbound Shipping"
    },
    {
      "type": "text",
      "id": "facility2_address",
      "label": "Facility 2 address",
      "default": "537 Stone Rd Suite F, Benicia, CA 94510"
    },
    {
      "type": "text",
      "id": "facility2_note",
      "label": "Facility 2 note",
      "default": "Not open to the public"
    }
  ],
  "presets": [
    {
      "name": "Two Facilities Warehouse"
    }
  ]
}
{% endschema %}