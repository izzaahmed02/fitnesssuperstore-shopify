{{ 'rich-text-custom.css' | asset_url | stylesheet_tag }}

<div class="rich-text-custom__wrapper">
    <div class="rich-text-custom__content">
        <h2 class="rich-text-custom__title">{{ section.settings.title }}</h2>
        {%- if section.settings.description -%}
          <p class="rich-text-custom__description">{{ section.settings.description }}</p>
        {%- endif -%}
        <a href="{{ section.settings.url }}"
           class="rich-text-custom__btn">{{ section.settings.label }} {% render 'chevron-right' %}</a>
    </div>
</div>

{% schema %}
{
  "name": "Custom Rich text",
  "tag": "section",
  "class": "section rich-text-custom",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Ready to get top-branded gym equipment for up to 70% off MSRP?",
      "label": "Section title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Section Button Link"
    },
    {
      "type": "text",
      "id": "label",
      "default": "Shop remanufactured equipment",
      "label": "Section Button Label"
    }
  ],
  "presets": [
    {
      "name": "Custom Rich text"
    }
  ]
}
{% endschema %}


