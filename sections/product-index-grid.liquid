{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  if collection.url
    assign results_url = collection.url
  else
    assign terms = collection.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

<div class="container page-width">
  <div id="ProductGridContainer" class="collection-wrapper">
    <div class="collection-filter-wrapper">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

      <aside
        aria-labelledby="verticalTitle"
        class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'facets',
          results: collection,
          enable_filtering: true,
          enable_sorting: true,
          filter_type: 'vertical',
          paginate: paginate
        %}
      </aside>
    </div>

    <div id="ProductGridContainerMain" class="collection-product-wrapper">
      {%- liquid
        assign sort_by = collection.sort_by | default: 'title-ascending'
      -%}
      <div class="collection-grid-top">
        <form id="collection-search-form">
          <input type="text" id="search-input" placeholder="Search">
        </form>

        <div class="right-side">
          <facet-filters-form class="facets facets-vertical-sort small-hide">
            <form class="facets-vertical-form" id="FacetSortForm">
              <div class="facet-filters sorting caption">
                <div class="facet-filters__field">
                  <div class="select">
                    {%- assign sort_by = collection.sort_by | default: 'title-ascending' -%}
                    <select
                      name="sort_by"
                      class="facet-filters__sort select__select caption-large"
                      id="SortBy"
                      aria-describedby="a11y-refresh-page-message"
                    >
                      {%- for option in collection.sort_options -%}
                        {% if option.value == 'title-ascending' or option.value == 'title-descending' %}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ 'products.facets.sort_by_label' | t }}
                            {{ option.name | escape }}
                          </option>
                        {% endif %}
                      {%- endfor -%}
                    </select>
                    {% render 'icon-caret' %}
                  </div>
                </div>
              </div>
            </form>
          </facet-filters-form>

          {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
          {%- assign pageUrl = contentForQuerystring
            | split: '"pageurl":"'
            | last
            | split: '"'
            | first
            | split: '.myshopify.com'
            | last
            | replace: '\/', '/'
            | replace: '%20', ' '
            | replace: '\u0026', '&'
          -%}
          {%- assign products_per_page = 30 -%}
          {%- for i in (1..1) -%}
            {%- unless pageUrl contains '?' -%}{% break %}{%- endunless -%}
            {%- if pageUrl contains 'perview=30' -%}{%- assign products_per_page = 30 -%}{%- endif -%}
            {%- if pageUrl contains 'perview=60' -%}{%- assign products_per_page = 60 -%}{%- endif -%}
            {%- if pageUrl contains 'perview=90' -%}{%- assign products_per_page = 90 -%}{%- endif -%}
          {%- endfor -%}

          <div class="sort-per-page">
            <span class="label">Show </span>
            <div class="select">
              <select id="sel1" class="num">
                <option
                  value="/collections/{{ collection.handle }}?perview=30"
                  {% if products_per_page == 30 %}
                    selected="selected"
                  {% endif %}
                >
                  30
                </option>
                <option
                  value="/collections/{{ collection.handle }}?perview=60"
                  {% if products_per_page == 60 %}
                    selected="selected"
                  {% endif %}
                >
                  60
                </option>
                <option
                  value="/collections/{{ collection.handle }}?perview=90"
                  {% if products_per_page == 90 %}
                    selected="selected"
                  {% endif %}
                >
                  90
                </option>
              </select>
              {% render 'icon-caret' %}
            </div>
            <span class="label"> per page</span>
          </div>
        </div>
      </div>

      <div class="mobile_facets">
        {% render 'facets',
          results: collection,
          enable_filtering: true,
          enable_sorting: true,
          filter_type: 'vertical',
          paginate: paginate
        %}
      </div>

      <div class="tags-wrapper">
        {% comment %} {% paginate collection.products by products_per_page %}
          {% assign current_page = paginate.current_page %}
          {% assign current_offset = paginate.current_offset %}
          {% assign items_count = paginate.items %}
        {% endpaginate %}
        {% assign current_offset = current_offset | plus: 1 %}
        {% assign page_count = current_page | times: products_per_page %}
        <div class="collecion-count">
          <span>
            {%- if current_offset != items_count %}
              {{ current_offset }}-
              {%- if page_count <= items_count %}{{ page_count }}{% else %}{{ items_count }}{% endif -%}
            {%- else -%}
              {{- current_offset -}}
            {%- endif -%}
          </span>
          of {{ items_count }}
        </div> {% endcomment %}

        <div class="collecion-count">
          <span id="collection-count-range"></span> of <span id="collection-total-count"></span>
        </div>
        
        <div class="active-facets active-facets-desktop">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <facet-remove>
                <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                  <span class="active-facets__button-inner button button--tertiary">
                    <span>{{ filter.label | escape }}: </span> {{ value.label | escape }}
                    {% render 'icon-close-small' %}
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
                </a>
              </facet-remove>
            {%- endfor -%}
            {% if filter.type == 'price_range' %}
              {% assign min = filter.min_value.value %}
              {% assign max = filter.max_value.value %}
              {%- if min != null or max != null -%}
                <facet-remove>
                  <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                    <span class="active-facets__button-inner button button--tertiary">
                      {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                      {% render 'icon-close-small' %}
                      <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                    </span>
                  </a>
                </facet-remove>
              {%- endif -%}
            {% endif %}
          {%- endfor -%}
          <div class="active-facets-vertical-filter">
            {% assign tagsCount = 0 %}
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                {% assign tagsCount = tagsCount | plus: 1 %}
              {% endfor %}
            {% endfor %}
            {% if tagsCount > 0 %}
              <facet-remove class="active-facets__button-wrapper">
                <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                  <span>
                    Clear all
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M5.46967 5.46967C5.76256 5.17678 6.23744 5.17678 6.53033 5.46967L12 10.9393L17.4697 5.46967C17.7626 5.17678 18.2374 5.17678 18.5303 5.46967C18.8232 5.76256 18.8232 6.23744 18.5303 6.53033L13.0607 12L18.5303 17.4697C18.8232 17.7626 18.8232 18.2374 18.5303 18.5303C18.2374 18.8232 17.7626 18.8232 17.4697 18.5303L12 13.0607L6.53033 18.5303C6.23744 18.8232 5.76256 18.8232 5.46967 18.5303C5.17678 18.2374 5.17678 17.7626 5.46967 17.4697L10.9393 12L5.46967 6.53033C5.17678 6.23744 5.17678 5.76256 5.46967 5.46967Z" fill="#E9380D"/>
                    </svg>
                  </span>
                </a>
              </facet-remove>
            {% endif %}
          </div>
        </div>
      </div>

        <div
          class="collection product-index-grid search-results-container"
          id="product-grid"
          data-id="{{ section.id }}"
        >

          <!-- Filtered products will be rendered here -->
        </div>

        <div class="loading-overlay gradient"></div>

      <div id="pagination-container">
        <!-- Pagination buttons will appear here -->
      </div>
    </div>
  </div>
</div>

<script>
  let allProducts = [];
  let filteredProducts = [];
  let currentPage = 1;
  const itemsPerPage = {{ products_per_page }};

  const searchForm = document.getElementById('collection-search-form');
  searchForm.addEventListener('submit', handleSearchInput);
  
  // Filter products based on the search query
  function filterProducts(searchQuery, filters) {
    if (!searchQuery && Object.keys(filters).length === 0) {
      return allProducts;
    }
  
    return allProducts.filter(product => {
      const matchesQuery = product.title.toLowerCase().includes(searchQuery);
      return matchesQuery;
    });
  }

  function updateProductCount() {
    const countRange = document.getElementById('collection-count-range');
    const totalCount = document.getElementById('collection-total-count');
    const mobileTotal = document.querySelectorAll('.product-count__text');
  
    const start = (currentPage - 1) * itemsPerPage + 1;
    const end = Math.min(start + itemsPerPage - 1, filteredProducts.length);
    const total = filteredProducts.length;
  
    // Update the count elements
    countRange.textContent = start !== end ? `${start}-${end}` : `${start}`;
    totalCount.textContent = total;

    if (mobileTotal) {
      console.log(`${total} results`);
      mobileTotal.forEach((el) => el.textContent = `${total} results`);
      console.log(mobileTotal);
    }
  }  
  
  // Render a single product
  function renderProduct(product) {
    return `
      <li class="product-item product-li-item" data-brand="${product.brand}">
        <span class="model">${product.model}</span>
        <span class="price">${product.price}</span>
        <span class=""><a href="${product.url}">${product.title}</a></span>
      </li>
    `;
  }
  
  // Create brand title and product containers
  function renderBrandsAndProducts() {
    const productGrid = document.getElementById('product-grid');
  
    if (!productGrid) return;
  
    const products = Array.from(productGrid.querySelectorAll('.product-li-item'));
  
    let currentBrand = null;
    let brandContainer = null;
  
    products.forEach((product) => {
      const brand = product.dataset.brand || "";
  
      if (brand !== currentBrand) {
        // Create a new container for the brand
        const brandContainerWrapper = document.createElement('div');
        brandContainerWrapper.className = 'brand-container--wrapper';
        productGrid.appendChild(brandContainerWrapper);
        
        brandContainer = document.createElement('ul');
        brandContainer.className = 'brand-container';
        brandContainerWrapper.appendChild(brandContainer);
  
        // Create and insert the brand title before the container
        const brandTitle = document.createElement('h2');
        brandTitle.textContent = brand;
        brandTitle.className = 'brand-title';
        productGrid.insertBefore(brandTitle, brandContainerWrapper);
  
        currentBrand = brand;
      }
  
      if (brandContainer) {
        brandContainer.appendChild(product);
      }
    });
  }
  
  // Render Pagination
  function renderPagination(totalItems, itemsPerPage) {
    const paginationContainer = document.getElementById('pagination-container');
    const totalPages = Math.ceil(totalItems / itemsPerPage);
    const maxVisibleButtons = 5; 
  
    if (totalPages <= 1) {
      paginationContainer.innerHTML = '';
      return;
    }
  
    function updatePagination() {
      const paginationContainer = document.getElementById('pagination-container');
  
      if (!paginationContainer) {
          console.error('Pagination container not found.');
          return;
      }
  
      paginationContainer.innerHTML = ''; // Clear previous pagination
  
      // Previous button
      const prevButton = document.createElement('button');
      prevButton.className = 'pagination-prev';
      prevButton.disabled = currentPage === 1;
      prevButton.addEventListener('click', () => {
          if (currentPage > 1) {
              currentPage--;
              renderPage();
              updatePagination();
          }
      });
      paginationContainer.appendChild(prevButton);
  
      // Dynamic page range calculation
      let startPage = Math.max(1, currentPage - Math.floor(maxVisibleButtons / 2));
      let endPage = Math.min(totalPages, startPage + maxVisibleButtons - 1);
  
      // Adjust the range when close to edges
      if (endPage - startPage < maxVisibleButtons - 1) {
          startPage = Math.max(1, endPage - maxVisibleButtons + 1);
      }
  
      // Add first page and ellipsis if needed
      if (startPage > 1) {
          createPageButton(1);
          if (startPage > 2) {
              createEllipsis();
          }
      }
  
      // Add page buttons in range
      for (let i = startPage; i <= endPage; i++) {
          createPageButton(i);
      }
  
      // Add ellipsis and last page if needed
      if (endPage < totalPages) {
          if (endPage < totalPages - 1) {
              createEllipsis();
          }
          createPageButton(totalPages);
      }
  
      // Next button
      const nextButton = document.createElement('button');
      nextButton.className = 'pagination-next';
      nextButton.disabled = currentPage === totalPages;
      nextButton.addEventListener('click', () => {
          if (currentPage < totalPages) {
              currentPage++;
              renderPage();
              updatePagination();
          }
      });
      paginationContainer.appendChild(nextButton);
    }
  
    function createPageButton(page) {
      const pageButton = document.createElement('button');
      pageButton.textContent = page;
      pageButton.className = 'pagination-button';
      if (page === currentPage) {
        pageButton.classList.add('active');
      }
      pageButton.addEventListener('click', () => {
        currentPage = page;
        renderPage();
        updatePagination();
      });
      paginationContainer.appendChild(pageButton);
    }
  
    function createEllipsis() {
      const ellipsis = document.createElement('span');
      ellipsis.textContent = '...';
      ellipsis.className = 'pagination-ellipsis';
      paginationContainer.appendChild(ellipsis);
    }
  
    updatePagination();
  }
  
  // Render the current page of products
  function renderPage() {
    const resultsContainer = document.querySelector('.search-results-container');
    const paginationContainer = document.getElementById('pagination-container');
  
    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
  
    const pageProducts = filteredProducts.slice(start, end);
  
    resultsContainer.innerHTML = '';
  
    pageProducts.forEach(product => {
      resultsContainer.innerHTML += renderProduct(product);
    });
  
    renderPagination(filteredProducts.length, itemsPerPage);
    renderBrandsAndProducts();
    updateProductCount();
  }
    
  async function handleSearchInput(event) {
    event.preventDefault();
  
    const searchInput = document.getElementById('search-input');
    const searchQuery = searchInput.value.toLowerCase().trim();
    const resultsContainer = document.querySelector('.search-results-container');
    const paginationContainer = document.getElementById('pagination-container');
  
    resultsContainer.innerHTML = '';
    paginationContainer.innerHTML = '';
  
    const url = new URL(window.location);
    const activeFilters = new URLSearchParams(window.location.search);
  
    if (!searchQuery) {
      // If search input is cleared, remove query parameter
      activeFilters.delete('q');
      window.history.pushState({}, '', `${url.pathname}?${activeFilters.toString()}`);
      
      // Reset to show all products
      filteredProducts = allProducts;
      currentPage = 1;
      renderPage();
      return;
    }
  
    // If there's a search query, update the query parameter
    activeFilters.set('q', searchQuery);
    window.history.pushState({}, '', `${url.pathname}?${activeFilters.toString()}`);
  
    try {
      allProducts = await fetchAllProducts();
      filteredProducts = filterProducts(searchQuery, {});
  
      if (filteredProducts.length) {
        currentPage = 1;
        renderPage();
      } else {
        resultsContainer.innerHTML = '<p>No products found matching your search and filters.</p>';
      }
    } catch (error) {
      console.error('Error fetching filtered products:', error);
      resultsContainer.innerHTML = '<p>Something went wrong while fetching products.</p>';
    }
  }  
  
  // Fetch all products
  async function fetchAllProducts() {
    const collectionWrapper = document.querySelector('.collection-product-wrapper');
    collectionWrapper.classList.add('loading');
  
    try {
      const collectionHandle = '{{ collection.handle }}';
      const filterParams = new URLSearchParams(window.location.search);
  
      filterParams.append('view', 'ajax_full_collection');
  
      const response = await fetch(`/collections/${collectionHandle}?${filterParams.toString()}`);
      if (!response.ok) {
        throw new Error('Failed to fetch products');
      }
  
      const rawResponseText = await response.text();
      const sanitizedData = rawResponseText.replace(/[\x00-\x1F\x7F]/g, '');
      const products = JSON.parse(sanitizedData);
  
      return products;
    } catch (error) {
      console.error('Error fetching products:', error);
      throw error;
    } finally {
      collectionWrapper.classList.remove('loading');
    }
  }
  
  // Initial page load logic
  window.addEventListener('DOMContentLoaded', async function () {
    try {
      const searchQuery = new URLSearchParams(window.location.search).get('q') || '';
      document.getElementById('search-input').value = searchQuery;
  
      allProducts = await fetchAllProducts();
      filteredProducts = filterProducts(searchQuery.toLowerCase(), {});
      currentPage = 1;
      renderPage();
    } catch (error) {
      console.error('Error during initial product load:', error);
      const resultsContainer = document.querySelector('.search-results-container');
      resultsContainer.innerHTML = '<p>Failed to load products. Please try again.</p>';
    }
  });
  
  let previousParams = new URLSearchParams(window.location.search).toString();

  async function handleUrlChange() {
    const currentParams = new URLSearchParams(window.location.search).toString();
    
    if (currentParams !== previousParams) {
      previousParams = currentParams;
  
      const collectionWrapper = document.querySelector('.collection-product-wrapper');
      const searchQuery = new URLSearchParams(window.location.search).get('q') || '';
      const filters = {};
  
      for (const [key, value] of new URLSearchParams(window.location.search).entries()) {
        if (key !== 'q') {
          filters[key] = value;
        }
      }
  
      collectionWrapper.classList.add('loading');
  
      try {
        document.getElementById('search-input').value = searchQuery;
  
        allProducts = await fetchAllProducts(filters);
        filteredProducts = filterProducts(searchQuery.toLowerCase(), {});
        currentPage = 1;
        renderPage();
      } catch (error) {
        console.error('Error during initial product load:', error);
        const resultsContainer = document.querySelector('.search-results-container');
        resultsContainer.innerHTML = '<p>Failed to load products. Please try again.</p>';
      } finally {
        collectionWrapper.classList.remove('loading');
      }
    }
  }
  
  // MutationObserver to watch for DOM changes that may update the URL
  const observer = new MutationObserver(() => {
    const currentParams = new URLSearchParams(window.location.search).toString();
    if (currentParams !== previousParams) {
      handleUrlChange();
    }
  });

  // Observe the document for changes
  observer.observe(document, { childList: true, subtree: true });

  document.addEventListener('input', (event) => {
    if (event.target && event.target.id === 'search-input') {
      handleSearchInput(event);
    }
  });
</script>

