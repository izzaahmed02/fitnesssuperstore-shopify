    </div>
    {% render 'product-media-modal', variant_images: variant_images %}
    <div id="icon-close-template" style="display: none;">
      {% render 'icon-close-small' %}
    </div>
    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
          class="product-popup-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          <div class="product-popup-modal__content-info">
            <h2 class="h2">{{ block.settings.page.title | escape }}</h2>
            {{ block.settings.page.content }}
          </div>
        </div>
      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}

    <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-mobile-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}


</product-info>

<div id="product-gallery-popup" class="product-popup-overlay" hidden>
  <div class="product-popup-backdrop"></div>

  <div class="product-popup" role="dialog" aria-modal="true">
    <button class="popup-close" type="button" aria-label="Close popup">&times;</button>

    <div class="popup-tabs">
      <button class="popup-tab is-active" data-tab="images">Images</button>

      {%- assign has_videos = false -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
          {%- assign has_videos = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_videos -%}
        <button class="popup-tab" data-tab="videos">Videos</button>
      {%- endif -%}
    </div>

    <div class="popup-content">
      <div class="popup-media-viewer" data-popup-viewer></div>

      <div class="popup-sidebar">
        <div class="popup-product-title" data-popup-title></div>
        <div class="popup-thumbnails" data-tab-content="images"></div>
        <div class="popup-thumbnails hidden" data-tab-content="videos"></div>
      </div>
    </div>
  </div>
</div>

<div id="mobile-gallery-popup" class="mobile-popup-overlay" hidden>
  <div class="mobile-popup-backdrop"></div>
  <button class="mobile-popup-close" aria-label="Close">×</button>
  <div class="mobile-popup-slider"></div>
  <div class="mobile-popup-thumbnails"></div>
  <div class="mobile-popup-dots"></div>
</div>

{% assign options = product.metafields.options.product_options.value %}
{% for category in options %}
  {% if category.help_text.value != blank %}
    {% liquid
      assign content = category.help_text.value
      assign title = content.title
      assign text = content.help_text
      assign related_products = content.related_products.value
    %}
    {% render 'related-products-popup-for-options',
      popup_id: category.title,
      title: title,
      related_products: related_products,
      text: text
    %}
  {% endif %}

  {% for product_option in category.product_options.value %}
    {% if product_option.help_text.value != blank %}
      {% liquid
        assign content = product_option.help_text.value
        assign title = content.title
        assign text = content.help_text
        assign related_products = content.related_products.value
      %}
      {% render 'related-products-popup-for-options', 
        popup_id: product_option.product_option_title,
        title: title,
        related_products: related_products,
        text: text
      %}
    {% endif %}
  {% endfor %}
{% endfor %}



<style>
  #dynamic-product-content iframe{max-width:100% !important;}


    #model {
--progress-bar-color: none;
--progress-bar-height: 0px;
}

  #dynamic-product-content iframe {
    max-width: 100% !important;
  }
  .icon-3d {
    position: absolute;
    top: 0px;
    right: 2px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .icon-3d.main {
    top: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
  }

  .icon-3d.thumb {
    top: 0px;
    right: 1px;
    width: 18px;
    height: 18px;
  }

  .icon-3d svg {
    width: 100%;
    height: 100%;
  }

  .image-skeleton-wrapper,
  .main-image-container {
    position: relative;
  }

  .pr_custom_price-container .pr_custom_compare_price {
    height: unset;
    background: none;
    font-size: 28px;
    line-height: 40px;
    font-weight: 100;
    color: #808080 !important;
    padding: 0px;
    margin-bottom: 0px;
  }

  .pr_custom_price-container .pr_custom_price {
    color: #F1592A !important;
  }
</style>


