                      </svg>
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

        <script type="application/json" data-product-media>
          [
            {% for media in product.media %}
              {
                "id": {{ media.id | json }},
                "media_type": {{ media.media_type | json }},
                "alt": {{ media.alt | json }},
                "preview_image": {
                  "src": {{ media.preview_image | image_url: width: 720 | json }},
                  "srcset": "{{ media.preview_image | image_url: width: 360 }} 360w, {{ media.preview_image | image_url: width: 540 }} 540w, {{ media.preview_image | image_url: width: 720 }} 720w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1080 }} 1080w, {{ media.preview_image | image_url: width: 1440 }} 1440w",
                  "sizes": "(min-width: 1200px) 34vw, (min-width: 990px) 38vw, 100vw",
                  "width": {{ media.preview_image.width | json }},
                  "height": {{ media.preview_image.height | json }}
                }
                {% if media.media_type == 'model' %}
                {% assign media_camera_orbit = media.presentation.camera_orbit %}
                  , "url": {% for source in media.sources %}{% if source.format == 'glb' %}"{{ source.url }}"{% endif %}{% endfor %}
                  , "camera_orbit": {{ media_camera_orbit | json }}
                {% elsif media.media_type == 'video' %}
                  , "sources": [
                    {% for source in media.sources %}
                      {
                        "url": {{ source.url | json }},
                        "mime_type": {{ source.mime_type | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                {% elsif media.media_type == 'external_video' %}
                  , "host": {{ media.host | json }},
                    "external_id": {{ media.external_id | json }}
                {% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>

        {% comment %}
          Templates that hold the native Shopify model_viewer markup for each 3D media item.
          They are cloned on demand so camera orbit data defined in the admin is preserved.
        {% endcomment %}
        {% for media in product.media %}
          {% if media.media_type == 'model' %}
            <template id="ModelViewerTemplate-{{ media.id }}" data-model-viewer-template>
              {{
                media
                | model_viewer_tag:
                  image_size: '2048x',
                  reveal: 'auto',
                  toggleable: true,
                  interaction_prompt: 'auto',
                  loading: 'eager'
              }}
            </template>
          {% endif %}
        {% endfor %}
      </product-gallery>

        {%- liquid
          assign mobile_gallery_featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media | default: product.media.first
          assign mobile_gallery_aspect_ratio = mobile_gallery_featured_media.preview_image.aspect_ratio | default: mobile_gallery_featured_media.aspect_ratio | default: 1
        -%}
        <mobile-gallery style="--mobile-gallery-aspect-ratio: {{ mobile_gallery_aspect_ratio }};">
          <div class="mobile-gallery-wrapper only-mobile">
          <div class="main-slider-arrow--left" type="button">
            <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 0.46967C7.48924 0.762563 7.48924 1.23744 7.19635 1.53033L2.72668 6L7.19635 10.4697C7.48924 10.7626 7.48924 11.2374 7.19635 11.5303C6.90345 11.8232 6.42858 11.8232 6.13569 11.5303L1.13569 6.53033C0.995033 6.38968 0.916016 6.19891 0.916016 6C0.916016 5.80109 0.995033 5.61032 1.13569 5.46967L6.13569 0.46967C6.42858 0.176777 6.90345 0.176777 7.19635 0.46967Z" fill="white"/>
            </svg>
          </div>

            <div class="mobile-gallery-slider image-skeleton-wrapper"></div>

          <div class="main-slider-arrow--right" type="button">
            <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M0.803654 0.46967C1.09655 0.176777 1.57142 0.176777 1.86431 0.46967L6.86431 5.46967C7.15721 5.76256 7.15721 6.23744 6.86431 6.53033L1.86431 11.5303C1.57142 11.8232 1.09655 11.8232 0.803654 11.5303C0.510761 11.2374 0.510761 10.7626 0.803654 10.4697L5.27332 6L0.803654 1.53033C0.510761 1.23744 0.510761 0.762563 0.803654 0.46967Z" fill="white"/>
            </svg>
          </div>

          <div class="mobile-gallery-dots"></div>
          </div>
        </mobile-gallery>

        {% if section.settings.accent_text != blank %}
          <div class="product__accesnt-text hidden lg:flex">
            <div>
              <p class="product__accesnt-text-text">{{ section.settings.accent_text }}</p>
              <p>{{ section.settings.text }}</p>
            </div>

            <a href="{{ section.settings.button_link  | default: '#' }}">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.45958 2.25002L5.52495 2.25005L5.58515 2.25003C5.91729 2.24988 6.17563 2.24977 6.41432 2.29189C7.31374 2.45061 8.07568 3.04551 8.4478 3.87958C8.54655 4.10093 8.6091 4.35157 8.68951 4.67382L8.68951 4.67383L8.68951 4.67384L8.7041 4.73225L9.11772 6.38672L9.12677 6.42291L9.12677 6.42293C9.26686 6.98319 9.38575 7.4587 9.44293 7.86157C9.5038 8.29046 9.50557 8.70021 9.36866 9.12073C9.23175 9.54125 8.9891 9.87142 8.68738 10.1823C8.40398 10.4743 8.02792 10.7886 7.58483 11.1591L7.55622 11.183L5.94399 12.5308C7.2473 14.8902 9.10778 16.7507 11.4672 18.054L12.815 16.4418L12.839 16.4132C13.2094 15.9701 13.5238 15.594 13.8157 15.3106C14.1266 15.0089 14.4568 14.7663 14.8773 14.6294C15.2978 14.4924 15.7075 14.4942 16.1364 14.5551C16.5393 14.6123 17.0148 14.7311 17.575 14.8712L17.5751 14.8712L17.5751 14.8713L17.6113 14.8803L19.2658 15.2939L19.3242 15.3085L19.3242 15.3085C19.6464 15.3889 19.8971 15.4515 20.1184 15.5502C20.9525 15.9223 21.5474 16.6843 21.7061 17.5837C21.7482 17.8224 21.7481 18.0807 21.748 18.4129L21.748 18.4731L21.748 18.5384C21.7482 18.9214 21.7484 19.2237 21.6818 19.5215C21.4397 20.6055 20.4364 21.5157 19.334 21.6514C19.0316 21.6886 18.7718 21.6632 18.4486 21.6315L18.4485 21.6315L18.4485 21.6315L18.4017 21.6269C15.7621 21.3694 13.3864 20.7099 11.3171 19.6702C8.24296 18.1256 5.87243 15.755 4.32781 12.6809C3.28809 10.6116 2.62865 8.23596 2.37111 5.5963L2.36653 5.54952C2.33484 5.22628 2.30937 4.96642 2.3466 4.66401C2.48232 3.56164 3.39252 2.55831 4.4765 2.31618C4.77435 2.24965 5.07657 2.24982 5.45958 2.25002ZM12.8556 18.7319C14.5361 19.452 16.4378 19.9282 18.5474 20.134C18.9338 20.1717 19.0296 20.1776 19.1507 20.1627C19.6235 20.1044 20.1141 19.6594 20.2179 19.1945C20.2438 19.0784 20.248 18.9515 20.248 18.4731C20.248 18.0524 20.2452 17.9363 20.2289 17.8444C20.1568 17.4355 19.8864 17.0892 19.5073 16.9201C19.422 16.882 19.31 16.8511 18.902 16.7491L17.2475 16.3355C16.6413 16.184 16.2419 16.0851 15.9257 16.0402C15.6268 15.9978 15.4677 16.0146 15.3416 16.0557C15.2156 16.0967 15.0771 16.1768 14.8605 16.387C14.6313 16.6095 14.3666 16.9245 13.9658 17.4039L12.8556 18.7319ZM5.26615 11.1424L6.59411 10.0322C7.07351 9.63137 7.38855 9.36676 7.61102 9.13755C7.82126 8.92094 7.90131 8.78242 7.94235 8.65637C7.98339 8.53032 8.00023 8.37122 7.95781 8.07235C7.91293 7.75611 7.81406 7.35674 7.6625 6.75052L7.24889 5.09605C7.14687 4.68797 7.11601 4.57604 7.07795 4.49074C6.90881 4.11162 6.56247 3.84121 6.15365 3.76907C6.06166 3.75283 5.94559 3.75005 5.52495 3.75005C5.04653 3.75005 4.91959 3.75418 4.80349 3.78011C4.3386 3.88395 3.89356 4.37452 3.83536 4.8473C3.82044 4.96843 3.82631 5.06417 3.86402 5.45064C4.06984 7.56018 4.54599 9.46194 5.26615 11.1424ZM13.2478 6.99999C13.2478 6.58578 13.5836 6.24999 13.9978 6.24999C15.0244 6.24999 15.9319 6.8889 16.5454 7.54437C16.8889 7.91141 17.18 8.32423 17.3888 8.73048C17.59 9.12199 17.7478 9.57165 17.7478 9.99999C17.7478 10.4142 17.412 10.75 16.9978 10.75C16.5836 10.75 16.2478 10.4142 16.2478 9.99999C16.2478 9.91004 16.2042 9.70708 16.0547 9.41609C15.9127 9.13983 15.7038 8.84025 15.4503 8.56942C14.954 8.03924 14.4164 7.74999 13.9978 7.74999C13.5836 7.74999 13.2478 7.41421 13.2478 6.99999ZM13.9978 3.24999C13.5836 3.24999 13.2478 3.58578 13.2478 3.99999C13.2478 4.41421 13.5836 4.74999 13.9978 4.74999C16.8973 4.74999 19.2478 7.1005 19.2478 9.99999C19.2478 10.4142 19.5836 10.75 19.9978 10.75C20.412 10.75 20.7478 10.4142 20.7478 9.99999C20.7478 6.27207 17.7258 3.24999 13.9978 3.24999Z" fill="white"/>
              </svg>

              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="opacity: 1 !important;">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- comment -%}
            AB Test - Option B ("asjads-pdp") — Main info buy-box.
            Rebuilt from Figma frame 3679:78324 ("Main info", file
            XBaAGVhSupd0fvIcXd28qw, node-id 3679-78324). Scope: this section
            renders the "Main info" column only (title, size-swap cards,
            price/financing, tabs, showroom badge, CTAs, add-ons) — the
            product media gallery above is the existing, reusable PDP
            component and is intentionally left untouched.

            CTA WIRING — per explicit direction, the quote-flow buttons below
            ("Request Quote Review", "Open in Gym Designer", "Customize this
            build") are VISUAL ONLY: plain <button type="button"> elements
            with no popup, cart, or submission logic attached yet. There is
            intentionally no Add to Cart button in this design, matching
            Figma. Wire these up once the target flow (quote popup vs. real
            purchase) is decided. The "Get delivered quote / confirm fit"
            button and the secondary "Request Quote Review" text link have
            been removed per P0.

            Size-swap cards are driven by product.variants — one card per
            variant, matching the future single-package/size product this
            template will be assigned to. Selecting a card navigates to that
            variant's URL (read-only page view, not a cart mutation).

            Two near-duplicate blocks in the Figma frame (a second, narrower
            "Info" tab panel + "Total price/CTA" section, and a fully
            duplicated Add-ons/most-popular block lower in the frame) were
            treated as leftover design exploration and were not rebuilt here
            — see the read-out given to the team before this rewrite.
          {%- endcomment -%}

          {%- liquid
            assign current_variant = product.selected_or_first_available_variant
            assign custom_product_options_block = section.blocks | where: 'type', 'product_options'
            assign abtest_mp_price = current_variant.price
          -%}

          {% style %}
            #shopify-section-{{ section.id }} .abtest-title {
              margin-bottom: 20px;
            }

            #shopify-section-{{ section.id }} .abtest-title__row {
              display: flex;
              align-items: center;
              flex-wrap: wrap;
              gap: 12px;
              justify-content: space-between;
            }

            #shopify-section-{{ section.id }} .abtest-title__name {
              font-family: var(--font-heading-family);
              font-size: 30px;
              line-height: 40px;
              color: #23232b;
              margin: 0;
            }

            #shopify-section-{{ section.id }} .abtest-title__status {
              display: flex;
              align-items: center;
              flex-wrap: wrap;
              gap: 12px;
            }

            #shopify-section-{{ section.id }} .abtest-tag {
              display: inline-flex;
              align-items: center;
              padding: 8px 16px;
              border-radius: 43px;
              font-size: 14px;
              font-weight: 700;
              line-height: 20px;
              white-space: nowrap;
            }

            #shopify-section-{{ section.id }} .abtest-tag--available {
              background: #ccedda;
              color: #12693a;
            }

            #shopify-section-{{ section.id }} .abtest-tag--unavailable {
              background: #f1e5e5;
              color: #8a2c2c;
            }

            #shopify-section-{{ section.id }} .abtest-size-cards {
              display: grid;
              grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
              gap: 12px;
              margin: 0 0 20px;
              border: 0;
              padding: 0;
            }

            #shopify-section-{{ section.id }} .abtest-size-card__input {
              position: absolute;
              opacity: 0;
              pointer-events: none;
            }

            #shopify-section-{{ section.id }} .abtest-size-card {
              display: flex;
              flex-direction: column;
              gap: 8px;
              border: 1px solid #e5e5e5;
              border-radius: 8px;
              padding: 12px;
              cursor: pointer;
              background: #fff;
            }

            #shopify-section-{{ section.id }} .abtest-size-card.is-selected {
              border-color: #d83d0e;
              border-width: 2px;
              padding: 11px;
            }

            #shopify-section-{{ section.id }} .abtest-size-card.is-soldout {
              opacity: 0.5;
              cursor: not-allowed;
            }

            #shopify-section-{{ section.id }} .abtest-size-card__title {
              font-size: 14px;
              font-weight: 700;
              color: #23232b;
            }

            #shopify-section-{{ section.id }} .abtest-size-card__desc {
              font-size: 12px;
              line-height: 18px;
              color: #808080;
            }

            #shopify-section-{{ section.id }} .abtest-size-card__price {
              font-size: 14px;
              font-weight: 700;
              color: #d83d0e;
            }

            #shopify-section-{{ section.id }} .abtest-price {
              margin-bottom: 16px;
            }

            #shopify-section-{{ section.id }} .abtest-price__was {
              font-size: 16px;
              color: #808080;
              margin: 0 0 4px;
            }

            #shopify-section-{{ section.id }} .abtest-price__row {
              display: flex;
              align-items: center;
              flex-wrap: wrap;
              gap: 12px;
            }

            #shopify-section-{{ section.id }} .abtest-price__label {
              font-size: 16px;
              line-height: 24px;
              font-weight: 700;
              color: #f1592a;
              margin: 0;
            }

            #shopify-section-{{ section.id }} .abtest-price .pr_custom_price {
              font-size: 32px;
              line-height: 40px;
              font-weight: 700;
              color: #f1592a;
              margin: 0;
            }

            #shopify-section-{{ section.id }} .abtest-price .pr_custom_compare_price {
              font-size: 16px;
              color: #808080;
            }

            #shopify-section-{{ section.id }} .abtest-price__save {
              display: inline-flex;
              align-items: center;
              padding: 5px 14px;
              border-radius: 43px;
              background: #d83d0e;
              color: #fff;
              font-size: 13px;
              font-weight: 700;
            }

            #shopify-section-{{ section.id }} .abtest-btn {
              display: flex;
              align-items: center;
              justify-content: center;
              width: 100%;
              min-height: 48px;
              border-radius: 8px;
              font-size: 16px;
              font-weight: 700;
              font-family: inherit;
              cursor: pointer;
              text-align: center;
            }

            #shopify-section-{{ section.id }} .abtest-btn--primary {
              background: #d83d0e;
              color: #fff;
              border: 0;
            }

            #shopify-section-{{ section.id }} .abtest-btn--outline {
              background: #fff;
              color: #23232b;
              border: 1px solid #d3d9e5;
            }

            #shopify-section-{{ section.id }} .abtest-btn--link {
              background: transparent;
              color: #d83d0e;
              border: 0;
              min-height: auto;
              padding: 0;
              justify-content: flex-start;
            }

            #shopify-section-{{ section.id }} .abtest-customize {
              margin-bottom: 20px;
            }

            #shopify-section-{{ section.id }} .abtest-cta-row {
              display: flex;
              flex-direction: column;
              gap: 12px;
              margin: 20px 0;
            }

            #shopify-section-{{ section.id }} .abtest-room-cta {
              border-top: 1px solid #edeff3;
              padding-top: 20px;
              margin-bottom: 8px;
            }

            #shopify-section-{{ section.id }} .abtest-room-cta__title {
              font-size: 16px;
              font-weight: 700;
              color: #23232b;
              margin: 0 0 4px;
            }

            #shopify-section-{{ section.id }} .abtest-room-cta__subtitle {
              font-size: 14px;
              color: #808080;
              margin: 0 0 12px;
            }
          {% endstyle %}

          <div class="abtest-title">
            <div class="abtest-title__row">
              <h1 class="abtest-title__name">{{ product.title | escape }}</h1>
              <div class="abtest-title__status">
                {% for block in section.blocks %}
                  {% if block.type == '@app' %}
                    {% render block %}
                  {% endif %}
                {% endfor %}
                {% comment %}
                  Stock-status badge (Available to Order / Sold Out) hidden
                  per explicit direction — kept here, not deleted, since the
                  logic is expected to be repurposed later into a
                  Request-Quote-status badge and re-enabled. Do not remove
                  this block when doing other cleanup.
                {% endcomment %}
                {% comment %}
                {% if current_variant.available %}
                  <span class="abtest-tag abtest-tag--available">Available to Order</span>
                {% else %}
                  <span class="abtest-tag abtest-tag--unavailable">Sold Out</span>
                {% endif %}
                {% endcomment %}
              </div>
            </div>
          </div>

          {% if product.variants.size > 1 %}
            {%- assign abtest_size_option = product.options_with_values.first -%}
            <fieldset class="abtest-size-cards" role="radiogroup" aria-label="{{ abtest_size_option.name }}">
              <legend class="visually-hidden">{{ abtest_size_option.name }}</legend>
              {% for variant in product.variants %}
                <label class="abtest-size-card{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}">
                  <input
                    type="radio"
                    class="abtest-size-card__input"
                    name="AbTestSize-{{ section.id }}"
                    value="{{ variant.id }}"
                    data-variant-url="{{ variant.url }}"
                    {% if variant.id == current_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span class="abtest-size-card__title">{{ variant.title }}</span>
                  {%- if variant.metafields.custom.size_description != blank -%}
                    <span class="abtest-size-card__desc">{{ variant.metafields.custom.size_description }}</span>
                  {%- endif -%}
                  <span class="abtest-size-card__price">Starting at {{ variant.price | money }}</span>
                </label>
              {% endfor %}
            </fieldset>

            <script>
              (function () {
                var radios = document.querySelectorAll('input[name="AbTestSize-{{ section.id }}"]');
                radios.forEach(function (radio) {
                  radio.addEventListener('change', function () {
                    if (radio.checked && radio.dataset.variantUrl) {
                      window.location.href = radio.dataset.variantUrl;
                    }
                  });
                });
              })();
            </script>
          {% endif %}

          <div class="abtest-price">
            {% comment %}
              .pr_custom_price is read directly by assets/main-product-custom.js
              elsewhere in the theme — keep this class name. The Affirm/Shop Pay
              financing UI (.affirm-as-low-as trigger + paylater-providers render)
              and the compare-at "was" price / "You save" pill have both been
              removed from this PDP per P0 (no financing copy, no compare-at price
              on the GymBuild quote-only buy-box).
            {% endcomment %}
            <div id="price-{{ section.id }}" role="status" class="abtest-price__row">
              <p class="abtest-price__label">Starting at</p>
              <p
                class="pr_custom_price{% unless product.available %} out-of-stock{% endunless %}"
                data-price-value="{{ abtest_mp_price | money_without_currency }}"
                data-currency="{{ cart.currency.symbol }}"
              >
                {{ abtest_mp_price | money }}
              </p>
            </div>
          </div>

          <modal-opener class="gymbuild-customize-drawer__opener" data-modal="#GymBuildCustomizeModal-{{ section.id }}">
            <button type="button" class="abtest-btn abtest-btn--outline abtest-customize" aria-haspopup="dialog">
              Customize this build
            </button>
          </modal-opener>
          {% render 'gymbuild-customize-popup', current_variant: current_variant %}

          {% for item in product.tags %}
            {% unless item != 'Free Shipping' or product.template_suffix == 'discontinued' %}
              <div class="free-shipping-badge">
                <div class="shipping-icon">
