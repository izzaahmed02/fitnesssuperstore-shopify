                <div class="shipping-text">
                  <div><b>This item qualifies for</b><span class="highlight"> FREE SHIPPING</span></div>
                  <div class="subtext">
                    to the Lower 48 States
                    {% if product.price < 2000 %}
                      (Minimum order $200 to qualify)
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endunless %}
          {% endfor %}

          <div class="metainfo-wrapper metainfo-tabs-wrapper">
            <div class="metainfo-tabs-nav" role="tablist">
              <button
                type="button"
                class="metainfo-tab-button is-active"
                data-metainfo-tab-button="delivery-warranty-{{ section.id }}"
                role="tab"
                aria-controls="metainfo-tab-panel-delivery-warranty-{{ section.id }}"
                aria-selected="true"
              >
                Delivery &amp; Warranty
              </button>

              {% for block in section.blocks %}
                {% if block.type == 'metainfo_custom_tab' and block.settings.title != blank %}
                  <button
                    type="button"
                    class="metainfo-tab-button"
                    data-metainfo-tab-button="custom-tab-{{ section.id }}-{{ block.id }}"
                    role="tab"
                    aria-controls="metainfo-tab-panel-custom-tab-{{ section.id }}-{{ block.id }}"
                    aria-selected="false"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>

            <div class="metainfo-tabs-content">
              <div
                class="metainfo-tab-panel is-active"
                id="metainfo-tab-panel-delivery-warranty-{{ section.id }}"
                data-metainfo-tab-panel="delivery-warranty-{{ section.id }}"
                role="tabpanel"
              >
                {% if product.metafields.custom.condition_state != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-star' %}</div>
                    <div class="item__text">
                      <span class="title">Condition:</span>
                      {{
                        product.metafields.custom.condition_state
                        | strip_html
                        | replace: ' (See Description for Details)', ''
                        | replace: '(What Does this Mean?)', ''
                      }}
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.custom.grade != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-chart' %}</div>
                    <div class="item__text">
                      <span class="title">Grade:</span>
                      {{ product.metafields.custom.grade }}
                      <span class="more-info" data-customfield="Grade">(More Info)</span>
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.custom.warranty != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-verified' %}</div>
                    <div class="item__text">
                      <span class="title">Warranty:</span>
                      {{
                        product.metafields.custom.warranty
                        | strip_html
                        | replace: ' (See Description for Details)', ''
                      }}
                      <span class="more-info" data-customfield="Warranty">(More Info)</span>
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.custom.ships != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-box' %}</div>
                    <div class="item__text">
                      <span class="title">Ships:</span>
                      {{ product.metafields.custom.ships }}

                      {% for collection in product.collections %}
                        {% if collection.handle contains 'shop-by-strength-product-line' %}
                          <span class="more-info" data-customfield="Shipping">(More Info)</span>

                          <script>
                            var attachClickHandler = setInterval(function () {
                              var $target = $('.custom_shipping_container');

                              if ($target.length > 0) {
                                var $clickTarget = $target.parent().parent();

                                $clickTarget.off('click.clearContent').on('click.clearContent', function () {
                                  $('#dynamic-product-content').empty();
                                });

                                clearInterval(attachClickHandler);
                              }
                            }, 200);
                          </script>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.custom.processing_time != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-timer' %}</div>
                    <div class="item__text">
                      <span class="title">Processing Time:</span>
                      {{ product.metafields.custom.processing_time_long }}
                      <span
                        class="more-info"
                        data-customfield="Processing Time"
                        data-processingtime="{{ product.metafields.custom.processing_time }}"
                      >
                        (More Info)
                      </span>
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.custom.product_code != blank %}
                  <div class="item">
                    <div class="item__icon-wrap">{% render 'icon-hashtag' %}</div>
                    <div class="item__text">
                      <span class="title">Product Code:</span>
                      {{ product.metafields.custom.product_code }}
                    </div>
                  </div>
                {% endif %}
              </div>

              {% for block in section.blocks %}
                {% if block.type == 'metainfo_custom_tab' and block.settings.title != blank %}
                  <div
                    class="metainfo-tab-panel"
                    id="metainfo-tab-panel-custom-tab-{{ section.id }}-{{ block.id }}"
                    data-metainfo-tab-panel="custom-tab-{{ section.id }}-{{ block.id }}"
                    role="tabpanel"
                  >
                    <div class="metainfo-tab-custom-content">
                      {% if block.settings.custom_liquid != blank %}
                        {{ block.settings.custom_liquid }}
                      {% elsif block.settings.content != blank %}
                        {{ block.settings.content }}
                      {% elsif request.design_mode %}
                        <p>Add content or connect a metafield for this tab.</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          {% assign meta_object_3rd_party = product.metafields.custom['3rd_party'].value %}
          {% if meta_object_3rd_party != blank and meta_object_3rd_party.google_material != blank %}
            {% assign value = meta_object_3rd_party.google_material | downcase %}
            {% if value == 'on display in benicia' %}
              <div class="showroom">
                <div class="img-wrap">{% render 'icon-bigcheck' %}</div>
                <span class="showroom-text">On Display in Store — Benicia California Showroom</span>
              </div>
            {% endif %}
          {% endif %}

          {% comment %} Visual-only for now — see TODO note at top of this file. {% endcomment %}
          <div class="abtest-cta-row">
            <button type="button" class="abtest-btn abtest-btn--primary">Request Quote Review</button>
          </div>

          {% comment %} Visual-only for now — see TODO note at top of this file. {% endcomment %}
          <div class="abtest-room-cta">
            <p class="abtest-room-cta__title">See this layout in your actual room</p>
            <p class="abtest-room-cta__subtitle">Send us your room plan for quote review</p>
            <button type="button" class="abtest-btn abtest-btn--outline">Open in Gym Designer</button>
          </div>

          {% comment %}
