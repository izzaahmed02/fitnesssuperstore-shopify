                              </g>
                            </g>
                          </g>
                        </svg>
                      </span>
                    {% endif %}
                  </div>
                </button>
              {%- endfor -%}

              {% assign model = product.media | where: 'media_type', 'model' | first %}
              {%- if model -%}
                {% assign preview = model.preview_image %}

                <button
                  class="thumbnail-btn{% if model.alt contains '3D' or model.alt contains '3d' %} threeD-image{% endif %}"
                  data-media-id="{{ model.id }}"
                  data-camera-orbit="{{ model.presentation.camera_orbit }}"
                  type="button"
                >
                  <div class="image-skeleton-wrapper">
                    {{
                      preview
                      | image_url: width: 176
                      | image_tag:
                        alt: model.alt,
                        widths: '88, 176',
                        sizes: '88px',
                        width: 88,
                        height: 88,
                        loading: 'lazy',
                        onload: "this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                    }}
                    {% if model.alt contains '3D' or model.alt contains '3d' %}
                      <span class="icon-3d" aria-label="3D Icon">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          xmlns:xlink="http://www.w3.org/1999/xlink"
                          fill="#000000"
                          height="800px"
                          width="800px"
                          version="1.1"
                          id="Layer_1"
                          viewBox="0 0 480 480"
                          xml:space="preserve"
                        >
                          <g>
                            <g>
                              <g>
