{% style %}

.product-form__quantity {
  display: none;
}
  #shopify-section-{{ section.id }} .metainfo-tabs-wrapper {
    display: block;
    margin-top: 32px;
  }

  .atc-container {
    width: 100%;
  }

  .product_price_with_options_atc {
    margin-top: 16px;
  }

  .product-options__category-title span {
    display: none;
  }

  .product-options__category-title svg {
    display: none;
  }

  #shopify-section-{{ section.id }} .metainfo-tabs-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    margin-bottom: 14px;
    border-bottom: 1px solid #EDEFF3;
    overflow-x: auto;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-button {
    font-size: 14px;
    line-height: 20px;
    color: #23232B;
    text-align: center;
    padding: 0 0 8px;
    border: 0;
    border-bottom: 4px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: 0.2s ease;
    white-space: nowrap;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-button.is-active {
    border-bottom-color: #D83D0E;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-panel {
    display: none;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-panel .item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-panel .item + .item {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content {
    font-family: Lato, sans-serif;
    font-size: 14px;
    line-height: 22px;
    color: #23232B;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content h4 {
    font-size: 22px;
    margin: 0px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content ul li{
    list-style: none;
    color: #23232B;
  }

#shopify-section-{{ section.id }} .metafield-rich_text_field ul {
  list-style: none;
  padding-left: 0;
}

#shopify-section-{{ section.id }} .metafield-rich_text_field ul li {
  padding-left: 1.2em;
  position: relative;
  margin: 8px 0;
  font-size: 14px;
  line-height: 20px;
}

#shopify-section-{{ section.id }} .metafield-rich_text_field ul li::before {
  content: "" !important;
  display: inline-block !important;
  width: 8px;
  height: 8px;
  background-image: url("data:image/svg+xml,%3Csvg width='8' height='8' viewBox='0 0 8 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='4' cy='4' r='4' fill='%233E77AA'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: contain;
  background-color: transparent;
  position: absolute;
  left: 0;
  top: 0.45em;
}

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content p {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content ul,
  #shopify-section-{{ section.id }} .metainfo-tab-custom-content ol {
    margin-left: 0;
    padding-left: 0px;
  }

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content ul li {
     padding-left: 1.2em;
  position: relative;
  margin: 8px 0;
  font-size: 14px;
  line-height: 20px;
}

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content ul li::before {
  content: "" !important;
  display: inline-block !important;
  width: 8px;
  height: 8px;
  background-image: url("data:image/svg+xml,%3Csvg width='8' height='8' viewBox='0 0 8 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='4' cy='4' r='4' fill='%233E77AA'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: contain;
  background-color: transparent;
  position: absolute;
  left: 0;
  top: 0.45em;
}

  #shopify-section-{{ section.id }} .metainfo-tab-custom-content li::before {
    content: none !important;
    display: none !important;
  }

  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .metainfo-tabs-nav {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .metainfo-tab-button {
      font-size: 13px;
      line-height: 20px;
    }
  }
  #shopify-section-{{ section.id }} .product-main-container{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
  }
  #shopify-section-{{ section.id }} .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .product-main-right{
    padding-top: 20px;
    padding-left: 80px;
    background: #FAF9F9;
  }

  #shopify-section-{{ section.id }} .product-main-right .prod-title{
    font-size: 30px;
    line-height: 40px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 20px;
  }
  #shopify-section-{{ section.id }} .mpe {
    margin-top: -20px;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .custom-gallery-thumbnails.only-desktop .thumbnail-btn {
    width: 88px;
    min-width: 88px;
    height: 88px;
    flex: 0 0 88px;
    box-sizing: border-box;
  }

  .product__tile-calculator{
    margin-top: 14px;
  }

{% endstyle %}

{% if product.template_suffix == 'discontinued' %}
  <meta itemprop="availability" content="Discontinued">
{% elsif product.available == true %}
  <meta itemprop="availability" content="InStock">
{% else %}
  <meta itemprop="availability" content="OutOfStock">
{% endif %}

{% comment %} {% render 'custom-breadcrumbs', with product: product %} {% endcomment %}
{% render 'metaobjects-breadcrumbs', with product: product %}


{% assign default_camera_orbit = '24deg 74deg 10m' %}


<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} prodTemplate"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-accordion.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-accordion.css' | asset_url | stylesheet_tag }}</noscript>
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
  <link rel="stylesheet" href="{{ 'component-rating.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-rating.css' | asset_url | stylesheet_tag }}</noscript>
  <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}</noscript>

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}


  {{ 'custom-main-product-page.css' | asset_url | stylesheet_tag }}
  {{ 'custom-main-product-hgs-page.css' | asset_url | stylesheet_tag }}
  {{ 'HGS-custom-product-gallery.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'custom-option-picker-snippet.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'custom-option-picker-snippet.css' | asset_url | stylesheet_tag }}</noscript>

  {% assign hide_product_options = false %}
  {% for item in cart.items %}
    {% for property in item.properties %}
      {% if property.first == '_functionOperation' %}
        {% assign hide_product_options = true %}
      {% endif %}
    {% endfor %}
  {% endfor %}


  {% unless hide_product_options %}
    <link rel="stylesheet" href="{{ 'product-options.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'product-options.css' | asset_url | stylesheet_tag }}</noscript>
  {% endunless %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 990px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .product_price_with_options-contaniner {
        flex-direction: column;
        margin-top: 32px;
    }
      .product_price_with_options-contaniner .product_prices {
        margin-bottom: 16px;
      }
    }
  {%- endstyle -%}

  {%- assign enable_product_form_js = true -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'tile_calculator' -%}
        {% if block.settings.disable_product_form_js %}
          {%- assign enable_product_form_js = false -%}
        {% endif %}
    {%- endcase -%}
  {%- endfor -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  {% if enable_product_form_js %}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {% endif %}

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}


  {% comment %} pdp-page-width main-container {% endcomment %}
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="product__info-wrapper--mobile">
        <div class="product__info-container--mobile">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <p class="h2">{{ product.title | escape }}</p>
                </div>
            
              {% when 'price' %}
                <p class="affirm-as-low-as" data-page-type="product" data-amount="{{ product.price }}"></p>


                {% assign campaign_text = '' %}

                {% if product.title contains 'French Fitness' %}
                  {% assign campaign_text = settings.sale_promo_ff %}
                {% elsif product.title contains 'Remanufactured' %}
                  {% assign campaign_text = settings.sale_promo_reman %}
                {% else %}
                  {% assign campaign_text = settings.sale_promo_default %}
                {% endif %}

                {% unless campaign_text == blank %}
                  <div class="campaign-sale-container hide-on-mobile">
                    <p>{{ campaign_text | escape }}</p>
                  </div>
                {% endunless %}

                <div>
                 {% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price %}
  <span class="pr_custom_compare_price"
    >As high as:
    <s>{{ product.metafields.custom.retail_price | money_with_currency -}}</s>
  </span>
{% elsif product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
  <span class="pr_custom_compare_price"
    >As high as:
    <s>{{ product.selected_or_first_available_variant.compare_at_price | money_with_currency -}}</s>
  </span>
{% endif %}
                  {% if product.metafields.custom.saleprice_name != blank %}
                    {% render 'super-sale',
                      sale_name: product.metafields.custom.saleprice_name,
                      current_price: product.selected_or_first_available_variant.compare_at_price,
                      sale_price: product.metafields.custom.sale_price
                    %}
                  {% else %}
                    <div class="price-container">
                      {%- render 'price',
                        product: product,
                        use_variant: true,
                        show_badges: true,
                        price_class: 'price--large'
                      -%}

                      {% if product.metafields.custom.retail_price > product.selected_or_first_available_variant.price %}
  <span class="you-save"
    >You save
    {{ product.metafields.custom.retail_price | minus: product.selected_or_first_available_variant.price | money -}}
  </span>
{% elsif product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
  <span class="you-save"
    >You save
    {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money -}}
  </span>
{% endif %}
                    </div>
                  {% endif %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="product-main-left-container">

           <product-gallery
        data-product-title="{{ product.title | escape }}"
        data-default-camera-orbit="{{ default_camera_orbit }}"
      >
        <div class="custom-product-gallery">
          <div class="custom-gallery-wrapper">
            <!-- Thumbnails -->
            {%- assign image_media = product.media | where: 'media_type', 'image' -%}

            <div class="custom-gallery-thumbnails only-desktop">
              {%- assign image_limit = 3 -%}
              {%- for media in image_media limit: image_limit -%}
                {% assign preview = media.preview_image %}

                <button
                  class="thumbnail-btn{% if forloop.first %} is-active{% endif %}{% if media.alt contains '3D' or media.alt contains '3d' %} threeD-image{% endif %}"
                  data-media-id="{{ media.id }}"
                  type="button"
                >
                  <div class="image-skeleton-wrapper">
                    {{
                      preview
                      | image_url: width: 176
                      | image_tag:
                        alt: media.alt,
                        widths: '88, 176',
                        sizes: '88px',
                        width: 88,
                        height: 88,
                        loading: 'lazy',
                        onload: "this.closest('.image-skeleton-wrapper').classList.add('loaded')"
                    }}
                    {% if media.alt contains '3D' or media.alt contains '3d' %}
                      <span class="icon-3d" aria-label="3D Icon">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          xmlns:xlink="http://www.w3.org/1999/xlink"
                          fill="#000000"
                          height="800px"
