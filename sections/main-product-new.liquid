          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "circle"
        }
      ]
    },
    {
      "type": "color_options",
      "name": "Configurator",
      "limit": 1
    },
    {
      "type": "info_tab",
      "name": "Info tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab title",
          "default": "Key Specs"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content source",
          "options": [
            { "value": "custom", "label": "Custom content below" },
            { "value": "product_meta", "label": "Product metafields (condition, warranty, ships)" }
          ],
          "default": "custom"
        },
        {
          "type": "liquid",
          "id": "content",
          "label": "Content (HTML/Liquid)"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price + financing",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_financing",
