          "default": "button"
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "label": "Swatch shape",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "circle"
        }
      ]
    },
    {
      "type": "color_options",
      "name": "Configurator",
      "limit": 1
    },
    {
      "type": "info_tab",
      "name": "Info tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab title",
          "default": "Key Specs"
        },
        {
          "type": "select",
          "id": "source",
