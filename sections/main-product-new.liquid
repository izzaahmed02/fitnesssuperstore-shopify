          "default": true
        }
      ]
    },
    {
      "type": "delivery_options",
      "name": "Delivery options dropdown",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Delivery & Installation Options"
        },
        {
          "type": "text",
          "id": "group_match",
          "label": "Option group to show (name contains)",
          "info": "Matches an option group from the product's configurator, e.g. \"assembly\". The dropdown shows that group's real, priced choices. Leave blank to hide.",
          "default": "assembly"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "Show gift card recipient form",
          "default": false
        }
      ]
    },
    {
      "type": "product_options",
      "name": "Add-Ons (upsells)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "upsell_metafield",
          "label": "Upsell list metafield",
          "info": "namespace.key of the product metafield holding the upsell list. Accepts a list of metaobjects (variant/product + default_quantity + group), a list of variants, or a list of products. Empty or unset renders nothing.",
          "default": "custom.pdp_upsells"
        }
      ]
    },
    {
      "type": "content_section",
      "name": "Content section",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Overview"
        },
        {
          "type": "liquid",
          "id": "content",
          "label": "Content (HTML/Liquid)"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "addons_heading",
      "label": "Add-Ons heading",
      "default": "Add-Ons:"
    },
    {
      "type": "text",
      "id": "showroom_text",
      "label": "Showroom name",
      "info": "Shown as \"On Display: <name>\" on products whose 3rd_party.google_material marks them as on display.",
      "default": "Benicia California Showroom"
    },
    {
      "type": "header",
      "content": "Shipping & Service Regions"
    },
    {
      "type": "text",
      "id": "regions_heading",
      "label": "Popover heading",
      "default": "Shipping & Service Regions"
    },
    {
      "type": "textarea",
      "id": "regions_text",
      "label": "Popover text",
      "default": "Shipping, Room of Choice, installation, warranty service, and delivery options may vary for Hawaii, Alaska, Puerto Rico, Canada, international, and remote-area destinations. Please review Shipping & Service Regions or contact us before ordering if you are in a special-service area."
    },
    {
      "type": "text",
      "id": "regions_link_text",
      "label": "Popover link text",
      "default": "View Shipping & Service Regions"
    },
    {
      "type": "text",
      "id": "regions_link",
      "label": "Popover link URL",
      "info": "Root-relative so it resolves on preview themes as well as the live domain. Shopify's url picker cannot target a #fragment, hence a text field.",
      "default": "/pages/shipping-information#shipping-service-regions"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky Add to Cart bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main product NEW (Figma)"
    }
  ]
}
{% endschema %}
