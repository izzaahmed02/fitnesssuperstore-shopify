{% comment %}
Titan-style Blog Article Slider (Fixed Layout & Arrow Positioning)
- Select a blog from customizer
- Displays ALL articles from selected blog
- Instance-safe (can repeat multiple times on same page)
- Arrow behavior + positioning aligned with Titan Fitness
{% endcomment %}

<section id="ArticleSlider-{{ section.id }}" class="article-slider">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="article-slider__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign blog_handle = section.settings.blog %}
    {% if blogs[blog_handle] != blank %}
      <div class="article-slider__container">
        <button class="article-slider__arrow prev" aria-label="Previous"></button>

        <div class="article-slider__viewport">
          <div class="article-slider__track">
            {% for article in blogs[blog_handle].articles %}
              <article class="article-card">
                <a href="{{ article.url }}" class="article-card__link">
                  {% if article.image %}
                    <div class="article-card__image">
                      {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy' }}
                    </div>
                  {% endif %}
                  <div class="article-card__content">
                    <h3 class="article-card__title">{{ article.title }}</h3>
                  </div>
                </a>
              </article>
            {% endfor %}
          </div>
        </div>

        <button class="article-slider__arrow next" aria-label="Next"></button>
      </div>
    {% endif %}
  </div>
</section>

<style>
/* ===== Layout ===== */
#ArticleSlider-{{ section.id }} {
  position: relative;
}

#ArticleSlider-{{ section.id }} .article-slider__container {
  position: relative;
}

#ArticleSlider-{{ section.id }} .article-slider__viewport {
  overflow: hidden;
}

#ArticleSlider-{{ section.id }} .article-slider__track {
  display: flex;
  gap: 24px;
  transition: transform 0.4s ease;
}

#ArticleSlider-{{ section.id }} .article-card {
  flex: 0 0 320px;
}

/* ===== Arrows (Titan-style) ===== */
#ArticleSlider-{{ section.id }} .article-slider__arrow {
  position: absolute;
  top: 38%;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0,0,0,.15);
  cursor: pointer;
  z-index: 5;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow::before {
  content: '';
  display: block;
  width: 10px;
  height: 10px;
  border-top: 2px solid #000;
  border-right: 2px solid #000;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.prev {
  left: -22px;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.prev::before {
  transform: translate(-50%, -50%) rotate(-135deg);
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.next {
  right: -22px;
}

/* ===== Cards ===== */
#ArticleSlider-{{ section.id }} .article-card__image img {
  width: 100%;
  display: block;
}

#ArticleSlider-{{ section.id }} .article-card__title {
  font-size: 16px;
  margin-top: 12px;
}

/* ===== Mobile ===== */
@media (max-width: 768px) {
  #ArticleSlider-{{ section.id }} .article-slider__arrow {
    display: none;
  }

  #ArticleSlider-{{ section.id }} .article-slider__viewport {
    overflow-x: auto;
  }

  #ArticleSlider-{{ section.id }} .article-slider__track {
    scroll-snap-type: x mandatory;
  }

  #ArticleSlider-{{ section.id }} .article-card {
    scroll-snap-align: start;
  }
}
</style>

<script>
(() => {
  const section = document.getElementById('ArticleSlider-{{ section.id }}');
  if (!section) return;

  const track = section.querySelector('.article-slider__track');
  const cards = section.querySelectorAll('.article-card');
  const next = section.querySelector('.article-slider__arrow.next');
  const prev = section.querySelector('.article-slider__arrow.prev');

  if (!track || !cards.length) return;

  let index = 0;
  const cardWidth = cards[0].offsetWidth + 24;

  const update = () => {
    track.style.transform = `translateX(-${index * cardWidth}px)`;
  };

  next.addEventListener('click', () => {
    if (index < cards.length - 1) {
      index++;
      update();
    }
  });

  prev.addEventListener('click', () => {
    if (index > 0) {
      index--;
      update();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Blog Article Slider New",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Articles"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    }
  ],
  "presets": [
    {
      "name": "Blog Article Slider New"
    }
  ]
}
{% endschema %}