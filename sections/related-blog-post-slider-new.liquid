{% comment %}
Titan-style Blog Article Slider (Center snap + correct image aspect)
{% endcomment %}

<section id="ArticleSlider-{{ section.id }}" class="article-slider">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="article-slider__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign blog_handle = section.settings.blog %}
    {% if blogs[blog_handle] != blank %}
      <div class="article-slider__container">
        <button class="article-slider__arrow prev" aria-label="Previous"></button>

        <div class="article-slider__viewport">
          <div class="article-slider__track">
            {% for article in blogs[blog_handle].articles %}
              <article class="article-card">
                <a href="{{ article.url }}" class="article-card__link">
                  {% if article.image %}
                    <div class="article-card__image">
                      {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                    </div>
                  {% endif %}
                  <div class="article-card__content">
                    <h3 class="article-card__title">{{ article.title }}</h3>
                  </div>
                </a>
              </article>
            {% endfor %}
          </div>
        </div>

        <button class="article-slider__arrow next" aria-label="Next"></button>
      </div>
    {% endif %}
  </div>
</section>

<style>
/* ===== Base ===== */
#ArticleSlider-{{ section.id }} { position: relative; }
#ArticleSlider-{{ section.id }} .article-slider__container { position: relative; }

/* ===== Viewport ===== */
#ArticleSlider-{{ section.id }} .article-slider__viewport {
  overflow: hidden;
}

/* ===== Track ===== */
#ArticleSlider-{{ section.id }} .article-slider__track {
  display: flex;
  gap: 24px;
  transition: transform .45s cubic-bezier(.4,0,.2,1);
  will-change: transform;
}

/* ===== Card ===== */
#ArticleSlider-{{ section.id }} .article-card {
  flex: 0 0 340px;
}

/* ===== Image (NO stretch) ===== */
#ArticleSlider-{{ section.id }} .article-card__image {
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

#ArticleSlider-{{ section.id }} .article-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ===== Arrows (Titan placement) ===== */
#ArticleSlider-{{ section.id }} .article-slider__arrow {
  position: absolute;
  top: 42%;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0,0,0,.15);
  cursor: pointer;
  z-index: 3;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow::before {
  content: '';
  width: 10px;
  height: 10px;
  border-top: 2px solid #000;
  border-right: 2px solid #000;
  position: absolute;
  top: 50%;
  left: 50%;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.prev {
  left: -22px;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.prev::before {
  transform: translate(-50%, -50%) rotate(-135deg);
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.next {
  right: -22px;
}

#ArticleSlider-{{ section.id }} .article-slider__arrow.next::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

/* ===== Mobile ===== */
@media (max-width: 768px) {
  #ArticleSlider-{{ section.id }} .article-slider__arrow { display: none; }

  #ArticleSlider-{{ section.id }} .article-slider__viewport {
    overflow-x: auto;
  }

  #ArticleSlider-{{ section.id }} .article-slider__track {
    scroll-snap-type: x mandatory;
    transform: none !important;
  }

  #ArticleSlider-{{ section.id }} .article-card {
    scroll-snap-align: center;
  }
}
</style>

<script>
(() => {
  const section = document.getElementById('ArticleSlider-{{ section.id }}');
  if (!section) return;

  const track = section.querySelector('.article-slider__track');
  const cards = Array.from(section.querySelectorAll('.article-card'));
  const prev = section.querySelector('.article-slider__arrow.prev');
  const next = section.querySelector('.article-slider__arrow.next');

  if (!cards.length) return;

  let index = 0;

  const update = () => {
    const viewportWidth = section.querySelector('.article-slider__viewport').offsetWidth;
    const card = cards[index];
    const cardCenter = card.offsetLeft + card.offsetWidth / 2;
    const offset = cardCenter - viewportWidth / 2;
    track.style.transform = `translateX(-${offset}px)`;
  };

  next.addEventListener('click', () => {
    if (index < cards.length - 1) {
      index++;
      update();
    }
  });

  prev.addEventListener('click', () => {
    if (index > 0) {
      index--;
      update();
    }
  });

  window.addEventListener('resize', update);
})();
</script>

{% schema %}
{
  "name": "Blog Article Slider New",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Articles" },
    { "type": "blog", "id": "blog", "label": "Select blog" }
  ],
  "presets": [ { "name": "Blog Article Slider New" } ]
}
{% endschema %}
