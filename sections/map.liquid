                        </svg>
                        <div class="image-with-text__contacts-column">
                        {{ block.settings.phone }}
                        </div>
                      </div>
                    {% endif %}

                    {% if block.settings.whatsapp != blank %}
                      <div class="image-with-text__location-address">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 13.379 2.28 14.693 2.784 15.888C3.063 16.548 3.202 16.878 3.22 17.128C3.237 17.378 3.163 17.652 3.016 18.201L2 22L5.799 20.984C6.348 20.837 6.622 20.764 6.872 20.78C7.122 20.798 7.452 20.937 8.112 21.216C9.34266 21.7343 10.6647 22.0009 12 22Z" stroke="#F1592A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8.58817 12.377L9.45917 11.296C9.82617 10.84 10.2792 10.416 10.3162 9.808C10.3242 9.655 10.2162 8.967 10.0012 7.59C9.91617 7.049 9.41017 7 8.97317 7C8.40317 7 8.11817 7 7.83517 7.13C7.47717 7.293 7.11017 7.752 7.02917 8.137C6.96517 8.442 7.01317 8.652 7.10817 9.072C7.51017 10.855 8.45517 12.616 9.91917 14.081C11.3842 15.545 13.1452 16.49 14.9292 16.892C15.3492 16.987 15.5582 17.035 15.8632 16.971C16.2482 16.891 16.7072 16.523 16.8712 16.165C17.0002 15.882 17.0002 15.597 17.0002 15.027C17.0002 14.589 16.9512 14.084 16.4102 13.999C15.0332 13.783 14.3452 13.676 14.1922 13.684C13.5852 13.72 13.1602 14.174 12.7042 14.541L11.6232 15.411" stroke="#F1592A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {{ block.settings.whatsapp }}
                      </div>
                    {% endif %}

                    {% if block.settings.email != blank %}
                      <div class="image-with-text__location-address">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M10 3.25H9.94358C8.10582 3.24998 6.65019 3.24997 5.51098 3.40313C4.33856 3.56076 3.38961 3.89288 2.64124 4.64124C1.89288 5.38961 1.56076 6.33856 1.40314 7.51098C1.24997 8.65019 1.24998 10.1058 1.25 11.9436V12V12.0564C1.24998 13.8942 1.24997 15.3498 1.40314 16.489C1.56076 17.6614 1.89288 18.6104 2.64124 19.3588C3.38961 20.1071 4.33856 20.4392 5.51098 20.5969C6.65018 20.75 8.1058 20.75 9.94354 20.75H9.94359H10H14H14.0564H14.0565C15.8942 20.75 17.3498 20.75 18.489 20.5969C19.6614 20.4392 20.6104 20.1071 21.3588 19.3588C22.1071 18.6104 22.4392 17.6614 22.5969 16.489C22.75 15.3498 22.75 13.8942 22.75 12.0565V12.0564V12V11.9436V11.9435C22.75 10.1058 22.75 8.65018 22.5969 7.51098C22.4392 6.33856 22.1071 5.38961 21.3588 4.64124C20.6104 3.89288 19.6614 3.56076 18.489 3.40313C17.3498 3.24997 15.8942 3.24998 14.0564 3.25H14H10ZM3.7019 5.7019C4.12511 5.27869 4.70476 5.02502 5.71085 4.88976C6.73851 4.75159 8.09318 4.75 10 4.75H14C15.9068 4.75 17.2615 4.75159 18.2892 4.88976C19.2952 5.02502 19.8749 5.27869 20.2981 5.7019C20.7213 6.12511 20.975 6.70476 21.1102 7.71085C21.2484 8.73851 21.25 10.0932 21.25 12C21.25 13.9068 21.2484 15.2615 21.1102 16.2892C20.975 17.2952 20.7213 17.8749 20.2981 18.2981C19.8749 18.7213 19.2952 18.975 18.2892 19.1102C17.2615 19.2484 15.9068 19.25 14 19.25H10C8.09318 19.25 6.73851 19.2484 5.71085 19.1102C4.70476 18.975 4.12511 18.7213 3.7019 18.2981C3.27869 17.8749 3.02502 17.2952 2.88976 16.2892C2.75159 15.2615 2.75 13.9068 2.75 12C2.75 10.0932 2.75159 8.73851 2.88976 7.71085C3.02502 6.70476 3.27869 6.12511 3.7019 5.7019ZM6.41603 7.37596C6.07138 7.1462 5.60573 7.23933 5.37596 7.58398C5.1462 7.92862 5.23933 8.39427 5.58398 8.62404L11.584 12.624C11.8359 12.792 12.1641 12.792 12.416 12.624L18.416 8.62404C18.7607 8.39427 18.8538 7.92862 18.624 7.58398C18.3943 7.23933 17.9286 7.1462 17.584 7.37596L12 11.0986L6.41603 7.37596Z" fill="#F1592A"/>
                        </svg>
                        {{ block.settings.email }}
                      </div>
                    {% endif %}

                    {% if block.settings.time != blank %}
                      <div class="image-with-text__location-address">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.25C6.61522 2.25 2.25 6.61522 2.25 12C2.25 17.3848 6.61522 21.75 12 21.75C17.3848 21.75 21.75 17.3848 21.75 12C21.75 6.61522 17.3848 2.25 12 2.25ZM3.75 12C3.75 7.44365 7.44365 3.75 12 3.75C16.5563 3.75 20.25 7.44365 20.25 12C20.25 16.5563 16.5563 20.25 12 20.25C7.44365 20.25 3.75 16.5563 3.75 12ZM12.75 8C12.75 7.58579 12.4142 7.25 12 7.25C11.5858 7.25 11.25 7.58579 11.25 8V12C11.25 12.2508 11.3753 12.4849 11.584 12.624L14.584 14.624C14.9286 14.8538 15.3943 14.7607 15.624 14.416C15.8538 14.0714 15.7607 13.6057 15.416 13.376L12.75 11.5986V8Z" fill="#F1592A"/>
                        </svg>
                        <div class="image-with-text__contacts-column">
                          {{ block.settings.time }}
                        </div>
                      </div>
                    {% endif %}

                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    {% if block.settings.link_style %}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="link-style"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.button_label | escape }}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="#F1592A"/>
                        </svg>

                      </a>
                    {% else %}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}

            {% assign icons = section.blocks | where: 'type', 'icon' %}
            {% if icons.size > 0 %}
              <div class="image-with-text__icons">
                {% for icon in icons %}
                  <div class="image-with-text__icons-item">
                    <img src="{{ icon.settings.icon | img_url: 'master' }}" alt="{{ icon.settings.icon.alt }}">
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

