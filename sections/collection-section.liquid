<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelector('.sort-per-page select.num').addEventListener('change', function(){
      const url = new URL(window.location.href);
      url.searchParams.delete('page');
      url.searchParams.set('view', this.value.split('=')[1]); 
      window.location.replace(url.toString()); 
    });

    function initSlider(element) {
    $(element).slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      lazyLoad: 'ondemand',
      arrows: true,
      dots: true,
      responsive: [
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1
          }
        }
      ],
      
    });

    $(element).find('img.lazy-load').each(function() {
        const img = $(this);
        img.attr('src', img.data('src'));
        img.removeClass('lazy-load'); 
        img.css({
          'opacity': '1',
          'visibility': 'visible'
        });
    });

    document.querySelectorAll('.main-review-container').forEach((element, id) => {
      const saReviewPolling = setInterval(() => {
        const starContainer = element.querySelector('.star_container div');
        const reviewContainer = element.querySelector('.review-container');

        if (starContainer) {
          const starsCount = starContainer.querySelectorAll('.on')?.length;
          const reviewCount = starContainer.querySelector('.ind_cnt_num').textContent;
          const reviewText = starContainer.querySelector('.ind_cnt_desc').textContent;

          if (reviewContainer) {
            const reviewsRatingSpan = reviewContainer.querySelector('.reviews-count');
            const starRatingCount = reviewContainer.querySelector('.star-count');
            reviewsRatingSpan.textContent = `(${reviewCount} ${reviewText})`;
            starRatingCount.textContent = starsCount.toFixed(1);
          }
          element.style.display = 'block';
          clearInterval(saReviewPolling);
        } 
      }, 100)
    });
  }

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        initSlider(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

    $('.image-wrap').each(function() {
      observer.observe(this);
    });
    
  });
</script>

