<style>

  .homepage-products{
  padding: 60px 16px;
  }
  
.homepage-products .featured_products_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}

.homepage-products .soldout {
  display: flex;
  align-items: center;
  font-family: 'Lato', sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  color: #B3B3B3;
  margin-bottom: 8px;
}

.homepage-products .featured_products_container .product-item .image-wrap {
  margin-bottom: 8px;
}

.homepage-products .soldout svg {
  margin-right: 4px;
}

.homepage-products .featured_products_header h3 {
  font-family: 'Lato', sans-serif;
  font-size: 40px;
  font-weight: 700;
  line-height: 52px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin: 0;
}

.homepage-products .custom-container {
  max-width: 1280px;
  margin-left: auto;
  margin-right: auto; 
}

.homepage-products img.lazy-load {
  max-width: 100%;
  height: auto;
}

.homepage-products .featured_products_link {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: #F1592A;
  border-radius: 8px;
  font-family: 'Lato', sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #fff;
  text-decoration: none;
}

.homepage-products .featured_products_container .slick-prev,
.homepage-products .featured_products_container .slick-next {
  display: none;
}

.homepage-products .slick-prev:before,
.homepage-products .slick-next:before {
  display: none;
}

.homepage-products .product-item {
  
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 8px;
  width: 100%;
  max-width: 300px;
  min-width: 200px;
  flex: 1;
  margin: 0px 8px;
}

.homepage-products .product-item .image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  background: #FFFFFF;
  box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  overflow: hidden;
}

.homepage-products .product-item .image-wrap .slider-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.homepage-products .product-item .image-wrap img {
  width: 90%;
  max-height: 215px;
  object-fit: contain;
  margin: 0 auto;
}

.homepage-products .product-item .slick-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  position: absolute;
  width: 72px;
  left: calc(50% - 72px/2);
  bottom: 12px;
  z-index: 2;
}

.homepage-products .product-item .slick-dots li {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #D3D9E5;
  margin: 0;
}

.homepage-products .product-item .slick-dots li.slick-active {
  background: #23232B;
}

.homepage-products .product-item .slick-dots li button {
  display: none;
}

.homepage-products .product-item .description {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 4px;
  width: 100%;
  z-index: 1;
}

.homepage-products .product-item .title {
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  color: #393940;
  text-decoration: none;
  text-transform: none;
  margin: 0;
  width: 100%;
  max-width: 100%;
  padding: 0;

}

.homepage-products .product-item .old-price-wrapper {
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #393940;
  text-decoration: line-through;
  width: 100%;
}

.homepage-products .availability p {
  margin: 0;
}

.homepage-products .product-item .price-wrapper {
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  color: #F1592A;
  width: 100%;
}

.homepage-products .product-item .tags-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  position: absolute;
  width: auto;
  height: auto;
  left: 16px;
  top: 16px;
  z-index: 3;
}

.homepage-products .product-item .condition-tag,
.homepage-products .product-item .ship-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 12px;
  gap: 4px;
  width: auto;
  height: 28px;
  background: #FFFFFF;
  border: 1px solid #F1592A;
  border-radius: 99px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 14px;
  line-height: 20px;
  color: #F1592A;
}

.homepage-products .product-item .condition-tag.blue {
  color: #3C3B3F;
  border: 1px solid #000;
}

.homepage-products .product-item .sale-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 16px;
  gap: 2px;
  width: auto;
  height: 38px;
  background: #FEEAE8;
  border-radius: 5px;
  font-family: 'Arial', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 20px;
  color: #F52419;
}

.homepage-products .availability {
  font-family: 'Lato', sans-serif;
  font-style: normal;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  color: #00A344;
  width: 100%;
}

@media (max-width: 768px) {
  .homepage-products .featured_products_header {
    padding: 10px;
  }
  .homepage-products .featured_products_container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .homepage-products .product-item {
    width: 100%;
    max-width: 300px;
    min-width: 200px;
  }
  .homepage-products .product-item .image-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .homepage-products .product-item .image-wrap img {
    width: 90%;
    max-height: 215px;
  }
  .homepage-products .product-item .title {
    font-size: 16px;
    line-height: 22px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .homepage-products .product-item .old-price-wrapper,
  .homepage-products .product-item .price-wrapper,
  .homepage-products .availability {
    font-size: 14px;
    line-height: 20px;
  }
}

#shopify-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg }};
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function initSlider(element) {
    if (!$(element).hasClass('slick-initialized')) {
      $(element).find('.slider-container').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        lazyLoad: 'ondemand',
        arrows: true,
        prevArrow: '<button type="button" class="slick-prev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z" fill="black"/></svg></button>',
        nextArrow: '<button type="button" class="slick-next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="black"/></svg></button>',
        dots: true,
        responsive: [
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1,
            },
          },
        ],
      });

      $(element).find('img.lazy-load').each(function () {
        const img = $(this);
        if (img.data('src')) {
          img.attr('src', img.data('src'));
          img.removeClass('lazy-load');
          img.css({
            opacity: '1',
            visibility: 'visible',
          });
        }
      });
    }
  }

  const observer = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          initSlider(entry.target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.8 }
  );

  $('.image-wrap').each(function () {
    if ($(this).length > 0) {
      observer.observe(this);
    }
  });
});

$(document).ready(function() {
  $('.homepage-products .featured_products_container').slick({
    dots: false,
    infinite: false,
    slidesToShow: 4,
    slidesToScroll: 1,
    variableWidth: true,
    responsive: [
      { breakpoint: 1300, settings: { slidesToShow: 4 } },
      { breakpoint: 1024, settings: { slidesToShow: 3 } },
      { breakpoint: 989, settings: { slidesToShow: 2 } },
      { breakpoint: 768, settings: { slidesToShow: 1, centerMode: true, centerPadding: '20px' } }
    ]
  });
});
</script>

<div class="custom-container">
  <div class="featured_products_header">
    {% if section.settings.heading != blank %}
      <h3>{{ section.settings.heading }}</h3>
    {% endif %}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.url }}" class="featured_products_link">
        {{ section.settings.link }}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.8017 4.46967C8.09459 4.17678 8.56947 4.17678 8.86236 4.46967L13.8624 9.46967C14.1553 9.76256 14.1553 10.2374 13.8624 10.5303L8.86236 15.5303C8.56947 15.8232 8.09459 15.8232 7.8017 15.5303C7.50881 15.2374 7.50881 14.7626 7.8017 14.4697L12.2714 10L7.8017 5.53033C7.50881 5.23744 7.50881 4.76256 7.8017 4.46967Z" fill="#fff"/>
        </svg>
      </a>
    {% endif %}
  </div>

   <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}"
            >
              {% assign skip_card_product_styles = false %}
              {%- for product in section.settings.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'product-card',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

{% schema %}
{
  "name": "Homepage Products",
  "class": "homepage-products",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link url"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Choose Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Homepage products"
    }
  ]
}
{% endschema %}