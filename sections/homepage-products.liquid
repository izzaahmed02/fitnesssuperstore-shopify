4455 4.85378 5.98226Z" fill="#F52419"/>
                </svg>
                Sale
              </div>
            {% endif %}
          </div>
        </div>
        <div class="description">
          {% if product.available == false %}
            <span class="soldout">
              {% render 'icon-sold-out' %}
              {{- 'products.product.sold_out' | t -}}
            </span>
          {% else %}
            <div class="ship-wrapper">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M1.03906 6.66797C1.03906 6.32279 1.31888 6.04297 1.66406 6.04297H6.66406C7.00924 6.04297 7.28906 6.32279 7.28906 6.66797C7.28906 7.01315 7.00924 7.29297 6.66406 7.29297H1.66406C1.31888 7.29297 1.03906 7.01315 1.03906 6.66797ZM1.03906 9.16797C1.03906 8.82279 1.31888 8.54297 1.66406 8.54297H4.9974C5.34257 8.54297 5.6224 8.82279 5.6224 9.16797C5.6224 9.51315 5.34257 9.79297 4.9974 9.79297H1.66406C1.31888 9.79297 1.03906 9.51315 1.03906 9.16797ZM1.66406 11.043C1.31888 11.043 1.03906 11.3228 1.03906 11.668C1.03906 12.0131 1.31888 12.293 1.66406 12.293H3.33073C3.67591 12.293 3.95573 12.0131 3.95573 11.668C3.95573 11.3228 3.67591 11.043 3.33073 11.043H1.66406Z" fill="#00A344"/>
