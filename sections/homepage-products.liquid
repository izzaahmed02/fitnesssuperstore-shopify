 17.2433 6.08877 17.7096 6.66406 17.7096C7.23936 17.7096 7.70573 17.2433 7.70573 16.668Z" fill="#00A344"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.00219 1.04297C3.51664 1.04297 2.22057 1.86523 1.54794 3.07201C1.37988 3.37351 1.48807 3.75416 1.78958 3.92222C2.09108 4.09027 2.47174 3.98208 2.63979 3.68058C3.10049 2.85402 3.98774 2.29297 5.00219 2.29297H11.8772V10.0013C11.8772 10.5728 11.407 11.043 10.8355 11.043H10.0022C9.65701 11.043 9.37719 11.3228 9.37719 11.668C9.37719 12.0131 9.65701 12.293 10.0022 12.293H10.8355C12.0974 12.293 13.1272 11.2631 13.1272 10.0013V1.66797C13.1272 1.32279 12.8474 1.04297 12.5022 1.04297H5.00219ZM15.629 8.33464C15.629 8.22148 15.7242 8.1263 15.8374 8.1263H16.5492L17.7124 10.1669V11.043H15.8374C15.7242 11.043 15.629 10.9478 15.629 10.8346V8.33464ZM15.8374 6.8763C15.0338 6.8763 14.379 7.53112 14.379 8.33464V10.8346C14.379 11.6381 15.0338 12.293 15.8374 12.293H18.3374C18.6825 12.293 18.9624 12.0131 18.9624 11.668 Warner Bros. Discovery, Inc. or its subsidiaries and affiliates. All rights reserved.
V10.0013C18.9624 9. 89276 18.9341 9.78609 18.8803 9.6918L17.4553 7.1918C17.3441 6.99674 17.1369 6.8763 16.9123 6.8763H15.8374Z" fill="#00A344"/>
              </svg>
            {{ product.metafieldscustom.processing_time_filter }}
            </div>
          {% endif %}
          <a class="title" href="{{ product.url }}">
            {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
          </a>
          {% if product.available != false %}
            {% if product.metafields.custom.retail_price != blank %}
              <div class="old-price-wrapper">
                <span>As high as:</span> {{ product.metafields.custom.retail_price | money }}
              </div>
            {% else %}
              <div class="old-price-wrapper"></div>
            {% endif %}
            <div class="price-wrapper">
              <span>Price USD: </span>{{ product.price | money }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Homepage Products",
  "class": "homepage-products",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link url"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Choose Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Homepage products"
    }
  ]
}
{% endschema %}