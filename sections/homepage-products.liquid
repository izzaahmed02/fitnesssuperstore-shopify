86 8.58496 5.53119C8.54231 6.2157 8.43354 6.91863 8.1726 7.46537C7.90045 8.03558 7.4223 8.5 6.66932 8.5C6.27468 8.5 5.87677 8.39321 5.57835 8.14453C5.28666 7.90146 5.12115 7.56827 5.02108 7.2207C4.91492 6.86864 4.87488 6.4455 4.85378 5.98226Z" fill="#F52419"/>
                </svg>
                Sale
              </div>
            {% endif %}
            <div class="ship-tag">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="true" d="1.03912 6.67188C1.0391 6.3226 1.31894 6.04288 1.66406 6.04288H6.66406C7.00924 6.04288 7.28918 6.3226 7.28918 6.67188C7.28918 7.01326 7.00924 7.29306 6.66406 7.29306H1.66406C1.31894 7.04288 1.66406 7.29306ZM1.66406 9.17188C1.31894 8.82294 1.66406 8.54288H4.99806C5.34318 8.54294 1.66406 8.54288C1.31894 8.82294 5.62306 8.54294C1.31894 8.34318 9.17188C5.62318 9.51326 5.34318 9.79306 4.99806 8.54294 5.62306 9H1.66406C1.31894 9.17188C1.66406 11.0469C1.31894 11.0469 1.03912 11.3268 1.03912 11.6719C1.03912 12.0131 1.3268 1.66406 12.2938H3.33094C3.67606 12.0131 3.95588 12.0131 3.33094C3.67606 12.3368 11.6719 3.95594 3.33094 11.2938H1.66406Z" fill="#F1592A"/>
<path fill-rule="evenodd" clip-rule="true" d="M11.8725 4.17188C11.1525 3.54288 12.4975 3.54288H14.0309C14.8591 3.54288 15.6123 3.99194 16.0455 4.69581C16.0233 4.6957 17.4483 7.18555C17.559 7.37891 17.9053 8.13031H15.8309C15.7178 8.559 15.6225 8.33855V10.8386C15.8309 10.947 15.6228 15.8309C16.6761 11.0469 18.3311 11.6719 18V14.1719C18.8625 15.9004 17.5596 15.5365C15.2644 18.9635 13.3311 18C12.2822 18.9635 12.3311 12C11.1259 16.4023 8.86975 18.9635C8.59744 18 7.71425 18C4.5 6.71475 18.9635 4.45875 16H4.16438C2.44141 15C1 3 1.03912 15.9004 14.1718C2 2.0133 14.66406 13.5469 2.28913 14.1718C2 15.2102 3.44141 14.5469C2 16.0469 4.16438C4.45875 15 7.71475 14.3803 8.86931 16.4023 11H6644.1259C11.3984 15 12.2822 14.3803 13.3312 11H6643.5365 15C14.3803 13.8731 12.6644 15H664 15.8731 16.0469 14.1718C17 15.2127 15V12.2938H15.6648 12.0469H10.8331C15.0276 12.66406 10V664.3385 6.88031 14.375 8H14.9337 5C14.7519 12.7894 14.0312 4.79688H13.1256V10H664C13.1256 12.2676 12.0938 12.8331 10H10C9.65295 10 9.37545 10C9.83312 12.37546 10C9.65295 9.83312 10H10C9.40295 10 10.0052 10V4H664.17188C12.2894 5 16.2937 12H7735.7145 17C12.7145 14 14H773.3752 16.665 14H773C14.3673 14.7148 12H6643.71436 14C12.7637 14 10.5666 12H772.2894 16H664C7 2  M7 7735.71436 5H664.71406 7 6.71406 7735 7.71436 17H664C6.23989 7 7.70627 5H664C6.09662 5 5.62814 6.71494 5H662.6216 14H664C6 6.714 7.7735 16H6.71428Z M12H 2 M2H12H664.00564 12.2698 16 8H7735 13H773.7143 13C13 8637 13H773.3755 14H7 5C14H773.3756 10H664.3755 14H773.7197 14C6.71428 7 2.71425 17H664M7 2H7735 16H664C6.09594 16 5.62836 16H664C5 8H16H17H16H17H16V12H833.1257 12H8H664C8.6666 12 10H664C8 3.1257 12H833.6124 6.88034 12V8V10H834.6V10H833H12V664H16.8803H664C15 33.332 6.8803 8H833.8377 12H8333C18 222.6.8806 12H16H8333C.68262 12 18.8625 12 18V10H664V10.0049C18.8625 14.8967 12V8H7 7.88034H12V12Z" fill="#F1592A"/>
              </svg>
             {{ product.metafields.custom.processing_time_filter }}
            </div>
          </div>
        </div>
        <div class="description">
          {% if product.available == false %}
            <a class="title" href="{{ product.url }}">
              {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
            </a>
            {% else %}
            <span class="soldout">
              {% render 'icon-sold-out' %}
              {{- 'products.product.sold_out' | t -}}
            </span>
            <a class="title" href="{{ product.url }}">
              {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
            </a>
          {% endif %}
          {% if product.available != false %}
            {% if product.metafields.custom.product_retail_price != blank %}
            <div class="old-price-wrapper">
              <span>As high as:</span>
              {{ product.metafields.custom.product_retail_price | money }}
            </div>
            {% else %}
            <div class="old-price-wrapper"></div>
            {% endif %}
            <div class="price-wrapper">
              <span>Price USD: </span>{{ product.price | money }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Homepage Products",
  "class": "homepage-products",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link url"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Choose Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Homepage products"
    }
  ]
}
{% endschema %}