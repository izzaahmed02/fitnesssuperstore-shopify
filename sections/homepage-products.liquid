<style>
.featured_products_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}

.soldout {
  display: flex;
  align-items: center;
  font-family: 'Lato', sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  color: #B3B3B3;
  margin-bottom: 8px;
}

.featured_products_container .product-item .image-wrap {
  margin-bottom: 8px;
}

.soldout svg {
  margin-right: 4px;
}

.featured_products_header h3 {
  font-family: 'Lato', sans-serif;
  font-size: 40px;
  font-weight: 700;
  line-height: 52px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin: 0;
}

.custom-container {
  max-width: 1280px;
  margin-left: auto;
  margin-right: auto;
}

img.lazy-load {
  max-width: 100%;
  height: auto;
}

.featured_products_link {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: #F1592A;
  border-radius: 8px;
  font-family: 'Lato', sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #fff;
  text-decoration: none;
}

.featured_products_container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.featured_products_container .slick-prev {
  left: 12px;
  z-index: 100;
}

.featured_products_container .slick-next {
  right: 12px;
  z-index: 100;
}

.slick-prev:before,
.slick-next:before {
  display: none;
}

.product-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 8px;
  width: 241px;
  height: 447px;
  flex: none;
  flex-grow: 1;
}

.product-item .image-wrap {
  position: relative;
  width: 241px;
  height: 283px;
  background: #FFFFFF;
  box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  flex: none;
  align-self: stretch;
  z-index: 0;
  overflow: hidden;
}

.product-item .image-wrap .slider-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-item .image-wrap img {
  width: 217px;
  height: 215px;
  object-fit: contain;
}

.product-item .slick-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  position: absolute;
  width: 72px;
  height: 8px;
  left: calc(50% - 72px/2);
  bottom: 12px;
  z-index: 2;
}

.product-item .slick-dots li {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #D3D9E5;
  margin: 0;
}

.product-item .slick-dots li.slick-active {
  background: #23232B;
}

.product-item .slick-dots li button {
  display: none;
}

.product-item .description {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 4px;
  width: 241px;
  height: 156px;
  flex: none;
  align-self: stretch;
  z-index: 1;
}

.product-item .title {
  width: 241px;
  height: 72px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  color: #393940;
  text-decoration: none;
  text-transform: none;
  margin: 0;
  flex: none;
  align-self: stretch;
}

.product-item .old-price-wrapper {
  width: 241px;
  height: 24px;
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #393940;
  text-decoration: line-through;
  flex: none;
  align-self: stretch;
}

.product-item .price-wrapper {
  width: 241px;
  height: 24px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  color: #F1592A;
  flex: none;
  align-self: stretch;
}

.product-item .ship-wrapper {
  width: 241px;
  height: 24px;
  display: flex;
  align-items: center;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  color: #00A344;
  flex: none;
  align-self: stretch;
  gap: 4px;
}

.product-item .tags-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  position: absolute;
  width: 160px;
  height: auto;
  left: 16px;
  top: 16px;
  z-index: 3;
}

.product-item .condition-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 16px;
  gap: 4px;
  width: auto;
  height: 38px;
  background: #FFFFFF;
  border: 1px solid #F1592A;
  border-radius: 99px;
  font-family: 'Lato', sans-serif;
  font-weight: 500;
  font-size: 14px;
  line-height: 20px;
  color: #F1592A;
}

.product-item .condition-tag.blue {
  color: #3C3B3F;
  border: 1px solid #000;
}

.product-item .sale-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 16px;
  gap: 2px;
  width: auto;
  height: 38px;
  background: #FEEAE8;
  border-radius: 5px;
  font-family: 'Arial', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 20px;
  color: #F52419;
}

@media (max-width: 768px) {
  .featured_products_header {
    padding: 10px;
  }
  .featured_products_container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .product-item {
    width: 100%;
    max-width: 241px;
  }
  .product-item .image-wrap {
    width: 100%;
  }
  .product-item .image-wrap img {
    width: 90%;
    height: auto;
    max-height: 215px;
  }
  .product-item .title,
  .product-item .old-price-wrapper,
  .product-item .price-wrapper,
  .product-item .ship-wrapper {
    width: 100%;
  }
}

#shopify-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg }};
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function initSlider(element) {
    if (!$(element).hasClass('slick-initialized')) {
      $(element).find('.slider-container').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        lazyLoad: 'ondemand',
        arrows: true,
        prevArrow: '<button type="button" class="slick-prev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z" fill="black"/></svg></button>',
        nextArrow: '<button type="button" class="slick-next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="black"/></svg></button>',
        dots: true,
        responsive: [
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1,
            },
          },
        ],
      });

      $(element).find('img.lazy-load').each(function () {
        const img = $(this);
        if (img.data('src')) {
          img.attr('src', img.data('src'));
          img.removeClass('lazy-load');
          img.css({
            opacity: '1',
            visibility: 'visible',
          });
        }
      });
    }
  }

  const observer = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          initSlider(entry.target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.8 }
  );

  $('.image-wrap').each(function () {
    if ($(this).length > 0) {
      observer.observe(this);
    }
  });
});
</script>

<div class="custom-container">
  <div class="featured_products_header">
    {% if section.settings.heading != blank %}
      <h3>{{ section.settings.heading }}</h3>
    {% endif %}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.url }}" class="featured_products_link">
        {{ section.settings.link }}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.8017 4.46967C8.09459 4.17678 8.56947 4.17678 8.86236 4.46967L13.8624 9.46967C14.1553 9.76256 14.1553 10.2374 13.8624 10.5303L8.86236 15.5303C8.56947 15.8232 8.09459 15.8232 7.8017 15.5303C7.50881 15.2374 7.50881 14.7626 7.8017 14.4697L12.2714 10L7.8017 5.53033C7.50881 5.23744 7.50881 4.76256 7.8017 4.46967Z" fill="#fff"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="featured_products_container">
    {% for product in section.settings.products %}
      <div class="product-item card__inner" data-product-id="{{ product.id }}">
        <div class="image-wrap">
          <div class="slider-container">
            {% assign images = product.images %}
            {% for item in images limit: 5 %}
              {% if item != '' %}
                <div class="image-item">
                  {{ item | image_url: width: 217 | image_tag: class: 'lazy-load', loading: 'lazy' }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="tags-wrapper">
            {% if product.metafields.custom.condition_state contains "New" %}
              <div class="condition-tag">
                {% render 'icon-new' %}
                New
              </div>
            {% else %}
              <div class="condition-tag blue">
                {% render 'icon-remanufactured' %}
                Remanufactured
              </div>
            {% endif %}
            {% if product.compare_at_price != blank %}
              <div class="sale-tag">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
