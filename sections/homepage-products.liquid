<style>
.featured_products_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}

.soldout {
  display: flex;
  align-items: center;
  font-family: 'Lato', sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  color: #B3B3B3;
  margin-bottom: 8px;
}

.featured_products_container .product-item .image-wrap {
  margin-bottom: 8px;
}

.soldout svg {
  margin-right: 4px;
}

.featured_products_header h3 {
  font-family: 'Lato', sans-serif;
  font-size: 40px;
  font-weight: 700;
  line-height: 52px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin: 0;
}

.custom-container {
  max-width: 1280px;
  margin-left: auto;
  margin-right: auto;
}

img.lazy-load {
  max-width: 100%;
  height: auto;
}

.featured_products_link {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: #F1592A;
  border-radius: 8px;
  font-family: 'Lato', sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #fff;
  text-decoration: none;
}

.featured_products_container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.featured_products_container .slick-prev {
  display: none;
}

.featured_products_container .slick-next {
   display: none;
}

.slick-prev:before,
.slick-next:before {
  display: none;
}

.product-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 8px;
  width: 241px;
  height: 447px;
  flex: none;
  flex-grow: 1;
}

.product-item .image-wrap {
  position: relative;
  width: 241px;
  height: 283px;
  background: #FFFFFF;
  box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  flex: none;
  align-self: stretch;
  z-index: 0;
  overflow: hidden;
}

.product-item .image-wrap .slider-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-item .image-wrap img {
  width: 217px;
  height: 215px;
  object-fit: contain;
}

.product-item .slick-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  position: absolute;
  width: 72px;
  height: 8px;
  left: calc(50% - 72px/2);
  bottom: 12px;
  z-index: 2;
}

.product-item .slick-dots li {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #D3D9E5;
  margin: 0;
}

.product-item .slick-dots li.slick-active {
  background: #23232B;
}

.product-item .slick-dots li button {
  display: none;
}

.product-item .description {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 4px;
  width: 241px;
  height: 156px;
  flex: none;
  align-self: stretch;
  z-index: 1;
}

.product-item .title {
  width: 241px;
  height: 72px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  color: #393940;
  text-decoration: none;
  text-transform: none;
  margin: 0;
  flex: none;
  align-self: stretch;
}

.product-item .old-price-wrapper {
  width: 241px;
  height: 24px;
  font-family: 'Lato', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 24px;
  color: #393940;
  text-decoration: line-through;
  flex: none;
  align-self: stretch;
}

.product-item .price-wrapper {
  width: 241px;
  height: 24px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 24px;
  color: #F1592A;
  flex: none;
  align-self: stretch;
}

.product-item .tags-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  position: absolute;
  width: auto;
  height: auto;
  left: 16px;
  top: 16px;
  z-index: 3;
}

.product-item .condition-tag,
.product-item .ship-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 12px;
  gap: 4px;
  width: auto;
  height: 28px;
  background: #FFFFFF;
  border: 1px solid #F1592A;
  border-radius: 99px;
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 14px;
  line-height: 20px;
  color: #F1592A;
}

.product-item .condition-tag.blue {
  color: #3C3B3F;
  border: 1px solid #000;
}

.product-item .sale-tag {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 4px 16px;
  gap: 2px;
  width: auto;
  height: 38px;
  background: #FEEAE8;
  border-radius: 5px;
  font-family: 'Arial', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 20px;
  color: #F52419;
}

@media (max-width: 768px) {
  .featured_products_header {
    padding: 10px;
  }
  .featured_products_container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .product-item {
    width: 100%;
    max-width: 241px;
  }
  .product-item .image-wrap {
    width: 100%;
  }
  .product-item .image-wrap img {
    width: 90%;
    height: auto;
    max-height: 215px;
  }
  .product-item .title,
  .product-item .old-price-wrapper,
  .product-item .price-wrapper {
    width: 100%;
  }
}

#shopify-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg }};
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  function initSlider(element) {
    if (!$(element).hasClass('slick-initialized')) {
      $(element).find('.slider-container').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        lazyLoad: 'ondemand',
        arrows: true,
        prevArrow: '<button type="button" class="slick-prev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5303 5.46967C14.8232 5.76256 14.8232 6.23744 14.5303 6.53033L9.06066 12L14.5303 17.4697C14.8232 17.7626 14.8232 18.2374 14.5303 18.5303C14.2374 18.8232 13.7626 18.8232 13.4697 18.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697L13.4697 5.46967C13.7626 5.17678 14.2374 5.17678 14.5303 5.46967Z" fill="black"/></svg></button>',
        nextArrow: '<button type="button" class="slick-next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.46967 5.46967C9.76256 5.17678 10.2374 5.17678 10.5303 5.46967L16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L10.5303 18.5303C10.2374 18.8232 9.76256 18.8232 9.46967 18.5303C9.17678 18.2374 9.17678 17.7626 9.46967 17.4697L14.9393 12L9.46967 6.53033C9.17678 6.23744 9.17678 5.76256 9.46967 5.46967Z" fill="black"/></svg></button>',
        dots: true,
        responsive: [
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1,
            },
          },
        ],
      });

      $(element).find('img.lazy-load').each(function () {
        const img = $(this);
        if (img.data('src')) {
          img.attr('src', img.data('src'));
          img.removeClass('lazy-load');
          img.css({
            opacity: '1',
            visibility: 'visible',
          });
        }
      });
    }
  }

  const observer = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          initSlider(entry.target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.8 }
  );

  $('.image-wrap').each(function () {
    if ($(this).length > 0) {
      observer.observe(this);
    }
  });
});
</script>

<div class="custom-container">
  <div class="featured_products_header">
    {% if section.settings.heading != blank %}
      <h3>{{ section.settings.heading }}</h3>
    {% endif %}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.url }}" class="featured_products_link">
        {{ section.settings.link }}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.8017 4.46967C8.09459 4.17678 8.56947 4.17678 8.86236 4.46967L13.8624 9.46967C14.1553 9.76256 14.1553 10.2374 13.8624 10.5303L8.86236 15.5303C8.56947 15.8232 8.09459 15.8232 7.8017 15.5303C7.50881 15.2374 7.50881 14.7626 7.8017 14.4697L12.2714 10L7.8017 5.53033C7.50881 5.23744 7.50881 4.76256 7.8017 4.46967Z" fill="#fff"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="featured_products_container">
    {% for product in section.settings.products %}
      <div class="product-item card__inner" data-product-id="{{ product.id }}">
        <div class="image-wrap">
          <div class="slider-container">
            {% assign images = product.images %}
            {% for item in images limit: 5 %}
              {% if item != '' %}
                <div class="image-item">
                  {{ item | image_url: width: 217 | image_tag: class: 'lazy-load', loading: 'lazy' }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="tags-wrapper">
           
            {% if product.compare_at_price != blank %}
              <div class="sale-tag">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M8.21437 1.54706L8.0026 2C8.21437 1.54706 8.21458 1.54716 8.2148 1.54726L8.21535 1.54752L8.21675 1.54818L8.22084 1.55012L8.234 1.55644C8.24496 1.56175 8.26024 1.56925 8.27955 1.57895C8.31817 1.59836 8.37296 1.62662 8.44161 1.66388C8.57884 1.73835 8.77189 1.849 9.00215 1.99703C9.46184 2.29254 10.0745 2.74001 10.6883 3.34984C11.9163 4.56985 13.1693 6.46277 13.1693 9.09091C13.1693 12.0713 10.8786 14.5 8.0026 14.5C5.12661 14.5 2.83594 12.0713 2.83594 9.09091C2.83594 7.60221 3.38191 6.40198 3.91738 5.58255C4.18567 5.17199 4.45419 4.85242 4.65722 4.63401C4.75891 4.52462 4.84465 4.44009 4.90641 4.38167C4.93731 4.35244 4.96225 4.32971 4.98024 4.31362L5.00191 4.29449L5.00862 4.28869L5.0109 4.28673L5.01177 4.28599L5.01213 4.28568C5.01229 4.28555 5.01245 4.28541 5.33594 4.66667L5.01245 4.28541C5.16099 4.15937 5.36922 4.13109 5.546 4.21294C5.72279 4.29478 5.83594 4.47186 5.83594 4.66667C5.83594 5.69788 5.8406 6.44629 5.98337 6.94597C6.05073 7.18174 6.13522 7.30688 6.21853 7.37631C6.29511 7.44012 6.4222 7.5 6.66927 7.5C6.91624 7.5 7.10476 7.38108 7.27011 7.03464C7.44667 6.6647 7.54636 6.11764 7.58691 5.46881C7.62679 4.83081 7.60715 4.14498 7.57614 3.52497C7.56625 3.32704 7.55487 3.13173 7.54408 2.94629C7.52215 2.56986 7.5026 2.23415 7.5026 2C7.5026 1.82905 7.58994 1.66995 7.73417 1.57817C7.87839 1.48639 8.05951 1.47466 8.21437 1.54706ZM4.85378 5.98226C4.82081 6.02972 4.78765 6.07883 4.7545 6.12957C4.28997 6.84044 3.83594 7.85234 3.83594 9.09091C3.83594 11.5651 5.72394 13.5 8.0026 13.5C10.2813 13.5 12.1693 11.5651 12.1693 9.09091C12.1693 6.80996 11.0889 5.18109 5.98226C4.82081 6.02972 4.78765 6.07883 4.7545 6.12957C4.28997 6.84044 3.83594 7.85234 3.83594 9.09091C3.83594 11.5651 5.72394 13.5 8.0026 13.5C10.2813 13.5 12.1693 11.5651 12.1693 9.09091C12.1693 6.80996 11.0889 5.15743 9.98354 4.05925C9.46603 3.54511 8.94752 3.15753 8.5427 2.89109C8.55313 3.06978 8.56439 3.26496 8.5749 3.47503C8.6064 4.10502 8.62832 4.83586 8.58496 5.53119C8.54231 6.2157 8.43354 6.91863 8.1726 7.46537C7.90045 8.03558 7.4223 8.5 6.66932 8.5C6.27468 8.5 5.87677 8.39321 5.57835 8.14453C5.28666 7.90146 5.12115 7.56827 5.02108 7.2207C4.91492 6.86864 4.87488 6.4455 4.85378 5.98226Z" fill="#F52419"/>
                </svg>
                Sale
              </div>
            {% endif %}
            <div class="ship-tag">
             {{ product.metafields.custom.processing_time_filter }}
            </div>
          </div>
        </div>
        <div class="description">
          {% if product.available == false %}
            <a class="title" href="{{ product.url }}">
              {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
            </a>
            {% else %}
          
            <a class="title" href="{{ product.url }}">
              {{ product.title | replace: "(Remanufactured)", "" | replace: "(New)", "" }}
            </a>
          {% endif %}
          {% if product.available != false %}
            {% if product.metafields.custom.product_retail_price != blank %}
            <div class="old-price-wrapper">
              <span>As high as:</span>
              {{ product.metafields.custom.product_retail_price | money }}
            </div>
            {% else %}
            <div class="old-price-wrapper"></div>
            {% endif %}
            <div class="price-wrapper">
              <span>Price USD: </span>{{ product.price | money }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Homepage Products",
  "class": "homepage-products",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link url"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Choose Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Homepage products"
    }
  ]
}
{% endschema %}