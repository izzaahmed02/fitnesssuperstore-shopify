<div class="page-width">
<div class="process-steps-section">
  {% if section.settings.section_heading %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}
  <div class="process-steps-wrapper">

    <!-- LEFT SIDE NAV -->
    <div class="process-steps-nav">
      {% for block in section.blocks %}
        <div 
          class="process-nav-item {% if forloop.first %}active{% endif %}" 
          data-target="step-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="process-nav-number h3">
            {{ forloop.index0 }}.
          </div>
          <div class="process-nav-title">
            {{ block.settings.heading | raw }}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- RIGHT SIDE CONTENT -->
    <div class="process-steps-content">
      {% for block in section.blocks %}
        <div 
          id="step-{{ forloop.index0 }}" 
          class="process-step-block"
        >
          <h2 class="process-step-heading">
            {{ block.settings.heading }}
          </h2>

          <div class="process-step-text">
            {{ block.settings.text }}
          </div>

          {% if block.settings.image != blank or block.settings.image_mobile != blank %}
            <div class="process-step-image">

                 {% if block.settings.image != blank %}
                    <div class="desktop-image">
                        {{ block.settings.image | image_url: width: 1200 | image_tag }}
                    </div>
                {% endif %}

                {% if block.settings.image_mobile != blank %}
                    <div class="mobile-image">
                        {{ block.settings.image_mobile | image_url: width: 990 | image_tag }}
                    </div>
                {% endif %}
  </div>
{% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>
</div>

<style>
.process-steps-section {
  padding: 44px 0px;
}

.process-steps-wrapper {
  display: grid;
  grid-template-columns: 435px 1fr;
  gap: 24px;
}

.process-steps-section .section-heading {
  font-size: 38px;
  line-height: 38px;
  letter-spacing: 0.38px;
  font-weight: 800;
  margin: 0px;
  margin-bottom: 44px;
  text-transform: capitalize;
}

/* LEFT SIDE */
.process-steps-nav {
  position: sticky;
  top: 120px;
  height: fit-content;
  background: #F6F6F5;
  padding: 24px;
}

.process-nav-item {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  cursor: pointer;
}

/* Make each nav item relative for positioning */
.process-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 40px; /* space for connector + spacing */
  cursor: pointer;
}

/* Remove extra space on last item */
.process-nav-item:last-child {
  margin-bottom: 0;
}

/* Vertical connector line */
.process-nav-item:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 24px; /* center of 48px number box */
  top: 56px;  /* 48px box + 8px spacing */
  width: 1px;
  height: 24px; /* exact requested */
  background: #A6A99E;
}

.process-nav-number {
  min-width: 48px;
  min-height: 48px;
  background: #A6A99E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #FFFFFF;
  border-radius: 2px;
  margin: 0px;
  font-size: 28px;
  line-height: 28px;
  letter-spacing: 0.28px;
}

.process-nav-title {
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-weight: 800;
  color: #010101;
}

/* ACTIVE STATE */
.process-nav-item.active .process-nav-number {
  background: #F15B61;
  color: #ffffff;
}

.process-nav-item.active .process-nav-title {
  color: #F15B61;
}

/* RIGHT SIDE */
.process-step-block {
  margin-bottom: 44px;
}

.process-steps-section #step-0 .process-step-heading {
margin-top: 0px;
}

.process-step-heading {
  font-size: 28px;
  margin-bottom: 20px;
}

.process-step-text {
  margin-bottom: 24px;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
}

.process-step-image img {
  width: 100%;
  border-radius: 6px;
  height: auto;
  display: block;
}
.desktop-image {
  display: block;
}

.mobile-image {
  display: none;
}


/* MOBILE */
@media (max-width: 990px) {
  .process-steps-section {
    padding: 24px 0px;
  }
  .process-steps-wrapper {
    grid-template-columns: 1fr;
  }

  .process-steps-nav {
    position: relative;
    top: 0;
    margin-bottom: 24px;
    display: flex;
    overflow-x: auto;
    gap: 8px;
    flex-direction: column;
    padding: 16px;
  }
  .process-nav-number {
    background: #F15B61;
    font-size: 22px;
    line-height: 22px;
    letter-spacing: 0.22px;
    margin: 0px;
    color: #ffffff;
  }

  .process-nav-item.active .process-nav-title {
    color: #010101;
    }

  .process-nav-item {
    flex: 0 0 auto;
    margin-bottom: 32px;
  }

  .process-step-block {
    margin-bottom: 24px;
  }
  .desktop-image {
    display: none;
  }

  .mobile-image {
    display: block;
  }

  .process-step-heading {
  font-size: 22px;
  line-height: 22px;
  letter-spacing: 0.22px;
  margin-bottom: 26px;
  margin-top: 0px;
  }

  .process-step-text {
  font-size: 14px;
  line-height: 20px;
  margin-bottom: 20px;
  }

  .process-steps-section .section-heading {
  font-size: 26px;
  line-height: 26px;
  letter-spacing: 0.26px;
  margin-bottom: 20px;
  margin-top: 0;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const navItems = document.querySelectorAll(".process-nav-item");
  const sections = document.querySelectorAll(".process-step-block");

  // Click scroll
  navItems.forEach(item => {
    item.addEventListener("click", function () {
      const target = document.getElementById(this.dataset.target);
      window.scrollTo({
        top: target.offsetTop - 100,
        behavior: "smooth"
      });
    });
  });

  // Intersection Observer for scroll spy
  const observerOptions = {
    root: null,
    rootMargin: "0px 0px -40% 0px",
    threshold: 0.3
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {

        const id = entry.target.getAttribute("id");

        navItems.forEach(item => {
          item.classList.remove("active");
          if (item.dataset.target === id) {
            item.classList.add("active");
          }
        });

      }
    });
  }, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });

});
</script>

{% schema %}
{
  "name": "Installment Options",
  "settings": [
     {
          "type": "inline_richtext",
          "id": "section_heading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "html",
          "id": "heading",
          "label": "Step Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Step Image (Mobile ≤ 990px)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Installment Options"
    }
  ]
}
{% endschema %}