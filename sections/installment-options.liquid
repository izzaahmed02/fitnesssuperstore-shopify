<div class="page-width">
<div class="process-steps-section">
  {% if section.settings.section_heading %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}
  <div class="process-steps-wrapper">

    <!-- LEFT SIDE NAV -->
    <div class="process-steps-nav">
      {% for block in section.blocks %}
        <div 
          class="process-nav-item {% if forloop.first %}active{% endif %}" 
          data-target="step-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="process-nav-number">
            {{ block.settings.heading }}
          </div>
          
        </div>
      {% endfor %}
    </div>

    <!-- RIGHT SIDE CONTENT -->
    <div class="process-steps-content">
      {% for block in section.blocks %}
        <div 
          id="step-{{ forloop.index0 }}" 
          class="process-step-block"
        >
          <h2 class="process-step-heading">
            {{ block.settings.heading }}
          </h2>

          <div class="process-step-text">
            {{ block.settings.text }}
          </div>

          {% if block.settings.block_ul_title %}
            <div class="process-step-ul rte">
                {% if block.settings.block_ul_title %}
                    <h3 class="process-step-ul-title">
                        {{ block.settings.block_ul_title }}
                    </h3>
                {% endif %}
                {% if block.settings.block_ul_text %}
                    {{ block.settings.block_ul_text }}
                {% endif %}
            </div>
            {% endif %}

            {% if block.settings.block_important %}
                <div class="process-step-important">
                    <h3 class="process-step-important-title">
                        {{ block.settings.block_important }}
                    </h3>
                    <p>
                        {{ block.settings.block_important_text }}
                    </p>
                </div>
            {%  endif %}

            {% if block.settings.block_message %}
                <div class="process-step-message">
                    <h3 class="process-step-message-title">
                        {{ block.settings.block_message }}
                    </h3>
                    <p>
                        {{ block.settings.block_message_text }}
                    </p>
                </div>
            {%  endif %}



        </div>

        
      {% endfor %}
    </div>

  </div>
</div>
</div>

<style>

.process-container .page-width {
    padding: 0 16px;
}
.process-steps-section {
  padding: 36px 0px;
}

.process-steps-wrapper {
  display: grid;
  grid-template-columns: 279px 1fr;
  gap: 16px;
}

.process-steps-section .section-heading {
  font-size: 38px;
  line-height: 38px;
  letter-spacing: 0.38px;
  font-weight: 800;
  margin: 0px;
  margin-bottom: 44px;
  text-transform: capitalize;
}

/* LEFT SIDE */
.process-steps-nav {
  position: sticky;
  top: 120px;
  height: fit-content;
  background: #F6F6F5;
}

.process-nav-item {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  cursor: pointer;
}

/* Make each nav item relative for positioning */
.process-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px; /* space for connector + spacing */
  cursor: pointer;
}

/* Remove extra space on last item */
.process-nav-item:last-child {
  margin-bottom: 0;
}

.process-nav-number {
  min-width: 48px;
  min-height: 48px;
  background: #FAF9F9;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-weight: 600;
  color: #000000;
  border-radius: 8px;
  margin: 0px;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  width: 100%;
  text-align: left;
  padding: 12px;
  border: 1px solid #E5E5E5;
}

.process-nav-title {
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-weight: 800;
  color: #010101;
}

/* ACTIVE STATE */
.process-nav-item.active .process-nav-number {
  background: #3E77AA;
  color: #ffffff;
}

.process-nav-item.active .process-nav-title {
  color: #F15B61;
}

/* RIGHT SIDE */
.process-step-block {
  margin-bottom: 32px;
}

.process-steps-section #step-0 .process-step-heading {
margin-top: 0px;
}

.process-step-heading {
  font-size: 38px;
  line-height: 50px;
  letter-spacing: 0px;
  margin-bottom: 16px;
}

.process-step-text {
  margin-bottom: 24px;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
}

.process-step-text p {
    margin: 0px;
}

.process-step-image img {
  width: 100%;
  border-radius: 6px;
  height: auto;
  display: block;
}
.desktop-image {
  display: block;
}

.mobile-image {
  display: none;
}


/* MOBILE */
@media (max-width: 990px) {
  .process-steps-section {
    padding: 24px 0px;
  }
  .process-steps-wrapper {
    grid-template-columns: 1fr;
  }

  .process-steps-nav {
    display: none !important;
    position: relative;
    top: 0;
    margin-bottom: 24px;
    display: flex;
    overflow-x: auto;
    gap: 8px;
    flex-direction: column;
    padding: 16px;
  }
  .process-nav-number {
    background: #F15B61;
    font-size: 22px;
    line-height: 22px;
    letter-spacing: 0.22px;
    margin: 0px;
    color: #ffffff;
  }

  .process-nav-item.active .process-nav-title {
    color: #010101;
    }

  .process-nav-item {
    flex: 0 0 auto;
    margin-bottom: 32px;
  }

  .process-step-block {
    margin-bottom: 24px;
  }
  .desktop-image {
    display: none;
  }

  .mobile-image {
    display: block;
  }

  .process-step-heading {
  font-size: 22px;
  line-height: 22px;
  letter-spacing: 0.22px;
  margin-bottom: 26px;
  margin-top: 0px;
  }

  .process-step-text {
  font-size: 14px;
  line-height: 20px;
  margin-bottom: 20px;
  }

  .process-steps-section .section-heading {
  font-size: 26px;
  line-height: 26px;
  letter-spacing: 0.26px;
  margin-bottom: 20px;
  margin-top: 0;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const navItems = document.querySelectorAll(".process-nav-item");
  const sections = document.querySelectorAll(".process-step-block");

  // Click scroll
  navItems.forEach(item => {
    item.addEventListener("click", function () {
      const target = document.getElementById(this.dataset.target);
      window.scrollTo({
        top: target.offsetTop - 100,
        behavior: "smooth"
      });
    });
  });

  // Intersection Observer for scroll spy
  const observerOptions = {
    root: null,
    rootMargin: "0px 0px -40% 0px",
    threshold: 0.3
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {

        const id = entry.target.getAttribute("id");

        navItems.forEach(item => {
          item.classList.remove("active");
          if (item.dataset.target === id) {
            item.classList.add("active");
          }
        });

      }
    });
  }, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });

});
</script>

{% schema %}
{
  "name": "Installment Options",
  "class": "process-container",
  "settings": [
     {
          "type": "inline_richtext",
          "id": "section_heading",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "heading_blue",
          "label": "Highlights"
        },
        {
          "type": "text",
          "id": "block_ul_title",
          "label": "Step Heading"
        },
        {
          "type": "richtext",
          "id": "block_ul_text",
          "label": "Step List"
        },
        {
          "type": "text",
          "id": "block_important",
          "label": "Important Heading"
        },
        {
          "type": "richtext",
          "id": "block_important_text",
          "label": "Important Text"
        },
        {
          "type": "text",
          "id": "block_message",
          "label": "Message Heading"
        },
        {
          "type": "richtext",
          "id": "block_message_text",
          "label": "Message Text"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Installment Options"
    }
  ]
}
{% endschema %}

