<div class="page-width">
<div class="process-steps-section">
  {% if section.settings.section_heading %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}
  <div class="process-steps-wrapper">

    <!-- LEFT SIDE NAV -->
    <div class="process-steps-nav">
      {% for block in section.blocks %}
        <div 
          class="process-nav-item {% if forloop.first %}active{% endif %}" 
          data-target="step-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="process-nav-number">
            {{ block.settings.heading }}
          </div>
          
        </div>
      {% endfor %}
    </div>

    <!-- RIGHT SIDE CONTENT -->
    <div class="process-steps-content">
      {% for block in section.blocks %}
        <div 
          id="step-{{ forloop.index0 }}" 
          class="process-step-block"
        >
          <h2 class="process-step-heading">
            <span>
                {{ block.settings.heading }}
            </span>
            {% if block.settings.heading_blue %}
            <span class="headling-blue">
                {{ block.settings.heading_blue }}
                </span>
            {% endif %}
          </h2>

          <div class="process-step-text">
            {{ block.settings.text }}
          </div>

          {% if block.settings.block_ul_title %}
            <div class="process-step-ul rte">
                {% if block.settings.block_ul_title %}
                    <h3 class="process-step-ul-title">
                        {{ block.settings.block_ul_title }}
                    </h3>
                {% endif %}
                {% if block.settings.block_ul_text %}
                    {{ block.settings.block_ul_text }}
                {% endif %}
            </div>
            {% endif %}

            {% if block.settings.block_important %}
                <div class="process-step-important">
                    <h3 class="process-step-important-title" style="color: {{ block.settings.text_color }};">
                      {% if block.settings.show_icon %}
                      <span class="icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M9.75 0C15.1348 0 19.5 4.36522 19.5 9.75C19.5 15.1348 15.1348 19.5 9.75 19.5C4.36522 19.5 0 15.1348 0 9.75C0 4.36522 4.36522 0 9.75 0ZM9.75 1.5C5.19365 1.5 1.5 5.19365 1.5 9.75C1.5 14.3063 5.19365 18 9.75 18C14.3063 18 18 14.3063 18 9.75C18 5.19365 14.3063 1.5 9.75 1.5ZM9.75 12.75C10.3023 12.75 10.75 13.1977 10.75 13.75C10.75 14.3023 10.3023 14.75 9.75 14.75C9.19771 14.75 8.75 14.3023 8.75 13.75C8.75 13.1977 9.19771 12.75 9.75 12.75ZM9.75 5C11.2688 5 12.5 6.23122 12.5 7.75V7.87109C12.5 8.63251 12.1975 9.36291 11.6592 9.90137L10.2803 11.2803C9.98738 11.5732 9.51262 11.5732 9.21973 11.2803C8.92683 10.9874 8.92683 10.5126 9.21973 10.2197L10.5986 8.84082C10.8557 8.58367 11 8.23468 11 7.87109V7.75C11 7.05964 10.4404 6.5 9.75 6.5C9.05964 6.5 8.5 7.05964 8.5 7.75V8.25C8.5 8.66421 8.16421 9 7.75 9C7.33579 9 7 8.66421 7 8.25V7.75C7 6.23122 8.23122 5 9.75 5Z" fill="#F1592A"/>
                        </svg>
                      </span>
                    {% endif %}
                        {{ block.settings.block_important }}
                    </h3>
                  
                        {{ block.settings.block_important_text }}
                    
                </div>
            {%  endif %}

            {% assign has_message = block.settings.block_message | strip_html | strip %}
            {% assign has_text = block.settings.block_message_text | strip %}
            {% if has_message != blank or has_text != blank %}

                <div class="process-step-message">
                    <h3 class="process-step-message-title">
                      {% if block.settings.show_icons %}
                      <span class="icon">
                        <svg width="21" height="19" viewBox="0 0 21 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10.2048 0C11.1278 0.00010274 11.8015 0.555453 12.3777 1.2793C12.9495 1.9978 13.5584 3.05425 14.3152 4.36133L18.3777 11.3779C19.1371 12.6897 19.752 13.7474 20.0915 14.6035C20.4334 15.4659 20.5798 16.3302 20.1179 17.1318C19.6557 17.9331 18.8351 18.2388 17.9177 18.375C17.0067 18.5102 15.7832 18.5078 14.2673 18.5078H6.14231C4.62642 18.5078 3.40296 18.5102 2.49192 18.375C1.57439 18.2388 0.754016 17.9332 0.291726 17.1318C-0.170352 16.3302 -0.0237862 15.4659 0.318093 14.6035C0.657611 13.7474 1.27258 12.6896 2.03196 11.3779L6.09446 4.36133C6.85113 3.05435 7.46019 1.99776 8.03196 1.2793C8.60808 0.555508 9.2818 0 10.2048 0ZM10.2048 1.5C9.975 1.5 9.68719 1.60908 9.20579 2.21387C8.71993 2.82441 8.17434 3.76251 7.39231 5.11328L3.32981 12.1299C2.54509 13.4853 2.00124 14.4294 1.71262 15.1572C1.42695 15.878 1.47591 16.1826 1.59055 16.3818C1.70546 16.5811 1.94461 16.7766 2.71262 16.8906C3.48718 17.0055 4.57599 17.0078 6.14231 17.0078H14.2673C15.8336 17.0078 16.9225 17.0056 17.697 16.8906C18.4648 16.7766 18.7042 16.5811 18.8191 16.3818C18.9336 16.1826 18.9826 15.8778 18.697 15.1572C18.4084 14.4293 17.8646 13.4854 17.0798 12.1299L13.0173 5.11328C12.2352 3.76239 11.6897 2.82444 11.2038 2.21387C10.7225 1.60908 10.4346 1.50008 10.2048 1.5ZM10.2048 12.7578C10.7568 12.758 11.2046 13.2058 11.2048 13.7578C11.2048 14.31 10.757 14.7577 10.2048 14.7578C9.65253 14.7578 9.20481 14.3101 9.20481 13.7578C9.20506 13.2057 9.65268 12.7578 10.2048 12.7578ZM10.2048 6.00781C10.6188 6.00795 10.9546 6.3439 10.9548 6.75781V10.7578C10.9548 11.1719 10.6189 11.5077 10.2048 11.5078C9.7906 11.5078 9.45481 11.172 9.45481 10.7578V6.75781C9.45506 6.34381 9.79075 6.00781 10.2048 6.00781Z" fill="#F1592A"/>
                        </svg>
                      </span>
                    {% endif %}
                        {{ block.settings.block_message }}
                    </h3>
                    <p>
                        {{ block.settings.block_message_text }}
                    </p>
                </div>
            {%  endif %}
            {% if block.settings.gird_icons %}
              <div class="blocks-grid__wrapper grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--2-col-desktop">
              
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon != blank %}
                            <img src="{{ block.settings.icon1 | img_url: 'master' }}"
                                    {% if block.settings.icon.alt %}
                                        alt="{{ block.settings.icon1.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title1 != blank %}
                                <h2 class="h4">{{ block.settings.title1 }}</h2>
                            {% endif %}
                            {% if block.settings.text1 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text1 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon2 != blank %}
                            <img src="{{ block.settings.icon2 | img_url: 'master' }}"
                                    {% if block.settings.icon2.alt %}
                                        alt="{{ block.settings.icon2.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title2 != blank %}
                                <h2 class="h4">{{ block.settings.title2 }}</h2>
                            {% endif %}
                            {% if block.settings.text2 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text2 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon3 != blank %}
                            <img src="{{ block.settings.icon3 | img_url: 'master' }}"
                                    {% if block.settings.icon3.alt %}
                                        alt="{{ block.settings.icon3.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title3 != blank %}
                                <h2 class="h4">{{ block.settings.title3 }}</h2>
                            {% endif %}
                            {% if block.settings.text3 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text3 }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="blocks-grid__item grid__item">
                        {% if block.settings.icon4 != blank %}
                            <img src="{{ block.settings.icon4 | img_url: 'master' }}"
                                    {% if block.settings.icon4.alt %}
                                        alt="{{ block.settings.icon4.alt }}"
                                    {% else %}
                                        alt="Icon"
                                    {% endif %}
                                    loading="lazy"
                                    width="{{ block.settings.icon.width }}"
                                    height="{{ block.settings.icon.height }}">
                        {% endif %}
                        <div>
                            {% if block.settings.title4 != blank %}
                                <h2 class="h4">{{ block.settings.title4 }}</h2>
                            {% endif %}
                            {% if block.settings.text4 != blank %}
                                <div class="blocks-grid__item-text">{{ block.settings.text4 }}</div>
                            {% endif %}
                        </div>
                    </div>
                
            </div>


            {% endif %}


        </div>

        
      {% endfor %}
    </div>

  </div>
</div>
</div>

<style>

.process-container .page-width {
    padding: 0 16px;
}
.process-steps-section {
  padding: 36px 0;
}

.process-steps-content {
padding: 0 16px;
}

.process-steps-wrapper {
  display: grid;
  grid-template-columns: 279px 1fr;
  gap: 16px;
}

.process-steps-section .section-heading {
  font-size: 38px;
  line-height: 38px;
  letter-spacing: 0.38px;
  font-weight: 800;
  margin: 0px;
  margin-bottom: 44px;
  text-transform: capitalize;
}

/* LEFT SIDE */
.process-steps-nav {
  position: sticky;
  top: 150px;
  height: fit-content;
}

.process-nav-item {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  cursor: pointer;
}

/* Make each nav item relative for positioning */
.process-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px; /* space for connector + spacing */
  cursor: pointer;
}

/* Remove extra space on last item */
.process-nav-item:last-child {
  margin-bottom: 0;
}

.process-nav-number {
  min-width: 48px;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-weight: 600;
  color: #000000;
  border-radius: 8px;
  margin: 0px;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  width: 100%;
  text-align: left;
  padding: 12px;
  border: 1px solid #E5E5E5;
  font-family: var(--font-body-family);
}

.process-nav-title {
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
  font-weight: 800;
  color: #010101;
}

.process-step-important {
  border-left: 4px solid #F1592A;
  padding-left: 20px;
  margin-bottom: 32px;
}

.process-step-important-title {
  font-family: var(--font-body-family);
  font-size: 18px;
  line-height: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0px;
  margin-bottom: 8px;
}

.process-step-important p {
  margin: 0px;
}

.process-step-important-title .icon {
  display: flex;
  align-items: center;
}

.process-step-message {
  background: #FCF6F4;
  border-radius: 12px;
  padding: 20px 24px;
}

.process-step-ul ol {
  list-style: none;         /* remove default numbers and dot */
  counter-reset: my-counter; /* start custom counter */
  padding-left: 0px;       /* space for numbers */
}

.process-step-ul ol li {
  counter-increment: my-counter; /* increment for each li */
  position: relative;
  padding-left: 36px;
  margin-bottom: 12px;
}

/* Insert number before each item */
.process-step-ul ol li::before {
  content: counter(my-counter); /* show number only */
  position: absolute;
  left: 0;
  font-weight: bold;
  font-size: 11px;           /* optional */
}


.process-step-ul ol li::before {
  left: 0;
  text-align: left;
  width: 24px;
  height: 24px;
  text-align: center;
  background: #FCE6DE;
  border-radius: 100%;
  color: #F1592A;
}

.process-step-message-title {
  margin: 0px;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: 0px;
  color: #F1592A;
  font-family: var(--font-body-family);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
}

.icon svg {
  display: block;
}

/* ACTIVE STATE */
.process-nav-item.active .process-nav-number {
  background: #3E77AA;
  color: #ffffff;
}

.process-nav-number p {
margin: 0px;
}

.process-nav-item.active .process-nav-title {
  color: #F15B61;
}

/* RIGHT SIDE */
.process-step-block {
  padding: 36px 0px;
}

#step-0 {
padding-top: 0px;
}

.process-steps-section #step-0 .process-step-heading {
margin-top: 0px;
}

.process-step-heading {
  margin: 0px;
  font-size: 38px;
  line-height: 50px;
  letter-spacing: 0px;
  margin-bottom: 16px;
}

.process-step-text {
  margin-bottom: 32px;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0px;
}

.process-step-text p {
  margin: 0px;
}

.headling-blue {
  font-size: 18px;
  line-height: 24px;
  color: #7283A4;
  letter-spacing: 0px;
  text-transform: initial;
  font-family: var(--font-body-family);
}

.process-step-ul-title {
  font-family: var(--font-body-family);
  font-size: 28px;
  line-height: 36px;
  margin-bottom: 20px;

}

.process-step-ul.rte ol {
  margin-bottom: 32px;
}


/* MOBILE */
@media (max-width: 990px) {
  .process-steps-section {
    padding: 24px 0px;
  }
  .process-steps-wrapper {
    grid-template-columns: 1fr;
  }

  .process-steps-nav {
    display: none !important;
    position: relative;
    top: 0;
    margin-bottom: 24px;
    display: flex;
    overflow-x: auto;
    gap: 8px;
    flex-direction: column;
    padding: 16px;
  }
  .process-nav-number {
    background: #F15B61;
    font-size: 22px;
    line-height: 22px;
    letter-spacing: 0.22px;
    margin: 0px;
    color: #ffffff;
  }

  .process-nav-item.active .process-nav-title {
    color: #010101;
    }

  .process-nav-item {
    flex: 0 0 auto;
    margin-bottom: 32px;
  }

  .process-step-block {
    margin-bottom: 24px;
  }
  .desktop-image {
    display: none;
  }

  .mobile-image {
    display: block;
  }

  .process-step-heading {
  font-size: 22px;
  line-height: 22px;
  letter-spacing: 0.22px;
  margin-bottom: 26px;
  margin-top: 0px;
  }

  .process-step-text {
  font-size: 14px;
  line-height: 20px;
  margin-bottom: 20px;
  }

  .process-steps-section .section-heading {
  font-size: 26px;
  line-height: 26px;
  letter-spacing: 0.26px;
  margin-bottom: 20px;
  margin-top: 0;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const navItems = document.querySelectorAll(".process-nav-item");
  const sections = document.querySelectorAll(".process-step-block");

  // Click scroll
  navItems.forEach(item => {
    item.addEventListener("click", function () {
      const target = document.getElementById(this.dataset.target);
      window.scrollTo({
        top: target.offsetTop - 100,
        behavior: "smooth"
      });
    });
  });

  // Intersection Observer for scroll spy
  const observerOptions = {
    root: null,
    rootMargin: "0px 0px -40% 0px",
    threshold: 0.3
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {

        const id = entry.target.getAttribute("id");

        navItems.forEach(item => {
          item.classList.remove("active");
          if (item.dataset.target === id) {
            item.classList.add("active");
          }
        });

      }
    });
  }, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });

});
</script>

