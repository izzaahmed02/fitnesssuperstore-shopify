{% comment %}
State FAQs Section
Fetches FAQ data from metafield: custom.service_state_faqs
Metaobject: service_state_faqs
Fields: faq_question, faq_answers
{% endcomment %}

<section class="state-faqs section section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="state-faqs__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign faqs_metafield = page.metafields.custom.service_state_faqs %}
    
    {% if faqs_metafield != blank and faqs_metafield.references.size > 0 %}
      <div class="state-faqs__list">
        {% for faq in faqs_metafield.references %}
          <div class="state-faqs__item">
            <h3 class="state-faqs__question">{{ faq.faq_question }}</h3>
            <div class="state-faqs__answer">
              {{ faq.faq_answers }}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p>No FAQs available at this time.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Service State FAQs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Service State FAQs"
    }
  ]
}
{% endschema %}
