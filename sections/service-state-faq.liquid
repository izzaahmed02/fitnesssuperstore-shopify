{% comment %}
State FAQs Section
Fetches FAQ data from page metafield: custom.service_state_faqs
Metaobject: service_state_faqs
Fields: faq_question, faq_answers
{% endcomment %}

<section class="state-faqs section section-{{ section.id }}">
  <div class="page-width">
    <h2>FAQs Debug Output</h2>
    <pre>
Metafield JSON: {{ page.metafields.custom.service_state_faqs | json }}
    </pre>
  </div>
</section>


{% schema %}
{
  "name": "Service State FAQs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Service State FAQs"
    }
  ]
}
{% endschema %}
