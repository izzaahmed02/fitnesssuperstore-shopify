{%- comment -%} Benicia Showroom — Map, Hours & Directions (Plan your visit) {%- endcomment -%}
{{ 'showroom-benicia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign phone_tel = s.phone_tel | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}
<section class="sr-page sr-section sr-map">
  <div class="sr-container sr-map__grid">
    <div class="sr-map__embed">
      {{ s.map_embed }}
    </div>
    <div class="sr-map__details">
      <div class="sr-map__head">
        <h2 class="sr-map__title">{{ s.map_heading }}</h2>
        {%- if s.map_subtitle != blank -%}<p class="sr-map__subtitle">{{ s.map_subtitle }}</p>{%- endif -%}
      </div>

      <ul class="sr-map__list">
        {%- if s.row1_primary != blank -%}
          <li class="sr-map__row">
            <span class="sr-map__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <span class="sr-map__rowtext"><span class="sr-map__primary">{{ s.row1_primary }}</span>{% if s.row1_secondary != blank %}<span class="sr-map__secondary">{{ s.row1_secondary }}</span>{% endif %}</span>
          </li>
        {%- endif -%}
        {%- if s.row2_primary != blank -%}
          <li class="sr-map__row">
            <span class="sr-map__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/></svg></span>
            <span class="sr-map__rowtext"><span class="sr-map__primary">{{ s.row2_primary }}</span>{% if s.row2_secondary != blank %}<span class="sr-map__secondary">{{ s.row2_secondary }}</span>{% endif %}</span>
          </li>
        {%- endif -%}
        {%- if s.row3_primary != blank -%}
          <li class="sr-map__row">
            <span class="sr-map__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"/></svg></span>
            <span class="sr-map__rowtext"><span class="sr-map__primary">{{ s.row3_primary }}</span>{% if s.row3_secondary != blank %}<span class="sr-map__secondary">{{ s.row3_secondary }}</span>{% endif %}</span>
          </li>
        {%- endif -%}
        {%- if s.row4_primary != blank -%}
          <li class="sr-map__row">
            <span class="sr-map__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.75" r="0.6" fill="currentColor" stroke="none"/></svg></span>
            <span class="sr-map__rowtext"><span class="sr-map__primary">{{ s.row4_primary }}</span>{% if s.row4_secondary != blank %}<span class="sr-map__secondary">{{ s.row4_secondary }}</span>{% endif %}</span>
          </li>
        {%- endif -%}
      </ul>

      <a class="sr-btn sr-btn--primary sr-map__cta" href="tel:{{ phone_tel }}" data-sr-event="showroom_call_click" data-sr-location="map">
        {{ s.map_call_label }}
      </a>
    </div>
  </div>
</section>
<script src="{{ 'showroom-benicia.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Showroom Map & Directions",
  "tag": "section",
  "class": "section section-showroom-map",
  "settings": [
    { "type": "html", "id": "map_embed", "label": "Map embed (iframe)", "default": "<iframe title=\"Benicia showroom map\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3140.8353440721503!2d-122.13291412435669!3d38.07421557191142!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80856e61f4a219f9%3A0x967cc8884a1783f6!2s457%20Industrial%20Way%2C%20Benicia%2C%20CA%2094510%2C%20USA!5e0!3m2!1sen!2sus!4v1763716232308\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen></iframe>" },
    { "type": "text", "id": "map_heading", "label": "Heading", "default": "Plan your visit" },
    { "type": "text", "id": "map_subtitle", "label": "Subtitle", "default": "Map, Hours & Directions" },
    { "type": "header", "content": "Row 1 — Address (pin)" },
    { "type": "text", "id": "row1_primary", "label": "Primary", "default": "457 Industrial Way, Benicia, CA 94510" },
    { "type": "text", "id": "row1_secondary", "label": "Secondary", "default": "Public showroom — open to visitors" },
    { "type": "header", "content": "Row 2 — Hours (clock)" },
    { "type": "text", "id": "row2_primary", "label": "Primary", "default": "Showroom hours: Mon–Fri, 8 AM–3:30 PM" },
    { "type": "text", "id": "row2_secondary", "label": "Secondary", "default": "Phone hours: 7 AM–6 PM, Mon–Fri" },
    { "type": "header", "content": "Row 3 — Phone" },
    { "type": "text", "id": "row3_primary", "label": "Primary", "default": "+1 (925) 215-2927" },
    { "type": "text", "id": "row3_secondary", "label": "Secondary", "default": "No weekend or after-hours availability" },
    { "type": "header", "content": "Row 4 — Entry (info)" },
    { "type": "text", "id": "row4_primary", "label": "Primary", "default": "Enter from Industrial Way" },
    { "type": "text", "id": "row4_secondary", "label": "Secondary", "default": "Visitor parking is in front of the main showroom doors" },
    { "type": "header", "content": "Call button" },
    { "type": "text", "id": "map_call_label", "label": "Call button label", "default": "Call the Showroom" },
    { "type": "text", "id": "phone_tel", "label": "Phone (tel: value)", "default": "+19252152927" }
  ],
  "presets": [{ "name": "Showroom Map & Directions" }]
}
{% endschema %}
