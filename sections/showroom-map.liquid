{%- comment -%} Benicia Showroom — Map, Hours & Directions {%- endcomment -%}
{{ 'showroom-benicia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign phone_tel = s.phone_tel | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}
<section class="sr-page sr-section sr-map">
  <div class="sr-container sr-map__grid">
    <div class="sr-map__embed">
      {{ s.map_embed }}
    </div>
    <div class="sr-map__details">
      <p class="sr-map__eyebrow">{{ s.map_eyebrow }}</p>
      <h2 class="sr-section__title">{{ s.map_heading }}</h2>
      <ul class="sr-map__list">
        {%- for i in (1..7) -%}
          {%- assign k = 'map_point_' | append: i -%}
          {%- if s[k] != blank -%}<li>{{ s[k] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="sr-map__ctas">
        <a class="sr-btn sr-btn--primary" href="tel:{{ phone_tel }}" data-sr-event="showroom_call_click" data-sr-location="map">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z"/></svg>{{ s.map_call_label }}
        </a>
        <a class="sr-btn sr-btn--ghost" href="{{ s.directions_url }}" target="_blank" rel="noopener" data-sr-event="directions_click" data-sr-location="map">
          {{ s.cta_directions_label }}
        </a>
      </div>
    </div>
  </div>
</section>
<script src="{{ 'showroom-benicia.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Showroom Map & Directions",
  "tag": "section",
  "class": "section section-showroom-map",
  "settings": [
    { "type": "html", "id": "map_embed", "label": "Map embed (iframe)", "default": "<iframe title=\"Benicia showroom map\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3140.8353440721503!2d-122.13291412435669!3d38.07421557191142!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80856e61f4a219f9%3A0x967cc8884a1783f6!2s457%20Industrial%20Way%2C%20Benicia%2C%20CA%2094510%2C%20USA!5e0!3m2!1sen!2sus!4v1763716232308\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen></iframe>" },
    { "type": "text", "id": "map_eyebrow", "label": "Eyebrow", "default": "Plan your visit" },
    { "type": "text", "id": "map_heading", "label": "Heading", "default": "Map, Hours & Directions" },
    { "type": "text", "id": "map_point_1", "label": "Point 1", "default": "457 Industrial Way, Benicia, CA 94510" },
    { "type": "text", "id": "map_point_2", "label": "Point 2", "default": "Public showroom — open to visitors" },
    { "type": "text", "id": "map_point_3", "label": "Point 3", "default": "Showroom hours: Mon–Fri, 8 AM–3:30 PM" },
    { "type": "text", "id": "map_point_4", "label": "Point 4", "default": "Phone hours: 7 AM–6 PM, Mon–Fri" },
    { "type": "text", "id": "map_point_5", "label": "Point 5", "default": "No weekend or after-hours availability" },
    { "type": "text", "id": "map_point_6", "label": "Point 6", "default": "Enter from Industrial Way" },
    { "type": "text", "id": "map_point_7", "label": "Point 7", "default": "Visitor parking is in front of the main showroom doors" },
    { "type": "text", "id": "map_call_label", "label": "Call button label", "default": "Call the Showroom" },
    { "type": "header", "content": "Contact & Directions" },
    { "type": "text", "id": "phone_tel", "label": "Phone (tel: value)", "default": "+19252152927" },
    { "type": "text", "id": "directions_url", "label": "Get Directions URL", "default": "https://www.google.com/maps/dir/?api=1&destination=457+Industrial+Way,+Benicia,+CA+94510" },
    { "type": "text", "id": "cta_directions_label", "label": "Directions CTA label", "default": "Get Directions" }
  ],
  "presets": [{ "name": "Showroom Map & Directions" }]
}
{% endschema %}
