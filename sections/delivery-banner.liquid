{{ 'section-delivery-banner.css' | asset_url | stylesheet_tag }}


<div class="section-{{ section.id }} page-width">
    <div class="container">
        <div class="delivery-banner__wrapper">
            <h1 class="delivery-banner__title">{{ section.settings.heading }}</h1>
            <img src="{{ section.settings.image | image_url: width: 1300, height: 410 }}"
                 alt="{{ section.settings.image.alt | escape }}" class="delivery-banner__img">
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Banner",
  "tag": "section",
  "class": "section delivery-banner",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "Delivery Banner"
    }
  ]
}
{% endschema %}
