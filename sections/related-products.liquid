{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% comment %} Get the metafield data - use .value to get ProductListDrop {% endcomment %}
{% assign related_products_list = product.metafields.custom.related_products.value %}

{% assign fallback_count = 4 %}
{% assign products_to_display = blank %}
{% assign product_count = 0 %}

{% comment %} Check if we have related products in the metafield {% endcomment %}
{% if related_products_list != blank %}
  {% comment %} ProductListDrop can be iterated directly {% endcomment %}
  {% for related_product in related_products_list %}
    {% comment %} Check if product is available and not the current product {% endcomment %}
    {% if related_product != blank and related_product.available and related_product.id != product.id %}
      {% if products_to_display == blank %}
        {% capture products_to_display %}{{ related_product.id }}{% endcapture %}
      {% else %}
        {% capture products_to_display %}{{ products_to_display }},{{ related_product.id }}{% endcapture %}
      {% endif %}
      {% assign product_count = product_count | plus: 1 %}
      
      {% if product_count >= fallback_count %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}
  
  {% comment %} Convert the IDs back to products for display {% endcomment %}
  {% if products_to_display != blank %}
    {% assign product_ids = products_to_display | split: ',' %}
    {% assign products_to_display = blank %}
    
    {% for product_id in product_ids %}
      {% comment %} Get each product by iterating through the list again {% endcomment %}
      {% for related_product in related_products_list %}
        {% assign id_string = related_product.id | append: '' %}
        {% assign check_id = product_id | append: '' %}
        {% if id_string == check_id %}
          {% if products_to_display == blank %}
            {% assign products_to_display = related_product %}
          {% else %}
            {% assign products_to_display = products_to_display | append: '|||' | append: related_product %}
          {% endif %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    
    {% if products_to_display != blank and products_to_display contains '|||' %}
      {% assign products_to_display = products_to_display | split: '|||' %}
    {% elsif products_to_display != blank %}
      {% comment %} Single product - create array {% endcomment %}
      {% assign temp_product = products_to_display %}
      {% assign products_to_display = blank | split: ',' %}
      {% assign products_to_display = products_to_display | push: temp_product %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %} Simpler approach - try direct iteration and collection {% endcomment %}
{% if products_to_display == blank or products_to_display.size == 0 %}
  {% assign products_array = blank | split: ',' %}
  
  {% if related_products_list != blank %}
    {% for related_product in related_products_list limit: fallback_count %}
      {% if related_product.available and related_product.id != product.id %}
        {% assign products_array = products_array | push: related_product %}
      {% endif %}
    {% endfor %}
    
    {% if products_array.size > 0 %}
      {% assign products_to_display = products_array %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %} Fallback to collection products if no metafield products found {% endcomment %}
{% if products_to_display == blank or products_to_display.size == 0 %}
  {% assign products_array = blank | split: ',' %}
  
  {% comment %} Try to get products from the same collection first {% endcomment %}
  {% if product.collections.size > 0 %}
    {% assign current_collection = product.collections.first %}
    
    {% for collection_product in current_collection.products limit: 10 %}
      {% if collection_product.available and collection_product.id != product.id %}
        {% assign products_array = products_array | push: collection_product %}
        
        {% if products_array.size >= fallback_count %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  
  {% comment %} If still need more products, use all products collection {% endcomment %}
  {% if products_array.size < fallback_count %}
    {% for fallback_product in collections.all.products limit: 10 %}
      {% if fallback_product.available and fallback_product.id != product.id %}
        {% comment %} Check if not already in array {% endcomment %}
        {% assign already_added = false %}
        {% for existing in products_array %}
          {% if existing.id == fallback_product.id %}
            {% assign already_added = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        
        {% unless already_added %}
          {% assign products_array = products_array | push: fallback_product %}
        {% endunless %}
        
        {% if products_array.size >= fallback_count %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  
  {% if products_array.size > 0 %}
    {% assign products_to_display = products_array %}
  {% endif %}
{% endif %}

{% if products_to_display != blank and products_to_display.size > 0 %}
  <div class="custom-container">
    <div class="featured_products_header">
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="featured_products_container">
      {% for display_product in products_to_display limit: fallback_count %}
        {% render 'related-items', product: display_product %}
      {% endfor %}
    </div>
  </div>
  <script src="{{ 'related-products.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section related-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label"
    }
  ]
}
{% endschema %}