{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% comment %} Get the metafield data {% endcomment %}
{% assign related_products_metafield = product.metafields.custom.related_products.value %}

{% comment %} Debug: Check metafield content {% endcomment %}
<!-- Debug: Metafield size: {{ related_products_metafield.size }} -->
<!-- Debug: First product in metafield: {{ related_products_metafield.first.title }} -->

{% assign fallback_count = 4 %}
{% assign products_to_display = '' | split: '' %}

{% if related_products_metafield and related_products_metafield.size > 0 %}
  {% comment %} Metafield contains product references - iterate through them {% endcomment %}
  {% for related_product in related_products_metafield %}
    {% comment %} Check if product is available and not the current product {% endcomment %}
    {% if related_product and related_product.available and related_product.id != product.id %}
      {% assign products_to_display = products_to_display | append: related_product | append: ',' | split: ',' %}
      
      {% comment %} Stop if we have enough products {% endcomment %}
      {% if products_to_display.size >= fallback_count %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}
  
  {% comment %} Limit to fallback_count {% endcomment %}
  {% if products_to_display.size > fallback_count %}
    {% assign products_to_display = products_to_display | slice: 0, fallback_count %}
  {% endif %}
{% endif %}

{% comment %} Fallback to collection products if no metafield products found {% endcomment %}
{% if products_to_display.size == 0 %}
  {% comment %} Try to get products from the same collection first {% endcomment %}
  {% assign current_collection = collections[product.collections.first.handle] %}
  
  {% if current_collection %}
    {% assign collection_products = current_collection.products | where: 'available', true %}
    {% for collection_product in collection_products limit: 5 %}
      {% if collection_product.id != product.id %}
        {% assign products_to_display = products_to_display | append: collection_product | append: ',' | split: ',' %}
        {% if products_to_display.size >= fallback_count %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
  
  {% comment %} If still no products, use all products collection {% endcomment %}
  {% if products_to_display.size == 0 %}
    {% assign all_products = collections.all.products | where: 'available', true %}
    {% for fallback_product in all_products limit: 5 %}
      {% if fallback_product.id != product.id %}
        {% assign products_to_display = products_to_display | append: fallback_product | append: ',' | split: ',' %}
        {% if products_to_display.size >= fallback_count %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% if products_to_display.size > 0 %}
  <div class="custom-container">
    <div class="featured_products_header">
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="featured_products_container">
      {% for product in products_to_display %}
        {% render 'related-items', product: product %}
      {% endfor %}
    </div>
  </div>
  <script src="{{ 'related-products.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section related-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label"
    }
  ]
}
{% endschema %}