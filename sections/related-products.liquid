<script>
  document.addEventListener('DOMContentLoaded', function () {
     
    const relatedProductsUl = document.querySelector('.related-products');

    if (relatedProductsUl) {

      const observer = new MutationObserver((mutationsList) => {
        mutationsList.forEach((mutation) => {
          if (mutation.type === 'childList') {
            function initSlider(element) {
            if (!$(element).hasClass('slick-initialized')) {
              $(element).slick({
                slidesToShow: 1,
                slidesToScroll: 1,
                lazyLoad: 'ondemand',
                arrows: true,
                dots: true,
                responsive: [
                  {
                    breakpoint: 768,
                    settings: { 
                      slidesToShow: 1,
                    },
                  },
                ],
              });
      
              $(element)
                .find('.image-item')
                .each(function () {
                  $(this).css({
                    background: '#edeff3',
                  });
                });
              $(element)
                .find('img.lazy-load')
                .each(function () {
                  const img = $(this);
                  if (img) {
                    img.attr('src', img.data('src'));
                    img.removeClass('lazy-load');
                    img.css({
                      opacity: '1',
                      visibility: 'visible',
                    });
                  }
                });
            }
          }
      
          const observer = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  initSlider(entry.target);
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.5 }
          );
      
            $('.image-wrap').each(function () {
              if ($(this).length > 0) {
                observer.observe(this);
              }
            }); 
      
          $('.related-products ul').slick({
                infinite: false,
                slidesToShow: 4,
                slidesToScroll: 1,
                prevArrow: $('.slick-prev'),
                nextArrow: $('.slick-next'),
                arrows: true,
                dots: false,
                draggable: false
          });
      
          $('.related-products ul').on('afterChange', function (event, slick, currentSlide) {
            const $prev = $('.slick-prev');
            const $next = $('.slick-next');
          
            if (currentSlide === 0) { 
            } else {
              $prev.removeClass('slick-disabled');
            }
          
            if (currentSlide === slick.slideCount - slick.options.slidesToShow) {
              $next.addClass('slick-disabled');
            } else {
              $next.removeClass('slick-disabled');
            }
          });
          $('.related-products').css("height", "auto");
          $('.related-products').css("overflow-y", "visible");
          }
        });
      });
    
      const config = {
        childList: true,
        attributes: false, 
        subtree: false,
      };
    
      observer.observe(relatedProductsUl, config);
    }

  });
</script>

{% style %}
  #shopify-section-{{ section.id }}{
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .related-products{
    padding: 0;
    display: flex;
    height: 0;
    max-width: 1680px;
    margin: 0 auto;
    overflow-y: hidden;
  }
  .related-products ul{
    display: flex;
    max-width: 89%;
    margin-left: auto;
    margin-right: auto;
  }
  .related-products .product-item{
    margin-left: 16px;
    margin-right: 16px;
  }

  .slick-prev,
  .slick-next {
    position: absolute;
    top: 30%;
    transform: translateY(-50%);
    z-index: 10;
    cursor: pointer;
  }
  
  .slick-prev:before {
    display: none;
  }

  .slick-next:before {
    display: none;
  }
  
  
  .slick-next {
    right: 20px;
  }
  .slick-prev{
    left: -10px;
  }
  .slick-prev-icon,
  .slick-next-icon {
    transition: fill 0.3s ease;
  }
  
  .slick-disabled rect {
    fill: #E5E5E5;
  }
  
  .slick-disabled rect {
    fill: #E5E5E5;
  }

  .recommendation-title{
    font-size: 48px;
    font-weight: 700;
    line-height: 68px;
    color: #23232B;
    margin-top: 0;
    margin-bottom: 52px;
    text-align: center;
  }
  #product_page .paging .sa_page{
    width: 48px;
    height: 48px;
    border-radius: 8px;
    border: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    color: #393940;
  }
  #product_page .paging .sa_page.active{
    background: #F1592A;
    color: #fff;
  }

  @media (min-width: 1918px) {
    .related-products ul {
      max-width: 97%;
    }
    .slick-prev {
      left: -40px;
    }
    .slick-next {
      right: -20px;
    }
  }
{% endstyle %}

{% render 'collection-section-style' %}

<div class="product-recommendations"></div>

<h2 class="recommendation-title">{{ section.settings.title }}</h2>

<product-recommendations
    class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit=16"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <ul
        class=""
        role="list"
      >
        {% for recommendation in recommendations.products %}
          {% render 'product-item', product: recommendation %}
        {% endfor %}
      </ul>

      <div class="slick-prev" aria-label="Previous">
        <svg class="slick-prev-icon" width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="48" rx="24" fill="#616166" />
          <path fill-rule="evenodd" clip-rule="evenodd" d="M26.5303 17.4697C26.8232 17.7626 26.8232 18.2374 26.5303 18.5303L21.0607 24L26.5303 29.4697C26.8232 29.7626 26.8232 30.2374 26.5303 30.5303C26.2374 30.8232 25.7626 30.8232 25.4697 30.5303L19.4697 24.5303C19.1768 24.2374 19.1768 23.7626 19.4697 23.4697L25.4697 17.4697C25.7626 17.1768 26.2374 17.1768 26.5303 17.4697Z" fill="#B3B3B3" />
        </svg>
      </div>
      <div class="slick-next" aria-label="Next">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="48" height="48" rx="24" fill="#616166"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M21.4697 17.4697C21.7626 17.1768 22.2374 17.1768 22.5303 17.4697L28.5303 23.4697C28.8232 23.7626 28.8232 24.2374 28.5303 24.5303L22.5303 30.5303C22.2374 30.8232 21.7626 30.8232 21.4697 30.5303C21.1768 30.2374 21.1768 29.7626 21.4697 29.4697L26.9393 24L21.4697 18.5303C21.1768 18.2374 21.1768 17.7626 21.4697 17.4697Z" fill="white"/>
        </svg>
      </div>
    {% endif %}
  </product-recommendations>


