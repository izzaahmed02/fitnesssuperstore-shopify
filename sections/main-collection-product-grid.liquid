<script>
  window.shopifyDomain = '79ef8b-5e.myshopify.com';
  window.shopifyStorefrontToken = 'c58409094793cba2fc6ce881d45d39f5';
  window.currentCollectionId = "gid://shopify/Collection/{{ collection.id }}";
