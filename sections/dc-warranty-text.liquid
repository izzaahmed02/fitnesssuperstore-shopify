{{ 'dc-warranty-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} .multicolumn-card {
      text-align: start;
    }
  }
{%- endstyle -%}


<div class="dc-warranty-text">
  <div
    class="page-width-dc multicolumn-padding section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >

    <div>
      {{ section.settings.text }}
    </div>

    <div class="dc-wtext-bottom">
    {% for block in section.blocks %}
    <div class="dc-wtext-item dc-wtext-num">
      <h4 class="dc-wtext-item-title">
        {{ block.settings.title }}
      </h4>

      {% if block.settings.subtitle != blank %}
      <div class="dc-wtext-item-subtitle">
        {{ block.settings.subtitle }}
      </div>
      {% endif %}

      {% if block.settings.text != blank %}
      <div class="dc-wtext-num-body">
        {{ block.settings.text }}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "dc Warranty Text",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#fff"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    }
  ],
  "blocks": [
    {
      "type": "item-num",
      "name": "item with nums and bulls",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "dc Warranty Text",
      "blocks": [
      ]
    }
  ]
}
{% endschema %}