<script>
document.addEventListener('DOMContentLoaded', () => {
  // Only run accordion behaviour on mobile
  const mq = window.matchMedia('(max-width: 749px)');

  function initAccordions() {
    const toggles = document.querySelectorAll('.footer__accordion-toggle');
    if (!toggles.length) return;

    toggles.forEach(toggle => {
      // Remove any old listener by cloning (safe in case of theme editor re-init)
      const fresh = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(fresh, toggle);
    });

    // Re-query after clone
    document.querySelectorAll('.footer__accordion-toggle').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        const submenuId = toggle.getAttribute('aria-controls');
        const submenu = document.getElementById(submenuId);

        // Close all others
        document.querySelectorAll('.footer__accordion-toggle').forEach(other => {
          if (other !== toggle) {
            other.setAttribute('aria-expanded', 'false');
            const otherMenu = document.getElementById(other.getAttribute('aria-controls'));
            if (otherMenu) otherMenu.classList.remove('is-open');
          }
        });

        toggle.setAttribute('aria-expanded', String(!isOpen));
        if (submenu) submenu.classList.toggle('is-open', !isOpen);
      });
    });
  }

  // Only activate on mobile; also re-run if viewport crosses the breakpoint
  if (mq.matches) initAccordions();
  mq.addEventListener('change', e => {
    if (e.matches) initAccordions();
  });
});
</script>