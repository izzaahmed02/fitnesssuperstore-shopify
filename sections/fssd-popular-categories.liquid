{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 4, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Six category tiles rendered as a static grid. No tabs, no carousel, no slick
  initialisation — visibility of all six without interaction is the point of
  the module (spec §4 item 4). Self-contained per spec R3; no shared stylesheet
  import, no device-targeting CSS (spec R2), no analytics helper (spec §8).

  The subtitle field has no equivalent on the Control section. Both the six
  category destinations and the subtitle copy are pending the consolidated
  Carlos / Larianne approval (spec §7, gate G0-j), so every value is a schema
  setting with a default rather than markup.
{% endcomment %}

<section class="fssd-popular-categories" aria-labelledby="fssd-popular-categories-heading-{{ section.id }}">
  <div class="fssd-popular-categories__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fssd-popular-categories__heading" id="fssd-popular-categories-heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="fssd-popular-categories__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <ul class="fssd-popular-categories__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category_card' -%}
          <li class="fssd-popular-categories__item" {{ block.shopify_attributes }}>
            <a
              class="fssd-popular-categories__card"
              href="{{ block.settings.link }}"
              data-fss-hp-event="fss_hp_category_click"
              data-fss-hp-props='{"category_handle": {{ block.settings.category_handle | json | escape }}, "slot": {{ forloop.index }}}'
            >
              {%- comment -%}
                Decorative only — aria-hidden, empty alt. The adjacent title and
                subtitle carry the meaning. An uploaded image overrides the
                selected inline SVG, so design assets drop in with no code change.
              {%- endcomment -%}
              <span class="fssd-popular-categories__icon" aria-hidden="true">
                {%- if block.settings.image_url != blank -%}
                  {%- comment -%}
                    Raw Shopify CDN URL — Tim-approved art that is not in
                    Content > Files, so an image_picker cannot bind it. The
                    image_url filter does not apply to a raw URL, so retina is
                    handled with the CDN's own &width= param (URLs already carry
                    ?v=, so append with &). Decorative: alt stays empty.
                  {%- endcomment -%}
                  <img
                    src="{{ block.settings.image_url }}&width=168"
                    srcset="{{ block.settings.image_url }}&width=112 1x, {{ block.settings.image_url }}&width=168 2x"
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  >
                {%- elsif block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 168 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 112 }} 112w,
                      {{ block.settings.image | image_url: width: 168 }} 168w
                    "
                    sizes="56px"
                    alt=""
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'treadmill' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 17h12l4-10"/><path d="M19 7V4h2"/><path d="M4 17v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1"/></svg>
                    {%- when 'bike' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17l4-8h5"/><path d="M10 9l3 8"/><path d="M13 6h3"/></svg>
                    {%- when 'weight_stack' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="7" y="5" width="10" height="3" rx="1"/><rect x="7" y="10" width="10" height="3" rx="1"/><rect x="7" y="15" width="10" height="3" rx="1"/><path d="M12 2v3"/></svg>
                    {%- when 'weight_plate' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/><path d="M12 4v2"/><path d="M12 18v2"/><path d="M4 12h2"/><path d="M18 12h2"/></svg>
                    {%- when 'rack' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 4v16"/><path d="M19 4v16"/><path d="M5 8h14"/><path d="M5 14h14"/><path d="M3 20h4"/><path d="M17 20h4"/></svg>
                    {%- when 'barbell' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9v6"/><path d="M6 7v10"/><path d="M18 7v10"/><path d="M21 9v6"/><path d="M6 12h12"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>

              <span class="fssd-popular-categories__body">
                {%- if block.settings.title != blank -%}
                  <span class="fssd-popular-categories__title">{{ block.settings.title }}</span>
                {%- endif -%}

                {%- if block.settings.subtitle != blank -%}
                  <span class="fssd-popular-categories__subtitle">{{ block.settings.subtitle }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.view_all_link != blank and section.settings.view_all_text != blank -%}
      <a class="fssd-popular-categories__view-all" href="{{ section.settings.view_all_link }}">
        {{ section.settings.view_all_text }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .fssd-popular-categories {
    --fssd-cat-accent: #d83d0e;
    --fssd-cat-border: #e5e5e5;
    --fssd-cat-muted: #616166;
    padding: 40px 0;
  }
  .fssd-popular-categories__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .fssd-popular-categories__heading {
    margin: 0 0 32px;
    font-size: 38px;
    line-height: 50px;
  }
  .fssd-popular-categories__subheading {
    max-width: 72ch;
    margin: 0 0 24px;
    color: var(--fssd-cat-muted);
    font-size: 16px;
    line-height: 26px;
  }
  .fssd-popular-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fssd-popular-categories__item {
    display: flex;
  }
  .fssd-popular-categories__card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 20px;
    border: 1px solid var(--fssd-cat-border);
    border-radius: 12px;
    text-align: left;
    text-decoration: none;
    color: inherit;
    background: #ffffff;
    box-shadow: 0px 0px 12px 0px #0000001A;
    transition: box-shadow 0.3s ease;
  }
  .fssd-popular-categories__card:hover {
    border-color: var(--fssd-cat-accent);
  }
  .fssd-popular-categories__card:focus-visible {
    outline: 3px solid var(--fssd-cat-accent);
    outline-offset: 2px;
  }
  .fssd-popular-categories__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background: #edeff3;
    color: var(--fssd-cat-accent);
  }
  .fssd-popular-categories__icon svg {
    width: 32px;
    height: 32px;
    display: block;
  }
  .fssd-popular-categories__icon img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    display: block;
  }
  .fssd-popular-categories__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .fssd-popular-categories__title {
    font-size: 15px;
    font-weight: 700;
    line-height: 20px;
  }
  .fssd-popular-categories__subtitle {
    color: var(--fssd-cat-muted);
    font-size: 13px;
    line-height: 18px;
  }
  .fssd-popular-categories__view-all {
    display: inline-block;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 700;
    color: var(--fssd-cat-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media screen and (max-width: 989px) {
    .fssd-popular-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .fssd-popular-categories__inner {
      padding: 0 16px;
    }
    .fssd-popular-categories__heading {
      font-size: 20px;
      line-height: 26px;
    }
    .fssd-popular-categories__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Popular Categories",
  "class": "fssd-popular-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Popular Categories"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Browse equipment by category."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View all categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link URL"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "category_handle",
          "label": "Category handle (fss_hp_category_click property)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (raw CDN, optional)",
          "info": "Overrides the icon. Precedence: Image URL, then Card Image, then icon. Use for a Shopify CDN URL not stored in Content > Files. Retina via the CDN &width= param; alt stays empty (decorative)."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Decorative inline SVG. Overridden by an Image URL or an uploaded Card Image.",
          "options": [
            { "value": "treadmill", "label": "Treadmill" },
            { "value": "bike", "label": "Exercise bike" },
            { "value": "weight_stack", "label": "Weight stack" },
            { "value": "weight_plate", "label": "Weight plate" },
            { "value": "rack", "label": "Rack / rig" },
            { "value": "barbell", "label": "Barbell" }
          ],
          "default": "treadmill"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image (overrides the icon)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Popular Categories",
      "category": "Custom",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Treadmills",
            "subtitle": "Commercial & performance cardio",
            "category_handle": "treadmills",
            "link": "/collections/treadmills",
            "image_url": "https://cdn.shopify.com/s/files/1/0884/2012/2940/collections/image_16.png?v=1739775592",
            "icon": "treadmill"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Exercise Bikes",
            "subtitle": "Upright, recumbent & indoor cycles",
            "category_handle": "exercise-bikes",
            "link": "/collections/exercise-bikes",
            "image_url": "https://cdn.shopify.com/s/files/1/0884/2012/2940/collections/image_bd424f47-0660-4439-ba5c-48a4560521d5.png?v=1734520137",
            "icon": "bike"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Selectorized",
            "subtitle": "Pin-loaded commercial strength",
            "category_handle": "selectorized-pin-loaded",
            "link": "/collections/selectorized-pin-loaded",
            "icon": "weight_stack"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Plate Loaded",
            "subtitle": "Leverage and free-weight machines",
            "category_handle": "plate-loaded",
            "link": "/collections/plate-loaded",
            "icon": "weight_plate"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Cages, Racks & Rigs",
            "subtitle": "Training systems & rack solutions",
            "category_handle": "cages-racks-rigs",
            "link": "/collections/cages-racks-rigs",
            "icon": "rack"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Free Weights",
            "subtitle": "Dumbbells, plates, bars & storage",
            "category_handle": "free-weights",
            "link": "/collections/free-weights",
            "image_url": "https://cdn.shopify.com/s/files/1/0884/2012/2940/files/FF-RCHD5-50-main.webp?v=1773521358",
            "icon": "barbell"
          }
        }
      ]
    }
  ]
}
{% endschema %}
