{{ 'section-sitemap.css' | asset_url | stylesheet_tag }}

{% style %}
  .sitemap-container {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
    .sitemap-container {
      padding-top: {{ section.settings.padding_top | times: 0.3 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.3 | round }}px;
    }
  }
{% endstyle %}

<div class="sitemap-container page-width scroll-trigger animate--slide-in">
  <h2>{{ section.settings.heading }}</h2>

  <div class="sitemap_search_wrapper">
    <input
      class="sitemap_search"
      type="text"
      placeholder="Search"
      oninput="filterPages()"
    />
  </div>
  
  <a href="/" class="sitemap_link home-link">Home</a>

  <div class="sitemap_links" id="sitemapLinks">
    {% for page in pages %}
      <div class="sitemap_item">
        <a href="{{ page.url }}" class="sitemap_link">{{ page.title }}</a>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  function filterPages() {
    const searchInput = document.querySelector('.sitemap_search').value.toLowerCase();
    const pages = document.querySelectorAll('.sitemap_item');

    pages.forEach((page) => {
      const title = page.textContent.toLowerCase();
      page.style.display = title.includes(searchInput) ? 'block' : 'none';
    });
  }
</script>


{% schema %}
{
  "name": "Sitemap",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ]
}
{% endschema %}