<script>
(function(){
  const input=document.getElementById('sitemap-search');
  const meta=document.getElementById('search-meta');
  const lists=[document.getElementById('sitemap-left'), document.getElementById('sitemap-right')];

  function label(li){
    const a=li.querySelector(':scope > a');
    return (a?a.textContent:(li.firstChild && li.firstChild.nodeType===3 ? li.firstChild.nodeValue : '')).trim();
  }
  function clearMarks(el){
    el.querySelectorAll('mark').forEach(m=>{const t=document.createTextNode(m.textContent);m.parentNode.replaceChild(t,m);});
  }
  function highlight(li,q){
    const a=li.querySelector(':scope > a'), target=a||li;
    target.childNodes.forEach(n=>{
      if(n.nodeType!==3) return;
      const t=n.nodeValue, i=t.toLowerCase().indexOf(q.toLowerCase()); if(i===-1) return;
      const span=document.createElement('span');
      span.appendChild(document.createTextNode(t.slice(0,i)));
      const mark=document.createElement('mark'); mark.textContent=t.slice(i,i+q.length);
      span.appendChild(mark); span.appendChild(document.createTextNode(t.slice(i+q.length)));
      n.parentNode.replaceChild(span,n);
    });
  }
  function filterNode(li,q){
    const title=label(li), selfMatch=q?title.toLowerCase().includes(q.toLowerCase()):true;
    const ul=li.querySelector(':scope > ul'); let anyChild=false;
    if(ul){ [...ul.children].forEach(ch=>{ const s=filterNode(ch,q); ch.classList.toggle('is-hidden',!s); anyChild=anyChild||s; }); }
    const show=q?(selfMatch||anyChild):true;
    li.classList.toggle('is-hidden',!show);
    clearMarks(li); if(q&&selfMatch) highlight(li,q);
    return show;
  }
  function filterList(ul,q){
    let total=0; if(!ul) return 0;
    [...ul.children].forEach(li=>{ const s=filterNode(li,q); if(s) total++; });
    return total;
  }
  function run(){
    const q=(input&&input.value||'').trim(); let total=0;
    lists.forEach(ul=> total+=filterList(ul,q));
    meta.textContent = q ? ("Showing " + total + " matching items") : "";
  }
  if(input) input.addEventListener('input', run, {passive:true});
})();
</script>


