<script>
(function(){
  const input = document.getElementById('sitemap-search');
  const meta  = document.getElementById('search-meta');

  const lis = document.querySelectorAll('#sitemap-root li, #supporting-sections li');

  function labelText(li){
    const a = li.querySelector(':scope > a');
    if (a) return a.textContent.trim();
    let txt = '';
    li.childNodes.forEach(n => {
      if (n.nodeType === 3) txt += n.nodeValue;
    });
    return txt.trim();
  }

  function clearHighlight(li){
    const a = li.querySelector(':scope > a');
    if (a) a.textContent = a.textContent;
    li.querySelectorAll('mark').forEach(m => {
      m.replaceWith(document.createTextNode(m.textContent));
    });
  }

  function highlight(li, q){
    const a = li.querySelector(':scope > a');
    const regex = new RegExp(`(${q})`, 'ig');
    if (a) {
      a.innerHTML = a.textContent.replace(regex, '<mark>$1</mark>');
    }
  }

  function showWithParents(li){
    li.style.display = '';
    let parent = li.parentElement;
    while (parent && parent.tagName === 'UL') {
      const pli = parent.closest('li');
      if (pli) pli.style.display = '';
      parent = pli ? pli.parentElement : null;
    }
  }

  function run(){
    const q = (input.value || '').trim().toLowerCase();
    let count = 0;

    lis.forEach(li => {
      clearHighlight(li);
      const title = labelText(li).toLowerCase();
      const match = q === '' ? true : title.includes(q);

      if (match) {
        li.style.display = '';
        if (q !== '') {
          highlight(li, q);
          count++;
        }
        if (q !== '') showWithParents(li); // ensure parents visible
      } else {
        li.style.display = q === '' ? '' : 'none';
      }
    });

    meta.textContent = q ? `Showing ${count} matching items` : '';
  }

  input.addEventListener('input', run);
})();
</script>
