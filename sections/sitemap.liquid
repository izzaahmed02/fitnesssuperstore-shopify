{{ 'section-sitemap.css' | asset_url | stylesheet_tag }}

<div class="sitemap-container page-width scroll-trigger animate--slide-in">
    <h1>{{ section.settings.heading }}</h1>
    <div class="sitemap_search_wrapper">
        <label>
            <input class="sitemap_search" type="text" placeholder="Search" oninput="filterPages()"/>
        </label>
    </div>
    <a href="/" class="sitemap_link home-link">Home</a>
    <ul class="sitemap_links" id="sitemapLinks">
        {%- paginate pages by 5000 -%}
            {% for page in pages %}
                {% unless page.metafields.custom.sitemap_hide == true %}
                    <li class="sitemap_item">
                        <a href="{{ page.url }}" class="sitemap_link">{{ page.title }}</a>
                    </li>
                {% endunless %}
            {% endfor %}
        {%- endpaginate -%}
        {%- paginate collections by 1000 -%}
            {% for collection in collections %}
                {% unless collection.metafields.custom.sitemap_hide == true %}
                    <li class="sitemap_item">
                        <a href="{{ collection.url }}" class="sitemap_link">{{ collection.title }}</a>
                    </li>
                {% endunless %}
            {% endfor %}
        {%- endpaginate -%}
    </ul>
</div>
<script src="{{ 'sitemap.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Sitemap",
  "tag": "section",
  "class": "sitemap",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ]
}
{% endschema %}