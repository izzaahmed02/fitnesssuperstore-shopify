<meta charset="utf-8">
<title>Site Map</title>
<meta name="robots" content="index,follow" />

<style>
.sitemapMain{padding:16px 12px}
.sitemapMain li{list-style:inherit!important}
.sitemapMain .root>li{list-style:disc!important}
.sitemapMain>li.mainHdg:first-child{list-style:none!important}
.sitemapMain .root>li>ul>li>ul{list-style:square!important}
.sitemapMain .root>li>ul{list-style:circle!important}
.sitemapMain .card h2{font-size:16px;font-family:Lato;line-height:normal}
.sitemapMain a{text-decoration:underline}

:root{
  --fg:#1a1a1a;
  --muted:#667085;
  --border:#e5e7eb;
  --bg:#ffffff;
  --card:#ffffff;
  --highlight:#fff3a3;
}
*{box-sizing:border-box}

.sitemapMain .muted{color:var(--muted);font-size:.9rem}
.sitemapMain .sitemap-toolbar{
  position:sticky;
  top:var(--header-height,0);
  z-index:1;
  background:var(--bg);
  padding:10px 0 14px;
  border-bottom:1px solid var(--border);
  margin-bottom:10px;
}
.sitemapMain .search-wrap{display:flex;gap:10px;align-items:center}
.sitemapMain .search-wrap input{
  flex:1;
  border:1px solid var(--border);
  border-radius:10px;
  padding:12px 14px;
  font-size:16px;
}
.sitemapMain .grid{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:22px;
  margin-top:12px;
}
@media(max-width:1080px){.grid{grid-template-columns:1fr}}
.sitemapMain .card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:12px;
  padding:16px;
}
.sitemapMain ul{margin:0 0 .6rem 2.05rem;padding:0;list-style:inherit;}
.sitemapMain li{margin:.25rem 0}
.sitemapMain .root>li>a,
.sitemapMain .root>li{font-weight:700}
.sitemapMain mark{background:var(--highlight);padding:0 .1em;border-radius:3px}
.sitemapMain .is-hidden{display:none!important}

@media(max-width:749px){
.sitemapMain .grid {
    grid-template-columns: 1fr;
}
}
</style>

<div class="sitemapMain">

  <div class="sitemap-toolbar">
    <div class="search-wrap">
      <input id="sitemap-search" type="search" placeholder="Search the sitemap..." autocomplete="off">
    </div>
    <div class="search-meta" id="search-meta"></div>
  </div>

  <div class="grid">

    <!-- LEFT: METAOBJECT SITEMAP -->
    <section class="card">
      {% assign root_menu = shop.metaobjects.sitemap_menu_1['main-sitemap-root'] %}
      {% if root_menu and root_menu.children1.value %}
      <nav>
        <ul class="root" id="sitemap-left">

          {% for item1 in root_menu.children1.value %}
          <li>
            {% if item1.link.value %}
              <a href="{{ item1.link.value.url }}">{{ item1.title.value }}</a>
            {% endif %}

            {% if item1.children1.value %}
            <ul>
              {% for item2 in item1.children1.value %}
              <li>
                {% if item2.link.value %}
                  <a href="{{ item2.link.value.url }}">{{ item2.title.value }}</a>
                {% endif %}

                {% if item2.children1.value %}
                <ul>
                  {% for item3 in item2.children1.value %}
                  <li>
                    {% if item3.link.value %}
                      <a href="{{ item3.link.value.url }}">{{ item3.title.value }}</a>
                    {% endif %}

                    {% if item3.children1.value %}
                    <ul>
                      {% for item4 in item3.children1.value %}
                      <li>
                        {% if item4.link.value %}
                          <a href="{{ item4.link.value.url }}">{{ item4.title.value }}</a>
                        {% endif %}

                        {% if item4.children1.value %}
                        <ul>
                          {% for item5 in item4.children1.value %}
                          <li>
                            {% if item5.link.value %}
                              <a href="{{ item5.link.value.url }}">{{ item5.title.value }}</a>
                            {% endif %}
                          </li>
                          {% endfor %}
                        </ul>
                        {% endif %}

                      </li>
                      {% endfor %}
                    </ul>
                    {% endif %}

                  </li>
                  {% endfor %}
                </ul>
                {% endif %}

              </li>
              {% endfor %}
            </ul>
            {% endif %}

          </li>
          {% endfor %}

        </ul>
      </nav>
      {% endif %}
    </section>

    <!-- RIGHT: MENU SITEMAP -->
    <section class="card">
      <ul class="root" id="sitemap-right">
        {% comment %}
        {% for link in linklists.sitemap-menu-2.links %}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if link.links.size > 0 %}
          <ul>
            {% for child in link.links %}
            <li>
              <a href="{{ child.url }}">{{ child.title }}</a>
              {% if child.links.size > 0 %}
              <ul>
                {% for grandchild in child.links %}
                <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
          {% endcomment %}
           {% for link in linklists.sitemap-menu-2.links %}
  {% if link.url == '/pages/blog' or link.title == 'Blog' %}
{% assign blog_handles = 'buying-guides,case-studies,comparisons,maintenance,news,warranty-shipping' | split: ',' %}

<li>
  <a href="/pages/blog">Blog</a>
  <ul>
    {% for handle in blog_handles %}
      {% assign blog = blogs[handle] %}
      {% if blog %}
      <li>
        <a href="{{ blog.url }}">{{ blog.title }}</a>
        {% if blog.articles_count > 0 %}
        <ul>
          {% for article in blog.articles limit:50 %}
          <li><a href="{{ article.url }}">{{ article.title }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endif %}
    {% endfor %}
  </ul>
</li>
  {% else %}
  <li>
    <a href="{{ link.url }}">{{ link.title }}</a>
    {% if link.links.size > 0 %}
    <ul>
      {% for child in link.links %}
      <li>
        <a href="{{ child.url }}">{{ child.title }}</a>
        {% if child.links.size > 0 %}
        <ul>
          {% for grandchild in child.links %}
          <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </li>
  {% endif %}
{% endfor %}
      </ul>
    </section>

  </div>

  <!-- CATALOG: crawlable hub + previously-orphaned collections -->
  <section class="card" id="sitemap-catalog" style="margin-top:22px;">
    <h2>Browse the Full Catalog</h2>
    <ul class="root">
      <li><a href="/collections/product-index">Product Index — View All Products</a></li>
    </ul>
    {%- assign featured_collection_handles = 'stairmaster-new,stairmaster-remanufactured,power-plate-new,power-plate-remanufactured,french-fitness-vail-series-1,french-fitness-telluride-series-1,french-fitness-wall-mounted-cable-machines,selectorized-bicep-tricep-combo,resistance-based-gym-systems' | split: ',' -%}
    <ul class="root">
      {%- for collection_handle in featured_collection_handles -%}
        {%- assign linked_collection = collections[collection_handle] -%}
        {%- if linked_collection != empty and linked_collection.products_count > 0 -%}
          <li><a href="{{ linked_collection.url }}">{{ linked_collection.title | escape }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
</div>

<script>
(function(){
  const input=document.getElementById('sitemap-search');
  const meta=document.getElementById('search-meta');
  const lists=[document.getElementById('sitemap-left'),document.getElementById('sitemap-right')];

  function label(li){
    const a=li.querySelector(':scope>a');
    return(a?a.textContent:'').trim();
  }
  function filterNode(li,q){
    const title=label(li).toLowerCase();
    const match=!q||title.includes(q);
    let childMatch=false;
    const ul=li.querySelector(':scope>ul');
    if(ul){
      [...ul.children].forEach(c=>{
        const s=filterNode(c,q);
        c.classList.toggle('is-hidden',!s);
        childMatch=childMatch||s;
      });
    }
    const show=match||childMatch;
    li.classList.toggle('is-hidden',!show);
    return show;
  }
  function run(){
    const q=input.value.trim().toLowerCase();
    let total=0;
    lists.forEach(ul=>{
      if(!ul) return;
      [...ul.children].forEach(li=>{
        if(filterNode(li,q)) total++;
      });
    });
    meta.textContent=q?`Showing ${total} results`:'';
  }
  input.addEventListener('input',run);
})();
</script>
