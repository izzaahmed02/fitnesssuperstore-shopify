{%- comment %}
  Forked from sections/HGS-explore-packages.liquid for the GymBuild PDP
  (templates/product.ab-test-asjads-pdp.json) ONLY. That original section
  is also used by templates/product.home-gym-packages.json — do not edit
  it for GymBuild-specific changes, and do not port these changes back
  into it.

  Card measurements pulled directly from Figma node 4636:216940
  (file XBaAGVhSupd0fvIcXd28qw) 2026-09-08: 300x354 card, a 240x240 square
  product image inset 30px/16px, 16px title-to-cards gap, 16px image-to-text
  gap, 12px title-to-price gap, 4px "Starting at"-to-price gap. That Figma
  card also has no description line (title + price only) — the description
  paragraph from the original section is intentionally dropped here to
  match it.
{% endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .explore-packages__title {
    font-size: 28px;
    font-weight: 700;
    color: #23232B;
    margin-bottom: 16px;
    font-family: Lato, sans-serif;
    text-transform: initial;
  }

  .explore-packages__slider-wrapper {
    position: relative;
    overflow: hidden;
  }

  .explore-packages__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    scroll-behavior: smooth;
  }

  .explore-packages__track::-webkit-scrollbar {
    display: none;
  }

  .explore-packages__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .explore-packages__card {
    flex: 0 0 300px;
    width: 300px;
    height: 354px;
    background: #EDEFF3;
    border-radius: 16px;
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
  }

  .explore-packages__card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .explore-packages__card-image-wrap {
    width: 240px;
    height: 240px;
    margin: 0 auto;
    border-radius: 10px;
    overflow: hidden;
    background: #EDEFF3;
    flex-shrink: 0;
  }

  .explore-packages__card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .explore-packages__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #fff;
    border-radius: 100px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #D83D0E;
    font-family: Lato, sans-serif;
    margin-bottom: 8px;
    width: fit-content;
  }

  .explore-packages__card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 16px 0;
  }

  .explore-packages__card-title {
    font-size: 16px;
    font-weight: 700;
    color: #23232B;
    font-family: Lato, sans-serif;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .explore-packages__card-price-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .explore-packages__card-price-label {
    font-size: 14px;
    font-weight: 600;
    color: #23232B;
    font-family: Lato, sans-serif;
  }

  .explore-packages__card-price {
    font-size: 18px;
    font-weight: 700;
    color: #D83D0E;
    font-family: Lato, sans-serif;
  }

  /* Gradient overlay on last visible card edge */
  .explore-packages__gradient {
    position: absolute;
    top: 0;
    right: 0;
    width: 220px;
    height: 100%;
    background: linear-gradient(to right, transparent, #ffffff);
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .explore-packages__gradient.is-hidden {
    opacity: 0;
  }

  /* Arrows */
  .explore-packages__arrows {
    display: flex;
    gap: 8px;
    justify-content: space-between;
    position: absolute;
    top: 60%;
    left: 15px;
    right: 15px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 3;
  }

  .explore-packages__arrow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #616166;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, opacity 0.2s ease;
    opacity: 1;
    pointer-events: all;
  }

  .explore-packages__arrow.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .explore-packages__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 749px) {
    .explore-packages__card {
      flex: 0 0 240px;
      width: 240px;
      height: 300px;
    }

    .explore-packages__card-image-wrap {
      width: 200px;
      height: 200px;
    }

    .explore-packages__gradient {
      width: 120px;
    }

     .explore-packages__title {
      font-size: 20px;
      line-height: 26px;
      margin-bottom: 16px;
  }
  }
{%- endstyle -%}

<div class="page-width" style="position: relative;">
  {% if section.settings.title != blank %}
    <h2 class="explore-packages__title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="explore-packages__slider-wrapper">
    <div class="explore-packages__track" id="explore-track-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign prod = block.settings.product %}
        {% if prod != blank and prod.handle != product.handle %}
          <a href="{{ prod.url }}" class="explore-packages__card" {{ block.shopify_attributes }}>
            <div class="explore-packages__card-image-wrap">
              {% if prod.available == false %}
                <div class="explore-packages__badge">
                  {{ 'products.product.sold_out' | t }}
                </div>
              {% elsif prod.metafields.custom.condition_state != blank %}
                <div class="explore-packages__badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  {{ prod.metafields.custom.condition_state }}
                </div>
              {% endif %}
              {% if prod.featured_image %}
                {{ prod.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: prod.title }}
              {% endif %}
            </div>
            <div class="explore-packages__card-body">
              <div class="explore-packages__card-title">{{ prod.title }}</div>
              <div class="explore-packages__card-price-row">
                <span class="explore-packages__card-price-label">Starting at</span>
                <span class="explore-packages__card-price">{{ prod.price | money }}</span>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="explore-packages__gradient" id="explore-gradient-{{ section.id }}"></div>
  </div>

  <div class="explore-packages__arrows">
    <button class="explore-packages__arrow is-hidden" id="explore-prev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="explore-packages__arrow" id="explore-next-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
  </div>
</div>

<script>
  (function () {
    const track = document.getElementById('explore-track-{{ section.id }}');
    const prevBtn = document.getElementById('explore-prev-{{ section.id }}');
    const nextBtn = document.getElementById('explore-next-{{ section.id }}');
    const gradient = document.getElementById('explore-gradient-{{ section.id }}');

    if (!track) return;

    const cardWidth = track.querySelector('.explore-packages__card')?.offsetWidth + 16 || 316;

    function updateControls() {
      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;

      prevBtn.classList.toggle('is-hidden', scrollLeft <= 10);
      nextBtn.classList.toggle('is-hidden', scrollLeft >= maxScroll - 10);
      gradient.classList.toggle('is-hidden', scrollLeft >= maxScroll - 10);
    }

    prevBtn.addEventListener('click', function () {
      track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', function () {
      track.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });

    track.addEventListener('scroll', updateControls, { passive: true });
    updateControls();

    // Drag to scroll
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;

    track.addEventListener('mousedown', function (e) {
      isDown = true;
      track.classList.add('is-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollStart = track.scrollLeft;
    });

    track.addEventListener('mouseleave', function () {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mouseup', function () {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollStart - walk;
    });

    // Touch swipe
    let touchStartX = 0;
    let touchScrollStart = 0;

    track.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].pageX;
      touchScrollStart = track.scrollLeft;
    }, { passive: true });

    track.addEventListener('touchmove', function (e) {
      const dx = touchStartX - e.touches[0].pageX;
      track.scrollLeft = touchScrollStart + dx;
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "GymBuild Explore Packages",
  "tag": "section",
  "class": "section explore-packages",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Explore Other Home Gym Packages"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GymBuild Explore Packages",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
