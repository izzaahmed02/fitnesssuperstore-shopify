{% comment %}
Simple "State Installation Image" section
Displays a single banner image with alt text from theme settings
{% endcomment %}

<div class="page-width">
  {%- assign banner_image = section.settings.banner_image -%}
  {%- assign banner_alt = section.settings.banner_image_alt -%}

  {%- if banner_image != blank -%}
    <img
      src="{{ banner_image | image_url: width: 3840 }}"
      alt="{{ banner_alt }}"
      width="3840"
      loading="lazy"
      sizes="100vw"
    >
  {%- else -%}
    <div class="banner-placeholder" style="width:100%; height:300px; background:#eee;"></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "State Installation Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_image_alt",
      "label": "Banner Image Alt Text",
      "default": "State Installation Banner"
    }
  ],
  "presets": [
    {
      "name": "State Installation Image"
    }
  ]
}
{% endschema %}
