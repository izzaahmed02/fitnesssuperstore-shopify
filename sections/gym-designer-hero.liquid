
<style>
.gym-designer-hero-section {
  padding: 0;
  margin: 0;
  background-color: #ffffff;
}

.gym-designer-hero-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: stretch;
  margin: 0;
  padding: 0 20px;
}

.gym-designer-hero-visual {
  padding: 0;
  margin: 0;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  max-height: 700px;
}

.gym-designer-hero-content {
  padding-right: 60px;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  margin: 23px 50px 0 0;
}

.gym-designer-hero-title {
  font-size: 4.5rem;
  line-height: 0.95;
  font-weight: 900;
  text-transform: uppercase;
  color: #000000;
  font-family: Lato, sans-serif;
  margin: 0 0 25px;
  letter-spacing: 0.1px;
}

.gym-designer-hero-description {
  color: #333333;
  font-family: Lato, sans-serif;
}

.gym-designer-hero-description p {
  margin-bottom: 32px;
}

.gym-designer-hero-description p:last-child {
  margin-bottom: 0;
}

@media screen and (max-width: 989px) {
  .gym-designer-hero-container {
    grid-template-columns: 1fr;
    min-height: auto;
    gap: 40px
  }

  .gym-designer-hero-visual {
    height: 50vh;
    min-height: 400px;
    order: 2;
  }

  .gym-designer-hero-content {
    padding: 80px 60px;
    order: 1;
  }

  .gym-designer-hero-title {
    font-size: 4rem;
    margin-bottom: 60px;
  }

}

@media screen and (max-width: 749px) {
  .gym-designer-hero-visual {
    height: 40vh;
    min-height: 300px;
    order: 2;
  }

  .gym-designer-hero-content {
    padding: 0;
    order: 1;
  }

  .gym-designer-hero-title {
    font-size: 3rem;
    margin-bottom: 40px;
  }

  .hero-image{
    padding-bottom: 2rem !important;
  }
}
</style>

<div class="gym-designer-hero-section">
  <div class="gym-designer-hero-container">
    <div class="gym-designer-hero-visual">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2000 | image_tag:
          loading: 'lazy',
          class: 'hero-image',
          alt: section.settings.hero_image.alt | escape
        }}
      {% else %}
        <img src="https://cdn.prod.website-files.com/63ea37f826113a5029824f10/63ea39a879a9cc6841a26a22_614394142acfa2588b6a32af_A_to_z_Bannerimage.jpeg?w=1200&h=800&fit=crop" alt="Gym Designer Interface" class="hero-image">
      {% endif %}
    </div>
    
    <div class="gym-designer-hero-content">
      <h1 class="gym-designer-hero-title">{{ section.settings.title | escape }}</h1>
      <div class="gym-designer-hero-description">
        <p>{{ section.settings.description_1 | escape }}</p>
        <p>{{ section.settings.description_2 | escape }}</p>
        <p>{{ section.settings.description_3 | escape }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gym Designer Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "BUILD YOUR UNIQUE TRAINING SPACE"
    },
    {
      "type": "textarea",
      "id": "description_1",
      "label": "Description Paragraph 1",
      "default": "Many of you have a space and know what you want. Others are still trying to work it out. That's why we have Gym Designer. It allows you to plan out a space quickly and easily. No more mucking around with complex architectural plans or thumbnail sketches."
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Description Paragraph 2",
      "default": "Instead, just dial in the size and shape of your space and start dropping equipment into it. Export high quality 3D image renders for showcasing and reference."
    },
    {
      "type": "textarea",
      "id": "description_3",
      "label": "Description Paragraph 3",
      "default": "No more guessing what your dream facility will look like. Receive a prompt follow up with our team regarding how we can help you make your idea a reality, obligation-free"
    }
  ],
  "presets": [
    {
      "name": "Gym Designer Hero"
    }
  ]
}
{% endschema %}
