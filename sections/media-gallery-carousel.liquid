{% assign images = product.metafields.custom.carousel_gallery.value %}
{% capture has_images %}false{% endcapture %}
{% for image in images %}
    {% capture has_images %}true{% endcapture %}
    {% break %}
{% endfor %}
    
{% if has_images == 'true' %}
  {{ 'media-gallery-carousel.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.5);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.5);
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  <section class="media-gallery-carousel media-gallery-carousel--{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {% if section.settings.heading != blank %}
        <div class="media-gallery-carousel__header">
            <h4 class="media-gallery-carousel__title h2">
            {{ section.settings.heading }}
            </h4>
        </div>
      {% endif %}

      <div class="media-gallery-carousel__wrapper">
        <div class="media-gallery-carousel__list js-media-gallery-carousel">
          {% for image in images %}
            <div class="media-gallery-carousel__item">
              <div class="media-gallery-carousel__image-wrapper">
                {{  
                  image
                  | image_url: width: 1000
                  | image_tag: class: 'media-gallery-carousel__image', loading: 'lazy', alt: product.title
                }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <script src="{{ 'media-gallery-carousel.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Media Gallery Carousel",
  "tag": "section",
  "class": "media-gallery-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.media-gallery-carousel.settings.heading.label",
      "default": "See how it looks in the gym"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.media-gallery-carousel.settings.color_scheme.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Media Gallery Carousel"
    }
  ]
}
{% endschema %}
