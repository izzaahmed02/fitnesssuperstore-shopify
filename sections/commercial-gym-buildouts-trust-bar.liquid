{%- style -%}
    #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
    }

    #shopify-section-{{ section.id }} .trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .trust-bar__icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    }

    #shopify-section-{{ section.id }} .trust-bar__icon svg {
    width: 100%;
    height: 100%;
    }

    #shopify-section-{{ section.id }} .trust-bar__text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: 'Lato', sans-serif;
    font-size: 1.6rem;
    text-align: center;
    }

    @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .trust-bar {
    flex-direction: column;
    gap: 0.4rem;
    text-align: center;
    }
    }
{%- endstyle -%}

<div class="trust-bar">
    <span class="trust-bar__icon">{% render 'icon-checkmark' %}</span>
    {%- if section.settings.text != blank -%}
        <p class="trust-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "Commercial Gym Buildouts Trust Bar",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#34343c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#d83d0e"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Reviewed by a Fitness Superstore gym specialist. Your details are used to prepare this quote."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Commercial Gym Buildouts Trust Bar"
    }
  ]
}
{% endschema %}
