{%- style -%}
    #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg }};
    }

    /* Figma node 4612:86188 (mobile) — row layout, icon top-aligned, text left-aligned (wraps to 3 lines) */
    #shopify-section-{{ section.id }} .trust-bar {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 8px;
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    }

    /* Figma node 4585:80435 (desktop) — single line, centered */
    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .trust-bar {
    align-items: center;
    justify-content: center;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    }
    }

    #shopify-section-{{ section.id }} .trust-bar__icon {
    flex: none;
    width: 24px;
    height: 24px;
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    }

    #shopify-section-{{ section.id }} .trust-bar__icon svg {
    width: 100%;
    height: 100%;
    }

    /* Figma node 4585:80438 — Lato Regular 16px/24px */
    #shopify-section-{{ section.id }} .trust-bar__text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    text-align: left;
    }

    @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .trust-bar__text {
    text-align: center;
    }
    }
{%- endstyle -%}

<div class="trust-bar">
    <span class="trust-bar__icon">{% render 'icon-checkmark' %}</span>
    {%- if section.settings.text != blank -%}
        <p class="trust-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "CGB Trust Bar",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#34343c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#f1592a"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Reviewed by a Fitness Superstore gym specialist. Your details are used to prepare this quote."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "CGB Trust Bar"
    }
  ]
}
{% endschema %}
