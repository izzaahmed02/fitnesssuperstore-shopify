{{ 'section-numbered-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% for block in section.blocks %}
  {% liquid
    assign heading = block.settings.heading
    assign number = block.settings.number
    assign items = block.settings.text | split: '</p>'
  %}
  <div class="numbered-list section-{{ section.id }}">
    <h3 class="numbered-list__heading">{{ number }}. {{ heading }}</h3>
    <ul class="numbered-list__list">
      {% for item in items %}
        {% assign text = item | replace: '<p>', '' %}
        {% if text != blank %}
          <li class="numbered-list__list-item">
            <div class="numbered-list__list-item-content">
              <div class="numbered-list__list-item-container">
                <span class="numbered-list__list-item-counter"> {{ number }}.{{ forloop.index }}. </span>
                <div>{{ text }}</div>
              </div>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endfor %}

{% schema %}
{
  "name": "Terms and conditions",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Number of section"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Terms and conditions"
    }
  ]
}
{% endschema %}
