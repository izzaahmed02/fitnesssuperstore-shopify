{% comment %}
  Desktop Homepage A/B Test (Variant B) — Module 5, per spec §4.
  DRAFT / NOT LAUNCHED. Not wired into any template; templates/index.json is
  frozen until S4.

  Sourcing: six per-block product pickers, following the
  sections/homepage-popular-fitness.liquid pattern. Deliberately NOT a
  collection loop — this module has no dependency on the "most-popular"
  collection, which spec §7 records as holding three usable products against a
  six-product module. Blocks ship empty because product settings cannot carry
  schema defaults and the six-product selection is Carlos and Larianne's to
  make (gate G0-j).

  Self-contained per spec R3: own scoped CSS, no shared stylesheet import.
  Does not reference assets/homepage-section-hero.css or
  assets/fss-hp-device-targeting.css (spec R2), and does not load
  assets/fss-hp-analytics.js — the helper stays on the mobile branch until S2
  and desktop inherits it at S4 (spec §8). The data-fss-hp-* attributes on each
  card are therefore inert during S1; that is expected.

  The .condition-tag / .condition-tag.blue class names match the theme's
  existing card treatment (snippets/product-item.liquid:24-33). Their visual
  rules are reproduced below rather than imported, because every existing
  definition is scoped to a foreign ancestor (.popular-eqpt, .collnGrid,
  .home-products) and would not apply here. Values are copied from
  assets/homepage-popular-fitness.css:188-206 and :248-251.
{% endcomment %}

<section class="fssd-top-sellers" aria-labelledby="fssd-top-sellers-heading-{{ section.id }}">
  <div class="fssd-top-sellers__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fssd-top-sellers__heading" id="fssd-top-sellers-heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="fssd-top-sellers__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <ul class="fssd-top-sellers__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' and block.settings.product != blank -%}
          <li class="fssd-top-sellers__item" {{ block.shopify_attributes }}>
            {%- render 'fssd-top-seller-card',
              product: block.settings.product,
              slot: forloop.index,
              cta_label: block.settings.cta_label
            -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .fssd-top-sellers {
    --fssd-ts-accent: #d83d0e;
    --fssd-ts-reman: #3e77aa;
    --fssd-ts-neutral: #616166;
    --fssd-ts-border: #e5e5e5;
    padding: 40px 0;
  }
  .fssd-top-sellers__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .fssd-top-sellers__heading {
    margin: 0 0 32px;
    font-size: 38px;
    line-height: 50px;
  }
  .fssd-top-sellers__subheading {
    max-width: 72ch;
    margin: 0 0 24px;
    color: var(--fssd-ts-neutral);
    font-size: 16px;
    line-height: 26px;
  }
  .fssd-top-sellers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fssd-top-sellers__item {
    display: flex;
  }
  .fssd-top-sellers__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--fssd-ts-border);
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0px 0px 12px 0px #0000001A;
    transition: box-shadow 0.3s ease;
  }
  .fssd-top-sellers__card:hover {
    border-color: var(--fssd-ts-accent);
  }
  .fssd-top-sellers__card:focus-visible {
    outline: 3px solid var(--fssd-ts-accent);
    outline-offset: 2px;
  }
  .fssd-top-sellers__media {
    position: relative;
    display: block;
    flex: 0 0 auto;
    aspect-ratio: 1 / 1;
    background: #f4f4f5;
  }
  /* Absolutely positioned so the image cannot participate in sizing the panel.
     With height: 100% in flow, the img resolved against the panel's height while
     the panel (flex-basis: auto) sized to the img — a circular dependency the
     browser broke by falling back to the image's intrinsic ratio, so each panel
     took its own product's shape. Out of flow, aspect-ratio: 1/1 governs.
     object-fit: contain retained: letterboxing inside a fixed square is correct
     for product shots with very different intrinsic ratios. */
  .fssd-top-sellers__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .fssd-top-sellers__tags {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .fssd-top-sellers .condition-tag {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: auto;
    height: 28px;
    padding: 4px 12px;
    background: #ffffff;
    border: 1px solid var(--fssd-ts-accent);
    border-radius: 99px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: var(--fssd-ts-accent);
  }
  .fssd-top-sellers .condition-tag.blue {
    border-color: var(--fssd-ts-reman);
    color: var(--fssd-ts-reman);
  }
  .fssd-top-sellers .condition-tag.neutral {
    border-color: var(--fssd-ts-neutral);
    color: var(--fssd-ts-neutral);
  }
  .fssd-top-sellers .condition-tag svg {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }
  /* Decorative icon wrappers (aria-hidden) sit between the pill's flex
     container and the icon. inline-flex keeps the svg a flex item so the
     16px sizing above still applies; flex: 0 0 auto stops the wrapper
     shrinking. No margin or padding, so the pill's 28px height, 4px 12px
     padding and 4px gap are unchanged. */
  .fssd-top-sellers .fssd-top-seller-card__condition-icon,
  .fssd-top-sellers .fssd-top-seller-card__pill-icon {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }
  .fssd-top-sellers__sale-tag {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 4px 12px;
    background: #ffffff;
    border: 1px solid #f52419;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: #f52419;
  }
  .fssd-top-sellers__soldout {
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    background: #ffffff;
    border: 1px solid var(--fssd-ts-neutral);
    border-radius: 99px;
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
    color: var(--fssd-ts-neutral);
  }
  .fssd-top-sellers__soldout svg {
    width: 16px;
    height: 16px;
  }
  .fssd-top-sellers__info {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 8px;
    padding: 16px;
  }
  .fssd-top-sellers__title {
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 600;
    line-height: 21px;
  }
  .fssd-top-sellers__prices {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .fssd-top-sellers__price {
    font-size: 17px;
    font-weight: 700;
    line-height: 22px;
  }
  .fssd-top-sellers__retail {
    color: var(--fssd-ts-neutral);
    font-size: 14px;
    line-height: 20px;
    text-decoration: line-through;
  }
  .fssd-top-sellers__cta {
    font-size: 14px;
    line-height: 20px;
    font-weight: 700;
    color: var(--fssd-ts-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media screen and (max-width: 989px) {
    .fssd-top-sellers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .fssd-top-sellers__inner {
      padding: 0 16px;
    }
    .fssd-top-sellers__heading {
      font-size: 20px;
      line-height: 26px;
    }
    .fssd-top-sellers__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Desktop Top Sellers",
  "class": "fssd-top-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Top Sellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Featured equipment."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Selection pending Carlos / Larianne approval (gate G0-j). Confirm the product has a condition_state metafield value — a blank value renders no condition badge."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA Label",
          "default": "View Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop Top Sellers",
      "category": "Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
