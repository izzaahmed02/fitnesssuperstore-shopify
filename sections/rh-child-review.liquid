{% comment %}
  Isolated alternate-view preview. Two 27-product lists avoid a 50-item loop cap.
  Does not modify Boost, native indexes, collections, product metadata or feeds.
{% endcomment %}
<section id="rh-review-{{ section.id }}" class="rh-review" data-rh-review data-expected-count="54">
  <div class="rh-review__notice"><strong>Unpublished child-card preview.</strong> Live product data; production search/index settings and collection membership are unchanged. This local filter is not a Boost acceptance test.</div>
  <h1>Rubber Hex dumbbells — choose your weight or set</h1>
  <p>Each card opens its own product and real variant. Singles, dumbbell-only sets, and rack/bench packages remain distinct.</p>
  <label for="rh-query-{{ section.id }}">Filter these products by name, weight, or exact SKU</label>
  <input id="rh-query-{{ section.id }}" type="search" data-rh-query placeholder="For example: 5-50 or FF-RCHD5-50-R" autocomplete="off">
  <p data-rh-count role="status" aria-live="polite"></p>
  <p data-rh-warning role="alert" hidden></p>
  <ul class="rh-review__grid" role="list">
    {% for child_product in section.settings.children_a %}{% render 'rh-child-card', child_product: child_product %}{% endfor %}
    {% for child_product in section.settings.children_b %}{% render 'rh-child-card', child_product: child_product %}{% endfor %}
  </ul>
  <p data-rh-empty hidden>No matching product in this 54-child preview. Clear the filter to view the complete family.</p>
  <noscript><p>JavaScript is off. The complete product-card grid remains available; local filtering is disabled.</p></noscript>
</section>
<style>
.rh-review{max-width:1320px;margin:32px auto;padding:0 20px;color:#171717}.rh-review__notice{background:#fff6df;border:1px solid #ebce87;padding:14px 18px;margin-bottom:22px;line-height:1.5}.rh-review h1{font-size:clamp(24px,3vw,36px);line-height:1.2;margin:0 0 12px}.rh-review>label{display:block;font-weight:600;margin:24px 0 8px}.rh-review input{width:100%;max-width:620px;border:1px solid #aaa;border-radius:5px;padding:12px;font:inherit}.rh-review__grid{list-style:none;padding:0;margin:20px 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 20px}.rh-child-card{min-width:0;display:flex;flex-direction:column}.rh-child-card[hidden]{display:none!important}.rh-child-card__image{position:relative;aspect-ratio:1;background:#f5f5f5;border-radius:14px;display:flex;align-items:center;justify-content:center;overflow:hidden}.rh-child-card__image img{width:100%;height:100%;object-fit:contain;padding:12px}.rh-child-card__condition{position:absolute;top:10px;left:10px;padding:4px 12px;border:1px solid #d63d00;border-radius:20px;background:white;color:#b93200;font-size:13px}.rh-child-card__ship{font-size:14px;line-height:1.4;color:#008147;margin:12px 0 8px}.rh-child-card__title{font-size:19px;line-height:1.35;margin:0 0 8px}.rh-child-card__title a{color:inherit;text-decoration:none}.rh-child-card__sku{font-size:13px;line-height:1.5;margin:0 0 10px;color:#505050;overflow-wrap:anywhere}.rh-child-card__price{font-size:25px;line-height:1.2;color:#c73900;font-weight:700;margin:auto 0 8px}.rh-child-card__reviews{font-size:14px;margin:0 0 12px}.rh-child-card__reviews span{color:#a06e00;font-size:20px}.rh-child-card__unavailable{font-size:14px;color:#8a2020}.rh-child-card__link{font-size:14px;color:#222;text-underline-offset:3px}.rh-review [data-rh-warning]{padding:12px;background:#fff0ec;border:1px solid #b84a33}.rh-review a:focus-visible,.rh-review input:focus-visible{outline:3px solid #005fab;outline-offset:4px}@media(max-width:989px){.rh-review__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:749px){.rh-review{padding:0 14px}.rh-review__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 14px}.rh-child-card__title{font-size:16px}.rh-child-card__price{font-size:21px}.rh-child-card__ship{font-size:12px}.rh-child-card__sku{font-size:12px}}
</style>
<script src="{{ 'rh-child-review.js' | asset_url }}" defer></script>
{% schema %}
{
  "name":"Rubber Hex child review",
  "tag":"div",
  "settings":[
    {"type":"paragraph","content":"Preview only. Select the exact 54 approved real children in two groups of 27. Never add either parent, legacy duplicate, test/helper product, or unrelated family."},
    {"type":"product_list","id":"children_a","label":"Approved children 1–27","limit":27},
    {"type":"product_list","id":"children_b","label":"Approved children 28–54","limit":27}
  ],
  "enabled_on":{"templates":["search","collection"]}
}
{% endschema %}
