    <style>
        .childlinks_container {
            position: absolute;
            top: 120%;
            left: -100%;
            min-width: 200px;
            box-shadow: 0px 12px 30px 0px #35353529;
            border-radius: 12px;
            padding: 16px;
            z-index: 1;
        }

        .parent .childlinks_container a {
            padding: 4px 8px;
            font-size: 16px;
            text-decoration: none;
        }

        .childlinks_container a:hover {
            color: var(--primary-orange);
        }

        .childlinks_container.active {
            opacity: 1;
            transform: translateY(0);
            visibility: visible;
            pointer-events: auto;
        }
    </style>
    <script>
		document.addEventListener('DOMContentLoaded', () => {
			const parents = document.querySelectorAll('.parent');
			parents.forEach((parent) => {
				const childLinksContainer = parent.querySelector('.childlinks_container');
				if (childLinksContainer) {
					let timeout;
					parent.addEventListener('mouseenter', () => {
						clearTimeout(timeout);
						childLinksContainer.classList.add('active');
					});

					parent.addEventListener('mouseleave', () => {
						timeout = setTimeout(() => {
							childLinksContainer.classList.remove('active');
						}, 200);
					});
				}
			});
		});
    </script>
