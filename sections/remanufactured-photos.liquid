<link rel="stylesheet" href="{{ 'section-remanufactured-photos.css' | asset_url }}">

<section class="remanufactured-photos-section">
    <div class="container">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-description">{{ section.settings.description }}</p>
      <div class="photo-container">
        <img width="1280" height="600"
          src="{{ section.settings.image | image_url }}" 
          alt="Remanufactured Photos" 
          class="photo" 
        />
      </div>
    </div>
  </section>

  {% schema %}
  {
    "name": "Remanufactured Photos",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Remanufactured Photos"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Preview some of the remanufactured machines that we have done"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "default": ""
      }
    ],
    "presets": [
      {
        "name": "Remanufactured Photos",
      }
    ]
  }
  {% endschema %}
  