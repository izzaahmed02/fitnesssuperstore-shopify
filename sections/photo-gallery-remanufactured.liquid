{% if section.blocks.size > 0 %}
<section id="customer-photo-gallery-{{ section.id }}" class="customer-photo-gallery">
  <div class="customer-photo-gallery__header">
    <h2 class="contact__heading">Inside Our Remanufacturing Process</h2>
  </div>

  <div class="gallery-slick-wrapper-{{ section.id }}">
    <div class="slick-carousel-gallery-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% assign thumb = block.settings.image | image_url: width: 900 %}
          {% assign full  = block.settings.image | image_url: width: 2400 %}
          <div class="customer-photo-gallery__slide" {{ block.shopify_attributes }}>
            <img
              src="{{ thumb }}"
              data-full="{{ full }}"
              alt="Customer photo {{ forloop.index }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Lightbox -->
  <div class="customer-photo-gallery__lightbox" aria-hidden="true">
    <div class="customer-photo-gallery__lightbox-inner">
      <button type="button" class="customer-photo-gallery__lightbox-close" aria-label="Close">&times;</button>
      <img src="" alt="Expanded customer photo">
    </div>
  </div>
</section>
{% endif %}

<style>
  #customer-photo-gallery-{{ section.id }} {
    margin: 40px 0;
    position: relative;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__header {
    margin-bottom: 24px;
    padding: 0 16px;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__slide img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
    cursor: pointer;
    transition: transform .2s ease;
    display: block;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__slide img:hover {
    transform: scale(1.03);
  }

  /* ── Wrapper gives padding so arrows have room ── */
  .gallery-slick-wrapper-{{ section.id }} {
    position: relative;
    padding: 0 36px;
  }

  /* ── Slick list clip ── */
  .slick-carousel-gallery-{{ section.id }} .slick-list {
    overflow: hidden;
    margin: 0 -8px;
  }

  /* ── Slide spacing ── */
  .slick-carousel-gallery-{{ section.id }} .slick-slide {
    margin: 0 8px;
  }

  /* ── Arrows ── */
  .gallery-slick-wrapper-{{ section.id }} .slick-prev,
  .gallery-slick-wrapper-{{ section.id }} .slick-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #616166;
    cursor: pointer;
    z-index: 10;
    display: flex !important;
    align-items: center;
    justify-content: center;
    font-size: 0;
    line-height: 0;
    padding: 0;
    color: transparent;
    outline: none;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-prev {
    left: 0;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-next {
    right: 0;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-prev:hover,
  .gallery-slick-wrapper-{{ section.id }} .slick-next:hover,
  .gallery-slick-wrapper-{{ section.id }} .slick-prev:focus,
  .gallery-slick-wrapper-{{ section.id }} .slick-next:focus {
    background: #616166;
    outline: none !important;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-next:before {
    content: '' !important;
    background-image: url('{{ 'arrow-left.svg' | asset_url }}') !important;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-prev:before {
    content: '' !important;
    background-image: url('{{ 'arrow-right.svg' | asset_url }}') !important;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  /* ── Dots ── */
  .slick-carousel-gallery-{{ section.id }}.slick-dotted.slick-slider {
    margin-bottom: 70px;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-dots {
    display: block !important;
    bottom: -50px !important;
    position: absolute;
    width: 100%;
    left: 0;
    text-align: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-dots li {
    display: inline-block;
    width: auto;
    height: auto;
    margin: 0 3px;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-dots li button {
    width: 12px !important;
    height: 12px !important;
    padding: 0 !important;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-dots li button:before {
    font-size: 0 !important;
    line-height: 12px !important;
    width: 12px !important;
    height: 12px !important;
    content: '' !important;
    display: block !important;
    background-color: #ccc !important;
    border-radius: 50% !important;
  }

  .gallery-slick-wrapper-{{ section.id }} .slick-dots li.slick-active button:before {
    background-color: #23232B !important;
  }

  /* ── Lightbox ── */
  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: .2s ease;
    z-index: 9999;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__lightbox-inner {
    max-width: 700px;
    width: 90%;
    position: relative;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__lightbox-inner img {
    max-width: 100%;
    display: block;
    border-radius: 12px;
  }

  #customer-photo-gallery-{{ section.id }} .customer-photo-gallery__lightbox-close {
    position: absolute;
    top: -44px;
    right: 0;
    font-size: 28px;
    background: #616166;
    cursor: pointer;
    height: 48px;
    width: 48px;
    border-radius: 34px;
    display: flex;
    font-weight: 100 !important;
    color: white;
    align-items: center;
    justify-content: center;
    border: none;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .gallery-slick-wrapper-{{ section.id }} {
      padding: 0 16px;
    }

    .gallery-slick-wrapper-{{ section.id }} .slick-prev,
    .gallery-slick-wrapper-{{ section.id }} .slick-next {
      width: 36px;
      height: 36px;
      top: auto;
      bottom: -48px;
      transform: none;
    }

    .gallery-slick-wrapper-{{ section.id }} .slick-prev {
      left: auto;
      right: 44px;
    }

    .gallery-slick-wrapper-{{ section.id }} .slick-next {
      right: 0;
    }

    .slick-carousel-gallery-{{ section.id }}.slick-dotted.slick-slider {
      padding-bottom: 24px !important;
      margin-bottom: 64px;
    }

    .gallery-slick-wrapper-{{ section.id }} .slick-dots {
      bottom: -10px !important;
    }
  }
</style>

<script>
(function () {
  var sectionEl = document.getElementById('customer-photo-gallery-{{ section.id }}');
  if (!sectionEl) return;

  var $slider = $('.slick-carousel-gallery-{{ section.id }}');

  $slider.slick({
    slidesToShow: 4,
    slidesToScroll: 1,
    arrows: true,
    dots: true,
    cssEase: 'linear',
    appendArrows: $('.gallery-slick-wrapper-{{ section.id }}'),
    responsive: [
      {
        breakpoint: 990,
        settings: { slidesToShow: 2 }
      },
      {
        breakpoint: 480,
        settings: { slidesToShow: 1 }
      }
    ]
  });

  // ── Lightbox ──
  var lightbox = sectionEl.querySelector('.customer-photo-gallery__lightbox');
  var lightboxImg = lightbox.querySelector('img');
  var closeBtn = lightbox.querySelector('.customer-photo-gallery__lightbox-close');

  sectionEl.querySelectorAll('.customer-photo-gallery__slide img').forEach(function (img) {
    img.addEventListener('click', function () {
      lightboxImg.src = img.dataset.full || img.src;
      lightbox.classList.add('customer-photo-gallery__lightbox--active');
    });
  });

  closeBtn.addEventListener('click', function () {
    lightbox.classList.remove('customer-photo-gallery__lightbox--active');
  });

  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) {
      lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      lightbox.classList.remove('customer-photo-gallery__lightbox--active');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Gallery Remanufactured",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Remanufactured",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}