{{ 'extra-info.css' | asset_url | stylesheet_tag: preload: false }}


{%- style -%}
  .main-container {
    max-width: 1920px;
    padding-left: 80px;
  }
  .product__extra_info {
    overflow: hidden;
  }
  .product__extra_info a {
    color: var(--primary-orange-500, #D83D0E) !important;
  }
  #shopify-section-{{ section.id }} .product__extra_info {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 750px) {
    #shopify-section-{{ section.id }} .product__extra_info {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

{% assign extra = product.metafields.custom.extra_info.value %}
{% assign addMoreSections = product.metafields.custom.add_more_sections.value %}
{% assign attachments_metafield = product.metafields.custom.attachments_and_add_ons.value %}
{% assign otherRigRackSystems = product.metafields.custom.recommended_products.value %}

<div class="product__extra_info">
  
    <div class="product__extra_info-wrap">
    {% if product.metafields.custom.gym_package_inclusions and product.metafields.custom.gym_package_inclusions.value != blank%}
          <h2 class="product__extra_info-title">Package Inclusions</h2>
        {% for package in product.metafields.custom.gym_package_inclusions.value %}
          <div class="package-group">
            <h5 class="product__extra_info-title">{{ package.display_name }}</h5>

            {% if package.inclusions %}
              <ul>
                {% for inclusion in package.inclusions.value %}
                  <li>
                      <strong>{{ inclusion.quantity }} - <a href="{{ inclusion.product.value.url }}">
                        {% if inclusion.display_name != blank %}
                            {{ inclusion.display_name }}
                          {% else %}
                            {{  inclusion.product.value.title }}
                        {% endif %}
                      </a></strong>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'description' %}
            {% if product.content != blank %}
              <div class="extra-info-width">
                <h2 class="product__extra_info-title description-heading">Description</h2>
     {% assign videos = product.media | where: "media_type", "video" %}
{% if videos.size > 0 %}
  <div class="product-videos-wrapper">
    {% for video in videos %}
      <div class="product-video-item">
        <a href="#" class="product-video-trigger" data-video-id="video-{{ video.id }}">
          {% if video.preview_image %}
            {% capture video_thumbnail_alt %}{{ product.title }} video preview {{ forloop.index }}{% endcapture %}
            <div class="product-video-thumbnail-wrapper">
              {{
                video.preview_image
                | image_url: width: 800
                | image_tag:
                  alt: video_thumbnail_alt,
                  class: 'product-video-thumbnail',
                  widths: '320, 480, 640, 800',
                  sizes: '(min-width: 990px) 532px, 100vw',
                  loading: 'lazy'
              }}
              <span class="product-video-play-icon">▶</span>
            </div>
          {% else %}
            <div class="video-placeholder">
              ▶ Play Video {{ forloop.index }}
            </div>
          {% endif %}
        </a>
      </div>
 
      <!-- Modal -->
      <div id="video-{{ video.id }}" class="product-video-modal">
        <div class="product-video-modal-content">
          <span class="product-video-close">&times;</span>
          <button
            type="button"
            class="product-video-modal-poster"
            aria-label="Play {{ product.title }} video {{ forloop.index }}"
          >
            {% if video.preview_image %}
              <img
                src="{{ video.preview_image | img_url: '1200x' }}"
                alt="{{ product.title }} video preview {{ forloop.index }}"
                class="product-video-modal-poster-image"
              >
            {% endif %}
            <span class="product-video-modal-play-icon">▶</span>
          </button>
          <video controls playsinline preload="none" poster="{{ video.preview_image | image_url: width: 1200 }}" style="width:100%; border-radius:12px; display:none;">
            {% for source in video.sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          </video>
        </div>
      </div>
    {% endfor %}
  </div>

  <style>
  .product-videos-wrapper {
  display: flex;
  flex-direction: column; /* stack vertically */
  gap: 16px;
  margin-bottom: 20px;
}

.product-video-item {
  width: 100%; /* full width */
}

.product-video-thumbnail-wrapper {
  position: relative;
  width: 100%;
}

.product-video-thumbnail {
  width: 100%;
  border-radius: 12px;
  cursor: pointer;
  display: block;
}

.product-video-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48px;
  color: white;
  text-shadow: 0 0 10px rgba(0,0,0,0.6);
  pointer-events: none;
}

@media (max-width: 600px) {
  .product-video-play-icon {
    font-size: 36px; /* smaller on mobile */
  }
}

/* Modal */
.product-video-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
  justify-content: center;
  align-items: center;
  padding: 10px;
}

.product-video-modal-content {
  position: relative;
  width: 100%;
  max-width: 900px; /* keeps it centered on big screens */
  max-height: 90vh;
}

.product-video-modal-poster {
  position: relative;
  display: block;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.product-video-modal-poster-image {
  width: 100%;
  height: auto;
  max-height: 90vh;
  object-fit: cover;
  border-radius: 12px;
  display: block;
}

.product-video-modal-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48px;
  color: white;
  text-shadow: 0 0 10px rgba(0,0,0,0.6);
  pointer-events: none;
}

.product-video-modal iframe,
.product-video-modal video {
  width: 100%;
  height: auto;
  max-height: 90vh;
  border-radius: 12px;
}

.product-video-close {
  position: absolute;
  top: -40px;
  right: 0;
  font-size: 32px;
  color: white;
  cursor: pointer;
}
html.no-scroll,
body.no-scroll {
  overflow: hidden;
  height: 100%;
}

@media (max-width: 600px) {
  .product-video-close {
    top: 10px;
    right: 10px;
    font-size: 28px;
    background: rgba(0,0,0,0.6);
    border-radius: 50%;
    padding: 4px 10px;
    z-index: 999;
  }
}



  </style>
<script>
document.addEventListener("DOMContentLoaded", function() {
  const triggers = document.querySelectorAll(".product-video-trigger");
  const modals = document.querySelectorAll(".product-video-modal");

  // Open modal
  triggers.forEach(trigger => {
    trigger.addEventListener("click", function(e) {
      e.preventDefault();
      const videoId = this.getAttribute("data-video-id");
      const modal = document.getElementById(videoId);
      if (modal) {
        resetModalVideo(modal);
        modal.style.display = "flex";
        document.body.classList.add("no-scroll"); // disable scroll
      }
    });
  });

  // Close modal
  modals.forEach(modal => {
    const closeBtn = modal.querySelector(".product-video-close");
    const posterBtn = modal.querySelector(".product-video-modal-poster");

    if (posterBtn) {
      posterBtn.addEventListener("click", function() {
        const video = modal.querySelector("video");

        posterBtn.style.display = "none";

        if (video) {
          video.style.display = "block";
          video.play();
        }
      });
    }

    closeBtn.addEventListener("click", function() {
      modal.style.display = "none";
      document.body.classList.remove("no-scroll"); // re-enable scroll
      stopVideo(modal);
    });
  });

  // Close when clicking outside
  window.addEventListener("click", function(e) {
    modals.forEach(modal => {
      if (e.target === modal) {
        modal.style.display = "none";
        document.body.classList.remove("no-scroll"); // re-enable scroll
        stopVideo(modal);
      }
    });
  });

  // Stop video (works for <video> and <iframe>)
  function resetModalVideo(modal) {
    const posterBtn = modal.querySelector(".product-video-modal-poster");
    const video = modal.querySelector("video");

    if (posterBtn) {
      posterBtn.style.display = "block";
    }

    if (video) {
      video.pause();
      video.currentTime = 0;
      video.style.display = "none";
    }
  }

  function stopVideo(modal) {
    const iframe = modal.querySelector("iframe");

    resetModalVideo(modal);

    if (iframe) {
      iframe.src = iframe.src; // reload iframe to stop playback
    }
  }
});
</script>


