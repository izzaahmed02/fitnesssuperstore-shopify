  "settings": [
    {
      "type": "header",
      "content": "Section paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description"
    },
    {
      "type": "extra",
      "name": "Extra info",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    },
    {
      "type": "all_in_one_overview",
      "name": "All in one overview",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "overview",
          "label": "Overview"
        }
      ]
    },
    {
      "type": "features",
      "name": "Features",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "features",
          "label": "Features"
        }
      ]
    },
    {
      "type": "otherfeatures",
      "name": "Other Features specs",
      "settings": [
        {
          "type": "textarea",
          "id": "otherfeatures",
          "label": "Other Features Specs"
        }
      ]
    },
    {
      "type": "warranty",
      "name": "Warranty",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "warranty",
          "label": "Warranty"
        }
      ]
    },
    {
      "type": "tech",
      "name": "Tech specs",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "tech",
          "label": "Tech specs"
        }
      ]
    },
    {
      "type": "othertech",
      "name": "Other Tech specs",
      "settings": [
        {
          "type": "textarea",
          "id": "othertech",
          "label": "Other Tech Specs"
        }
      ]
    },
    {
      "type": "smith",
      "name": "Smith bar specs",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "smith",
          "label": "Smith bar specs"
        }
      ]
    },
    {
      "type": "weightstacks",
      "name": "Weight Stacks",
      "settings": [
        {
          "type": "text",
          "id": "title",
