        },
        {
          "type": "richtext",
          "id": "weightstacks",
          "label": "Weight Stacks specs"
        }
      ]
    },
    {
      "type": "shippingdimsweight",
      "name": "Shipping Dims & Weight",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "shippingdimsweight",
          "label": "Shipping Dims & Weight specs"
        }
      ]
    },
    {
      "type": "setincludes",
      "name": "Set Includes",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    },
    {
      "type": "accessories",
      "name": "Accessories",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    },
    {
      "type": "accessory-feature",
      "name": "Accessory feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
