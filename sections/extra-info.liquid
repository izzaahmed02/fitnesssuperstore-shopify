<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".custom-video-wrapper").forEach(wrapper => {
      const poster = wrapper.querySelector(".custom-video-poster");
      const video = wrapper.querySelector(".custom-video");

      if (poster && video) {
        poster.addEventListener("click", () => {
          poster.style.display = "none";
          video.style.display = "block";
          video.play();
        });
      }
    });
  });
</script>
<style>
  .custom-video-wrapper{
    position: relative; width: 100%; max-width: 800px; margin-top: 10px; max-height:320px;
  }
  .custom-video-poster{
    position: relative; cursor: pointer; max-height:320px;
  }
    video.custom-video {
    border-radius: 20px;
  }
  .custom-video-poster img{
    width: 100%;
    height: auto;
    display: block;
    max-height: 320px;
    object-fit: cover;
    border-radius: 20px;
  }
  .custom-play-button{
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;
  }
  .product-details-description-body .custom-video-wrapper .custom-video{
    display:block !important;
  }
  @media(max-width:650px){
    .custom-video-wrapper{
      max-height:230px;
    }
    .custom-video-poster{
       max-height:230px;
    }
    .custom-video-poster img{
       max-height:230px; 
    }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const video = document.querySelector(".custom-product-video");
    const wrapper = document.querySelector(".custom-product-video-wrapper");

    if (!video || !wrapper) return;

    video.addEventListener("click", function (e) {
      e.preventDefault();

      if (video.paused) {
        video.play();
        wrapper.classList.add("playing");
        
      } else {
        video.pause();
        wrapper.classList.remove("playing");
        
      }
    });

    video.addEventListener("ended", function () {
      wrapper.classList.remove("playing");
    });
  });
</script>