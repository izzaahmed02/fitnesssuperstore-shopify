{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  /* Full-width page requirement — override the theme's default contained .page-width
     for this section only (does not affect .page-width elsewhere on the site). Figma
     node 4612:86492 (mobile) shows a 16px side inset on the "heading" frame (343 =
     375 - 16 - 16), not 40px — the flat 40px was compressing mobile text/buttons into
     a narrower column than intended. */
  #shopify-section-{{ section.id }} .page-width {
    max-width: 100%;
    margin: 0;
    padding-left: 16px;
    padding-right: 16px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .page-width {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  /* Figma nodes 4583:81433 (mid, 384px) / 4608:84411 (closing, 460px) — heights differ
     per instance, so a per-section custom height setting is used instead of the
     built-in small/medium/large presets, which don't give exact px control. */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .banner--medium:not(.banner--adapt) {
      min-height: {{ section.settings.banner_height_desktop }}px;
    }
    #shopify-section-{{ section.id }} .banner--medium:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content {
      min-height: {{ section.settings.banner_height_desktop }}px;
    }
  }

  /* Figma node 4612:86492 (mobile) — "Why Choose Us" frame is exactly 192px tall,
     nowhere near the theme's default mobile "medium" height (34rem/340px). */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .banner--medium:not(.banner--adapt) {
      min-height: {{ section.settings.banner_height_mobile }}px;
    }
    #shopify-section-{{ section.id }} .banner--medium:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content {
      min-height: {{ section.settings.banner_height_mobile }}px;
    }
  }

  /* "Show text box" being off triggers .banner--desktop-transparent, and since this
     banner also uses image_height: medium, the theme's
     ".banner--medium.banner--desktop-transparent .banner__box{max-width:68rem}" rule
     (assets/section-image-banner.css) was capping the text box at 680px — much
     narrower than Figma's ~1280px-wide single-line headings — forcing extra wraps on
     long text. Widen it to match. */
  #shopify-section-{{ section.id }} .banner__box {
    max-width: 1280px;
  }

  /* page-images/zoom-cta-banner.png confirms the design has no light box behind the
     text at all — just the heading/button sitting directly over the (already tinted)
     image. The color-scheme class previously on .banner__box painted a solid white
     background from the theme's color scheme (config/settings_data.json
     scheme-1.background: #ffffff) and has been removed from the markup entirely so its
     rule can't apply at any breakpoint. Also neutralize .content-container's own
     border/shadow and its ::after pseudo-element (which draws an independent
     box-shadow layer behind the element, unaffected by `background`) so nothing
     box-like can render here regardless of source. */
  #shopify-section-{{ section.id }} .banner__box {
    background: none !important;
    border: none !important;
    box-shadow: none !important;
  }
  #shopify-section-{{ section.id }} .banner__box::after {
    display: none !important;
  }

  /* Figma "Why Choose Us" frame fill — the overlay is a solid black tint baked into the
     image layer itself (0% for the mid banner, 83% for the closing banner), not a
     background behind the text box. The old rgba(255,255,255,...) inline style on
     .banner__box was both the wrong color (white, not black) and the wrong element —
     .banner__box gets forced transparent on desktop by .banner--desktop-transparent
     (triggered by "Show text box" being off), so the overlay never rendered on desktop
     at all. Apply it directly to .banner__media instead so it works consistently.
     .banner__media is ALREADY position:absolute (assets/section-image-banner.css) —
     that's what makes it fill the banner via top/left/width/height:100%, and it's
     already a valid positioned ancestor for this ::after overlay. A stray
     "position: relative" override here previously pulled it back into normal flow;
     since its only child (the <img>) is itself absolutely positioned and contributes
     no height, .banner__media collapsed to 0px tall and the image vanished. Do not
     re-add a position override on .banner__media. */
  #shopify-section-{{ section.id }} .banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  /* Figma nodes 4612:86495/4608:84414-mobile-equiv (mobile) — Oswald SemiBold 28px/34px, white */
  #shopify-section-{{ section.id }} .banner__heading {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    color: #ffffff;
    font-size: 28px;
    line-height: 34px;
  }

  /* Figma nodes 4583:81436/4608:84414 (desktop) — Oswald SemiBold 48px/68px */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .banner__heading {
      font-size: 48px;
      line-height: 68px;
    }
  }

  /* Figma "Confirmation Text" — Lato 16px/24px, #cccccc. Weight varies per banner
     instance (mid-page = Regular, closing = Bold) via the block's text_style field. */
  #shopify-section-{{ section.id }} .banner__text.rte {
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #cccccc;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .banner__text.rte.subtitle {
    font-weight: 700;
  }

  /* Same bug already found and fixed in commercial-gym-buildouts-hero.liquid:
     display:flex (block-level) + justify-self:center doesn't reliably center a block
     box outside a grid context — the base theme's .banner__buttons is display:inline-flex
     specifically so it respects .banner__box's own text-align:center (the default in
     assets/base.css.liquid for this "center" content alignment). Restoring inline-flex
     is what actually centers the button under the heading, matching Figma nodes
     4583:81433 (mid) / 4608:84411 (closing). */
  #shopify-section-{{ section.id }} .banner__buttons {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    justify-content: center;
    word-break: break-word;
    max-width: unset;
  }

  /* Figma node 4608:84416 "Buttons" (closing only — mid never has a phone link) — the
     button (255px) and phone link (336px) together exceed the 336px frame width, which
     only works if they're stacked, not side-by-side; a 16px gap separates them. This
     was missing on desktop (only the mobile media query below set flex-direction), so
     the button and phone link were rendering in a row instead of stacked. */
  #shopify-section-{{ section.id }} .banner__buttons--multiple {
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* Figma nodes 4583:81434/4608:84413/4612:86961 "heading" — gaps between the
     heading/text/buttons stack, confirmed identical on both mobile and desktop:
     heading→text 12px (closing only, mid has no text block), text→buttons 28px
     (closing), heading→buttons 28px on desktop (mid) — overridden to 20px on mobile
     below, since that's the one pair that differs by breakpoint. */
  #shopify-section-{{ section.id }} .banner__heading + .banner__text {
    margin-top: 12px;
  }
  #shopify-section-{{ section.id }} .banner__text + .banner__buttons {
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .banner__heading + .banner__buttons {
    margin-top: 28px;
  }

  /* Figma node 4608:84688 — Lato Bold 16px/24px, #d83d0e */
  .cgb-cta-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    color: #d83d0e;
    text-decoration: none;
  }

  .cgb-cta-phone-link svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .cgb-cta-phone-link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    /* Figma node 4612:86497 "Buttons" — the button spans the full 343px content width
       (375px frame - 16px inset each side), not its own text width. */
    #shopify-section-{{ section.id }} .banner__buttons {
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      width: 100%;
    }

    /* Figma node 4612:86492 (mid, no text block) — heading→buttons gap is 20px on
       mobile, not 28px like desktop (see the base rule above). Closing's
       heading→text→buttons gaps (12px/28px) are unchanged from the base rule since
       node 4612:86960 confirms they're identical on mobile and desktop. */
    #shopify-section-{{ section.id }} .banner__heading + .banner__buttons {
      margin-top: 20px;
    }
  }

  {%- if section.settings.image_overlay_opacity == 0 -%}
    /* Figma node 4612:86492 "Why Choose Us" (mobile, mid banner only) fill — a
       black-to-transparent vertical gradient over the image, present even though this
       banner's desktop overlay is 0% flat. Node 4612:86960 (closing, mobile) confirms
       the OTHER banner instance keeps its flat black tint at both breakpoints instead
       (no gradient), so this is gated to the 0%-opacity case rather than applied
       unconditionally. */
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .banner__media::after {
        background: linear-gradient(180deg, #000000 0%, rgba(0, 0, 0, 0) 100%);
      }
    }
  {%- endif -%}

  {%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign full_width = '120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign full_width = '100vw'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %} page-width"
>
  {%- if section.settings.image != blank -%}
    <div class="banner__media media">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          sizes: full_width,
          widths: widths,
          loading: 'lazy'
      }}
    </div>
  {%- else -%}
    <div class="banner__media media placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width">
    <div
      class="banner__box content-container content-container--full-width-mobile"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'heading' -%}
            <h2 class="banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>

          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'buttons' -%}
            {%- assign button_count = 0 -%}
            {%- if block.settings.button_label_1 != blank -%}{%- assign button_count = button_count | plus: 1 -%}{%- endif -%}
            {%- if block.settings.phone_text != blank -%}{%- assign button_count = button_count | plus: 1 -%}{%- endif -%}

            <div class="banner__buttons{% if button_count > 1 %} banner__buttons--multiple{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a href="{{ block.settings.button_link_1 }}" class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}">
                  {{ block.settings.button_label_1 | escape }}
                </a>
              {%- endif -%}

              {%- if block.settings.phone_text != blank -%}
                <a href="tel:{{ block.settings.phone_link | escape }}" class="cgb-cta-phone-link">
                  {% render 'icon-phone' %}
                  {{ block.settings.phone_text | escape }}
                </a>
              {%- endif -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CGB CTA Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "min": 200,
      "max": 600,
      "step": 4,
      "unit": "px",
      "label": "Banner height (desktop)",
      "info": "Only applies when Image height is set to Medium.",
      "default": 384
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 100,
      "max": 500,
      "step": 4,
      "unit": "px",
      "label": "Banner height (mobile)",
      "info": "Only applies when Image height is set to Medium.",
      "default": 192
    },
    {
      "type": "select",
      "id": "image_height",
      "default": "medium",
      "label": "Image height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "default": "middle-center",
      "label": "Desktop content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": false,
      "label": "Show text box"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "default": "center",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "default": "none",
      "label": "Image animation",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "ambient", "label": "Ambient" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "zoom-in", "label": "Zoom in" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "default": "center",
      "label": "Mobile content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": false,
      "label": "Show text below image on mobile"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading" },
        {
          "type": "select",
          "id": "heading_size",
          "default": "hxl",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" },
            { "value": "hxxl", "label": "Huge" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "text_style",
          "default": "body",
          "label": "Text style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" },
            { "value": "caption-with-letter-spacing", "label": "Caption" }
          ]
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Get My Gym Layout & Quote" },
        { "type": "url", "id": "button_link_1", "label": "Primary button link" },
        { "type": "checkbox", "id": "button_style_secondary_1", "default": false, "label": "Primary button secondary style" },
        {
          "type": "header",
          "content": "Phone link (optional, next to button)"
        },
        { "type": "text", "id": "phone_text", "label": "Phone link text" },
        { "type": "text", "id": "phone_link", "label": "Phone number (digits only, e.g. +19252152927)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CGB CTA Banner",
      "blocks": [
        {
          "type": "heading",
          "settings": { "heading": "Let Us Plan Your Room" }
        },
        {
          "type": "text",
          "settings": { "text": "<p>Share your space, budget and timing and we will come back with an equipment mix, a conceptual layout and a quote.</p>" }
        },
        {
          "type": "buttons",
          "settings": {
            "button_label_1": "Get My Gym Layout & Quote",
            "phone_text": "Call +1-925-215-2927 to talk to a gym specialist",
            "phone_link": "+19252152927"
          }
        }
      ]
    }
  ]
}
{% endschema %}
