}
.fsr-comparison-data .table-scroll td b{
    font-weight: 700;
}
.fsr-comparison-data th:not(:first-child),
.fsr-comparison-data td:not(:first-child) {
  text-align: center;
}
.fsr-comparison-data tbody tr:not(:last-child) {
  border-bottom: 1.5px solid #EDEFF3;
}
.fsr-comparison-data tbody td:nth-child(2) {
    border-left: 1.5px solid #23232B;
    border-right: 1.5px solid #23232B;
}
.fsr-comparison-data tbody tr:last-child td:nth-child(2) {
    border-bottom: 1.5px solid #23232B;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
.compare-banner {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.compare-text {
