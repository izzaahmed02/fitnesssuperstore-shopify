{% assign comparisonChartTitle = product.metafields.custom.features_specs.value.comparison_chart_title.value %}
{% assign comparisonChartTable = product.metafields.custom.features_specs.value.comparison_chart_table.value %}
<div class="fsr-comparison-data">
    {% if comparisonChartTitle != blank %}
        <div class="product__extra_tech extra-info-width chart-title">
        <h3>{{ comparisonChartTitle }}</h3>
        </div>
    {% endif %}
    {% if comparisonChartTable != blank %}
        <div class="product__extra_tech extra-info-width comparision-chart-table">
        <div>{{ comparisonChartTable }}</div>
        </div>
    {% endif %}
</div>
<style>
.fsr-comparison-data .chart-title h3{
    font-family: Oswald;
    font-size: 30px;
    font-weight: 600;
    text-transform: uppercase;
}
.fsr-comparison-data .table-scroll thead{
    background: #EDEFF3;

}
.fsr-comparison-data thead th:first-child {
  border-top-left-radius: 12px;
}
.fsr-comparison-data thead th:nth-child(2) {
  background: #23232B;
  color: #FFFFFF;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
}

.fsr-comparison-data thead th:last-child {
  border-top-right-radius: 12px;
}
.fsr-comparison-data .table-scroll table, .fsr-comparison-data .table-scroll th, .fsr-comparison-data .table-scroll td{
    border: none;
    border-radius: 0;
}
.fsr-comparison-data .table-scroll th{
    font-family: Lato;
    font-size: 16px;
    font-weight: 800;
}
.fsr-comparison-data th:first-child,
.fsr-comparison-data td:first-child {
  text-align: left;
}
.fsr-comparison-data .table-scroll td b{
    font-weight: 700;
}
.fsr-comparison-data th:not(:first-child),
.fsr-comparison-data td:not(:first-child) {
  text-align: center;
}
.fsr-comparison-data tbody tr:not(:last-child) {
  border-bottom: 1px solid #EDEFF3;
}
.fsr-comparison-data tbody td:nth-child(2) {
    border-left: 1px solid #23232B;
    border-right: 1px solid #23232B;
}
.fsr-comparison-data tbody tr:last-child td:nth-child(2) {
    border-bottom: 1px solid #23232B;
}
@media (max-width: 448px) {
    .fsr-comparison-data{
        padding: 0px 16px;
    }
    .fsr-comparison-data .chart-title h3{
        font-size: 28px;
    }
    .fsr-comparison-data .table-scroll th{
        font-size: 14px;
    }
    .fsr-comparison-data .table-scroll table {
        min-width: 680px;
    }
}
</style>
{% schema %}
{
    "name": "Comparison Chart",
    "settings": [],
     "presets": [
      {
        "name": "Comparison Chart",
        "category": "Product"
      }
    ]
}

{% endschema %}