  color: #FFFFFF;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
}

.fsr-comparison-data thead th:last-child {
  border-top-right-radius: 12px;
}
.fsr-comparison-data .table-scroll table, .fsr-comparison-data .table-scroll th, .fsr-comparison-data .table-scroll td{
    border: none;
