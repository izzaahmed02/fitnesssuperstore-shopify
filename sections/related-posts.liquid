{% comment %}
Related posts — pick up to 3 individual articles.
Now includes author name and published date.
{% endcomment %}

<section
  id="RelatedBlogs-{{ section.id }}"
  class="section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="grid grid--1-col grid--2-col-tablet grid--3-col-desktop">
      {%- for i in (1..3) -%}
        {% assign article_setting = 'article_' | append: i %}
        {% assign art_handle = section.settings[article_setting] %}
        {% if art_handle != blank %}
          {% assign article = articles[art_handle] %}
          {% if article %}
            <article class="grid__item">
              <div class="card-wrapper">
                <a href="{{ article.url }}" class="card">
                  {% if article.image %}
                    <div class="card__media">
                      <img
                        src="{{ article.image | img_url: '720x' }}"
                        alt="{{ article.image.alt | default: article.title }}"
                        class="card__image"
                        loading="lazy"
                      />
                    </div>
                  {% endif %}
                  <div class="card__content">
                    <h3 class="card__heading">
                      <span class="card__heading-text">{{ article.title }}</span>
                    </h3>

                               {% assign author_name = article.metafields.custom.author_name %}
{% if article.published_at or author_name %}
  <p class="card__meta publish-info">
    {% if article.published_at %}
      <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
    {% endif %}
    {% if author_name %}
       {% if article.metafields.custom.author_name %}
  {% if article.metafields.custom.author_url %}<a style="z-index: 2;text-decoration: underline;" href="{{ article.metafields.custom.author_url }}"> {% endif %}
    <span>{{ article.metafields.custom.author_name }}</span>
 {% if article.metafields.custom.author_url %} </a> {% endif %}
                {% else %}

                <span>{{ article.author }}</span> 
              {%- endif -%}
    {% endif %}
  </p>
{% endif %}

                    {% if section.settings.show_excerpt %}
                      <div class="card__subtext">
                        {{ article.excerpt | strip_html | truncate: section.settings.excerpt_length }}
                      </div>
                    {% endif %}

                    <div class="card__actions">
                      <span class="link">{{ section.settings.read_more_text }}</span>
                    </div>
                  </div>
                </a>
              </div>
            </article>
          {% endif %}
        {% endif %}
      {%- endfor -%}
    </div>

    {% unless section.settings.article_1 or section.settings.article_2 or section.settings.article_3 %}
      <p class="note" style="margin-top:12px;">No articles selected. Use the section settings to choose up to 3 articles.</p>
    {% endunless %}
  </div>

  <style>
    /* optional: ensure consistent image aspect */
    #RelatedBlogs-{{ section.id }} .card__media { aspect-ratio: 16/9; overflow: hidden; }
    #RelatedBlogs-{{ section.id }} .card__image { width: 100%; height: 100%; object-fit: cover; display:block; }
    .related-articles .card__media { position:relative; }
    .publish-info { display:flex; justify-content:space-between;}

  .publish-info span { margin-bottom: 12px; font-family: Lato; font-size: 12px; line-height: 18px; color: gray; text-transform: none; letter-spacing: .13rem;}
  #RelatedBlogs-{{ section.id }} .link {color: #D83D0E;}
  </style>
</section>

{% schema %}
{
  "name": "Related posts",
  "class": "related-articles",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Section heading",
      "default": "Related posts"
    },
    {
      "id": "article_1",
      "type": "article",
      "label": "Article 1"
    },
    {
      "id": "article_2",
      "type": "article",
      "label": "Article 2"
    },
    {
      "id": "article_3",
      "type": "article",
      "label": "Article 3"
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "Show excerpt",
      "default": true
    },
    {
      "id": "excerpt_length",
      "type": "number",
      "label": "Excerpt length (characters)",
      "default": 120
    },
    {
      "id": "read_more_text",
      "type": "text",
      "label": "Read more text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Related posts",
      "category": "Blog"
    }
  ]
}
{% endschema %}
