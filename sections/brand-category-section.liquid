<link rel="stylesheet" href="{{ 'section-brand-category.css' | asset_url }}">

<section class="brand-category-section">
    <div class="brand-category-container">
      {% for block in section.blocks %}
        <div class="brand-category">
          <h3>{{ block.settings.category_title }}</h3>
          <ul>
            {% for item in block.settings.items %}
              <li><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </section>  
  
  {% schema %}
  {
    "name": "Brand Categories",
    "tag": "section",
    "settings": [],
    "blocks": [
      {
        "type": "category",
        "name": "Category",
        "settings": [
          {
            "type": "text",
            "id": "category_title",
            "label": "Category Title",
            "default": "Category Name"
          },
          {
            "type": "collection_list",
            "id": "items",
            "label": "Category Items",
            "default": [
              { "name": "Item 1", "url": "#" },
              { "name": "Item 2", "url": "#" }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Brand Categories"
      }
    ]
  }
  {% endschema %}
  