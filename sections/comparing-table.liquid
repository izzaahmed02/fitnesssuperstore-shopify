{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
}

.section-{{ section.id }}-padding .comparing-table__table-item > div:first-child,
.section-{{ section.id }}-padding .comparing-table__table-header > div:first-child {
  width: calc((100% / {{ section.settings.columns }}) * 1.25);
}

.section-{{ section.id }}-padding .comparing-table__table-item > div:not(:first-child),
.section-{{ section.id }}-padding .comparing-table__table-header > div:not(:first-child) {
  width: calc((100% - ((100% / {{ section.settings.columns }}) * 1.25)) / ({{ section.settings.columns | minus: 1 }}));
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

@media screen and (max-width: 750px) {

  /* ACTUAL SCROLL CONTAINER */
  .section-{{ section.id }}-padding .comparing-table__table {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .section-{{ section.id }}-padding .comparing-table__table-wrapper {
    width: max-content;
  }

  .section-{{ section.id }}-padding
  .comparing-table__table-header,
  .section-{{ section.id }}-padding
  .comparing-table__table-item {
    display: flex;
    width: max-content;
  }

  .section-{{ section.id }}-padding
  .comparing-table__table-header > div,
  .section-{{ section.id }}-padding
  .comparing-table__table-item > div {
    flex-shrink: 0;
  }

  /* Sticky first column */
  .section-{{ section.id }}-padding
  .comparing-table__table-header > div:first-child,
  .section-{{ section.id }}-padding
  .comparing-table__table-item > div:first-child {
    position: sticky;
    left: 0;
    z-index: 5;
    background: #fff;
    box-shadow: 4px 0 12px rgba(0,0,0,.12);
  }
}
{%- endstyle -%}

<script>
document.addEventListener('DOMContentLoaded', function () {
  if (window.innerWidth > 750) return;

  const table = document.querySelector(
    '.section-{{ section.id }}-padding .comparing-table__table'
  );
  if (!table) return;

  const headers = table.querySelectorAll(
    '.comparing-table__table-header > div'
  );
  if (headers.length < 2) return;

  const stickyWidth = headers[0].offsetWidth;
  const colWidth = headers[1].offsetWidth;

  let snapTimeout;

  table.addEventListener('scroll', function () {
    clearTimeout(snapTimeout);

    snapTimeout = setTimeout(() => {
      const rawScroll = table.scrollLeft - stickyWidth;
      if (rawScroll < 0) return;

      const index = Math.round(rawScroll / colWidth);
      const target = stickyWidth + index * colWidth;

      table.scrollTo({
        left: target,
        behavior: 'smooth'
      });
    }, 90);
  });
});
</script>

<div class="comparing-table section-{{ section.id }}-padding">
  <div class="page-width comparing-table__container">
    {% if section.settings.title2 != blank %}
      <h2 class="title">{{ section.settings.title2 }}</h2>
    {% endif %}

    <div class="comparing-table__table">
      <div class="comparing-table__table-wrapper">
        <div class="comparing-table__table-header">
          {% for i in (1..7) %}
            {% assign key = 'text_' | append: i %}
            {% if section.settings[key] != blank %}
              <div class="header-title">{{ section.settings[key] }}</div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="comparing-table__table-body">
          {% for block in section.blocks %}
            <div class="comparing-table__table-item">
              {% for i in (1..7) %}
                {% assign key = 'text_' | append: i %}
                {% if block.settings[key] != blank %}
                  <div><div>{{ block.settings[key] }}</div></div>
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "title2",
      "label": "Heading",
      "default": "Compare products"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Number of columns",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },

    {
      "type": "text",
      "id": "text_1",
      "label": "Header column 1"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Header column 2"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Header column 3"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Header column 4"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Header column 5"
    },
    {
      "type": "text",
      "id": "text_6",
      "label": "Header column 6"
    },
    {
      "type": "text",
      "id": "text_7",
      "label": "Header column 7"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "text_1", "label": "Column 1" },
        { "type": "text", "id": "text_2", "label": "Column 2" },
        { "type": "text", "id": "text_3", "label": "Column 3" },
        { "type": "text", "id": "text_4", "label": "Column 4" },
        { "type": "text", "id": "text_5", "label": "Column 5" },
        { "type": "text", "id": "text_6", "label": "Column 6" },
        { "type": "text", "id": "text_7", "label": "Column 7" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}

