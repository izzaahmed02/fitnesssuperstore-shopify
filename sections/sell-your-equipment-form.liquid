{% comment %}
  Sell Your Equipment Form
  Styled to match legacy form (rectangular fields, visible borders)
  Compatible with Dawn theme + Shopify contact submission system
{% endcomment %}

<section class="section section-{{ section.id }} sell-equipment-form">
  <div class="page-width">
    <div class="contact-form">
      <h2 class="title h2">{{ section.settings.heading }}</h2>
      <p class="contact-form__subtitle">{{ section.settings.subheading }}</p>

      {% form 'contact', id: 'SellEquipmentForm', class: 'form' %}
        {% if form.posted_successfully? %}
          <div class="form-status form-status--success success-message">
            <div class="success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="success-circle" cx="26" cy="26" r="25" fill="none"/>
                <path class="success-check" fill="none" d="M14 27l7 7 16-16"/>
              </svg>
            </div>
            <h3>Thank you!</h3>
            <p>Your form has been submitted successfully.</p>
          </div>
        {% elsif form.errors %}
          <div class="form-status form-status--error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% unless form.posted_successfully? %}
        <div class="grid grid--1-col">
          <!-- Name -->
          <div class="field">
            <p class="field__title"><strong>Your Name</strong></p>
            <input type="text" name="contact[name]" class="field__input custom-input">
          </div>

          <!-- Email -->
          <div class="field" id="email-field-container">
            <p class="field__title"><strong>Email Address *</strong></p>
            <input type="email" name="contact[email]" class="field__input custom-input" required>
            <p class="inline-error" style="color: red; display: none; font-size: 13px; margin-top: 3px;">
              Please enter a valid email address.
            </p>
          </div>

          <!-- Phone -->
          <div class="field">
            <p class="field__title"><strong>Phone Number</strong></p>
            <input type="tel" name="contact[phone]" class="field__input custom-input">
          </div>

          <!-- City -->
          <div class="field">
            <p class="field__title"><strong>Enter City (California Only)</strong></p>
            <input type="text" name="contact[city]" class="field__input custom-input">
          </div>

          <!-- State -->
          <div class="field">
            <p class="field__title"><strong>Select your State</strong></p>
            <select name="contact[state]" class="custom-select">
              <option value="">-- Select State --</option>
              <option>Alabama</option><option>Alaska</option><option>Arizona</option><option>Arkansas</option>
              <option>California</option><option>Colorado</option><option>Connecticut</option><option>Delaware</option>
              <option>Florida</option><option>Georgia</option><option>Hawaii</option><option>Idaho</option>
              <option>Illinois</option><option>Indiana</option><option>Iowa</option><option>Kansas</option>
              <option>Kentucky</option><option>Louisiana</option><option>Maine</option><option>Maryland</option>
              <option>Massachusetts</option><option>Michigan</option><option>Minnesota</option><option>Mississippi</option>
              <option>Missouri</option><option>Montana</option><option>Nebraska</option><option>Nevada</option>
              <option>New Hampshire</option><option>New Jersey</option><option>New Mexico</option><option>New York</option>
              <option>North Carolina</option><option>North Dakota</option><option>Ohio</option><option>Oklahoma</option>
              <option>Oregon</option><option>Pennsylvania</option><option>Rhode Island</option><option>South Carolina</option>
              <option>South Dakota</option><option>Tennessee</option><option>Texas</option><option>Utah</option>
              <option>Vermont</option><option>Virginia</option><option>Washington</option><option>West Virginia</option>
              <option>Wisconsin</option><option>Wyoming</option><option>Washington D.C.</option>
              <option>None</option>
            </select>
          </div>

          <!-- Product Category -->
          <div class="field">
            <p class="field__title"><strong>Select Product Category</strong></p>
            <select name="contact[category]" class="custom-select">
              <option value="">-- Select Category --</option>
              <option>Elliptical Crosstrainers</option>
              <option>Exercise Bikes</option>
              <option>Free Weight Equipment</option>
              <option>Pilates Reformers</option>
              <option>Rowing Machines</option>
              <option>Stair Climbers / Steppers</option>
              <option>Treadclimbers</option>
              <option>Treadmill</option>
              <option>Vibration Trainers</option>
              <option>Weight Lifting Machines</option>
              <option>Other</option>
            </select>
          </div>

          <!-- Brand -->
          <div class="field">
            <p class="field__title"><strong>Select a Product Brand</strong></p>
            <select name="contact[brand]" class="custom-select">
              <option value="">-- Select Brand --</option>
              <option>Avanti</option><option>Body Craft</option><option>Body Solid</option><option>Bowflex</option>
              <option>Concept 2</option><option>Cybex</option><option>Expresso Fitness</option><option>Life Fitness</option>
              <option>Matrix</option><option>Octane Fitness</option><option>Precor</option><option>Technogym</option>
              <option>True</option><option>Woodway</option><option>Other</option>
            </select>
          </div>

          <!-- Model -->
          <div class="field">
            <p class="field__title"><strong>Specify Model Name / Number</strong></p>
            <input type="text" name="contact[model]" class="field__input custom-input">
          </div>

          <!-- Condition -->
          <div class="field">
            <p class="field__title"><strong>Comment on Product Condition</strong></p>
            <textarea name="contact[condition]" class="custom-textarea"></textarea>
          </div>

          <!-- Difficulty -->
          <div class="field">
            <p class="field__title"><strong>Difficulty of Removing Equipment from its Location</strong></p>
            <input type="text" name="contact[difficulty]" class="field__input custom-input">
          </div>

          <!-- PayPal -->
          <div class="field checkbox">
            <p class="field__title"><strong>Can we pay you by PayPal? (Outside California Only)</strong></p>
            <label><input type="checkbox" name="contact[paypal]" value="Yes"> Yes</label>
          </div>

          <!-- Radio Option -->
          <div class="field radio-group">
            <p class="field__title"><strong>Select Option</strong></p>
            <label><input type="radio" name="contact[type]" value="Sell Equipment"> Sell your Equipment</label><br>
            <label><input type="radio" name="contact[type]" value="Trade-in Equipment"> Trade-in Equipment</label>
          </div>

          <!-- Additional Comments -->
          <div class="field">
            <p class="field__title"><strong>Additional Comments</strong></p>
            <textarea name="contact[comments]" rows="5" class="custom-textarea"></textarea>
          </div>
        </div>

        <div class="contact-form__actions">
          <button type="submit" class="button button--primary" disabled>
            {{ section.settings.button_label }}
          </button>
        </div>
        {% endunless %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  {{ 'none' }}

  /* KEEP EXISTING STYLES */
  .field:after, .select:after, .customer .field:after, .customer select:after, .localization-form__select:after { box-shadow: none; }
  .field:after { box-shadow: none; }
  .field:hover.field:after { box-shadow: none; }
  .sell-equipment-form .field { display: block; }
  .sell-equipment-form .grid { row-gap: 0px; }

  .sell-equipment-form .custom-input,
  .sell-equipment-form .custom-select,
  .sell-equipment-form .custom-textarea {
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 0;
    padding: 8px 10px;
    font-size: 14px;
    font-family: inherit;
    background: #fff;
    box-sizing: border-box;
    margin-bottom: 10px;
  }

  .sell-equipment-form .custom-select { height: 38px; }
  .sell-equipment-form .custom-textarea { min-height: 100px; resize: vertical; }

  .sell-equipment-form .field__title { margin-bottom: 4px; font-size: 15px; color: #222; }
  .sell-equipment-form .checkbox label, .sell-equipment-form .radio-group label { font-size: 14px; }
  .sell-equipment-form .contact-form__actions { margin-top: 20px; }

  .sell-equipment-form .button {
    background-color: #c41200;
    color: white;
    border: none;
    text-transform: uppercase;
    justify-content: center;
  }
  .sell-equipment-form .button:hover { background-color: #a00e00; }

  /* SUCCESS MESSAGE */
  .success-message {
    text-align: center;
    padding: 40px 20px;
    background: #f6fff8;
    border: 1px solid #d9f7e9;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    animation: fadeIn 0.5s ease-in-out;
  }
  .success-icon { width: 80px; height: 80px; margin: 0 auto 15px; }
  .success-icon svg { width: 80px; height: 80px; }
  .success-circle { stroke: #28a745; stroke-width: 3; stroke-dasharray: 166; stroke-dashoffset: 166; stroke-linecap: round; animation: stroke 0.6s ease-out forwards; }
  .success-check { stroke: #28a745; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 48; stroke-dashoffset: 48; animation: stroke 0.4s 0.6s ease-out forwards; }
  @keyframes stroke { 100% { stroke-dashoffset: 0; } }
  @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

  /* INLINE EMAIL ERROR */
  .inline-error.show { display: block !important; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('SellEquipmentForm');
    const emailField = form.querySelector('input[name="contact[email]"]');
    const errorMsg = form.querySelector('.inline-error');
    const submitBtn = form.querySelector('button[type="submit"]');

    function isValidEmail(email) {
      // Regex for proper email validation with TLD
      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i;
      return regex.test(email);
    }

    function validateEmail() {
      const value = emailField.value.trim();
      if (value === '' || !isValidEmail(value)) {
        errorMsg.classList.add('show');
        submitBtn.disabled = true;
      } else {
        errorMsg.classList.remove('show');
        submitBtn.disabled = false;
      }
    }

    // Only show error on blur
    emailField.addEventListener('blur', validateEmail);

    // Enable/disable submit button as user types
    emailField.addEventListener('input', function() {
      submitBtn.disabled = !isValidEmail(emailField.value.trim());
      if (isValidEmail(emailField.value.trim())) {
        errorMsg.classList.remove('show');
      }
    });
  });
</script>


{% schema %}
{
  "name": "Sell Your Equipment Form",
  "class": "sell-equipment-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sell Your Equipment / Trade-ins" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "For a quick price quote, tell us as much as you can." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Submit" }
  ],
  "presets": [{ "name": "Sell Equipment Form" }]
}
{% endschema %}