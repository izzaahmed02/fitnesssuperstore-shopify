{% comment %}
  Sell Your Equipment Form
  Styled to match legacy form (rectangular fields, visible borders)
  Compatible with Dawn theme + Shopify contact submission system
{% endcomment %}


<section class="section section-{{ section.id }} sell-equipment-form">
  <div class="page-width">
    <div class="contact-form">
      <h2 class="title h2">{{ section.settings.heading }}</h2>
      <p class="contact-form__subtitle">{{ section.settings.subheading }}</p>

      {% form 'contact', id: 'SellEquipmentForm', class: 'form' %}
        {% if form.posted_successfully? %}
         <div class="form-status form-status--success">
    <strong>Thank you! Your form has been submitted successfully.</strong>
  </div>
        {% elsif form.errors %}
          <div class="form-status form-status--error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

  


        <div class="grid grid--1-col">
          <!-- Name -->
          <div class="field">
            <p class="field__title"><strong>Your Name</strong></p>
            <input type="text" name="contact[name]" class="field__input custom-input" required>
          </div>

          <!-- Email -->
          <div class="field">
            <p class="field__title"><strong>Email Address *</strong></p>
            <input type="email" name="contact[email]" class="field__input custom-input" required>
          </div>

          <!-- Phone -->
          <div class="field">
            <p class="field__title"><strong>Phone Number</strong></p>
            <input type="tel" name="contact[phone]" class="field__input custom-input">
          </div>

          <!-- City -->
          <div class="field">
            <p class="field__title"><strong>Enter City (California Only)</strong></p>
            <input type="text" name="contact[city]" class="field__input custom-input">
          </div>

          <!-- State -->
         <div class="field">
  <p class="field__title"><strong>Select your State</strong></p>
  <select name="contact[state]" class="custom-select">
    <option value="">-- Select State --</option>
    <option>Alabama</option>
    <option>Alaska</option>
    <option>Arizona</option>
    <option>Arkansas</option>
    <option>California</option>
    <option>Colorado</option>
    <option>Connecticut</option>
    <option>Delaware</option>
    <option>Florida</option>
    <option>Georgia</option>
    <option>Hawaii</option>
    <option>Idaho</option>
    <option>Illinois</option>
    <option>Indiana</option>
    <option>Iowa</option>
    <option>Kansas</option>
    <option>Kentucky</option>
    <option>Louisiana</option>
    <option>Maine</option>
    <option>Maryland</option>
    <option>Massachusetts</option>
    <option>Michigan</option>
    <option>Minnesota</option>
    <option>Mississippi</option>
    <option>Missouri</option>
    <option>Montana</option>
    <option>Nebraska</option>
    <option>Nevada</option>
    <option>New Hampshire</option>
    <option>New Jersey</option>
    <option>New Mexico</option>
    <option>New York</option>
    <option>North Carolina</option>
    <option>North Dakota</option>
    <option>Ohio</option>
    <option>Oklahoma</option>
    <option>Oregon</option>
    <option>Pennsylvania</option>
    <option>Rhode Island</option>
    <option>South Carolina</option>
    <option>South Dakota</option>
    <option>Tennessee</option>
    <option>Texas</option>
    <option>Utah</option>
    <option>Vermont</option>
    <option>Virginia</option>
    <option>Washington</option>
    <option>West Virginia</option>
    <option>Wisconsin</option>
    <option>Wyoming</option>
    <option>Washington D.C.</option>
    <option>None</option>
  </select>
</div>


          <!-- Product Category -->
          <div class="field">
            <p class="field__title"><strong>Select Product Category *</strong></p>
            <select name="contact[category]" class="custom-select" required>
              <option value="">-- Select Category --</option>
              <option value="Elliptical">Elliptical Crosstrainers</option>
              <option value="Exercise Bike">Exercise Bikes</option>
              <option value="Free Weight Equipment">Free Weight Equipment</option>
              <option value="Pilates Reformers">Pilates Reformers</option>
              <option value="Rowing Machines">Rowing Machines</option>
              <option value="Stair Climber">Stair Climbers / Steppers</option>
              <option value="Treadclimber">Treadclimbers</option>
              <option value="Treadmill">Treadmill</option>
              <option value="Vibration Trainers">Vibration Trainers</option>
              <option value="Weight Lifting Machines">Weight Lifting Machines</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <!-- Brand -->
          <div class="field">
            <p class="field__title"><strong>Select a Product Brand</strong></p>
            <select name="contact[brand]" class="custom-select">
              <option value="">-- Select Brand --</option>
              <option value="Avanti">Avanti</option>
              <option value="BodyCraft">Body Craft</option>
              <option value="BodySolid">Body Solid</option>
              <option value="Bowflex">Bowflex</option>
              <option value="Concept 2">Concept 2</option>
              <option value="Cybex">Cybex</option>
              <option value="CycleOps">CycleOps</option>
              <option value="Expresso">Expresso Fitness</option>
              <option value="First Degree">First Degree</option>
              <option value="Fitnex">Fitnex</option>
              <option value="FreeMotion">Free Motion</option>
              <option value="Hammer Strength">Hammer Strength</option>
              <option value="Hoist">Hoist</option>
              <option value="Jacobs Ladder">Jacob's Ladder</option>
              <option value="Keiser">Keiser</option>
              <option value="Kettler">Kettler</option>
              <option value="Landice">Landice</option>
              <option value="Legend">Legend</option>
              <option value="LeMond">LeMond</option>
              <option value="Life Fitness">Life Fitness</option>
              <option value="Magnum">Magnum Fitness</option>
              <option value="Marpo Kinetics">Marpo Kinetics</option>
              <option value="Matrix">Matrix</option>
              <option value="Maximus">Maximus</option>
              <option value="Monark">Monark</option>
              <option value="MultiSports">MultiSports</option>
              <option value="Nautilus">Nautilus</option>
              <option value="Noramco">Noramco Fitness</option>
              <option value="Nustep">Nustep</option>
              <option value="Octane">Octane Fitness</option>
              <option value="Paramount">Paramount</option>
              <option value="ProMaxima">ProMaxima</option>
              <option value="Physiostep">Physiostep</option>
              <option value="Power Plate">Power Plate</option>
              <option value="Powertec">Powertec</option>
              <option value="Precor">Precor</option>
              <option value="Quantum">Quantum Fitness</option>
              <option value="ROM">ROM</option>
              <option value="SportsArt">SportsArt</option>
              <option value="Star Trac">Star Trac</option>
              <option value="Schwinn">Schwinn</option>
              <option value="SciFit">SciFit</option>
              <option value="Soloflex">Soloflex</option>
              <option value="Spirit">Spirit</option>
              <option value="Stairmaster">Stairmaster</option>
              <option value="Stex">Stex</option>
              <option value="Technogym">Technogym</option>
              <option value="Theracycle">Theracycle</option>
              <option value="Total Gym">Total Gym</option>
              <option value="True">True</option>
              <option value="Turbosonic">Turbosonic</option>
              <option value="Universal">Universal</option>
              <option value="Vectra">Vectra</option>
              <option value="Versaclimber">Versaclimber</option>
              <option value="WaterRower">WaterRower</option>
              <option value="Woodway">Woodway</option>
              <option value="Yukon">Yukon</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <!-- Model -->
          <div class="field">
            <p class="field__title"><strong>Specify Model Name / Number</strong></p>
            <input type="text" name="contact[model]" class="field__input custom-input">
          </div>

          <!-- Condition -->
          <div class="field">
            <p class="field__title"><strong>Comment on Product Condition</strong></p>
            <textarea name="contact[condition]" class="custom-textarea"></textarea>
          </div>

          <!-- Difficulty -->
          <div class="field">
            <p class="field__title"><strong>Difficulty of Removing Equipment from its Location</strong></p>
            <input type="text" name="contact[difficulty]" class="field__input custom-input">
          </div>

          <!-- PayPal -->
          <div class="field checkbox">
            <p class="field__title"><strong>Can we pay you by PayPal? (Outside California Only)</strong></p>
            <label><input type="checkbox" name="contact[paypal]" value="Yes"> Yes</label>
          </div>

          <!-- Radio Option -->
          <div class="field radio-group">
            <p class="field__title"><strong>Select Option</strong></p>
            <label><input type="radio" name="contact[type]" value="Sell Equipment"> Sell your Equipment</label><br>
            <label><input type="radio" name="contact[type]" value="Trade-in Equipment"> Trade-in Equipment</label>
          </div>

          <!-- Additional Comments -->
          <div class="field">
            <p class="field__title"><strong>Additional Comments</strong></p>
            <textarea name="contact[comments]" rows="5" class="custom-textarea"></textarea>
          </div>
        </div>

        <div class="contact-form__actions">
          <button type="submit" class="button button--primary">
            {{ section.settings.button_label }}
          </button>
        </div>

      {% endform %}
    </div>
  </div>
</section>

<style>
    .field:after, .select:after, .customer .field:after, .customer select:after, .localization-form__select:after {
    box-shadow: none;
}

.field:hover.field:after {
    box-shadow: none;
}

.sell-equipment-form .field {
display: block;
}

.sell-equipment-form .grid {
row-gap: 0px;
}
  .sell-equipment-form .custom-input,
  .sell-equipment-form .custom-select,
  .sell-equipment-form .custom-textarea {
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 0;
    padding: 8px 10px;
    font-size: 14px;
    font-family: inherit;
    background: #fff;
    box-sizing: border-box;
    margin-bottom: 10px;
  }

  .sell-equipment-form .custom-select {
    height: 38px;
  }

  .sell-equipment-form .custom-textarea {
    min-height: 100px;
    resize: vertical;
  }

  .sell-equipment-form .field__title {
    margin-bottom: 4px;
    font-size: 15px;
    color: #222;
  }

  .sell-equipment-form .checkbox label,
  .sell-equipment-form .radio-group label {
    font-size: 14px;
  }

  .sell-equipment-form .contact-form__actions {
    margin-top: 20px;
  }

  .sell-equipment-form .button {
    background-color: #c41200;
    color: white;
    border: none;
    text-transform: uppercase;
    justify-content:center;
    margin-bottom:15px;
  }

  .sell-equipment-form .button:hover {
    background-color: #a00e00;
  }
</style>

{% schema %}
{
  "name": "Sell Your Equipment Form",
  "class": "sell-equipment-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sell Your Equipment / Trade-ins"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "For a quick price quote, tell us as much as you can."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Submit"
    }
  ],
  "presets": [
    {
      "name": "Sell Equipment Form"
    }
  ]
}
{% endschema %}
