{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

<section
  class="where-payment"
  style="background: {{ section.settings.bg }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <!-- Main Heading Block -->
    <div class="where-payment__header">
      <h2>{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="where-payment__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Cards Grid -->
    <div class="where-payment__grid">
      {% for block in section.blocks %}
       <div class="where-payment__card" {{ block.shopify_attributes }}>
  
  <div class="where-payment__card-top">
    <div class="where-payment__card-heading">
      {% if block.settings.icon != blank %}
        <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="">
      {% endif %}
      <span>{{ block.settings.title }}</span>
    </div>

    {% if block.settings.subtitle != blank %}
      <p class="where-payment__card-subtitle">{{ block.settings.subtitle }}</p>
    {% endif %}
  </div>

  {% if block.settings.text != blank %}
    <div class="where-payment__card-text rte">
      {{ block.settings.text }}
    </div>
  {% endif %}

  {% if block.settings.button_label != blank %}
    <div class="where-payment__card-footer">
      <a href="{{ block.settings.button_link }}" class="where-payment__btn">
        {{ block.settings.button_label }}
      </a>
    </div>
  {% endif %}

</div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .where-payment {
    font-family: system-ui, -apple-system, sans-serif;

  }
  .where-payment__card-top {
  margin-bottom: 12px;
}

.where-payment__card-text {
  flex-grow: 1; /* THIS is the key */
}

.where-payment__card-footer {
  margin-top: 20px;
}
  #hopify-section-template--26232940003644__chhose_payment_step_vishal_y8qEQm{
     background:#FAF9F9;
  }
  /* Header */
  .where-payment__header {
   width: 343;
  height: auto;
  angle: 0 deg;
  opacity: 1;
  gap: 4;

  }
.where-payment__card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.where-payment__card-footer {
  margin-top: 20px;
}

.where-payment__btn {
  display: block;
  width: 100%;
  text-align: center;
  background: #F1592A;
  color: #fff;
  height:48px;
  padding: 12px 16px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-family: Lato;
  font-size:16px;
  transition: 0.3s ease;
}

.where-payment__btn:hover {
  background: #F1592A;
}
  .where-payment__header h2 {
  font-family: Oswald;
  font-weight: 600;
  font-style: SemiBold;
  font-size: 38px;
  leading-trim: NONE;
  line-height: 50px;
  letter-spacing: 0%;
  text-align: center;
  vertical-align: middle;
  text-transform: uppercase;
  margin:0;


  }

  .where-payment__subtitle {
    font-family: Lato;
  font-weight: 700;
  font-style: Bold;
  font-size: 20px;
  line-height: 26px;
  letter-spacing: 0px;
  text-align: center;
  vertical-align: middle;
  color: #7283A4;
  margin:0;


  }

  /* Grid */
 .where-payment__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  padding: 24px;
  
  align-items: stretch;
}
  /* Card */
.where-payment__card {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 20px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  background: #fff;
}
  /* Card heading row — icon + text */
  .where-payment__card-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .where-payment__card-heading img {
    flex-shrink: 0;

    object-fit: contain;
    width: 21.579866409301758;
  height: 20.5000057220459;

  opacity: 1;
  top: 2.25px;
  left: 0.25px;

  }

  .where-payment__card-heading span {
    font-family: Lato;
  font-weight: 700;
  font-style: Bold;
  font-size: 18px;

  line-height: 24px;
  letter-spacing: 0px;
  text-transform: uppercase;


  }

  /* Card subheading */
.where-payment__card-subtitle {
    font-family: Lato;
    font-weight: 700;
    font-style: Bold;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 24px;
    letter-spacing: 0%;
    text-align: left;
    vertical-align: middle;
    color: #7283A4;
}

  /* Bullet list from RTE */
  .where-payment__card-text ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .where-payment__card-text ul li {
    display: flex;
    align-items: flex-start;
    gap: 8px;

    color: #333;

    font-family: Lato;
  font-weight: 400;
  font-style: Regular;
  font-size: 16px;

  line-height: 24px;
  letter-spacing: 0px;


  }

  .where-payment__card-text ul li::before {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3E77AA;
    margin-top: 8px;
  }

  /* Mobile */
  @media (max-width: 749px) {
    .where-payment__grid {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    where-payment__header{

  opacity: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
          display: flex;
    gap: 7px;
    flex-direction: column;
    }
  .where-payment__subtitle {
    align-items:left;
    padding: 0px !important;
    font-family: Lato;
    font-weight: 700;
    font-style: Bold;
    font-size: 16px;
    line-height: 15px;
    letter-spacing: 0px;
    /* text-align: center; */
    /* vertical-align: middle; */
    color: #7283A4;
    margin:0;



  }

  .where-payment__header h2 {
      color: #23232B;
      font-family: Oswald;
      font-weight: 600;

      font-size: 20px;
          line-height: 26px;
      letter-spacing: 0px;
      vertical-align: middle;
      text-transform: uppercase;

          margin: 0px;
      padding: 0px;
      text-align: left;


  }

.where-payment__btn{
  font-size: 14px;
}
  }
</style>

{% schema %}
{
  "name": "Where You'll See Payments",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#FAF9F9"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main heading",
      "default": "WHERE YOU'LL SEE PAYMENT OPTIONS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Payment methods appear in different places depending on the step."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Payment Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Card icon (next to heading)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card heading",
          "default": "CART (EXPRESS BUTTONS)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card subheading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bullet list (use bulleted list in editor)",
          "default": "<ul><li>Shop Pay</li><li>PayPal</li></ul>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Where You'll See Payments",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "CART (EXPRESS BUTTONS)",
            "text": "<ul><li>Shop Pay</li><li>PayPal</li><li>Amazon Pay (device dependent)</li><li>Google Pay</li></ul>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "CHECKOUT (PAYMENT STEP)",
            "text": "<ul><li>Card</li><li>Shop Pay</li><li>PayPal</li><li>Affirm</li><li>other available methods for your order</li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
