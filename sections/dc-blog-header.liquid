
<section class="section-{{ section.id }}-padding dc-blog-header">
  <div class="page-width-dc">
    <div class="dc-blog-header-content">
      <div class="dc-blog-header-content-text">
        <h1 class="dc-blog-header-content-text-title">{{ section.settings.title }}</h1>
        <p class="dc-blog-header-content-text-subtitle">{{ section.settings.subtitle }}</p>
      </div>
      
      <img src="{{ section.settings.image | img_url:'master' }}" alt="banner">
    </div>
  </div>
</section>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .dc-blog-header-content{
    border-radius: 24px;
    overflow:hidden;
    position:relative;
    max-height: 408px;
  }
  .dc-blog-header-content img{
    display:block;
    width: 100%;
  }
  .dc-blog-header-content-text{
    position:absolute;
    width: 100%;
    height:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    background-image: linear-gradient(0deg, rgba(35, 35, 43, 0.6), rgba(35, 35, 43, 0.6));
  }
  .dc-blog-header-content-text-title{
    margin: 0 auto 0 auto;
    max-width: 842px;
    font-family: 'Oswald';
    font-style: normal;
    font-weight: 600;
    font-size: 72px;
    line-height: 117%;
    text-transform: uppercase;
    color: #FFFFFF;
    text-align:center;
  }
  .dc-blog-header-content-text-subtitle{
    margin: 16px auto 0 auto;
    max-width: 842px;
    font-family: 'Lato';
    font-style: normal;
    font-weight: 400;
    font-size: 24px;
    line-height: 133%;
    text-align:center;
    color: #F2F2F2;
  }
{%- endstyle -%}

{% schema %}
  {
    "name": "dc Blog Header",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 12
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 24
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "subtitle",
        "label": "SubTitle"
      }
    ],
    "presets": [
      {
        "name": "dc Blog Header"
      }
    ]
  }
{% endschema %}
