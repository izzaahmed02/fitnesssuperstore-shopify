.option-products {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
}

.product-cards {
    width: 100%;
    display: flex;
    align-items: flex-start;
    white-space: nowrap;
    overflow-y: auto;
    gap: 12px;
}

@media (min-width: 990px) {
    .product-cards {
        gap: 16px;
    }

    .option-products {
        gap: 24px;
    }
}

.product-card {
    flex: 0 0 182px;
    max-width: 182px;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 12px;
    text-align: left;
    background-color: #fff;
    white-space: normal;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    height: 100%;
}

@media (min-width: 990px) {
    .product-card {
        flex: 0 0 182px;
        width: 182px;
    }
}

.product-card.active {
    border: 1px solid #F1592A;
    cursor: pointer;
}

@media (min-width: 990px) {
    .product-card:hover {
        border: 1px solid #F1592A;
        cursor: pointer;
    }
}

.product-card__img {
    width: 100%;
    background: #FAF9F9;
    padding: 15px;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
}

.product-card img {
    width: 60px;
    height: 60px;
    border-radius: 4px;
    -o-object-fit: contain;
    object-fit: contain;
}

.product-card h4 {
    font-size: 14px;
    font-weight: bold;
    margin: 0 0 4px 0;
    color: #000000;
    font-family: 'Lato';
    line-height: 20px;
}

.product-card__mid {
    text-align: left;
    line-height: 14px;
    width: 100%;
}

.product-card span {
    display: block;
    font-size: 12px;
    font-weight: bold;
    color: #808080;
    margin: 4px 0 0 0;
    font-family: 'Lato';
}

.product-card .product-card__price {
    color: #F1592A;
}

.product-card p {
    font-size: 16px;
    color: #393940;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: 'Lato';
    margin: 0;
    max-height: 0;
    transition: max-height 0.5s ease;
}

.product-card__description.expanded {
    max-height: 1000px;
}

.product-card .read-more-btn {
    display: inline-block;
    margin-top: 8px;
    color: #F1592A;
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: 'Lato';
    font-weight: 700;
}

.product-details {
    width: 100%;
    border-radius: 12px;
    padding: 12px;
    border: 1px solid #E5E5E5;
}

@media (min-width: 750px) {
    .product-details {
        border-radius: 0;
        padding: 0;
        border: 0;
    }
}

.modal-header {
    text-align: center;
    margin-bottom: 16px;
}

.modal-header h2 {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 18px;
    color: #333;
    cursor: pointer;
}

.product-details-container {
    display: none;
    min-height: 230px;
    justify-content: left;
    gap: 24px;
    margin-bottom: 24px;
}

.product-details-container .product-details__product-image {
    align-self: baseline;
    height: 200px;
}

@media (min-width: 750px) {
    .product-details-container .product-details__product-image {
        height: 220px;
        min-width: 358px;
    }
}

.product-details-container .product-details__product-info {
    height: auto;
}

.product-details__product-image {
    background: #FAF9F9;
    padding: 20px 80px;
    border-radius: 12px;
}

.product-details__product-image img {
    width: 100%;
    height: 100%;
    display: block;
    max-height: 180px;
}

.yt-video {
    margin-bottom: 12px;
}

.product-details__title {
    margin: 0 0 16px 0;
    font-size: 18px;
    text-transform: none;
    line-height: 24px;
    font-weight: 700;
}

.product-details-description-body ul:has(li:empty) {
    display: none;
}

.product-details-description-body li:empty {
    display: none;
}

.product-details__short_description {
    font-size: 16px;
    margin: 0;
    color: #393940;
    line-height: 24px;
}

.product-details-description-body {
    width: 100%;
}

.product-details-description-body * + * {
    margin-top: 12px;
}

.product-details-description-body div:has(iframe) {
    margin-bottom: 12px;
}

.product-details-description-body img {
    padding: 0 !important;
    width: 100% !important;
    max-width: 600px !important;
}

@media (min-width: 750px) {
    .product-details-description-body img {
        width: auto !important;
    }
}

.product-details-description-body p {
    background-color: transparent !important;
    padding: 0px !important;
    text-indent: 0px !important;
    letter-spacing: 0px !important;
    word-spacing: 0px !important;
    font-family: 'Lato';
    font-size: 16px;
    text-transform: capitalize !important;
    color: #393940 !important;
    margin: 0;
}

.product-details-description-body ul {
    margin-left: 50px;
}

.product-details-description-body li {
    position: relative;
    margin-bottom: 8px;
}

.product-details-description-body li::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: absolute;
    top: 8px;
    left: -14px;
    background: #3E77AA;
}

.product-details-description-body a {
    font-size: 16px !important;
    color: #F1592A !important;
}

.avis-cartOptionsPopup {
    z-index: 1000 !important;
}

.avis-popupHeader {
    padding: 32px 32px 0 32px;
    border-bottom: 0;
    margin-bottom: 8px;
}

.avis-popupHeader-close {
    width: 24px;
    height: 24px;
}

.avis-popupHeader-title {
    font-family: Lato;
    font-weight: 700;
    font-size: 28px;
    line-height: 36px;
    letter-spacing: 0px;
}

.avis-popupBox {
    max-width: 800px;
}

html:has(.avis-popupBox:has(form)) {
    overflow: hidden;
}

.avp-heading {
    font-family: Lato;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    margin: 0 0 16px 0;
}

.avp-option.ap-options__swatch-container .ap-label-tooltip::before {
    transform: rotate(180deg);
}

.ap-label-tooltip.open::before {
    transform: rotate(0) !important;

}

.ap-options__swatch {
    gap: 10px;
}

.ap-options__swatch.show {
    margin-top: 16px;
}

.avpoptions-container__v2 div .ap-options__swatch > label {
    margin-bottom: 0 !important;
}

.avp-option:not(.ap-options__heading-container, .ap-options__select-container) {
    padding: 12px !important;
}

.avpoptions-container__v2 .apo-swatch-wrapper .swatch-variant-title {
    font-size: 10px !important;
    line-height: 14px;
    padding-bottom: 0 !important;
}

.avpoptions-container__v2 .ap-label-tooltip label {
    padding-right: 7px;
}

.ap-options__select-container .avp-option-title {
    padding-right: 0px !important;
}

.avis-popupFooter {
    border-top: 0;
}

.avis-popupFooter {
    padding: 24px 32px 32px 32px;
    justify-content: center;
    -moz-column-gap: 16px;
    column-gap: 16px;
}

.avis-popupBody {
    padding: 0 32px;
}

.avis-popupFooter > button {
    width: calc(50% - 8px);
    height: 48px;
    border-radius: 8px;
}

.avpoptions-container__v2 .avp-option > .ap-label-tooltip > label, .avpoptions-container__v2 .avp-option label.avp-option-title, .avpoptions-container .avp-option > .ap-label-tooltip > label, .avpoptions-container .avp-option > label {
    margin-bottom: 0;
}

.apo-title {
    line-height: 20px;
}

.avis-popupFooter-cancel span {
    font-family: 'Lato';
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0px;
    color: #23232B;
}

.avis-popupFooter-cancel {
    border: 1.5px solid #D3D9E5 !important;
}

.avis-popupFooter-submit {
    background-color: #F1592A;
    border: none !important;
}

.avis-popupFooter-submit span {
    font-family: Lato;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0px;
}

.avp-productoption-total-add {
    display: none;
}

.ap-options__select-container:has(select[name="Warranty"]) {
    display: none;
}

@media (max-width: 992px) {
    .avis-popupBox {
        margin: 0 16px;
        width: calc(100% - 32px);
    }
}

@media (max-width: 749px) {
    .avis-popupHeader {
        padding: 16px 16px 0 16px;
    }

    .avis-popupHeader-title {
        font-size: 20px;
        line-height: 26px;
    }

    .avis-popupBody {
        padding: 0 16px;
    }

    .avis-popupFooter {
        padding: 16px;
        flex-direction: column-reverse;
        align-items: center;
        row-gap: 16px;
    }

    .avpoptions-container__v2 div[role=group] span > label:not(label.avp-hiddenvarianttitleswatch), .avpoptions-container__v2 fieldset > label:not(label.avp-hiddenvarianttitleswatch):not(:last-child), .avpoptions-container__v2 label.avp-productoptionswatchwrapper:not(label.avp-hiddenvarianttitleswatch) {
        margin-right: 0 !important;
        width: 100%;
        max-width: 100% !important;
        flex-direction: row !important;
        justify-content: space-between !important;
    }

    .avp-productoptionswatchwrapper + .avp-productoptionswatchwrapper {
        margin-top: 12px;
    }

    .avpoptions-container__v2 .apo-swatch-wrapper .swatch-variant-title {
        flex-direction: row;
        align-items: center;
        width: 100%;
        justify-content: flex-end;
        -moz-column-gap: 12px;
        column-gap: 12px;
        text-align: left;
    }

    .avp-option:not(.ap-options__heading-container, .ap-options__select-container) {
        padding: 12px 0 !important;
    }
}

@media (max-width: 576px) {
    .avis-popupFooter > button {
        width: 100%;
    }

    .swatch-variant-title .money.apo-money {
        white-space: nowrap;
    }

    .ap-label-tooltip {
        flex-direction: column;
        row-gap: 8px;
    }

    .ap-label-tooltip svg {
        display: none;
    }

    .option_selected-container {
        margin-left: 0 !important;
    }

    .avp-option.ap-options__swatch-container .ap-label-tooltip::before {
        margin-left: 0;
    }
}
#double-assembly-header {
    margin: 20px 0 10px;
}
